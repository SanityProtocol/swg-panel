# swg-node — entry-server image: userspace AmneziaWG + agent + HTTPS sync daemon.
#
# A container can't LOAD a kernel module, so this builds the userspace amneziawg-go
# plus the awg CLI tools, brings up the interface, and runs swg-noded as a pull-only
# client (outbound HTTPS to the panel; peers reconciled locally). Needs NET_ADMIN +
# /dev/net/tun.
#
# ⚠️ "Can't load" is not "can't use". A container USES a module the HOST has already
# loaded: with NET_ADMIN, `ip link add type amneziawg` succeeds here whenever
# /sys/module/amneziawg exists on the host, and awg-quick then takes the KERNEL
# datapath — measured on a live node, where `ip -d link show` reports `amneziawg`,
# not `tun`, with no amneziawg-go running. amneziawg-go is the FALLBACK for a host
# without the module, not the datapath a docker node is stuck with.
#
# We do NOT install that module for you, and throughput is not a reason to want it:
# measured on a 1-vCPU node, same params, four runs, kernel 1232–1299 Mbit/s vs
# userspace 1297–1503 Mbit/s — amneziawg-go was never slower. A host module also
# leaves kernel devices that OUTLIVE the container still holding their ListenPorts
# (see the stale-device sweep in node-entrypoint.sh). If you want it anyway, it is
# a host-side decision: install amneziawg-dkms there and recreate the container.

FROM public.ecr.aws/docker/library/golang:1.25-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends git make build-essential \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# userspace WireGuard/AmneziaWG datapath
RUN for i in 1 2 3 4 5; do git clone --depth=1 https://github.com/amnezia-vpn/amneziawg-go && break \
      || { echo "git clone amneziawg-go failed (attempt $i) — retrying"; sleep 3; rm -rf amneziawg-go; }; done \
 && cd amneziawg-go && go build -o /out/amneziawg-go . \
 && { strip /out/amneziawg-go || true; } \
 && test -x /out/amneziawg-go   # fail the build loudly if the datapath didn't build (don't ship a broken image)
# awg / awg-quick userspace control tools
RUN for i in 1 2 3 4 5; do git clone --depth=1 https://github.com/amnezia-vpn/amneziawg-tools && break \
      || { echo "git clone amneziawg-tools failed (attempt $i) — retrying"; sleep 3; rm -rf amneziawg-tools; }; done \
 && make -C amneziawg-tools/src \
 && make -C amneziawg-tools/src install DESTDIR=/out PREFIX=/usr WITH_BASHCOMPLETION=no WITH_SYSTEMDUNITS=no WITH_WGQUICK=yes \
 && test -x /out/usr/bin/awg && test -x /out/usr/bin/awg-quick

FROM public.ecr.aws/docker/library/python:3.12-slim
ARG TARGETARCH=amd64
# util-linux = nsenter (host_sh helper), curl + the static docker CLI = drive host turn-proxy units
# via the mounted docker.sock when TURN_MANAGE=panel (B1). The daemon is never installed — client only.
# wireguard-tools ships `wg`: without it the only tool here is `awg`, which lists amneziawg-module
# interfaces only — so a plain-WireGuard interface already on the box (the common case when adopting an
# existing install) was invisible to iface_candidates and could never be offered for adoption.
RUN apt-get update && apt-get install -y --no-install-recommends \
      iproute2 iptables nftables ipset dnsmasq ca-certificates procps curl util-linux wireguard-tools \
 && case "$TARGETARCH" in amd64) A=x86_64;; arm64) A=aarch64;; *) A=x86_64;; esac \
 && curl -fsSL "https://download.docker.com/linux/static/stable/${A}/docker-27.3.1.tgz" -o /tmp/d.tgz \
 && tar -xzf /tmp/d.tgz -C /tmp && install /tmp/docker/docker /usr/bin/docker \
 && rm -rf /tmp/d.tgz /tmp/docker /var/lib/apt/lists/*
COPY --from=build /out/amneziawg-go /usr/bin/amneziawg-go
COPY --from=build /out/usr/bin/awg /usr/bin/awg
COPY --from=build /out/usr/bin/awg-quick /usr/bin/awg-quick
WORKDIR /opt
COPY swg-agent /opt/swg-agent/swg-agent
COPY swg-noded /opt/swg-noded/swg-noded
COPY swg-sni /opt/swg-noded/swg-sni
COPY VERSION /opt/swg-noded/VERSION
COPY docker/node-entrypoint.sh /node-entrypoint.sh
RUN chmod +x /opt/swg-agent/swg-agent /opt/swg-noded/swg-noded /opt/swg-noded/swg-sni /node-entrypoint.sh /usr/bin/amneziawg-go /usr/bin/awg /usr/bin/awg-quick

ENV NODE_IFACE=awg0 \
    NODE_LISTEN_PORT=51820 \
    NODE_ADDRESS=10.8.0.1/24 \
    DNS=1.1.1.1 \
    TLS_VERIFY=no \
    INTERVAL=5
ENTRYPOINT ["/node-entrypoint.sh"]
