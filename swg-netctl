#!/usr/bin/env python3
"""swg-netctl — the privileged network/TLS helper for swg-panel.

The panel and swg-sub run UNPRIVILEGED (users swgpanel / swgsub). They cannot bind
low ports, edit their own systemd units, or run acme.sh. This root helper performs a
FIXED, strictly-validated set of exactly those operations on their behalf — nothing
else — so a compromise of the panel can't turn into arbitrary root.

Invoked two ways:

    swg-netctl <verb> <args...>     # direct (install scripts / manual / testing)
    swg-netctl run                  # drain the request queue (systemd .path/.timer trigger)

Verbs — each touches exactly ONE unit or cert path, chosen by a hard service map the
caller can't escape (callers pass only "panel"/"sub", never a unit name or file path):

    set-listen  <panel|sub> <ip> <port>   persist the bind addr as a systemd drop-in + daemon-reload
                                          (does NOT restart — the panel binds the new socket live first;
                                          the drop-in just makes it survive the next restart)
    issue-cert  <panel|sub> <domain>      acme.sh issue+install to that service's cert path (+ SIGHUP reload hook)
    drop-cert   <panel|sub> <domain>      stop auto-renewing one domain (after a confirmed domain switch)
    adopt-cert  <panel|sub> <cert> <key>  install an operator-supplied cert pair (TLS mode `skip`)
    restart     <panel|sub>               restart one service unit

Security model:
  - no shell, ever — every external command is an argv list (no interpolation, no word-splitting);
  - strict per-arg validation (service enum, IP literal, 1..65535 port, FQDN regex);
  - a hard service->{unit,cert,key,env} map — the caller can never name a unit, path, or reload command;
  - queue requests must be regular files OWNED BY THE PANEL USER (another local user can't inject);
  - requests/results carry NO secrets (the CF token etc. are read here, from install.conf, never passed in);
  - every action is logged to stderr (the journal).

stdlib-only Python 3, single file — same as the other swg programs.
"""

import contextlib
import grp
import ipaddress
import json
import os
import pwd
import shutil
import ssl
import urllib.error
import urllib.parse
import urllib.request
import re
import stat
import subprocess
import sys
import time

# ── configuration (env-overridable so the installer / tests can relocate) ─────────
PANEL_USER = os.environ.get("SWG_PANEL_USER", "swgpanel")
PANEL_GROUP = os.environ.get("SWG_PANEL_GROUP", "swg")
STATE_DIR = os.environ.get("SWG_STATE_DIR", "/var/lib/swg-panel")
ETC_DIR = os.environ.get("SWG_ETC_DIR", "/etc/swg-panel")
SUB_TLS_DIR = os.environ.get("SWG_SUB_TLS_DIR", "/etc/swg-sub/tls")
UNIT_DIR = os.environ.get("SWG_UNIT_DIR", "/etc/systemd/system")
CONF = os.path.join(ETC_DIR, "install.conf")
QUEUE_DIR = os.path.join(STATE_DIR, "netctl", "queue")
STATUS_DIR = os.path.join(STATE_DIR, "netctl", "status")
DRYRUN = os.environ.get("SWG_NETCTL_DRYRUN") == "1"

# The ONLY things the helper is allowed to touch, keyed by the service names callers may pass.
# There is no way for a request to name a unit, cert path, or reload command directly.
SERVICES = {
    "panel": {
        "unit": "swg-panel-server.service",
        "cert": os.path.join(ETC_DIR, "tls", "fullchain.pem"),
        "key": os.path.join(ETC_DIR, "tls", "key.pem"),
        "env_host": "SWG_PANEL_HOST",
        "env_port": "SWG_PANEL_PORT",
    },
    "sub": {
        "unit": "swg-sub.service",
        "cert": os.path.join(SUB_TLS_DIR, "fullchain.pem"),
        "key": os.path.join(SUB_TLS_DIR, "key.pem"),
        "env_host": "SWG_SUB_HOST",
        "env_port": "SWG_SUB_PORT",
    },
}

# FQDN: 1..253 chars, dot-separated labels of [A-Za-z0-9-] (no leading/trailing hyphen), ≥2 labels.
DOMAIN_RE = re.compile(
    r"^(?=.{1,253}$)(?!-)[A-Za-z0-9-]{1,63}(?<!-)(\.(?!-)[A-Za-z0-9-]{1,63}(?<!-))+$"
)


def log(msg):
    print("swg-netctl: " + msg, file=sys.stderr, flush=True)


class Reject(Exception):
    """A request that failed validation or execution — reported, never fatal to the queue."""


# ── validators (reject first, act later) ─────────────────────────────────────────
def v_service(s):
    if s not in SERVICES:
        raise Reject("unknown service %r (expected panel|sub)" % (s,))
    return s


def v_ip(s):
    try:
        ipaddress.ip_address(s)          # accepts v4/v6 literals incl. 0.0.0.0 / ::/ 127.0.0.1
    except (ValueError, TypeError):
        raise Reject("not an IP address: %r" % (s,))
    return s


def v_port(s):
    try:
        p = int(str(s), 10)
    except (TypeError, ValueError):
        raise Reject("not a port number: %r" % (s,))
    if not (1 <= p <= 65535):
        raise Reject("port out of range: %r" % (s,))
    return p


def v_domain(s):
    if not isinstance(s, str) or not DOMAIN_RE.match(s):
        raise Reject("not a valid domain: %r" % (s,))
    return s


# ── low-level helpers ─────────────────────────────────────────────────────────────
def run(argv, env=None):
    """Run an argv list (never a shell string). Returns (rc, combined_output)."""
    log("exec: " + " ".join(argv))
    if DRYRUN:
        return 0, "(dry-run)"
    p = subprocess.run(argv, env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, text=True)
    if p.stdout:
        for line in p.stdout.rstrip().splitlines():
            log("  | " + line)
    return p.returncode, p.stdout or ""


def load_conf():
    """Read /etc/swg-panel/install.conf (KEY=value / KEY="value"). The CF token lives here,
    never in a request — the helper reads it itself."""
    cfg = {}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, val = line.partition("=")
                cfg[k.strip()] = val.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return cfg


# ⚠️ Keep this list a SUPERSET of install-host.sh's find_acme(). The two diverged: the installer
# searched /root/.acme.sh, $HOME/.acme.sh and `command -v acme.sh`, while this searched
# /root/.acme.sh, /opt/acme.sh and ~/.acme.sh — neither a superset of the other. So an acme.sh on
# PATH (a distro package, or a custom install) was found at INSTALL time and then not at RUNTIME,
# and the panel's issue-cert button failed on a box the installer had called ready. `shutil.which`
# is the missing arm; /opt stays because only this side ever had it.
_ACME_CANDIDATES = ("/root/.acme.sh/acme.sh", "/opt/acme.sh/acme.sh",
                    os.path.expanduser("~/.acme.sh/acme.sh"))


# ⚠️ THE STORE IS NOT THE BINARY'S DIRECTORY, and it is not $HOME either. acme.sh keeps state in
# $LE_WORKING_DIR and falls back to "$HOME/.acme.sh" — and this process is a systemd oneshot with no
# HOME, so it silently operated on /.acme.sh (filesystem root) while acme's own cron renewed
# `--home /root/.acme.sh`. Every certificate the panel issued at runtime therefore had NO renewer and
# expired at 90 days. The unit now sets LE_WORKING_DIR, but do not depend on the unit alone: pass
# --home on every call, so a hand-run, an old unit, or a drop-in that lost the variable cannot
# resurrect the split.
ACME_HOME = os.environ.get("LE_WORKING_DIR") or "/root/.acme.sh"


def acme_argv(acme, *args):
    return [acme, "--home", ACME_HOME] + list(args)


def find_acme():
    for a in _ACME_CANDIDATES:
        if os.path.isfile(a) and os.access(a, os.X_OK):
            return a
    onpath = shutil.which("acme.sh")           # what install-host.sh's find_acme() also accepts
    if onpath:
        return onpath
    if DRYRUN:
        return "/root/.acme.sh/acme.sh"      # so the argv is visible without a live install
    # Name every place actually looked. The old message listed two of the three paths it tried,
    # so an operator with acme.sh in ~/.acme.sh was told it had not been looked for there.
    raise Reject("acme.sh not found (looked in %s, and on PATH)" % ", ".join(_ACME_CANDIDATES))


# ⚠️ AN ACME ENTRY WITH NO CERTIFICATE IS A TRAP, NOT STATE WORTH KEEPING — and it is self-perpetuating.
# acme.sh writes <domain>.key BEFORE it ever contacts the CA, and leaves it behind when the order fails.
# The next --issue then dies at "Domain key exists, do you want to overwrite it? ... add '--force'", so the
# FIRST failure's real cause (port 80 unreachable, a bad DNS token, a rate limit) is masked for ever and
# every retry reports the mask instead. It cannot heal itself: issue() calls createDomainKey only when the
# requested keylength differs from Le_Keylength in the domain conf, and that value is written ONLY on a
# successful key creation — so a failed run leaves a conf without it, the 2048 default never matches our
# ec-256, and the next run walks straight back into the same refusal. Measured on a live box: the same
# error, to the letter, two hours and several attempts apart. (acme.sh 3.1.4: issue():5044, createDomainKey():1669.)
#
# --force is the WRONG cure: _issue_acme relies on rc 2 = RENEW_SKIP, and forcing re-issues on every apply,
# burning Let's Encrypt's 5-duplicates-per-week. Drop the useless entry instead — the same thing
# do_drop_cert already does after a --remove, and install-host.sh's prune does for a superseded one.
def _acme_ecc_dir(domain):
    """The store directory OUR issuance uses for `domain` — we always issue --keylength ec-256, and acme.sh
    puts EC certs in `<domain>_ecc`. Only ever a directory sitting DIRECTLY under the store we pin: never a
    symlink pointing out of it, and never the RSA `<domain>` entry beside it, which on a shared box may
    belong to another tool entirely. Returns None when there is nothing of ours there."""
    p = os.path.join(ACME_HOME, "%s_ecc" % domain)
    if os.path.isdir(p) and os.path.dirname(os.path.realpath(p)) == os.path.realpath(ACME_HOME):
        return p
    return None


def _acme_entry_usable(d, domain):
    """Does this entry hold a certificate `--install-cert` could actually install? Ask for the file it READS
    (fullchain.cer) and require the leaf to really be a PEM — acme.sh ≤3.1.3 writes the CA's HTTP body to
    <domain>.cer unconditionally, so a 404 lands a JSON blob there that a bare size test calls a certificate."""
    try:
        if os.path.getsize(os.path.join(d, "fullchain.cer")) <= 0:
            return False
        with open(os.path.join(d, "%s.cer" % domain)) as f:
            return "BEGIN CERTIFICATE" in f.readline()
    except OSError:
        return False


def _acme_clear_unusable(domain):
    """Drop `domain`'s entry when it holds no usable certificate, so issuance can start clean.

    A directory with a key and no certificate is worth nothing to anyone. One that HAS a certificate is
    never touched: --issue RENEW_SKIPs it (rc 2), and a multi-SAN change re-issues from it happily because
    a successful entry carries the matching Le_Keylength, so createDomainKey is never even reached."""
    d = _acme_ecc_dir(domain)
    if d is None or DRYRUN or _acme_entry_usable(d, domain):
        return False
    shutil.rmtree(d, ignore_errors=True)
    log("cleared a failed acme entry for %s (a domain key with no certificate) — it would have masked "
        "every re-issue with \"Domain key exists\"" % domain)
    return True


def reload_cmd_for(service):
    # both the panel and swg-sub reload their cert on SIGHUP with zero downtime.
    return "systemctl kill -s HUP %s" % SERVICES[service]["unit"]


# ── verbs ─────────────────────────────────────────────────────────────────────────
def do_set_listen(service, ip, port):
    svc = SERVICES[v_service(service)]
    ip = v_ip(ip)
    port = v_port(port)
    dropdir = os.path.join(UNIT_DIR, svc["unit"] + ".d")
    path = os.path.join(dropdir, "10-access.conf")
    # Binding a port <1024 needs CAP_NET_BIND_SERVICE. The panel unit always carries it; swg-sub
    # gets it here so switching it onto a privileged port (e.g. 443) from the UI just works, on any
    # existing install, with no unit regeneration. AmbientCapabilities merges additively across
    # drop-ins, and is compatible with the unit's NoNewPrivileges=true (the panel proves this).
    cap = "AmbientCapabilities=CAP_NET_BIND_SERVICE\n" if port < 1024 else ""
    body = ("# managed by swg-netctl — from the panel's Access & TLS settings; do not edit by hand\n"
            "[Service]\n"
            "Environment=%s=%s\n"
            "Environment=%s=%d\n"
            "%s" % (svc["env_host"], ip, svc["env_port"], port, cap))
    if DRYRUN:
        log("would write %s:\n%s" % (path, body))
    else:
        os.makedirs(dropdir, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    rc, out = run(["systemctl", "daemon-reload"])
    if rc:
        raise Reject("daemon-reload failed: " + out.strip())
    return "persisted %s listen = %s:%d (takes effect on next restart)" % (service, ip, port)


_BASE_RE = re.compile(r"^/?[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9_-]*)*/?$")
def v_base(base):
    """A safe reverse-proxy mount base: '' (root) or a '/seg[/seg...]' path of [A-Za-z0-9_-] segments. No traversal."""
    b = (base or "").strip()
    if b in ("", "/"):
        return ""
    if ".." in b or not _BASE_RE.match(b):
        raise Reject("bad mount base %r" % (base,))
    return "/" + b.strip("/")

def do_set_base(service, base):
    """Persist the panel's reverse-proxy mount base (SWG_PANEL_BASE) as a systemd drop-in so a PATH change (e.g.
    /swg → /panel) survives the next restart. The live process already switched bases at confirm; this only makes
    it durable. Written to its OWN drop-in so it never clobbers set-listen's."""
    if v_service(service) != "panel":
        raise Reject("set-base only applies to the panel")
    svc = SERVICES["panel"]
    b = v_base(base)                       # "" (root) or "/panel"
    dropdir = os.path.join(UNIT_DIR, svc["unit"] + ".d")
    path = os.path.join(dropdir, "12-base.conf")
    body = ("# managed by swg-netctl — panel mount base (Access & TLS); do not edit by hand\n"
            "[Service]\n"
            "Environment=SWG_PANEL_BASE=%s\n" % b.strip("/"))
    if DRYRUN:
        log("would write %s:\n%s" % (path, body))
    else:
        os.makedirs(dropdir, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    rc, out = run(["systemctl", "daemon-reload"])
    if rc:
        raise Reject("daemon-reload failed: " + out.strip())
    return "persisted panel mount base = %s (takes effect on next restart)" % (b or "/")


def do_set_cert_env(service, state):
    """Persist whether the PANEL terminates its OWN TLS: 'on' points SWG_PANEL_TLS_CERT/KEY at the managed cert
    path (→ HTTPS on the next start = direct TLS); 'off' blanks them (→ plain HTTP behind a reverse proxy). This
    is the DURABLE half of a reverse-proxy↔direct-TLS switch — the live socket is already flipped by the panel's
    dual-listen at apply/confirm; this only makes the new scheme survive a restart. Its OWN drop-in (11-cert) so
    it never clobbers set-listen (10-access) / set-base (12-base), and it overrides the base unit's cert env. The
    cert PATH is fixed by the service map (never caller-named), so a request can't point the panel at a rogue cert."""
    if v_service(service) != "panel":
        raise Reject("set-cert-env only applies to the panel")
    svc = SERVICES["panel"]
    st = (state or "").strip().lower()
    if st not in ("on", "off"):
        raise Reject("set-cert-env state must be on|off")
    if st == "on" and not (os.path.exists(svc["cert"]) and os.path.exists(svc["key"])):
        raise Reject("no certificate at %s — issue one before enabling direct TLS" % svc["cert"])
    cert, key = (svc["cert"], svc["key"]) if st == "on" else ("", "")
    dropdir = os.path.join(UNIT_DIR, svc["unit"] + ".d")
    path = os.path.join(dropdir, "11-cert.conf")
    body = ("# managed by swg-netctl — panel direct-TLS on/off (Access & TLS); do not edit by hand\n"
            "[Service]\n"
            "Environment=SWG_PANEL_TLS_CERT=%s\n"
            "Environment=SWG_PANEL_TLS_KEY=%s\n" % (cert, key))
    if DRYRUN:
        log("would write %s:\n%s" % (path, body))
    else:
        os.makedirs(dropdir, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    rc, out = run(["systemctl", "daemon-reload"])
    if rc:
        raise Reject("daemon-reload failed: " + out.strip())
    return "persisted panel direct-TLS = %s (takes effect on next restart)" % st


def do_set_local_port(service, port):
    """Persist the panel's INTERNAL loopback-HTTP port (SWG_PANEL_LOCAL_PORT) so the dedicated 127.0.0.1 plain-HTTP
    listener for co-located nodes comes back on the SAME port after a restart — set when the panel flips to direct-TLS
    and keeps the old loopback listener as its internal interface. Its OWN drop-in (13-local) so it never clobbers
    set-listen (10) / set-cert-env (11) / set-base (12)."""
    if v_service(service) != "panel":
        raise Reject("set-local-port only applies to the panel")
    svc = SERVICES["panel"]
    p = v_port(port)
    dropdir = os.path.join(UNIT_DIR, svc["unit"] + ".d")
    path = os.path.join(dropdir, "13-local.conf")
    body = ("# managed by swg-netctl — panel internal loopback-HTTP port (Access & TLS); do not edit by hand\n"
            "[Service]\n"
            "Environment=SWG_PANEL_LOCAL_PORT=%d\n" % p)
    if DRYRUN:
        log("would write %s:\n%s" % (path, body))
    else:
        os.makedirs(dropdir, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    rc, out = run(["systemctl", "daemon-reload"])
    if rc:
        raise Reject("daemon-reload failed: " + out.strip())
    return "persisted panel internal loopback port = %d (takes effect on next restart)" % p


def _nrestarts(unit):
    """systemd's cumulative automatic-restart counter for `unit`, or -1 if unavailable."""
    rc, out = run(["systemctl", "show", unit, "-p", "NRestarts", "--value"])
    try:
        return int((out or "").strip())
    except ValueError:
        return -1


def do_reload(service):
    """SIGHUP a service so it re-reads its config with NO rebind + no restart — used when the panel changes swg-sub's
    mount base / config (a bind change still uses do_restart). No crash-loop verify is needed: nothing is re-bound."""
    svc = SERVICES[v_service(service)]
    rc, out = run(["systemctl", "kill", "-s", "HUP", svc["unit"]])
    if rc:
        raise Reject("reload %s failed: %s" % (svc["unit"], out.strip()))
    return "reloaded (SIGHUP) " + svc["unit"]


def do_restart(service):
    svc = SERVICES[v_service(service)]
    unit = svc["unit"]
    before = _nrestarts(unit)
    rc, out = run(["systemctl", "restart", unit])
    if rc:
        raise Reject("restart %s failed: %s" % (unit, out.strip()))
    # Verify it actually STAYS up. These units are Type=simple, so systemd reports "active" the instant the
    # process is exec'd — BEFORE it binds. A bad bind (Errno 98) crashes it right after, and Restart=on-failure
    # bounces it forever, so a momentary is-active lies. Settle well past RestartSec (2s), then require it active
    # AND that systemd logged NO automatic restart in the meantime — the reliable crash-loop signal. This lets
    # the caller (the panel's sub apply) detect a doomed bind and self-heal back to the previous address.
    if not DRYRUN:
        time.sleep(4.5)                          # > 2×RestartSec: a crash-loop auto-restarts at least once here
        st, _o = run(["systemctl", "is-active", unit])
        after = _nrestarts(unit)
        looped = before >= 0 and after >= 0 and after > before
        if st != 0 or looped:
            _r, detail = run(["systemctl", "--no-pager", "-n", "6", "status", unit])
            raise Reject("%s did not stay up after restart (the address is likely already in use): %s"
                         % (unit, (detail or "").strip()[-300:]))
    return "restarted " + unit


def _load_access_tls():
    """TLS creds for issuance. Preferred source is the panel's Access & TLS settings — root reads
    panel-settings.json DIRECTLY (swgsub is masked from it), so the CF token NEVER has to ride in a queue
    request (which is group-swg readable). Falls back to install.conf for anything unset."""
    acc = {}
    with contextlib.suppress(OSError, ValueError):
        with open(os.path.join(STATE_DIR, "panel-settings.json")) as f:
            acc = ((json.load(f).get("access") or {}).get("tls")) or {}
    cfg = load_conf()
    g = lambda k, ck: (str(acc.get(k) or cfg.get(ck) or "")).strip()
    return {"mode": g("mode", "TLS_MODE"), "email": g("email", "ACME_EMAIL"),
            "cf_token": g("cf_token", "CF_TOKEN"), "cf_account": (cfg.get("CF_ACCOUNT_ID") or "").strip(),
            "cf_origin_token": g("cf_origin_token", "CF_ORIGIN_TOKEN")}


def _fix_cert_perms(svc):
    # acme/openssl install root-owned; the service (swgpanel/swgsub, both in group swg) must READ the key.
    # root:swg with a group-readable key, and root keeps write — a service compromise can't rewrite it.
    with contextlib.suppress(KeyError, PermissionError, OSError):
        gid = grp.getgrnam(PANEL_GROUP).gr_gid
        for f, m in ((svc["cert"], 0o644), (svc["key"], 0o640)):
            if os.path.exists(f):
                os.chown(f, 0, gid); os.chmod(f, m)


def _issue_selfsigned(svc, domains):
    san = ",".join("DNS:" + d for d in domains)
    if DRYRUN:
        log("would openssl-selfsign CN=%s SAN=%s -> %s / %s" % (domains[0], san, svc["cert"], svc["key"])); return
    rc, out = run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650",
                   "-subj", "/CN=" + domains[0], "-addext", "subjectAltName=" + san,
                   "-keyout", svc["key"], "-out", svc["cert"]])
    if rc:
        raise Reject("openssl self-signed failed (rc %d): %s" % (rc, out.strip()[-300:]))


def _issue_acme(svc, service, domains, mode, creds, reloadcmd=True):
    acme = find_acme()
    env = dict(os.environ)
    # BEFORE the order, not after: a leftover from a previous failure would refuse THIS attempt too, and the
    # operator would read "Domain key exists" instead of the reason issuance is actually failing on this box.
    _acme_clear_unusable(domains[0])
    issue = acme_argv(acme, "--issue", "--server", "letsencrypt", "--keylength", "ec-256")
    for d in domains:                   # one -d per SAN; the FIRST is the primary acme.sh installs/renews by
        issue += ["-d", d]
    if mode == "cloudflare":
        if not creds["cf_token"]:
            raise Reject("cloudflare mode but no CF token (set it in Access & TLS or install.conf)")
        env["CF_Token"] = creds["cf_token"]
        if creds["cf_account"]:
            env["CF_Account_ID"] = creds["cf_account"]
        issue += ["--dns", "dns_cf"]
    else:  # letsencrypt (HTTP-01)
        issue += ["--standalone"]
    if creds["email"]:
        run(acme_argv(acme, "--register-account", "-m", creds["email"], "--server", "letsencrypt"), env=env)
    rc, out = run(issue, env=env)
    # acme.sh: 0 = issued, 2 = RENEW_SKIP (a still-valid cert already exists). Else a failure.
    if rc not in (0, 2) and not DRYRUN:
        # …and again on the way out, so the NEXT attempt meets the real error rather than this one's residue.
        _acme_clear_unusable(domains[0])
        raise Reject("acme --issue failed (rc %d) for %s: %s" % (rc, ",".join(domains), out.strip()[-400:]))
    inst = acme_argv(acme, "--install-cert", "-d", domains[0], "--ecc",   # install/renew keyed by the primary -d
                     "--key-file", svc["key"], "--fullchain-file", svc["cert"])
    if reloadcmd:                       # renewals reload the running service; a live-apply must NOT (the old
        inst += ["--reloadcmd", reload_cmd_for(service)]   # listener keeps the old cert until the change confirms)
    rc, out = run(inst, env=env)
    if rc:
        raise Reject("acme --install-cert failed (rc %d): %s" % (rc, out.strip()[-400:]))


def _issue_cf15(svc, domains, creds):
    """Cloudflare Origin CA cert (15 years) via the CF API — a private EC key + CSR generated locally, the
    cert signed by CF. ONLY valid behind Cloudflare's proxy. Uses the Origin CA token (Zone:SSL:Edit).
    Multiple `domains` → a multi-SAN cert (the first is the CSR CN); used to serve the OLD + NEW domain both
    through the node-migration grace on a domain change, so remote nodes on the old domain aren't cut off."""
    tok = creds["cf_origin_token"]
    if not tok:
        raise Reject("cf15 needs a Cloudflare Origin CA token (set it in Access & TLS or install.conf CF_ORIGIN_TOKEN)")
    if DRYRUN:
        log("would request a 15-year Cloudflare Origin cert (CN=%s, SAN=%s) -> %s" % (domains[0], ",".join(domains), svc["cert"]))
        return
    # generate the key + CSR with output CAPTURED (never routed through run(), which logs — the key is secret)
    key = subprocess.run(["openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
    if not key:
        raise Reject("openssl EC key generation failed")
    csr = subprocess.run(["openssl", "req", "-new", "-key", "/dev/stdin", "-subj", "/CN=" + domains[0]],
                         input=key, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode()
    if not csr.strip():
        raise Reject("openssl CSR generation failed")
    body = json.dumps({"hostnames": list(domains), "requested_validity": 5475,
                       "request_type": "origin-ecc", "csr": csr}).encode()
    req = urllib.request.Request("https://api.cloudflare.com/client/v4/certificates", data=body, method="POST",
                                 headers={"Content-Type": "application/json", "Authorization": "Bearer " + tok})
    log("requesting a Cloudflare Origin cert for %s" % ",".join(domains))
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            d = json.load(r)
    except urllib.error.HTTPError as e:
        d = json.load(e)
    except Exception as e:
        raise Reject("Cloudflare API request failed: %s" % (e,))
    if not d.get("success"):
        msgs = "; ".join(str(x.get("message")) for x in (d.get("errors") or [])) or "unknown error"
        raise Reject("Cloudflare rejected the Origin cert request (check the token + that %s is on this account): %s" % (",".join(domains), msgs))
    with open(svc["cert"], "w") as f:
        f.write(d["result"]["certificate"].rstrip("\n") + "\n")
    with open(svc["key"], "wb") as f:
        f.write(key)


def do_issue_cert(service, domain, reload="reload"):
    # reload="noreload" is used by the panel's live-apply: the new cert must NOT be reloaded into the
    # EXISTING listener (which is still serving the old cert to Cloudflare/clients during the dual-listen
    # window). Only the new listener loads it, at bind time. Renewals use "reload" (SIGHUP, zero-downtime).
    svc = SERVICES[v_service(service)]
    # `domain` may be a comma-separated list — a multi-SAN cert (first = primary/CN). The panel uses this on a
    # domain change to serve the OLD + NEW domain together through the node-migration grace, then reissues new-only.
    domains = [d for d in (domain or "").split(",") if d]
    if not domains:
        raise Reject("issue-cert: no domain given")
    seen = set(); uniq = []
    for d in domains:
        v_domain(d)
        if d not in seen:
            seen.add(d); uniq.append(d)
    domains = uniq
    if reload not in ("reload", "noreload"):
        raise Reject("bad reload flag %r" % (reload,))
    creds = _load_access_tls()
    mode = creds["mode"] or "letsencrypt"
    if not DRYRUN:
        os.makedirs(os.path.dirname(svc["cert"]), exist_ok=True)
    acme_mode = mode in ("cloudflare", "letsencrypt")
    if mode == "selfsigned":
        _issue_selfsigned(svc, domains)
    elif mode == "cf15":
        _issue_cf15(svc, domains, creds)
    elif acme_mode:
        _issue_acme(svc, service, domains, mode, creds, reloadcmd=(reload == "reload"))
    else:
        # letsencrypt-ip issues for a public IP (not a domain) — a separate path, deferred.
        raise Reject("issue-cert not yet implemented for TLS mode %r" % (mode,))
    _fix_cert_perms(svc)
    # selfsigned/cf15 write the file directly; SIGHUP the service to pick it up on a RENEWAL (no-op the first
    # time over plain HTTP). acme's --reloadcmd already did this. Skipped entirely for a live-apply (noreload).
    if reload == "reload" and not acme_mode:
        with contextlib.suppress(Exception):
            run(["systemctl", "kill", "-s", "HUP", svc["unit"]])
    return "issued cert for %s (%s) via %s" % (",".join(domains), service, mode)


# A domain-change apply issues the NEW cert over the live path (so the new listener can load it), but the
# change isn't committed until the browser confirms. These let the panel back the live cert up first and
# restore it on a revert, so a reverted/timed-out apply never leaves the wrong cert on disk.
def do_backup_cert(service):
    svc = SERVICES[v_service(service)]
    n = 0
    for f in (svc["cert"], svc["key"]):
        if os.path.exists(f) and not DRYRUN:
            shutil.copy2(f, f + ".applyback"); n += 1
    return "backed up %s cert (%d file(s))" % (service, n)


def do_restore_cert(service):
    svc = SERVICES[v_service(service)]
    restored = False
    for f in (svc["cert"], svc["key"]):
        b = f + ".applyback"
        if os.path.exists(b) and not DRYRUN:
            os.replace(b, f); restored = True
    if restored:
        _fix_cert_perms(svc)
        with contextlib.suppress(Exception):
            run(["systemctl", "kill", "-s", "HUP", svc["unit"]])   # reload the restored cert into the live listener
    return "restored %s cert" % service if restored else "no %s cert backup to restore" % service


def do_clear_backup(service):
    svc = SERVICES[v_service(service)]
    for f in (svc["cert"], svc["key"]):
        with contextlib.suppress(OSError):
            os.unlink(f + ".applyback")
    return "cleared %s cert backup" % service


# ── adopt an operator-supplied certificate (TLS mode `skip`) ──────────────────────
# The operator already HAS a certificate — issued by certbot, handed over by a hoster, carried from
# another box — and wants this panel to serve it. We COPY it into the managed path rather than pointing
# the unit at their file, because everything else in the TLS machinery is built around that one path:
# backup-cert/restore-cert, the .applyback self-heal, the expiry watch, SIGHUP reload, and swg-sub's
# InaccessiblePaths mask. A second source of truth would have to be threaded through all of it.
#
# ⚠️ ROOT IS ABOUT TO READ A PATH THE UNPRIVILEGED PANEL NAMED, and copy it somewhere group `swg` can
# read. The validation below is not only there to give a good error message — it is the boundary. The
# pair must LOAD as a certificate + matching private key, which is what keeps this from being a way to
# surface /etc/shadow, an SSH key, or an env file into the panel's cert directory. What remains, and is
# inherent to the feature rather than a hole in it: an operator (or a compromised panel) can make a TLS
# key pair that already exists on this host become the panel's certificate. The panel must be able to
# read the key it serves — that is what terminating TLS means — so no arrangement of permissions avoids
# it. Both paths are validated here; NEITHER file's CONTENT ever rides the request queue, which is
# group-readable (see the header): the queue carries paths, and paths are not secrets.
_MAX_PEM = 512 * 1024          # a chain plus a key; larger than this is not what we were pointed at


def _v_srcpath(p, what):
    p = (p or "").strip()
    if not p.startswith("/") or "\x00" in p or len(p) > 4096:
        raise Reject("%s: %r is not an absolute path" % (what, p[:120]))
    rp = os.path.realpath(p)
    # a symlink into the kernel's file systems is not a certificate, whatever it resolves to
    if rp.startswith(("/proc/", "/sys/", "/dev/")) or rp in ("/proc", "/sys", "/dev"):
        raise Reject("%s: %s is not a file this can read" % (what, p))
    try:
        st = os.stat(rp)
    except OSError as e:
        raise Reject("%s: cannot read %s (%s)" % (what, p, e.strerror or e))
    if not stat.S_ISREG(st.st_mode):
        raise Reject("%s: %s is not a regular file" % (what, p))
    if st.st_size <= 0 or st.st_size > _MAX_PEM:
        raise Reject("%s: %s is empty or far too large to be a PEM file" % (what, p))
    return rp


def _cert_names(path):
    """Every name the certificate answers to — DNS SANs plus the subject CN."""
    names = set()
    with contextlib.suppress(Exception):
        info = ssl._ssl._test_decode_cert(path)
        for typ, val in info.get("subjectAltName", ()):
            if typ == "DNS":
                names.add(str(val).lower())
        for rdn in info.get("subject", ()):
            for k, v in rdn:
                if k == "commonName":
                    names.add(str(v).lower())
    return names


def _cert_covers_host(path, host):
    d = (host or "").lower()
    for n in _cert_names(path):
        if n == d or (n.startswith("*.") and d.split(".", 1)[-1:] == [n[2:]]):
            return True
    return False


def _service_host(service):
    """The name THIS service is configured to answer to. Read HERE, from the panel's settings and then
    install.conf — never taken from the request: a caller that could name both the file and the name it
    must match would be checking its own homework."""
    host = ""
    with contextlib.suppress(OSError, ValueError):
        with open(os.path.join(STATE_DIR, "panel-settings.json")) as f:
            url = (((json.load(f).get("access") or {}).get(service) or {}).get("url") or "").strip()
        if url:
            host = urllib.parse.urlsplit(url if "://" in url else "https://" + url).hostname or ""
    if not host:
        cfg = load_conf()
        host = (cfg.get("SUB_DOMAIN") if service == "sub" else cfg.get("PANEL_DOMAIN")) or ""
    return host.strip().lower()


def do_adopt_cert(service, cert_src, key_src, reload="reload"):
    svc = SERVICES[v_service(service)]
    if reload not in ("reload", "noreload"):
        raise Reject("bad reload flag %r" % (reload,))
    c = _v_srcpath(cert_src, "certificate")
    k = _v_srcpath(key_src, "private key")
    # THE pair test: the same call the service itself will make when it binds. A pass here means the
    # listener comes up; it rejects a non-PEM, a key that does not match the leaf, and a passphrase-
    # protected key (which would otherwise hang a service that has no terminal to ask on).
    try:
        ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER).load_cert_chain(c, k, password=lambda: b"")
    except Exception as e:
        raise Reject("%s and %s are not a usable certificate + private key pair: %s"
                     % (cert_src, key_src, str(e).strip()[-200:] or e.__class__.__name__))
    host = _service_host(service)
    if host and not _cert_covers_host(c, host):
        raise Reject("that certificate does not cover %s — it names %s"
                     % (host, ", ".join(sorted(_cert_names(c))) or "no host at all"))
    with contextlib.suppress(Exception):
        left = int((ssl.cert_time_to_seconds(ssl._ssl._test_decode_cert(c)["notAfter"]) - time.time()) // 86400)
        if left < 0:
            raise Reject("that certificate expired %d day(s) ago" % -left)
    if DRYRUN:
        log("would install %s + %s as the %s certificate" % (cert_src, key_src, service)); return "dry-run"
    os.makedirs(os.path.dirname(svc["cert"]), exist_ok=True)
    for src, dst in ((c, svc["cert"]), (k, svc["key"])):
        if os.path.realpath(src) == os.path.realpath(dst):
            continue                      # already the file we serve (the operator pointed at it) — nothing to copy
        tmp = dst + ".adopting"           # write beside the target and rename: never a half-written cert on disk
        shutil.copyfile(src, tmp)
        os.replace(tmp, dst)
    _fix_cert_perms(svc)
    if reload == "reload":
        with contextlib.suppress(Exception):
            run(["systemctl", "kill", "-s", "HUP", svc["unit"]])
    return "installed the certificate from %s for %s" % (cert_src, service)


def do_drop_cert(service, domain):
    v_service(service)
    v_domain(domain)
    acme = find_acme()
    rc, out = run(acme_argv(acme, "--remove", "-d", domain, "--ecc"))
    if rc:
        raise Reject("acme --remove failed (rc %d): %s" % (rc, out.strip()[-200:]))
    # ⚠️ --remove DROPS THE RENEWAL CONFIG AND KEEPS THE KEY ("You can remove them by yourself"), and
    # that stranded key makes the domain un-reissuable: the next --issue stops at "Domain key exists,
    # do you want to overwrite it? If so, add --force". An address change that reverts once could
    # therefore NEVER be retried to the same address, while the dialog told the operator to try again.
    # --force is not the answer: swg-netctl relies on rc 2 = RENEW_SKIP, and --force re-issues on every
    # apply, burning Let's Encrypt's 5-per-week duplicate limit. We have just declared we do not want
    # this certificate, so drop its directory — the same thing install-host.sh's
    # prune_stale_acme_installs already does for a superseded entry.
    for _d in ("%s_ecc" % domain, domain):
        _p = os.path.join(ACME_HOME, _d)
        # only ever a domain directory directly under the store we own, and only one acme just removed
        if os.path.dirname(os.path.realpath(_p)) == os.path.realpath(ACME_HOME) and os.path.isdir(_p):
            shutil.rmtree(_p, ignore_errors=True)
    return "stopped auto-renewing %s" % (domain,)


_HOST_RE = re.compile(r"^[A-Za-z0-9.:_-]+$")


def _v_host(s):
    s = (s or "").strip()
    if not s or len(s) > 253 or not _HOST_RE.match(s):
        raise Reject("bad domain %r" % (s,))
    return s


def _update_conf(updates):
    """Rewrite install.conf, replacing the given KEY=value pairs in place (preserving comments, order and every
    key not mentioned) and appending any that were absent. Atomic, 0600 (the file also holds the CF token)."""
    try:
        with open(CONF) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    out, seen = [], set()
    for line in lines:
        s = line.strip()
        if s and not s.startswith("#") and "=" in s:
            k = s.partition("=")[0].strip()
            if k in updates:
                out.append("%s=%s" % (k, updates[k]))
                seen.add(k)
                continue
        out.append(line)
    for k, val in updates.items():
        if k not in seen:
            out.append("%s=%s" % (k, val))
    body = "\n".join(out).rstrip("\n") + "\n"
    if DRYRUN:
        log("would write %s:\n%s" % (CONF, body))
        return
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write(body)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CONF)


def do_persist_url(domain, base, port, serve, tls):
    """Keep install.conf's public URL + serve/TLS mode in step with a CONFIRMED Access address-migration, so a
    later re-install or bare→docker convert reproduces the CURRENT address — not the pre-migration one captured
    at install time. install.conf is otherwise written ONLY by install-host.sh, so without this a migrated panel
    silently reverts its URL on any convert/re-install and strands its nodes. Reverse-proxy keeps an existing
    nginx/caddy/skip serve flavour (else 'nginx') and forces TLS_MODE=none; direct-TLS sets SERVE_MODE=internal."""
    dom = _v_host(domain)
    b = v_base(base)                                   # "" (root) or "/panel"
    p = v_port(port) if str(port).strip() else ""
    serve = (serve or "").strip()
    cfg = load_conf()
    if serve == "reverse-proxy":
        sm = cfg.get("SERVE_MODE", "")
        serve_mode = sm if sm in ("nginx", "caddy", "skip") else "nginx"
        tls_mode = "none"
    else:
        serve_mode = "internal"
        tls_mode = (tls or "").strip() or cfg.get("TLS_MODE", "selfsigned")
    updates = {"PANEL_DOMAIN": dom, "PANEL_BASE": b, "SERVE_MODE": serve_mode, "TLS_MODE": tls_mode}
    if p:
        updates["PORT"] = str(p)
    _update_conf(updates)
    return "synced install.conf → domain=%s base=%s port=%s serve=%s tls=%s" % (
        dom, b or "/", p or "-", serve_mode, tls_mode)


VERBS = {
    "set-listen": (do_set_listen, 3),
    "set-base": (do_set_base, 2),
    "persist-url": (do_persist_url, 5),   # keep install.conf's URL+serve/TLS current after a confirmed migration
    "set-cert-env": (do_set_cert_env, 2),       # panel direct-TLS on|off (the durable half of a reverse-proxy↔TLS flip)
    "set-local-port": (do_set_local_port, 2),   # panel internal loopback-HTTP port (co-located nodes, direct-TLS)
    "issue-cert": (do_issue_cert, (2, 3)),      # optional 3rd arg: reload | noreload (live-apply uses noreload)
    "drop-cert": (do_drop_cert, 2),
    "adopt-cert": (do_adopt_cert, (3, 4)),
    "backup-cert": (do_backup_cert, 1),
    "restore-cert": (do_restore_cert, 1),
    "clear-backup": (do_clear_backup, 1),
    "restart": (do_restart, 1),
    "reload": (do_reload, 1),
}


def dispatch(verb, args):
    if verb not in VERBS:
        raise Reject("unknown verb %r" % (verb,))
    fn, argc = VERBS[verb]
    lo, hi = argc if isinstance(argc, tuple) else (argc, argc)   # some verbs take an optional trailing arg
    if not (lo <= len(args) <= hi):
        raise Reject("%s takes %s arg(s), got %d" % (verb, lo if lo == hi else "%d-%d" % (lo, hi), len(args)))
    for a in args:
        if not isinstance(a, (str, int)):
            raise Reject("%s: args must be strings/ints" % (verb,))
    return fn(*[str(a) for a in args])


# ── request queue (systemd trigger drains it) ─────────────────────────────────────
def _panel_uid():
    try:
        return pwd.getpwnam(PANEL_USER).pw_uid
    except KeyError:
        return None


def _write_status(rid, status, message, nonce):
    # writing a status file is not a privileged/system mutation, so it happens even in DRYRUN.
    os.makedirs(STATUS_DIR, exist_ok=True)
    doc = {"id": rid, "status": status, "message": message,
           "nonce": nonce, "at": int(time.time())}
    tmp = os.path.join(STATUS_DIR, rid + ".json.tmp")
    final = os.path.join(STATUS_DIR, rid + ".json")
    with open(tmp, "w") as f:
        json.dump(doc, f)
    os.chmod(tmp, 0o640)
    try:                                             # group-readable by the panel (group swg)
        os.chown(tmp, 0, grp.getgrnam(PANEL_GROUP).gr_gid)
    except (KeyError, PermissionError, OSError):
        pass
    os.replace(tmp, final)


def _safe_rid(name):
    # request filename → id, but never let it escape STATUS_DIR
    rid = os.path.basename(name)
    if rid.endswith(".json"):
        rid = rid[:-5]
    return re.sub(r"[^A-Za-z0-9_.-]", "_", rid) or "req"


def process_queue():
    if not os.path.isdir(QUEUE_DIR):
        return
    puid = _panel_uid()
    for name in sorted(os.listdir(QUEUE_DIR)):
        if not name.endswith(".json"):
            continue
        path = os.path.join(QUEUE_DIR, name)
        rid = _safe_rid(name)
        try:
            st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode):
                raise Reject("not a regular file")
            if puid is not None and st.st_uid != puid:
                raise Reject("request not owned by %s (uid %d) — ignored" % (PANEL_USER, st.st_uid))
            with open(path) as f:
                req = json.load(f)
            rid = _safe_rid(str(req.get("id") or rid))
            msg = dispatch(req.get("verb"), req.get("args") or [])
            log("ok [%s]: %s" % (rid, msg))
            _write_status(rid, "ok", msg, req.get("nonce"))
        except Reject as e:
            log("reject [%s]: %s" % (rid, e))
            _write_status(rid, "error", str(e), None)
        except Exception as e:                      # never let one bad request wedge the queue
            log("error [%s]: %s" % (rid, e))
            _write_status(rid, "error", "internal error: %s" % (e,), None)
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass


def main(argv):
    if len(argv) < 2:
        print("usage: swg-netctl run | <verb> <args...>", file=sys.stderr)
        return 2
    if argv[1] == "run":
        process_queue()
        return 0
    try:
        msg = dispatch(argv[1], argv[2:])
        print(json.dumps({"status": "ok", "message": msg}))
        return 0
    except Reject as e:
        print(json.dumps({"status": "error", "message": str(e)}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
