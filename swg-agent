#!/usr/bin/env python3
"""
swg-agent — node-side peer manager for swg-panel.

Reads ONE JSON request on stdin, performs a wg / AmneziaWG peer operation on a
*managed* interface, and writes ONE JSON response on stdout (exit 0 on success,
1 on error). Designed to be the forced command behind a dedicated SSH key:

  command="/opt/swg-agent/swg-agent",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 AAAA... swg-panel

so the panel can ONLY run these operations — never a shell.

Config: /etc/swg-agent/config.json   (see config.example.json)
Only interfaces listed there are touchable; S2S / exit tunnels are simply absent.

v1 targets native host interfaces (awg/wg on the host). The per-interface "cmd"
prefix is configurable for future container support.
"""

import contextlib
import errno
import fcntl
import ipaddress
import json
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import time

CONFIG_PATH = os.environ.get("SWG_AGENT_CONFIG", "/etc/swg-agent/config.json")
AUDIT_PATH  = os.environ.get("SWG_AGENT_AUDIT",  "/var/log/swg-agent/audit.log")
LOCK_PATH   = os.environ.get("SWG_AGENT_LOCK",   "/run/swg-agent.lock")
VERSION     = "1.0"

PUBKEY_RE = re.compile(r"^[A-Za-z0-9+/]{43}=$")
AWG_KEYS  = ["Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4",
             "H1", "H2", "H3", "H4", "I1", "I2", "I3", "I4", "I5"]


class AgentError(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code
        self.msg = msg


# ───────────────────────── helpers ─────────────────────────

def load_config():
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except Exception as e:
        raise AgentError("internal", f"cannot read {CONFIG_PATH}: {e}")


def iface_cfg(cfg, iface):
    ifaces = cfg.get("interfaces", {})
    if iface not in ifaces:
        raise AgentError("iface_not_managed", f"interface {iface!r} is not managed")
    return ifaces[iface]


def run(args, input_text=None, check=True):
    p = subprocess.run(args, input=input_text, capture_output=True, text=True)
    if check and p.returncode != 0:
        raise AgentError("internal", f"{' '.join(args)} failed: {p.stderr.strip()}")
    return p.stdout


def read_conf(path):
    with open(path) as f:
        return f.read()


def write_conf_atomic(path, text):
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def parse_dump(out):
    """First line = interface, rest = peers (tab-separated `wg show <i> dump`)."""
    lines = out.strip().splitlines()
    iface_line = lines[0].split("\t") if lines else []
    peers = []
    for line in lines[1:]:
        f = line.split("\t")
        if len(f) < 8:
            continue
        peers.append({
            "public_key": f[0],
            "endpoint": None if f[2] in ("(none)", "") else f[2],
            "allowed_ips": f[3],
            "last_handshake": int(f[4]) if f[4].isdigit() else 0,
            "rx_bytes": int(f[5]) if f[5].isdigit() else 0,
            "tx_bytes": int(f[6]) if f[6].isdigit() else 0,
        })
    return iface_line, peers


def parse_interface_section(conf_text):
    """Key->value of the first [Interface] section."""
    info, in_iface = {}, False
    for line in conf_text.splitlines():
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]")
            continue
        if in_iface and "=" in s and not s.startswith("#"):
            k, v = s.split("=", 1)
            info[k.strip()] = v.strip()
    return info


def awg_params(info):
    out = {}
    for k in AWG_KEYS:
        if k in info:
            v = info[k]
            out[k] = int(v) if v.isdigit() else v
    return out


def iface_net(info):
    addr = info.get("Address", "").split(",")[0].strip()
    if not addr:
        raise AgentError("internal", "interface conf has no Address")
    return ipaddress.ip_interface(addr)          # .ip = server addr, .network = subnet


def used_ips(peers):
    out = set()
    for p in peers:
        for cidr in p["allowed_ips"].split(","):
            cidr = cidr.strip()
            if cidr:
                out.add(cidr.split("/")[0])
    return out


def next_free_ip(info, peers):
    net = iface_net(info)
    taken = used_ips(peers) | {str(net.ip)}
    for host in net.network.hosts():
        if str(host) not in taken:
            return str(host)
    raise AgentError("subnet_full", "no free addresses in subnet")


def wg_dump(ic, iface):
    return run(ic["cmd"] + ["show", iface, "dump"])


def gen_psk(ic):
    return run(ic["cmd"] + ["genpsk"]).strip()


def append_peer_to_conf(path, pub, psk, allowed, name, endpoint=None, keepalive=None):
    block = "\n"
    if name:
        block += f"# name: {name}\n"
    block += "[Peer]\n"
    block += f"PublicKey = {pub}\n"
    if psk:
        block += f"PresharedKey = {psk}\n"
    block += f"AllowedIPs = {allowed}\n"
    if endpoint:                       # node-to-node mesh peers dial out (user peers omit both)
        block += f"Endpoint = {endpoint}\n"
    if keepalive:
        block += f"PersistentKeepalive = {keepalive}\n"
    with open(path, "a") as f:
        f.write(block)


def remove_peer_from_conf(path, pub):
    lines = read_conf(path).splitlines()
    starts = [i for i, l in enumerate(lines) if l.strip().lower() == "[peer]"]
    target = None
    for idx, start in enumerate(starts):
        end = starts[idx + 1] if idx + 1 < len(starts) else len(lines)
        if any(re.match(rf"\s*PublicKey\s*=\s*{re.escape(pub)}\s*$", b) for b in lines[start:end]):
            target = (start, end)
            break
    if target is None:
        return
    start, end = target
    # also drop a leading "# name:" comment and blank lines directly above [Peer]
    while start - 1 >= 0 and (lines[start - 1].strip() == ""
                              or lines[start - 1].strip().lower().startswith("# name:")):
        start -= 1
    new_lines = lines[:start] + lines[end:]
    write_conf_atomic(path, ("\n".join(new_lines).rstrip("\n") + "\n") if new_lines else "")


def set_listen_port_in_conf(path, port):
    """Rewrite (or insert) ListenPort in the first [Interface] section. Atomic, 0600."""
    lines = read_conf(path).splitlines()
    out, in_iface, done = [], False, False
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]")
            out.append(line)
            continue
        if in_iface and not done and re.match(r"(?i)\s*ListenPort\s*=", line):
            out.append(f"ListenPort = {port}")
            done = True
            continue
        out.append(line)
    if not done:
        res, added = [], False
        for line in out:
            res.append(line)
            if not added and line.strip().lower() == "[interface]":
                res.append(f"ListenPort = {port}")
                added = True
        out = res
    write_conf_atomic(path, "\n".join(out).rstrip("\n") + "\n")


def set_iface_fields_in_conf(path, fields):
    """Replace (or insert) the given [Interface] fields. fields = {Name: value}. Atomic, 0600."""
    want = {k.lower(): (k, str(v)) for k, v in fields.items()}
    lines = read_conf(path).splitlines()
    out, in_iface, seen = [], False, set()
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]"); out.append(line); continue
        if in_iface and "=" in s and not s.startswith("#"):
            k = s.split("=", 1)[0].strip().lower()
            if k in want:
                name, val = want[k]; out.append(f"{name} = {val}"); seen.add(k); continue
        out.append(line)
    missing = [(name, val) for k, (name, val) in want.items() if k not in seen]
    if missing:
        res, added = [], False
        for line in out:
            res.append(line)
            if not added and line.strip().lower() == "[interface]":
                for name, val in missing:
                    res.append(f"{name} = {val}")
                added = True
        out = res
    write_conf_atomic(path, "\n".join(out).rstrip("\n") + "\n")


def ensure_table_off_in_conf(path):
    """Idempotently ensure `Table = off` in [Interface] — for a mesh link that carries a 0.0.0.0/0 peer,
    so wg/awg-quick never installs a default route from AllowedIPs (which would hijack the box's egress).
    Self-heals Phase-1 link confs created before Table=off existed. No-op if already present."""
    try:
        info = parse_interface_section(read_conf(path))
    except Exception:
        return
    if str(info.get("Table", "")).strip().lower() == "off":
        return
    set_iface_fields_in_conf(path, {"Table": "off"})


def rewrite_peer_allowed_in_conf(path, pub, allowed):
    """Replace the AllowedIPs line of the [Peer] block matching `pub` (reuses the block scan from
    remove_peer_from_conf). Inserts an AllowedIPs line if the block somehow lacks one. Atomic, 0600."""
    lines = read_conf(path).splitlines()
    starts = [i for i, l in enumerate(lines) if l.strip().lower() == "[peer]"]
    for idx, start in enumerate(starts):
        end = starts[idx + 1] if idx + 1 < len(starts) else len(lines)
        if any(re.match(rf"\s*PublicKey\s*=\s*{re.escape(pub)}\s*$", b) for b in lines[start:end]):
            done = False
            for i in range(start, end):
                if re.match(r"(?i)\s*AllowedIPs\s*=", lines[i]):
                    lines[i] = f"AllowedIPs = {allowed}"; done = True; break
            if not done:
                lines.insert(start + 1, f"AllowedIPs = {allowed}")
            write_conf_atomic(path, "\n".join(lines).rstrip("\n") + "\n")
            return
    # peer block not found in conf (live-only) — nothing to rewrite


@contextlib.contextmanager
def locked():
    os.makedirs(os.path.dirname(LOCK_PATH) or "/run", exist_ok=True)
    f = open(LOCK_PATH, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def audit(op, req):
    try:
        os.makedirs(os.path.dirname(AUDIT_PATH), exist_ok=True)
        with open(AUDIT_PATH, "a") as f:
            f.write(json.dumps({
                "ts": int(time.time()), "op": op,
                "iface": req.get("iface"), "public_key": req.get("public_key"),
                "allowed_ips": req.get("allowed_ips"), "name": req.get("name"),
            }) + "\n")
    except Exception:
        pass   # auditing must never fail the operation


# ───────────────────────── operations ─────────────────────────

def op_describe(cfg, req):
    out = {"hostname": os.uname().nodename, "agent_version": VERSION, "interfaces": {}}
    want = req.get("iface")
    for iface, ic in cfg.get("interfaces", {}).items():
        if want and iface != want:
            continue
        iface_line, peers = parse_dump(wg_dump(ic, iface))
        info = parse_interface_section(read_conf(ic["conf"]))
        net = iface_net(info)
        port = int(iface_line[2]) if len(iface_line) > 2 and iface_line[2].isdigit() else None
        out["interfaces"][iface] = {
            "public_key": iface_line[1] if len(iface_line) > 1 else None,
            "listen_port": port,
            "endpoint": f"{cfg.get('endpoint_host', '')}:{port}" if port else None,
            "address": str(net),
            "subnet": str(net.network),
            "peer_count": len(peers),
            "used_ips": sorted(used_ips(peers)),
            "awg_params": awg_params(info),
            "dns": cfg.get("dns", []),
        }
    return out


def op_list_peers(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    _, peers = parse_dump(wg_dump(ic, iface))
    return {"iface": iface, "peers": peers}


def op_next_ip(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    _, peers = parse_dump(wg_dump(ic, iface))
    info = parse_interface_section(read_conf(ic["conf"]))
    return {"iface": iface, "next_ip": next_free_ip(info, peers) + "/32"}


def op_add_peer(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    pub = req.get("public_key", "")
    if not PUBKEY_RE.match(pub):
        raise AgentError("bad_pubkey", "public_key is not a valid WireGuard key")
    allowed = req.get("allowed_ips", "")
    name = req.get("name")
    psk_req = req.get("preshared_key", "auto")

    info = parse_interface_section(read_conf(ic["conf"]))
    iface_line, peers = parse_dump(wg_dump(ic, iface))

    if any(p["public_key"] == pub for p in peers):
        raise AgentError("peer_exists", "a peer with this public key already exists")

    # IP is always explicit; validate in-subnet, not the server, not taken — EXCEPT a default-route peer
    # (0.0.0.0/0 or ::/0). That's a mesh/cascade peer carrying arbitrary destinations into the link: it dials
    # out (endpoint) and its AllowedIPs is intentionally the whole internet, not an address in the link /31.
    # (op_set_peer_allowed flips an existing peer to /0; this lets the very FIRST add already carry /0 — needed
    # when the iface is rebuilt, e.g. after a reboot, while the cascade is already active.)
    members = [c.strip() for c in allowed.split(",") if c.strip()]
    if not members or not all("/" in m for m in members):
        raise AgentError("bad_request", "allowed_ips must be CIDR(s), e.g. 10.0.0.5/32")
    net = iface_net(info)
    # A default-route member (0.0.0.0/0 or ::/0) marks a mesh/cascade peer that carries arbitrary destinations
    # into the link — exempt from the in-subnet address checks (it dials out; its AllowedIPs is the whole internet).
    if not any(m in ("0.0.0.0/0", "::/0") for m in members):
        # Validate the peer's TUNNEL address: the member whose host IP is INSIDE the interface subnet. A peer may
        # legitimately also carry routed subnets outside the link's range (e.g. a LAN behind it), so check the
        # in-subnet member specifically rather than blindly the first CIDR — and reject if NONE is in-subnet
        # (that's the record mismatch the panel flags as "broken"; the node refuses it too, as defence in depth).
        in_sub = []
        for m in members:
            _ip = m.split("/")[0]
            try:
                _a = ipaddress.ip_address(_ip)
            except ValueError:
                raise AgentError("bad_request", f"invalid ip {_ip}")
            if _a in net.network:
                in_sub.append(_ip)
        if not in_sub:
            raise AgentError("bad_request", f"no address in {allowed} is inside subnet {net.network}")
        for ip in in_sub:
            if ip == str(net.ip):
                raise AgentError("ip_in_use", f"{ip} is the server address")
            if ip in used_ips(peers):
                raise AgentError("ip_in_use", f"{ip} already assigned")

    # PSK: default auto-generate; explicit value honored; "none"/false disables.
    if psk_req in (None, "none", False):
        psk = None
    elif psk_req in ("auto", "", True):
        psk = gen_psk(ic)
    else:
        psk = psk_req

    # mesh/node-to-node peers also dial out: an Endpoint + keepalive (user peers send neither)
    endpoint = (req.get("endpoint") or "").strip() or None
    ka = req.get("persistent_keepalive")
    try:
        ka = int(ka) if ka else None
    except (TypeError, ValueError):
        ka = None

    # 1) apply to the running interface (surgical — never touches other peers)
    args = ic["cmd"] + ["set", iface, "peer", pub, "allowed-ips", allowed]
    if endpoint:
        args += ["endpoint", endpoint]
    if ka:
        args += ["persistent-keepalive", str(ka)]
    if psk:
        args += ["preshared-key", "/dev/stdin"]
    run(args, input_text=(psk + "\n") if psk else None)

    # 2) persist to the conf
    append_peer_to_conf(ic["conf"], pub, psk, allowed, name, endpoint=endpoint, keepalive=ka)
    if endpoint:                        # a mesh/link peer (dials out) → keep its conf reboot-safe for the cascade
        ensure_table_off_in_conf(ic["conf"])

    port = int(iface_line[2]) if len(iface_line) > 2 and iface_line[2].isdigit() else None
    return {
        "public_key": pub,
        "allowed_ips": allowed,
        "preshared_key": psk,
        "server_public_key": iface_line[1] if len(iface_line) > 1 else None,
        "endpoint": f"{cfg.get('endpoint_host', '')}:{port}" if port else None,
        "awg_params": awg_params(info),
        "dns": cfg.get("dns", []),
    }


def op_set_peer_allowed(cfg, req):
    """Replace an EXISTING peer's AllowedIPs (live + conf). Used by the cascade to flip a mesh peer
    between the link /32 and 0.0.0.0/0 (entry) or to add forwarded subnets (exit). `awg set ... allowed-ips`
    is surgical and does NOT touch routing tables, so applying 0.0.0.0/0 live is safe; when the peer carries
    a default route we also ensure `Table = off` in the conf first, so the next bring-up won't hijack egress."""
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    pub = req.get("public_key", "")
    if not PUBKEY_RE.match(pub):
        raise AgentError("bad_pubkey", "public_key is not a valid WireGuard key")
    allowed = (req.get("allowed_ips") or "").strip()
    if not allowed or "/" not in allowed.split(",")[0]:
        raise AgentError("bad_request", "allowed_ips must be CIDR(s), e.g. 0.0.0.0/0 or 10.8.0.0/24")
    is_default = any(c.strip() in ("0.0.0.0/0", "::/0") for c in allowed.split(","))
    if is_default:                                  # persist Table=off BEFORE any future bring-up sees the /0
        ensure_table_off_in_conf(ic["conf"])
    run(ic["cmd"] + ["set", iface, "peer", pub, "allowed-ips", allowed])   # surgical live replace (no routing change)
    rewrite_peer_allowed_in_conf(ic["conf"], pub, allowed)
    return {"iface": iface, "public_key": pub, "allowed_ips": allowed}


def op_remove_peer(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    pub = req.get("public_key", "")
    if not PUBKEY_RE.match(pub):
        raise AgentError("bad_pubkey", "public_key is not a valid WireGuard key")
    _, peers = parse_dump(wg_dump(ic, iface))
    match = next((p for p in peers if p["public_key"] == pub), None)
    if not match:
        raise AgentError("peer_not_found", "no peer with this public key")
    run(ic["cmd"] + ["set", iface, "peer", pub, "remove"])
    remove_peer_from_conf(ic["conf"], pub)
    return {"removed": pub, "freed_ip": match["allowed_ips"]}


def set_awg_in_conf(path, awg):
    """Replace the AmneziaWG param lines in the first [Interface] section with `awg` (dict)."""
    keyset = set(AWG_KEYS)
    lines = read_conf(path).splitlines()
    out, in_iface = [], False
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]")
            out.append(line)
            if in_iface:
                for k in AWG_KEYS:
                    if k in awg:
                        out.append(f"{k} = {awg[k]}")
            continue
        if in_iface and "=" in s and s.split("=", 1)[0].strip() in keyset:
            continue   # drop the old awg param line
        out.append(line)
    write_conf_atomic(path, "\n".join(out).rstrip("\n") + "\n")


def op_set_iface(cfg, req):
    """Change the interface's UDP listen port and/or AmneziaWG obfuscation params on the live
    interface + its .conf. Peers (keys / AllowedIPs) are untouched; existing client tunnels
    reconnect via the panel-rendered Endpoint / new params."""
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    out = {"iface": iface}
    if req.get("listen_port") is not None:
        try:
            port = int(req.get("listen_port"))
        except (TypeError, ValueError):
            raise AgentError("bad_request", "listen_port must be a number")
        if not (1 <= port <= 65535):
            raise AgentError("bad_request", "listen_port out of range (1-65535)")
        with contextlib.suppress(Exception):
            run(ic["cmd"] + ["set", iface, "listen-port", str(port)])   # live, best-effort (iface may be DOWN)
        set_listen_port_in_conf(ic["conf"], port)                        # persist ALWAYS — applies on next bring-up
        out["listen_port"] = port
    awg = req.get("awg_params")
    if isinstance(awg, dict) and awg:
        awg = {k: str(awg[k]) for k in AWG_KEYS if k in awg and str(awg.get(k, "")) != ""}
        if awg:
            # apply live where the awg tool supports it (best-effort), then persist to the conf
            args = ic["cmd"] + ["set", iface]
            for k in AWG_KEYS:
                if k in awg:
                    args += [k.lower(), awg[k]]
            with contextlib.suppress(Exception):
                run(args)
            set_awg_in_conf(ic["conf"], awg)
            out["awg_params"] = awg
    if len(out) == 1:
        raise AgentError("bad_request", "nothing to set")
    return out


# ── egress rules: the up/down hooks a managed interface's conf carries ───────────────────────────
# One rule, two shapes: the up REAPS THEN ADDS (so the chain ends with exactly one copy however many
# were there), the down reaps. Both loops are BOUNDED — a `-D` that reports success without deleting
# would wedge a tear-down for ever.
#
# ⚠️ Deliberately NOT `-C … || -A …`, which is the obvious way to write an idempotent add and is
# WRONG here. Measured on a NixOS node, iptables 1.8.11 (nf_tables): `-C FORWARD -i zzz999 -o ens3
# -j ACCEPT` returns 0 — for an interface that exists nowhere on the box — as does `-i zzz999 -o
# zzz998`, while `-i zzz999 -j DROP` and a port check correctly return 1. A two-interface ACCEPT
# check matches on shape, not on the names. A guard that says "already there" about a rule that is
# not there SKIPS it, and the interface silently comes up without its forward rules. Delete-then-add
# needs no such judgement: it converges from any starting state.
_IPT_REAP_TRIES = 8

def _ipt_reap(table, rule):
    t = (table + " ") if table else ""
    return ("for _n in " + " ".join(str(i) for i in range(1, _IPT_REAP_TRIES + 1))
            + f"; do iptables {t}-D {rule} 2>/dev/null || break; done")

def _ipt_set(table, rule):
    """Exactly one copy of `rule`, whatever was there before."""
    t = (table + " ") if table else ""
    return _ipt_reap(table, rule) + f"; iptables {t}-A {rule} || true"


def _wan_iface():
    out = run(["ip", "-4", "route", "get", "1.1.1.1"], check=False)
    m = re.search(r" dev (\S+)", out or "")
    return m.group(1) if m else "eth0"


def _ensure_tool(tool):
    """Require the wg/awg tools to be present. We can't install them from here: the swg-noded service
    is sandboxed (ProtectSystem/ProtectHome make /usr and /root read-only, so apt + add-apt-repository
    fail) and the agent has a short timeout.

    The advice deliberately does NOT name the amnezia PPA any more. That PPA is Launchpad — Ubuntu-only, so
    it cannot work on Debian at all, and even on Ubuntu `add-apt-repository` dies with an unreadable Python
    traceback ("'NoneType' object has no attribute 'people'") whenever Launchpad's API is unreachable, which
    is exactly what one operator hit. The installer now builds tools and the kernel module from source on
    any distro and falls back to the userspace datapath, so "re-run the installer" is both correct
    everywhere and the shortest true answer.

    Each message is a FIXED sentence with nothing interpolated, so the panel can translate it by catalogue
    lookup like any other string — node messages otherwise arrive as untranslated English inside a
    translated page.
    """
    have, quick = shutil.which(tool), shutil.which(tool + "-quick")
    if have and quick:
        return
    if tool == "wg":
        raise AgentError("no_tool", "WireGuard tools are not installed on this node. Install them with your "
                         "package manager (on Debian/Ubuntu: apt-get install -y wireguard), then this "
                         "interface creates itself on the next sync.")
    # Distinguish "nothing installed" from "half installed": awg without awg-quick is a real and confusing
    # state that reads from the panel exactly like the tools being absent.
    if have and not quick:
        if _IN_CONTAINER:
            raise AgentError("no_tool", "This node's container image has awg but not awg-quick. Update the node "
                             "(docker compose pull && docker compose up -d) so it runs a current swg-node image, "
                             "then this interface creates itself on the next sync.")
        raise AgentError("no_tool", "AmneziaWG is only half-installed on this node: awg is present but "
                         "awg-quick is missing. Re-run the swgPanel node installer — it builds both from "
                         "source — then this interface creates itself on the next sync.")
    # A DOCKER node gets its tools from the swg-node image, which fails its own build unless awg, awg-quick
    # and amneziawg-go are all present — so this should be unreachable there. If it ever is, "re-run the
    # installer" is the wrong instruction: nothing on the host owns those binaries. Pull the image instead.
    if _IN_CONTAINER:
        raise AgentError("no_tool", "AmneziaWG tools are missing from this node's container image. Update the "
                         "node (docker compose pull && docker compose up -d) so it runs a current swg-node "
                         "image, then this interface creates itself on the next sync.")
    # "Re-run the installer" is the wrong instruction where the installation is declared elsewhere:
    # there is no installer to re-run, and one that ran would be invisible to the next rebuild. The
    # read-only unit directory is the signal — a capability, not a distro name (a host whose units we
    # cannot write is a host whose packages we have no business telling anyone to install by hand).
    # Fixed sentence with nothing interpolated, like its sibling above, so the panel can translate it.
    if not _units_persist():
        raise AgentError("no_tool", "AmneziaWG tools are not installed on this node, and this node's "
                         "installation is managed declaratively — re-running an installer would not "
                         "survive its next rebuild. Add the AmneziaWG tools to the system configuration "
                         "that declares this node and rebuild it, then this interface creates itself on "
                         "the next sync.")
    raise AgentError("no_tool", "AmneziaWG tools are not installed on this node. Re-run the swgPanel node "
                     "installer — it builds them from source on any distribution, and falls back to the "
                     "userspace datapath where the kernel module cannot load. Then this interface creates "
                     "itself on the next sync.")


def _awg_obfuscation():
    """Mirror install-host.sh's awg_obfuscation: random S1–S4, four disjoint H1–H4 bands, fixed I1–I5."""
    s1 = 15 + random.randint(0, 135); s2 = 15 + random.randint(0, 135)
    while s2 == s1 or s2 == s1 + 56:
        s2 = 15 + random.randint(0, 135)
    s3 = 15 + random.randint(0, 85); s4 = 15 + random.randint(0, 85)
    b = [base + random.randint(0, 899999999) for base in (5, 1000000000, 2000000000, 3000000000)]
    w = 15
    return ("Jc = 4\nJmin = 40\nJmax = 70\n"
            f"S1 = {s1}\nS2 = {s2}\nS3 = {s3}\nS4 = {s4}\n"
            f"H1 = {b[0]}-{b[0] + w}\nH2 = {b[1]}-{b[1] + w}\nH3 = {b[2]}-{b[2] + w}\nH4 = {b[3]}-{b[3] + w}\n"
            "I1 = <b 0xc000000001><r 64><t>\nI2 = <r 24><t>\nI3 = <r 32>\n"
            "I4 = <b 0xc000000001><r 32><t>\nI5 = <t><r 48>\n")


# Same test swg-noded makes (NODE_KIND): the agent otherwise has no idea it is inside a container, and where a
# conf may safely live depends entirely on that.
_IN_CONTAINER = os.path.exists("/.dockerenv") or os.path.exists("/run/.containerenv")

_UNIT_DIR = "/etc/systemd/system"
_UNIT_PERSIST = {"v": None}


def _units_persist():
    """Can a unit enabled here survive a reboot — i.e. is the systemd unit directory writable?

    On a host that keeps its units in a read-only store (NixOS, and any other immutable-OS layout)
    it is not, and `systemctl enable awg-quick@<iface>` cannot work there however it is spelled:
    systemd resolves the .wants symlink into the system scope, which is the read-only part.

    ⚠️ A REAL write probe, and it reads errno. os.access(..., W_OK) is not enough: as root it calls
    a mode-555 directory writable, because root bypasses the mode check. It does honour a read-only
    mount, so on NixOS it would happen to be right — by accident of which mechanism that host uses.
    A write answers both, and tells us WHY it failed, which is what the messages below turn on.

    Boot persistence is not lost on those hosts: the node's own bootstrap walks the conf directory
    and brings every persisted interface up before the daemon starts.
    """
    if _UNIT_PERSIST["v"] is None:
        probe = os.path.join(_UNIT_DIR, ".swg-agent-unit-probe")
        try:
            with open(probe, "w"):
                pass
            os.unlink(probe)
            _UNIT_PERSIST["v"] = True
        except OSError as e:
            # ⚠️ EROFS is the ONLY failure that means "this host's units are declared elsewhere".
            # EACCES means we are not privileged — a different problem with a different fix, and an
            # operator told to go edit their configuration.nix over it would be sent somewhere with
            # nothing to find. ENOENT (no such directory, e.g. inside a container) is not it either.
            # Anything but EROFS keeps today's behaviour: try, and let it fail harmlessly.
            _UNIT_PERSIST["v"] = getattr(e, "errno", None) != errno.EROFS
    return _UNIT_PERSIST["v"]


def _iface_unit(action, tool, iface):
    """enable/disable an interface's <tool>-quick@ unit, where that can mean anything.

    Skipped outright on a read-only unit directory rather than fired and swallowed: the call cannot
    succeed there, and a swallowed failure is the shape that gets read later as "we did it"."""
    if not _units_persist():
        return
    with contextlib.suppress(Exception):
        run(["systemctl", action, f"{tool}-quick@{iface}"], check=False)


def op_create_iface(cfg, req):
    """Create a BRAND-NEW wg/awg interface natively (kernel on bare-metal, userspace in a node
    container): genkey, write the .conf (Address from the given subnet, ListenPort, MTU, auto-NAT
    out the WAN, AWG obfuscation for awg), bring it up via <tool>-quick. Rolls back the conf if
    bring-up fails. The caller (swg-noded) then records {cmd, conf} so the panel manages it."""
    iface = (req.get("iface") or "").strip()
    req_tool = (req.get("cmd") or ["awg"])[0]
    add_obf = (req_tool == "awg")               # genuine AmneziaWG → obfuscation; plain WireGuard → none
    # use the requested tool if it's here; otherwise fall back to awg (amneziawg-go does plain WG too,
    # e.g. a node container ships only awg/awg-quick). A plain awg conf is WireGuard-compatible.
    have = lambda t: bool(shutil.which(t) and shutil.which(t + "-quick"))
    tool = req_tool if have(req_tool) else ("awg" if have("awg") else req_tool)
    cmd = [tool]
    if not iface or "/" in iface or " " in iface:
        raise AgentError("bad_request", "invalid interface name")
    try:
        net = ipaddress.ip_network(req.get("subnet") or "", strict=False)
    except Exception:
        raise AgentError("bad_request", "subnet must be a CIDR like 10.8.0.0/24")
    try:
        port = int(req.get("listen_port") or 51820)
    except (TypeError, ValueError):
        raise AgentError("bad_request", "listen_port must be a number")
    mtu = str(req.get("mtu") or "1280")
    _ensure_tool(tool)                          # install wg/awg tools if this node doesn't have them yet
    # On a container node ONLY /etc/amnezia/amneziawg is a bind-mount that outlives a container recreate;
    # /etc/wireguard is container-local. A plain-WG conf written there is destroyed by the next update while the
    # interface itself survives in the host netns — so the node comes back to a live device it has no conf for,
    # classifies it as somebody else's (adoption candidate), stops reporting it, and the panel shows the
    # interface as missing. AmneziaWG never hit this because its directory IS the mount.
    conf_dir = "/etc/amnezia/amneziawg" if (tool == "awg" or _IN_CONTAINER) else "/etc/wireguard"
    conf = os.path.join(conf_dir, iface + ".conf")
    if os.path.exists(conf):
        raise AgentError("exists", f"{conf} already exists")
    os.makedirs(conf_dir, exist_ok=True)
    # A supplied private_key RECREATES the interface with its ORIGINAL identity (Restore of a vanished iface —
    # key from the node's own backup or the operator vault); absent → genkey a brand-new interface.
    priv = (req.get("private_key") or "").strip()
    if not priv:
        priv = run(cmd + ["genkey"]).strip()
        if not priv:
            raise AgentError("internal", f"{tool} genkey produced no key")
    pub = run(cmd + ["pubkey"], input_text=priv + "\n").strip()
    ov_addr = (req.get("address") or "").strip()   # explicit iface address (mesh /31 ends differ per side)
    if ov_addr:
        try:
            addr = str(ipaddress.ip_interface(ov_addr))
        except Exception:
            raise AgentError("bad_request", "address must be CIDR like 10.99.0.0/31")
    else:
        addr = f"{net.network_address + 1}/{net.prefixlen}"
    wan = _wan_iface()
    # NAT is BEST-EFFORT (each step `|| true`) so the interface still comes up where iptables/nat
    # isn't available (e.g. some containers) — matching node-entrypoint.sh's non-fatal NAT. A failed
    # rule just means clients won't egress until NAT is sorted; it never blocks bring-up.
    # ONE COPY, NOT ONE MORE. iptables appends without checking and wg-quick's
    # PostDown deletes exactly one copy, so every bring-up that was not preceded by a matching
    # tear-down — a container stopped, a bare↔docker convert, an `ip link del`, a crash — left a
    # permanent extra copy, and a later delete could never clear more than one of them. Measured on a
    # 45-day-old node: twelve MASQUERADE rules, for subnets whose interfaces were long gone, beside a
    # box that had exactly one interface. Reaping on the way UP as well as down means a bring-up
    # converges the chain from any state — including the pile an install made before this fix.
    up = (f"sysctl -q -w net.ipv4.ip_forward=1 || true; "
          f"{_ipt_set('-t nat', f'POSTROUTING -s {net} -o {wan} -j MASQUERADE')}; "
          f"{_ipt_set('', f'FORWARD -i %i -o {wan} -j ACCEPT')}; "
          f"{_ipt_set('', f'FORWARD -i {wan} -o %i -m state --state RELATED,ESTABLISHED -j ACCEPT')}")
    down = (f"{_ipt_reap('-t nat', f'POSTROUTING -s {net} -o {wan} -j MASQUERADE')}; "
            f"{_ipt_reap('', f'FORWARD -i %i -o {wan} -j ACCEPT')}; "
            f"{_ipt_reap('', f'FORWARD -i {wan} -o %i -m state --state RELATED,ESTABLISHED -j ACCEPT')}; true")
    # ⚠️ The conf SAYS WHICH PROTOCOL IT IS. Everything else that could answer is circumstantial: the
    # directory is not (a container writes every conf to the AmneziaWG one, so a plain-WireGuard conf
    # that has been through one comes back as `awg` and the panel re-badges it), and the content is not
    # either — an AmneziaWG conf with no obfuscation set is byte-identical in shape to a WireGuard one,
    # which is exactly the case that cannot be guessed. A comment line travels with the file, through a
    # move, a convert, a run-model switch or a manual copy between boxes, and both wg-quick and
    # awg-quick ignore it. Same shape as #swg:onboarded.
    body = (f"#swg:cmd {tool}\n"
            f"[Interface]\nPrivateKey = {priv}\nAddress = {addr}\nListenPort = {port}\nMTU = {mtu}\n"
            f"PostUp = {up}\nPostDown = {down}\n")
    if (req.get("table") or "").strip().lower() == "off":   # mesh link: cascade manages routing — wg-quick must
        body += "Table = off\n"                              # NOT install AllowedIPs routes (a /0 would hijack default)
    if tool == "awg" and add_obf:               # only genuine AmneziaWG gets obfuscation params
        # RESTORE reuses the ORIGINAL obfuscation params (baked into every client) — never regenerate, or the
        # recreated interface won't speak the clients' handshake. A brand-new create gets fresh random params.
        supp = req.get("awg_params") if isinstance(req.get("awg_params"), dict) else None
        supp = {k: str(supp[k]) for k in AWG_KEYS if supp and str(supp.get(k, "")) != ""} if supp else None
        # A supplied set may be PARTIAL: the panel sends only the fields an operator filled into the defaults and
        # leaves the rest to us. Generate the full set first and overlay what arrived, or a blank field would
        # vanish from the conf altogether — an awg interface with no S/H is not obfuscated at all.
        #
        # …but ONLY the caller knows which kind of set it sent. A TAKE-OVER reads somebody else's conf and passes
        # back exactly the keys it found, which for a server built by an older AmneziaWG is Jc/Jmin/Jmax/S1/S2/H1–H4
        # and nothing else. Filling the rest from _awg_obfuscation() then hands the interface S3/S4 and our fixed
        # I1–I5 — junk the clients baked into their configs know nothing about. The handshake still completes (it
        # rides on the keys that DID match), so the server looks healthy and every existing client silently stops
        # passing data. `awg_params_exact` says "this set is the whole truth": write those keys and invent none.
        if supp and req.get("awg_params_exact"):
            body += "".join(f"{k} = {supp[k]}\n" for k in AWG_KEYS if k in supp)
        elif supp:
            _gen = _awg_obfuscation()
            _out = []
            for _ln in _gen.splitlines():
                _k = _ln.split("=")[0].strip()
                _out.append(f"{_k} = {supp[_k]}" if _k in supp else _ln)
            _seen = {l.split("=")[0].strip() for l in _out}
            _out += [f"{k} = {supp[k]}" for k in AWG_KEYS if k in supp and k not in _seen]
            body += "\n".join(_out) + "\n"
        else:
            body += _awg_obfuscation()
    write_conf_atomic(conf, body)
    # `wg-quick up <name>` resolves the name against /etc/wireguard and NOWHERE else, so moving the file to the
    # mount would break the bring-up it is supposed to enable. Link the name back into that directory: every
    # by-name call (up here, down/restart later, and wg-quick's own `wg setconf`) keeps working, while the file
    # that must survive a container recreate sits on the volume. The link is container-local and disposable —
    # after a recreate it is gone, the conf is not, and the node re-adopts the live interface from it.
    link = ""
    if conf_dir != "/etc/wireguard" and tool != "awg":
        link = os.path.join("/etc/wireguard", iface + ".conf")
        try:
            os.makedirs("/etc/wireguard", exist_ok=True)
            if os.path.islink(link) or os.path.exists(link):
                os.unlink(link)
            os.symlink(conf, link)
        except OSError as e:
            with contextlib.suppress(Exception):
                os.unlink(conf)
            raise AgentError("link_fail", f"couldn't link {link} -> {conf}: {e}")
    try:
        run([tool + "-quick", "up", iface])
    except Exception as e:
        with contextlib.suppress(Exception):
            os.unlink(conf)
        if link:
            with contextlib.suppress(Exception):
                os.unlink(link)
        msg = str(e)
        # "Unknown device type" / "Protocol not supported" == the kernel datapath module isn't loadable (the awg
        # DKMS module never built against this kernel, or a kernel upgrade left it stale). The agent is sandboxed
        # (can't apt-install), so translate the cryptic failure into the exact fix instead of blaming the port.
        if "Unknown device type" in msg or "Protocol not supported" in msg:
            kr = os.uname().release
            mod = "amneziawg" if tool == "awg" else "wireguard"
            # Same signal as _ensure_tool: where we cannot write a unit, the host's packages are
            # declared somewhere else and an apt-get line is an instruction that cannot stick. The
            # module has to come from the SAME kernel package set as the running kernel, which is
            # the whole difficulty on such a host, so say that rather than a command that will not
            # apply. This message interpolates (kernel release), so it is not catalogue-translated
            # either way and adds no i18n key.
            if not _units_persist():
                raise AgentError("no_module",
                                 f"the {mod} kernel module isn't built or loaded on this node (kernel {kr}), "
                                 f"and this node's installation is managed declaratively. Add the module to the "
                                 f"system configuration that declares this node — it must come from the same "
                                 f"kernel package set as the running kernel (on NixOS: "
                                 f"boot.extraModulePackages = [ config.boot.kernelPackages.{mod} ];) — and "
                                 f"rebuild. The userspace datapath is the fallback if the module lags your "
                                 f"kernel. Then the interface creates automatically on the next sync.")
            if tool == "awg":
                how = (f"sudo apt-get install -y dkms linux-headers-{kr} && "
                       f"sudo apt-get install -y amneziawg && sudo modprobe amneziawg")
            else:
                how = "sudo apt-get install -y wireguard && sudo modprobe wireguard"
            raise AgentError("no_module",
                             f"the {mod} kernel module isn't built/loaded "
                             f"on this node (kernel {kr}) — its DKMS module needs matching linux-headers. Run on the "
                             f"node:  {how}  — then the interface creates automatically on the next sync. "
                             f"(Re-running the node installer, or swg-update, does this for you.)")
        # "already exists" == a DEVICE of that name is already on the box — nothing to do with the port or the
        # subnet, which is what the generic message below blames and what sends the operator hunting the wrong
        # thing. It happens when an interface outlived the config that owned it (a convert, a manual `ip link
        # add`, a half-removed install): the device is still up, usually still holding its ORIGINAL key, so
        # adopting it keeps every existing client working while creating over it cannot.
        if "already exists" in msg.lower():
            raise AgentError("name_taken",
                             f"an interface named {iface} already exists on this node, so it can't be created. "
                             f"It isn't managed here — adopt it instead (that keeps its current key, so its "
                             f"peers keep working), or remove the device first if you really want a new one.")
        raise AgentError("up_failed", f"{tool}-quick up {iface} failed (port/subnet may be in use): {e}")
    _iface_unit("enable", tool, iface)
    return {"iface": iface, "public_key": pub, "address": addr, "conf": conf, "cmd": cmd, "listen_port": port}


_EGRESS_MASQ_RE = re.compile(r"-s (\S+) -o (\S+) -j MASQUERADE")

def _reap_egress_rules(conf_text, iface):
    """Delete EVERY copy of the egress rules this interface's conf installs, not just the one its
    PostDown takes.

    The hooks a conf carries are fixed when the interface is CREATED, so an install made before they
    became idempotent keeps piling up a copy per unmatched bring-up and can never clear more than one
    per tear-down — which is how a node ends up source-NATing subnets that have no interface. This is
    code, not conf, so it reaches those installs on the next update: read the subnet and the WAN out
    of the conf the interface actually used (never today's `ip route get`, which may name a different
    NIC than the rules were written with), and delete until each rule is gone. Best-effort — a node
    without iptables just has nothing to reap."""
    m = _EGRESS_MASQ_RE.search(conf_text or "")
    if not m:
        return
    net, wan = m.group(1), m.group(2)
    for args in (["-t", "nat", "-D", "POSTROUTING", "-s", net, "-o", wan, "-j", "MASQUERADE"],
                 ["-D", "FORWARD", "-i", iface, "-o", wan, "-j", "ACCEPT"],
                 ["-D", "FORWARD", "-i", wan, "-o", iface, "-m", "state",
                  "--state", "RELATED,ESTABLISHED", "-j", "ACCEPT"]):
        for _ in range(_IPT_REAP_TRIES):
            try:
                if subprocess.run(["iptables"] + args, capture_output=True, text=True).returncode != 0:
                    break
            except Exception:
                break


def op_delete_iface(cfg, req):
    """Tear a managed interface down and forget it: <tool>-quick down, remove its .conf, disable its
    unit. Destroys the interface, its server keypair, and all its peers on this node. Best-effort on
    each step so a partially-up interface still gets cleaned up."""
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)            # raises if it isn't managed here
    tool = (ic.get("cmd") or ["awg"])[0]
    conf_text = ""
    with contextlib.suppress(Exception):
        conf_text = read_conf(ic["conf"])          # read BEFORE the down — the reap needs the rules it wrote
    with contextlib.suppress(Exception):
        run([tool + "-quick", "down", iface])
    _reap_egress_rules(conf_text, iface)           # the down hook takes one copy; this takes the rest
    _iface_unit("disable", tool, iface)
    with contextlib.suppress(Exception):
        os.remove(ic["conf"])
    return {"iface": iface, "deleted": True}


def op_restart_iface(cfg, req):
    """Bounce a managed interface: <tool>-quick down (ignored if already down) then up — recovers a
    DOWN interface (e.g. one whose bring-up failed). Re-raises an up failure so the panel sees why."""
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)             # raises if it isn't managed here
    tool = (ic.get("cmd") or ["awg"])[0]
    with contextlib.suppress(Exception):
        run([tool + "-quick", "down", iface])
    try:
        run([tool + "-quick", "up", iface])
    except Exception as e:
        raise AgentError("up_failed", f"{tool}-quick up {iface} failed: {e}")
    return {"iface": iface, "restarted": True}


def op_stop_iface(cfg, req):
    """Stop a managed interface and keep it down: <tool>-quick down + disable its unit (so it doesn't
    come back on reboot). The .conf is KEPT — op_start_iface brings it back. Best-effort down."""
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)             # raises if it isn't managed here
    tool = (ic.get("cmd") or ["awg"])[0]
    with contextlib.suppress(Exception):
        run([tool + "-quick", "down", iface])
    _iface_unit("disable", tool, iface)
    return {"iface": iface, "stopped": True}


def op_start_iface(cfg, req):
    """Start a stopped interface: <tool>-quick up + re-enable its unit. Re-raises an up failure."""
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)             # raises if it isn't managed here
    tool = (ic.get("cmd") or ["awg"])[0]
    try:
        run([tool + "-quick", "up", iface])
    except Exception as e:
        raise AgentError("up_failed", f"{tool}-quick up {iface} failed: {e}")
    _iface_unit("enable", tool, iface)
    return {"iface": iface, "started": True}


def op_restore_iface_key(cfg, req):
    """Revert an interface to its blessed identity from the node's on-disk backup: rewrite the conf's
    [Interface] PrivateKey (+ Address + ListenPort), then bounce so the original server key is live."""
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)                 # raises if it isn't managed here
    priv = (req.get("private_key") or "").strip()
    if not priv:
        raise AgentError("bad_request", "private_key required")
    fields = {"PrivateKey": priv}
    if req.get("address"):
        fields["Address"] = req["address"]
    if req.get("listen_port"):
        fields["ListenPort"] = str(req["listen_port"])
    set_iface_fields_in_conf(ic["conf"], fields)
    tool = (ic.get("cmd") or ["awg"])[0]
    with contextlib.suppress(Exception):
        run([tool + "-quick", "down", iface])
    try:
        run([tool + "-quick", "up", iface])
    except Exception as e:
        raise AgentError("up_failed", f"{tool}-quick up {iface} failed after key restore: {e}")
    return {"iface": iface, "restored": True}


