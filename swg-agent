def respond(ok, op, data=None, error=None, code=None):
    out = {"ok": ok, "op": op}
    if ok:
        out["data"] = data
    else:
        out["error"] = error
        out["code"] = code
    print(json.dumps(out))
    sys.exit(0 if ok else 1)


