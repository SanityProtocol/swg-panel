_TURN_READ = {"at": 0.0}
def _read_units_live(svcs):
    """Batched read of the live .service ExecStart for several units (one host call). svc -> unit text."""
    if not svcs:
        return {}
    cmd = "; ".join("printf '@@SWG@@%s\\n' " + shlex.quote(s) + "; cat " + shlex.quote(_turn_unit_path(s)) + " 2>/dev/null"
                    for s in svcs)
    out = host_sh(cmd).stdout or ""
    res = {}; cur = None; buf = []
    for ln in out.splitlines():
        if ln.startswith("@@SWG@@"):
            if cur is not None:
                res[cur] = "\n".join(buf)
            cur = ln[len("@@SWG@@"):]; buf = []
        elif cur is not None:
            buf.append(ln)
    if cur is not None:
        res[cur] = "\n".join(buf)
    return res

def _list_turn_units():
    """Bare-metal turn-proxy services present on disk (vk-turn-proxy-*.service).
    None on a read error (so the caller keeps the record rather than wiping it); [] means genuinely none.

    BOTH unit directories, not just the probed one: on a host where /etc/systemd/system is read-only
    our units live in /run, and a host that changed state between reboots can have them in either.
    Scanning one dir would report "no turn proxies" for a node that plainly has them — the
    found-nothing-vs-could-not-look trap, in the direction that silently wipes the record."""
    seen, ok = [], False
    for d in (UNIT_DIR_PERSIST, UNIT_DIR_RUNTIME):
        try:
            files = os.listdir(d)
        except OSError:
            continue
        ok = True
        seen += [f[:-len(".service")] for f in files
                 if f.startswith("vk-turn-proxy-") and f.endswith(".service")]
    return sorted(set(seen)) if ok else None

TURN_PENDING_DIR = "/var/lib/swg-noded/turn-pending"   # an installer/convert drops "<svc>" here (listen\nconnect\nowner) WHILE setting a turn-proxy up
def _turn_installing_markers():
    """Turn-proxies an installer/convert is actively setting up right now (fresh markers only, < 5min — a
    crashed installer's stale marker is ignored). svc -> {listen, connect, owner}. Surfaced as 'installing'."""
    out = {}
    try:
        names = os.listdir(TURN_PENDING_DIR)
    except OSError:
        return out
    for f in names:
        p = os.path.join(TURN_PENDING_DIR, f)
        try:
            if time.time() - os.path.getmtime(p) > 300:
                continue
            with open(p) as fh:
                ls = fh.read().splitlines()
        except OSError:
            continue
        out[f] = {"listen": (ls[0] if len(ls) > 0 else ""), "connect": (ls[1] if len(ls) > 1 else ""), "owner": (ls[2] if len(ls) > 2 else "")}
    return out

TURN_CAP_TABLE = "swg_turn"        # our own inet nft table: capture each turn-proxy's REMOTE PEER IPs (UDP + TCP) into a dynamic set
TURN_PEER_TTL  = "3m"              # a captured peer IP lingers this long past its last packet, then auto-prunes (online is wg-tracked)
TURN_CAP_SIG   = "v3-peer"         # bump when the table/rule SHAPE changes → forces a one-time rebuild of the capture table
_GW_CACHE = {"at": 0.0, "ips": frozenset()}


def _default_gateways():
    """Default-route gateway IP(s), cached ~60s. Excluded from captured peer IPs: a bridge-net docker install that
    SNATs inbound (userland-proxy) makes EVERY peer appear as the container's gateway — so recording it would be
    wrong. Dropping it degrades that config honestly to 'no peer IP' instead of a bogus 172.x.x.1."""
    now = time.time()
    if now - _GW_CACHE["at"] < 60:
        return _GW_CACHE["ips"]
    gws = set(re.findall(r"via (\d+\.\d+\.\d+\.\d+)", (run(["ip", "route", "show", "default"]).stdout or "")))
    _GW_CACHE["at"] = now; _GW_CACHE["ips"] = frozenset(gws)
    return _GW_CACHE["ips"]


def _is_peer_ip(ip):
    """A capturable turn PEER source: keep public AND private/internal (a LAN/internal deployment is valid), but
    drop the SNAT gateway artifact + loopback/link-local/unspecified/reserved/multicast (never a real remote peer)."""
    if ip in _default_gateways():
        return False
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return False
    return not (a.is_loopback or a.is_link_local or a.is_unspecified or a.is_reserved or a.is_multicast)


def _ensure_turn_capture(ports):
    """Keep an nft `swg_turn` table whose prerouting rule records each turn-proxy's REMOTE PEER IP into a dynamic,
    self-expiring set `peers` (key = src-ip . dst-port). A turn-proxy is a pure listener (-listen <pub>:<port>
    -connect 127.0.0.1:<wg>) and the client never dials it directly: the client talks to a VK TURN server, which
    relays to us. So the party sending to the listen port IS the VK relay, and that is what we record.

    Three clauses do the filtering, and all three are load-bearing:
      · `ct direction original` — the flow was opened TOWARD the proxy. Without it we also match NAT REPLY packets:
        turn ports are allocated from 56000-56999, which sits inside ip_local_port_range (32768-60999), so a
        masqueraded peer's (or the node's own) outbound connection can be assigned source port 56004 — and the
        reply then lands on `WAN:56004`. We hook prerouting at mangle priority (-150), BEFORE nf_nat un-translates
        at -100, so such a packet still reads as dst-port 56004 here even though it belongs to a different socket
        entirely and the proxy never receives it. That is what filed Instagram/Yandex/Telegram as "turn IPs".
      · `fib daddr type local` — the packet is addressed to US, not merely transiting (a tunnelled peer dialling
        someone else's :5600x would otherwise file its own 10.x address).
      · `ct state established` — the proxy actually answered, so an unparsed scanner probe never becomes a record.

    Works for UDP (which `ss` can't see — a proxy serves every peer from one unconnected socket) AND TCP, is read as
    O(turn-peers) (only OUR set, not the whole socket/conntrack table), and needs no extra package. `ports` = wanted
    turn listen ports. Runs in swg-noded's netns → bare-metal + host-net docker see all turn traffic; a bridge-net
    node is isolated (best-effort: works if docker preserves the peer src, else the SNAT gateway is filtered on read)."""
    want = sorted({int(p) for p in ports if str(p).isdigit()})
    exists = run(["nft", "list", "table", "inet", TURN_CAP_TABLE]).returncode == 0
    sigf = os.path.join(STATE_DIR, ".turn-cap-sig")
    prev = ""
    with contextlib.suppress(Exception):
        prev = open(sigf).read().strip()
    if exists and prev != TURN_CAP_SIG:                            # rule/table shape changed → rebuild once
        run(["nft", "delete", "table", "inet", TURN_CAP_TABLE]); exists = False
    if not want:                                                   # no turn proxies → tear the table down
        if exists:
            run(["nft", "delete", "table", "inet", TURN_CAP_TABLE])
        return
    if not exists:
        run(["nft", "add", "table", "inet", TURN_CAP_TABLE])
        run(["nft", "add", "set", "inet", TURN_CAP_TABLE, "ports", "{ type inet_service; }"])
        run(["nft", "add", "set", "inet", TURN_CAP_TABLE, "peers",
             "{ type ipv4_addr . inet_service; flags dynamic,timeout; timeout " + TURN_PEER_TTL + "; }"])
        run(["nft", "add", "chain", "inet", TURN_CAP_TABLE, "pre",   # prerouting @ mangle priority → sees the peer src before any DNAT
             "{ type filter hook prerouting priority mangle; policy accept; }"])
        run(["nft", "add", "rule", "inet", TURN_CAP_TABLE, "pre",    # non-terminal: record the src-ip.dport of flows opened TO us, packet continues
             "meta l4proto { tcp, udp } th dport @ports fib daddr type local "
             "ct direction original ct state established update @peers { ip saddr . th dport }"])
        with contextlib.suppress(OSError):
            os.makedirs(STATE_DIR, exist_ok=True); open(sigf, "w").write(TURN_CAP_SIG)
    out = run(["nft", "list", "set", "inet", TURN_CAP_TABLE, "ports"]).stdout or ""   # sync @ports to the wanted list (drift-gated)
    m = re.search(r"elements = \{([^}]*)\}", out)
    cur = {int(x) for x in re.findall(r"\d+", m.group(1))} if m else set()
    if cur != set(want):
        run(["nft", "flush", "set", "inet", TURN_CAP_TABLE, "ports"])
        run(["nft", "add", "element", "inet", TURN_CAP_TABLE, "ports", "{ " + ", ".join(str(p) for p in want) + " }"])


def _turn_peer_ips():
    """port(str) → set(real peer src IPs — the VK relays fronting this proxy), read from OUR nft capture set
    (elements look like `203.0.113.9 . 56006 expires …`), filtered to genuine remote peers (drops the SNAT
    gateway + non-routable artifacts)."""
    m = {}
    out = run(["nft", "list", "set", "inet", TURN_CAP_TABLE, "peers"]).stdout or ""
    mm = re.search(r"elements = \{(.*)\}", out, re.S)
    if mm:
        for el in mm.group(1).split(","):
            g = re.search(r"([0-9.]+)\s*\.\s*(\d+)", el)
            if g and _is_peer_ip(g.group(1)):
                m.setdefault(g.group(2), set()).add(g.group(1))
    return m


def _attach_turn_src_ips(tp):
    """Attach src_ips (unique remote PEER source IPs — the VK relays) to each turn-proxy by matching its listen PORT
    against OUR nft capture set (see _ensure_turn_capture — works for UDP and TCP). The wire field keeps its
    `src_ips` name: it is snapshot transport a mixed-version panel already reads, and renaming it would blank the
    grid on either side of an upgrade. Best-effort — any failure leaves src_ips unset."""
    with contextlib.suppress(Exception):
        # The capture set covers EVERY turn-family listen port — the turn-proxies here AND the self-contained
        # VK-turn servers (WDTT + csqtt), which also sit behind a VK relay. ONE ensure over the union so a second
        # pass can't evict the others; the WDTT/csqtt snapshot entries read the same @peers set (build_snapshot).
        sc_ports = []
        with contextlib.suppress(Exception):
            sc_ports = [str((v or {}).get("listen") or "").rsplit(":", 1)[-1]
                        for v in list((_wdtt_load() or {}).values()) + list((_csqtt_load() or {}).values())]
        turn_ports = [str(t.get("listen") or "").rsplit(":", 1)[-1] for t in (tp or [])]
        allp = [p for p in (turn_ports + sc_ports) if p]
        if not allp:
            _ensure_turn_capture([])                               # nothing turn-family → drop the capture table
            return
        _ensure_turn_capture(allp)
        cmap = _turn_peer_ips()
        for t in (tp or []):
            lp = str(t.get("listen") or "").rsplit(":", 1)[-1]
            if lp.isdigit():
                t["src_ips"] = sorted(cmap.get(lp, ()))


def _service_of_pid(pid):
    """The systemd turn-proxy unit owning a pid → its service name (vk-turn-proxy-<fork>-<port>), via cgroup."""
    try:
        with open("/proc/%s/cgroup" % pid) as f:
            m = re.search(r"(vk-turn-proxy-[^/\s.]+)", f.read())
        return m.group(1) if m else ""
    except Exception:
        return ""


def _attach_turn_wg_sports(tp):
    """Attach wg_sports — the localhost SOURCE ports this proxy uses to reach its wg backend. A wg peer that came
    in via a proxy has endpoint 127.0.0.1:<one of these ports>, so the panel can tell WHICH proxy a client used
    even when several proxies front the SAME interface (else it'd guess the first). Transport-agnostic (the
    proxy→wg side is always a normal connected socket); grouped by owning unit via /proc/<pid>/cgroup. Best-effort."""
    with contextlib.suppress(Exception):
        if not tp:
            return
        by_svc = {}
        for proto in ("-t", "-u"):
            try:
                r = subprocess.run(["ss", "-Hnp", proto, "state", "established"], capture_output=True, text=True, timeout=5)
            except Exception:
                continue
            for line in (r.stdout or "").splitlines():
                mp = re.search(r"pid=(\d+)", line)
                loop = re.findall(r"127\.0\.0\.1:(\d+)", line)   # LOCAL then PEER, both loopback on a proxy→wg conn
                if not mp or len(loop) < 2:
                    continue
                svc = _service_of_pid(mp.group(1))
                if svc:
                    by_svc.setdefault(svc, set()).add(loop[0])   # loop[0] = LOCAL = the source port wg sees as the endpoint
        for t in tp:
            svc = t.get("service") or ""
            if svc in by_svc:
                t["wg_sports"] = sorted(by_svc[svc])


def load_turn_proxies():
    """Turn-proxies installed on this box — listen/connect/wrap_key/params. Refreshed from the LIVE
    .service files (throttled) so direct edits on the server show up on the panel."""
    try:
        with open(TURN_RECORD) as f:
            d = json.load(f)
        tp = d.get("turn_proxies") if isinstance(d, dict) else None
        tp = tp if isinstance(tp, list) else []
    except Exception:
        return []
    if TURN_DOCKER:                 # container model — the record IS the config; just flag running via docker ps
        # defensive dedup: collapse any same-service duplicates (last wins, like apply_turn / bare-metal) so a
        # hand-edited or round-tripped record can't surface a proxy twice or have two entries fight one container.
        seen = {}; uniq = []
        for t in tp:
            s = t.get("service")
            if not s:
                continue
            if s in seen:
                uniq[seen[s]] = t
            else:
                seen[s] = len(uniq); uniq.append(t)
        tp = uniq
        _dturn_attach_running(tp)
        _attach_turn_version(tp)
        _attach_turn_src_ips(tp)
        _attach_turn_wg_sports(tp)
        return tp
    nowt = time.time()
    on_disk = _list_turn_units()   # bare-metal: the units on disk are the source of truth — reconcile the list
    if on_disk is not None:        # to them so convert/installer/hand-created units show (and deleted ones drop)
        rec_by = {t.get("service"): t for t in tp if t.get("service")}
        tp = [rec_by.get(svc) or {"service": svc} for svc in on_disk]
    if TURN_MANAGE_ON and (any("params" not in t for t in tp) or nowt - _TURN_READ["at"] >= 20):
        units = _read_units_live([t["service"] for t in tp if t.get("service")])
        changed = False
        for t in tp:
            u = units.get(t.get("service"))
            if not u:
                continue
            live = _tp_from_unit(t["service"], u)
            for k in ("listen", "connect", "wrap_key", "params"):
                if t.get(k) != live.get(k):
                    t[k] = live.get(k); changed = True
        _TURN_READ["at"] = nowt
        if changed:
            with contextlib.suppress(Exception):
                tmp = TURN_RECORD + ".tmp"
                with open(tmp, "w") as f:
                    json.dump({"turn_proxies": tp}, f)
                os.replace(tmp, TURN_RECORD)
    _attach_turn_running(tp)
    _attach_turn_version(tp)
    _attach_turn_src_ips(tp)
    _attach_turn_wg_sports(tp)
    marks = _turn_installing_markers()   # an installer/convert is setting these up → show "installing" (synthetic entry if no unit yet)
    if marks:
        have = {t.get("service") for t in tp}
        for svc, m in marks.items():
            if svc in have:
                for t in tp:
                    if t.get("service") == svc and t.get("running") is not True:
                        t["installing"] = True
            else:
                tp.append({"service": svc, "listen": m["listen"], "connect": m["connect"],
                           "owner": m["owner"], "running": False, "installing": True})
    with _TURN_JOBS_LOCK:                                   # async reinstall/update in flight → surface as "updating"
        _active = {s for s, j in _TURN_JOBS.items() if not j.get("done")}
        _fin = {s for s, j in _TURN_JOBS.items() if j.get("done")}
        for s in [s for s in _fin if time.time() - _TURN_JOBS[s].get("at", 0) > 120]:
            _TURN_JOBS.pop(s, None)                         # safety: don't leak a done job apply_turn never got to consume
    for svc in _fin:
        NODE_PROGRESS.pop(svc, None)                        # finished → drop the transient note (apply_turn reports the result)
    for svc in _active:
        NODE_PROGRESS[svc] = "updating…"
        if not any(t.get("service") == svc for t in tp):
            tp.append({"service": svc, "running": False, "installing": True})
        for t in tp:
            if t.get("service") == svc:
                t["installing"] = True
    return tp

_TURN_RUN = {"at": 0.0, "map": {}}
def _attach_turn_running(tps):
    """Live `running` flag per turn-proxy (one batched `systemctl is-active`, throttled to 20s) so the
    panel can grey out a crash-looping service (e.g. a -listen IP not local → bind fails)."""
    svcs = [t["service"] for t in tps if t.get("service")]
    if not svcs or not TURN_MANAGE_ON:
        return
    nowt = time.time()
    if nowt - _TURN_RUN["at"] >= 20:
        cmd = "for s in " + " ".join(shlex.quote(s) for s in svcs) + \
              "; do printf '%s=%s\\n' \"$s\" \"$(systemctl is-active \"$s\" 2>/dev/null)\"; done"
        m = {}
        for ln in (host_sh(cmd).stdout or "").splitlines():
            s, _, state = ln.partition("=")
            if s:
                m[s] = (state.strip() == "active")
        _TURN_RUN["at"] = nowt; _TURN_RUN["map"] = m
    for t in tps:
        if t.get("service") in _TURN_RUN["map"]:
            t["running"] = _TURN_RUN["map"][t["service"]]


def _node_addrs():
    """[(dev, ip)] for the node's non-loopback, non-tunnel/bridge IPv4 addresses — the shared parse behind
    list_node_ips / _ip_ifaces / _ifaces. One `ip -o addr show` instead of three per snapshot."""
    out = []
    try:
        raw = run(["ip", "-4", "-o", "addr", "show"]).stdout
    except Exception:
        return out
    for ln in raw.splitlines():
        p = ln.split()
        if len(p) < 4 or p[2] != "inet":
            continue
        dev, ip = p[1], p[3].split("/")[0]
        if dev == "lo" or dev.startswith(("wg", "awg", "swg_", "dawg", "docker", "br-", "veth", "kube", "cni", "flannel")):
            continue
        if ip.startswith("127."):
            continue
        out.append((dev, ip))
    return out


def list_node_ips(addrs=None):
    """The node's own IPv4 addresses (candidates for a per-interface egress/source IP), excluding
    loopback + tunnel/bridge devices. On a docker host-net node this is the HOST's addresses."""
    ips = []
    for dev, ip in (addrs if addrs is not None else _node_addrs()):
        if ip not in ips:
            ips.append(ip)
    return ips


def list_node_ip_ifaces(addrs=None):
    """The node's (ipv4, nic) pairs — for the merged egress picker (a source IP always lives on a NIC)."""
    pairs = []
    for dev, ip in (addrs if addrs is not None else _node_addrs()):
        if not any(x["ip"] == ip for x in pairs):
            pairs.append({"ip": ip, "iface": dev})
    return pairs


def list_node_ifaces(addrs=None):
    """The node's WAN-candidate NIC names (devices carrying a non-loopback IPv4) — for the egress -o."""
    ifs = []
    for dev, ip in (addrs if addrs is not None else _node_addrs()):
        if dev not in ifs:
            ifs.append(dev)
    return ifs


def _detect_wan():
    out = run(["sh", "-c", "ip -4 route get 1.1.1.1 2>/dev/null"]).stdout
    m = re.search(r" dev (\S+)", out or "")
    return m.group(1) if m else "eth0"


def _iface_subnet(node_cfg, iface):
    """The interface's tunnel subnet (CIDR) read from its conf Address — for the egress SNAT match."""
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    try:
        with open(ic.get("conf", "")) as f:
            m = re.search(r"(?im)^\s*Address\s*=\s*([^\s,]+)", f.read())
    except Exception:
        return ""
    if not m:
        return ""
    import ipaddress
    try:
        return str(ipaddress.ip_network(m.group(1), strict=False))
    except Exception:
        return ""


def _comment_re(tag):
    """Match a `--comment <tag>` in `iptables -S` output. iptables QUOTES comments (--comment "tag"),
    but some builds don't — match either form. Getting this wrong makes the "does this rule already
    exist?" check always miss, so the reconcile appends a fresh duplicate every cycle → the POSTROUTING
    chain explodes into tens of thousands of rules and listing it pins the CPU."""
    return re.compile(r'--comment "?' + re.escape(tag) + r'"?(?:\s|$)')


def _snat_reconcile_rule(tag, subnet, des, rules):
    """Ensure exactly one tagged SNAT/MASQUERADE POSTROUTING rule for `subnet`, inserted at the head
    (ahead of any default MASQUERADE). des = ("SNAT", wan, ip) | ("MASQUERADE", wan, "") | None (no rule).
    `rules` = current `iptables -t nat -S POSTROUTING` lines. Returns (changed: bool, error: str|None).
    Shared by reconcile_egress (local-iface SNAT) and reconcile_cascade (exit forwarded-subnet SNAT)."""
    _re = _comment_re(tag)
    existing = [ln for ln in rules if _re.search(ln)]
    # The MATCHED SOURCE is part of the rule's identity, not just its action: an interface can keep its name and
    # WAN while its SUBNET changes (a WDTT instance's wg_addr is editable, and _wdtt_params_changed supports it).
    # Comparing only action/-o/--to-source declared such a rule "already correct" and left it matching the OLD
    # subnet forever — clients on the new one then connect fine but get NO internet, because nothing NATs them.
    def _norm(c):
        c = (c or "").strip()
        if not c:
            return ""
        with contextlib.suppress(Exception):
            return str(ipaddress.ip_network(c, strict=False))
        return c
    cur = None
    if existing:
        o = re.search(r"-o (\S+)", existing[0]); src = re.search(r"--to-source (\S+)", existing[0])
        s = re.search(r"-s (\S+)", existing[0])
        cur = ("SNAT" if "SNAT" in existing[0] else "MASQUERADE", o.group(1) if o else "",
               src.group(1) if src else "", _norm(s.group(1) if s else ""))
    want = (des[0], des[1], des[2], _norm(subnet)) if des else None
    if cur == want:
        return (False, None)
    for ln in existing:                                   # drop stale rule(s)
        run(["sh", "-c", "iptables -t nat " + ln.replace("-A POSTROUTING", "-D POSTROUTING", 1)])
    if des:
        args = ["iptables", "-t", "nat", "-I", "POSTROUTING", "-s", subnet, "-o", des[1],
                "-m", "comment", "--comment", tag, "-j", des[0]]
        if des[0] == "SNAT":
            args += ["--to-source", des[2]]
        r = run(args)
        if r.returncode != 0:
            return (False, (r.stderr or "").strip()[:120])
    return (True, None)


def _has_foreign_egress(subnet, rules):
    """True if some NON-swg-egress POSTROUTING rule already source-NATs `subnet` (a legacy .conf PostUp
    MASQUERADE, or a hand-added rule). Lets the baseline heal DEFER to an existing working rule instead of
    stacking a duplicate — so it only fills genuine gaps and never churns against PostUp."""
    pat = re.compile(r'-s ' + re.escape(subnet) + r'(?:\s|$)')
    for ln in rules:
        if not ln.startswith("-A POSTROUTING") or "swg-egress:" in ln:
            continue                                          # our own tag is not "foreign"
        if pat.search(ln) and ("MASQUERADE" in ln or "SNAT" in ln):
            return True
    return False


def _iface_is_mesh(node_cfg, iface, subnet):
    """A node↔node mesh/cascade link — NOT a client-serving interface, so it must never get a client egress
    MASQUERADE (cascade owns its routing). Detected purely LOCALLY (the node-sync `desired_ifaces` is a sparse
    push-delta and doesn't carry `system`): the reserved link-name prefix, a point-to-point /31(+) subnet, or
    `Table = off` in its .conf (wg-quick mesh links set it)."""
    if iface.startswith("swg_"):
        return True
    try:
        if int(str(subnet).rsplit("/", 1)[1]) >= 31:
            return True
    except Exception:
        pass
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    try:
        with open(ic.get("conf", "")) as f:
            if re.search(r"(?im)^\s*Table\s*=\s*off\b", f.read()):
                return True
    except Exception:
        pass
    return False


def reconcile_egress(node_cfg, desired_ifaces, default_egress_ip=""):
    """Per LOCAL interface, ensure its egress source-NAT, tagged 'swg-egress:<iface>' (inserted ahead of any
    default MASQUERADE), replaced on change, removed when cleared. Cases, in order:
      egress_ip set        → SNAT to that source IP        (Option-I, from desired_ifaces)
      node default_egress  → SNAT to the node default IP
      wan_iface pinned     → MASQUERADE out that NIC        (from desired_ifaces)
      plain default        → MASQUERADE out the auto WAN    (baseline)
    The baseline exists because the panel documents blank egress_ip = "auto/MASQUERADE", yet that NAT historically
    lived ONLY in the interface's .conf PostUp — fire-once, so an interface brought up outside wg-quick (manual /
    onboarded / older create) or after an iptables flush has no SNAT and nothing re-adds it (handshake succeeds,
    panel shows live, traffic can't return). Owning a reconciled baseline self-heals that. Guards keep it safe:
      • never a node↔node mesh link (local detection — cascade owns those);
      • never when SOMETHING ELSE already source-NATs the subnet — a legacy PostUp MASQUERADE, a hand rule, or the
        cascade's swg-fwd-snat for a forward-mode iface — so it only fills genuine gaps, never duplicates or churns.
    Runs iptables directly (root on bare-metal; container root + NET_ADMIN + host netns on docker)."""
    res = {"changed": 0, "errors": []}
    try:
        rules = run(["iptables", "-t", "nat", "-S", "POSTROUTING"]).stdout.splitlines()
    except Exception as e:
        res["errors"].append("iptables list: " + str(e)); return res
    default_wan = _detect_wan()
    client_devs = []
    for iface in (node_cfg.get("interfaces") or {}):
        want = (desired_ifaces or {}).get(iface) or {}
        egress = (want.get("egress_ip") or "").strip()
        wan_ov = _safe_wan(want.get("wan_iface"), "")         # reject shell metachars before it enters an iptables rule
        subnet = _iface_subnet(node_cfg, iface)
        if not subnet:
            continue
        is_mesh = _iface_is_mesh(node_cfg, iface, subnet)
        if not is_mesh:
            client_devs.append(iface)                         # client tunnels also get FORWARD-accept + MSS-clamp (below)
        if egress:                                            # SNAT to a chosen source IP, out a chosen/auto WAN
            des = ("SNAT", wan_ov or default_wan, egress)
        elif default_egress_ip:                               # node-level default direct egress IP (fallback)
            des = ("SNAT", wan_ov or default_wan, default_egress_ip)
        elif wan_ov:                                          # just pin the WAN egress interface
            des = ("MASQUERADE", wan_ov, "")
        elif not is_mesh and not _has_foreign_egress(subnet, rules):   # baseline: a client interface must egress — heal a
            des = ("MASQUERADE", default_wan, "")             #   plain MASQUERADE, but never a mesh link and never when the
        else:                                                 #   subnet is already source-NATed (PostUp / cascade / hand)
            des = None
        changed, err = _snat_reconcile_rule("swg-egress:" + iface, subnet, des, rules)
        if err:
            res["errors"].append("egress " + iface + ": " + err); continue
        if changed:
            res["changed"] += 1
    # WDTT instances own their (built-in userspace-WG) interface and run with -no-nat → the node owns their
    # egress MASQUERADE + FORWARD/MSS, exactly like a client interface. Their subnet comes from the WDTT record
    # (wg_addr), not a wg-quick .conf, so they're reconciled here separately (never mesh; heal only genuine gaps).
    for _wif, _winst in _wdtt_load().items():
        _wsub = _wdtt_subnet(_winst.get("wg_addr") or "")
        if not _wsub:
            continue
        _wdes = ("MASQUERADE", default_wan, "") if not _has_foreign_egress(_wsub, rules) else None
        changed, err = _snat_reconcile_rule("swg-egress:" + _wif, _wsub, _wdes, rules)
        if err:
            res["errors"].append("egress " + _wif + ": " + err); continue
        if changed:
            res["changed"] += 1
        client_devs.append(_wif)
        # A qWDTT instance with RAW enabled owns a SECOND tunnel (its own TUN + subnet, no WireGuard). It runs
        # -no-nat like the wg one, so its egress is ours too — including the MSS clamp client_devs brings, which
        # upstream adds itself and our -no-nat gate skips.
        _wraw = _wdtt_raw(_winst)
        if _wraw:
            _rsub = _wdtt_subnet(_wraw[2])
            if _rsub:
                _rdes = ("MASQUERADE", default_wan, "") if not _has_foreign_egress(_rsub, rules) else None
                changed, err = _snat_reconcile_rule("swg-egress:" + _wraw[1], _rsub, _rdes, rules)
                if err:
                    res["errors"].append("egress " + _wraw[1] + ": " + err)
                else:
                    if changed:
                        res["changed"] += 1
                    client_devs.append(_wraw[1])
    # csqtt instances (raw-IP TUN, run with --no-nat) → the node owns their egress MASQUERADE + FORWARD/MSS too.
    # Their subnet comes from the csqtt record (tun_addr), same treatment as a WDTT instance / client interface.
    for _cif, _cinst in _csqtt_load().items():
        _csub = _csqtt_subnet(_cinst.get("tun_addr") or "")
        if not _csub:
            continue
        _cdes = ("MASQUERADE", default_wan, "") if not _has_foreign_egress(_csub, rules) else None
        changed, err = _snat_reconcile_rule("swg-egress:" + _cif, _csub, _cdes, rules)
        if err:
            res["errors"].append("egress " + _cif + ": " + err); continue
        if changed:
            res["changed"] += 1
        client_devs.append(_cif)
    # FORWARD-accept (belt-and-suspenders — harmless under the usual ACCEPT policy, load-bearing under DROP) and — the
    # real value — a TCP-MSS clamp TOWARD each client tunnel, so a website's return packets can't exceed the 1280 tunnel
    # MTU and silently blackhole ("connects but pages time out"). Applied to ALL client tunnels (PostUp never wrote an
    # MSS clamp), tagged apart from the cascade's link-dev rules; mesh links excluded (cascade owns theirs). Idempotent
    # + self-cleaning (drops tags for interfaces that go away) via _ensure_dev_rules.
    client_devs.sort()
    _ensure_dev_rules("filter", "FORWARD", "swg-egress-acl:", client_devs, res,
                      lambda d, direction: ["iptables", "-I", "FORWARD", direction, d,
                                            "-m", "comment", "--comment", "swg-egress-acl:" + d, "-j", "ACCEPT"])
    _ensure_dev_rules("mangle", "FORWARD", "swg-egress-mss:", client_devs, res,
                      lambda d, direction: (["iptables", "-t", "mangle", "-I", "FORWARD", "-o", d,
                                             "-p", "tcp", "--tcp-flags", "SYN,RST", "SYN",
                                             "-m", "comment", "--comment", "swg-egress-mss:" + d,
                                             "-j", "TCPMSS", "--clamp-mss-to-pmtu"] if direction == "-o" else None))
    return res


# ───────────────────────── Phase 2: traffic cascade ─────────────────────────
SWG_RT_BASE = 7000          # swg-owned policy-routing table id / ip-rule priority band [BASE, MAX]
SWG_RT_MAX = 7099           # (priority == table number; one table per egress target per node)
SMART_NFT_TABLE = "swg_smart"   # Phase 3: inet nft table holding the per-category dest sets + marking chain
SNI_NFQUEUE = 0                 # SNI mode: nft queues each connection's first packets here → swg-sni reads the ClientHello
SNI_MAP_PATH = "/var/lib/swg-noded/sni-map.json"   # domain→category map swg-noded writes for swg-sni to consume
SNI_RESET_MARK = 0x9999         # SNI mode: swg-sni stamps the FIRST ClientHello to a newly-learned dst with this skb mark;
#                                 a standing nft forward rule RSTs it so the client reconnects and the retry routes correctly
#                                 (outside the 7000-band fwmarks). Must match the value passed to swg-sni.
_SNI_PROC = {"p": None}         # the running swg-sni subprocess (SNI-mode classifier), or None
_SMART_MODE = {"m": None}       # the routing mode the panel last shipped (configured intent) — surfaced in smart_status for the panel's host-layer health view


def _cascade_want_sig(fwd, exit_, smart=None):
    """Canonical signature of the policy rules+routes a plan wants — same token shape as the live
    reader below, so an exact-match means 'no drift' and we skip the (gap-inducing) flush+rebuild."""
    sig = set()
    for e in fwd:
        T = str(e["table"]); sig.add(f"R|from|{e['subnet']}|{T}"); sig.add(f"T|{T}|default|{e['via_iface']}")
    for e in (smart or []):                            # smart entry = fwmark T → table T (default via link)
        T = str(e["table"]); sig.add(f"R|fwmark|{int(e['table'])}|{T}"); sig.add(f"T|{T}|default|{e['via_iface']}")
    for e in exit_:
        T = str(e["table"]); sig.add(f"R|to|{e['subnet']}|{T}"); sig.add(f"T|{T}|{e['subnet']}|{e['via_iface']}")
    return sig


def _cascade_live_sig(tables):
    """Canonical signature of our LIVE policy rules (band priorities) + routes in the given tables —
    parsed from `ip rule show` / `ip route show table T` so it's robust to iproute2's output wording."""
    sig = set()
    try:
        for line in run(["ip", "rule", "show"]).stdout.splitlines():
            mp = re.match(r"^\s*(\d+):\s+(.*)$", line)
            if not mp:
                continue
            pri = int(mp.group(1))
            if not (SWG_RT_BASE <= pri <= SWG_RT_MAX):
                continue
            body = mp.group(2)
            lk = re.search(r"lookup (\S+)", body); T = lk.group(1) if lk else str(pri)
            mto = re.search(r"\bto (\S+)", body); mfrom = re.search(r"\bfrom (\S+)", body)
            mfw = re.search(r"fwmark (0x[0-9a-fA-F]+|\d+)", body)
            if mfw:
                sig.add(f"R|fwmark|{int(mfw.group(1), 0)}|{T}")
            elif mto:
                sig.add(f"R|to|{mto.group(1)}|{T}")
            elif mfrom and mfrom.group(1) != "all":
                sig.add(f"R|from|{mfrom.group(1)}|{T}")
    except Exception:
        pass
    for T in tables:
        try:
            for line in run(["ip", "route", "show", "table", str(T)]).stdout.splitlines():
                toks = line.split()
                if not toks:
                    continue
                dev = toks[toks.index("dev") + 1] if "dev" in toks else ""
                sig.add(f"T|{T}|{toks[0]}|{dev}")
        except Exception:
            pass
    return sig


def _live_band_prios():
    out = []
    with contextlib.suppress(Exception):
        for line in run(["ip", "rule", "show"]).stdout.splitlines():
            mp = re.match(r"^\s*(\d+):", line)
            if mp and SWG_RT_BASE <= int(mp.group(1)) <= SWG_RT_MAX:
                out.append(int(mp.group(1)))
    return sorted(set(out))


def _ensure_fwd_iptables(fwd, exit_, default_wan, res, default_egress_ip=""):
    """Idempotent (no-churn) exit SNAT + FORWARD-accept + MSS-clamp for the link devices, tagged
    swg-fwd-{snat,acl,mss}:* so stale entries (after a forward→direct switch) are cleaned up. Traffic
    received from other nodes (the cascade/smart exit side) SNATs to the exit record's egress_ip, falling
    back to THIS node's default direct egress IP — so routed traffic appears as the exit node's chosen IP."""
    link_devs = sorted({e["via_iface"] for e in (fwd + exit_)})
    # 1) exit SNAT per forwarded subnet (diff via the shared helper) + drop stale tags
    try:
        nat = run(["iptables", "-t", "nat", "-S", "POSTROUTING"]).stdout.splitlines()
    except Exception as e:
        res["errors"].append("cascade nat list: " + str(e)); nat = []
    want_snat = set()
    for e in exit_:
        S = e["subnet"]; tag = "swg-fwd-snat:" + S; want_snat.add(tag)
        W = _safe_wan(e.get("wan_iface"), default_wan)     # reject shell metachars before it enters an iptables rule
        X = (e.get("egress_ip") or "").strip() or default_egress_ip
        des = ("SNAT", W, X) if X else ("MASQUERADE", W, "")
        _ch, err = _snat_reconcile_rule(tag, S, des, nat)
        if err:
            res["errors"].append("cascade snat " + S + ": " + err)
        elif _ch:
            res["changed"] += 1
    for ln in nat:                                              # remove SNAT tags no longer wanted
        mt = re.search(r'--comment "?(swg-fwd-snat:[^"\s]+)"?', ln)
        if mt and mt.group(1) not in want_snat and ln.startswith("-A POSTROUTING"):
            run(["sh", "-c", "iptables -t nat " + ln.replace("-A POSTROUTING", "-D POSTROUTING", 1)]); res["changed"] += 1
    # 2) FORWARD accept (filter) + 3) MSS clamp (mangle), present-or-absent per link dev
    _ensure_dev_rules("filter", "FORWARD", "swg-fwd-acl:", link_devs, res,
                      lambda d, direction: ["iptables", "-I", "FORWARD", direction, d,
                                            "-m", "comment", "--comment", "swg-fwd-acl:" + d, "-j", "ACCEPT"])
    _ensure_dev_rules("mangle", "FORWARD", "swg-fwd-mss:", link_devs, res,
                      lambda d, direction: (["iptables", "-t", "mangle", "-I", "FORWARD", "-o", d,
                                             "-p", "tcp", "--tcp-flags", "SYN,RST", "SYN",
                                             "-m", "comment", "--comment", "swg-fwd-mss:" + d,
                                             "-j", "TCPMSS", "--clamp-mss-to-pmtu"] if direction == "-o" else None))


def _ensure_dev_rules(table, chain, prefix, link_devs, res, mk):
    """Ensure the tagged per-device rules built by mk(dev, '-i'/'-o') exist (skip if present), and drop
    any tagged rule for a device no longer in link_devs. mk may return None for a direction to skip it."""
    targs = ["-t", table] if table != "filter" else []
    try:
        lines = run(["iptables"] + targs + ["-S", chain]).stdout.splitlines()
    except Exception as e:
        res["errors"].append(f"cascade {table} list: " + str(e)); return
    want = {prefix + d for d in link_devs}
    for d in link_devs:
        tag = prefix + d
        for direction in ("-i", "-o"):
            add = mk(d, direction)
            if add is None:
                continue
            if not any((tag in ln and f"{direction} {d}" in ln) for ln in lines):
                run(add)
                res["changed"] += 1
    for ln in lines:                                            # drop stale device tags
        mt = re.search(r'--comment "?(' + re.escape(prefix) + r'[^"\s]+)"?', ln)
        if mt and mt.group(1) not in want and ln.startswith("-A " + chain):
            run(["sh", "-c", "iptables " + " ".join(targs) + " " + ln.replace("-A " + chain, "-D " + chain, 1)]); res["changed"] += 1


def _smart_setname(cat):
    return "cat_" + re.sub(r"[^a-z0-9]", "_", str(cat).lower())


def _smart_learnsetname(cat):
    # Hybrid-SNI learned dst IPs live in their OWN per-cat set (flags timeout) so they auto-expire — separate from the
    # timeout-less interval cat_ set that holds the static geoip CIDRs. swg-sni must sanitise the cat identically.
    return "catl_" + re.sub(r"[^a-z0-9]", "_", str(cat).lower())


_LOOP = {"n": 0}                       # reconcile-loop counter — drives per-loop caches (bumped at the top of main's loop)
_SMART_TABLE = {"n": -1, "rc": 1, "out": "", "counts": {}, "setnames": set(), "bytes": {}}


def _smart_table():
    """`nft list table inet swg_smart` rendered AND parsed at most ONCE per reconcile loop, shared by
    smart_status + _ensure_smart_nft. Both the render (serializes every CIDR of every set — thousands for a
    geoip category like cat_ru) and the element-count parse (regex + split over that text) are O(set size), so
    doing them once instead of twice halves that cost. Nothing mutates the table between those two callers
    within a loop, so the shared result is current; the next loop bumps _LOOP and re-renders. Returns the
    cache dict: ["rc"], ["out"] (raw), ["counts"] {set:element_count}, ["setnames"] {set}."""
    if _SMART_TABLE["n"] != _LOOP["n"]:
        r = run(["nft", "list", "table", "inet", SMART_NFT_TABLE])
        out = r.stdout or ""
        counts, setnames, cbytes = {}, set(), {}
        if r.returncode == 0:
            setnames = set(re.findall(r"set (\S+) {", out))
            counts = {c: 0 for c in setnames}
            # nft nests the elements in a second brace pair — `set X { type…; elements = { CIDR, … } }` — so the
            # naive `set {(.*?)}` stops at the INNER `}` and always counts 0. Anchor on the elements block
            # instead (element CIDRs contain no braces). A wrong 0 here forces a full geo set reload EVERY cycle
            # (nft -f of thousands of CIDRs ≈ 250ms), because the reload guard is "count == 0 → (re)load".
            for m in re.finditer(r"set (\S+) {(?:[^}]*?elements = {([^}]*)})?", out, re.S):
                el = m.group(2)
                counts[m.group(1)] = len([x for x in el.split(",") if x.strip()]) if el else 0
            # DESTINATION STATS (free harvest): per-category named counters `counter c_<cat>_<up|dn> { packets P
            # bytes B }` — cumulative bytes since the counter object was created (survives chain rebuilds). See
            # _ensure_smart_nft's forward count chain. cat is the sanitised category id (== _smart_setname minus cat_).
            for cm in re.finditer(r"counter (c_[a-z0-9_]+) \{\s*packets \d+ bytes (\d+)", out):
                mm = re.match(r"c_(.+)_(up|dn)$", cm.group(1))
                if mm:
                    cbytes.setdefault(mm.group(1), {"up": 0, "dn": 0})[mm.group(2)] = int(cm.group(2))
        _SMART_TABLE.update(n=_LOOP["n"], rc=r.returncode, out=out, counts=counts, setnames=setnames, bytes=cbytes)
    return _SMART_TABLE


def _ensure_smart_nft(smart_e, categories, res, pin=False, v6_ifaces=(), reset_mark=0, queue=True, learn_ttl=3600):
    """Phase 3 marking: keep an inet table `swg_smart` with one interval set per category (populated from
    shipped geo CIDR lists — see _smart_geo_refresh) and a prerouting chain that marks
    `ip saddr <S> ip daddr @cat_<c> meta mark set <T>`. Idempotent + drift-gated (flush+rebuild the chain
    only when the wanted rule set changes, so steady-state never un-marks a packet mid-flight). Packets
    stay 100% kernel-routed (the mark feeds the `ip rule fwmark` band). v1 is IPv4-only (v6 leaks direct).

    pin=True (SNI mode): swg-sni fills the sets LIVE from TLS handshakes, so a connection's dst can enter its set
    mid-flight; decide+pin the mark ONCE per connection (ct state new → ct mark) and just restore it afterwards,
    so an in-flight flow is never rerouted (which would change its egress src IP and break it). Also emit an
    NFQUEUE rule feeding each connection's first packets to swg-sni for learning (fail-open bypass)."""
    cats = sorted(set(categories) | {e["category"] for e in smart_e})
    _t = _smart_table()                                         # shared per-loop render + parse (see smart_status)
    if not smart_e and not cats:                                # nothing wanted → tear our table down
        if _t["rc"] == 0:
            run(["nft", "delete", "table", "inet", SMART_NFT_TABLE]); res["changed"] += 1
        return {}
    body = _t["out"] if _t["rc"] == 0 else ""
    # one-shot migration: sets created before auto-merge can't get the flag in place (they're chain-referenced),
    # so if any of ours lacks it, rebuild the whole table once — afterwards every set has auto-merge and the
    # additive dnsmasq/custom-IP paths can't be rejected by an overlap. Stamp-guarded so it can never loop even
    # if some nft version omits the flag from `list` output; sets refill (geoip/dnsmasq) on the next passes.
    _am = os.path.join(GEO_DIR, ".automerge-migrated")
    if _t["rc"] == 0 and not os.path.exists(_am) and re.search(r"set \S+ {(?:(?!auto-merge|}).)*}", body, re.S):
        run(["nft", "delete", "table", "inet", SMART_NFT_TABLE]); res["changed"] += 1
        body = ""
    if not body:
        run(["nft", "add", "table", "inet", SMART_NFT_TABLE])
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True); open(_am, "w").write("1")
    have_sets = set(re.findall(r"set (\S+) {", body))
    for c in cats:                                              # one interval set per category ("all" is the catch-all → no set)
        if c == "all":
            continue
        sn = _smart_setname(c)
        if sn not in have_sets:
            run(["nft", "add", "set", "inet", SMART_NFT_TABLE, sn, "{ type ipv4_addr; flags interval; auto-merge; }"])
        if queue and _smart_learnsetname(c) not in have_sets:   # Hybrid-SNI: self-expiring learned-IP set (single IPs; TTL change handled in the rebuild block)
            run(["nft", "add", "set", "inet", SMART_NFT_TABLE, _smart_learnsetname(c),
                 "{ type ipv4_addr; flags timeout; timeout " + str(learn_ttl) + "s; }"])
    if "prerouting" not in re.findall(r"chain (\S+) {", body):
        run(["nft", "add", "chain", "inet", SMART_NFT_TABLE, "prerouting",
             "{ type filter hook prerouting priority mangle; policy accept; }"])
    # drift-gate the mark rules: want vs live (parsed from the chain), flush+rebuild only on change.
    # Category rules match a dest set; the "all" catch-all matches any dest but ONLY when still unmarked
    # (`meta mark 0x0`) and is emitted LAST, so specific categories win (first-match semantics).
    subnets = sorted({e["subnet"] for e in smart_e})
    # Ordered, first-match rules carrying a per-rule ACTION: exit=mark→mesh, direct=leave in-kernel (default route),
    # block=drop. Each specific rule ends in `return` so the FIRST match wins — a direct/block exception genuinely
    # overrides a later catch-all exit, and block is a real kill-switch (not a silent fall-through to direct). "all"
    # is the catch-all → emitted after the specific rules for its subnet. Order is preserved from the panel plan.
    spec = [e for e in smart_e if e["category"] != "all"]
    allr = [e for e in smart_e if e["category"] == "all"]
    want = [(e["subnet"], e["category"], e.get("action", "exit"), e.get("table")) for e in spec + allr]
    v6f = sorted(set(v6_ifaces))                                # smart routing is IPv4-only → drop forwarded v6 on these ifaces (fail-closed, no leak)
    sig = hashlib.sha1((("pin;" if pin else "") + ("q;" if queue else "") + json.dumps(want) + "|v6:" + ",".join(v6f) + "|rst:" + str(reset_mark) + ("|lttl:" + str(learn_ttl) if queue else "") + "|s9").encode()).hexdigest()[:16]   # s9: reverted the per-source blkd meter (its duplicate name killed the catl_blku drop rule → hybrid blocking broke); s7: +counter on the blku content-block drop; s6: +catl_ learned-IP sets (Hybrid-SNI TTL); s5 was +QUIC drop + SNI reset + queue-gate
    _sigf = os.path.join(GEO_DIR, ".smart-sig")
    try:
        stored = open(_sigf).read().strip()
    except OSError:
        stored = ""
    chain_present = "prerouting" in re.findall(r"chain (\S+) {", body)
    def _cbody(name):                                          # the rules inside one chain of our table (per-chain, so a full external flush is detected)
        m = re.search(r"chain " + name + r" \{(.*?)\n\s*\}", body, re.S)
        return m.group(1) if m else ""
    expect_pre = pin or any(a != "direct" for (_, _, a, _) in want)   # exit/block rules + pin (queue/restore) all emit `ip saddr` prerouting rules
    pre_ok = (not expect_pre) or ("saddr" in _cbody("prerouting"))
    fwd_ok = ((not v6f) or ("drop" in _cbody("forward"))) and ((not (pin and reset_mark)) or ("reject" in _cbody("forward")))
    if stored != sig or not chain_present or not pre_ok or not fwd_ok:   # drift-gate: signature change, or a chain was emptied externally
        stored = ""                                            # force the sig file to be rewritten below
        run(["nft", "flush", "chain", "inet", SMART_NFT_TABLE, "prerouting"])
        if queue:                                              # apply an ip_learning TTL change to the learned sets (an nft set's
            _ttlm = os.path.join(GEO_DIR, ".catl-ttl")         # default timeout is immutable live → destroy+recreate; chain just
            _prev = ""                                         # flushed above so catl_ is now unreferenced. Marker-gated: stable TTL never churns.
            with contextlib.suppress(Exception):
                _prev = open(_ttlm).read().strip()
            if _prev != str(learn_ttl):
                for c in cats:
                    if c == "all":
                        continue
                    ln = _smart_learnsetname(c)
                    run(["nft", "delete", "set", "inet", SMART_NFT_TABLE, ln])   # ok if absent
                    run(["nft", "add", "set", "inet", SMART_NFT_TABLE, ln,
                         "{ type ipv4_addr; flags timeout; timeout " + str(learn_ttl) + "s; }"])
                with contextlib.suppress(OSError):
                    os.makedirs(GEO_DIR, exist_ok=True); open(_ttlm, "w").write(str(learn_ttl))
        _ok = [True]                                            # a failed nft add must NOT persist the sig, so the rebuild retries next cycle
        def _add(*a):
            r = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "prerouting", *a])
            if r.returncode != 0:
                res["errors"].append("smart nft: " + (r.stderr or "").strip()[:120]); _ok[0] = False
            else:
                res["changed"] += 1
        if pin:
            # restore the per-connection pinned mark ONLY on the original direction (client→dst). Reply packets
            # (dst=a local client) must stay unmarked so they route via the main table back out the user iface —
            # else the fwmark rule sends the return traffic to table 7000 (the mesh) and it never reaches the client.
            _add("ct", "direction", "original", "meta", "mark", "set", "ct", "mark")
            for S in subnets:                                  # SNI can't parse the ENCRYPTED QUIC ClientHello → drop UDP/443 so HTTP/3 falls back to TCP (which swg-sni reads). No accuracy loss (TCP still routes by SNI/IP); just no HTTP/3 on smart ifaces.
                _add("ip", "saddr", S, "udp", "dport", "443", "drop")
        _new = ["ct", "state", "new"] if pin else []           # pin: decide once per connection at ct state new
        for (S, cat, act, T) in want:
            if cat == "all":                                   # catch-all — no dest set, emitted last for its subnet
                if act == "exit":
                    _add("ip", "saddr", S, *_new, "meta", "mark", "set", str(T), *(["ct", "mark", "set", str(T)] if pin else []))
                elif act == "block":                           # kill-switch: drop everything else (pin: only the new pkt, so an allowed flow's established pkts survive)
                    _add("ip", "saddr", S, *_new, "drop")
                continue                                        # direct catch-all → no rule (falls to the main/default route)
            # match the geoip CIDR set AND (Hybrid-SNI) the learned-IP set — a dst learned by swg-sni lives only in catl_
            for snm in [_smart_setname(cat)] + ([_smart_learnsetname(cat)] if queue else []):
                if act == "exit":
                    _add("ip", "saddr", S, *_new, "ip", "daddr", "@" + snm, "meta", "mark", "set", str(T), *(["ct", "mark", "set", str(T)] if pin else []), "return")
                elif act == "direct":
                    _add("ip", "saddr", S, *_new, "ip", "daddr", "@" + snm, "return")   # explicit direct exception (wins over a later catch-all exit)
                elif act == "block":
                    if str(cat).startswith("blku"):    # content-block union → aggregate COUNTER (growing "blocked" metric); zero
                        _add("ip", "saddr", S, "ip", "daddr", "@" + snm, "counter", "drop")   # CPU (only ticks on dropped pkts). Emitted
                        #                                                                       for BOTH cat_ and catl_ (Hybrid learned) sets
                    else:
                        _add("ip", "saddr", S, "ip", "daddr", "@" + snm, "drop")
        if pin and queue:                                       # feed each connection's first packets to swg-sni (userspace SNI); kernel-SNI reads them via xt_string instead → no queue
            for S in subnets:
                _add("ip", "saddr", S, "tcp", "dport", "443", "ct", "state", "established", "ct", "packets", "lt", "12", "queue", "num", str(SNI_NFQUEUE), "bypass")
        # IPv6 fail-closed: the marking above is IPv4-only, so a dual-stack client's v6 traffic would bypass smart
        # routing and leak out the entry node's WAN. DROP forwarded IPv6 on each smart interface (both directions).
        chains_now = re.findall(r"chain (\S+) {", body)
        want_fwd = bool(v6f) or bool(pin and reset_mark)   # forward chain hosts the v6 fail-closed drops AND the SNI reset
        if want_fwd:
            if "forward" not in chains_now:
                run(["nft", "add", "chain", "inet", SMART_NFT_TABLE, "forward", "{ type filter hook forward priority filter; policy accept; }"])
            run(["nft", "flush", "chain", "inet", SMART_NFT_TABLE, "forward"])
            if pin and reset_mark:                         # SNI first-hit RST: swg-sni stamped the FIRST ClientHello to a
                for S in subnets:                           # newly-learned dst with reset_mark → RST it so the client reconnects
                    run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "forward", "ip", "saddr", S, "tcp", "dport", "443",
                         "meta", "mark", hex(reset_mark), "counter", "reject", "with", "tcp", "reset"])   # counter = reset hit-rate (health); retry's SYN matches the set and routes correctly
            for ifn in v6f:
                run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "forward", "meta", "nfproto", "ipv6", "iifname", ifn, "drop"])
                run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "forward", "meta", "nfproto", "ipv6", "oifname", ifn, "drop"])
        elif "forward" in chains_now:
            run(["nft", "flush", "chain", "inet", SMART_NFT_TABLE, "forward"])
            run(["nft", "delete", "chain", "inet", SMART_NFT_TABLE, "forward"])
        if _ok[0]:                                             # only stamp the sig when every rule landed → a transient nft failure retries next cycle
            with contextlib.suppress(OSError):
                os.makedirs(GEO_DIR, exist_ok=True)
                open(_sigf, "w").write(sig)
    # drop sets we no longer want (a category was un-ticked, or 'ru' was split into 'ru_net'/'ru_blocked'): after the
    # chain rebuild above they're unreferenced, so delete them — else the stale set lingers with old IPs forever.
    wanted_sn = {_smart_setname(c) for c in cats if c != "all"}
    wanted_ln = {_smart_learnsetname(c) for c in cats if c != "all"}
    for sn in have_sets:
        if (sn.startswith("cat_") and sn not in wanted_sn) or (sn.startswith("catl_") and sn not in wanted_ln):
            if run(["nft", "delete", "set", "inet", SMART_NFT_TABLE, sn]).returncode == 0:   # still-referenced → fails, retried next pass
                res["changed"] += 1
    # ── DESTINATION STATS: per-category named byte counters + their own FORWARD count chain (harvested free by
    # _smart_table). Named counters are TABLE OBJECTS → they survive the marking-chain rebuilds above (bytes accrue;
    # reset only on full-table teardown/reboot). Counting lives in the FORWARD hook (priority mangle, count-only,
    # policy accept → falls through) so addresses are post-un-SNAT (download) / pre-SNAT (upload) — accurate for BOTH
    # direct and mesh-forwarded categories, exactly like the measured-internet lane. Blocked categories are dropped in
    # prerouting → never reach FORWARD → correctly count 0. Own drift-gate so it rebuilds only when (subnet,cat) changes;
    # the rebuild flushes RULES, never the counters. ──
    if body:                                                     # table exists this cycle
        # ALL-MATCH (no `return`): categories NEST (a yandex IP is also in the broad ru_net set; youtube ⊂ google),
        # and each must show its FULL total, so a byte counts in EVERY category it matches (overlap on purpose).
        # DESTINATION VIEW: count every category whose SET is POPULATED (enabled OR routed) on every smart-routed
        # subnet — DECOUPLED from the routing rules, so catch-all-forwarded YouTube still counts as YouTube; only
        # "unknown to every set" is uncategorized. Skip empty sets (no wasted per-packet lookup). The DISTINCT total
        # is the measured CLIENT traffic, never Σ categories. Cost ≈ 1 nftset lookup per populated category per
        # forwarded packet (all-match), bounded by how many categories you enable. Order irrelevant without `return`.
        subnets = sorted({e["subnet"] for e in smart_e})           # every client subnet under smart routing (incl catch-all)
        # In Hybrid-SNI a category's dsts can live ONLY in its learned set (catl_) with an empty geoip set (cat_),
        # so also count any ROUTED category when queueing — else swg-sni-learned traffic falls through to c_uncat.
        _routed_cats = {c for (_S, c, _a, _T) in want if c != "all"} if queue else set()
        count_cats = sorted(c for c in cats if c != "all" and (_t["counts"].get(_smart_setname(c), 0) > 0 or c in _routed_cats))
        catw = [(S, c) for S in subnets for c in count_cats]
        have_cnt = set(re.findall(r"counter (\S+) {", body))
        for c in count_cats:
            cn = "c_" + _smart_setname(c)[4:]                   # cat_<x> → c_<x>
            for d in ("up", "dn"):
                if cn + "_" + d not in have_cnt:
                    run(["nft", "add", "counter", "inet", SMART_NFT_TABLE, cn + "_" + d])
        for d in ("up", "dn"):                                  # UNCATEGORIZED bucket: client traffic matching no category set
            if count_cats and "c_uncat_" + d not in have_cnt:   # only meaningful when ≥1 category exists to be "un" of
                run(["nft", "add", "counter", "inet", SMART_NFT_TABLE, "c_uncat_" + d])
        csig = hashlib.sha1((json.dumps(catw) + "|d4|q" + str(int(bool(queue)))).encode()).hexdigest()[:16]   # d4: + ct-mark uncat exclusion (Kernel-SNI double-count); catl_ learned counting; q: engine gate
        _csigf = os.path.join(GEO_DIR, ".catcount-sig")
        try:
            cstored = open(_csigf).read().strip()
        except OSError:
            cstored = ""
        cc_present = "catcount" in re.findall(r"chain (\S+) {", body)
        if catw and (cstored != csig or not cc_present):
            if not cc_present:
                run(["nft", "add", "chain", "inet", SMART_NFT_TABLE, "catcount",
                     "{ type filter hook forward priority mangle; policy accept; }"])
            run(["nft", "flush", "chain", "inet", SMART_NFT_TABLE, "catcount"])
            cok = True
            for (S, c) in catw:                                 # no `return` → a byte counts in EVERY category it matches
                snm = _smart_setname(c); cn = "c_" + snm[4:]
                r1 = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catcount", "ip", "saddr", S, "ip", "daddr", "@" + snm, "counter", "name", cn + "_up"])
                r2 = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catcount", "ip", "daddr", S, "ip", "saddr", "@" + snm, "counter", "name", cn + "_dn"])
                if r1.returncode or r2.returncode:
                    cok = False
                if queue:                                       # Hybrid-SNI: swg-sni-learned dsts live in catl_<c> — tally them into the SAME
                    lnm = _smart_learnsetname(c)                # category counter, skipping any dst already in the geoip cat_ set (no double count)
                    r3 = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catcount", "ip", "saddr", S, "ip", "daddr", "@" + lnm, "ip", "daddr", "!=", "@" + snm, "counter", "name", cn + "_up"])
                    r4 = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catcount", "ip", "daddr", S, "ip", "saddr", "@" + lnm, "ip", "saddr", "!=", "@" + snm, "counter", "name", cn + "_dn"])
                    if r3.returncode or r4.returncode:
                        cok = False
            # catany: FIRST-MATCH mirror — a client byte that matches NO populated category set falls through to
            # c_uncat → the "Uncategorised" bar. Categorised bytes `return` early (already tallied in catcount). Ordered
            # per subnet: up cat-returns, then the up uncat catch-all; then the same for down. Subnet-scoped like catcount
            # (transit from other nodes not counted). Overlap can't derive this by subtraction, hence a dedicated pass.
            if "catany" not in re.findall(r"chain (\S+) {", body):
                run(["nft", "add", "chain", "inet", SMART_NFT_TABLE, "catany",
                     "{ type filter hook forward priority mangle; policy accept; }"])
            run(["nft", "flush", "chain", "inet", SMART_NFT_TABLE, "catany"])
            subs = sorted({S for (S, _c) in catw})
            cats_here = sorted({c for (_S, c) in catw})
            for S in subs:
                for c in cats_here:
                    snm = _smart_setname(c)
                    r = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "saddr", S, "ip", "daddr", "@" + snm, "return"])
                    if r.returncode: cok = False
                    if queue:                                   # a learned dst IS categorised → return early so it isn't tallied as uncat
                        r = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "saddr", S, "ip", "daddr", "@" + _smart_learnsetname(c), "return"])
                        if r.returncode: cok = False
                # Kernel-SNI categorises into swgk_<c> IPSETS (invisible to nft) but CONNMARKs the routed flow — so an
                # exit-marked byte IS categorised even when no nft set matched it; exclude it from uncat (else double count).
                run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "saddr", S, "ct", "mark", "!=", "0x0", "return"])
                run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "saddr", S, "counter", "name", "c_uncat_up", "return"])
                for c in cats_here:
                    snm = _smart_setname(c)
                    r = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "daddr", S, "ip", "saddr", "@" + snm, "return"])
                    if r.returncode: cok = False
                    if queue:
                        r = run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "daddr", S, "ip", "saddr", "@" + _smart_learnsetname(c), "return"])
                        if r.returncode: cok = False
                run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "daddr", S, "ct", "mark", "!=", "0x0", "return"])
                run(["nft", "add", "rule", "inet", SMART_NFT_TABLE, "catany", "ip", "daddr", S, "counter", "name", "c_uncat_dn", "return"])
            if cok:
                with contextlib.suppress(OSError):
                    open(_csigf, "w").write(csig)
        elif not catw and cc_present:                           # no smart categories left → drop the count chains (counters can linger, harmless)
            run(["nft", "flush", "chain", "inet", SMART_NFT_TABLE, "catcount"])
            run(["nft", "delete", "chain", "inet", SMART_NFT_TABLE, "catcount"])
            if "catany" in re.findall(r"chain (\S+) {", body):
                run(["nft", "flush", "chain", "inet", SMART_NFT_TABLE, "catany"])
                run(["nft", "delete", "chain", "inet", SMART_NFT_TABLE, "catany"])
    # per-set live element counts (so _smart_geo_refresh knows which need (re)loading — e.g. empty after a reboot).
    # Reuse the shared per-loop parse; if `body` was blanked above (auto-merge migration / table absent) the sets
    # were just dropped → report {} so every set is treated as empty and gets reloaded.
    return dict(_t["counts"]) if body else {}


# ── geo/domain lists: the node caches each routed category's CIDR list (<cat>.txt, → nft set) and domain list
#    (<cat>.doms, → dnsmasq) under GEO_DIR. Both files are resolved ON THE PANEL and PULLED FROM IT by
#    _panel_list_refresh — the node fetches NO routing list from GitHub (its only network dependency is the panel,
#    outbound-only, the censorship-robust goal). A Kernel-mode node matches by geoip (the .txt sets); DNS/SNI modes
#    add the domain tier on top. (youtube has no geoip — it shares Google's IPs — so it's domain-only, DNS/SNI only.)
GEO_DIR = os.path.join(STATE_DIR, "geo")
_CIDR4_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}/\d{1,2}$")


# ── Panel-pull: fetch provider-catalog lists from the PANEL (not GitHub) ─────────────────────────────────────
# The panel resolves each routed provider list once and serves it (raw text) with a version. The node pulls a
# list only when its version changed — a newly-routed cat immediately, a CHANGED existing one only inside the
# scheduled quiet window (that reload is what clients feel). Pulled files land as <cat>.txt (ip) / <cat>.doms
# (host) in GEO_DIR — the SAME files _smart_geo_refresh / _smart_domain_refresh already load.
_PULL_INFLIGHT = set(); _PULL_LOCK = threading.Lock()

def _in_quiet_window(sched):
    """Is now inside the operator's scheduled update window? every_days=0 → continuous (always). Else the 60-min
    window opening at the node-local `at` time. New lists ignore this (applied immediately); only CHANGED ones wait."""
    ev = int((sched or {}).get("every_days") or 1)
    if ev == 0:
        return True
    at = str((sched or {}).get("at") or "04:00")
    try:
        hh, mm = int(at.split(":")[0]), int(at.split(":")[1])
    except Exception:
        hh, mm = 4, 0
    import datetime
    now = datetime.datetime.now()                              # node-local time (the node is a real host, not sandboxed)
    start = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
    return start <= now < start + datetime.timedelta(minutes=60)

def _panel_get(url, token, panel, timeout=60):
    """GET a URL from the panel using the SAME TLS posture as post_json (fingerprint pin / verify / self-signed).
    Returns (status, bytes, x_list_version). status 0 = the request never completed."""
    u = urllib.parse.urlparse(url)
    host = u.hostname; port = u.port or (443 if u.scheme == "https" else 80)
    path = (u.path or "/") + (("?" + u.query) if u.query else "")
    fp = ((panel or {}).get("fingerprint") or "").replace(":", "").lower().strip()
    conn = None
    try:
        if u.scheme == "http":
            conn = http.client.HTTPConnection(host, port, timeout=timeout)
        else:
            ctx = ssl.create_default_context() if ((panel or {}).get("verify", False) and not fp) else ssl._create_unverified_context()
            conn = http.client.HTTPSConnection(host, port, timeout=timeout, context=ctx)
            if fp:
                conn.connect()
                der = conn.sock.getpeercert(True)
                if not der or hashlib.sha256(der).hexdigest() != fp:
                    return 0, b"", ""                          # pin mismatch — fail closed
        conn.request("GET", path, headers={"Authorization": "Bearer " + token, **_sig_headers(token, b"")})
        resp = conn.getresponse(); data = resp.read()
        if resp.status >= 400:
            return resp.status, b"", ""
        return resp.status, data, resp.getheader("X-List-Version", "")
    except Exception:
        return 0, b"", ""
    finally:
        if conn:
            with contextlib.suppress(Exception):
                conn.close()

def _bg_pull(cat, tier, ver, base, panel, dest, pver_path):
    """Background pull of one resolved list from the panel → dest, then stamp its version. Deduped per (cat,tier)."""
    k = cat + "|" + tier
    with _PULL_LOCK:
        if k in _PULL_INFLIGHT:
            return
        _PULL_INFLIGHT.add(k)
    def _work():
        try:
            url = base + "?cat=" + urllib.parse.quote(cat, safe="") + "&tier=" + tier
            st, data, _hv = _panel_get(url, (panel or {}).get("token") or "", panel)
            if st == 200:
                tmp = dest + ".tmp"
                with open(tmp, "wb") as f:
                    f.write(data)
                os.replace(tmp, dest)
                with contextlib.suppress(OSError):
                    open(pver_path, "w").write(ver)
        except Exception:
            pass                                               # keep last-good; retry next sync
        finally:
            with _PULL_LOCK:
                _PULL_INFLIGHT.discard(k)
    threading.Thread(target=_work, daemon=True).start()

def _panel_list_refresh(manifest, sched, panel, res):
    """For each provider-catalog list this node routes (from the sync `list_manifest`), pull it from the panel
    when its version changed — new cat now, changed cat only in the quiet window. Writes <cat>.txt / <cat>.doms
    so the existing geoip/domain loaders pick them up. Non-blocking (each pull runs on its own daemon thread)."""
    base_url = (panel or {}).get("url") or ""
    if not manifest or not base_url or not (panel or {}).get("token"):
        return
    try:
        os.makedirs(GEO_DIR, exist_ok=True)
    except OSError:
        return
    base = base_url.rstrip("/") + "/api/node/list"
    in_window = _in_quiet_window(sched)
    for cat, tiers in manifest.items():
        if not re.match(r"^[A-Za-z0-9:._-]+$", cat or ""):     # category → a filename under GEO_DIR; reject path traversal (/, \, ..) from a compromised/MITM panel
            continue
        for tier, want_v in (tiers or {}).items():
            if tier not in ("ip", "host") or not want_v:
                continue
            dest = os.path.join(GEO_DIR, cat + (".txt" if tier == "ip" else ".doms"))
            pv = os.path.join(GEO_DIR, "." + cat.replace(":", "_") + "." + tier + ".pver")
            try:    cur_v = open(pv).read().strip()
            except OSError: cur_v = ""
            have = os.path.exists(dest)
            if cur_v == want_v and have:
                continue                                       # unchanged upstream → nothing to pull
            if not (not have or not cur_v) and not in_window:  # a CHANGED existing list waits for the quiet hour
                continue
            _bg_pull(cat, tier, want_v, base, panel, dest, pv)
    # GC orphaned pulled files — a cat that LEFT the manifest (a removed/steered list) leaves its <cat>.doms/.txt +
    # .pver behind forever. Prune them, but ONLY when the manifest is NON-EMPTY: an empty manifest could be a
    # transient, and a still-needed list that got pruned re-pulls on the next sync anyway (self-healing, never a
    # lasting loss). Touches only files matching the pulled-list naming — control markers (.xtstring-sig, .nft…) stay.
    if manifest:
        keep = set()
        for cat, tiers in manifest.items():
            for tier in (tiers or {}):
                if tier in ("ip", "host"):
                    keep.add(cat + (".txt" if tier == "ip" else ".doms"))
                    keep.add("." + cat.replace(":", "_") + "." + tier + ".pver")
        with contextlib.suppress(OSError):
            for fn in os.listdir(GEO_DIR):
                is_list = (fn.endswith(".doms") or fn.endswith(".txt")) and not fn.startswith(".")
                is_pver = fn.startswith(".") and fn.endswith(".pver")
                if (is_list or is_pver) and fn not in keep:
                    with contextlib.suppress(OSError):
                        os.remove(os.path.join(GEO_DIR, fn))


def _nft_load_set(setname, cidrs):
    """Atomically replace an nft interval set's elements (flush + chunked add via `nft -f`). Overlapping or
    adjacent ranges are COLLAPSED first — an `interval` set without auto-merge rejects an overlapping add and
    the whole load fails (this is why the large, overlap-heavy Russia list never loaded), so we merge them in
    Python (collapse also fixes adjacency)."""
    import ipaddress
    try:
        cidrs = [str(n) for n in ipaddress.collapse_addresses(
            ipaddress.ip_network(c.strip(), strict=False) for c in cidrs if c.strip())]
    except Exception:
        pass   # bad entry → fall back to the raw list (best-effort; nft will reject the offending chunk only)
    lines = [f"flush set inet {SMART_NFT_TABLE} {setname}"]
    for i in range(0, len(cidrs), 2000):
        lines.append(f"add element inet {SMART_NFT_TABLE} {setname} {{ {', '.join(cidrs[i:i + 2000])} }}")
    path = os.path.join(GEO_DIR, "." + setname + ".nft")
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    rc = run(["nft", "-f", path]).returncode
    with contextlib.suppress(OSError):
        os.unlink(path)
    return rc


def _smart_demote_geo(cat, res):
    """A category that's now domain-filled but was geoip-loaded before (e.g. after an upgrade that moved it to
    the domain tier): flush its set ONCE and drop the geo cache, so only dnsmasq's resolved IPs remain — else a
    provider's whole IP range would re-merge the split apart. Keyed on the .loaded marker, so it runs a single
    time per transition and never wipes dnsmasq's accumulated fill afterwards."""
    lp = os.path.join(GEO_DIR, "." + cat + ".loaded")
    if not os.path.exists(lp):
        return
    run(["nft", "flush", "set", "inet", SMART_NFT_TABLE, _smart_setname(cat)])
    for p in (lp, os.path.join(GEO_DIR, "." + cat + ".attempt"), os.path.join(GEO_DIR, cat + ".txt")):
        with contextlib.suppress(OSError):
            os.unlink(p)
    res["changed"] += 1


def _smart_geo_refresh(categories, set_counts, res, skip=()):
    """Ensure each needed category's CIDR list is cached + fresh and loaded into its nft set. Fetches only
    when the cache is missing/stale (TTL-gated, so most syncs do nothing); reloads the set when the data
    changed OR the live set is empty (e.g. after a reboot — nft sets aren't persistent). Failures leave the
    set as-is (inert / last-good) and retry next TTL. `skip` = domain-filled categories (dnsmasq owns those
    sets — geo-fetch must never touch them, else a provider's whole IP range would re-merge the split apart)."""
    if not categories:
        return
    try:
        os.makedirs(GEO_DIR, exist_ok=True)
    except OSError as e:
        res["errors"].append("smart geo dir: " + str(e)); return     # can't cache → skip (sets stay inert)
    for cat in categories:
        if cat == "all":
            continue                                           # catch-all → no set
        if cat in skip:                                        # domain-filled → dnsmasq owns it; clear any stale geoip once
            _smart_demote_geo(cat, res)
            continue
        try:                                                   # one bad category must never crash the sync loop
            sn = _smart_setname(cat)
            path = os.path.join(GEO_DIR, cat + ".txt")         # CIDR list, pulled from the panel by _panel_list_refresh
            try:
                st = os.stat(path)                             # no data yet → set stays empty (inert) until the pull lands
            except OSError:
                continue
            sig = "%d:%d" % (int(st.st_mtime), st.st_size)      # cheap change signal — avoids re-reading/hashing a big file every cycle
            lp = os.path.join(GEO_DIR, "." + cat + ".loaded")
            marker = ""
            with contextlib.suppress(OSError):
                marker = open(lp).read().strip()
            msig, mhash = marker.split("|", 1) if "|" in marker else ("", marker)   # legacy marker held the hash alone
            if msig == sig and set_counts.get(sn, 0) > 0:      # file unchanged AND set populated → nothing to do (skip read/regex/hash)
                continue
            cidrs = [ln.strip() for ln in open(path).read().splitlines() if _CIDR4_RE.match(ln.strip())]
            if not cidrs:
                continue
            h = hashlib.sha256(("\n".join(cidrs)).encode()).hexdigest()
            if mhash != h or set_counts.get(sn, 0) == 0:       # content changed, or set empty (post-reboot) → (re)load
                if _nft_load_set(sn, cidrs) == 0:
                    with contextlib.suppress(OSError):
                        open(lp, "w").write(sig + "|" + h)
                    res["changed"] += 1
                else:
                    res["errors"].append("smart geo load " + cat + " failed")
            else:                                              # mtime touched but content identical → just refresh the sig
                with contextlib.suppress(OSError):
                    open(lp, "w").write(sig + "|" + h)
        except Exception as e:
            res["errors"].append("smart geo " + cat + ": " + str(e)[:120])


def _smart_load_cidrs(cidrs_map, set_counts, res):
    """Custom-rule raw IPs/CIDRs → ADDED into their nft set directly. The set ALSO fills from dnsmasq for the
    rule's domain half, so we add elements (never flush, which would wipe the dnsmasq-resolved IPs). Add-only +
    gated on the live element count, so steady state is a no-op; a post-reboot empty set re-loads them."""
    for cat, cl in (cidrs_map or {}).items():
        cl = [c for c in (cl or []) if c]
        if not cl:
            continue
        sn = _smart_setname(cat)
        if set_counts.get(sn, 0) >= len(cl):                   # already present (count covers them) → skip the churn
            continue
        for i in range(0, len(cl), 2000):
            if run(["nft", "add", "element", "inet", SMART_NFT_TABLE, sn, "{ " + ", ".join(cl[i:i + 2000]) + " }"]).returncode == 0:
                res["changed"] += 1


# ── GeoSite host tier: per-category DOMAIN lists, fetched/cached EXACTLY like the geoip tier above but feeding
#    dnsmasq instead of nft sets. Sources: v2fly/domain-list-community for global services (one plaintext file
#    per category, may use `include:`), 1andrevich/Re-filter-lists for Russia (a pre-flattened .lst). The fetched
#    list UNIONS with the panel's curated DOMAIN_BUNDLES, then drives the dnsmasq nftset directives below. Only a
#    DNS/SNI-mode node fetches these (the panel ships a domain cat only off Kernel mode); a Kernel node matches
#    the same cats by geoip. Cached under GEO_DIR as <cat>.doms, TTL/retry-gated, mirror-able via SWG_GEO_MIRROR.
#    "V2:<name>" = v2fly data/<name>; "RF:<name>" = Re-filter <name>.lst. Keep in sync with the panel's HOST_CATEGORIES.
# PROVIDER-catalog cats (namespaced "<prov>:<id>") AND curated built-ins are resolved on the PANEL and PULLED
# from it by _panel_list_refresh — the node never fetches from GitHub. A bare id with no pulled file is a
# custom_<hash> rule, whose contents the panel ships inline.
_CAT_CAPS = {}   # {cat:{ip,host}} — refreshed from the sync `smart.cat_caps` at the top of every reconcile
def _is_provider_cat(cat):
    return ":" in str(cat)                                      # <prov>:<id> → panel-resolved + panel-pulled

_DOM_RE = re.compile(r"^(?=.{1,253}$)(?!-)[a-z0-9-]{1,63}(?<!-)(\.(?!-)[a-z0-9-]{1,63}(?<!-))+$")


_DOM_CACHE = {}   # cat -> ((mtime,size), parsed-domain-list): reuse the parsed list while the .doms file is unchanged
_DOMTIER_CACHE = {}   # {"v": (input-signature, fully-enriched {cat:[domain]})}: skip the union+sort when inputs are unchanged
_DNSMASQ_BUILD = {"n": 0}   # cycles since the domain tier went active — drives the periodic self-heal rebuild

# ── Force-DNS fill admission control ──────────────────────────────────────────────────────────────────────
# Loading a domain category into dnsmasq's per-domain map costs memory the box may not have. A big content list
# (ads/malware/adult can union to MILLIONS of domains) balloons BOTH the noded's build and dnsmasq's resident set,
# thrashing a small box into swap until its sync loop starves and the panel marks the node offline (observed:
# noded → 665 MB / folio_wait on a 961 MB box). So before Force-DNS loads any list we size it cheaply (on-disk
# .doms bytes, no read) and admit only what fits a memory budget; over-budget categories are SKIPPED and reported
# rather than loaded. The node degrades honestly and stays online. This is a node-side safety net — it holds no
# matter what the panel ships, so a mis-sized policy can never take a node down.
_FORCEDNS_DOM_BYTES = 400        # est. PEAK bytes/domain for the whole load: dnsmasq resident (~80) + the noded's
                                 # transient build copies (dom_sets/groups/conf/body, ~300). Conservative on purpose
                                 # so the gate is safe WITHOUT streaming the build.
_FILL_HEADROOM = 96 * 1024 * 1024   # never spend the last 96 MB of available memory on a domain fill


def _cgroup_mem_available():
    """Bytes still allocatable inside our cgroup (a docker memory cap), or None if unlimited/unreadable. Mirrors the
    panel's _mem_total_mb cgroup-awareness so a memory-capped container budgets by ITS limit, not the host's RAM."""
    for lim, cur in (("/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory.current"),                       # v2
                     ("/sys/fs/cgroup/memory/memory.limit_in_bytes", "/sys/fs/cgroup/memory/memory.usage_in_bytes")):  # v1
        try:
            raw = open(lim).read().strip()
            if raw == "max":
                return None
            L = int(raw)
            if L <= 0 or L >= (1 << 62):                  # v1 "unlimited" sentinel
                return None
            return max(0, L - int(open(cur).read().strip() or 0))
        except (OSError, ValueError):
            continue
    return None


def _fill_budget_bytes():
    """Memory a domain fill may consume without thrashing: min(host MemAvailable, cgroup headroom) less a fixed
    reserve. Read fresh each cycle so a box under load admits less."""
    avail = read_meminfo().get("available", 0)
    cg = _cgroup_mem_available()
    if cg is not None:
        avail = min(avail, cg)
    return max(0, avail - _FILL_HEADROOM)


def _doms_est_count(cat):
    """Cheap domain-count estimate for a category from its on-disk .doms size — a stat, never a read (~18 B/line)."""
    try:
        return max(0, os.stat(os.path.join(GEO_DIR, cat + ".doms")).st_size // 18)
    except OSError:
        return 0


def _forcedns_admit(cats, res):
    """Admit as many domain categories to the Force-DNS fill as fit the memory budget; skip the rest (largest first,
    so the most categories stay enforced) and report the skip for the panel to surface. Returns the admitted cats.
    Never raises."""
    budget = _fill_budget_bytes()
    sized = sorted(((c, _doms_est_count(c)) for c in cats), key=lambda x: x[1])   # smallest first → fit the cheap ones
    admitted, dropped, spent = [], [], 0
    for cat, n in sized:
        if n and spent + n * _FORCEDNS_DOM_BYTES > budget:
            dropped.append((cat, n)); continue
        admitted.append(cat); spent += n * _FORCEDNS_DOM_BYTES
    if dropped:
        tot = sum(n for _, n in dropped)
        res["errors"].append(
            "Force-DNS fill over memory budget (~%d MB free): skipped %d categor%s (~%s domains) — %s. "
            "Use kernel-SNI for large content lists, or a smaller list." % (
                budget // (1024 * 1024), len(dropped), "y" if len(dropped) == 1 else "ies",
                format(tot, ","), ", ".join(c for c, _ in sorted(dropped, key=lambda x: -x[1]))))
        _SMART_MODE["fill_gate"] = {"skipped": [c for c, _ in dropped], "skipped_domains": tot,
                                    "budget_mb": budget // (1024 * 1024)}
    else:
        _SMART_MODE.pop("fill_gate", None)
    return admitted


def _smart_domain_refresh(cats, res):
    """Return {cat: domain-list} parsed from each cat's panel-pulled <cat>.doms cache. A cat with no pulled file
    (a custom_<hash> rule, whose domains come inline from the panel) is skipped. Cheap: the parsed list is memoized
    per file signature, so an unchanged .doms is never re-read."""
    out = {}
    if not cats:
        return out
    try:
        os.makedirs(GEO_DIR, exist_ok=True)
    except OSError as e:
        res["errors"].append("smart domain dir: " + str(e)); return out
    for cat in cats:
        path = os.path.join(GEO_DIR, cat + ".doms")            # domain list, pulled from the panel by _panel_list_refresh
        # Panel-pulled = a provider cat OR a curated cat whose .doms the panel ships. A cat with no pulled file is a
        # custom_<hash> (its domains come inline from the panel) → skip.
        if not (_is_provider_cat(cat) or os.path.exists(path)):
            continue
        try:
            try:
                st = os.stat(path)
            except OSError:
                continue                                       # no cache yet → nothing to return for this cat
            sig = (int(st.st_mtime), st.st_size)
            cached = _DOM_CACHE.get(cat)
            if cached and cached[0] == sig:                    # file unchanged → reuse the parsed list (skip the big read+regex)
                doms = cached[1]
            else:
                doms = [d for d in open(path).read().splitlines() if _DOM_RE.match(d.strip())]
                _DOM_CACHE[cat] = (sig, doms)
            if doms:
                out[cat] = doms
        except Exception as e:
            res["errors"].append("smart domain " + cat + ": " + str(e)[:120])
    return out


# ── domain tier: a dedicated dnsmasq fills the domain-category nft sets. Smart-interface clients have their
#    DNS transparently DNAT-redirected here, so every lookup of a bundle domain adds its answer IPs to cat_<c>
#    — the same set the marking chain matches. Managed from the sync loop (configured/started/torn down each
#    pass, self-healing like the nft rules). The set fills as clients browse; no static IP list to go stale.
SMART_DNS_PORT = 5354                                           # dnsmasq listens here on loopback (system :53 untouched)
DNSMASQ_BIN  = "dnsmasq"
DNSMASQ_CONF = os.path.join(STATE_DIR, "smart-dnsmasq.conf")
DNSMASQ_PID  = os.path.join(STATE_DIR, "smart-dnsmasq.pid")
SMARTDNS_TAG = "swg-smartdns"                                   # iptables comment tag for the DNS-redirect rules


def _dnsmasq_running():
    """Our dnsmasq's pid if alive, else 0 (stale/absent pid-file → 0)."""
    try:
        pid = int(open(DNSMASQ_PID).read().strip())
        os.kill(pid, 0)                                        # signal 0 = liveness probe, sends nothing
        return pid
    except (OSError, ValueError):
        return 0


def _dnsmasq_kill():
    """Stop the running dnsmasq but KEEP its config file — for a restart that reloads changed nftset directives
    (they're read only at startup). The conf was just rewritten and is about to be re-read; deleting it here (as
    _dnsmasq_stop does for a full teardown) makes the immediate restart fail 'cannot read <conf>: No such file'."""
    pid = _dnsmasq_running()
    if pid:
        run(["kill", str(pid)])
    run(["pkill", "-f", "--", "conf-file=" + DNSMASQ_CONF])   # reap any stray instances the pid-file missed
    with contextlib.suppress(OSError):
        os.unlink(DNSMASQ_PID)                               # stale after the kill; the conf stays for the restart


def _dnsmasq_stop():
    _dnsmasq_kill()
    with contextlib.suppress(OSError):
        os.unlink(DNSMASQ_CONF)                              # full teardown — no restart coming, drop the conf too


def _route_localnet_ok():
    """True if net.ipv4.conf.all.route_localnet is enabled — REQUIRED for Force-DNS to DNAT a forwarded client's
    :53 to our loopback dnsmasq. In containers /proc/sys is usually read-only, so `sysctl -w` silently no-ops and
    the redirect blackholes every DNS packet while dnsmasq sits idle (client loses all name resolution). Reading
    the live value lets us self-heal where writable and, where not, flag the node instead of failing in silence."""
    try:
        return open("/proc/sys/net/ipv4/conf/all/route_localnet").read().strip() == "1"
    except OSError:
        return False


def _smart_dns_redirect(subnets, res):
    """DNAT udp/tcp :53 from each smart subnet → our dnsmasq (127.0.0.1:SMART_DNS_PORT), tag-reconciled so it
    converges (add wanted / drop stale) without churn. Empty subnets → remove all our redirect rules. The
    route_localnet sysctl lets a forwarded packet DNAT to loopback (off by default)."""
    want = {(S, proto) for S in subnets for proto in ("udp", "tcp")}
    out = getattr(run(["iptables", "-t", "nat", "-S", "PREROUTING"]), "stdout", "") or ""
    live = set()
    for ln in out.splitlines():
        if SMARTDNS_TAG not in ln:
            continue
        ms = re.search(r"-s (\S+)", ln); mp = re.search(r"-p (\w+)", ln)
        if ms and mp:
            S = ms.group(1)
            live.add((S if "/" in S else S + "/32", mp.group(1)))
    if want and not _route_localnet_ok():
        # Re-assert every cycle it's found off — a container/host restart resets the sysctl while our DNAT rules
        # persist, silently blackholing client DNS. Idempotent where already on; a no-op where /proc/sys is
        # read-only (containers) — smart_status() then reports route_localnet=false so the failure is visible.
        run(["sysctl", "-q", "-w", "net.ipv4.conf.all.route_localnet=1"])

    def rule(S, proto):
        return ["-s", S, "-p", proto, "--dport", "53", "-m", "comment", "--comment", SMARTDNS_TAG,
                "-j", "DNAT", "--to-destination", "127.0.0.1:" + str(SMART_DNS_PORT)]
    for (S, proto) in sorted(want - live):
        run(["iptables", "-t", "nat", "-A", "PREROUTING"] + rule(S, proto)); res["changed"] += 1
    for (S, proto) in sorted(live - want):
        run(["iptables", "-t", "nat", "-D", "PREROUTING"] + rule(S, proto)); res["changed"] += 1


def _ensure_smart_dnsmasq(domains, smart_e, res, unchanged=False):
    """(Re)configure + run the domain-tier dnsmasq and redirect smart-subnet DNS to it. domains = {cat:[domain]}
    for the active domain categories; smart_e gives the source subnets. Nothing wanted → full teardown.
    unchanged=True (inputs identical to last cycle) → skip the expensive body rebuild, but still re-assert the DNS
    redirect (cheap, diff-gated) and, every ~12 cycles, force a full rebuild to self-heal any external drift."""
    subnets = sorted({e["subnet"] for e in smart_e})
    want = bool(domains and subnets)
    _smart_dns_redirect(subnets if want else [], res)          # cheap, diff-gated — always reconciled
    if not want:                                               # nothing to fill → tear down + reap any stray instance
        _DNSMASQ_BUILD["n"] = 0
        had = _dnsmasq_running() or os.path.exists(DNSMASQ_CONF) or run(["pgrep", "-f", "conf-file=" + DNSMASQ_CONF]).returncode == 0
        if had:
            _dnsmasq_stop(); res["changed"] += 1
        return
    _DNSMASQ_BUILD["n"] += 1
    if unchanged and _DNSMASQ_BUILD["n"] % 12 != 0 and _dnsmasq_running():
        return                                                 # inputs unchanged + dnsmasq alive → skip the O(n) config rebuild
    conf = ["# managed by swg-noded — domain-tier smart routing (do not edit)",
            "port=" + str(SMART_DNS_PORT), "listen-address=127.0.0.1", "bind-interfaces",
            "no-resolv", "no-hosts", "cache-size=2000", "pid-file=" + DNSMASQ_PID]
    conf += ["server=1.1.1.1", "server=8.8.8.8"]
    # PER-DOMAIN, not per-category. dnsmasq applies only the FIRST nftset directive that lists a given domain, so a
    # domain shared by several categories (e.g. google.com in BOTH a custom list and the built-in Google set) would
    # land in only one set — silently corrupting the other set's routing + stats, and hostage to config order. Instead
    # map each domain to EVERY set it belongs to and emit it once, targeting all those sets at once (dnsmasq accepts a
    # comma-joined target list; verified it fills all of them). This makes population order- and overlap-independent:
    # any admin edit — new list, host added to an existing list, lists that overlap each other or a built-in category —
    # just recomputes the map, no glitch possible. (CIDRs bypass dnsmasq entirely — nft adds them to their set directly,
    # which is already per-set, so only domains need this.)
    dom_sets = {}
    for cat in domains:
        sn = _smart_setname(cat)
        for d in domains[cat]:
            if d: dom_sets.setdefault(d, set()).add(sn)
    groups = {}                                                # group by exact set-membership so same-membership domains
    for d, sns in dom_sets.items():                            # still share a directive (keeps the config compact)
        groups.setdefault(tuple(sorted(sns)), []).append(d)
    for sns in sorted(groups):                                 # sorted here + below → deterministic body (no needless restart)
        suffix = "/" + ",".join("4#inet#" + SMART_NFT_TABLE + "#" + sn for sn in sns)   # every set this group's domains join
        cur, clen = [], 0                                      # chunk by BYTE length: dnsmasq's parser caps a line at
        for d in sorted(groups[sns]):                          # ~1024 chars (MAXDNAME); overflow → dnsmasq FAILS to start
            if cur and 8 + clen + len(suffix) + 1 + len(d) > 900:   # ("nftset=/"=8, "/"=1). Keep each line < ~900 bytes.
                conf.append("nftset=/" + "/".join(cur) + suffix)
                cur, clen = [], 0
            cur.append(d); clen += len(d) + (1 if clen else 0)
        if cur:
            conf.append("nftset=/" + "/".join(cur) + suffix)
    body = "\n".join(conf) + "\n"
    try:
        cur = open(DNSMASQ_CONF).read()
    except OSError:
        cur = None
    if cur != body:
        try:
            with open(DNSMASQ_CONF, "w") as f:
                f.write(body)
        except OSError as e:
            res["errors"].append("smart dnsmasq conf: " + str(e)); return
        if _dnsmasq_running():                                 # nftset directives are read only at startup → restart
            _dnsmasq_kill()                                     # kill but KEEP the freshly-written conf (else restart can't read it)
    if not _dnsmasq_running():                                 # (re)start, also self-heals after a reboot/crash
        r = run([DNSMASQ_BIN, "--conf-file=" + DNSMASQ_CONF])
        if getattr(r, "returncode", 1) != 0:
            res["errors"].append("smart dnsmasq start: " + (getattr(r, "stderr", "") or "").strip()[:120])
        else:
            res["changed"] += 1


# ── Force-DNS guard (DoH/DoT block): in forcedns mode the node's dnsmasq IS the smart-routing oracle (it fills
#    the domain sets), so a client that resolves over ENCRYPTED DNS would bypass it. Plaintext :53 is already
#    DNAT'd to our dnsmasq (_smart_dns_redirect); this closes the encrypted holes by DROPping, from the smart
#    subnets, DoT/DoQ (:853) and DoH/DoH3 (:443 to known DoH-resolver IPs). Gated on the panel's block_doh
#    (routing_mode == forcedns) — NOT applied in kernel mode (geoip needs no DNS) or sni mode (Phase C is
#    DoH-proof without forcing DNS). Own inet table `swg_doh`, reconciled/torn-down like the smart table.
DOH_NFT_TABLE = "swg_doh"
# DoH-resolver IPs to drop on :443. DELIBERATELY a small CURATED list of the major providers' DEDICATED
# resolver anycast IPs — NOT a big crowd-sourced feed (e.g. dibdot/DoH-IP-blocklists). Those feeds resolve DoH
# *hostnames*, and many DoH services sit behind SHARED CDNs (Cloudflare 104.21/172.67/162.159…); dropping :443
# to a shared-CDN IP would blackhole unrelated websites. Blocking by IP is only safe for dedicated resolver
# anycast (1.1.1.1, 8.8.8.8, 9.9.9.9, …), which is also what every browser/OS auto-DoH defaults to — a user
# pointing at a custom CDN-hosted DoH can only be stopped by SNI inspection (Phase C), not IP. Plain /32s.
DOH_IPS = sorted(set([
    "1.1.1.1", "1.0.0.1", "1.1.1.2", "1.0.0.2", "1.1.1.3", "1.0.0.3",          # Cloudflare (+ family/security)
    "8.8.8.8", "8.8.4.4",                                                       # Google
    "9.9.9.9", "149.112.112.112", "9.9.9.10", "149.112.112.10",                # Quad9
    "9.9.9.11", "149.112.112.11",
    "94.140.14.14", "94.140.15.15", "94.140.14.140", "94.140.14.141",          # AdGuard (+ family)
    "208.67.222.222", "208.67.220.220", "208.67.222.123", "208.67.220.123",    # OpenDNS / FamilyShield
    "185.228.168.9", "185.228.169.9", "185.228.168.168",                       # CleanBrowsing
    "45.90.28.0", "45.90.30.0",                                                 # NextDNS anycast
    "194.242.2.2", "194.242.2.3", "194.242.2.4",                               # Mullvad
    "76.76.2.0", "76.76.10.0",                                                  # Control D
    "193.110.81.0", "185.253.5.0",                                             # dns0.eu
    "77.88.8.8", "77.88.8.1", "77.88.8.2", "77.88.8.3", "77.88.8.7",           # Yandex DNS
    "223.5.5.5", "223.6.6.6",                                                   # AliDNS
    "1.12.12.12", "120.53.53.53",                                              # DNSPod
]))


def _doh_ips():
    """The dedicated-resolver anycast IPs to drop on :443 (see DOH_IPS rationale)."""
    return DOH_IPS


def _ensure_doh_block(subnets, enable, res):
    """(Re)build or tear down the `swg_doh` drop table. Signature-gated (subnets + DoH-IP set), so steady state
    is a no-op and a list refresh re-applies. Built atomically via `nft -f`. Never raises into the sync loop."""
    try:
        have = run(["nft", "list", "table", "inet", DOH_NFT_TABLE])
        if not (enable and subnets):                           # disabled / no smart subnets → drop our table
            if have.returncode == 0:
                run(["nft", "delete", "table", "inet", DOH_NFT_TABLE]); res["changed"] += 1
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, ".doh.sig"))
            return
        ips = _doh_ips()
        want_src = sorted(subnets)
        sig = hashlib.sha256((";".join(want_src) + "|" + ";".join(ips)).encode()).hexdigest()
        sigf = os.path.join(GEO_DIR, ".doh.sig")
        cur = ""
        with contextlib.suppress(OSError):
            cur = open(sigf).read().strip()
        if have.returncode == 0 and cur == sig:                # already converged (table present + same wants)
            return
        lines = []
        if have.returncode == 0:
            lines.append("delete table inet " + DOH_NFT_TABLE)
        lines.append("table inet " + DOH_NFT_TABLE + " {")
        lines.append("  set doh4 { type ipv4_addr; flags interval; auto-merge; elements = { " + ", ".join(ips) + " } }")
        lines.append("  chain forward { type filter hook forward priority filter; policy accept;")
        for S in want_src:
            lines.append("    ip saddr " + S + " udp dport 853 drop")    # DoQ
            lines.append("    ip saddr " + S + " tcp dport 853 drop")    # DoT
            lines.append("    ip saddr " + S + " ip daddr @doh4 udp dport 443 drop")   # DoH3 / QUIC
            lines.append("    ip saddr " + S + " ip daddr @doh4 tcp dport 443 drop")   # DoH
        lines += ["  }", "}"]
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True)
        path = os.path.join(GEO_DIR, ".doh.nft")
        with open(path, "w") as f:
            f.write("\n".join(lines) + "\n")
        rc = run(["nft", "-f", path]).returncode
        with contextlib.suppress(OSError):
            os.unlink(path)
        if rc == 0:
            with contextlib.suppress(OSError):
                open(sigf, "w").write(sig)
            res["changed"] += 1
        else:
            res["errors"].append("doh block nft load failed")
    except Exception as e:
        res["errors"].append("doh block: " + str(e)[:120])


MECH_NFT_TABLE = "swg_mech"     # per-interface FREE traffic/abuse mechanism drops (SMTP/QUIC/torrent-port-hint/port-scan)
_MECH_ON = {"subs": 0}          # how many subnets run the free abuse tier — see _ensure_mech_block / smart_status

def _mech_meter(subnet):
    return "psc_" + re.sub(r"[^0-9a-z]", "_", subnet.lower())   # valid nft id for the per-subnet port-scan rate meter
def _mech_flagged(subnet):
    return "pscf_" + re.sub(r"[^0-9a-z]", "_", subnet.lower())  # per-subnet FLAGGED-scanner set: only over-rate src IPs land here (self-expiring)
def _mech_ports(subnet):
    return "mps_" + re.sub(r"[^0-9a-z]", "_", subnet.lower())   # valid nft id for the per-subnet (proto.port) drop set

def _ensure_mech_block(mech, res):
    """Per-interface FREE traffic/abuse mechanism drops in the `swg_mech` table (forward hook, mirrors _ensure_doh_block).
    mech = {subnet: [mechanism ids]}. EVERY rule is O(1) / offload-safe. To keep the datapath cheap the deterministic
    port drops (SMTP :25, QUIC udp/443, BitTorrent PORT-HINT 6881-6889) are COLLAPSED into ONE concatenated (proto.port)
    set → one lookup, not one rule per port. Plus a per-SOURCE new-connection rate meter for port-scan / brute-force
    (a token bucket touched ONLY at connection setup, `ct state new`; established packets skip it). The bounded
    L7-SIGNATURE mechanisms (torrent handshake, WebRTC, cryptomining) are NOT built here — deferred + measurement-gated.
    Signature-gated so steady state is a no-op; atomic `nft -f`; never raises; never-wipe (nothing wanted → delete ONLY
    our table). Unknown/sig mechanisms are ignored (fail-open, never a silent CPU cost)."""
    try:
        have = run(["nft", "list", "table", "inet", MECH_NFT_TABLE])
        portsets = {}   # subnet -> sorted [(proto.port) element strings]   (smtp/quic/torrents → ONE set → ONE rule)
        meters = []     # subnets running the port-scan rate meter
        for S in sorted(mech or {}):
            cats = set(mech.get(S) or [])
            els = []
            if "smtp" in cats:     els.append("tcp . 25")
            if "quic" in cats:     els.append("udp . 443")
            if "torrents" in cats: els += ["udp . 6881-6889", "tcp . 6881-6889"]   # FREE port-hint; the sig scan is a later measured tier
            if els:                portsets[S] = sorted(els)
            if "portscan" in cats: meters.append(S)
        # Does this node run the FREE abuse tier at all? Recorded BEFORE the signature gate below, so a
        # steady-state no-op still keeps it current. smart_status reads it to decide whether the blocking
        # ACTIVITY is worth harvesting when the CONTENT table does not exist — see its early return.
        _MECH_ON["subs"] = len(set(portsets) | set(meters))
        if not portsets and not meters:                           # nothing wanted → tear down ONLY our table (never touches others)
            if have.returncode == 0:
                run(["nft", "delete", "table", "inet", MECH_NFT_TABLE]); res["changed"] += 1
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, ".mech.sig"))
            return
        sig = hashlib.sha256(json.dumps({"p": portsets, "m": sorted(meters), "v": 2}, sort_keys=True).encode()).hexdigest()   # v2: +pscf flagged-scanner set
        sigf = os.path.join(GEO_DIR, ".mech.sig")
        cur = ""
        with contextlib.suppress(OSError):
            cur = open(sigf).read().strip()
        if have.returncode == 0 and cur == sig:                   # table present + same wants → converged, no-op
            return
        lines = ["delete table inet " + MECH_NFT_TABLE] if have.returncode == 0 else []
        lines.append("table inet " + MECH_NFT_TABLE + " {")
        for S, els in sorted(portsets.items()):
            lines.append("  set " + _mech_ports(S) + " { type inet_proto . inet_service; flags interval; elements = { " + ", ".join(els) + " } }")
        for S in sorted(meters):                                  # FLAGGED-scanner set — only over-rate src IPs are added, timeout-expiring
            lines.append("  set " + _mech_flagged(S) + " { type ipv4_addr; flags timeout; }")
        lines.append("  chain forward { type filter hook forward priority filter; policy accept;")
        for S in sorted(portsets):                                # ONE port-drop rule per subnet (all its port mechanisms)
            lines.append("    ip saddr " + S + " meta l4proto . th dport @" + _mech_ports(S) + " drop")
        for S in sorted(meters):                                  # per-SOURCE new-connection rate limit (scans / brute-force). Over-rate
            lines.append("    ip saddr " + S + " ct state new meter " + _mech_meter(S) +   # sources are recorded in the flagged set (→ real
                         " { ip saddr limit rate over 200/second } add @" + _mech_flagged(S) + " { ip saddr timeout 600s } drop")   # scanner attribution, self-decaying)
        lines += ["  }", "}"]
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True)
        path = os.path.join(GEO_DIR, ".mech.nft")
        with open(path, "w") as f:
            f.write("\n".join(lines) + "\n")
        rc = run(["nft", "-f", path]).returncode
        with contextlib.suppress(OSError):
            os.unlink(path)
        if rc == 0:
            with contextlib.suppress(OSError):
                open(sigf, "w").write(sig)
            res["changed"] += 1
        else:
            res["errors"].append("mech block nft load failed")
    except Exception as e:
        res["errors"].append("mech block: " + str(e)[:120])


TORRENT_MARK = 0x7770     # connmark for a detected BitTorrent flow (outside the 7000-7099 fwmark band + SNI reset 0x9999)

def _ensure_torrent_sig(subnets, res):
    """Phase 3 of the torrents mechanism — the PROPER, port-independent BitTorrent block by protocol SIGNATURE
    (iptables `-m string`, xt_string). For each subnet: scan ONLY the first packets of a NEW tcp flow
    (`-m connbytes 0:12 original packets`) for the `\\x13BitTorrent protocol` handshake; on a hit, pin the flow's
    connmark and DROP it. A `connmark → DROP` rule placed FIRST means a classified flow drops O(1) and NEVER
    re-scans, so scanning is confined to a tiny bounded window at connection setup (near-zero amortized). SUPPLEMENTS
    the free port-hint (swg_mech) — catches BitTorrent on any port. Capability-gated (needs `iptables -m string`);
    where absent, the port-hint still applies. Sig-gated (rebuild only on change), never raises. Mirrors
    _ensure_smart_xtstring's SWGP chain lifecycle exactly (mangle PREROUTING)."""
    CHAIN = "SWGP"
    subs = sorted(set(subnets or []))
    sig = hashlib.sha1(("torsig7|" + ";".join(subs)).encode()).hexdigest()[:16]   # torsig7: presence-only swgp_src (element counters proven non-accumulating; reverted count rules)
    sigf = os.path.join(GEO_DIR, ".torsig-sig")
    try:
        stored = open(sigf).read().strip()
    except OSError:
        stored = ""
    hooked = run(["iptables", "-t", "mangle", "-C", "PREROUTING", "-p", "tcp", "-j", CHAIN]).returncode == 0
    if stored == sig and (hooked or not subs):                # steady state → no-op
        return
    if subs and not _kernel_sni_ok():                         # no xt_string on this box → port-hint (swg_mech) only, skip the scan
        return
    run(["iptables", "-t", "mangle", "-D", "PREROUTING", "-p", "tcp", "-j", CHAIN])   # unhook + rebuild fresh
    run(["iptables", "-t", "mangle", "-F", CHAIN]); run(["iptables", "-t", "mangle", "-X", CHAIN])
    if not subs:                                              # teardown (torrents off / no subnets)
        with contextlib.suppress(OSError):
            os.remove(sigf)
        return
    _ok = [True]
    def _ipt(*a):
        r = run(["iptables", "-t", "mangle", *a])
        if r.returncode != 0:
            res["errors"].append("torrent-sig: " + (r.stderr or "").strip()[:120]); _ok[0] = False
    _ipt("-N", CHAIN)
    # torrent source IPs (who tried torrents), self-expiring PRESENCE set (attribution: which peers offended).
    run(["ipset", "create", "swgp_src", "hash:ip", "timeout", "600", "-exist"])
    for S in subs:
        # Phase 1 (FIRST): a flow already classified BitTorrent → record the source (attribution: who tried torrents) then
        # drop O(1), never re-scan. swgp_src is a self-expiring PRESENCE set — membership tells us which peers offended;
        # ipset element counters don't accumulate (SET overwrites to the last packet), so we keep presence, not counts.
        _ipt("-A", CHAIN, "-s", S, "-m", "connmark", "--mark", hex(TORRENT_MARK), "-j", "SET", "--add-set", "swgp_src", "src", "--exist")
        _ipt("-A", CHAIN, "-s", S, "-m", "connmark", "--mark", hex(TORRENT_MARK), "-j", "DROP")
        # Phase 2 (BOUNDED scan): only the first packets of a NEW tcp flow — on the handshake, pin the connmark…
        _ipt("-A", CHAIN, "-s", S, "-p", "tcp",
             "-m", "connbytes", "--connbytes", "0:12", "--connbytes-dir", "original", "--connbytes-mode", "packets",
             "-m", "string", "--algo", "bm", "--hex-string", "|13|BitTorrent protocol",
             "-j", "CONNMARK", "--set-mark", hex(TORRENT_MARK))
        # …and drop the packet that just matched (subsequent packets hit the Phase-1 rule).
        _ipt("-A", CHAIN, "-s", S, "-m", "connmark", "--mark", hex(TORRENT_MARK), "-j", "DROP")
    _ipt("-A", "PREROUTING", "-p", "tcp", "-j", CHAIN)        # hook once, last
    if _ok[0]:
        res["changed"] += 1
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True); open(sigf, "w").write(sig)


def reconcile_dial_src(desired_by_iface, res):
    """Pin the OUTBOUND source IP for each mesh link that set a dial_src — a /32 route to the peer endpoint
    with `src <dial_src>` in the main table (the encrypted tunnel UDP leaves the WAN, so this never touches
    the cascade 7000-band). `ip route replace` is atomic (no gap) so it's re-asserted every sync (reboot-safe);
    a cleared dial_src removes the route (diffed against a small state file). Never raises into the sync loop."""
    try:
        want = {}                                              # peer endpoint IP -> dial source IP
        for peers in (desired_by_iface or {}).values():
            for p in peers:
                ds = (p.get("dial_src") or "").strip(); ep = p.get("endpoint") or ""
                if not ds or not ep:
                    continue
                try:
                    want[socket.gethostbyname(ep.rsplit(":", 1)[0])] = ds
                except Exception:
                    continue                                   # unresolvable endpoint → skip (retry next sync)
        statef = os.path.join(STATE_DIR, "dial-src.json")
        prev = {}
        with contextlib.suppress(Exception):
            prev = json.load(open(statef))
        for ip in (set(prev) - set(want)):                     # dial_src cleared → drop our /32
            run(["ip", "route", "del", ip + "/32"]); res["changed"] = res.get("changed", 0) + 1
        for ip, ds in want.items():                            # (re)assert the source route (atomic, idempotent)
            g = run(["ip", "route", "get", ip]).stdout
            mdev = re.search(r"\bdev (\S+)", g); mvia = re.search(r"\bvia (\S+)", g)
            cmd = ["ip", "route", "replace", ip + "/32"]
            if mvia:
                cmd += ["via", mvia.group(1)]
            if mdev:
                cmd += ["dev", mdev.group(1)]
            cmd += ["src", ds]
            _rc = run(cmd).returncode
            if _rc != 0 and mvia:
                # Some providers hand the box a /32 and a gateway OUTSIDE it, so the gateway is on no
                # connected subnet and the default route works only because it carries `onlink`. A route
                # rebuilt from `ip route get` (which does not report the flag) is then rejected outright:
                # "Nexthop has invalid gateway". Measured on a live node — enp0s3 77.221.143.174/32 with
                # `default via 10.0.0.1 dev enp0s3 onlink`. Retry it the way the box's own default is
                # written. An ordinary subnet succeeds on the first attempt and never reaches this.
                _rc = run(cmd + ["onlink"]).returncode
            if _rc != 0:
                res["errors"].append("dial-src " + ip + ": route failed")
            elif prev.get(ip) != ds:
                res["changed"] = res.get("changed", 0) + 1
        if want != prev:
            with contextlib.suppress(Exception):
                with open(statef + ".tmp", "w") as f:
                    json.dump(want, f)
                os.replace(statef + ".tmp", statef)
    except Exception as e:
        res["errors"].append("dial-src: " + str(e)[:120])


def apply_panel_settings(pan):
    """Consume the sync-reply `panel` block (Panel settings): push the geo/turn mirrors via in-process env
    (existing readers pick them up untouched), set the runtime geo TTL, and force a geo re-fetch when the
    operator bumps the epoch (wipe the cache files so they read missing). Never raises."""
    try:
        if not isinstance(pan, dict):
            return
        if (pan.get("turn_mirror") or "").strip():             # only ADD a turn mirror (preserve any install-time one)
            os.environ["SWG_TURN_MIRROR"] = pan["turn_mirror"].strip()
        ep = str(int(pan.get("geo_epoch") or 0))
        ef = os.path.join(GEO_DIR, ".geo-epoch")
        cur = ""
        with contextlib.suppress(Exception):
            cur = open(ef).read().strip()
        if ep != cur:                                          # Refresh-geo pressed → drop cache so it refetches
            with contextlib.suppress(OSError):
                os.makedirs(GEO_DIR, exist_ok=True)
            for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
                if fn.endswith((".txt", ".attempt", ".loaded", ".doms")):
                    with contextlib.suppress(OSError):
                        os.unlink(os.path.join(GEO_DIR, fn))
            with contextlib.suppress(OSError):
                open(ef, "w").write(ep)
    except Exception:
        pass


def _apply_routing_reset(reset_val, res, learned_val=None):
    """Dispatch the operator's reset counters. A full reset already clears the learned sets, so skip the learned
    pass when it fired. Returns True if either reset ran."""
    full = _apply_full_reset(reset_val, res)
    learned = False if full else _apply_learned_reset(learned_val, res)
    return full or learned


def _apply_learned_reset(learned_val, res):
    """Operator pressed 'Reset learned IPs': clear ONLY the node's learned dst-IP sets (kernel-SNI ipsets + the
    userspace-SNI nft sets), keeping the pulled lists in place — no re-pull. This SAME reconcile pass rebuilds the
    nft sets from the still-cached lists (geoip re-loads) and the reader re-learns hosts as traffic flows. Fires once
    per press (per-node counter vs local stamp)."""
    try:
        rv = str(int(learned_val or 0))
    except Exception:
        rv = "0"
    stamp = os.path.join(GEO_DIR, ".routing-reset-learned")
    cur = ""
    with contextlib.suppress(Exception):
        cur = open(stamp).read().strip()
    if rv == cur or rv == "0":                                  # unchanged (or never reset) → nothing to do
        return False
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True)
    # kernel-SNI: flush each learned ipset (keep the set + chain — only the learned IPs go)
    for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
        run(["ipset", "flush", setn])
    # userspace-SNI: drop the rebuild signatures + per-list loaded markers so the nft sets rebuild from the CACHED
    # lists this pass (userspace-learned IPs go; geoip re-loads from the still-present .txt — NO re-pull)
    for fn in (".smart-sig", ".xtstring-sig", ".catcount-sig"):
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(GEO_DIR, fn))
    for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
        if fn.endswith(".loaded"):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, fn))
    run(["nft", "delete", "table", "inet", SMART_NFT_TABLE])    # rebuilt from cache below (same pass)
    _SMART_TABLE["n"] = -1                                      # invalidate the per-loop table cache so _ensure_smart_nft re-renders
    p = _SNI_PROC.get("p")                                      # restart the userspace reader → its in-memory learned/seen clears
    if p and p.poll() is None:
        with contextlib.suppress(Exception): p.terminate()
    _SNI_PROC["p"] = None
    with contextlib.suppress(OSError):
        open(stamp, "w").write(rv)
    res["changed"] += 1
    print("routing: LEARNED RESET #%s — flushed learned ipsets/nft sets (lists kept); re-learning" % rv, flush=True)
    return True


def _apply_full_reset(reset_val, res):
    """Operator pressed 'Reset routing' for this node: wipe ALL smart-routing state so the SAME reconcile pass
    rebuilds it from scratch and re-pulls every enabled/curated list from the panel. Idempotent — acts only when
    the panel's per-node counter differs from our local stamp (so it fires once per press, never on a normal sync).
    An explicit operator action, not an outage → safe to wipe (the never-wipe-on-outage invariant is about failed
    syncs, which never reach here). Returns True if it reset."""
    try:
        rv = str(int(reset_val or 0))
    except Exception:
        rv = "0"
    stamp = os.path.join(GEO_DIR, ".routing-reset")
    cur = ""
    with contextlib.suppress(Exception):
        cur = open(stamp).read().strip()
    if rv == cur or rv == "0":                                  # unchanged (or never reset) → nothing to do
        return False
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True)
    # 1) wipe the pulled-list cache + every rebuild signature → forces a fresh re-pull + full rebuild next
    for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
        if fn.endswith((".txt", ".doms", ".attempt", ".loaded")) or fn in (
                ".smart-sig", ".xtstring-sig", ".catcount-sig", ".geo-epoch", ".doh.sig", ".automerge-migrated"):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, fn))
    # 2) drop the nft smart table (all sets + chains + mark rules) → rebuilt below
    run(["nft", "delete", "table", "inet", SMART_NFT_TABLE])
    _SMART_TABLE["n"] = -1                                      # invalidate the per-loop table cache so _ensure_smart_nft re-renders (sees it gone) and RECREATES it this same pass
    # 3) drop the kernel-SNI iptables chain + destroy the learned ipsets
    run(["iptables", "-t", "mangle", "-D", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", "SWGK"])
    run(["iptables", "-t", "mangle", "-F", "SWGK"]); run(["iptables", "-t", "mangle", "-X", "SWGK"])
    for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
        run(["ipset", "destroy", setn])
    # 4) restart the userspace SNI reader so its in-memory learned set clears (relaunched by _ensure_sni_router)
    p = _SNI_PROC.get("p")
    if p and p.poll() is None:
        with contextlib.suppress(Exception): p.terminate()
    _SNI_PROC["p"] = None
    with contextlib.suppress(OSError):
        open(stamp, "w").write(rv)
    res["changed"] += 1
    print("routing: FULL RESET #%s — wiped sets/chains/ipsets/list-cache; rebuilding + re-pulling" % rv, flush=True)
    return True


def reconcile_cascade(node_cfg, plan, smart=None, default_egress_ip="", panel_conn=None, panel_cfg=None):
    """Phase 2 cascade + Phase 3 smart routing. ENTRY (P2 forward): `ip rule from S lookup T`; ENTRY
    (P3 smart): nftables marks `ip saddr S ip daddr @<category> meta mark set T` then `ip rule fwmark T
    lookup T` — both route into `default dev <link> table T`. EXIT (shared): `ip rule to S lookup T` +
    `S dev <link> table T` + SNAT S out the WAN. Idempotent: policy rules/routes are rebuilt only when
    they DRIFT from the plan (a signature compare — never churn each sync, which would leak a packet to
    direct egress mid-gap); the iptables + nft sides are diffed by tag/signature. Runtime state is lost on
    reboot, so this re-applies on the first sync after one. Returns {changed, errors}."""
    res = {"changed": 0, "errors": []}
    plan = plan or {}
    fwd = plan.get("forward") or []
    exit_ = plan.get("exit") or []
    smart_e = (smart or {}).get("entries") or []
    smart_exit = [e for e in smart_e if e.get("action", "exit") == "exit"]   # only exit rules carry a mesh table/dev; direct/block are local verdicts
    mode = (smart or {}).get("mode") or "kernel"               # kernel | forcedns | sni | sni_kernel — the CONFIGURED host-match mode
    _SMART_MODE["m"] = mode                                     # report the configured mode for the panel's host-layer health
    # Resolve the ACTUAL host-fill engine; degrade kernel-SNI → userspace SNI if xt_string/ipset are missing on this box.
    if mode == "forcedns":     host_engine = "dns"
    elif mode == "sni":        host_engine = "sni_user"
    elif mode == "sni_kernel": host_engine = "sni_kernel" if _kernel_sni_ok() else "sni_user"
    else:                      host_engine = "none"
    is_sni = host_engine in ("sni_user", "sni_kernel")         # both SNI engines share the nft ct-restore/QUIC-drop/reset setup
    _SMART_MODE["engine"] = host_engine                        # the ACTUAL running engine → smart_status reports its liveness
    _apply_routing_reset((smart or {}).get("routing_reset"), res, (smart or {}).get("routing_reset_learned"))   # operator resets: full wipe+re-pull, or learned-IPs-only
    ip_learning = (smart or {}).get("ip_learning", True)       # False → keep the node "fresh": learned SNI IPs expire fast (short TTL)
    learn_ttl = 3600 if ip_learning else 120                   # learned-IP lifetime (s) — kernel-SNI ipset AND Hybrid-SNI catl_ set
    _CAT_CAPS.clear(); _CAT_CAPS.update((smart or {}).get("cat_caps") or {})   # panel-shipped caps → host-tier seeding + kernel greying
    # PROVIDER lists: pull each routed one from the PANEL (not GitHub) when its version changed — writes the same
    # <cat>.txt / <cat>.doms the loaders below consume. New cat → now; changed cat → only in the quiet window.
    _panel_list_refresh((smart or {}).get("list_manifest") or {}, (panel_cfg or {}).get("geo_update") or {},
                        panel_conn, res)
    band = _live_band_prios()
    want_tables = {str(e["table"]) for e in (fwd + smart_exit + exit_)}
    want_sig = _cascade_want_sig(fwd, exit_, smart_exit)   # only exit entries create fwmark→table policy routing
    live_sig = _cascade_live_sig({str(p) for p in band} | want_tables)
    # POLICY RULES/ROUTES — only touch them when they drift (avoids per-sync rule gaps).
    if want_sig != live_sig:
        if fwd or smart_e or exit_:                            # enable forwarding + loose rp_filter (asymmetric paths)
            run(["sysctl", "-q", "-w", "net.ipv4.ip_forward=1"])
            wan = _detect_wan()
            for dev in sorted({"all", wan} | {e["via_iface"] for e in (fwd + smart_exit + exit_)}):
                run(["sysctl", "-q", "-w", f"net.ipv4.conf.{dev}.rp_filter=2"])   # effective = max(all,dev): lower BOTH
        for pri in band:                                       # teardown our whole band (rules + tables)
            for _ in range(8):                                 # del-until-absent (a priority may carry several rules)
                if run(["ip", "rule", "del", "pref", str(pri)]).returncode != 0:
                    break
            run(["ip", "route", "flush", "table", str(pri)])
        for e in fwd:                                          # P2 ENTRY: from S → table T (default via link)
            T = str(e["table"]); S = e["subnet"]; dev = e["via_iface"]
            run(["ip", "route", "replace", "default", "dev", dev, "table", T])
            run(["ip", "rule", "add", "from", S, "lookup", T, "priority", T])
            res["changed"] += 1
        for T, dev in sorted({(str(e["table"]), e["via_iface"]) for e in smart_exit}):   # P3 ENTRY: fwmark T → table T
            run(["ip", "route", "replace", "default", "dev", dev, "table", T])
            run(["ip", "rule", "add", "fwmark", T, "lookup", T, "priority", T])
            res["changed"] += 1
        for e in exit_:                                        # EXIT: to S → table T (S via link)
            T = str(e["table"]); S = e["subnet"]; dev = e["via_iface"]
            run(["ip", "route", "replace", S, "dev", dev, "table", T])
            run(["ip", "rule", "add", "to", S, "lookup", T, "priority", T])
            res["changed"] += 1
    # IPTABLES (SNAT / FORWARD accept / MSS clamp) — always reconciled by tag (cheap, no-churn).
    _ensure_fwd_iptables(fwd, exit_, _detect_wan(), res, default_egress_ip)
    # NFTABLES smart-routing marking (saddr+daddr@category → mark T) — drift-gated, packets stay in-kernel.
    smart_cats = sorted(set((smart or {}).get("categories") or []) | {e["category"] for e in smart_e})
    _smart_subs = {e["subnet"] for e in smart_e}                # smart interfaces (by subnet) → IPv6 fail-closed drop
    # v6 fail-closed drop set = every LOCAL iface whose subnet is smart-routed. Include the self-contained kinds
    # (WDTT userspace-WG + csqtt raw TUN, both IPv4-only) so v6 can't leak past their v4-only smart routing — they
    # live outside node_cfg["interfaces"], so without this they were the one datapath bit missing full parity.
    smart_ifs = sorted(({ifn for ifn in (node_cfg.get("interfaces") or {}) if _iface_subnet(node_cfg, ifn) in _smart_subs}
                        | {ifn for ifn, w in _wdtt_load().items() if _wdtt_subnet((w or {}).get("wg_addr") or "") in _smart_subs}
                        | {(_wdtt_raw(w) or ("", "", ""))[1] for w in _wdtt_load().values()
                           if _wdtt_raw(w) and _wdtt_subnet(_wdtt_raw(w)[2]) in _smart_subs}   # the RAW TUN of a smart-routed qWDTT instance — v6 must fail closed there too
                        | {ifn for ifn, c in _csqtt_load().items() if _csqtt_subnet((c or {}).get("tun_addr") or "") in _smart_subs})) if _smart_subs else []
    set_counts = _ensure_smart_nft(smart_e, smart_cats, res, pin=is_sni, v6_ifaces=smart_ifs,
                                    reset_mark=(SNI_RESET_MARK if is_sni else 0), queue=(host_engine == "sni_user"),
                                    learn_ttl=learn_ttl)
    domains = dict((smart or {}).get("domains") or {})         # domain-tier bundles {cat:[domain]} → dnsmasq/sni/kernel-filled
    if mode != "kernel":                                       # CATALOG host cats (no curated bundle) → seed empty so the node domain-fills them from MetaCubeX
        for _c, _caps in _CAT_CAPS.items():
            if _caps.get("host") and _c not in domains and _c in smart_cats:
                domains[_c] = []
    # GeoSite host tier: enrich each panel-shipped domain cat with the node-fetched upstream list (union), so the
    # curated bundle stays a guaranteed fallback. The union+sort of a ~100k-entry list is expensive to redo every
    # cycle, so cache the enriched dict on a CHEAP signature of the inputs — subnets + the raw panel bundles (small)
    # + each fetched cat's geo-file (mtime,size) — never touching the big lists. Unchanged inputs reuse the enriched
    # dict AND tell _ensure_smart_dnsmasq to skip its (equally expensive) config rebuild. This keeps domains[cat]
    # populated either way, so the geoip↔domain split below (skip=...) stays correct.
    _host_cats = [c for c in domains if _CAT_CAPS.get(c, {}).get("host")]
    if host_engine == "dns":                                   # Force-DNS loads full lists into the per-domain dnsmasq
        _admit = set(_forcedns_admit(_host_cats, res))         # map → memory-gate it; over-budget cats stay off (reported)
        for c in _host_cats:
            if c not in _admit:
                domains.pop(c, None)                           # not loaded → not filled: honest degrade, node stays online
        _host_cats = [c for c in _host_cats if c in _admit]
    else:
        _SMART_MODE.pop("fill_gate", None)                     # gate only governs the dnsmasq fill; clear when not in it
    _fetched = _smart_domain_refresh(_host_cats, res)
    dom_sig = (tuple(sorted({e["subnet"] for e in smart_e})), json.dumps(domains, sort_keys=True),
               tuple(sorted((c, _DOM_CACHE.get(c, (None,))[0]) for c in _fetched)))
    _dt = _DOMTIER_CACHE.get("v")
    dom_unchanged = bool(_dt and _dt[0] == dom_sig)
    if dom_unchanged:
        domains = _dt[1]                                       # inputs unchanged → reuse enriched dict (skip union+sort)
    else:
        for cat, fl in _fetched.items():
            domains[cat] = sorted(set(domains.get(cat) or []) | set(fl))
        _DOMTIER_CACHE["v"] = (dom_sig, domains)
    # GEOIP cats fill from cached CIDR lists (TTL-gated); domain cats are owned by dnsmasq → skip them here. A
    # cat is demoted from geoip only once it actually HAS domains, so a geoip-only cat (ru_net) never demotes and a
    # domain-capable cat stays geoip until its upstream domain list lands rather than going briefly empty.
    if smart_cats:
        _smart_geo_refresh(smart_cats, set_counts or {}, res, skip={c for c, v in domains.items() if v})
    _smart_load_cidrs((smart or {}).get("cidrs") or {}, set_counts or {}, res)   # custom-rule raw IPs/CIDRs → into the set
    _subs = sorted({e["subnet"] for e in smart_e})
    _mech = (smart or {}).get("mech") or {}                   # {subnet: [mechanism ids]} → FREE L4/rate drops (mode-independent)
    _doh_mech = {s for s, cats in _mech.items() if "doh" in (cats or [])}   # explicit per-interface DoH-block mechanism
    if host_engine == "sni_user":                             # userspace swg-sni fills the domain cats from the TLS
        _ensure_sni_router(domains, _subs, res, learn_ttl)    # handshake (client DNS untouched); enriched lists OK here
        _ensure_smart_xtstring([], {}, 0, res, active=False)  # ensure the kernel engine is torn down
        reconcile_catk_chain([])                              # not kernel-SNI → drop the per-category counting chain
        if _dnsmasq_running() or os.path.exists(DNSMASQ_CONF):
            _ensure_smart_dnsmasq({}, [], res, unchanged=False)
    elif host_engine == "sni_kernel":                         # in-kernel xt_string reader — no userspace daemon at all
        _ensure_sni_router(None, [], res)                     # stop swg-sni
        _ensure_smart_xtstring(smart_exit, domains, SNI_RESET_MARK, res, ttl=learn_ttl)   # enriched domains, capped per-cat inside (256)
        reconcile_catk_chain(sorted({e["category"] for e in smart_exit if domains.get(e["category"])}))   # per-category dest byte counters (swgk sets)
        if _dnsmasq_running() or os.path.exists(DNSMASQ_CONF):
            _ensure_smart_dnsmasq({}, [], res, unchanged=False)
    else:                                                     # forcedns (dnsmasq oracle) or kernel/IP-only (nothing)
        _ensure_sni_router(None, [], res)                     # not SNI → stop the classifier + drop its map
        _ensure_smart_xtstring([], {}, 0, res, active=False)  # ensure the kernel engine is torn down
        reconcile_catk_chain([])                              # not kernel-SNI → drop the per-category counting chain
        if smart_e or domains or _dnsmasq_running() or os.path.exists(DNSMASQ_CONF):
            _ensure_smart_dnsmasq(domains, smart_e, res, unchanged=dom_unchanged)
    # Encrypted-DNS (DoH/DoT) guard: forcedns AUTO-blocks every smart subnet (so the dnsmasq domain fill can't be
    # bypassed); SNI modes leave the client's DNS untouched by default — but an explicit per-interface DoH-block
    # mechanism blocks it in ANY mode. Union the two; empty → the swg_doh table is torn down (never-wipe, our table only).
    _doh_subs = set(_doh_mech)
    if host_engine not in ("sni_user", "sni_kernel") and (smart or {}).get("block_doh"):
        _doh_subs |= set(_subs)
    _ensure_doh_block(sorted(_doh_subs), bool(_doh_subs), res)
    _ensure_mech_block(_mech, res)                            # FREE traffic/abuse L4/rate drops (smtp/quic/torrents-porthint/portscan)
    _ensure_torrent_sig(sorted({s for s, cats in _mech.items() if "torrents" in (cats or [])}), res)   # Phase 3: bounded signature drop (any-port), where xt_string is capable
    return res


_KSNI = {"ok": None}            # cached kernel-SNI capability (ipset tool + iptables xt_string) — stable per boot


def _kernel_sni_ok():
    """True if the kernel-SNI datapath is usable on this box: the `ipset` tool AND iptables `-m string` (xt_string).
    Cached (stable until the box changes + noded restarts). Used to degrade-open to the userspace engine if absent."""
    if _KSNI["ok"] is None:
        _KSNI["ok"] = (run(["sh", "-c", "command -v ipset >/dev/null 2>&1"]).returncode == 0
                       and run(["sh", "-c", "iptables -m string --help >/dev/null 2>&1"]).returncode == 0)
    return _KSNI["ok"]


def _xts_setname(cat):
    return ("swgk_" + re.sub(r"[^a-z0-9]", "_", cat.lower()))[:31]   # ipset names cap at 31 chars


def _ensure_smart_xtstring(host_entries, domains, reset_mark, res, active=True, ttl=3600):
    """Kernel-SNI host tier (mode=sni_kernel): learn each host category's dst IPs IN-KERNEL from the TLS SNI
    (iptables `-m string` Boyer-Moore on the ClientHello) into a per-category ipset, route KNOWN IPs to that
    category's exit fwmark (CONNMARK — the nft ct-restore carries it to the packet), and flag the FIRST hit with
    reset_mark (→ the shared nft forward reject → RST → client reconnects routed). No userspace daemon; runs
    parallel per-CPU in softirq. Reuses the shared fwmark→mesh band + the shared reset rule. Drift-gated.

    host_entries: exit rules [{subnet, category, table}] whose category has domains. domains: {cat:[domain]} — the
    SMALL curated bundle ONLY (never the geosite-enriched list → that'd be tens of thousands of xt_string rules).
    active=False (or no host entries) → full teardown."""
    CHAIN = "SWGK"
    entries = [e for e in host_entries if domains.get(e["category"])] if active else []
    # Remember WHY the chain may be absent. "No entries" is the normal, correct state for an all-direct/all-block
    # ruleset, or for the window right after a node restart before the domain lists have been pulled — but the
    # health probe below only sees "the SWGK hook isn't there" and reported the engine DOWN, which is a red badge
    # on a node with nothing wrong with it.
    _SMART_MODE["xts_idle"] = not entries
    want_cats = sorted({e["category"] for e in entries})
    sig_src = (json.dumps([[e["subnet"], e["category"], e.get("table")] for e in entries], sort_keys=True)
               + "|" + json.dumps({c: sorted((domains.get(c) or [])[:256]) for c in want_cats}, sort_keys=True) + "|rm:" + str(reset_mark) + "|ttl:" + str(ttl))
    sig = hashlib.sha1(sig_src.encode()).hexdigest()[:16]
    sigf = os.path.join(GEO_DIR, ".xtstring-sig")
    try:
        stored = open(sigf).read().strip()
    except OSError:
        stored = ""
    hooked = run(["iptables", "-t", "mangle", "-C", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN]).returncode == 0
    if stored == sig and (hooked or not entries):              # steady state: keep the ipsets alive (they hold learned IPs — NEVER flush here)
        for c in want_cats:
            run(["ipset", "create", _xts_setname(c), "hash:ip", "family", "inet", "timeout", str(ttl), "-exist"])
        return
    if entries and not _kernel_sni_ok():
        res["errors"].append("kernel-sni: ipset/xt_string unavailable"); return
    run(["iptables", "-t", "mangle", "-D", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN])   # unhook, rebuild fresh
    run(["iptables", "-t", "mangle", "-F", CHAIN]); run(["iptables", "-t", "mangle", "-X", CHAIN])
    ttl_marker = os.path.join(GEO_DIR, ".xtstring-ttl")         # a TTL change (IP-learning toggled) can't be applied to a live set → recreate
    prev_ttl = ""
    with contextlib.suppress(Exception):
        prev_ttl = open(ttl_marker).read().strip()
    if entries and str(ttl) != prev_ttl:
        for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
            run(["ipset", "destroy", setn])
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True); open(ttl_marker, "w").write(str(ttl))
    if not entries:                                            # teardown: drop the chain + our learned ipsets
        for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
            run(["ipset", "destroy", setn])
        with contextlib.suppress(OSError):
            os.remove(sigf)
        return
    _ok = [True]
    def _ipt(*a):
        r = run(["iptables", "-t", "mangle", *a])
        if r.returncode != 0:
            res["errors"].append("kernel-sni: " + (r.stderr or "").strip()[:120]); _ok[0] = False
    for c in want_cats:                                        # per-category learned-IP set MUST exist before the rules reference it
        run(["ipset", "create", _xts_setname(c), "hash:ip", "family", "inet", "timeout", str(ttl), "-exist"])
    _ipt("-N", CHAIN)
    for e in entries:                                          # Phase 1: route KNOWN learned IPs to their exit, then RETURN
        setn = _xts_setname(e["category"]); T = str(e.get("table"))   # (so a known flow never re-learns / re-resets)
        _ipt("-A", CHAIN, "-s", e["subnet"], "-m", "set", "--match-set", setn, "dst", "-j", "CONNMARK", "--set-mark", T)
        _ipt("-A", CHAIN, "-s", e["subnet"], "-m", "set", "--match-set", setn, "dst", "-j", "RETURN")
    for e in entries:                                          # Phase 2: FIRST hit — read the SNI in-kernel, learn + flag
        setn = _xts_setname(e["category"])
        for d in (domains.get(e["category"]) or [])[:256]:     # cap per-cat rules; kernel routing lists are small (youtube≈177)
            _ipt("-A", CHAIN, "-s", e["subnet"], "-p", "tcp", "--dport", "443", "-m", "string", "--algo", "bm", "--string", d, "-j", "SET", "--add-set", setn, "dst")
        if reset_mark:
            for d in (domains.get(e["category"]) or [])[:256]:
                _ipt("-A", CHAIN, "-s", e["subnet"], "-p", "tcp", "--dport", "443", "-m", "string", "--algo", "bm", "--string", d, "-j", "CONNMARK", "--set-mark", hex(reset_mark))
    _ipt("-A", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN)   # hook once, last
    if _ok[0]:
        res["changed"] += 1
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True); open(sigf, "w").write(sig)


def _ensure_sni_router(domains, subnets, res, learn_ttl=3600):
    """SNI mode: write the domain→category map for swg-sni and keep the classifier running; any other mode stops it
    and drops the map. swg-sni reads each connection's ClientHello off the NFQUEUE that _ensure_smart_nft set up
    and adds the dst IP to the matched category set, so the kernel routes FUTURE connections to that IP — the
    client's own DNS (incl. DoH/DoT) is never touched. Supervised as a subprocess (shares swg-noded's cgroup, so it
    dies on a noded restart and is relaunched here)."""
    want = domains is not None and bool(subnets)
    # Nothing to route (no interface carries a routed category yet) ⇒ the classifier is stopped ON PURPOSE.
    # Without this the health badge read the absent process as a failure and cried "SNI parser down — host
    # routing degraded" on a node that was working exactly as configured — which is the first thing an operator
    # sees after picking an SNI mode but before assigning any category. Mirrors `xts_idle` on the kernel path.
    _SMART_MODE["sni_idle"] = not want
    p = _SNI_PROC.get("p")
    if not want:
        if p and p.poll() is None:
            with contextlib.suppress(Exception): p.terminate()
        _SNI_PROC["p"] = None
        with contextlib.suppress(OSError): os.remove(SNI_MAP_PATH)
        return
    if p and p.poll() is None and _SNI_PROC.get("ttl") != learn_ttl:   # ip_learning TTL flipped → relaunch so swg-sni's seen-cache
        with contextlib.suppress(Exception): p.terminate()            # TTL matches the new learned-set timeout (else a 3600→120 flip leaks)
        _SNI_PROC["p"] = None; p = None
    try:                                                       # write the map only when it changes (cheap; swg-sni reloads on mtime)
        newmap = json.dumps({c: sorted(d) for c, d in (domains or {}).items() if d}, sort_keys=True)
        old = ""
        with contextlib.suppress(OSError):
            with open(SNI_MAP_PATH) as f: old = f.read()
        if newmap != old:
            os.makedirs(os.path.dirname(SNI_MAP_PATH), exist_ok=True)
            with open(SNI_MAP_PATH + ".tmp", "w") as f: f.write(newmap)
            os.replace(SNI_MAP_PATH + ".tmp", SNI_MAP_PATH)
            res["changed"] += 1
    except Exception as e:
        res["errors"].append("sni map: " + str(e)[:120]); return
    if not p or p.poll() is not None:                          # (re)launch the classifier if it isn't running
        exe = next((c for c in (os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "swg-sni"),
                                "/opt/swg-noded/swg-sni", "/usr/local/bin/swg-sni") if os.path.exists(c)), None)
        if not exe:
            res["errors"].append("sni: swg-sni not found"); return
        try:
            log = open("/var/lib/swg-noded/swg-sni.log", "a")
            _SNI_PROC["p"] = subprocess.Popen([sys.executable, exe, "--queue", str(SNI_NFQUEUE),
                                               "--map", SNI_MAP_PATH, "--table", SMART_NFT_TABLE,
                                               "--reset-mark", hex(SNI_RESET_MARK), "--learn-ttl", str(learn_ttl)],
                                              stdout=log, stderr=log)
            _SNI_PROC["ttl"] = learn_ttl
            res["changed"] += 1; print("sni: launched swg-sni (queue %d, learn-ttl %d)" % (SNI_NFQUEUE, learn_ttl), flush=True)
        except Exception as e:
            res["errors"].append("sni launch: " + str(e)[:120])


def _block_activity():
    """Per-subnet blocking ACTIVITY, harvested from EXISTING datapath state — NO new counters, no per-packet cost:
      torrent = iptables SWGP signature chain: the CONNMARK-set rule's per-subnet count (≈ torrent connections caught)
      scan    = the port-scan meter's live element count (hosts currently rate-limited for scanning/flooding)
    Reach (distinct blocked destinations) is already in smart_status.sets (the cat_blku_* set element counts), so it
    needs nothing here. Best-effort — any read that fails just omits that signal (never raises). Returns {subnet:{…}}."""
    out = {}
    IP = r"\d+\.\d+\.\d+\.\d+/\d+"
    with contextlib.suppress(Exception):                          # torrent: iptables always counts; sum the signature-match rule per source subnet
        for ln in (run(["iptables", "-t", "mangle", "-nvL", "SWGP", "-x"]).stdout or "").splitlines():
            f = ln.split()
            if "CONNMARK" in ln and f and f[0].isdigit():
                subs = [x for x in f if re.match("^" + IP + "$", x)]
                if subs:
                    out.setdefault(subs[0], {})["torrent"] = int(f[0])
    with contextlib.suppress(Exception):                          # scan: the FLAGGED-scanner set per subnet — only over-rate src IPs
        mech = run(["nft", "list", "table", "inet", "swg_mech"]).stdout or ""   # land there, so it's the REAL scanners (not every active
        for sub, fset in re.findall(r"ip saddr (" + IP + r")[^\n]*?add @(pscf_\S+)", mech):   # source) + their IPs → per-user attribution
            with contextlib.suppress(Exception):
                # Bound the read to THIS set's own block. An empty set prints no `elements` line at all, so a
                # search that just ran on from the set's name found the NEXT set's elements instead — and every
                # quiet subnet was then reported as having the busy one's scanner, by IP. That IP is mapped to a
                # peer and shown as "who", so the cost was naming an innocent user on another interface as the
                # scanner. nft closes a set with `}` alone on its line; the elements line never is.
                blk = re.search(r"set " + re.escape(fset) + r" \{(.*?)\n[ \t]*\}", mech, re.S)
                sm = re.search(r"elements = \{([^}]*)\}", blk.group(1)) if blk else None
                ips = re.findall(r"\d+\.\d+\.\d+\.\d+", sm.group(1)) if sm else []
                out.setdefault(sub, {})["scan"] = len(ips)
                if ips:
                    out[sub]["scan_ips"] = ips                    # source IPs the panel maps → peer → user for the "who" bubble
    with contextlib.suppress(Exception):                          # blocked: cumulative packets dropped to a content-block set,
        pre = run(["nft", "list", "chain", "inet", SMART_NFT_TABLE, "prerouting"]).stdout or ""   # summed per source subnet
        for ln in pre.splitlines():                               # rule: ip saddr <sub> ip daddr @cat_blku_… counter packets N … drop
            if "blku" not in ln or "drop" not in ln:
                continue
            sub = re.search(r"ip saddr (" + IP + r")", ln)
            pk = re.search(r"counter packets (\d+)", ln)
            if sub and pk:                                        # cat_ AND catl_ (Hybrid) drop rules both count → sum per subnet
                out.setdefault(sub.group(1), {})
                out[sub.group(1)]["blocked"] = out[sub.group(1)].get("blocked", 0) + int(pk.group(1))
    with contextlib.suppress(Exception):                          # torrent SOURCE IPs (who tried torrents) from the swgp_src
        il = run(["ipset", "list", "swgp_src"]).stdout or ""      # presence set, matched into the subnet they belong to
        tips = re.findall(r"\d+\.\d+\.\d+\.\d+", il.split("Members:", 1)[-1]) if "Members:" in il else []
        for ip in tips:
            with contextlib.suppress(Exception):
                a = ipaddress.ip_address(ip)
                for sub in list(out):
                    if a in ipaddress.ip_network(sub, strict=False):
                        out[sub].setdefault("torrent_ips", []).append(ip); break
    return out


def _blk_domains_read():
    """swg-sni's bounded top-K of blocked hostnames (host → cumulative hit count). The PANEL buckets these into content
    categories (it owns the per-category source lists), so no per-category datapath is needed. Userspace-SNI mode only;
    best-effort, empty if the file is absent (other engines / SNI off)."""
    with contextlib.suppress(Exception):
        with open(os.path.join(os.path.dirname(SNI_MAP_PATH), "sni-blk-hits.json")) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return {str(k): int(v) for k, v in d.items() if isinstance(v, (int, float)) and int(v) > 0}
    return {}


def smart_status():
    """Phase 3 smart-routing health for the panel UI: whether our nft table is up, per-category element counts
    (a populated set = data loaded), active mark-rule count, and HOST-LAYER health — the configured mode, whether
    the mode's fill engine is alive (swg-sni for SNI, dnsmasq for Force-DNS), and the SNI first-hit reset hit-count.
    So the operator sees a silent host-layer failure (dead reader / never learning) instead of just missing routes."""
    t = _smart_table()                                          # shared per-loop render + parse (also used by _ensure_smart_nft)
    mode = _SMART_MODE.get("m") or "kernel"
    engine = _SMART_MODE.get("engine") or "none"                # actual running engine: none|dns|sni_user|sni_kernel
    sni_alive = bool(_SNI_PROC.get("p") and _SNI_PROC["p"].poll() is None)
    dns_alive = bool(_dnsmasq_running())
    if engine == "sni_user":     engine_ok = sni_alive or bool(_SMART_MODE.get("sni_idle"))   # up, or idle by design (nothing routed)
    elif engine == "sni_kernel":                                # the hook is torn down on purpose when there is nothing to route
        engine_ok = bool(_SMART_MODE.get("xts_idle")) or run(
            ["iptables", "-w", "2", "-t", "mangle", "-C", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", "SWGK"]).returncode == 0
    elif engine == "dns":        engine_ok = dns_alive and _route_localnet_ok()   # dnsmasq up AND loopback-DNAT possible
    else:                        engine_ok = True               # IP-only → no host engine to be down
    base = {"mode": mode, "engine": engine, "engine_ok": engine_ok, "sni_alive": sni_alive,
            "dnsmasq": dns_alive, "route_localnet": _route_localnet_ok()}   # false in dns mode ⇒ client DNS blackholed (container)
    if _SMART_MODE.get("fill_gate"):                           # Force-DNS fill skipped over-budget categories → tell the panel
        base["fill_gate"] = _SMART_MODE["fill_gate"]
    if t["rc"] != 0:
        # No CONTENT table — but the FREE abuse tier (swg_mech: smtp / torrent ports / port-scan) is a separate
        # datapath that does not need one, and turning ONLY those on is an ordinary configuration. `block` used to
        # live solely on the path below, so such a node harvested its torrent / scanner / drop counts and then
        # reported none of them: the filters worked and the Protection card stayed empty for ever. Report them
        # here too — gated on the tier actually being configured, so a node with NO blocking at all still pays
        # nothing for the harvest (it shells out to iptables/nft/ipset).
        return {**base, "active": False, "sets": {}, "rules": 0, "resets": 0,
                **({"block": _block_activity()} if _MECH_ON["subs"] else {})}
    rules = len(re.findall(r"ip saddr \S+ ip daddr @\S+ meta mark set", t["out"]))
    resets = sum(int(x) for x in re.findall(r"meta mark 0x0*9999 counter packets (\d+)", t["out"]))   # SNI first-hit RSTs
    return {**base, "active": rules > 0, "sets": dict(t["counts"]), "rules": rules,
            "bytes": dict(t["bytes"]), "resets": resets,   # bytes: {cat:{up,dn}} cumulative destination stats
            "block": _block_activity(),                    # {subnet:{torrent,scan}} blocking activity from existing state (reach is in `sets`)
            "blk_domains": _blk_domains_read()}            # {host:count} blocked-domain top-K (SNI mode) → panel buckets into categories


_CATS = {"t": 0.0, "cum": {}, "rate": {}}


def sample_cats():
    """LATEST per-category throughput {cat:{up,dn}} B/s — the delta of the cumulative nft category counters
    (harvested by _smart_table) over the last interval. The LIVE 'traffic by destination' figure: the most
    recent push, not a window average. Reset/vanish-safe; cheap (reuses the per-loop dump — no new subprocess)."""
    t = _smart_table()
    if t["rc"] != 0:
        _CATS["rate"] = {}
        return {}
    cum = t["bytes"]
    now = time.time()
    prev, pt = _CATS["cum"], _CATS["t"]
    if prev and now > pt:
        dt = now - pt
        r = {}
        for cat, v in cum.items():
            if str(cat).startswith("blku"):      # block-list set — a drop target, not a destination category; keep it
                continue                          # out of the "top destinations" throughput (its reach lives in `sets`)
            p = prev.get(cat) or {}
            r[cat] = {"up": max(0.0, v.get("up", 0) - p.get("up", 0)) / dt,   # counter reset (rebuild/reboot) → drop → 0
                      "dn": max(0.0, v.get("dn", 0) - p.get("dn", 0)) / dt}
        _CATS["rate"] = r
    _CATS["cum"] = cum
    _CATS["t"] = now
    return dict(_CATS["rate"])


# ───────────────────────── internet egress volume (measured, not estimated) ─────────────────────────
# The exact bytes this node forwards to/from the INTERNET, read off the per-iface FORWARD ACCEPT counters
# the agent installs in every interface's PostUp (`-i <iface> -o <wan>` = upload · `-i <wan> -o <iface>` =
# download). Counting is free (kernel keeps these counters always-on); we only READ them, and only on a slow
# gate (~15s) — NEVER on the 5s snapshot path — caching the rate so build_snapshot just attaches the cache.
# Correct for multi-hop by construction: at an ENTRY forwarded traffic goes iface→mesh (both tunnels, no `-o
# <wan>` match), so only DIRECT client traffic counts; at an EXIT the mesh iface forwards to the WAN
# (`-i swg_… -o <wan>`), so the relayed volume is attributed to the node that actually reaches the internet.
INET_SAMPLE_EVERY_S = 5    # match the client/mesh lanes' 5s cadence — a mangle-table iptables-save is ~1-3ms (geo sets live in a separate nft table), measured negligible on a 1-CPU node
SWG_INET_TABLE = "mangle"        # count in MANGLE FORWARD, not filter — see reconcile_inet_chain
SWG_INET_CHAIN = "SWG_INET"      # our own chain, jumped from mangle FORWARD: counts tunnel↔wan bytes
_INET = {"t": 0.0, "cum": None, "rate": {"up": 0.0, "down": 0.0}}


def reconcile_inet_chain(node_cfg):
    """Maintain the SWG_INET counting chain: one up (iface→wan) + one down (wan→iface) rule per managed
    tunnel iface, tagged with a comment, jumped from mangle FORWARD. The rules carry NO target, so they only
    COUNT and fall through — the packet's verdict is unchanged (no datapath effect).

    Why MANGLE FORWARD (not filter): netfilter traverses the mangle FORWARD hook BEFORE the filter table, so
    the counters see every forwarded packet regardless of the server's firewall. On a box running firewalld/
    ufw the filter FORWARD chain often starts with `ctstate ESTABLISHED,RELATED -j ACCEPT`, which would accept
    the return (download) traffic before any filter-level counter — undercounting there. Counting in mangle is
    config-independent: it works the same on a bare Debian box, a firewalld CentOS, an lxc/kvm guest, or the
    host-netns docker node. Mangle has no ACCEPT/DROP that terminates, so our fall-through rules never disturb
    the smart-routing marks either. WAN is the default-route egress (`ip route get 1.1.1.1`) — generic across
    providers/NIC names. Rebuilt only when the iface-set/WAN signature changes, so counters keep accruing.
    Best-effort (a node without iptables just no-ops)."""
    T = SWG_INET_TABLE
    managed = set((node_cfg.get("interfaces") or {}).keys())
    with contextlib.suppress(Exception):
        managed |= set(_wdtt_load().keys())   # WDTT owns its TUN + MASQUERADEs directly → count its internet egress too (feeds the flow-map internet lane)
    managed = sorted(managed)
    if not managed:
        return
    wan = _detect_wan()
    if not wan:
        return
    if run(["iptables", "-t", "filter", "-nL", SWG_INET_CHAIN]).returncode == 0:   # migrate: earlier builds
        run(["iptables", "-t", "filter", "-D", "FORWARD", "-j", SWG_INET_CHAIN])    # put this chain in FILTER;
        run(["iptables", "-t", "filter", "-F", SWG_INET_CHAIN])                     # drop it so counts don't
        run(["iptables", "-t", "filter", "-X", SWG_INET_CHAIN])                     # split across two tables
    if run(["iptables", "-t", T, "-nL", SWG_INET_CHAIN]).returncode != 0:
        run(["iptables", "-t", T, "-N", SWG_INET_CHAIN])          # create the chain (idempotent)
    if ("-j " + SWG_INET_CHAIN) not in (run(["iptables", "-t", T, "-S", "FORWARD"]).stdout or ""):
        run(["iptables", "-t", T, "-I", "FORWARD", "1", "-j", SWG_INET_CHAIN])   # count before anything else
    cur = run(["iptables", "-t", T, "-S", SWG_INET_CHAIN]).stdout.splitlines()
    cursig = set()
    for ln in cur:
        m = re.search(r'--comment "?(swg-inet-(?:up|dn)):([^"\s]+)', ln)   # `-S` QUOTES the comment — tolerate it, else cursig is always empty → constant flush → counters never accrue
        if not m:
            continue
        mi = re.search(r"-i (\S+)", ln); mo = re.search(r"-o (\S+)", ln)
        cursig.add((m.group(1), m.group(2), mi.group(1) if mi else "", mo.group(1) if mo else ""))
    wantsig = set()
    for ifn in managed:
        wantsig.add(("swg-inet-up", ifn, ifn, wan)); wantsig.add(("swg-inet-dn", ifn, wan, ifn))
    if cursig == wantsig:
        return                                              # unchanged → leave the counters accumulating
    run(["iptables", "-t", T, "-F", SWG_INET_CHAIN])          # iface set / WAN changed → rebuild
    for ifn in managed:
        run(["iptables", "-t", T, "-A", SWG_INET_CHAIN, "-i", ifn, "-o", wan,
             "-m", "comment", "--comment", "swg-inet-up:" + ifn])
        run(["iptables", "-t", T, "-A", SWG_INET_CHAIN, "-i", wan, "-o", ifn,
             "-m", "comment", "--comment", "swg-inet-dn:" + ifn])


def read_inet_bytes(managed_ifaces=None):
    """Cumulative internet-forwarded bytes {up, down} from the SWG_INET chain counters (see
    reconcile_inet_chain). One cheap `iptables-save -c -t mangle`. None → unreadable / chain not built yet."""
    r = run(["iptables-save", "-c", "-t", SWG_INET_TABLE])
    if r.returncode != 0 or not r.stdout:
        return None
    up = down = 0
    for ln in r.stdout.splitlines():
        if "swg-inet-" not in ln:
            continue
        m = re.match(r"\[\d+:(\d+)\]\s+-A\s+" + SWG_INET_CHAIN + r"\b(.*)", ln)
        if not m:
            continue
        by = int(m.group(1))
        if "swg-inet-up:" in m.group(2):
            up += by
        elif "swg-inet-dn:" in m.group(2):
            down += by
    return {"up": up, "down": down}


def sample_inet(node_cfg, now):
    """Return the cached internet {up, down} rate (B/s), refreshing the counters at most every
    INET_SAMPLE_EVERY_S. First read only sets the baseline (rate stays 0 until the next sample)."""
    if _INET["cum"] is not None and (now - _INET["t"]) < INET_SAMPLE_EVERY_S:
        return _INET["rate"]
    managed = set((node_cfg.get("interfaces") or {}).keys())
    if not managed:
        return _INET["rate"]
    cur = read_inet_bytes(managed)
    if cur is None:                                    # no iptables (some containers) → leave last known
        return _INET["rate"]
    prev, pt = _INET["cum"], _INET["t"]
    if prev is not None and now > pt:                  # counter reset (iface flap) → clamp the negative delta to 0
        dt = now - pt
        _INET["rate"] = {"up": max(0.0, (cur["up"] - prev["up"]) / dt),
                         "down": max(0.0, (cur["down"] - prev["down"]) / dt)}
    _INET["cum"] = cur; _INET["t"] = now
    return dict(_INET["rate"])


# ── Kernel-SNI per-category bytes (destination stats for the sni_kernel engine) ──
# The nft `catcount` counters key off the nft cat_<c> GEOIP sets. But Kernel-SNI learns dst IPs into the swgk_<c>
# IPSETS (nft can't match an ipset), so its routed traffic is invisible to catcount → the "top destinations" chart is
# empty in sni_kernel mode. Mirror the SWG_INET pattern: an iptables mangle-FORWARD chain that counts up (dst∈swgk_<c>)
# + dn (src∈swgk_<c>) per category via `-m set`, read as a delta. Config-independent (mangle runs before filter),
# count-only (no verdict → no datapath effect). Merged into cat_rate alongside the nft catcount cats.
SWG_CATK_CHAIN = "SWG_CATK"
CATK_SAMPLE_EVERY_S = 5
_CATK = {"t": 0.0, "cum": None, "rate": {}}


def reconcile_catk_chain(cats):
    """Maintain SWG_CATK: per-category up/dn count rules (`-m set --match-set swgk_<c> dst|src`) in mangle FORWARD,
    so the Kernel-SNI datapath's routed bytes are attributed per category. cats = raw category ids with a swgk_ set.
    Drift-gated on the category set; best-effort (a node without iptables/ipset just no-ops)."""
    T = "mangle"
    want = sorted(set(c for c in (cats or []) if c and c != "all"))
    have = run(["iptables", "-t", T, "-nL", SWG_CATK_CHAIN]).returncode == 0
    if not want:
        if have:
            run(["iptables", "-t", T, "-D", "FORWARD", "-j", SWG_CATK_CHAIN])
            run(["iptables", "-t", T, "-F", SWG_CATK_CHAIN]); run(["iptables", "-t", T, "-X", SWG_CATK_CHAIN])
        return
    if not have:
        run(["iptables", "-t", T, "-N", SWG_CATK_CHAIN])
    if ("-j " + SWG_CATK_CHAIN) not in (run(["iptables", "-t", T, "-S", "FORWARD"]).stdout or ""):
        run(["iptables", "-t", T, "-I", "FORWARD", "1", "-j", SWG_CATK_CHAIN])   # count before anything else
    cur = run(["iptables", "-t", T, "-S", SWG_CATK_CHAIN]).stdout or ""
    cursig = set(m.group(1) for m in re.finditer(r'--comment "?swg-catk-(?:up|dn):([^"\s]+)', cur))   # `-S` quotes the comment
    if cursig == set(want):
        return                                              # unchanged → leave the counters accumulating
    run(["iptables", "-t", T, "-F", SWG_CATK_CHAIN])
    for c in want:
        sn = _xts_setname(c)
        run(["iptables", "-t", T, "-A", SWG_CATK_CHAIN, "-m", "set", "--match-set", sn, "dst",
             "-m", "comment", "--comment", "swg-catk-up:" + c])   # up: client → dest (dst in the learned set)
        run(["iptables", "-t", T, "-A", SWG_CATK_CHAIN, "-m", "set", "--match-set", sn, "src",
             "-m", "comment", "--comment", "swg-catk-dn:" + c])   # dn: dest → client (src in the learned set)


def sample_catk():
    """Kernel-SNI per-category {cat:{up,dn}} B/s from the SWG_CATK counters (delta). {} if the chain isn't built."""
    now = time.time()
    if _CATK["cum"] is not None and (now - _CATK["t"]) < CATK_SAMPLE_EVERY_S:
        return dict(_CATK["rate"])
    r = run(["iptables-save", "-c", "-t", "mangle"])
    if r.returncode != 0 or not r.stdout:
        return dict(_CATK["rate"])                          # no iptables → leave last known
    if "swg-catk-" not in r.stdout:                         # chain gone (mode changed) → clear
        _CATK["cum"] = {}; _CATK["rate"] = {}; _CATK["t"] = now
        return {}
    cum = {}
    for ln in r.stdout.splitlines():
        m = re.match(r"\[\d+:(\d+)\]\s+-A\s+" + SWG_CATK_CHAIN + r"\b(.*)", ln)
        if not m:
            continue
        mm = re.search(r"swg-catk-(up|dn):(\S+)", m.group(2))
        if not mm:
            continue
        cum.setdefault(mm.group(2).strip('"'), {"up": 0, "dn": 0})[mm.group(1)] += int(m.group(1))
    prev, pt = _CATK["cum"], _CATK["t"]
    if prev is not None and now > pt:                       # counter reset (rebuild) → clamp negative delta to 0
        dt = now - pt
        _CATK["rate"] = {c: {"up": max(0.0, v["up"] - (prev.get(c) or {}).get("up", 0)) / dt,
                             "dn": max(0.0, v["dn"] - (prev.get(c) or {}).get("dn", 0)) / dt}
                         for c, v in cum.items()}
    _CATK["cum"] = cum; _CATK["t"] = now
    return dict(_CATK["rate"])


def node_datapath_health():
    """This node's kernel-datapath health for the panel's self-heal check: is the AmneziaWG kernel module loadable
    when the node uses awg? Bare-metal only — a docker node runs the userspace amneziawg-go datapath (no kernel
    module, so the "Unknown device type" DKMS class can't happen) → {}. Mirrors the panel's host_datapath_health."""
    if NODE_KIND == "docker":
        return {}
    out = {}
    try:
        awg_used = any(os.path.exists(p) for p in ("/usr/bin/awg", "/usr/local/bin/awg", "/sbin/awg", "/usr/sbin/awg"))
        if awg_used:
            loaded = False
            try:
                with open("/proc/modules") as f:
                    loaded = any(ln.startswith("amneziawg ") for ln in f)
            except Exception:
                pass
            built = False
            if not loaded:
                kr = os.uname().release
                for d in ("/lib/modules/%s/updates/dkms" % kr, "/lib/modules/%s/updates" % kr, "/lib/modules/%s/kernel/drivers/net" % kr):
                    try:
                        if any(f.startswith("amneziawg.ko") for f in os.listdir(d)):
                            built = True
                            break
                    except Exception:
                        continue
            out["awg"] = {"needed": True, "ok": bool(loaded or built)}
    except Exception:
        return {}
    return out


def _uapi_lines(iface):
    """Raw UAPI `get=1` response lines from a userspace wireguard-go/amneziawg-go socket, or [] if there is none.

    ONE reader for the two callers that each carried their own copy of the connect / send / read-until-errno
    loop — and the copies had drifted: this one searches every directory discovery accepts, the other hardcoded
    /var/run/wireguard, so an interface whose socket lives in /run/wireguard was invisible to it.
    """
    sock = next((p for p in (os.path.join(d, iface + ".sock") for d in WG_SOCK_DIRS) if os.path.exists(p)), "")
    if not sock:
        return []
    with contextlib.suppress(Exception):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(2)
        s.connect(sock)
        s.sendall(b"get=1\n\n")
        data = b""
        while b"errno=" not in data:
            c = s.recv(8192)
            if not c:
                break
            data += c
        s.close()
        return data.decode("utf-8", "replace").splitlines()
    return []


def _uapi_probe(iface):
    """(listen_port, peer_count) for an adoption candidate — works when the CLI can't read the socket."""
    port = 0; peers = 0
    for line in _uapi_lines(iface):
        if line.startswith("listen_port="):
            with contextlib.suppress(ValueError):
                port = int(line.split("=", 1)[1] or "0")
        elif line.startswith("public_key="):
            peers += 1
    return port, peers

# Where wg / awg / WDTT actually live on a box we did NOT set up. Discovery used to look only where WE install,
# so an interface configured by a distro package, by hand, or by an upstream installer was invisible — and an
# adoption flow that can't see the thing it exists to adopt is useless. Keep these lists as the single source of
# truth for every scan (conf lookup, candidate enumeration, WDTT probing).
WG_CONF_DIRS  = ("/etc/wireguard", "/usr/local/etc/wireguard")
AWG_CONF_DIRS = ("/etc/amnezia/amneziawg", "/etc/amneziawg", "/usr/local/etc/amneziawg", "/etc/amnezia")
WG_SOCK_DIRS  = ("/var/run/wireguard", "/run/wireguard")   # wireguard-go/amneziawg-go UAPI sockets
# Every fork's -config-dir default, plus the usual hand-install spots. wg-keys.dat here == a WDTT identity.
WDTT_CFG_DIRS = ("/etc/wdtt", "/opt/wdtt", "/var/lib/wdtt", "/usr/local/etc/wdtt")
# The interface an UNPATCHED upstream build serves. OUR builds take -iface; the authors' do not register the flag
# at all (ildarmaga compiles wgIfaceName = "wdtt0", alongside a hardcoded 10.66.66.1/24 and :2860 admin surface),
# which is also why only one upstream server can run per host.
WDTT_DEFAULT_IFACE = "wdtt0"
_WDTT_HOSTPROC = {"at": 0.0, "walked": 0.0, "rows": [], "ok": True}   # docker: cached HOST /proc walk.
                                            # "ok" = the walk COMPLETED. An empty rows list means "nothing is
                                            # running" only when ok; otherwise it means "we could not look".
                                            # "at" is the CACHE clock a flush resets; "walked" is when a walk
                                            # last actually ran, which nothing resets — see _WDTT_HOST_FLOOR.
_WDTT_CFGPROBE = {}                          # docker: cfgdir -> (ts, {...}) cached host-side file probe
_WDTT_HOST_TTL = 120                         # each host probe is a privileged one-shot container — never per-5s.
                                            # This is DISCOVERY: it changes when a human installs or starts a
                                            # server on the box, so minutes is the right granularity. It was 45s,
                                            # which on a live node cost ~80 privileged containers an hour to learn
                                            # nothing had changed; anything that must not act on a stale answer
                                            # flushes first, and that is what the flush is for.
_WDTT_HOST_FLOOR = 5                         # a walk THIS recent is reused even when the cache was flushed


def _awg_conf_dirs():
    """AWG_CONF_DIRS plus every subdirectory of /etc/amnezia (the Amnezia installers use one per product)."""
    dirs = list(AWG_CONF_DIRS)
    with contextlib.suppress(Exception):
        for sub in os.listdir("/etc/amnezia"):
            d = "/etc/amnezia/" + sub
            if os.path.isdir(d) and d not in dirs:
                dirs.append(d)
    return dirs


def _cand_conf(name):
    """Path to an on-disk conf for this interface, searched across every conventional location. '' if none."""
    for d in _awg_conf_dirs() + list(WG_CONF_DIRS):
        p = os.path.join(d, name + ".conf")
        if os.path.isfile(p):
            return p
    return ""


def _conf_has_awg(path):
    """Does this conf carry AmneziaWG obfuscation knobs? Near-definitive — plain wg-quick rejects these keys."""
    with contextlib.suppress(Exception):
        for ln in open(path):
            if re.match(r"\s*(Jc|Jmin|Jmax|S[1-4]|H[1-4]|I[1-5])\s*=\s*\S", ln):
                return True
    return False


def _conf_is_awg(path):
    """Does this conf path sit in an AmneziaWG location? (drives proto, and awg confs also carry Jc/S1 knobs)"""
    return any(os.path.dirname(path) == d for d in _awg_conf_dirs())


def _wdtt_is_server(flags):
    """Is this argv a WDTT server AT ALL? _wdtt_procs deliberately casts a wide net (argv[0] containing "server"
    or "wdtt") because the forks name their binaries inconsistently — but the turn-proxies are literally called
    `turn-server`. Without this check every one of them looked like a WDTT server that simply hadn't been given
    -iface, and _wdtt_iface_of then attributed it to the DEFAULT interface: the foreign lookup for wdtt0 returned
    a TURN-PROXY, the panel offered its port as "currently" the one to adopt, and the adopt would have signalled
    it. A turn-proxy carries -connect/-obf-*/-wrap-*; none of the flags below, and no "wdtt" in its path."""
    # csqtt (amurcanov's Rust rewrite) is a DISTINCT kind with its own reconcile loop, but it also names its binary
    # `server` and carries -iface/-config-dir/-desired — so without this it looks like a foreign WDTT server, the
    # scan claims its raw-TUN interface, and the panel offers the managed csqtt instance for ADOPTION ("orphan").
    # It carries -tun-addr (a WDTT server uses -wg-addr, never -tun-addr) and its binary lives under /opt/swg-csqtt.
    # NB: don't key off -no-nat — our WDTT servers pass it too; only -tun-addr and the exe path are csqtt-exclusive.
    _exe = (flags.get("_exe") or "").lower()
    if "csqtt" in _exe or (flags.get("tun-addr") or "").strip():
        return False
    if "wdtt" in _exe:
        return True
    return any((flags.get(k) or "").strip() for k in ("iface", "config-dir", "wg-port", "wg-addr", "desired"))


def _wdtt_iface_of(flags):
    """The interface a WDTT server owns. OUR builds pass -iface; the AUTHORS' upstream builds hardcode it and
    register no such flag, so a genuinely foreign server has no -iface at all. Matching on the flag alone meant the
    foreign lookup could only ever find WDTT we had deployed ourselves — i.e. never the case it exists for."""
    return (flags.get("iface") or "").strip() or WDTT_DEFAULT_IFACE


def _wdtt_foreign_proc(iface):
    """(pid, flags) of a WDTT server on this interface that we do NOT supervise — ({}/None when there is none.
    Returns the FLAGS too: on a docker node they come from the host's pid namespace, so the caller must not try to
    re-read /proc/<pid> itself (that pid does not exist in this container)."""
    ours = set()
    with contextlib.suppress(Exception):
        ours = {p.pid for p in _WDTT_PROCS.values() if p is not None}
    for pid, flags in _wdtt_procs():
        if pid not in ours and _wdtt_iface_of(flags) == iface:
            return pid, flags
    return None, {}


def _wdtt_flags_from_argv(parts):
    """{flag: value} from an argv list (`-flag value` pairs) + argv[0]. Shared by the local /proc reader and the
    docker host-namespace walk, so both understand a cmdline identically."""
    out = {"_exe": parts[0] if parts else ""}
    i = 1
    while i < len(parts):
        if parts[i].startswith("-"):
            key = parts[i].lstrip("-")
            if i + 1 < len(parts) and not parts[i + 1].startswith("-"):
                out[key] = parts[i + 1]; i += 2; continue
            out[key] = "true"
        i += 1
    return out


def _wdtt_cmdline_flags(pid):
    """{flag: value} from a LOCAL process cmdline + argv[0]."""
    out = {"_exe": ""}
    with contextlib.suppress(Exception):
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            parts = [p.decode("utf-8", "replace") for p in f.read().split(b"\x00") if p]
        out = _wdtt_flags_from_argv(parts)
    with contextlib.suppress(Exception):
        out["_exe"] = os.readlink("/proc/%d/exe" % pid) or out["_exe"]
        out["_cwd"] = os.readlink("/proc/%d/cwd" % pid) or ""
    return out


def _wdtt_unit_of_pid(pid, host_ns=False):
    """The service unit a process belongs to, '' when it isn't service-managed. Read from its cgroup line, on the
    HOST when the pid lives there (docker). Adoption needs this because a foreign WDTT server is normally a
    SERVICE: killing the process alone leaves its manager to restart it."""
    txt = ""
    if host_ns or NODE_KIND == "docker":
        txt = (host_sh("cat /proc/%d/cgroup 2>/dev/null; :" % int(pid), timeout=20).stdout or "")
    else:
        with contextlib.suppress(Exception):
            with open("/proc/%d/cgroup" % int(pid)) as f:
                txt = f.read()
    for ln in txt.splitlines():
        seg = ln.strip().rsplit("/", 1)[-1]
        if seg.endswith(".service"):
            return seg
    return ""


# Which CLI talks to the OTHER containers on this host. `docker` when it is here — that is the case this
# code was written for, and it is also what a DOCKER node has inside its own image, talking to the socket the
# compose mounts. Otherwise `podman`: its `ps`/`exec`/`inspect`/`stop`/`start` take the same arguments, and a
# host that runs containers under podman is not a rare shape — it is what the Nix container arm uses by
# default, because nixpkgs flags the docker package insecure. Without this, discovery ran `docker ps`, got
# "command not found", and reported NOTHING: a working AmneziaWG server in a podman container was invisible,
# which reads as "the panel cannot see my server" rather than as a missing binary. Resolved once.
_CTR_CLI = {"v": None}
_CTR_CLI_DIRS = ("/run/current-system/sw/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/snap/bin")

def _ctr_cli():
    # PATH first, then a short list of absolute locations — because the PATH is not always ours to rely on.
    # A native NixOS node runs with a PATH the module curates, and podman is deliberately NOT in it: it is a
    # third-party runtime the operator may or may not have, and a node that hard-depends on it would refuse to
    # build without it. `shutil.which` therefore answers "no" on the one host where podman is most likely to be
    # the runtime, and discovery silently found nothing.
    if _CTR_CLI["v"] is None:
        _CTR_CLI["v"] = "docker"
        for cli in ("docker", "podman"):
            found = shutil.which(cli) or next((os.path.join(d, cli) for d in _CTR_CLI_DIRS
                                               if os.access(os.path.join(d, cli), os.X_OK)), None)
            if found:
                _CTR_CLI["v"] = found
                break
    return _CTR_CLI["v"]

_CTR_NAMES = {"at": 0.0, "map": {}}      # container id -> name; one `docker ps` shared by every candidate


def _ctr_name_map(timeout=15):
    """{full container id: name}, cached on the same TTL as the proc walks — a `docker ps` per candidate per
    5s snapshot would cost more than the answer is worth."""
    now = time.time()
    if now - _CTR_NAMES["at"] < _CTR_IF_TTL:
        return _CTR_NAMES["map"]
    m = {}
    with contextlib.suppress(Exception):
        r = run([_ctr_cli(), "ps", "--no-trunc", "--format", "{{.ID}} {{.Names}}"], timeout=timeout)
        for ln in (r.stdout or "").splitlines():
            cid, _, nm = ln.strip().partition(" ")
            if cid and nm.strip():
                m[cid] = nm.strip()
    _CTR_NAMES["at"], _CTR_NAMES["map"] = now, m
    return m


def _proc_container(pid):
    """Name of the container a foreign server runs in, or "" when it runs on the node itself.

    The panel calls an interface ALIEN when another program owns it in its own container, and ORPHAN when it
    sits on the node and is merely unmanaged — two different things to do about it, so two different words.
    wg/awg candidates carry `container` and get that right; WDTT and csqtt carried no such field, so every
    foreign one of them rendered as ORPHAN, including servers plainly running in Docker. That is the case the
    operator most needs to recognise BEFORE adopting, since taking over a container's server means stopping a
    container somebody else's tooling will restart.

    Read from the pid's cgroup, the same way _wdtt_unit_of_pid reads its unit — and from the HOST's /proc when
    the pid lives there (a docker node's host walk). "" on any doubt: unlabelled is better than mislabelled.
    """
    if not pid:
        return ""
    txt = ""
    if NODE_KIND == "docker" and not os.path.exists("/proc/%d" % int(pid)):
        txt = (host_sh("cat /proc/%d/cgroup 2>/dev/null; :" % int(pid), timeout=20).stdout or "")
    else:
        with contextlib.suppress(Exception):
            with open("/proc/%d/cgroup" % int(pid)) as f:
                txt = f.read()
    m = re.search(r"[0-9a-f]{64}", txt)
    if not m:
        return ""                       # a systemd slice, or nothing recognisable → it is on the node
    cid = m.group(0)
    return _ctr_name_map().get(cid) or cid[:12]


def _wdtt_flags_host(pid):
    """Flags for ONE pid in the HOST's pid namespace (docker) — the same base64 hand-off as _wdtt_host_procs,
    but never cached: this backs the re-verify taken immediately before we signal, where a stale answer is the
    difference between stopping the foreign server and killing whatever inherited its pid."""
    out = {}
    with contextlib.suppress(Exception):
        b64 = (host_sh("base64 -w0 < /proc/%d/cmdline 2>/dev/null" % int(pid), timeout=20).stdout or "").strip()
        if b64:
            parts = [x.decode("utf-8", "replace") for x in base64.b64decode(b64).split(b"\x00") if x]
            if parts:
                out = _wdtt_flags_from_argv(parts)
    return out


def _wdtt_host_procs():
    """WDTT *and csqtt* servers in the HOST's pid namespace — docker only. This container has no pid:host, so a
    foreign server running on the host is invisible to a local /proc walk and could never be adopted. host_sh
    reaches it, but each call spawns a privileged one-shot container, so the result is cached: the foreign lookup
    runs per candidate per 5s snapshot, and paying a container for each of those would be ruinous.
    cmdline goes over as base64 — an argv with spaces or newlines must survive the trip intact.

    The net has to be wider than the name suggests: this is the ONLY host walk on a docker node, and _csqtt_procs
    reads it too. Matching *wdtt*|*server* alone missed the case it exists for — the AUTHORS' upstream csqtt
    installs its binary as `csqtt` (/usr/local/bin/csqtt), which contains neither, so a hand-installed csqtt eating
    a whole box was discarded here before the csqtt discriminator downstream ever saw it, and the panel reported
    the node as running nothing. Everything collected is classified downstream — _wdtt_procs drops csqtt via
    _wdtt_is_server, _csqtt_procs keeps exactly it — so widening here cannot cross the two kinds."""
    now = time.time()
    if now - _WDTT_HOSTPROC["at"] < _WDTT_HOST_TTL:
        return _WDTT_HOSTPROC["rows"]
    # A flush sets "at" to 0 to force freshness. Several call sites can flush — or expire together, since every
    # host probe shares this TTL — inside ONE reconcile pass, and each miss costs a privileged container. Measured
    # on a live node: bursts of ~5 back-to-back walks, then a clean 42s gap. The gap proved the TTL was working
    # and the burst was the whole cost. A walk that finished seconds ago is fresh enough for every caller in the
    # same pass, so honour a floor that a flush cannot cross: correctness is unaffected (nothing can start, be
    # noticed, and be acted on inside five seconds) and the burst collapses to one walk.
    if now - _WDTT_HOSTPROC["walked"] < _WDTT_HOST_FLOOR:
        return _WDTT_HOSTPROC["rows"]
    rows = []
    ok = False
    with contextlib.suppress(Exception):
        # NOT *server*: every server kind we look for names itself in its own path — ours live under
        # .../wdtt/<iface>/server and .../csqtt/<iface>/server, a bare-metal install under /opt/swg-wdtt/, and the
        # authors' upstream csqtt at /usr/local/bin/csqtt. A bare *server* added nothing and matched the whole box:
        # on a live node it returned fail2ban-server, both turn-proxies and swg-panel-server ITSELF, every one of
        # which then had to be carried back over the hop and thrown away downstream.
        cmd = ("for p in /proc/[0-9]*; do c=$p/cmdline; [ -r \"$c\" ] || continue; "
               "case \"$(head -c 200 \"$c\" | tr '\\0' ' ')\" in *wdtt*|*csqtt*) "
               "printf '%s ' \"${p#/proc/}\"; base64 -w0 < \"$c\"; echo ;; esac; done")
        _r = host_sh(cmd, timeout=30)
        # rc 124 is run()'s timeout. This hop DOES fail in the field — a box seen forking ~500 helpers per pass
        # under load logged nothing but `host_sh rc=124` — and an empty answer from a failed walk is
        # indistinguishable from a healthy "nothing there" unless we record which one it was.
        ok = (_r.returncode == 0)
        for ln in (_r.stdout or "").splitlines():
            pid, _, b64 = ln.strip().partition(" ")
            if not pid.isdigit() or not b64:
                continue
            with contextlib.suppress(Exception):
                parts = [x.decode("utf-8", "replace") for x in base64.b64decode(b64).split(b"\x00") if x]
                # Deliberately WIDER than the shell net above, and not to be "tidied" into matching it: the net
                # tests the whole cmdline, this tests argv[0]. A foreign server started as `server -iface wdtt1`
                # gets through the net on its ARGUMENT and would be dropped here by a wdtt/csqtt-only test.
                if parts and ("wdtt" in parts[0] or "csqtt" in parts[0] or "server" in parts[0]):
                    rows.append((int(pid), _wdtt_flags_from_argv(parts)))
    _WDTT_HOSTPROC["at"] = now
    _WDTT_HOSTPROC["walked"] = time.time()
    _WDTT_HOSTPROC["rows"] = rows
    _WDTT_HOSTPROC["ok"] = ok
    # One line per walk, and a walk is now a rare event. It says how often this actually runs and whether the
    # answer can be trusted — the two things that took a live box and a packet of measurements to establish.
    print("host-walk: %d server proc(s), %.1fs, %s" % (len(rows), _WDTT_HOSTPROC["walked"] - now,
                                                       "complete" if ok else "INCOMPLETE (answer not trusted)"),
          flush=True)
    return rows


def _wdtt_hostproc_flush():
    """Make the next _wdtt_host_procs re-walk instead of answering from the TTL cache.

    The cache is right for the per-5s snapshot and wrong for anything that SIGNALS: a pid read from a walk up to
    45s old may already have been reused, and the difference between stopping a foreign server and killing an
    unrelated process is exactly that staleness. Bare metal walks live and ignores this."""
    _WDTT_HOSTPROC["at"] = 0.0


def _wdtt_unit_ports(execstart):
    """(listen, wg_port) parsed out of a unit's ExecStart. A STOPPED server has no argv to read, but the unit
    that starts it is right there on disk and is authoritative about the ports its clients already dial."""
    with contextlib.suppress(Exception):
        parts = [p for p in shlex.split(execstart or "") if p]
        f = _wdtt_flags_from_argv(parts)
        return (f.get("listen") or "").strip(), str(f.get("wg-port") or "").strip()
    return "", ""


def _wdtt_inbound_ports_local(cfgdir):
    """(dtls, wg) from ildarmaga's own panel.db `wdtt_inbound` row — the fork records what it listens on, which
    survives a stop. amurcanov keeps nothing equivalent, hence the unit fallback."""
    dbp = os.path.join(cfgdir, "panel.db")
    if not os.path.isfile(dbp):
        return "", ""
    with contextlib.suppress(Exception):
        import sqlite3
        c = sqlite3.connect(dbp, timeout=5)
        try:
            for d, w in c.execute("SELECT dtls_port, wg_port FROM wdtt_inbound LIMIT 1"):
                return (str(d or "").strip(), str(w or "").strip())
        finally:
            c.close()
    return "", ""


def _wdtt_users_local(cfgdir):
    """The users a WDTT config-dir holds, as NON-SECRET rows for the adoption UI — never the password itself
    (the panel stays blind to credentials until the operator actually adopts). Both store layouts, same shape:
    a user that has never connected still gets a row, because "3 issued, 1 ever connected" is exactly what an
    operator needs before taking a server over — and the interface can only ever show the connected one."""
    out = []
    dbp = os.path.join(cfgdir, "panel.db")
    if os.path.isfile(dbp):
        with contextlib.suppress(Exception):
            import sqlite3
            c = sqlite3.connect(dbp, timeout=5)
            try:
                for lbl, did, exp, deact, dn, up, vkh, seen, ports in c.execute(
                        "SELECT comment, device_id, expires_at, is_deactivated, down_bytes, up_bytes,"
                        " vk_hash, last_seen_at, ports FROM wdtt_users"):
                    out.append({"label": (lbl or "").strip()[:60], "bound": bool((did or "").strip()),
                                "last_seen": int(seen or 0), "expires_at": int(exp or 0),
                                "disabled": bool(deact), "vk": bool((vkh or "").strip()),
                                "down_bytes": int(dn or 0), "up_bytes": int(up or 0), "ports": str(ports or "")})
            finally:
                c.close()
        return out
    pj = os.path.join(cfgdir, "passwords.json")
    if os.path.isfile(pj):
        with contextlib.suppress(Exception):
            with open(pj) as f:
                raw = json.load(f) or {}
            devs = raw.get("devices") or {}
            for _pw, e in (raw.get("passwords") or {}).items():
                e = e if isinstance(e, dict) else {}
                _did = str(e.get("device_id") or "").strip()
                # The JSON stores DO carry a display name (`name`); hardcoding "" here listed every user of a
                # foreign server as an unlabelled row, which is the one thing that tells them apart on adopt.
                out.append({"label": str(e.get("name") or e.get("comment") or "").strip()[:60],
                            "bound": bool(_did), "last_seen": int(e.get("last_seen_at") or 0),
                            "expires_at": int(e.get("expires_at") or 0),
                            "disabled": bool(e.get("is_deactivated")), "vk": bool(str(e.get("vk_hash") or "").strip()),
                            "down_bytes": int(e.get("down_bytes") or 0), "up_bytes": int(e.get("up_bytes") or 0),
                            "ports": str(e.get("ports") or ""),
                            "ip": str(((devs.get(_did) or {}) if _did else {}).get("ip") or "")})
    return out


def _listdir_safe(path):
    """os.listdir that answers [] instead of raising — a scan over a directory we may not be able to read must
    not take its caller down with it."""
    try:
        return os.listdir(path)
    except OSError:
        return []


def _proc_cfg_root(pid, reader_init="/proc/self"):
    """Prefix that makes a foreign server's -config-dir resolve the way THAT PROCESS sees it, or "".

    Every WDTT fork and csqtt ship a Docker install, and a containerised server's -config-dir is a path inside
    ITS filesystem. Reading that path on the host gives one of two wrong answers: nothing there, so the server is
    reported un-adoptable and the operator is told to point at a key file that is not on the host either — or,
    far worse, a DIFFERENT install at the same default path. /etc/wdtt is WDTT_CFG_DIRS[0], so any box that has
    ever run a bare-metal fork collides, and the probe then reports the containerised server as adoptable while
    carrying the HOST install's wg-keys.dat and password store. Adoption seeds the new server with that identity
    and breaks every client of BOTH — the same failure the explicit-config-dir guard above exists to prevent,
    reached from a direction it does not cover, because the path IS explicit; it is just namespace-local.

    /proc/<pid>/root is the process's own root, and for an ordinary host process it IS the host root — so this
    returns "" there and nothing changes for the case that has always worked. Empty on any doubt (pid gone, a
    namespace we cannot read): failing safe means behaving exactly as before, never guessing at a path.
    """
    if not pid:
        return ""
    with contextlib.suppress(Exception):
        if os.readlink("/proc/%d/ns/mnt" % int(pid)) != os.readlink(reader_init + "/ns/mnt"):
            return "/proc/%d/root" % int(pid)
    return ""


def _wdtt_cfg_probe(cfg, pid=None):
    """{'id': bool, 'store': str, 'users': [...]} for a config-dir — does it hold an identity (wg-keys.dat),
    which store, and the NON-SECRET rows of that store (never the passwords).
    A FOREIGN server's config-dir lives on the HOST, so on a docker node os.path.isfile() here always says no and
    every foreign WDTT reported adoptable=False. One batched host probe, cached like the proc walk."""
    now = time.time()
    # A CONTAINERISED server's config-dir must be read through its own root (see _proc_cfg_root). "" for every
    # ordinary host process, so this is a no-op there. On a docker node the pid belongs to the HOST namespace and
    # is not in our /proc at all — _proc_cfg_root returns "" and the host shell below does the same test itself.
    _root = _proc_cfg_root(pid)
    # Key the cache on the RESOLVED path, not the bare dir: a host /etc/wdtt and a container /etc/wdtt are two
    # different installs that would otherwise share one entry and answer for each other.
    _ck = (_root, cfg)
    hit = _WDTT_CFGPROBE.get(_ck)
    if hit and now - hit[0] < _WDTT_HOST_TTL:
        return hit[1]
    _cfgr = _root + cfg
    if NODE_KIND != "docker":
        res = {"id": os.path.isfile(os.path.join(_cfgr, "wg-keys.dat")),
               "store": ("panel.db" if os.path.isfile(os.path.join(_cfgr, "panel.db")) else
                         ("passwords.json" if os.path.isfile(os.path.join(_cfgr, "passwords.json")) else "")),
               "users": _wdtt_users_local(_cfgr), "inbound_ports": _wdtt_inbound_ports_local(_cfgr),
               "unit_listen": "", "unit_wg_port": "", "unit_fork": ""}
        # A containerised server is started by its own compose/entrypoint, never by a unit on this host. Any host
        # unit naming the same -config-dir belongs to the OTHER install at that path — attributing its ports and
        # fork to this server is the same mistake as reading its identity. Skip the scan entirely.
        _udir = "" if _root else "/etc/systemd/system"
        # Per-FILE suppression, not per-scan: /etc/systemd/system is full of dangling symlinks (a stock box has
        # dbus-org.freedesktop.ModemManager1.service pointing at nothing) and .wants directories. With one
        # suppress around the whole loop, the first unreadable entry aborted the scan — so a dormant install
        # whose unit sorted after it recovered NO ports and NO fork, and the operator was asked for values the
        # unit spells out. It sorts second on a default Debian, so this was the common case, not the edge.
        for _un in sorted(x for x in _listdir_safe(_udir) if x.endswith(".service")):
            with contextlib.suppress(Exception):
                _u = os.path.join(_udir, _un)
                _txt = open(_u, errors="replace").read()
                if ("config-dir " + cfg) not in _txt:
                    continue
                for _l in _txt.splitlines():
                    if _l.startswith("ExecStart="):
                        _ex = _l.split("=", 1)[1]
                        res["unit_listen"], res["unit_wg_port"] = _wdtt_unit_ports(_ex)
                        # A STOPPED server has no argv to read, but the unit that starts it spells the same
                        # flags out — the only way to tell a dormant qWDTT from a dormant amurcanov, since
                        # they share both the store and the identity file.
                        for _fl, _fk in _WDTT_FORK_BY_FLAG:
                            if (" -" + _fl) in _ex:
                                res["unit_fork"] = _fk; break
                        break
                break
    else:
        res = {"id": False, "store": "", "users": [], "inbound_ports": ("", ""), "unit_listen": "", "unit_wg_port": "", "unit_fork": ""}
        with contextlib.suppress(Exception):
            # The trailing `; :` keeps the probe's exit status at 0 whatever happens. It is a QUESTION, not an
            # assertion: "no passwords.json" exited 1 and "the dir is gone" exited 2, so a probe that had
            # answered perfectly logged `rc=1`/`rc=2` every single cycle — burying the real WDTT log lines.
            # It must sit OUTSIDE the `&&` to also cover the failing `cd`.
            # The store rides back base64'd in the SAME batched call — one privileged container per 45s, not
            # one per question. Size-capped: this is a probe, not a backup, and a store big enough to matter is
            # better answered after adoption than by shipping it through a shell.
            # The pid here belongs to the HOST namespace, so _proc_cfg_root could not test it from inside this
            # container — the host shell does the same comparison itself and prefixes the config-dir when the
            # server turns out to be containerised (a fork installed via its own compose on the host's docker).
            # Same rule for the unit scan: skip it whenever a prefix applies, since that server has no host unit.
            _pfxsh = ("R=''; P=%s; [ -n \"$P\" ] && [ -e /proc/$P/ns/mnt ] && "
                      "[ \"$(readlink /proc/$P/ns/mnt)\" != \"$(readlink /proc/1/ns/mnt)\" ] && R=/proc/$P/root; "
                      % shlex.quote(str(int(pid)) if pid else ""))
            _cmd = _pfxsh + (("cd \"$R\"%s 2>/dev/null && { [ -f wg-keys.dat ] && echo id; [ -f panel.db ] && echo panel.db; "
                     "[ -f passwords.json ] && echo passwords.json; "
                     "for f in passwords.json panel.db panel.db-wal; do [ -f \"$f\" ] || continue; "
                     "[ $(stat -c %%s \"$f\") -gt 8388608 ] && continue; "
                     "printf 'B64:%%s ' \"$f\"; base64 -w0 < \"$f\"; echo; done; }; "
                     # the unit that STARTS this config dir carries the ports a stopped server can't tell us
                     "[ -n \"$R\" ] || for u in /etc/systemd/system/*.service; do [ -f \"$u\" ] || continue; "
                     "grep -q -- %s \"$u\" 2>/dev/null || continue; "
                     "printf 'EXEC:'; grep -h '^ExecStart=' \"$u\" | head -1; done; :")
                    % (shlex.quote(cfg), shlex.quote("config-dir " + cfg)))
            raw = (host_sh(_cmd, timeout=40).stdout or "")
            flags = [ln for ln in raw.split() if not ln.startswith("B64:") and not ln.startswith("EXEC:")]
            for _ln in raw.splitlines():
                if _ln.startswith("EXEC:"):
                    res["unit_listen"], res["unit_wg_port"] = _wdtt_unit_ports(_ln[5:].split("=", 1)[-1])
                    break
            res["id"] = "id" in flags
            res["store"] = "panel.db" if "panel.db" in flags else ("passwords.json" if "passwords.json" in flags else "")
            _blobs = {}
            for _ln in raw.splitlines():
                if not _ln.startswith("B64:"):
                    continue
                _name, _, _b64 = _ln[4:].partition(" ")
                if _name and _b64:
                    with contextlib.suppress(Exception):
                        _blobs[_name] = base64.b64decode(_b64)
            if _blobs:
                _tmp = "/tmp/swg-wdtt-probe-" + hashlib.sha1(cfg.encode()).hexdigest()[:8]
                shutil.rmtree(_tmp, ignore_errors=True)
                os.makedirs(_tmp, mode=0o700, exist_ok=True)
                try:
                    for _n, _b in _blobs.items():
                        with open(os.path.join(_tmp, _n), "wb") as _fh:
                            _fh.write(_b)
                    res["users"] = _wdtt_users_local(_tmp)
                    res["inbound_ports"] = _wdtt_inbound_ports_local(_tmp)
                finally:
                    shutil.rmtree(_tmp, ignore_errors=True)
    _WDTT_CFGPROBE[_ck] = (now, res)
    return res

# Flags that only ONE fork's server has, so seeing one in a foreign argv (or in its -h) names the fork outright.
# qWDTT is the case that forced this: it stores passwords.json and wg-keys.dat exactly like the amurcanov family,
# so the layout check below cannot tell them apart and every foreign qWDTT was adopted labelled "amurcanov" —
# which then hides its RAW-IP capability and manages it with the wrong fork's binary. `-listen-raw` and
# `-listen-direct` are UPSTREAM qWDTT flags (not ours), and no other fork has either.
_WDTT_FORK_BY_FLAG = (("listen-raw", "qwdtt"), ("listen-direct", "qwdtt"), ("admin-addr", "ildarmaga"), ("no-panel", "wdttplus"))


def _wdtt_guess_fork(exe, cfgdir, flags=None, pid=None):
    """Best-effort fork id for a FOREIGN WDTT: our own binary path → exact; else a fork-unique flag in its argv;
    else the config-dir layout (panel.db = ildarmaga, passwords.json = amurcanov-family); else the binary's own
    -h signature. Never authoritative — the panel's adopt modal always lets the operator confirm/override it."""
    for fk in WDTT_FORK_OWNER:
        if ("/" + fk + "/") in (exe or ""):
            return fk
    # argv first: free, exact, and the ONLY signal that also works on a docker node (where the config dir is a
    # host path we cannot stat and exec'ing a host binary in here just burns the timeout).
    for _fl, _fk in _WDTT_FORK_BY_FLAG:
        if _fl in (flags or {}):
            return _fk
    # Host-aware: a FOREIGN server's config-dir is on the HOST, so os.path.isfile() from inside a container always
    # said no. The layout check then fell through, the -h probe below tried to exec a host path that doesn't exist
    # in here, and the fork came back "" — which the panel renders as its DEFAULT, amurcanov. An upstream ildarmaga
    # server was therefore adopted and labelled as a different author's fork.
    _store = _wdtt_cfg_probe(cfgdir, pid)["store"] if cfgdir else ""
    if _store == "panel.db":
        return "ildarmaga"
    # ONE exec, not two: this runs per unmanaged candidate on every 5s snapshot, and `run` blocks — two hung
    # execs of a foreign binary stalled the sync loop for up to 12s before the snapshot was even posted. Skip it
    # entirely when there's no executable to ask (the dormant scan passes exe="").
    # Nothing to exec (dormant scan), or a docker node where `exe` is a HOST path that does not resolve in here —
    # asking it for -h would just burn the 6s timeout per candidate, per snapshot.
    if not exe or NODE_KIND == "docker":
        return "amurcanov" if _store == "passwords.json" else ""
    h = ""
    with contextlib.suppress(Exception):
        _r = run([exe, "-h"], timeout=6)
        h = (_r.stderr or "") + (_r.stdout or "")
    for _fl, _fk in _WDTT_FORK_BY_FLAG:
        if ("-" + _fl) in h:
            return _fk
    return "amurcanov" if _store == "passwords.json" else ""

def _wdtt_procs():
    """Every WDTT server process on this box → [(pid, argv-flags)]. ONE /proc walk shared by the callers that
    used to each do their own — the foreign-server lookup (per candidate, per 5s snapshot) and the dormant scan."""
    out = []
    with contextlib.suppress(Exception):
        for ent in os.listdir("/proc"):
            if not ent.isdigit():
                continue
            with contextlib.suppress(Exception):
                with open("/proc/%s/cmdline" % ent, "rb") as f:
                    parts = f.read().split(b"\x00")
                # "csqtt" belongs here as much as on the docker hop: the AUTHORS' upstream installs its binary
                # as /usr/local/bin/csqtt, which contains neither "server" nor "wdtt". That gap was found and
                # closed for the host walk a docker node makes, and left open on this one — so the same
                # hand-installed csqtt that a docker node now finds stayed invisible on a BARE-METAL node, and
                # to a docker node for anything inside its own namespace. Same net, both paths.
                if not parts or not parts[0] or not any(m in parts[0] for m in (b"server", b"wdtt", b"csqtt")):
                    continue
                out.append((int(ent), _wdtt_cmdline_flags(int(ent))))
    # DOCKER: the walk above only sees THIS container's pid namespace — our own supervised children. A foreign
    # server runs on the host and would be invisible, so merge the (cached) host-namespace walk. Host pids can't
    # collide with container-local ones here because the local set is only ever our own _WDTT_PROCS children.
    if NODE_KIND == "docker":
        _seen = {p for p, _ in out}
        out.extend((p, f) for p, f in _wdtt_host_procs() if p not in _seen)
    # One choke point for "is this actually WDTT": the argv[0] net above is deliberately wide, and everything
    # downstream (foreign lookup, dormant scan, live config-dirs) treats what it returns as a WDTT server.
    return [(p, f) for p, f in out if _wdtt_is_server(f)]


def _wdtt_live_cfgdirs():
    """Config directories of every WDTT server currently RUNNING here — ours and foreign alike."""
    dirs = set()
    with contextlib.suppress(Exception):
        for ifn in (_wdtt_load() or {}):
            dirs.add(os.path.realpath(_wdtt_dir(ifn)))
    for _pid, flags in _wdtt_procs():
        cd = (flags.get("config-dir") or "").strip()
        # Only a server sharing OUR mount namespace makes a HOST directory live. A containerised fork's
        # -config-dir names a path inside its own image; treating that as live here silently hid the host's
        # genuinely dormant install at the same default path from the adoption list.
        if cd and not _proc_cfg_root(_pid):
            with contextlib.suppress(Exception):
                dirs.add(os.path.realpath(cd))
    return dirs


def wdtt_dormant():
    """WDTT installs sitting on disk with NOTHING running — the one real server we'd otherwise miss entirely.

    A WDTT server owns its TUN, so when it's stopped there is no interface, no UAPI socket and no process: it
    can't appear as an adoption candidate, and the operator sees nothing at all where a real server lives. But a
    wg-keys.dat in one of the fork config directories is unambiguous evidence of an install. Report those (with
    the fork guessed from the store layout) so the panel can say "start it, then adopt" instead of staying silent.
    Report-only — nothing is started, moved or touched."""
    live = _wdtt_live_cfgdirs()
    out = []
    for d in WDTT_CFG_DIRS:
        with contextlib.suppress(Exception):
            # Host-aware, like every other foreign lookup: a foreign install lives on the HOST, so on a docker
            # node os.path.isfile() here answered "no" for every one of them. A RUNNING foreign server was still
            # found (the proc walk crosses the namespace), but a STOPPED one — the exact case this function
            # exists for — was invisible and unadoptable. _wdtt_cfg_probe already crosses it, and is cached.
            probe = _wdtt_cfg_probe(d)
            if not probe["id"] or os.path.realpath(d) in live:
                continue
            store = probe["store"]
            # Ports ARE recoverable from a stopped install: the password store records the ports each password
            # was issued for ("<dtls>,<wg>,…"), so a server with at least one user tells us what it was listening
            # on. The SUBNET is not — client addresses are derived at runtime and never written — and the public
            # endpoint never lived here at all (the server binds 0.0.0.0; what clients dial is a property of the
            # network). So prefill what the files actually know and ask for the rest.
            # Ports for a STOPPED server, best source first. They are runtime flags, so they are not in the
            # config dir — but "we can't know them" was too quick: the unit that starts it spells them out, and
            # ildarmaga records them in its own store. Only ask the operator once all three come up empty; a
            # wrong port here means every existing client dials a server that is no longer listening.
            lp = wp = 0
            with contextlib.suppress(Exception):                       # 1) the service unit's ExecStart
                _ul = str(probe.get("unit_listen") or "").rsplit(":", 1)[-1]
                if _ul.isdigit():
                    lp = int(_ul)
                if str(probe.get("unit_wg_port") or "").isdigit():
                    wp = int(probe["unit_wg_port"])
            with contextlib.suppress(Exception):                       # 2) the fork's own inbound record
                if not (lp and wp):
                    _d, _w = probe.get("inbound_ports") or ("", "")
                    if not lp and str(_d).isdigit(): lp = int(_d)
                    if not wp and str(_w).isdigit(): wp = int(_w)
            with contextlib.suppress(Exception):                       # 3) the ports a password was issued for
                if not (lp and wp):
                    for _e in (probe.get("users") or []):
                        _ports = [p for p in str((_e or {}).get("ports") or "").split(",") if p.strip().isdigit()]
                        if len(_ports) >= 2:
                            lp, wp = lp or int(_ports[0]), wp or int(_ports[1]); break
            _at = 0
            with contextlib.suppress(Exception):
                _at = int(os.path.getmtime(os.path.join(d, "wg-keys.dat")))   # local only; 0 on docker (host path)
            out.append({"config_dir": d, "store": store,
                        "fork": probe.get("unit_fork") or _wdtt_guess_fork("", d),
                        "listen_port": lp, "wg_port": wp,
                        "users": probe.get("users") or [],    # non-secret rows, so the adopt UI can show WHO is on it
                        "at": _at})
    return out


def wdtt_foreign_probe(iface):
    """Can this FOREIGN (panel-unmanaged) WDTT interface be adopted? Locates its running server, its config-dir
    (explicit -config-dir → the fork default /etc/wdtt → the process cwd) and its identity file, and guesses the
    fork. Returns NON-SECRET metadata only — never the owner password or key material (the panel stays blind; the
    node re-reads those locally at adopt time). None when it isn't a locatable WDTT server.
    `adoptable` is False when the identity (wg-keys.dat) can't be found: adopting would mint a FRESH server key and
    break every existing client, so the panel offers Ignore instead."""
    # Take the flags the lookup already resolved — on docker they come from the HOST's pid namespace, so
    # re-reading /proc/<pid> from inside this container would find nothing and blank every field.
    pid, f = _wdtt_foreign_proc(iface)
    if not pid:
        return None
    # An explicit -config-dir is AUTHORITATIVE, even when it holds no identity — that just means this server
    # isn't adoptable. Searching on past it would attribute another server's wg-keys.dat to this one, report it
    # as adoptable, and then seed the adoption with the wrong identity: every client of BOTH servers breaks.
    # Only guess when the process didn't say (an upstream run with no flag lands in one of the defaults).
    cfg = (f.get("config-dir") or "").strip()
    if not cfg:
        for cand in list(WDTT_CFG_DIRS) + [f.get("_cwd") or ""]:
            if cand and _wdtt_cfg_probe(cand, pid)["id"]:
                cfg = cand; break
        else:
            cfg = WDTT_CFG_DIRS[0]
    probe = _wdtt_cfg_probe(cfg, pid)     # host-aware AND namespace-aware: see _proc_cfg_root
    # -wg-addr, like -iface, is OUR flag: the authors' builds compile the subnet in (ildarmaga hardcodes
    # 10.66.66.1/24) and register nothing to read it from. argv therefore yields "" for a genuinely foreign
    # server and adoption refused it — "this server's tunnel subnet isn't an IPv4 CIDR: (none)" — for a value
    # sitting on the live interface all along. The running device is the authority; argv is only a hint.
    _wa = (f.get("wg-addr") or "").strip()
    if not _wa:
        with contextlib.suppress(Exception):
            for ln in (run(["ip", "-4", "-o", "addr", "show", iface]).stdout or "").splitlines():
                _p = ln.split()
                if len(_p) >= 4 and _p[2] == "inet":
                    _wa = _p[3]; break
    return {"pid": pid, "container": _proc_container(pid),
            "fork": _wdtt_guess_fork(f.get("_exe") or "", cfg, f, pid), "config_dir": cfg,
            "listen": f.get("listen") or "", "wg_port": f.get("wg-port") or "", "wg_addr": _wa,
            # Whether the foreign server is ALSO serving raw-IP. Without this the panel adopts it with RAW off
            # and every raw client of that server silently stops connecting, with nothing on screen to say why.
            "raw_listen": f.get("listen-raw") or "",
            "max_passwords": f.get("max-passwords") or "", "has_identity": probe["id"], "adoptable": bool(probe["id"]),
            # Non-secret rows from its own store, so the adoption UI can list EVERY issued user — the interface
            # only knows the ones that have connected, which undercounts what the operator is taking on.
            "users": probe.get("users") or [],
            "store": probe["store"]}

_CTR_IF_TTL = 120                                  # discovery, not reconcile — see _container_ifaces
_CTR_IF = {"at": 0.0, "rows": []}
_CTR_ADOPT = {}          # last container take-over result, reported ONCE so the panel can import + clear
# The take-over runs in its own thread (see the call site). One at a time, keyed by container: the panel only
# ever asks for one, and a second request for the SAME container while the first is in flight must not start a
# second stop.
_CTR_JOB = {"container": "", "iface": "", "req_at": 0, "done": False, "res": None}
_CTR_JOB_LOCK = threading.Lock()


def _ctr_job_start(container, req_iface, req_at, node_cfg, agent, sudo):
    """Begin a container take-over unless this exact request is already running or already answered."""
    with _CTR_JOB_LOCK:
        j = _CTR_JOB
        if j["container"] == container and j["req_at"] == req_at and (j["res"] is not None or not j["done"]):
            return                                   # in flight, or its answer is still waiting to be reported
        if not j["done"] and j["container"]:
            return                                   # another take-over is still running — never two stops at once
        _CTR_JOB.update(container=container, iface=req_iface, req_at=req_at, done=False, res=None)

    def _run():
        res = {}
        try:
            res = container_iface_takeover(container, node_cfg, agent, sudo)
        except Exception as e:
            res = _ctr_err("take-over failed: {e}", e=str(e)[:140])
        with _CTR_JOB_LOCK:
            if _CTR_JOB["container"] == container and _CTR_JOB["req_at"] == req_at:
                _CTR_JOB.update(done=True, res=res)
    threading.Thread(target=_run, daemon=True).start()


def _ctr_job_collect(node_cfg):
    """Publish a finished take-over into the snapshot channel (once), on whichever pass sees it done."""
    with _CTR_JOB_LOCK:
        j = _CTR_JOB
        if not (j["done"] and j["res"] is not None):
            return
        container, iface, req_at, res = j["container"], j["iface"], j["req_at"], j["res"]
        _CTR_JOB.update(container="", iface="", req_at=0, res=None)
    _CTR_ADOPT.clear()
    _CTR_ADOPT.update({"container": container, "req_iface": iface,
                       "req_at": req_at,          # which REQUEST this answers — see below
                       "at": int(time.time()), **(res or {})})
    if (res or {}).get("ok"):
        _persist_config(node_cfg)                  # the interface is ours now — persist before anything else
_OUR_CTRS = ("swg-node", "swg-panel", "swg-sub", "swg-turn-")   # ours; never reported as somebody else's
# (container ID, tool) pairs where that image simply has no such binary — an mtproxy has neither wg nor awg, and
# a plain-WireGuard Amnezia container has wg but not awg. Whether a binary exists is fixed for a container's life,
# but we re-asked every 120s, and each miss is a `docker exec` that can only fail and that dockerd logs as an
# error: ~700 a day per missing tool, burying the lines that matter. Keyed by container ID, so a recreate (new ID)
# is probed afresh, and pruned each walk to the containers still running.
_CTR_NOTOOL = set()


def _container_ifaces(timeout=15):
    """wg/awg interfaces that live inside ANOTHER container's network namespace → [{name, container, proto}].

    AmneziaVPN is the case this exists for. Its own run_container.sh starts the server WITHOUT --network host
    (a published UDP port and its own netns) and its start.sh runs `awg-quick up /opt/amnezia/awg/awg0.conf`
    INSIDE the container, so the device is a kernel interface in a namespace we are not in and its .conf is on
    a filesystem we cannot see. Every source iface_candidates has — wg/awg show, the UAPI socket dirs, the conf
    directories — is namespace- and filesystem-local, so the panel truthfully found nothing and said nothing.
    An operator who has just pointed swgPanel at a working AmneziaWG server reads that as "it doesn't work".

    REPORT ONLY, and deliberately not merged into iface_candidates: this is not adoptable in place. Amnezia's
    container is --restart always, and its start.sh takes the interface DOWN and back UP from its own conf on
    every start — so a peer we added to the live device would vanish on the next restart unless we also wrote
    into a file inside their container, which their client rewrites whenever the operator adds a user there.
    Two writers on one config, one of them restoring from its own copy on a schedule we do not control.

    `docker exec`, not nsenter: a docker node has its OWN pid namespace, so a host pid from `docker inspect`
    does not resolve inside it, and nsenter would work on bare metal only. exec needs no pid at all and behaves
    identically on both. Cached, because discovery of something a human installs does not belong on a 5s loop.
    """
    now = time.time()
    if now - _CTR_IF["at"] < _CTR_IF_TTL:
        return _CTR_IF["rows"]
    rows = []
    with contextlib.suppress(Exception):
        r = run([_ctr_cli(), "ps", "--format", "{{.ID}}\t{{.Names}}"], timeout=15)
        if r.returncode == 0:
            _live_ids = set()
            for ln in (r.stdout or "").splitlines():
                cid, _, name = ln.partition("\t")
                cid, name = cid.strip(), name.strip()
                if not cid or name.startswith(_OUR_CTRS):
                    continue
                # A container on the HOST's network namespace has no interfaces of its own — everything it
                # shows is the host's, which this node already sees directly. Reporting them here made every
                # local interface look like somebody else's: the panel offered to "take over" awg0 from a
                # container that merely shares the namespace, and marked it NAME TAKEN because the node
                # already runs it. Ours are excluded by name; anyone else's host-networked container (a
                # monitoring agent, a proxy) would have done the same.
                with contextlib.suppress(Exception):
                    _nm = run([_ctr_cli(), "inspect", "-f", "{{.HostConfig.NetworkMode}}", cid], timeout=15)
                    if (_nm.stdout or "").strip().lower() == "host":
                        continue
                _live_ids.add(cid)
                for tool, proto in (("awg", "awg"), ("wg", "wg")):
                    if (cid, tool) in _CTR_NOTOOL:   # that image has no such binary — asking again cannot change it
                        continue
                    with contextlib.suppress(Exception):
                        q = run([_ctr_cli(), "exec", cid, tool, "show", "interfaces"], timeout=15)
                        if q.returncode != 0:
                            # "executable file not found in $PATH" is the image telling us it has no such tool —
                            # a permanent answer, unlike a busy/erroring container, which must stay retryable.
                            # Both streams: the docker CLI prints this OCI error on stdout, not stderr.
                            if "executable file not found" in (q.stderr or "") + (q.stdout or ""):
                                _CTR_NOTOOL.add((cid, tool))
                            continue
                        for ifn in (q.stdout or "").split():
                            if not ifn or any(x["name"] == ifn and x["container"] == name for x in rows):
                                continue
                            # its subnet, so the card can say what the interface actually serves — the one
                            # fact an operator needs to see whether it collides with anything of theirs
                            cidr = ""
                            with contextlib.suppress(Exception):
                                a = run([_ctr_cli(), "exec", cid, "ip", "-4", "-o", "addr", "show", ifn], timeout=timeout)
                                for tok in (a.stdout or "").split():
                                    if "/" in tok and tok[0].isdigit():
                                        cidr = tok
                                        break
                            port, plist = 0, []
                            with contextlib.suppress(Exception):
                                d = run([_ctr_cli(), "exec", cid, tool, "show", ifn, "dump"], timeout=timeout)
                                if d.returncode == 0:
                                    head, plist = parse_dump(d.stdout or "")
                                    if len(head) > 2 and str(head[2]).isdigit():
                                        port = int(head[2])
                            # Amnezia keeps the display names in its own table, joined to the device by pubkey
                            # (clientId == clientPubKey). Without it every peer reads as an anonymous key.
                            if plist:
                                with contextlib.suppress(Exception):
                                    for pk, nm in (_ctr_peer_names(cid, timeout=timeout) or {}).items():
                                        for pe in plist:
                                            if pe.get("public_key") == pk:
                                                pe["name"] = nm
                            hport = _ctr_published(cid, port, timeout=timeout) if port else 0
                            # the conf is the authority, not the tool that answered (see _ctr_is_awg)
                            proto = "awg" if _ctr_is_awg(cid, ifn, timeout=timeout) else proto
                            rows.append({"name": ifn, "container": name, "proto": proto, "address": cidr,
                                         "listen_port": port, "host_port": hport, "peers": len(plist),
                                         # the panel forwards this verbatim; cap it so one very large foreign
                                         # server cannot bloat every snapshot this node posts
                                         "peer_list": plist[:200]})
            # forget containers that are gone; a recreate gets a new ID and is probed from scratch
            _CTR_NOTOOL.difference_update({p for p in _CTR_NOTOOL if p[0] not in _live_ids})
    _CTR_IF["at"] = now
    _CTR_IF["rows"] = rows
    return rows


def _ctr_err(template, **vars):
    """One operator-facing failure from the container take-over.

    Carries the finished English sentence AND the template it came from, because the panel translates by
    looking the sentence up as a catalogue key — and a sentence with the container name already interpolated
    into it can never match one. Old panels read `error` and see English, new ones read `error_key`/`error_vars`
    and show the operator's language. Keep the template EXACTLY in step with js/lang/*.js.
    """
    return {"error": template.format(**vars), "error_key": template, "error_vars": dict(vars)}


def _ctr_running(container, timeout=20):
    """Is this container actually running? The one question a failed `stop` cannot answer for itself."""
    with contextlib.suppress(Exception):
        r = run([_ctr_cli(), "inspect", "-f", "{{.State.Running}}", container], timeout=timeout)
        if r.returncode == 0:
            return (r.stdout or "").strip().lower().startswith("true")
    return False        # cannot tell → treat as down: the caller only uses this to decide whether to give up


def _ctr_published(container, port, timeout=15):
    """The HOST udp port this container publishes for `port`, or 0 if it publishes none.

    A container on its own netns is unreachable from outside the box unless docker forwards a host port to it,
    so this is what decides whether an external address may be shown for it at all — and it is also the port
    that would collide with one of ours. `--network host` publishes nothing but IS the host, so the container's
    own port is the host's.
    """
    with contextlib.suppress(Exception):
        r = run([_ctr_cli(), "inspect", "-f",
                 "{{.HostConfig.NetworkMode}}\t{{json .NetworkSettings.Ports}}", container], timeout=timeout)
        if r.returncode != 0:
            return 0
        mode, _, raw = (r.stdout or "").strip().partition("\t")
        if mode.strip() == "host":
            return int(port)
        for spec, binds in (json.loads(raw or "{}") or {}).items():
            if not spec.endswith("/udp") or not binds:
                continue
            if spec.split("/")[0] != str(port):
                continue
            for b in binds:
                hp = str((b or {}).get("HostPort") or "").strip()
                if hp.isdigit():
                    return int(hp)
    return 0


def _ctr_is_awg(container, ifn, timeout=15):
    """Authoritative wg-vs-awg for a container interface: does its conf carry obfuscation params?

    Which TOOL answered is not a reliable signal. On a box whose amneziawg module backs everything, `wg`
    enumerates AWG devices too — the exact false positive iface_candidates documents and refuses to use, and
    the reason a card could read "WG" for an interface the take-over then correctly created with `awg`.
    Amnezia names its AmneziaWG interface `wg0`, so the NAME says nothing either. Cheap: one exec per iface.
    """
    with contextlib.suppress(Exception):
        pat = "^[[:space:]]*(Jc|Jmin|Jmax|S[1-4]|H[1-4]|I[1-5])[[:space:]]*="
        q = run([_ctr_cli(), "exec", container, "sh", "-c",
                 "grep -lE '%s' /opt/amnezia/awg/%s.conf /opt/amnezia/wireguard/%s.conf "
                 "/opt/amnezia/*/%s.conf /etc/wireguard/%s.conf /etc/amnezia/amneziawg/%s.conf 2>/dev/null"
                 % (pat, ifn, ifn, ifn, ifn, ifn)], timeout=timeout)
        if q.returncode == 0 and (q.stdout or "").strip():
            return True
    return False


def _ctr_peer_names(container, conf_dir="", timeout=25):
    """{pubkey: display name} out of Amnezia's own client table, or {} if there isn't one we can read.

    Their desktop client keeps the names beside the conf in a JSON table whose filename has moved between
    versions, so this DISCOVERS the table rather than guessing at it, and joins on the public key — their
    wireguardConfigurator.cpp sets `clientConfig.clientId = connData.clientPubKey`, so the id IS the pubkey.
    Best-effort by construction: no table, or an unreadable one, just means the peers read as anonymous keys.
    """
    names = {}
    for d in ([conf_dir] if conf_dir else []) + ["/opt/amnezia/awg", "/opt/amnezia/wireguard", "/opt/amnezia"]:
        with contextlib.suppress(Exception):
            t = run([_ctr_cli(), "exec", container, "sh", "-c",
                     "for f in %s/*; do case \"$f\" in *.conf|*.key) ;; *) [ -f \"$f\" ] && echo \"$f\";; esac; done" % d],
                    timeout=timeout)
            for f in [x.strip() for x in (t.stdout or "").split() if x.strip()]:
                with contextlib.suppress(Exception):
                    b = run([_ctr_cli(), "exec", container, "cat", f], timeout=timeout)
                    doc = json.loads(b.stdout or "")
                    rows = doc if isinstance(doc, list) else (doc.get("clients") or [])
                    for row in rows if isinstance(rows, list) else []:
                        if not isinstance(row, dict):
                            continue
                        cid = str(row.get("clientId") or "").strip()
                        nm = str(((row.get("userData") or {}) if isinstance(row.get("userData"), dict) else {})
                                 .get("clientName") or row.get("clientName") or "").strip()
                        if cid and nm:
                            names[cid] = nm
                if names:
                    break
        if names:
            break
    return names


def container_iface_read(container, want_iface=None, timeout=25):
    """Read a wg/awg server out of ANOTHER container: its interface config and its peers, with names.

    Everything needed to recreate the server natively is in one file. Amnezia's configure_container.sh writes
    /opt/amnezia/<proto>/<iface>.conf holding PrivateKey, ListenPort, Address and the full AWG obfuscation set
    (Jc/Jmin/Jmax/S1..S4/H1..H4/I1), followed by a [Peer] block per client. Recreated with the same key, port
    and params, an existing client config keeps working untouched — the phone cannot tell it changed hands.

    Names are NOT in that file; the desktop client keeps them in a JSON table beside it, and its filename has
    moved between versions. So DISCOVER it rather than hardcode a guess: any other .json/table next to the conf
    is tried, and entries are joined to peers by public key — `clientConfig.clientId = connData.clientPubKey`
    in their wireguardConfigurator.cpp, so the id IS the pubkey. No table, or an unreadable one, simply means
    the peers arrive unnamed; it must never cost us the import.

    Returns {"conf": <text>, "path": ..., "iface": ..., "interface": {...}, "peers": [{...}], "named": n} or
    {"error": ...}. Reads only — nothing here stops, writes or deletes anything.
    """
    out = {"peers": [], "named": 0}
    if not container:
        return _ctr_err("no container given")
    r = run([_ctr_cli(), "exec", container, "sh", "-c",
             "ls -1 /opt/amnezia/*/*.conf /opt/amnezia/*.conf 2>/dev/null"], timeout=timeout)
    paths = [p.strip() for p in (r.stdout or "").split() if p.strip().endswith(".conf")]
    if not paths:
        return _ctr_err("no wg/awg config found in container {c}", c=container)
    # A .conf on disk is NOT evidence that anything is serving it. A leftover from a previous protocol, a file
    # an operator parked there, or a second conf beside the live one would all read exactly the same — and the
    # take-over this feeds STOPS somebody's container, so "there is a file" is not a good enough reason. Ask
    # the container what is actually UP and take the conf that belongs to it.
    live = {}
    for tool in ("awg", "wg"):
        with contextlib.suppress(Exception):
            q = run([_ctr_cli(), "exec", container, tool, "show", "interfaces"], timeout=timeout)
            if q.returncode == 0:
                for n in (q.stdout or "").split():
                    live.setdefault(n, tool)
    want = (want_iface or "").strip()
    path = ""
    for cand in paths:
        base = os.path.basename(cand)[:-5]
        if (base == want) if want else (base in live):
            path = cand
            break
    if not path:
        if want:
            return _ctr_err("{c} has no config for {i}", c=container, i=want)
        return _ctr_err("{c} has {n} wg/awg config(s) but none of them is running ({names}) — nothing to take over",
                        c=container, n=len(paths), names=", ".join(sorted(live)) or "no interface is up")
    out["running"] = os.path.basename(path)[:-5] in live
    out["live_tool"] = live.get(os.path.basename(path)[:-5], "")
    c = run([_ctr_cli(), "exec", container, "cat", path], timeout=timeout)
    if c.returncode != 0 or not (c.stdout or "").strip():
        return _ctr_err("could not read {p} in {c}", p=path, c=container)
    conf = c.stdout
    out["path"], out["conf"] = path, conf
    out["iface"] = os.path.basename(path)[:-5]
    out["interface"] = parse_interface_section(conf)
    # Final proof that this file describes THAT interface: derive the public key from the conf's private key
    # and compare it with the key the live interface is actually using. Names can collide and files can be
    # stale; a matching key cannot be a coincidence.
    out["key_match"] = False
    with contextlib.suppress(Exception):
        _priv = (out["interface"].get("PrivateKey") or out["interface"].get("privatekey") or "").strip()
        _live = (run([_ctr_cli(), "exec", container, out.get("live_tool") or "wg", "show",
                      out["iface"], "public-key"], timeout=timeout).stdout or "").strip()
        _mine = (run(["wg", "pubkey"], input_text=_priv + "\n", timeout=timeout).stdout or "").strip()
        out["key_match"] = bool(_live and _mine and _live == _mine)
    # peers, in file order — pubkey is the identity, and the only thing that joins to a name
    cur = None
    for ln in conf.splitlines():
        s = ln.strip()
        if s.startswith("["):
            if cur:
                out["peers"].append(cur)
            cur = {} if s.lower() == "[peer]" else None
            continue
        if cur is None or "=" not in s or s.startswith("#"):
            continue
        k, _, v = s.partition("=")
        cur[k.strip().lower()] = v.strip()
    if cur:
        out["peers"].append(cur)
    # names: any table beside the conf, joined by pubkey. Best-effort by construction.
    with contextlib.suppress(Exception):
        names = _ctr_peer_names(container, os.path.dirname(path), timeout=timeout)
        for p in out["peers"]:
            nm = names.get((p.get("publickey") or "").strip())
            if nm:
                p["name"] = nm
                out["named"] += 1
    return out


_AWG_CONF_KEYS = ("Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4", "H1", "H2", "H3", "H4",
                  "I1", "I2", "I3", "I4", "I5")


# Which container each taken-over interface came from, mirrored OUT of config.json into the node's STATE dir.
# config.json is authoritative, but on a docker node it lives inside the node container and does not survive a
# recreate, while the state dir is a bind mount — and the uninstaller runs on the HOST, where it can read
# neither the container's filesystem nor a container that has already been removed. Same reason
# _persist_panel_url keeps a copy here. Read by uninstall.sh to put their server back.
ADOPTED_CTRS_PATH = os.path.join(STATE_DIR, "adopted-containers.json")


def _adopted_ctr_load():
    with contextlib.suppress(Exception):
        with open(ADOPTED_CTRS_PATH) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return {k: v for k, v in d.items() if isinstance(k, str) and isinstance(v, str) and v}
    return {}


def _adopted_ctr_save(m):
    with contextlib.suppress(Exception):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = ADOPTED_CTRS_PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump(m, f, indent=1)
        os.replace(tmp, ADOPTED_CTRS_PATH)


def _adopted_ctr_set(iface, container):
    m = _adopted_ctr_load()
    if m.get(iface) != container:
        m[iface] = container
        _adopted_ctr_save(m)


def _adopted_ctr_forget(iface):
    """The interface is gone, so we no longer owe anyone their container back — drop the claim, or a later
    uninstall would start a container for an interface this node stopped serving long ago."""
    m = _adopted_ctr_load()
    if m.pop(iface, None) is not None:
        _adopted_ctr_save(m)


def container_iface_takeover(container, node_cfg, agent, sudo):
    """Take a wg/awg server over from ANOTHER container: stop it, and stand the SAME server up natively.

    Same identity, deliberately: the private key, listen port, address and obfuscation parameters are reused,
    so every config already on a client keeps working — nobody re-imports anything and nobody notices, which
    is the only reason to do this rather than tell the operator to start again.

    Order matters and is not negotiable. Their container is stopped FIRST, because one process can hold that
    UDP port: bringing ours up first would simply fail to bind. And --restart=no is set with it, or the daemon
    puts it back at the next reboot to fight ours for the port, months later, with nobody watching.

    Every failure after the stop puts their container back exactly as it was — started, with its original
    restart policy. A take-over that half-happened is worse than one that did not: their users would be down
    with nothing serving them.

    Returns {"ok": True, "iface", "peers": [...]} for the panel to import, or {"error": ...}.
    """
    r = container_iface_read(container)
    if r.get("error"):
        return r
    iface = r.get("iface") or ""
    info = {k.lower(): v for k, v in (r.get("interface") or {}).items()}
    priv, port = (info.get("privatekey") or "").strip(), (info.get("listenport") or "").strip()
    addr = (info.get("address") or "").strip()
    if not iface or not priv or not addr:
        return _ctr_err("{c}: its config has no interface name, key or address to reuse", c=container)
    # Refuse on anything but a live interface whose key matches its config. This stops somebody else's
    # container; "there was a file that looked right" is not a standard worth acting on.
    if not r.get("running"):
        return _ctr_err("{i} in {c} is not actually running — nothing to take over", i=iface, c=container)
    if not r.get("key_match"):
        return _ctr_err("{i} in {c} does not match the config we read (its live key is a different one), so "
                        "taking it over would not keep existing clients working — refusing", i=iface, c=container)
    if iface in (node_cfg.get("interfaces") or {}):
        return _ctr_err("this node already runs an interface called {i}, so the same name cannot be created "
                        "here — free it first (delete that interface if it is unused, or move its peers "
                        "elsewhere). Nothing was changed.", i=iface)
    # Two Amnezia containers routinely carry the SAME tunnel subnet: each has its own netns, so 10.8.1.0/24
    # inside one and inside another never meet. Taking both over moves them into the HOST namespace, where
    # that stops being true — two routes for one prefix, and the second interface's peers break. Names differ
    # (wg0 vs awg0), so the name check above cannot catch it. Refuse BEFORE the stop: discovering this after
    # would have torn down a working server to find out.
    _mine = (node_cfg.get("interfaces") or {})
    with contextlib.suppress(Exception):
        _want = ipaddress.ip_network(addr.split(",")[0].strip(), strict=False)
        for _ifn in _mine:
            _have = _iface_subnet(node_cfg, _ifn)
            if not _have:
                continue
            with contextlib.suppress(Exception):
                if ipaddress.ip_network(_have, strict=False).overlaps(_want):
                    return _ctr_err(
                        "{i} in {c} serves {s}, which overlaps {o} already on this node. In its own container "
                        "that is fine — each has its own network namespace — but taking it over moves it here, "
                        "where one subnet cannot be served twice. Take over only one of them, or renumber the "
                        "other first. Nothing was changed.", i=iface, c=container, s=str(_want), o=_ifn)
    awg = {k: v for k, v in (r.get("interface") or {}).items() if k in _AWG_CONF_KEYS}
    cmd = ["awg"] if awg else ["wg"]          # obfuscation params present => it is AmneziaWG, not plain WireGuard

    # what the daemon will restore on failure
    pol = ""
    with contextlib.suppress(Exception):
        pol = (run([_ctr_cli(), "inspect", "-f", "{{.HostConfig.RestartPolicy.Name}}", container],
                   timeout=20).stdout or "").strip()
    # Tools BEFORE the stop. This used to be discovered inside create-iface, i.e. after their container was
    # already down — so a node missing the awg tools took a working VPN offline for the stop/fail/restart
    # cycle just to learn a precondition we could have read up front. Same rule as the name and subnet checks:
    # anything knowable without touching their service is checked before we touch it.
    _need = cmd[0]
    if not (shutil.which(_need) and shutil.which(_need + "-quick")):
        return _ctr_err("{i} in {c} is {p}, and this node does not have the {p} tools ({t} and {t}-quick) to "
                        "stand it up. Install them, then take it over again — {c} was not touched and is "
                        "still serving.", i=iface, c=container, p=("AmneziaWG" if _need == "awg" else "WireGuard"),
                        t=_need)
    if run([_ctr_cli(), "update", "--restart=no", container], timeout=30).returncode != 0:
        return _ctr_err("could not clear the restart policy on {c} — nothing was changed", c=container)
    # `-t 10`: name the grace period rather than inheriting the runtime's (both default to 10 anyway). Two reasons, both measured on podman
    # 5.7 against a container that ignores SIGTERM: the wait ran long enough to matter, and `stop` does not
    # return when the process dies — it returns after the runtime has cleaned the container up, which took a
    # further minute. The node's sync loop is BLOCKED for all of that (the take-over is deliberately
    # synchronous), so an over-long stop is what makes the panel show the node as stale mid-adoption.
    if run([_ctr_cli(), "stop", "-t", "10", container], timeout=60).returncode != 0:
        # ⚠️ Do not conclude "nothing was changed" from a non-zero stop. Our own timeout expiring is not the
        # container still running: podman answered late on exactly the container it had already killed, and the
        # operator was told nothing had happened while their server was down. ASK before reporting.
        if _ctr_running(container):
            with contextlib.suppress(Exception):
                run([_ctr_cli(), "update", "--restart=" + (pol or "always"), container], timeout=30)
            return _ctr_err("could not stop {c} — nothing was changed", c=container)
        print("container-takeover: %s reported no clean stop but is down — continuing" % container, flush=True)

    def _undo(why):
        with contextlib.suppress(Exception):
            run([_ctr_cli(), "update", "--restart=" + (pol or "always"), container], timeout=30)
        with contextlib.suppress(Exception):
            run([_ctr_cli(), "start", container], timeout=90)
        _CTR_IF["at"] = 0.0
        print("container-takeover: %s failed (%s) — put %s back" % (iface, why, container), flush=True)
        return _ctr_err("{why} — {c} was restarted and is serving again, nothing was taken over",
                        why=why, c=container)

    ag = run_agent(agent, sudo, {"op": "create-iface", "iface": iface, "cmd": cmd,
                                 "subnet": addr, "address": addr,
                                 "listen_port": int(port) if port.isdigit() else 0,
                                 "private_key": priv, "awg_params": awg or None,
                                 # `awg` is every obfuscation key THEIR conf carried — no more, no less. Whatever
                                 # it omits, their clients omit too, so the agent must not top it up from our
                                 # defaults: a server written by an older AmneziaWG has no S3/S4/I1–I5, and adding
                                 # them still handshakes while dropping every data packet the clients send.
                                 "awg_params_exact": True,
                                 "mtu": (info.get("mtu") or "").strip() or None})
    if not ag.get("ok"):
        return _undo("could not create %s here: %s" % (iface, ag.get("error")))
    conf = (ag.get("data") or {}).get("conf") or ""
    if not conf:
        return _undo("the agent created %s but returned no config path" % iface)
    node_cfg.setdefault("interfaces", {})[iface] = {"cmd": cmd, "conf": conf, "adopted_from": container}
    _adopted_ctr_set(iface, container)     # survives a docker node recreate; the uninstaller reads it
    _CTR_IF["at"] = 0.0
    print("container-takeover: %s is ours now (from %s, %d peer(s) to import)"
          % (iface, container, len(r.get("peers") or [])), flush=True)
    return {"ok": True, "iface": iface, "container": container, "conf": conf,
            "listen_port": port, "address": addr, "proto": cmd[0],
            "peers": r.get("peers") or [], "named": r.get("named") or 0}


_DEFAULT_ROUTES = ("0.0.0.0/0", "::/0")


def _outbound_client_tunnel(conf, addr, live_peers):
    """True when this interface is THIS BOX dialling OUT — a client tunnel, not a server anyone joins.

    WDTT-Plus's optional exit is one: pick `warp_free`, `imported_wg` or `wireguard_vps` in its bot and it
    writes /etc/wireguard/wg-wdtt-exit.conf (Cloudflare WARP, an imported profile, or another VPS) and
    policy-routes its users out through it. A hand-rolled wgcf/WARP tunnel has the identical shape. Offering
    one for adoption would hand the panel the box's own egress and present its single upstream as if it were
    a user, so these never reach the operator as a candidate at all.

    All three are required, so a server can never match: the interface holds a HOST address (/32 or /128 — a
    server holds the subnet it hands out, and our mesh links a /31), and it has a peer with an Endpoint (we
    dial IT, not the reverse) whose AllowedIPs take the default route (everything goes there).
    """
    host = False
    for part in str(addr or "").split(","):
        part = part.strip()
        if "/" not in part:
            continue
        with contextlib.suppress(ValueError):
            pfx = int(part.rsplit("/", 1)[1])
            host = host or (pfx == 32 and "." in part) or (pfx == 128 and ":" in part)
    if not host:
        return False

    def dials(ep, aips):
        return bool(str(ep or "").strip()) and any(
            a.strip() in _DEFAULT_ROUTES for a in str(aips or "").split(","))

    for p in (live_peers or []):
        if dials(p.get("endpoint"), p.get("allowed_ips")):
            return True
    if conf:                                   # a DOWN tunnel is still one — read it off the file
        with contextlib.suppress(Exception):
            ep = aips = ""
            inpeer = False
            for ln in open(conf):
                if re.match(r"\s*\[", ln):
                    if inpeer and dials(ep, aips):
                        return True
                    inpeer = bool(re.match(r"(?i)\s*\[Peer\]", ln)); ep = aips = ""
                    continue
                if not inpeer:
                    continue
                m = re.match(r"(?i)\s*Endpoint\s*=\s*(.+)", ln)
                if m:
                    ep = m.group(1).strip()
                m = re.match(r"(?i)\s*AllowedIPs\s*=\s*(.+)", ln)
                if m:
                    aips = m.group(1).strip()
            if inpeer and dials(ep, aips):
                return True
    return False


def iface_candidates(node_cfg):
    """wg/awg interfaces present on this box that this node does NOT manage — Approach-B adoption candidates for the
    panel to classify (WG / AWG / WDTT) or ignore. REPORT ONLY — nothing is touched (a kernel interface stays on the
    kernel until the operator adopts it). Each: name, proto (wg|awg), datapath (kernel|userspace), listen_port,
    address, peers, up, wdtt_hint (an unmanaged userspace wg iface is most likely a WDTT server's)."""
    managed = set((node_cfg.get("interfaces") or {}).keys())
    local_wdtt = {}
    with contextlib.suppress(Exception):
        local_wdtt = _wdtt_load() or {}
    # Only WDTT the PANEL manages is "ours". One carried over by a convert onto a panel that has never seen it is
    # exactly an adoption candidate — and since reconcile_wdtt now preserves those instead of deleting them, this
    # is what makes them visible; otherwise they'd survive on disk and appear nowhere.
    managed |= set(k for k, v in local_wdtt.items() if (v or {}).get("panel_managed"))
    with contextlib.suppress(Exception):
        managed |= set(_csqtt_load().keys())     # csqtt is a distinct managed kind — never a wg/awg/WDTT candidate
    names_wdtt = set(k for k in local_wdtt if k not in managed)
    names = set(names_wdtt)                                  # unadopted local WDTT instances are candidates too
    for tool in (["wg"], ["awg"]):                           # kernel + any userspace socket the CLI can read
        with contextlib.suppress(Exception):
            r = run(_wgcmd(tool) + ["show", "interfaces"])
            if r.returncode == 0:
                names.update((r.stdout or "").split())
    for _d in WG_SOCK_DIRS:                                  # userspace wireguard-go the CLI can't read
        with contextlib.suppress(Exception):
            for f in os.listdir(_d):
                if f.endswith(".sock"):
                    names.add(f[:-5])
    # A FOREIGN WDTT server's interface is invisible to every source above: it writes no .conf, and on a docker node
    # the wg CLI can't see it either (the host's UAPI socket dir isn't mounted) — so an adoption flow that exists to
    # surface it listed everything EXCEPT it. The running process is the authority on which interface it owns.
    for _pid, _fl in _wdtt_procs():
        with contextlib.suppress(Exception):
            names.add(_wdtt_iface_of(_fl))
    for _d in _awg_conf_dirs() + list(WG_CONF_DIRS):         # confs on disk (a down interface is adoptable too)
        with contextlib.suppress(Exception):
            for f in os.listdir(_d):
                if f.endswith(".conf"):
                    names.add(f[:-5])                        # ".conf" is 5 chars — [:-4] leaves a trailing dot
    ipmap = {}
    with contextlib.suppress(Exception):
        for ln in (run(["ip", "-4", "-o", "addr", "show"]).stdout or "").splitlines():
            p = ln.split()
            if len(p) >= 4 and p[2] == "inet":
                ipmap.setdefault(p[1], p[3])
    out = []
    for name in sorted(names):
        if not name or name in managed or name.startswith("swg_"):
            continue
        userspace = any(os.path.exists(os.path.join(_d, name + ".sock")) for _d in WG_SOCK_DIRS)
        conf = _cand_conf(name)
        proto = "awg" if (conf and _conf_is_awg(conf)) else "wg"
        if not conf:
            with contextlib.suppress(Exception):
                if "amneziawg" in (run(["ip", "-d", "-o", "link", "show", name]).stdout or ""):
                    proto = "awg"
        port = 0; peers = 0; up = False; ent_peers = []; awg_live = False
        # Try BOTH tools, preferred one first. `wg` and `awg` each only speak to their own datapath, and the proto
        # guess above is just a guess: a confless interface reports "tun type tun" when it is userspace, so an
        # AmneziaWG device would be dumped with `wg`, fail, and be reported as an empty interface with no peers.
        # Whichever tool answers is also the authoritative proto.
        for _tool in (["awg"], ["wg"]) if proto == "awg" else (["wg"], ["awg"]):
            with contextlib.suppress(Exception):
                r = run(_wgcmd(_tool) + ["show", name, "dump"])
                if r.returncode == 0 and (r.stdout or "").strip():
                    lines = r.stdout.strip().splitlines(); f0 = lines[0].split("\t")
                    if len(f0) >= 3:
                        with contextlib.suppress(ValueError):
                            port = int(f0[2])
                    # Obfuscation knobs, straight from the live device — the ONE signal that cannot be a false
                    # positive: a plain WireGuard interface has no Jc/S1/H* to report. A `wg` dump is exactly
                    # [priv, pub, port, fwmark], so anything longer means the tool emitted awg fields; fwmark is
                    # the last one and is excluded, or a plain interface with a fwmark set would read as AWG.
                    if len(f0) > 4:
                        for _v in f0[3:-1]:
                            if _v and _v not in ("0", "off") and (_v[0].isdigit() or _v[0] == "-"):
                                awg_live = True; break
                    peers = max(0, len(lines) - 1); up = True
                    # The operator is deciding whether to adopt this thing, so show them WHAT is on it, not just a
                    # count. Non-secret fields only — the PSK parse_dump keeps for adoption is dropped here, since
                    # this rides to the browser in /api/state. Capped: a peer list is unbounded and this is a
                    # preview, not the roster it becomes after adoption.
                    with contextlib.suppress(Exception):
                        _, _pl = parse_dump(r.stdout)
                        ent_peers = [{"public_key": p["public_key"], "allowed_ips": p["allowed_ips"],
                                      "endpoint": p["endpoint"], "last_handshake": p["last_handshake"],
                                      "rx_bytes": p["rx_bytes"], "tx_bytes": p["tx_bytes"]} for p in _pl[:200]]
                    if not conf:                            # no conf to trust — believe the tool that answered
                        proto = "awg" if _wgcmd(_tool) == ["awg"] else "wg"
                    break
        if not up and userspace:                            # userspace socket the CLI can't read → UAPI
            port, peers = _uapi_probe(name); up = True
        addr = ipmap.get(name, "")
        if name in names_wdtt:                              # fill from OUR record — a stopped WDTT has no live iface
            _lw = local_wdtt.get(name) or {}
            if not port:
                with contextlib.suppress(Exception):
                    port = int(str(_lw.get("listen") or "").rsplit(":", 1)[-1] or 0)
            if not addr:
                addr = _lw.get("wg_addr") or ""
        if conf and (port == 0 or not addr):                # fill from the on-disk conf (down interface still counts)
            with contextlib.suppress(Exception):
                for ln in open(conf):
                    m = re.match(r"\s*ListenPort\s*=\s*(\d+)", ln)
                    if m and not port:
                        port = int(m.group(1))
                    m = re.match(r"\s*Address\s*=\s*([0-9./,]+)", ln)
                    if m and not addr:
                        addr = m.group(1).split(",")[0].strip()
        if _outbound_client_tunnel(conf, addr, ent_peers):
            continue                                        # this box dialling out (WDTT-Plus exit / WARP) — never a candidate
        ent = {"name": name, "proto": proto, "datapath": "userspace" if userspace else "kernel",
               "listen_port": port, "address": addr, "peers": peers, "up": bool(up),
               "wdtt_hint": bool(userspace or name in names_wdtt),
               "peer_list": ent_peers,
               "conf": conf}
        # Which type should the adopt sheet PRESELECT? Rank by how badly a wrong guess hurts, and only ever
        # preselect on evidence that cannot be coincidence. Deliberately NOT used: "the awg tool answered the
        # dump" — on a box where the amneziawg module backs everything it answers for plain WireGuard interfaces
        # too, which is precisely the false positive to avoid.
        _why = ""
        if awg_live:
            _hint, _why = "awg", "obfuscation parameters are set on the interface"
        elif conf and _conf_has_awg(conf):
            _hint, _why = "awg", "its config carries AmneziaWG parameters"
        elif conf and _conf_is_awg(conf):
            _hint, _why = "awg", "its config is in an AmneziaWG directory (" + os.path.dirname(conf) + ")"
        else:
            _hint = "wg"
        ent["type_hint"], ent["type_why"] = _hint, _why   # abs conf path (if any) — the panel passes it back to /api/iface/onboard to adopt
        # ALWAYS probe — a running server bound to `-iface <name>` is the authoritative signal, and the socket is
        # not. Gating this on `userspace` missed a WDTT server on a kernel interface, one whose fork writes no UAPI
        # socket, and one whose socket sits outside the node's mount namespace — and the interface was then offered
        # as plain WireGuard, which is worse than missing it: adopting it that way fights the live WDTT server for
        # the same device. The probe is a /proc scan, so it costs nothing when there is no such process.
        with contextlib.suppress(Exception):
            fp = wdtt_foreign_probe(name)
            if fp:
                # An explicit allowlist, so anything wdtt_foreign_probe learns has to be named here too.
                # `users` was missing: the adopt sheet counted the users of a DORMANT install but showed none for
                # a RUNNING foreign server — the one case where the operator most needs to see who they take on.
                # `raw_listen` decides whether adoption carries the server's RAW listener over.
                ent["wdtt"] = {k: fp[k] for k in ("fork", "config_dir", "listen", "wg_port", "wg_addr",
                                                  "max_passwords", "has_identity", "adoptable", "store",
                                                  "users", "raw_listen", "container")}
                ent["wdtt_hint"] = True
                ent["type_hint"] = "wdtt"
                ent["type_why"] = "a WDTT server (" + (fp.get("fork") or "unknown fork") + ") is running on it"
                if not ent["listen_port"]:                  # a stopped/kernel iface still knows its ports from argv
                    with contextlib.suppress(Exception):
                        ent["listen_port"] = int(str(fp.get("listen") or "").rsplit(":", 1)[-1] or 0)
                if not ent["address"]:
                    ent["address"] = fp.get("wg_addr") or ""
        out.append(ent)
    return out

# ── boot persistence: is this interface actually wired to come back after a reboot? ──────────────
# The thing that starts an interface at boot is a systemd .wants symlink to <tool>-quick@<iface>.
# Nothing reported whether that symlink exists, so an interface could be UP and healthy on every
# screen while being one reboot away from vanishing — which is exactly what a whole class of nodes
# was (see swg-agent's _iface_unit: the enable was fired into contextlib.suppress and its failure
# went nowhere). This closes the loop by OBSERVING the state each sync rather than trusting what
# some earlier enable returned: an operator `systemctl disable`, a wiped /etc, a half-restored box
# all show up here, and a one-shot return value would have missed every one.
#
# True = enabled, False = NOT enabled and it should be, None = this host does not start interfaces
# from units at all, so the question is meaningless:
#   · no systemctl — a node CONTAINER; node-entrypoint.sh brings its interfaces up.
#   · units declared elsewhere (NixOS and other immutable layouts) — unit_dir_persists() is False,
#     sc_enable_now() there uses `start`, not `enable`, so nothing is EVER enabled by design and a
#     False would be a permanent false alarm on a perfectly healthy node.
_BOOT_PERSIST = {}          # iface -> (checked_at, value)
_BOOT_PERSIST_TTL = 300     # it changes about never; do not spawn a systemctl per interface per 5s sync


def iface_boot_persists(iface, cmd, now=None):
    now = now or time.time()
    hit = _BOOT_PERSIST.get(iface)
    if hit and now - hit[0] < _BOOT_PERSIST_TTL:
        return hit[1]
    val = None
    if shutil.which("systemctl") and unit_dir_persists():
        tool = (cmd or ["awg"])[0]
        try:
            val = run(["systemctl", "is-enabled", "%s-quick@%s" % (tool, iface)]).returncode == 0
        except Exception:
            val = None                      # could not ask → say nothing, never guess False
    _BOOT_PERSIST[iface] = (now, val)
    return val


def build_snapshot(node_cfg, online_max, last_samples, now=None):
    now = now or int(time.time())
    hcfg = node_cfg.get("health") or {}
    interfaces = {}
    stopped_set = _load_stopped_ifaces()   # interfaces the operator deliberately stopped → "stopped", not "down"
    for iface, ic in (node_cfg.get("interfaces") or {}).items():
        cmd = _wgcmd(ic.get("cmd", ["awg"]))
        try:                                        # one bad interface must never kill the whole snapshot
            _r = run(cmd + ["show", iface, "dump"])
            if _r.returncode != 0:                  # interface isn't up — flag it, but still surface its
                try:                                # intended config from the .conf (subnet/awg/port/pubkey)
                    conf_text = open(ic["conf"]).read()
                except OSError:
                    conf_text = ""
                _meta = build_meta([], conf_text, ic.get("endpoint_host") or node_cfg.get("endpoint_host"),
                                   node_cfg.get("dns", []), cmd, iface)
                # `onboarded` on every branch (T-19): the panel needs it to tell an ADD-ONLY interface — one
                # whose foreign peers SURVIVE, and are therefore its to import — from a normal one, whose
                # strays it reaps within a sync. Reported even when there is nothing to import, because the
                # panel gates on the field being PRESENT: absent means "an old node", not "not add-only".
                _bp = iface_boot_persists(iface, ic.get("cmd"), now)
                if iface in stopped_set:            # the operator stopped it — a choice, not a failure (no error)
                    interfaces[iface] = {"peers": [], "meta": _meta, "stopped": True,
                                         "onboarded": bool(ic.get("onboarded")), "boot_persist": _bp}
                else:
                    interfaces[iface] = {"peers": [], "meta": _meta,
                        "down": ((_r.stderr or "").strip() or "interface is not up")[:140],
                        "onboarded": bool(ic.get("onboarded")), "boot_persist": _bp}
                ensure_iface_backup(iface, conf_text, cmd)
                continue
            dump = _r.stdout
            iface_line, raw = parse_dump(dump)
            try:
                conf_text = open(ic["conf"]).read()
            except OSError:
                conf_text = ""
            st = last_samples.setdefault(iface, {"peers": {}, "t": now})
            dt = max(1e-6, now - st["t"])
            peers = peer_view(raw, st["peers"], dt, online_max, now)
            st["peers"] = {p["public_key"]: (p["rx_bytes"], p["tx_bytes"]) for p in raw}
            st["t"] = now
            interfaces[iface] = {
                "peers": peers,
                "meta": build_meta(iface_line, conf_text,
                                   ic.get("endpoint_host") or node_cfg.get("endpoint_host"),
                                   node_cfg.get("dns", []), cmd, iface),
                "onboarded": bool(ic.get("onboarded")),   # add-only: its peers are the panel's to import (T-19)
                "boot_persist": iface_boot_persists(iface, ic.get("cmd"), now),   # will it come back after a reboot?
            }
            if iface in stopped_set:               # it's up again (e.g. brought up outside the panel) → clear the stopped mark
                _set_iface_stopped(iface, False)
            ensure_iface_backup(iface, conf_text, cmd)
        except Exception as e:
            print(f"snapshot: skipping {iface}: {e}", flush=True)
            continue
    _addrs = _node_addrs()                         # one `ip -o addr show`, shared by the three derived views below
    _tps = load_turn_proxies()
    _tflags = {}                                   # Axis-1: per-fork flag discovery (`<binary> -h`), only where the panel manages turn (that's the only place the settings UI shows). Cached per (fork,version).
    if TURN_MANAGE:
        for _tp in _tps:
            _fk = _turn_fork(_tp.get("service") or "")
            if _fk and _fk not in _tflags:
                _tflags[_fk] = _turn_discover_flags(_tp.get("service") or "")
    snap = {"hostname": socket.gethostname(), "generated_at": now,
            "interfaces": interfaces, "turn_proxies": _tps, "turn_flags": _tflags,
            "arch": _turn_arch(),   # so the panel mirrors/pins ONLY this node's arch for a turn install (not both → no slow/failed cross-arch fetch)
            "turn_capable": _turn_arch_ok(),   # false ONLY when this box's arch has no server-linux-<arch> build → panel greys out "Setup proxy" (never blocks on uncertainty)
            "noded_version": NODED_VERSION, "kind": NODE_KIND, "net_mode": NODE_NET,
            "turn_manage": TURN_MANAGE, "cmd_errors": dict(NODE_ERRORS), "cmd_progress": dict(NODE_PROGRESS),
            "update_auto": update_auto(),   # can the panel's Update button do anything here? (see update_auto)
            # Informational, NOT failures: an adoption that succeeded but not from the source the operator named.
            # cmd_errors is the wrong channel for it (it renders as a failure and is cleared on success).
            "onboard_notes": dict(NODE_NOTES),
            "quarantined": op_quarantined(),   # ops in repeated-failure backoff — visible, not silently churning
            "node_ips": list_node_ips(_addrs), "node_ifaces": list_node_ifaces(_addrs),
            "node_ip_ifaces": list_node_ip_ifaces(_addrs), "smartroute": smart_status(),
            "datapath": node_datapath_health(),          # kernel datapath health (awg module loadable?) → panel node-repair "Fix" (bare-metal)
            "iface_key_backups": list_iface_backups(),   # {iface: pubkey} of on-disk key backups (restorability of MISSING ifaces)
            "ifaces_awaiting_key": sorted(_AWAIT_KEY),   # held for the vault, NOT missing — see _AWAIT_KEY
            # ⚠️ CAN this node put a vault-relayed key back? A build older than T-22 ignores `sealed_key`
            # on a restore and silently reverts from its on-disk backup instead — which after a migration
            # IS the minted key, so the restore "succeeds" and changes nothing. The panel must not offer a
            # door the node cannot walk through, so it asks rather than guessing from a version string
            # (which is stamped independently of content and has false-passed here before).
            "iface_key_vault_restore": True,
            "transport_pub": transport_pub(),            # node re-seal target — the browser seals a restored key to this
            "iface_key_sealed": dict(_IVK_SEALED),       # {iface: {pub, eph, ct, mac}} interface keys sealed to the vault, pending upload
            "wdtt_key_sealed": dict(_WDTT_SEALED)}        # {iface: {pub(server_pub), ...}} WDTT server identities sealed to the vault, pending upload
    # Added only when set, so a node with neither env var reports exactly what it reported before
    # these fields existed. See NODE_PLATFORM / NODE_DECLARATIVE at the top: `kind` still says how
    # this node RUNS; these say what owns its installation, and only the panel's UI reads them.
    _pid, _pinfo = (NODE_PLATFORM, {}) if NODE_PLATFORM else ("", {})
    if not _pid:
        with contextlib.suppress(Exception):
            _pid, _pinfo = _platform_detect()
    elif NODE_PLATFORM:                                   # an explicit label still wins, but the DETAIL is worth having
        with contextlib.suppress(Exception):
            _pinfo = _platform_detect()[1]
    if _pid:
        snap["platform"] = _pid
    if _pinfo:
        snap["platform_info"] = _pinfo                    # {name, version, kernel} — presentation only, like platform
    if NODE_DECLARATIVE:
        snap["declarative"] = True
    if NODE_RUNTIME:
        snap["runtime"] = NODE_RUNTIME
    if NODE_UDP_PORTS:
        snap["udp_ports"] = NODE_UDP_PORTS
    snap["wdtt"] = wdtt_snapshot()                    # WDTT instances: active + server pubkey + per-password device/traffic (read-back for the panel; no privkeys)
    snap["csqtt"] = csqtt_snapshot()                  # csqtt instances (raw-TUN): active + per-password device/traffic + byte-delta online (no privkeys)
    # ⚠️ An instance WE hold that the panel does not claim. Nothing will ever start it: the node only runs
    # what the panel desires, and removals are explicit — so it sits installed, stopped and ownerless, while
    # the card reads "starting" for ever because our own record says it was not deliberately stopped. Seen on
    # a live node: a WDTT and a csqtt server, both disabled for three days, both still holding their users,
    # and the only offered action (Start) could not work because the panel had no record to submit. Say so,
    # and the panel can offer to reclaim it — with its users — instead of showing a server nobody owns.
    for _fam in ("wdtt", "csqtt"):
        _cl = _CLAIMED.get(_fam)
        if _cl is None:                      # never had a valid reply → claim nothing about claims
            continue
        for _e in (snap.get(_fam) or []):
            if _e and _e.get("iface") not in _cl:
                _e["unclaimed"] = True
    with contextlib.suppress(Exception):              # VK-relay src-IPs for the self-contained turn servers (capture ensured in _attach_turn_src_ips, above)
        _cmap = _turn_peer_ips()
        for _x in (snap.get("wdtt") or []) + (snap.get("csqtt") or []):
            if not _x:
                continue
            _lp = str(_x.get("listen") or "").rsplit(":", 1)[-1]
            if _lp.isdigit():
                _x["src_ips"] = sorted(_cmap.get(_lp, ()))
    snap["iface_candidates"] = iface_candidates(node_cfg)
    # Interfaces in ANOTHER container's netns (AmneziaWG's server is the case). A SEPARATE key, never
    # merged into the candidates above: those are offers to adopt, and this one cannot be adopted in
    # place — see _container_ifaces. Reported so the panel can say what is running instead of nothing.
    snap["container_ifaces"] = _container_ifaces()
    if _CTR_ADOPT:
        snap["container_adopt"] = dict(_CTR_ADOPT)   # take-over result → the panel imports the peers and clears   # unmanaged wg/awg interfaces on the box → panel adoption candidates (report-only, untouched)
    snap["wdtt_dormant"] = wdtt_dormant()                   # WDTT installs on disk with nothing running (no iface to be a candidate)
    snap["csqtt_candidates"] = csqtt_candidates()           # FOREIGN csqtt servers on the box → panel adoption candidates (report-only, untouched)
    if hcfg.get("enabled", True):      # additive + opt-out; mounts default to ["/"]
        snap["health"] = collect_health(mounts=hcfg.get("mounts"))
    snap["inet"] = sample_inet(node_cfg, now)   # measured internet up/down (B/s); cached, refreshed off the 5s path
    snap["cat_rate"] = sample_cats()            # LIVE per-category throughput {cat:{up,dn}} B/s (latest push, delta of the nft counters)
    for _c, _v in sample_catk().items():        # + Kernel-SNI categories (swgk ipsets, invisible to the nft catcount) — add per cat
        _b = snap["cat_rate"].setdefault(_c, {"up": 0.0, "dn": 0.0})
        _b["up"] = _b.get("up", 0.0) + _v["up"]; _b["dn"] = _b.get("dn", 0.0) + _v["dn"]
    return snap


# ───────────────────────── reconcile ─────────────────────────

_UNSET = object()


def _iface_dump(node_cfg, iface):
    """One `<cmd> show <iface> dump` -> (iface_line, peers), or None if the interface can't be read (down /
    no such device). Lets a caller fetch the live interface ONCE and share it across current_pubkeys/
    current_allowed instead of shelling out per accessor every cycle."""
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    cmd = _wgcmd(ic.get("cmd", ["awg"]))
    try:
        r = run(cmd + ["show", iface, "dump"])
        if r.returncode != 0:
            return None
        return parse_dump(r.stdout)
    except Exception:
        return None


def current_pubkeys(node_cfg, iface, dump=_UNSET):
    if dump is _UNSET:                              # not pre-fetched → read it now
        dump = _iface_dump(node_cfg, iface)
    if dump is None:                               # interface down / no such device — NOT "zero peers"
        return None
    return {p["public_key"] for p in dump[1]}


def _norm_allowed(s):
    """Normalize an AllowedIPs string for comparison — sorted, deduped, whitespace-stripped CIDRs.
    (awg/wg may reorder the list, so a raw string compare would churn.)"""
    return ",".join(sorted({c.strip() for c in (s or "").split(",") if c.strip()}))


def current_allowed(node_cfg, iface, dump=_UNSET):
    """{pubkey -> normalized AllowedIPs} live on the interface, or None if it can't be read."""
    if dump is _UNSET:
        dump = _iface_dump(node_cfg, iface)
    if dump is None:
        return None
    return {p["public_key"]: _norm_allowed(p["allowed_ips"]) for p in dump[1]}


def current_endpoints(node_cfg, iface, dump=_UNSET):
    """{pubkey -> live 'ip:port' endpoint} on the interface, or None if it can't be read. Used to ADOPT a
    mesh dial-out peer already dialed to the desired endpoint after our applied_ep memory is lost (restart /
    docker convert) — so we neither re-add a duplicate (which the agent refuses) nor spin the reconcile."""
    if dump is _UNSET:
        dump = _iface_dump(node_cfg, iface)
    if dump is None:
        return None
    return {p["public_key"]: p.get("endpoint") for p in dump[1]}


MESH_STALE_S = 240   # a dial-out mesh peer silent this long (well past keepalive + the panel's 180s "down") is stuck → bounce
def current_handshakes(node_cfg, iface, dump=_UNSET):
    """{pubkey -> last-handshake unix ts (0 if never)} on the interface, or None if unreadable. Lets the
    reconcile detect a dial-out mesh peer that HAS connected but gone silent-stale (endpoint moved / NAT
    rebind / DPI) — WG dialing a fixed endpoint never recovers that on its own, so we bounce it."""
    if dump is _UNSET:
        dump = _iface_dump(node_cfg, iface)
    if dump is None:
        return None
    return {p["public_key"]: p.get("last_handshake") or 0 for p in dump[1]}


def current_listen_port(node_cfg, iface):
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    cmd = _wgcmd(ic.get("cmd", ["awg"]))
    try:
        r = run(cmd + ["show", iface, "dump"])
        if r.returncode == 0:
            iface_line, _ = parse_dump(r.stdout)
            if len(iface_line) > 2 and str(iface_line[2]).isdigit():
                return int(iface_line[2])
    except Exception:
        pass
    try:                                  # interface DOWN — fall back to the .conf so a port change still
        info = parse_interface_section(open(ic["conf"]).read())   # converges (set-iface persists it for next up)
        lp = str(info.get("ListenPort", "")).strip()
        return int(lp) if lp.isdigit() else None
    except Exception:
        return None


def _conf_text(node_cfg, iface):
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    try:
        with open(ic["conf"]) as f:
            return f.read()
    except Exception:
        return ""


def current_awg(node_cfg, iface):
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    try:
        with open(ic["conf"]) as f:
            return awg_params(parse_interface_section(f.read()))
    except Exception:
        return None


def reconcile_ifaces(node_cfg, desired_ifaces, agent, sudo):
    """Apply the panel's desired interface config (listen port, link MTU and/or AmneziaWG params).
    Only ever called on a valid sync reply; converges the live interface to the panel's target."""
    res = {"changed": 0, "errors": []}
    for iface, want in (desired_ifaces or {}).items():
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        payload = {"op": "set-iface", "iface": iface}
        port = want.get("listen_port")
        if port:
            cur = current_listen_port(node_cfg, iface)
            if cur is not None and int(cur) != int(port):
                payload["listen_port"] = int(port)
        mtu = want.get("mtu")
        if mtu:
            cur_mtu = iface_mtu(iface, parse_interface_section(_conf_text(node_cfg, iface)))
            if cur_mtu is None or int(cur_mtu) != int(mtu):
                payload["mtu"] = int(mtu)
        awg = want.get("awg_params")
        if isinstance(awg, dict) and awg:
            cur_awg = current_awg(node_cfg, iface) or {}
            want_s = {k: str(v) for k, v in awg.items()}
            if any(str(cur_awg.get(k)) != v for k, v in want_s.items()):
                payload["awg_params"] = awg
        akey = "setiface|" + iface
        if len(payload) <= 2:                 # only op + iface — nothing differs
            _op_ok(akey)                      # nothing left to apply IS convergence: drop any prior backoff
            continue
        # ⚠️ BACKOFF, LIKE EVERY OTHER AGENT OP. This one was outside it, and outside NODE_ERRORS with it,
        # so a set-iface that cannot succeed — an interface whose conf is gone is the ordinary case —
        # re-spawned the agent every 5 seconds for ever while the panel showed the operator nothing at all
        # (measured live, §7.5 of the rebuild plan: the same failure logged for minutes with cmd_errors
        # empty). Both halves are this omission: the churn AND the silence. `_op_cfg_changed` keeps the
        # self-heal — a corrected desired state retries on the next sync instead of waiting out the
        # exponential — and the error is still reported while quarantined, which is the contract the
        # backoff's own comment states.
        _op_cfg_changed(akey, json.dumps(payload, sort_keys=True))
        if not _op_ready(akey):
            res["errors"].append(f"set-iface {iface}: {_op_err(akey) or 'repeated failure'} (retrying)")
            continue
        r = run_agent(agent, sudo, payload)
        if r.get("ok"):
            _op_ok(akey); res["changed"] += 1
        else:
            _op_fail(akey, err=r.get("error")); res["errors"].append(f"set-iface {iface}: {r.get('error')}")
    return res


def reconcile(node_cfg, desired_by_iface, agent, sudo, remove_by_iface=None):
    """Apply the panel's desired peer set. Only ever called on a valid sync reply."""
    res = {"added": 0, "removed": 0, "errors": []}
    remove_by_iface = remove_by_iface or {}
    # last DESIRED endpoint we pushed per peer — so an operator changing a node's ingress IP re-dials existing
    # links (the panel sends the new endpoint; we apply it once), without fighting WireGuard's roaming (we key
    # on the desired value, not the live/roamed one). iface|pubkey -> endpoint.
    EP_FILE = os.path.join(STATE_DIR, "mesh-eps.json")
    applied_ep = {}
    with contextlib.suppress(Exception):
        applied_ep = json.load(open(EP_FILE))
    ep_dirty = False
    for iface, ic in (node_cfg.get("interfaces") or {}).items():
        desired = {p["public_key"]: p for p in (desired_by_iface.get(iface) or [])}
        dump = _iface_dump(node_cfg, iface)         # read the live interface ONCE, shared by both accessors below
        current = current_pubkeys(node_cfg, iface, dump)
        if current is None:
            res["errors"].append(f"{iface}: cannot read interface")
            continue
        live_allowed = current_allowed(node_cfg, iface, dump) or {}   # for re-applying a CHANGED AllowedIPs (cascade /32→/0)
        live_ep = current_endpoints(node_cfg, iface, dump) or {}       # live endpoints — adopt an already-dialed peer (see the re-assert below)
        live_hs = current_handshakes(node_cfg, iface, dump) or {}      # live handshake ts — detect a silent-stale dial-out mesh peer
        # EXPLICIT retirements from the panel (a key it rotated/deleted) FIRST — removed even on an
        # add-only interface, and before the add below so the replacement key can take the freed IP.
        for pk in remove_by_iface.get(iface, []):
            if pk in current and pk not in desired:
                r = run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                if r.get("ok"):
                    res["removed"] += 1; current.discard(pk)
                else:
                    res["errors"].append(f"retire {pk[:8]}: {r.get('error')}")
        for pk, p in desired.items():
            if pk in current:
                if live_hs.get(pk) and (time.time() - live_hs[pk]) <= MESH_STALE_S:
                    _op_ok("stale|" + iface + "|" + pk)   # link is healthy → reset any prior stale-bounce backoff
                # already present — but its AllowedIPs may have CHANGED (cascade flips a mesh peer
                # /32 ↔ 0.0.0.0/0, or an exit gains a forwarded subnet). reconcile otherwise skips
                # present peers, so apply the diff surgically (this is risk R1).
                want_a = _norm_allowed(p.get("allowed_ips", ""))
                if want_a and live_allowed.get(pk) is not None and live_allowed[pk] != want_a:
                    r = run_agent(agent, sudo, {"op": "set-peer-allowed", "iface": iface,
                                                "public_key": pk, "allowed_ips": p.get("allowed_ips", "")})
                    if r.get("ok"):
                        res["added"] += 1                        # count as a change (drives the reconcile log)
                    else:
                        res["errors"].append(f"allowed {pk[:8]}: {r.get('error')}")
                # endpoint CHANGED (the peer's ingress IP/port was edited) → re-dial: re-assert the peer with
                # the new endpoint. Keyed on the desired value so this fires once per real change, not per roam.
                ek = iface + "|" + pk; want_ep = p.get("endpoint")
                if want_ep and applied_ep.get(ek) != want_ep:
                    if live_ep.get(pk) == want_ep:
                        # SELF-HEAL (no datapath change): the peer is ALREADY dialed to exactly the desired
                        # endpoint — our applied_ep memory was simply lost (process restart / docker convert /
                        # EP_FILE gone). Adopt it: record the endpoint WITHOUT re-adding. The agent refuses a
                        # duplicate add ("peer_exists"), and that failure was pinning the reconcile at the fast
                        # retry cadence forever (~17% CPU). A healthy link is left untouched.
                        applied_ep[ek] = want_ep; ep_dirty = True
                    elif not _op_ready("redial|" + ek):             # a re-dial that keeps failing → back off, don't churn
                        res["errors"].append(f"endpoint {pk[:8]}: retrying later (repeated failure)")
                    else:
                        _mkadd = lambda: {"op": "add-peer", "iface": iface, "public_key": pk,
                                          "allowed_ips": p.get("allowed_ips", ""),
                                          "preshared_key": p.get("preshared_key", "none"),
                                          "endpoint": want_ep,
                                          "persistent_keepalive": p.get("persistent_keepalive"),
                                          "name": p.get("name", "")}
                        r = run_agent(agent, sudo, _mkadd())
                        if not r.get("ok") and r.get("code") == "peer_exists":
                            # genuine re-dial, but the peer lingers under a DIFFERENT endpoint and the agent won't
                            # add a duplicate → self-heal: drop it, then re-add with the new endpoint.
                            run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                            r = run_agent(agent, sudo, _mkadd())
                        if r.get("ok"):
                            _op_ok("redial|" + ek); applied_ep[ek] = want_ep; ep_dirty = True; res["added"] += 1
                        else:
                            _op_fail("redial|" + ek); res["errors"].append(f"endpoint {pk[:8]}: {r.get('error')}")
                elif want_ep and live_hs.get(pk) and (time.time() - live_hs[pk]) > MESH_STALE_S and _op_ready("stale|" + ek):
                    # SILENT-MESH-DEATH heal: a dial-out mesh peer that HANDSHOOK before but has been stale past
                    # MESH_STALE_S is stuck — the remote's ingress moved (NAT rebind / IP change / DPI) and WG,
                    # dialing a fixed endpoint, never recovers. Bounce it (re-resolves a hostname endpoint on
                    # re-add). Gated: only a previously-connected peer (never-connected = "connecting", not stuck),
                    # and backoff-guarded so a genuinely-offline peer doesn't churn.
                    run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                    r = run_agent(agent, sudo, {"op": "add-peer", "iface": iface, "public_key": pk,
                                                "allowed_ips": p.get("allowed_ips", ""),
                                                "preshared_key": p.get("preshared_key", "none"),
                                                "endpoint": want_ep,
                                                "persistent_keepalive": p.get("persistent_keepalive"),
                                                "name": p.get("name", "")})
                    if r.get("ok"):
                        _op_fail("stale|" + ek)   # count the bounce for backoff, but DON'T clear — a healthy link stops being stale on its own next cycle
                        applied_ep[ek] = want_ep; ep_dirty = True; res["added"] += 1
                    else:
                        _op_fail("stale|" + ek); res["errors"].append(f"stale-redial {pk[:8]}: {r.get('error')}")
                continue
            akey = "add|" + iface + "|" + pk
            _op_cfg_changed(akey, (p.get("allowed_ips", ""), str(p.get("endpoint") or ""), p.get("preshared_key", "none")))  # a corrected desired config → drop the backoff, retry now
            if not _op_ready(akey):                                  # repeatedly rejected AND config unchanged → in backoff; don't re-spawn the agent
                res["errors"].append(f"add {pk[:8]}: retrying later (repeated failure)")
                continue
            r = run_agent(agent, sudo, {
                "op": "add-peer", "iface": iface, "public_key": pk,
                "allowed_ips": p.get("allowed_ips", ""),
                "preshared_key": p.get("preshared_key", "none"),
                "endpoint": p.get("endpoint"),                       # mesh peers dial out (user peers: None)
                "persistent_keepalive": p.get("persistent_keepalive"),
                "name": p.get("name", "")})
            if r.get("ok"):
                _op_ok(akey); res["added"] += 1
                if p.get("endpoint"):
                    applied_ep[iface + "|" + pk] = p.get("endpoint"); ep_dirty = True
            else:
                _op_fail(akey); res["errors"].append(f"add {pk[:8]}: {r.get('error')}")
        # An onboarded interface is ADD-ONLY: the panel never removes peers it didn't create, so an
        # interface adopted from another tool (e.g. wg-easy) keeps its existing peers. They surface
        # as adoptable orphans instead of being wiped.
        if ic.get("onboarded"):
            continue
        for pk in current - set(desired):
            r = run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
            if r.get("ok"):
                res["removed"] += 1
                applied_ep.pop(iface + "|" + pk, None); ep_dirty = True
            else:
                res["errors"].append(f"remove {pk[:8]}: {r.get('error')}")
    if ep_dirty:
        with contextlib.suppress(Exception):
            with open(EP_FILE + ".tmp", "w") as f:
                json.dump(applied_ep, f)
            os.replace(EP_FILE + ".tmp", EP_FILE)
    return res


def _strip_learned_endpoints(body):
    """Drop `Endpoint =` lines that `showconf` LEARNED rather than read from configuration.

    A peer's endpoint is the source address of the last packet wg accepted from it — transient client state,
    not config. Writing it into the server's conf pins a client's IP into a file that backups and the
    bare<->docker conversion copy around, and makes the next `wg-quick up` dial an address the client may
    have left. wg corrects it on the first authenticated packet, so keeping it buys nothing.

    A peer that also sets PersistentKeepalive is the exception: that pair is how a dial-OUT peer is written
    (mesh / node-to-node), and there the Endpoint IS configuration — drop it and the link only forms if the
    far end happens to initiate. showconf cannot otherwise tell the two apart.
    """
    out, sec = [], []

    def emit():
        blk = sec
        if blk and re.match(r"(?i)^\s*\[Peer\]", blk[0]) and not any(
                re.match(r"(?i)^\s*PersistentKeepalive\s*=", l) for l in blk):
            blk = [l for l in blk if not re.match(r"(?i)^\s*Endpoint\s*=", l)]
        out.extend(blk)

    for ln in body.splitlines():
        if re.match(r"(?i)^\s*\[", ln):
            emit(); sec = [ln]
        else:
            sec.append(ln)
    emit()
    return "\n".join(out)


def _reconstruct_conf(iface, cmd):
    """Rebuild an interface's .conf from the LIVE device and return its path ('' if that isn't possible).

    A docker node mounts its own dir over /etc/amnezia/amneziawg, so a pre-existing HOST interface's .conf is
    invisible in here and the candidate is reported with conf="" — adoption then failed for every wg/awg device on
    the box. `wg/awg showconf` reads the running device over netlink, which works fine from the container (host
    networking) and yields the server key plus every peer — exactly what adoption promises to keep, and fresher
    than any file. showconf omits the interface ADDRESS (it is not kernel state the tool reports), so that comes
    from `ip addr`.

    Written into the node's own persisted conf dir, never the host's: we are adopting the interface, not editing
    somebody else's file, and on docker that dir is the bind-mount that survives a recreate."""
    dst_dir = _awg_conf_dirs()[0] if cmd == ["awg"] else (AWG_CONF_DIRS[0] if NODE_KIND == "docker" else WG_CONF_DIRS[0])
    with contextlib.suppress(Exception):
        r = run(cmd + ["showconf", iface])
        body = (r.stdout or "").strip()
        if not body or "[Interface]" not in body:
            return ""
        body = _strip_learned_endpoints(body)
        addr = ""
        with contextlib.suppress(Exception):
            for ln in (run(["ip", "-4", "-o", "addr", "show", iface]).stdout or "").splitlines():
                p = ln.split()
                if len(p) >= 4 and p[2] == "inet":
                    addr = p[3]; break
        if addr and "Address" not in body.split("[Peer]")[0]:
            body = body.replace("[Interface]", "[Interface]\nAddress = " + addr, 1)
        # MTU is a wg-quick directive, so showconf omits it — but it IS on the live link, and dropping it
        # silently re-created the interface with a different MTU than the one that was serving. (DNS, Table and
        # the PostUp/PostDown hooks live ONLY in the file; when that file is unreadable they are genuinely lost,
        # which is what the caller warns about rather than papering over.)
        mtu = ""
        with contextlib.suppress(Exception):
            _lk = (run(["ip", "-o", "link", "show", iface]).stdout or "")
            _m = re.search(r"\bmtu (\d+)\b", _lk)
            if _m:
                mtu = _m.group(1)
        if mtu and "MTU" not in body.split("[Peer]")[0]:
            body = body.replace("[Interface]", "[Interface]\nMTU = " + mtu, 1)
        os.makedirs(dst_dir, exist_ok=True)
        path = os.path.join(dst_dir, iface + ".conf")
        if os.path.exists(path):          # never clobber a conf we already manage
            return path
        with open(path, "w") as f:
            # …and which protocol it is. A rebuilt conf lands in whichever directory THIS run-model uses,
            # which is not the same one the next model will read it from — so the file has to carry the
            # answer rather than let its location imply one (see the agent's writer for why the content
            # cannot be probed for it).
            f.write("#swg:onboarded\n#swg:cmd " + (cmd[0] if cmd else "awg") + "\n" + body + "\n")
        os.chmod(path, 0o600)
        return path
    return ""


def _live_wg_ifaces():
    """Names of wg/awg devices that exist on this box right now. The datapath is the authority — awg first,
    because an amneziawg device answers only to `awg`."""
    live = set()
    for tool in (["awg"], ["wg"]):
        with contextlib.suppress(Exception):
            r = run(_wgcmd(tool) + ["show", "interfaces"])
            if r.returncode == 0:
                live |= set((r.stdout or "").split())
    return live


# ── what this box is carrying, and how it is running it ─────────────────────────────────────────
# A node's RUN-MODEL can change underneath it: bare-metal ↔ docker (convert.sh), native ↔ container (a
# declarative module), a container recreated, a box restored onto a different one. Each model keeps its
# records in its OWN paths, so the next incarnation starts blind — and, worse, the previous one's fork
# servers and turn proxies are still running, holding the tun devices and the ports the new one needs.
# Measured on a live master: after a switch the old servers kept serving, unmanaged and invisible, while
# the new ones died with "create TUN device".
#
# So write ONE record of what is here, in the one directory every run-model already shares (STATE_DIR:
# bare-metal writes it directly, a container gets it bind-mounted, convert.sh carries it across), and
# name every component the way THIS incarnation actually created it. A handover then stops exactly what
# the record says — never a name pattern, which would eventually match somebody else's unit.
NODE_INVENTORY = os.path.join(STATE_DIR, "node-inventory.json")
_INV_LAST = {"sig": None}


def _inventory_now(node_cfg):
    inv = {"at": int(time.time()), "kind": NODE_KIND, "runtime": NODE_RUNTIME,
           "ifaces": sorted((node_cfg.get("interfaces") or {}).keys()),
           "units": [], "containers": []}
    with contextlib.suppress(Exception):
        _turn = [tp.get("service") for tp in load_turn_proxies() if tp.get("service")]
        if NODE_KIND == "docker":
            # This model runs turn proxies as SIBLING containers and the fork servers as its own children —
            # the children die with it, so only the containers outlive this process.
            inv["containers"] = sorted(_turn_cname(sv) for sv in _turn)
        else:
            inv["units"] = sorted([_wdtt_svc(i) for i in (_wdtt_load() or {})]
                                  + [_csqtt_svc(i) for i in (_csqtt_load() or {})]
                                  + list(_turn))
    return inv


def write_inventory(node_cfg):
    """Keep the record current. Written only when it CHANGES — this runs on every sync."""
    inv = _inventory_now(node_cfg)
    sig = json.dumps({k: v for k, v in inv.items() if k != "at"}, sort_keys=True)
    if sig == _INV_LAST["sig"]:
        return
    with contextlib.suppress(Exception):
        os.makedirs(os.path.dirname(NODE_INVENTORY), exist_ok=True)
        tmp = NODE_INVENTORY + ".tmp"
        with open(tmp, "w") as f:
            json.dump(inv, f, indent=2)
        os.replace(tmp, NODE_INVENTORY)
        _INV_LAST["sig"] = sig


def handover_from_previous_runmodel():
    """Stop what a PREVIOUS run-model left running here, by the names IT recorded. Once, at startup.

    Interfaces are deliberately NOT touched: they are kernel state in the host namespace, they keep
    serving across the change, and selfheal_ifaces takes them back on the first sync. What must stop are
    the things that OWN a device or a port — fork servers and turn proxies — because two owners of one
    tun device is not a state either of them can resolve.

    Where we cannot reach them (a container node with no runtime socket), say exactly which units are
    still up rather than failing quietly: that is a one-line fix for an operator and an invisible outage
    otherwise."""
    prev = None
    with contextlib.suppress(Exception):
        with open(NODE_INVENTORY) as f:
            prev = json.load(f)
    if not isinstance(prev, dict) or not prev.get("kind"):
        return
    if (prev.get("kind"), prev.get("runtime") or "") == (NODE_KIND, NODE_RUNTIME or ""):
        return                                   # same model — its components are ours, not leftovers
    units = [u for u in (prev.get("units") or []) if isinstance(u, str) and u]
    ctrs = [c for c in (prev.get("containers") or []) if isinstance(c, str) and c]
    if not (units or ctrs):
        return
    print("run-model changed (%s/%s -> %s/%s) — handing over %d unit(s), %d container(s) from the previous one"
          % (prev.get("kind"), prev.get("runtime") or "-", NODE_KIND, NODE_RUNTIME or "-", len(units), len(ctrs)),
          flush=True)
    stuck = []
    for u in units:
        w = host_sh(sc_disable_now_stop(u), timeout=60)
        if w.returncode != 0:
            stuck.append(u)
    for c in ctrs:
        with contextlib.suppress(Exception):
            if run([_ctr_cli(), "stop", "-t", "10", c], timeout=60).returncode != 0 and _ctr_running(c):
                stuck.append(c)
    _handover_fork_dirs()
    _handover_turn()
    if stuck:
        NODE_ERRORS["handover"] = (
            "This node changed run-model, and the previous one's servers are still running here: "
            + ", ".join(sorted(stuck)[:6])
            + ". They hold the interfaces and ports this one needs. Stop them on the box "
              "(`systemctl disable --now <name>`), then this node takes over on its next sync.")
        print("handover: could not stop " + ", ".join(sorted(stuck)), flush=True)
    else:
        NODE_ERRORS.pop("handover", None)
        print("handover: the previous run-model's components are stopped", flush=True)


def backfill_cmd_markers(node_cfg):
    """Write `#swg:cmd` into the confs of interfaces we already manage, once.

    The marker only lands on confs written from now on, which would leave every interface that already
    exists exposed to the thing it prevents — a conf moving between directories and coming back as the
    other protocol. So stamp what is here. The source is the LIVE DEVICE, not our record: the device is
    what the interface actually IS today (a record can be a copy of an earlier wrong guess, which is
    exactly how this failure propagates), and an interface that is not up is left alone rather than
    guessed at. Never touches a conf that already carries a marker, and never one we do not manage."""
    live = {}
    for tool in ("awg", "wg"):
        with contextlib.suppress(Exception):
            r = run(_wgcmd([tool]) + ["show", "interfaces"])
            if r.returncode == 0:
                for n in (r.stdout or "").split():
                    live.setdefault(n, tool)          # awg first: an amneziawg device answers only to awg
    for iface, rec in (node_cfg.get("interfaces") or {}).items():
        conf = (rec or {}).get("conf") or ""
        tool = live.get(iface)
        if not (conf and tool and os.path.isfile(conf)):
            continue
        with contextlib.suppress(Exception):
            with open(conf) as f:
                head = f.read()
            if "#swg:cmd" in head.split("[Interface]")[0]:
                continue
            with open(conf, "w") as f:
                f.write("#swg:cmd " + tool + "\n" + head)
            print("conf: stamped %s as %s (so it keeps its protocol wherever it goes)" % (iface, tool), flush=True)


def _handover_fork_dirs():
    """Carry each WDTT/csqtt instance's own directory into the root THIS run-model uses.

    The two models keep fork state in different places — /opt/swg-{wdtt,csqtt} on bare-metal, the mounted
    state dir in a container — so a switch left the new model looking at an empty root and treating live
    servers as absent. WDTT survived that because its identity is escrowed and it HELD rather than mint a
    new key, which is the system working but still costs the operator an unlock; csqtt has no escrow and
    simply came back with a new owner password. Neither is necessary: the directory is right there on the
    same box, and the record (shared now) says which instances there are.

    Copy the state, never the binary: `server` is a symlink into a per-root .bin, and the install path
    rewrites it anyway. An existing directory in this root is left completely alone — it is either ours
    already or something we must not overwrite."""
    for root, other, load in ((WDTT_ROOT, ("/opt/swg-wdtt" if NODE_KIND == "docker" else "/var/lib/swg-noded/wdtt"), _wdtt_load),
                              (CSQTT_ROOT, ("/opt/swg-csqtt" if NODE_KIND == "docker" else "/var/lib/swg-noded/csqtt"), _csqtt_load)):
        insts = {}
        with contextlib.suppress(Exception):
            insts = load() or {}
        for iface in insts:
            src, dst = os.path.join(other, iface), os.path.join(root, iface)
            if os.path.exists(dst) or not os.path.isdir(src):
                continue
            with contextlib.suppress(Exception):
                os.makedirs(root, exist_ok=True)
                shutil.copytree(src, dst, symlinks=False, ignore=shutil.ignore_patterns("server", "*.log"))
                print("handover: carried %s's state from %s into %s" % (iface, src, dst), flush=True)


def _turn_record_raw():
    """The turn record AS WRITTEN, without the bare-metal reconcile in load_turn_proxies().

    That reconcile makes the unit files the inventory — a proxy whose unit is gone drops out, which is
    right when an operator deletes a unit and wrong the moment we are asking what the PREVIOUS run-model
    was carrying: its proxies were containers, so this arm has no unit for any of them."""
    with contextlib.suppress(Exception):
        with open(TURN_RECORD) as f:
            d = json.load(f)
        return [t for t in ((d or {}).get("turn_proxies") or []) if isinstance(t, dict) and t.get("service")]
    return []


def _handover_turn():
    """Stand the previous run-model's turn proxies up in THIS model's form.

    The two models keep turn proxies in different shapes — host units on bare-metal, sibling containers on
    docker — so a switch does not merely leave them stopped, it leaves them with no representation here at
    all: the panel's cards vanish and the operator's config goes with them. The shared record is what makes
    this possible; it holds listen/connect/params, which is everything an install needs except the fork,
    and that comes from the record or from the binary's own repo.txt.

    Only ever for a proxy this arm does not already have, and errors are reported rather than retried:
    installing pulls a binary, and a loop that re-pulls one every five seconds is worse than a card the
    operator can press Reinstall on."""
    rec = _turn_record_raw()
    if not rec:
        return
    have = set()
    with contextlib.suppress(Exception):
        have = {t.get("service") for t in (load_turn_proxies() or []) if t.get("service")}
    for t in rec:
        svc = t["service"]
        if svc in have:
            continue
        owner = (t.get("owner") or "").strip()
        if not owner:
            for rp in (_turn_repo_path(svc), _turn_repo_path_legacy(svc)):
                with contextlib.suppress(Exception):
                    with open(rp) as f:
                        owner = f.read().strip()
                if owner:
                    break
        if not (owner and t.get("listen") and t.get("connect")):
            NODE_ERRORS["turn:" + svc] = (
                "This node changed run-model and " + svc + " did not come across — its record does not say "
                "which fork it runs, so it cannot be rebuilt here. Re-create it from the panel.")
            continue
        req = {"owner": owner, "listen": t["listen"], "connect": t["connect"], "params": t.get("params") or ""}
        err = (_dturn_install(svc, req)[0] if TURN_DOCKER else _turn_install(svc, req))
        if err:
            NODE_ERRORS["turn:" + svc] = ("Rebuilding " + svc + " after the run-model change failed: " + str(err)[:120])
            print("handover: turn %s could not be rebuilt: %s" % (svc, str(err)[:120]), flush=True)
        else:
            NODE_ERRORS.pop("turn:" + svc, None)
            print("handover: turn %s rebuilt in this run-model's form" % svc, flush=True)


def sc_disable_now_stop(svc):
    """Stop AND unlink a unit a previous run-model left behind, without caring which of the two works.

    `disable --now` fails as a whole where units live in a read-only directory (a store-based OS), and the
    STOP is the half that matters — a server that keeps holding a tun device is the problem, an orphaned
    unit file is not."""
    q = shlex.quote(svc)
    return ("systemctl stop " + q + " >/dev/null 2>&1; systemctl disable " + q + " >/dev/null 2>&1; "
            "systemctl is-active --quiet " + q + " && exit 1; exit 0")


def selfheal_ifaces(node_cfg, desired_ifaces, owned=None):
    """Interfaces the PANEL manages that are live on this box but that we hold no config for → onboard them
    ourselves, as {iface: {cmd, conf}} for onboard_ifaces.

    The case this exists for: a container recreate wipes a conf written to container-local storage while the
    interface itself survives in the host netns (it lives there, not in the container). The node then comes back
    to a live device it has no record of, stops reporting it, and the panel shows the interface as MISSING until
    somebody clicks Restore — which does exactly what this does, from the same live device. There is nothing for
    a human to decide: the panel already says it owns the interface, and the interface is right there.

    Only ever for an interface that is genuinely UP here. One the panel wants and this box does not have is a
    different situation — it may need recreating from a key backup, which is a decision, not a repair — and it
    must not be retried every five seconds.
    """
    # `owned` is the panel's actual set of interfaces; `desired_ifaces` is only the ones with settings still
    # to apply. Reading the sparse map as the owned set meant an interface whose settings were all in sync was
    # invisible here — so the one thing this function exists for (a live device we hold no conf for) was never
    # healed unless it happened to have a pending override. Older panels send no `owned`; fall back to the old
    # source so their behaviour is unchanged.
    want = set(owned) if owned else set(desired_ifaces or {})
    have = set((node_cfg.get("interfaces") or {}).keys())
    gap = want - have
    if not gap:
        return {}
    # NOT via iface_candidates(): that list exists for ADOPTION and deliberately drops every name starting
    # with "swg_" — an interface the panel itself created is not a foreign device for an operator to classify.
    # But those are precisely the interfaces that land here, so reusing it healed exactly nothing. Ask the
    # datapath instead: the running device is the authority on what is live on this box.
    owned = set()
    with contextlib.suppress(Exception):
        owned |= set(_wdtt_load() or {})          # a WDTT server owns its interface — not ours to adopt
    with contextlib.suppress(Exception):
        owned |= set(_csqtt_load() or {})         # nor a csqtt server's raw TUN
    with contextlib.suppress(Exception):
        for _pid, _fl in _wdtt_procs():           # including a FOREIGN server's, which writes no record here
            owned.add(_wdtt_iface_of(_fl))
    out = {}
    for tool in (["awg"], ["wg"]):                # awg first: an amneziawg device answers only to awg
        with contextlib.suppress(Exception):
            r = run(_wgcmd(tool) + ["show", "interfaces"])
            if r.returncode != 0:
                continue
            for n in (r.stdout or "").split():
                if n not in gap or n in owned or n in out:
                    continue
                # Genuinely UP only. A device an operator took down is a decision of theirs, not damage to
                # repair, and a wg device reports state UNKNOWN when up — so read the flags, not the state.
                flags = ""
                with contextlib.suppress(Exception):
                    flags = (run(["ip", "-o", "link", "show", n]).stdout or "").split(">")[0]
                if "UP" not in flags:
                    continue
                out[n] = {"cmd": list(tool), "conf": ""}
    return out


def onboard_ifaces(node_cfg, onboard):
    """Add panel-requested interfaces to this node's managed set (config.json) when they exist
    locally — for a wg/awg interface the panel didn't auto-detect. Once added, build_snapshot
    reports it and the panel closes the request (no separate ack needed). Only ever on a 200."""
    res = {"added": [], "errors": []}
    if not onboard:
        return res
    ifaces = node_cfg.setdefault("interfaces", {})
    changed = False
    for iface, want in onboard.items():
        if iface in ifaces:                 # already managed — nothing to do (panel will clear it)
            continue
        cmd = want.get("cmd") or ["awg"]
        conf = want.get("conf") or ""
        try:
            _asked = conf
            if not conf or not os.path.exists(conf):
                # No readable .conf (a docker node cannot see the host's) — rebuild it from the live device.
                conf = _reconstruct_conf(iface, cmd if cmd != ["auto"] else ["awg"]) or \
                       (_reconstruct_conf(iface, ["wg"]) if cmd == ["auto"] else "")
                if not conf:
                    res["errors"].append(f"{iface}: no config on disk and the live interface couldn't be read"); continue
                # Which source won is not a detail: adopting from the device keeps the keys, peers, ports and
                # AWG params, but any DNS / Table / PostUp the operator had in that file is NOT on the device
                # and does not survive. Saying so beats a silent substitution — the operator supplied a path
                # and is entitled to know it was not the one used.
                if _asked:
                    res.setdefault("notes", []).append(
                        f"{iface}: couldn't read {_asked} — adopted from the live interface instead "
                        f"(keys, peers and ports kept; any DNS/Table/PostUp lines in that file are not)")
                    print(f"onboard: {iface}: {_asked} unreadable — rebuilt from the live device", flush=True)
            if cmd == ["auto"]:                     # "Existing" gave no protocol — detect it from the conf
                info = parse_interface_section(open(conf).read())
                cmd = ["awg"] if any(k in info for k in AWG_KEYS) else ["wg"]
                try:
                    run(cmd + ["show", iface, "dump"])
                except Exception:
                    cmd = ["wg"] if cmd == ["awg"] else ["awg"]   # fall back to the other tool
            run(cmd + ["show", iface, "dump"])      # raises if the interface isn't actually up
        except Exception as e:
            res["errors"].append(f"{iface}: {e}"); continue
        ifaces[iface] = {"cmd": cmd, "conf": conf, "onboarded": True}   # add-only: never wipe its peers
        try:                                            # persist the markers in the conf so a docker restart
            with open(conf) as _f: _t = _f.read()       # (config.json rebuilt from confs) keeps it add-only
            _pre = "" if "#swg:onboarded" in _t else "#swg:onboarded\n"
            # …and which protocol it is. This conf is the OPERATOR's file, adopted where it lies, so unlike
            # the rebuilt one (see _reconstruct_conf) nothing has stamped it. Its directory is not evidence:
            # a container writes every conf to the AmneziaWG dir, so an adopted plain-WireGuard interface
            # that goes through a convert or a run-model switch comes back up as `awg` — node-entrypoint's
            # add_iface falls back to location precisely when this line is missing. backfill_cmd_markers
            # would stamp it, but only at the NEXT node start, and a convert need not include one.
            if "#swg:cmd" not in _t.split("[Interface]")[0]:
                _pre += "#swg:cmd " + (cmd[0] if cmd else "awg") + "\n"
            if _pre:
                with open(conf, "w") as _f: _f.write(_pre + _t)
        except OSError:
            pass
        changed = True
        res["added"].append(iface)
    if changed:
        try:
            _persist_config(node_cfg)
        except Exception as e:
            res["errors"].append(f"persist config.json: {e}")
    return res


def restart_ifaces(node_cfg, restart, agent, sudo):
    """Bounce panel-requested interfaces (<tool>-quick down/up) via swg-agent — recovers a DOWN one."""
    res = {"restarted": [], "errors": []}
    for iface in (restart or []):
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        r = run_agent(agent, sudo, {"op": "restart-iface", "iface": iface})
        if r.get("ok"):
            res["restarted"].append(iface); _set_iface_stopped(iface, False)   # a restart brings it back up
        else:
            res["errors"].append(f"{iface}: {r.get('error')}")
    return res


# interfaces the operator deliberately stopped from the panel → reported as "stopped" (not "down": it's a
# choice, not a failure). Persisted so it survives a daemon restart. Cleared when the interface is started.
IFACE_STOPPED_FILE = os.path.join(STATE_DIR, "iface-stopped.json")
def _load_stopped_ifaces():
    try:
        with open(IFACE_STOPPED_FILE) as f:
            v = json.load(f)
        return set(v) if isinstance(v, list) else set()
    except Exception:
        return set()
def _set_iface_stopped(iface, stopped):
    s = _load_stopped_ifaces()
    if (iface in s) == bool(stopped):
        return
    s.add(iface) if stopped else s.discard(iface)
    with contextlib.suppress(Exception):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = IFACE_STOPPED_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(sorted(s), f)
        os.replace(tmp, IFACE_STOPPED_FILE)


def stop_ifaces(node_cfg, stop, agent, sudo):
    """Stop panel-requested interfaces (down + disable, conf kept) — they stay down until started again."""
    res = {"stopped": [], "errors": []}
    for iface in (stop or []):
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        r = run_agent(agent, sudo, {"op": "stop-iface", "iface": iface})
        if r.get("ok"):
            res["stopped"].append(iface); _set_iface_stopped(iface, True)   # mark as a deliberate stop, not a failure
        else:
            res["errors"].append(f"{iface}: {r.get('error')}")
    return res


def start_ifaces(node_cfg, start, agent, sudo):
    """Start panel-requested interfaces (up + enable)."""
    res = {"started": [], "errors": []}
    for iface in (start or []):
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        r = run_agent(agent, sudo, {"op": "start-iface", "iface": iface})
        if r.get("ok"):
            res["started"].append(iface); _set_iface_stopped(iface, False)   # no longer stopped
        else:
            res["errors"].append(f"{iface}: {r.get('error')}")
    return res


def apply_iface_keys(node_cfg, iface_key, agent, sudo):
    """Panel keypair requests per interface: 'rebaseline' overwrites the on-disk backup from the live
    conf (after an Adopt); 'restore' re-keys the interface from that backup + bounces it (a Restore)."""
    res = {"done": [], "errors": []}
    for iface, req in (iface_key or {}).items():
        ic = (node_cfg.get("interfaces") or {}).get(iface)
        if not ic:
            continue
        action = (req or {}).get("action")
        cmd = _wgcmd(ic.get("cmd", ["awg"]))
        try:
            if action == "rebaseline":
                conf_text = ""
                with contextlib.suppress(OSError):
                    conf_text = open(ic["conf"]).read()
                rec = harvest_iface_backup(conf_text, cmd) if conf_text else None
                if rec:
                    write_iface_backup(iface, rec); res["done"].append(iface)
            elif action == "restore":
                bak = read_iface_backup(iface) or {}
                # ⚠️ THE VAULT FIRST (T-22 ②). Reverting from the on-disk backup is right after a hand
                # re-key on this box and USELESS after a migration, where the backup is the freshly minted
                # key and restoring it is a no-op. When the panel relays a sealed copy, that is the ORIGINAL
                # identity and it wins; the backup stays the fallback for the same-box case.
                priv = ""
                if (req or {}).get("sealed_key"):
                    with contextlib.suppress(Exception):
                        priv = ivk_unseal(transport_priv(), req["sealed_key"]).decode().strip()
                    if not priv:
                        res["errors"].append(iface + ": the relayed key could not be unsealed on this node"); continue
                if not priv:
                    priv = (bak.get("private_key") or "").strip()
                if not priv:
                    res["errors"].append(iface + ": no keypair backup to restore from"); continue
                r = run_agent(agent, sudo, {"op": "restore-iface-key", "iface": iface, "conf": ic["conf"],
                                            "private_key": priv, "listen_port": bak.get("listen_port"),
                                            "address": bak.get("address")})
                if r.get("ok"):
                    res["done"].append(iface)
                    # …and re-baseline, so the on-disk backup stops disagreeing with the identity that is
                    # now live. Without this the box keeps a backup of the key we just replaced, and the
                    # NEXT restore would revert to it — the very trap this branch exists to escape.
                    with contextlib.suppress(Exception):
                        _ct = ""
                        with contextlib.suppress(OSError):
                            _ct = open(ic["conf"]).read()
                        _rec = harvest_iface_backup(_ct, cmd) if _ct else None
                        if _rec:
                            write_iface_backup(iface, _rec)
                else:
                    res["errors"].append(iface + ": " + str(r.get("error")))
        except Exception as e:
            res["errors"].append(iface + ": " + str(e))
    return res


def _persist_config(node_cfg):
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(node_cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


# ── panel address auto-repoint (pin-gated) + opportunistic cert-pin adoption ──────────────────────────────
# The panel serves its canonical URL + cert fingerprint in every sync. On a change of the panel host/port an
# ONLINE node re-points itself — but ONLY after proving the new address presents the SAME identity we already
# trust (pinned cert / CA), so a MITM (or a stolen token feeding a bogus URL) can never redirect a node.

def _host_is_internal(host):
    """A compose/loopback/private address whose link to the panel is INDEPENDENT of the public address — the
    master's local node (docker: 'swg-panel', bare-metal: localhost) must never auto-repoint on a public change."""
    h = (host or "").strip().lower().strip("[]")
    if not h:
        return True
    if h == "localhost" or h.startswith("127.") or h == "::1":
        return True
    if "." not in h and ":" not in h:                      # single-label hostname (e.g. compose service 'swg-panel')
        return True
    if h.startswith(("10.", "192.168.", "169.254.")):
        return True
    if h.startswith("172."):
        try:
            return 16 <= int(h.split(".")[1]) <= 31
        except Exception:
            return False
    if h.startswith(("fc", "fd", "fe80")):                 # v6 ULA / link-local
        return True
    return False

def _norm_url(u):
    """scheme://host[:port][/path] with default ports dropped + trailing slash trimmed — so we don't churn on
    cosmetic differences, but DO distinguish a reverse-proxy mount-PATH change (/swg vs /panel is a real address
    change nodes must follow, not cosmetic)."""
    try:
        p = urllib.parse.urlparse(u if "://" in (u or "") else "https://" + (u or ""))
        host = p.hostname or ""
        default = 443 if p.scheme == "https" else 80
        port = p.port or default
        netloc = host if port == default else (("[%s]:%d" % (host, port)) if ":" in host else "%s:%d" % (host, port))
        return "%s://%s%s" % (p.scheme, netloc, (p.path or "").rstrip("/"))
    except Exception:
        return (u or "").rstrip("/")

def _verify_panel(base_url, token, panel):
    """True iff the panel at base_url answers /api/node/whoami with our token UNDER OUR CURRENT TLS POSTURE
    (existing pin / CA verify). This is the gate that stops a MITM from redirecting us."""
    try:
        st, _d, _h = _panel_get(base_url.rstrip("/") + "/api/node/whoami", token, panel, timeout=8)
        return st == 200
    except Exception:
        return False

def _persist_panel_url(node_cfg, new_url):
    """Persist a re-point. config.json is authoritative for bare-metal + the running process; the STATE_DIR copy
    survives a docker container recreate (node-entrypoint reads it ahead of the .env PANEL_URL)."""
    node_cfg.setdefault("panel", {})["url"] = new_url
    _persist_config(node_cfg)
    with contextlib.suppress(Exception):
        tmp = os.path.join(STATE_DIR, "panel-url.tmp")
        with open(tmp, "w") as f:
            f.write(new_url + "\n")
        os.replace(tmp, os.path.join(STATE_DIR, "panel-url"))


def _persist_panel_auth(panel):
    """Mirror the CREDENTIAL and TLS posture beside the learned URL, for the same reason the URL is
    mirrored — and it is the same three lines because it is the same failure.

    ⚠️ Measured by reading `docker/node-entrypoint.sh`, which is the bootstrap on BOTH the container arm
    and the NixOS native arm: it regenerates /etc/swg-agent/config.json from the environment on every
    start and honours exactly ONE self-learned value, `panel-url`. An address swap only ever changes the
    URL, so that was enough. A TRANSFER changes the token — and can change the posture — so a container
    recreate (or a nixos-rebuild) would put the OLD panel's token back and the node would 401 against the
    new one for ever, while the panel that sent it reported a completed transfer.

    Written 0600: `panel-token` is a working credential."""
    for name, val in (("panel-token", panel.get("token") or ""),
                      ("panel-verify", "yes" if panel.get("verify") else "no"),
                      ("panel-fp", (panel.get("fingerprint") or ""))):
        with contextlib.suppress(Exception):
            path = os.path.join(STATE_DIR, name)
            if not val:
                with contextlib.suppress(OSError):
                    os.unlink(path)
                continue
            tmp = path + ".tmp"
            with open(tmp, "w") as f:
                f.write(val + "\n")
            os.chmod(tmp, 0o600)
            os.replace(tmp, path)


# The pending reverse-proxy address swap's CANDIDATE — the NEW address the panel is advertising ALONGSIDE our blessed
# one while the operator re-points the proxy (external: full new URL via panel_url_next; internal: the new listen port
# via panel_local_port). We keep dialing blessed; if it stops answering (proxy flipped old→new, or confirm dropped the
# old), we settle onto this. Kept OUT of config.json (a transient) + mirrored to a file so an external node — which has
# no loopback _heal backstop — survives a restart mid-swap. Cleared once no swap is pending or the candidate is adopted.
_SWAP = {"cand": ""}
def _persist_candidate(cand):
    _SWAP["cand"] = cand or ""
    try:
        path = os.path.join(STATE_DIR, "panel-url-cand")
        if cand:
            with open(path + ".tmp", "w") as f:
                f.write(cand + "\n")
            os.replace(path + ".tmp", path)
        else:
            with contextlib.suppress(OSError):
                os.unlink(path)
    except Exception:
        pass

def _learn_candidate(panel, reply):
    """From a valid sync, remember (don't yet switch to) the new address the panel is advertising. A co-located
    loopback node that can STILL dial the panel on loopback follows the listen PORT (+ mount base) via
    panel_local_port. But when the panel is direct-TLS / bound to a public IP, panel_local_port is None (loopback no
    longer reaches it) — so even a co-located node learns the PUBLIC url (panel_url_next before confirm, panel_url
    after), following the panel to its public hostname. External nodes always learn the public url. Cleared when the
    panel advertises no new address."""
    try:
        cur = (panel.get("url") or "").rstrip("/")
        cu = urllib.parse.urlparse(cur if "://" in cur else "https://" + cur)
        cur_host = cu.hostname
        _h = (cur_host or "").lower().strip("[]")
        lp = reply.get("panel_local_port")
        loopback_node = _host_is_internal(cur_host) and (_h == "localhost" or _h.startswith("127.") or _h == "::1")
        cand = ""
        if loopback_node and lp:
            # co-located loopback node, panel STILL loopback-reachable → follow the internal port AND mount base
            # directly (bypasses any proxy). A PENDING path swap carries the NEW base in panel_url_next's path (the
            # LIVE panel_base is still the OLD one until confirm); once confirmed panel_url_next clears + panel_base
            # holds the new base.
            cur_port = cu.port or (443 if cu.scheme == "https" else 80)
            cur_base = (cu.path or "").rstrip("/")
            nxt = (reply.get("panel_url_next") or "").strip()
            if nxt:
                new_base = urllib.parse.urlparse(nxt if "://" in nxt else "https://" + nxt).path.rstrip("/")
            else:
                pb = reply.get("panel_base")
                new_base = (pb if pb is not None else cur_base).rstrip("/")
            if int(lp) != cur_port or new_base != cur_base:
                cand = "%s://%s:%d%s" % (cu.scheme, cur_host, int(lp), new_base)
        else:
            # external node — OR a co-located node whose panel went direct-TLS / public (no usable loopback port, so it
            # must move to the public hostname). Candidate = the pending swap's next-url (before confirm) OR the
            # advanced canonical url — kept alive until this node actually sits on it, so a blessed-address death
            # right at/after confirm still has a fail-over target.
            nxt = (reply.get("panel_url_next") or "").strip().rstrip("/")
            can = (reply.get("panel_url") or "").strip().rstrip("/")
            if nxt and _norm_url(nxt) != _norm_url(cur):
                cand = nxt
            elif can and _norm_url(can) != _norm_url(cur):
                cand = can
        if _norm_url(cand) != _norm_url(_SWAP.get("cand") or ""):
            _persist_candidate(cand)
    except Exception as e:
        print("_learn_candidate:", e, flush=True)

def _failover_candidate(panel, node_cfg):
    """Our blessed panel address stopped answering while a swap is pending → settle onto the learned candidate if it
    now answers as the same panel (operator flipped the proxy to the new address, or confirmed the swap so the old was
    dropped). Verified with our OWN trust anchor — a wrong/hostile address can't capture us. Returns the new sync url
    if it moved, else None. This is what makes confirm land the node on the new address, cancel keep it on the old."""
    try:
        cand = (_SWAP.get("cand") or "").rstrip("/")
        cur = (panel.get("url") or "").rstrip("/")
        if not cand or _norm_url(cand) == _norm_url(cur):
            return None
        if _verify_panel(cand, panel.get("token") or "", panel):
            panel["url"] = cand
            _persist_candidate("")
            _persist_panel_url(node_cfg, cand)
            print(f"blessed panel address stopped answering — failed over to {cand} (verified same identity)", flush=True)
            return cand.rstrip("/") + "/api/node/sync"
    except Exception as e:
        print("_failover_candidate:", e, flush=True)
    return None


# ── T-10: a TRANSFER to another panel ────────────────────────────────────────────────────────────
# Not the same thing as the address swap above, and deliberately not folded into it. That one follows ONE
# panel to a new address with OUR token under OUR trust anchor. This one hands us to a DIFFERENT panel: a
# different token, a different certificate, a different fleet.
#
# ⚠️ IT IS A CANDIDATE, NOT A SWITCH. The blessed panel stays blessed and keeps getting our snapshots the
# whole time. We promote only once the far panel answers `whoami` with the token it sent, so a wrong or
# unreachable target costs a wait rather than a server — the operator's panel reports "did not re-point"
# instead of discovering later that a node has vanished into nowhere. `_verify_panel` is untouched: its
# threat is a URL we found OURSELVES, and this one arrives inside the blessed panel's authenticated reply
# from a panel that already dictates our entire desired peer set.
# Interfaces the panel asked us to restore and whose ORIGINAL key only the operator vault can supply, so
# we are waiting rather than minting a stranger (T-22). Reported every snapshot: "missing on the node" is
# the label the panel would otherwise show, and it would send the operator looking for a fault instead of
# for their vault password.
_AWAIT_KEY = set()

_XFER_PATH = os.path.join(STATE_DIR, "panel-transfer.json")
_XFER = {"cand": None}


def _load_transfer():
    """The pending candidate, re-read at startup — a transfer must survive a restart mid-flight, the same
    property the address-swap candidate has and for the same reason (an external node has no loopback
    backstop to fall back on)."""
    try:
        with open(_XFER_PATH) as f:
            d = json.load(f)
        if isinstance(d, dict) and d.get("url") and d.get("token"):
            _XFER["cand"] = d
    except Exception:
        pass


def _persist_transfer(cand):
    _XFER["cand"] = cand or None
    try:
        if cand:
            tmp = _XFER_PATH + ".tmp"
            with open(tmp, "w") as f:
                json.dump(cand, f)
            os.chmod(tmp, 0o600)                       # it holds a token for the far panel
            os.replace(tmp, _XFER_PATH)
        else:
            with contextlib.suppress(OSError):
                os.unlink(_XFER_PATH)
    except Exception as e:
        print("_persist_transfer:", e, flush=True)


def _learn_transfer(panel, reply):
    """Remember (do NOT switch to) a transfer candidate the blessed panel is advertising. Cleared the
    moment it stops advertising one — an operator who cancels the transfer on the panel must not leave a
    node quietly holding another fleet's credential."""
    try:
        t = reply.get("transfer") if isinstance(reply.get("transfer"), dict) else None
        cand = None
        if t and (t.get("url") or "").strip() and (t.get("token") or "").strip():
            cand = {"url": (t.get("url") or "").strip().rstrip("/"),
                    "token": (t.get("token") or "").strip(),
                    "fp": (t.get("fp") or "").replace(":", "").lower().strip(),
                    "verify": bool(t.get("verify"))}
            if _norm_url(cand["url"]) == _norm_url((panel.get("url") or "").rstrip("/")):
                cand = None                            # "transfer to where we already are" is a no-op
        if (cand or {}).get("url") != (_XFER["cand"] or {}).get("url") or \
           (cand or {}).get("token") != (_XFER["cand"] or {}).get("token"):
            _persist_transfer(cand)
    except Exception as e:
        print("_learn_transfer:", e, flush=True)


def _promote_transfer(panel, node_cfg):
    """Try to move to the transfer candidate. Returns the new sync url if we moved, else None.

    VERIFIED-THEN-PINNED, in that order:

      1. a CA-verified `whoami` with the far panel's token. If that answers, the address is who it says it
         is by public trust and we need no pin at all.
      2. otherwise a `whoami` pinned to the certificate FINGERPRINT PANEL A SAW when it pushed the bundle.
         Self-signed is the normal case for this project, and this is strictly stronger than the trust-on-
         first-use the installer does: the identity was fixed by a party we already trust, before we dialled.

    Anything else and we stay exactly where we are. A candidate is never "tried until it works": each pass
    is one cheap GET, and the panel that offered it is the one that reports the wait."""
    cand = _XFER["cand"]
    if not cand:
        return None
    url, token = cand["url"], cand["token"]
    posture = None
    if _verify_panel(url, token, {"verify": True}):
        posture = {"verify": True, "fingerprint": ""}
    elif cand.get("fp") and _verify_panel(url, token, {"fingerprint": cand["fp"]}):
        posture = {"verify": False, "fingerprint": cand["fp"]}
    if posture is None:
        return None
    panel["url"] = url
    panel["token"] = token
    panel["verify"] = posture["verify"]
    if posture["fingerprint"]:
        panel["fingerprint"] = posture["fingerprint"]
    else:
        panel.pop("fingerprint", None)
    _persist_transfer(None)
    _persist_candidate("")                             # an address swap from the OLD panel is meaningless now
    _persist_panel_url(node_cfg, url)
    _persist_panel_auth(panel)
    how = "CA-verified" if posture["verify"] else "pinned to the certificate the previous panel saw"
    print("transferred to %s (%s) — syncing there from now on" % (url, how), flush=True)
    return url.rstrip("/") + "/api/node/sync"


def apply_panel_hints(panel, node_cfg, reply):
    """On a VALID sync: (1) opportunistically adopt a cert pin if we're currently UNVERIFIED (TOFU upgrade over an
    already-unverified channel — strictly better); (2) re-point to a new panel URL, pin-gated. Returns the new
    sync URL to dial if it changed, else None. Never throws (a hiccup must not break the sync loop)."""
    try:
        p_url = (reply.get("panel_url") or "").strip().rstrip("/")
        cur_fp = (panel.get("fingerprint") or "").replace(":", "").lower().strip()
        verified = bool(panel.get("verify", False) or cur_fp)
        # NOTE: no server-driven pin adoption. The panel reports its ORIGIN cert fp, but a node behind a
        # TLS-terminating proxy (Cloudflare) sees the PROXY's cert — adopting the panel-reported fp would
        # pin the wrong cert and fail closed. Pinning belongs at install (Phase 1), where the installer
        # captures the cert the NODE actually sees. Here we only re-point, gated by the EXISTING trust anchor.
        # (a) LEARN the pending-swap candidate every valid sync (internal: new port; external: new url). We do NOT
        # switch to it here — we keep dialing blessed and fail over only if blessed stops answering (see
        # _failover_candidate). This is what keeps a node on BOTH addresses during the transition, settling on the
        # survivor: confirm drops the old → blessed dies → fail over to new; cancel drops the new → blessed lives on.
        _learn_candidate(panel, reply)
        # (a2) …and the TRANSFER candidate, which is a different panel rather than a different address for
        # this one. Learned here and promoted by the caller, so the whole "where do we sync" decision stays
        # in one place instead of being made twice with two different notions of what is blessed.
        _learn_transfer(panel, reply)
        # (b) CANONICAL adopt: the panel's CONFIRMED dial url advanced. Internal links never adopt the public url
        # (meaningless to a co-located node — they follow the listen PORT via the candidate path). An EXTERNAL node
        # adopts it once it verifies as the same panel — the graceful path when the old address still serves at confirm.
        if p_url:
            cur = (panel.get("url") or "").rstrip("/")
            cur_host = urllib.parse.urlparse(cur if "://" in cur else "https://" + cur).hostname
            if _norm_url(p_url) != _norm_url(cur) and not _host_is_internal(cur_host):
                if not verified:
                    print(f"panel moved to {p_url}, but this node is unverified — re-point it manually "
                          f"(set panel.url in {CONFIG_PATH} + restart)", flush=True)
                elif _verify_panel(p_url, panel.get("token") or "", panel):
                    panel["url"] = p_url
                    _persist_candidate("")   # canonical arrived → the swap is done, drop any candidate
                    _persist_panel_url(node_cfg, p_url)
                    print(f"panel address changed → re-pointed to {p_url} (verified same identity)", flush=True)
                    return p_url.rstrip("/") + "/api/node/sync"
                else:
                    print(f"panel says it moved to {p_url}, but that address doesn't present our trusted cert yet "
                          f"— staying on {cur}", flush=True)
    except Exception as e:
        print("apply_panel_hints:", e, flush=True)
    return None


_LOCAL_HEAL = {"at": 0.0}
def _heal_local_panel(panel, node_cfg):
    """A CO-LOCATED node (loopback panel URL, e.g. a bare-metal master's local node) can't learn a new panel port
    via sync — its link is refused, so it never receives the panel_url hint. When a LOOPBACK sync fails, rediscover
    the panel locally: read its bind port from the standard settings file, else probe common ports, and re-point.
    No MITM risk on loopback. Docker masters use a stable internal link (swg-panel:8443) that never breaks, so this
    only ever fires bare-metal. Returns the new sync URL if it moved, else None."""
    try:
        cur = (panel.get("url") or "").rstrip("/")
        u = urllib.parse.urlparse(cur if "://" in cur else "https://" + cur)
        host = (u.hostname or "").lower()
        if not (host == "localhost" or host.startswith("127.") or host == "::1"):
            return None                                  # not a loopback link → the sync-response repoint handles it
        now = time.time()
        if now - _LOCAL_HEAL["at"] < 30:                 # cooldown — don't rescan every failed 5s sync
            return None
        _LOCAL_HEAL["at"] = now
        scheme = u.scheme or "https"
        cur_port = u.port or (443 if scheme == "https" else 80)
        cur_base = (u.path or "").rstrip("/")                # keep the reverse-proxy mount path (e.g. /swg) — a subpath panel answers there, not at root
        token = panel.get("token") or ""
        candidates = [443, 8443, 2053, 2083, 2087, 2096, 80, 8080, 8000, 9443]
        bases = [cur_base]
        for sp in ("/var/lib/swg-panel/panel-settings.json", "/etc/swg-panel/panel-settings.json"):
            try:
                _acc = (((json.load(open(sp)) or {}).get("access") or {}).get("panel") or {})
                pp = int(_acc.get("port") or 0)
                if pp and pp not in candidates:
                    candidates.insert(0, pp)             # the exact configured port → covers a non-standard one
                sb = urllib.parse.urlparse(str(_acc.get("url") or "")).path.rstrip("/")   # the configured mount base → covers a PATH change (/swg → /panel)
                if sb not in bases:
                    bases.insert(0, sb)
                break
            except Exception:
                pass
        for base in bases:                               # try the configured base first, then the one we were on
            for port in candidates:
                if port == cur_port and base == cur_base:
                    continue
                probe = "%s://%s:%d%s" % (scheme, host, port, base)
                if _verify_panel(probe, token, panel):
                    panel["url"] = probe
                    _persist_candidate("")
                    _persist_panel_url(node_cfg, probe)
                    print(f"panel not reachable at {cur} — rediscovered it locally at {probe}, re-pointed", flush=True)
                    return probe.rstrip("/") + "/api/node/sync"
    except Exception as e:
        print("_heal_local_panel:", e, flush=True)
    return None


def create_ifaces(node_cfg, create, agent, sudo):
    """Create panel-requested BRAND-NEW interfaces via swg-agent (genkey + conf + auto-NAT + bring-up),
    then start managing them (config.json). Only on a valid sync. Bring-up runs live — verify on one
    node. Native datapath: kernel on a bare-metal node, container-userspace on a docker node."""
    res = {"created": [], "errors": []}
    if not create:
        return res
    ifaces = node_cfg.setdefault("interfaces", {})
    changed = False
    _live = None                            # datapath asked at most once per pass, and only if we need it
    for iface, want in create.items():
        if iface in ifaces:
            # Already ours. Normally this is just the panel not having seen our report yet — say nothing.
            if _live is None:
                _live = _live_wg_ifaces()
            if iface in _live:
                continue
            # WE HOLD A RECORD FOR A DEVICE THAT IS NOT ON THIS BOX. This used to decline with advice —
            # "Restore it (that reuses its original server key)" — naming an op that cannot do it:
            # restore-iface-key EDITS an existing conf, and in this state the conf is exactly what is gone.
            # So the panel asked every five seconds for ever and the interface stayed dead (measured live,
            # §7.5 of the rebuild plan: a damaged interface was unrepairable from any direction).
            #
            # A RESTORE request is the operator asking for precisely this, and it is safe to honour: the
            # stale record is a pointer to a conf that no longer exists, and the ORIGINAL key comes back
            # from the on-disk backup a few lines below — which is untouched here, because it is the thing
            # the restore reads. Drop the dead record and fall through to the create.
            #
            # Without `restore` we still decline: a plain create would mint a NEW server key under a name
            # whose clients are all configured against the old one, and that stays a decision, not a
            # side effect.
            if not want.get("restore"):
                res["errors"].append(
                    f"{iface}: this node already has a record for {iface} but no such interface exists here — "
                    f"it cannot be created again under that name. Restore it (that reuses its original server "
                    f"key, so existing clients keep working), or delete it and create it under a free name.")
                continue
            # ...including a conf left behind by whatever killed the device. `create-iface` refuses to
            # write over an existing conf ("exists"), so without this the two damage shapes diverge:
            # device+conf gone repairs, device-gone-conf-left does not — and the second would end up
            # WORSE than it started, record dropped and create refused. The path we remove is the one
            # THIS node recorded for THIS managed interface, its device is not running, and the operator
            # has asked for the restore; the key backup, which is what the restore actually reads, is
            # never touched.
            _stale = (ifaces.get(iface) or {}).get("conf")
            if _stale and os.path.exists(_stale):
                with contextlib.suppress(OSError):
                    os.unlink(_stale)
            print("create: %s is recorded here but its device is gone — dropping the stale record and "
                  "restoring it with its original key" % iface, flush=True)
            ifaces.pop(iface, None)
            changed = True
        elif iface.startswith("swg_"):
            # A MESH LINK we do not manage, whose conf is nevertheless on disk: the leftover of an earlier
            # create that wrote the conf and then failed to bring the device up (a re-enrolled box whose
            # /31 was still held by the previous panel's link, say). `create-iface` refuses to write over an
            # existing conf, so the retry failed on "already exists" from then on — the address conflict
            # cleared and the link still never came up. Only `swg_*`: those are the panel's own plumbing,
            # created by nobody else, and it is asking for this one right now. A USER interface with a conf
            # we do not manage is an adoption candidate — a decision, and emphatically not ours to delete.
            if _live is None:
                _live = _live_wg_ifaces()
            _orphconf = "" if iface in _live else _cand_conf(iface)
            if _orphconf:
                with contextlib.suppress(OSError):
                    os.unlink(_orphconf)
                print("create: %s had a leftover conf and no device — removed it so the link can be "
                      "created" % iface, flush=True)
        cmd = want.get("cmd") or ["awg"]
        # RESTORE of a vanished interface: recreate it with its ORIGINAL server key so no client re-imports.
        # Key source, in order: a sealed_key the browser re-sealed to THIS node's transport key from the operator
        # vault (a full wipe — panel relayed only ciphertext); else the node's own on-disk backup. Absent both →
        # fall through to a brand-new genkey (agent side): a fresh identity.
        priv = (want.get("private_key") or "").strip()
        if not priv and want.get("sealed_key"):
            with contextlib.suppress(Exception):
                priv = ivk_unseal(transport_priv(), want["sealed_key"]).decode().strip()   # vault key, delivered sealed
        if not priv and want.get("restore"):
            priv = ((read_iface_backup(iface) or {}).get("private_key") or "").strip()
        # ⚠️⚠️ HOLD, DO NOT MINT (T-22). With `hold_key` the panel is saying: I hold escrow for this
        # interface's ORIGINAL identity, and only a browser can open it. Falling through to genkey here
        # invents a stranger — the interface comes up serving a key no client config names, and the escrow
        # that could have put the real one back is then unreachable, because the on-disk backup this node
        # writes is of the minted key. Measured on a real migration: both interfaces came back re-keyed on
        # the FIRST sync, before any operator could act.
        #
        # This is exactly what a WDTT server has always done with its own key_blob hold; it was never
        # extended to interfaces. Waiting costs an interface that stays DOWN until the vault is unlocked —
        # against one that is UP and unusable, and unrecoverable. The wait is the recoverable half.
        if not priv and want.get("hold_key"):
            _AWAIT_KEY.add(iface)
            print("create: %s HOLDING — the panel holds its escrowed key; unlock the vault and restore it "
                  "(minting here would re-key every client)" % iface, flush=True)
            continue
        _AWAIT_KEY.discard(iface)
        r = run_agent(agent, sudo, {"op": "create-iface", "iface": iface, "cmd": cmd,
                                    "subnet": want.get("subnet"), "listen_port": want.get("listen_port"),
                                    "address": want.get("address"),   # explicit addr (mesh /31 ends)
                                    "private_key": priv,               # blank => agent genkeys a new one
                                    "awg_params": want.get("awg_params"),   # restore: original obfuscation (else agent randomizes)
                                    "mtu": want.get("mtu")})
        if not r.get("ok"):
            # THE NAME IS TAKEN BY A DEVICE THAT IS ALREADY HERE. That is not a failure to report and retry
            # for ever — it is the interface the panel is asking for, already running, with the key its clients
            # use. It happens whenever the node's RECORD is lost while the datapath survives: a container
            # recreated, a run-model switched, a restored box. Creating over it is impossible (and would mint a
            # new key); the right answer is to take the live one back, which is exactly what the self-heal does
            # a few lines later in this same pass. Hand it that name instead of an error nobody can act on.
            if r.get("code") == "name_taken":
                if _live is None:
                    _live = _live_wg_ifaces()
                if iface in _live:
                    res.setdefault("heal", []).append(iface)
                    print("create: %s is already live here — adopting it back instead of recreating" % iface, flush=True)
                    continue
            res["errors"].append(f"{iface}: {r.get('error')}"); continue
        data = r.get("data") or {}
        conf = data.get("conf") or ""
        if not conf:
            res["errors"].append(f"{iface}: agent returned no conf path"); continue
        with contextlib.suppress(Exception):
            ensure_iface_backup(iface, open(conf).read(), cmd)   # (re)seed the key backup (no-op if it already exists)
        # the agent may have fallen back (e.g. wg→awg on a node with only amneziawg-go) — record the
        # tool it ACTUALLY used, or we'll later run the wrong CLI (`wg show`) and "can't read" it
        ifaces[iface] = {"cmd": data.get("cmd") or cmd, "conf": conf}
        changed = True
        res["created"].append(iface)
    if changed:
        try:
            _persist_config(node_cfg)
        except Exception as e:
            res["errors"].append(f"persist config.json: {e}")
    return res


def orphan_mesh_links(node_cfg, owned):
    """Mesh links (`swg_*`) we manage that the CURRENT panel does not claim — leftovers from a previous one.

    A mesh link belongs to whichever panel created it: the node never invents one. Two things leave one
    behind. The panel drops the link when its PEER NODE is deleted from the fleet — the ordinary path sends
    an explicit delete, and this is the backstop for when that request is missed. And re-pointing a node at a
    DIFFERENT panel (moving a box between fleets) leaves the old panel's links here for ever — no panel will
    ever mention them again, they keep the mesh /31 they were handed, and the NEW panel's link to the same peer
    then fails to come up ("RTNETLINK answers: Address already in use") on every reconcile, so the node can
    never mesh. The operator cannot clear it from the panel either: `swg_*` names are deliberately hidden from
    the adopt/candidate grids (they are the panel's own plumbing, not something to classify), so no control for
    it exists anywhere.

    `owned_ifaces` is the panel stating which interfaces are ITS OWN, so a `swg_*` in our managed set that it
    does not claim is, by construction, somebody else's. Guarded three ways, because acting on this deletes an
    interface: the key must be PRESENT (an older panel omits it — reap nothing), and non-empty (a panel that
    has lost its own record must not be able to tear the mesh down), and only `swg_*` names are considered —
    a USER interface the panel does not own is an adoption candidate, which is a different answer entirely.
    """
    if not isinstance(owned, list) or not owned:
        return []
    have = set(owned)
    ifaces = node_cfg.setdefault("interfaces", {})
    out = {n for n in ifaces if n.startswith("swg_") and n not in have}
    _added = False
    # …and the ones that are LIVE here but in no registry of ours. A RE-ENROLLED box gets a fresh config
    # whose `interfaces` map is empty, so the walk above sees nothing and this healed exactly nothing in the
    # case the docstring describes — moving a box between panels is precisely when its registry is new.
    # Measured on a migration test box: four leftover `swg_*` devices from earlier rounds, two of them
    # holding the very /31s the new links needed, and every reconcile failed "Address already in use" for
    # ever. Register what we find (tool + conf, as onboarding does) so the ordinary teardown can act: the
    # agent refuses to delete an interface that is not managed here, which is the guard that made the
    # simple "just list them" version a silent no-op.
    for _tool in (["awg"], ["wg"]):
        with contextlib.suppress(Exception):
            r = run(_wgcmd(_tool) + ["show", "interfaces"])
            if r.returncode != 0:
                continue
            for n in (r.stdout or "").split():
                if not n.startswith("swg_") or n in have or n in ifaces:
                    continue
                _cf = _cand_conf(n)
                if not _cf:
                    continue        # no conf to clean up: leave it rather than guess at what it is
                ifaces[n] = {"cmd": list(_tool), "conf": _cf}
                out.add(n)
                _added = True
    if _added:
        # PERSIST before the caller's teardown runs. swg-agent resolves "is this interface managed here?"
        # against the config ON DISK, not our in-memory copy, so registering without writing left it
        # refusing every delete ("interface 'swg_...' is not managed") while the reconcile that followed
        # had already started treating them as ours — peer removals against an interface nothing could act
        # on, once per pass, for ever.
        with contextlib.suppress(Exception):
            _persist_config(node_cfg)
    return sorted(out)


def delete_ifaces(node_cfg, delete, agent, sudo):
    """Tear down panel-requested interfaces (down + remove conf via swg-agent) and stop managing them.
    Only on a valid sync. The panel clears the request once the iface stops appearing in snapshots."""
    res = {"deleted": [], "errors": []}
    if not delete:
        return res
    ifaces = node_cfg.get("interfaces") or {}
    changed = False
    for iface in list(delete):
        if iface not in ifaces:             # already gone — panel clears it when the snapshot lacks it
            continue
        r = run_agent(agent, sudo, {"op": "delete-iface", "iface": iface})
        if not r.get("ok"):
            res["errors"].append(f"{iface}: {r.get('error')}"); continue
        ifaces.pop(iface, None)
        _adopted_ctr_forget(iface)
        changed = True
        res["deleted"].append(iface)
    if changed:
        try:
            _persist_config(node_cfg)
        except Exception as e:
            res["errors"].append(f"persist config.json: {e}")
    return res


# ── turn-proxy management (host systemd units) ──────────────────────────────────────────────────
# UNVERIFIED ON DOCKER: the bare-metal path edits units + systemctl directly; the docker path runs
# the same on the HOST via a privileged --pid=host helper through the mounted docker.sock (nsenter
# into PID 1). Test on a real node before relying on it. The socket = root-on-host (opt-in install).
HELPER_IMAGE = os.environ.get("HELPER_IMAGE") or "ghcr.io/sanityprotocol/swg-node:latest"
# ── where host systemd units go ─────────────────────────────────────────────────────────────────
# PROBED, never guessed from the distro. On a host that keeps its units in a read-only store —
# NixOS, and any other immutable-OS layout — /etc/systemd/system is a symlink into that store and
# refuses a write, while /run/systemd/system is tmpfs, sits in systemd's search path directly below
# it, and takes precedence over /usr/lib. Units written there are lost at reboot, which is fine:
# reconcile recreates them, and persisted interfaces come up from the node's own bootstrap.
#
# The probe goes through host_sh because host_sh is what WRITES the unit — on a docker node the
# directory that matters is the HOST's, not the container's.
UNIT_DIR_PERSIST = "/etc/systemd/system"
UNIT_DIR_RUNTIME = "/run/systemd/system"
_UNIT_DIR = {"dir": None, "persist": True, "asked": False}


def _probe_unit_dir():
    """Decide once, on first use.

    ⚠️ A REAL write probe, never os.access(..., W_OK) and never `[ -w ]`. As root those report a
    mode-555 directory WRITABLE, because root bypasses the mode check — measured on swgt. They do
    honour a read-only MOUNT (measured on the NixOS VM: `[ -w /etc/systemd/system ]` is false
    there), so on today's NixOS they happen to give the right answer — by accident of which
    mechanism that host uses, not because the check is sound. A write is the only thing that
    answers both. uninstall.sh's unit_dir_writable() is the same shape for the same reason.

    ⚠️ And "the probe failed" is not "the directory is read-only". A docker node with no socket
    (rc 126), a sudo that wants a password, a missing shell — all of those come back non-zero too,
    and concluding read-only from them would silently drop `systemctl enable` on a perfectly
    ordinary host, which loses every service at the next reboot. Only an explicit marker decides;
    anything else leaves the answer unresolved and today's behaviour in place.
    """
    if _UNIT_DIR["asked"]:
        return
    _UNIT_DIR["asked"] = True          # ONCE per process, whatever the answer — a probe that keeps
    _UNIT_DIR["dir"] = UNIT_DIR_PERSIST   # retrying is a sudo attempt (or a docker run) per call,
    #                                       which is the Z-12 shape: one repeating line, forever.
    probe = UNIT_DIR_PERSIST + "/.swg-noded-unit-probe"
    # The probe must say which of THREE things happened, because two of them are not "read-only":
    # a non-zero exit also comes back when the probe never ran at all — host_sh wraps in sudo when
    # we are not root, and a sudo that wants a password fails exactly like an EROFS write. Reading
    # that as "read-only" would quietly drop `systemctl enable` on an ordinary box and cost it
    # every service at the next reboot. So the shell prints which branch it took, and no marker
    # means we could not look.
    # ⚠️ The write goes in a SUBSHELL, exactly as uninstall.sh's unit_dir_writable() does it, and
    # that is not style. `:` is a POSIX SPECIAL built-in, so a redirection error on it makes the
    # SHELL EXIT — in dash, which is /bin/sh on Debian and Ubuntu. Inside `{ ...; }` that killed the
    # whole probe before either marker could be printed, and the answer came back "could not look"
    # on a host that is plainly read-only. Measured on the NixOS VM after I "tidied" the parentheses
    # into braces. The subshell contains the exit.
    w = host_sh("( : > " + shlex.quote(probe) + " ) 2>/dev/null"
                " && { rm -f " + shlex.quote(probe) + "; echo SWGUNITDIR-RW; }"
                " || echo SWGUNITDIR-RO")
    out = (w.stdout or "")
    if "SWGUNITDIR-RW" in out:
        _UNIT_DIR["dir"], _UNIT_DIR["persist"] = UNIT_DIR_PERSIST, True
        return
    if "SWGUNITDIR-RO" not in out:                # we could not look — keep today's behaviour
        if w.returncode != 126:                   # 126 already logged its own one-time notice
            print("units: could not probe %s (rc=%d) — assuming it is writable, which is what this "
                  "did before there was a probe" % (UNIT_DIR_PERSIST, w.returncode), flush=True)
        return
    host_sh("mkdir -p " + shlex.quote(UNIT_DIR_RUNTIME))
    _UNIT_DIR["dir"], _UNIT_DIR["persist"] = UNIT_DIR_RUNTIME, False
    print("units: %s is read-only on this host — writing to %s instead. Units there are recreated "
          "by reconcile after a reboot; interfaces come back from the node's own bootstrap."
          % (UNIT_DIR_PERSIST, UNIT_DIR_RUNTIME), flush=True)


def turn_unit_dir():
    _probe_unit_dir()
    return _UNIT_DIR["dir"] or UNIT_DIR_PERSIST


def unit_dir_persists():
    """True when a unit written here survives a reboot — i.e. when `systemctl enable` can work."""
    _probe_unit_dir()
    return bool(_UNIT_DIR["persist"])


def sc_enable_now(svc):
    """`systemctl enable --now <svc>` where units persist; plain `start` where they cannot.

    Measured on NixOS 26.05: `enable` fails with `…/multi-user.target.wants/…: Read-only file
    system` even for a unit living in /run — systemd resolves .wants into the SYSTEM scope wherever
    the unit itself sits. `start` works there.

    ⚠️ An early probe reported `enable` SUCCEEDING on a /run unit, and this nearly got deleted on
    the strength of it. That probe's unit had no [Install] section, so `enable` had nothing to link
    and returned 0 trivially. Do not re-derive this from a test that cannot fail.
    """
    return ("systemctl enable --now " if unit_dir_persists() else "systemctl start ") + shlex.quote(svc)


def sc_disable_now(svc):
    """The mirror of sc_enable_now — and on a read-only unit dir it is also what makes a FOREIGN
    server's take-over work at all (a hand-installed WDTT/csqtt server we are adopting): there
    `disable --now` fails before it ever reaches the stop, leaving the other server running and
    holding the port, while `stop` succeeds."""
    return ("systemctl disable --now " if unit_dir_persists() else "systemctl stop ") + shlex.quote(svc)
TURN_MANAGE_ON = (NODE_KIND != "docker") or ((os.environ.get("TURN_MANAGE") or "manual").strip().lower() == "panel")
NODE_PROGRESS = {} # request key (iface name / turn service) -> transient "what's happening right now" line
                   # (e.g. a slow GitHub download retrying) → cmd_progress on the snapshot → yellow card note.
NODE_ERRORS = {}   # request key (iface name / turn service / .service path) -> last apply error, reported
                   # in the snapshot ("cmd_errors") so the panel can show WHY a host->node command failed
NODE_NOTES = {}    # iface -> one-line note about HOW it was adopted (succeeded, but not from the named source);
                   # reported as "onboard_notes" and written to the activity log once by the panel

_HOST_SH_CAP = {"ok": None, "warned": False}


def _host_sh_available():
    """Can we reach the host at all? Bare-metal: always. Docker: only through the mounted socket.

    TURN_MANAGE=manual is the compose DEFAULT, so a node installed without the socket is the common
    case, not the exotic one — and every host_sh call there used to spawn a `docker run` that failed
    with "Cannot connect to the Docker daemon". The discovery scan runs on every reconcile, so that
    was a failing container launch and a log line every few seconds, forever. Answer the question
    once instead."""
    if NODE_KIND != "docker":
        return True
    if _HOST_SH_CAP["ok"] is None:
        _HOST_SH_CAP["ok"] = bool(shutil.which("docker")) and any(
            os.path.exists(p) for p in ("/var/run/docker.sock", "/run/docker.sock"))
    return _HOST_SH_CAP["ok"]


def host_sh(cmd, timeout=90):
    """Run a shell command on the HOST. Bare-metal: directly. Docker: via a one-shot privileged
    --pid=host helper through the mounted docker socket — nsenter into PID 1 so the command runs in
    the host's namespaces (its filesystem + systemd).

    Returns rc=126 without trying when there is no way to reach the host (see _host_sh_available).
    126 is deliberately distinct from the 125 docker itself returns and from a command's own 127:
    callers that today read an empty stdout as "the host has nothing" can tell "could not look"
    apart from "looked and found none"."""
    if not _host_sh_available():
        if not _HOST_SH_CAP["warned"]:
            _HOST_SH_CAP["warned"] = True
            print("host_sh: no docker socket on this node (TURN_MANAGE=manual) — host-side reads, "
                  "foreign-server discovery and unit management are unavailable; "
                  "further attempts are skipped silently", flush=True)
        class _R:
            returncode = 126; stdout = ""; stderr = "host_sh unavailable: no docker socket mounted"
        return _R()
    if NODE_KIND != "docker":
        args = ["sh", "-c", cmd] if os.geteuid() == 0 else ["sudo", "-n", "sh", "-c", cmd]
    else:
        # --entrypoint nsenter is REQUIRED: the swg-node image's entrypoint is node-entrypoint.sh
        # (it demands PANEL_URL + sets up wg) — passing nsenter as the command alone still runs it.
        #
        # Once inside the host's mount namespace the PATH we get is the host's, and on a
        # declaratively managed host (NixOS and friends) nothing we call is where a normal distro
        # puts it. Measured on NixOS 26.05: of the ten tools these commands actually invoke, NINE
        # were unreachable — cat, systemctl, ip, wg, tar, base64, chmod, mkdir, pgrep — leaving only
        # the shell builtin. The failure is quiet in the worst way: `sh -c` hands back the command's
        # own 127, so a missing binary is indistinguishable from "the operation failed".
        # Prefixing the system profile recovered all nine. Elsewhere the directory simply does not
        # exist, so this is inert. Prepended with a NEWLINE, not "; ", so a cmd that opens with a
        # comment or a heredoc is unaffected. Kept in its OWN variable so the failure logs below
        # still show the caller's command, not 47 characters of prefix.
        _wrapped = "export PATH=/run/current-system/sw/bin:$PATH\n" + cmd
        args = ["docker", "run", "--rm", "--privileged", "--pid=host", "--entrypoint", "nsenter",
                HELPER_IMAGE, "-t", "1", "-m", "-u", "-i", "-n", "-p", "--", "sh", "-c", _wrapped]
    try:
        r = run(args, timeout=timeout)
    except Exception as e:                              # e.g. 'docker' not found, or a timeout
        print("host_sh EXC: " + str(e) + " :: " + cmd[:160], flush=True)
        class _R:                                       # synthesize a failed result so callers see it
            returncode = 127; stdout = ""; stderr = str(e)
        return _R()
    if r.returncode != 0:
        print("host_sh rc=" + str(r.returncode) + " :: " + cmd[:160] + " :: " + (r.stderr or r.stdout or "")[:300], flush=True)
    return r

def _turn_unit_path(svc):
    return turn_unit_dir() + "/" + svc + ".service"

def _exec_of(unit_text):
    for ln in unit_text.splitlines():
        if ln.startswith("ExecStart="):
            return ln[len("ExecStart="):]
    return ""

def _exec_params(execl):
    """Everything after '-connect <ip:port>' in the ExecStart — the free-text extra flags (wrap etc.)."""
    m = re.search(r"-connect[ =]+\S+\s*(.*)$", execl)
    return (m.group(1).strip() if m else "")

def _parse_tp(svc, execl):
    def g(flag):
        m = re.search(r"-" + re.escape(flag) + r"[ =]+(\S+)", execl)
        return m.group(1) if m else ""
    return {"service": svc, "listen": g("listen"), "connect": g("connect"),
            "wrap_key": g("wrap-key") or g("obf-key") or g("password"), "params": _exec_params(execl)}   # free-turn = -obf-key, MYSOREZ = -password

def _installed_tp(svc):
    """Re-read a turn unit (after install/edit) so the record carries the real ExecStart, incl. the
    generated wrap key."""
    unit = host_sh("cat " + shlex.quote(_turn_unit_path(svc)) + " 2>/dev/null").stdout
    return _tp_from_unit(svc, unit)


# ───────── docker turn-proxies: sibling CONTAINERS (no host systemd, no --pid=host helper) ─────────
# A docker node runs each turn-proxy as its OWN container (swg-turn-<inst>, host networking) instead of
# editing host systemd through a privileged --pid=host nsenter helper. swg-noded fetches the fork binary
# into its host-mounted data dir and runs it in the swg-node image; a change = recreate the container
# (fast, no daemon-reload). TURN_RECORD is the source of truth for the config on a docker node.
SWG_HOST_NODE_DIR = (os.environ.get("SWG_HOST_NODE_DIR") or "").rstrip("/")   # host path mapped to /var/lib/swg-noded
SWG_TURN_IMAGE = os.environ.get("SWG_TURN_IMAGE") or ""                       # image used to run the turn binary
TURN_DOCKER = (NODE_KIND == "docker")

def _turn_inst(svc):  return svc[len("vk-turn-proxy-"):] if svc.startswith("vk-turn-proxy-") else svc
def _turn_fork(svc):  inst = _turn_inst(svc); return inst.rsplit("-", 1)[0] or inst   # <fork>-<port> → <fork> (handles hyphenated forks, e.g. WINGS-N)
def _turn_cname(svc): return "swg-turn-" + _turn_inst(svc)
# ONE binary per fork, not per instance: every WINGS-N-<port> instance shares …/turn/.bin/WINGS-N/server.
def _turn_bin_local(svc): return "/var/lib/swg-noded/turn/.bin/" + _turn_fork(svc) + "/server"   # inside swg-noded
def _turn_bin_host(svc):  return SWG_HOST_NODE_DIR + "/turn/.bin/" + _turn_fork(svc) + "/server"  # same file on the host (mounted into each instance's container)
def _turn_bin_local_legacy(svc): return "/var/lib/swg-noded/turn/" + _turn_inst(svc) + "/server"  # pre-dedup per-instance path (migrated on next download)
def _turn_fork_in_use(svc, rec):   # is any OTHER instance of this fork still in the record? (don't drop a shared binary others use)
    fork = _turn_fork(svc); items = rec.values() if isinstance(rec, dict) else (rec or [])
    return any(isinstance(tp, dict) and tp.get("service") and tp["service"] != svc and _turn_fork(tp["service"]) == fork for tp in items)

def _params_wrapkey(params):
    # the obfuscation secret each fork carries: free-turn = -obf-key, the vk-turn-proxy forks = -wrap-key,
    # MYSOREZ = -password (a passphrase HKDF'd to the AEAD key).
    m = re.search(r"-(?:wrap|obf)-key[ =]+(\S+)", params or "") or re.search(r"-password[ =]+(\S+)", params or "")
    return m.group(1) if m else ""
def _params_set_wrapkey(params, key):
    params = params or ""
    # rotate whichever obfuscation-key flag the unit already carries (free-turn-proxy = -obf-key,
    # the vk-turn-proxy forks = -wrap-key, MYSOREZ = -password); only fall back to appending -wrap-key on a keyless unit.
    if re.search(r"-obf-key[ =]+\S+", params):
        return re.sub(r"-obf-key[ =]+\S+", "-obf-key " + key, params)
    if re.search(r"-wrap-key[ =]+\S+", params):
        return re.sub(r"-wrap-key[ =]+\S+", "-wrap-key " + key, params)
    if re.search(r"-password[ =]+\S+", params):
        return re.sub(r"-password[ =]+\S+", "-password " + key, params)
    return (params + " -wrap-key " + key).strip()

def _dturn_args(tp):
    listen = tp.get("listen", "")
    if NODE_NET == "bridge" and ":" in listen:
        # the stored listen binds the node's public IP, which isn't assignable inside our container netns — bind all
        # interfaces on the same port and let docker publish it (compose ports:). connect stays 127.0.0.1 (our netns).
        listen = "0.0.0.0:" + listen.rsplit(":", 1)[1]
    args = ["-listen", listen, "-connect", tp.get("connect", "")]
    p = (tp.get("params") or "").strip()
    if p:
        try: args += shlex.split(p)
        except Exception: args += p.split()
    return args

def _turn_arch():
    # Canonical arch for the turn-proxy binary name (server-linux-<arch>). Report the TRUE arch for anything we
    # have no build for (raw uname -m) so the panel can tell an armv7l / i686 / riscv64 box apart from amd64 —
    # NEVER collapse the unknown to amd64 (that silently fetched a wrong x86-64 binary → 404 / "Exec format error").
    # Recognise every alias of a supported arch so a valid 64-bit box is never misread as unsupported.
    m = os.uname().machine
    if m in ("x86_64", "amd64"):   return "amd64"
    if m in ("aarch64", "arm64"):  return "arm64"
    return m or "amd64"            # unknown/empty → its own name (blank falls back to amd64: when unsure, allow)

def _turn_arch_ok():
    # The forks publish server-linux-amd64 + server-linux-arm64 ONLY — this is the single source of truth for
    # "can this box run a turn-proxy". If a fork ever ships more arches, widen this set (and TURN_ARCHES on the panel).
    return _turn_arch() in ("amd64", "arm64")

def _turn_dl_urls(owner, arch, tag=None):
    """GitHub release assets are single-origin (objects.githubusercontent.com). Try GitHub direct first, then
    any operator-configured proxy mirrors (SWG_TURN_MIRROR, space-separated prefixes — OPT-IN: proxying a binary
    you execute is a supply-chain trust decision, so it's off by default).
    When the panel supplies a release TAG (the checksum gate), pin the IMMUTABLE per-tag asset
    (releases/download/<tag>/…) instead of the moving 'latest' — so the bytes match the sha256 the panel hashed."""
    path = ("download/" + tag) if tag else "latest/download"
    base = "https://github.com/" + owner + "/releases/" + path + "/server-linux-" + arch
    urls = [base]
    for m in (os.environ.get("SWG_TURN_MIRROR") or "").split():
        urls.append(m.rstrip("/") + "/" + base)   # e.g. https://ghproxy.example/https://github.com/<owner>/releases/...
    return urls

def _turn_pin(pin):
    """(tag, expected_sha) from the panel-provided pin {tag, sums:{arch:sha}} for THIS node's arch. Pass the pin
    dict itself (req.get("pin")), not the whole request. Either value may be '' — a mixed-version panel or one
    that couldn't hash the asset sends no sha, and the node then proceeds UNVERIFIED (the pre-checksum-gate
    behaviour). A PRESENT sha is ENFORCED fail-closed: a downloaded binary that doesn't match is deleted and
    never chmod+exec'd. See docs/TURN-PROXY-OVERHAUL-PLAN.md (Axis 2 · P1)."""
    pin = pin or {}
    return (pin.get("tag") or ""), ((pin.get("sums") or {}).get(_turn_arch()) or "")

def _turn_sha_ok(path, want):
    """True if `path`'s sha256 == want, or want is empty (nothing to verify → caller proceeds, logged elsewhere)."""
    if not want:
        return True
    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        return h.hexdigest() == want
    except OSError:
        return False

def _turn_sha_shell(path_q, want):
    """A shell fragment (for the host_sh install/reinstall heredocs) that verifies `path_q` (already shlex-quoted)
    against `want`, removing it and failing the command on mismatch. '' when there's nothing to enforce."""
    if not want:
        return ""
    return (" && { printf '%s  %s' " + shlex.quote(want) + " " + path_q
            + " | sha256sum -c --status - || { rm -f " + path_q
            + "; echo 'turn binary checksum mismatch — refusing to run unverified binary' >&2; false; }; }")

_TURN_PANEL = {}   # the panel connection dict (url/token/fingerprint/verify) — set each sync so the turn-binary MIRROR pull works

def _turn_panel_fetch(owner, tag, arch, dest, want):
    """Pull the fork binary from the PANEL's mirror (Axis 2 · P2) → dest, verified against `want` (the pin sha).
    Censorship-robust: the node reaches the panel over its existing outbound-only channel even where GitHub is
    blocked. Returns True on a verified write (dest is left executable-ready), else False (caller falls back to
    GitHub-direct). No-ops without a pin tag or panel config — so mixed-version panels keep GitHub-direct."""
    panel = _TURN_PANEL or {}
    base = (panel.get("url") or "").rstrip("/")
    if not base or not tag or "/" not in (owner or ""):
        return False
    url = (base + "/api/node/turn-binary?owner=" + urllib.parse.quote(owner, safe="")
           + "&tag=" + urllib.parse.quote(tag, safe="") + "&arch=" + arch)
    st, data, _hv = _panel_get(url, panel.get("token") or "", panel, timeout=200)
    if st != 200 or not data:
        return False
    if want and hashlib.sha256(data).hexdigest() != want:   # the mirror must still match the pin (belt & suspenders)
        return False
    try:
        tmp = dest + ".pdl"
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(tmp, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o755)
        os.replace(tmp, dest)
    except OSError:
        with contextlib.suppress(OSError):
            os.remove(dest + ".pdl")
        return False
    return True

def _dturn_download(svc, owner, pin=None):
    arch = _turn_arch()
    if not _turn_arch_ok():                               # no server-linux-<arch> build exists → refuse cleanly (never fetch a wrong-arch binary)
        return "no turn-proxy build for this architecture (" + os.uname().machine + ") — forks publish amd64/arm64 only"
    tag, want = _turn_pin(pin)                            # panel checksum gate: pin the tag + expected sha256 (both '' → unverified)
    binp = _turn_bin_local(svc)   # shared per-fork slot
    if os.path.exists(binp):       # already have this fork's binary (another instance, or a prior install) → REUSE,
        return ""                  # no GitHub hit. (A panel Reinstall removes binp first, so it still forces a fresh fetch.)
    try: os.makedirs(os.path.dirname(binp), exist_ok=True)
    except OSError as e: return "mkdir: " + str(e)
    leg = _turn_bin_local_legacy(svc)                    # upgrade: reuse a pre-dedup per-instance binary instead of re-downloading
    if os.path.exists(leg):
        with contextlib.suppress(OSError):
            os.replace(leg, binp); os.chmod(binp, 0o755)
        if os.path.exists(binp):
            _turn_write_version(svc, tag or _turn_resolve_tag(owner)); return ""
    if _turn_panel_fetch(owner, tag, arch, binp, want):  # P2: pull the (verified) binary from the panel mirror first — censorship-robust
        _turn_write_version(svc, tag or _turn_resolve_tag(owner)); return ""
    err = "binary download failed"
    for url in _turn_dl_urls(owner, arch, tag):          # GitHub-direct fallback (mirror miss / no pin / mixed-version)
        r = run(["curl", "-4", "-fsSL", "--connect-timeout", "20", "--max-time", "240", "--retry", "3",
                 "--retry-delay", "3", "--retry-all-errors", url, "-o", binp], timeout=320)
        if r.returncode == 0:
            if not _turn_sha_ok(binp, want):             # downloaded but doesn't match the panel's hash → delete + refuse (never chmod/exec)
                with contextlib.suppress(OSError): os.remove(binp)
                return "checksum mismatch — refusing to run unverified turn binary (want " + want[:12] + "…)"
            with contextlib.suppress(OSError): os.chmod(binp, 0o755)
            _turn_write_version(svc, tag or _turn_resolve_tag(owner))   # record which release tag we just fetched
            return ""
        err = (r.stderr or "binary download failed").strip()[:160]
    return err

def _dturn_force_download(svc, owner, pin=None):
    """Reinstall/update: fetch the fork binary FRESH and atomically swap it in — WITHOUT ever unlinking the live
    shared file. A container bind-mounts this path (…:/turn-server); if it's momentarily missing when docker
    (re)creates a container, docker creates a *directory* there and everything breaks. So: temp + os.replace only."""
    arch = _turn_arch()
    if not _turn_arch_ok():                               # reinstall/update on an unrunnable arch → refuse cleanly
        return "no turn-proxy build for this architecture (" + os.uname().machine + ") — forks publish amd64/arm64 only"
    pin_tag, want = _turn_pin(pin)                        # panel checksum gate: pin tag + expected sha (both '' → unverified)
    binp = _turn_bin_local(svc)
    try: os.makedirs(os.path.dirname(binp), exist_ok=True)
    except OSError as e: return "mkdir: " + str(e)
    tag = pin_tag or _turn_resolve_tag(owner)             # prefer the panel-pinned tag (matches the hashed asset)
    if tag and os.path.isfile(binp):                     # a sibling instance of this fork already refreshed the
        with contextlib.suppress(Exception):             # shared binary this round → reuse, don't re-download 22MB
            with open(_turn_ver_path(svc)) as f:
                if f.read().strip() == tag: return ""
    tmp = binp + ".new." + _turn_inst(svc)
    if _turn_panel_fetch(owner, tag, arch, tmp, want):   # P2: pull the (verified, chmod'd) binary from the panel mirror first
        try: os.replace(tmp, binp)                       # atomic swap; tmp was verified before this point
        except OSError as e:
            with contextlib.suppress(OSError): os.remove(tmp)
            return ("swap failed (is " + binp + " a directory? — docker bind-mount footgun): " + str(e))[:160]
        _turn_write_version(svc, tag); return ""
    err = "binary download failed"
    for url in _turn_dl_urls(owner, arch, tag):          # GitHub-direct fallback
        r = run(["curl", "-4", "-fsSL", "--connect-timeout", "20", "--max-time", "240", "--retry", "3",
                 "--retry-delay", "3", "--retry-all-errors", url, "-o", tmp], timeout=320)
        if r.returncode == 0:
            if not _turn_sha_ok(tmp, want):              # verify BEFORE the atomic swap → the live binary is never replaced by unverified bytes
                with contextlib.suppress(OSError): os.remove(tmp)
                return "checksum mismatch — refusing to run unverified turn binary (want " + want[:12] + "…)"
            with contextlib.suppress(OSError): os.chmod(tmp, 0o755)
            try: os.replace(tmp, binp)                   # atomic: the path is a valid file at every instant
            except OSError as e:
                with contextlib.suppress(OSError): os.remove(tmp)
                return ("swap failed (is " + binp + " a directory? — docker bind-mount footgun): " + str(e))[:160]
            _turn_write_version(svc, tag)                # record which release tag we just fetched
            return ""
        err = (r.stderr or "binary download failed").strip()[:160]
    with contextlib.suppress(OSError): os.remove(tmp)
    return err

def _dturn_run(tp):   # (re)create the container to match tp; returns the docker-run CompletedProcess
    svc = tp["service"]; cn = _turn_cname(svc)
    run(["docker", "rm", "-f", cn], timeout=30)   # ignore errors (may not exist yet)
    # HOST-net node: turn shares the host net → forwards to the WG interface at 127.0.0.1:<port>. BRIDGE-net node:
    # the WG interfaces are in OUR netns, so the turn container joins it (container:<us>) to reach 127.0.0.1:<port>
    # and be visible to our nft client-IP capture. In bridge, its public listen port lives in our netns → publish it
    # on the swg-node container (compose ports:). (A swg-node recreate orphans netns-joined turns; reconcile re-runs them.)
    net = ["--network", "container:" + _SELF_CONTAINER] if NODE_NET == "bridge" else ["--network", "host"]
    # Axis-2 P3: drop every capability except NET_BIND_SERVICE (bind a <1024 listen port) + no-new-privileges —
    # a turn proxy only forwards packets, so a compromised fork binary is confined to its sockets.
    harden = ["--cap-drop", "ALL", "--cap-add", "NET_BIND_SERVICE", "--security-opt", "no-new-privileges"]
    # Bound the container log. Docker's json-file driver defaults to UNLIMITED, and a fork binary that spins and
    # logs per iteration will fill the host disk — observed at 9.6G from one such server. compose caps the panel's
    # own services the same way; these are created here, so they must be capped here.
    logcap = ["--log-opt", "max-size=10m", "--log-opt", "max-file=3"]
    return run(["docker", "run", "-d", "--name", cn] + net + ["--restart", "unless-stopped"] + harden + logcap +
               ["-v", _turn_bin_host(svc) + ":/turn-server:ro", "--entrypoint", "/turn-server",
                SWG_TURN_IMAGE] + _dturn_args(tp), timeout=60)

def _dturn_netns_current(svc):
    """Bridge only: is the (running) turn container attached to OUR CURRENT netns? A swg-node recreate/update leaves
    its netns-joined turns pointing at the OLD (now-dead) container — docker still reports them 'running', but they're
    network-broken (can't reach the WG interface, invisible to nft capture). Our container id is our hostname, and the
    turn's NetworkMode records the full id it joined, so a stale join no longer starts with our current id → recreate."""
    if NODE_NET != "bridge":
        return True
    r = run(["docker", "inspect", "-f", "{{.HostConfig.NetworkMode}}", _turn_cname(svc)])
    return (r.stdout or "").strip().startswith("container:" + socket.gethostname())

_TURN_IMG_FIXED = {}   # svc -> the SWG_TURN_IMAGE we already recreated for (see below)

def _dturn_image_current(svc):
    """Is the (running) turn container on the image this node runs turns FROM? Updating a docker node to a new
    image tag leaves its turn containers on the old one: docker reports them 'running', nothing looks wrong, and
    they quietly serve a different build than the node beside them — observed on a node moved to a pre-release
    tag whose two turn proxies stayed on :latest, i.e. main-branch binaries running next to a dev node.
    Same shape as the netns twin above: notice the drift, and let the ordinary recreate path fix it.

    FAIL-SAFE, deliberately. A comparison that can never be satisfied would tear the container down on every
    single pass, for ever, and a turn proxy that is merely on the wrong tag still WORKS — so a mismatch is
    acted on AT MOST ONCE per target image. If docker still disagrees after we rebuilt for that exact target
    (a normalised name, a digest pin, anything we did not anticipate), we stop and leave the proxy running."""
    if not SWG_TURN_IMAGE:
        return True                       # nothing to compare against → never churn
    r = run(["docker", "inspect", "-f", "{{.Config.Image}}", _turn_cname(svc)])
    cur = (r.stdout or "").strip()
    if not cur or cur == SWG_TURN_IMAGE:  # match, or docker could not say → leave it alone
        _TURN_IMG_FIXED.pop(svc, None)
        return True
    if _TURN_IMG_FIXED.get(svc) == SWG_TURN_IMAGE:
        return True                       # already rebuilt for this target once — do not loop on it
    _TURN_IMG_FIXED[svc] = SWG_TURN_IMAGE
    return False


def _dturn_verify(svc):
    time.sleep(1.5)
    r = run(["docker", "inspect", "-f", "{{.State.Running}}", _turn_cname(svc)])
    if (r.stdout or "").strip() == "true": return ""
    lg = run(["docker", "logs", "--tail", "5", _turn_cname(svc)])
    return ("turn container isn't running: " + ((lg.stderr or lg.stdout or "").strip() or "see docker logs"))[:160]

def _dturn_delete(svc, rec=None):
    run(["docker", "rm", "-f", _turn_cname(svc)], timeout=30)
    shutil.rmtree(os.path.dirname(_turn_bin_local_legacy(svc)), ignore_errors=True)   # old per-instance dir, if any
    if not _turn_fork_in_use(svc, rec):                  # last instance of this fork → drop the shared binary
        shutil.rmtree(os.path.dirname(_turn_bin_local(svc)), ignore_errors=True)

# ── turn-proxy VERSION/owner — sidecars next to the SHARED per-fork binary (one tag/owner per fork) ──
# docker: …/turn/.bin/<fork>/version.txt · bare: /opt/vk-turn-proxy/.bin/<fork>/version.txt + repo.txt.
# Reads fall back to the pre-dedup per-instance path so an un-migrated install still shows its version.
def _turn_ver_path(svc):
    if TURN_DOCKER:
        return os.path.join(os.path.dirname(_turn_bin_local(svc)), "version.txt")
    return "/opt/vk-turn-proxy/.bin/" + _turn_fork(svc) + "/version.txt"
def _turn_repo_path(svc):    # owner repo (fallback if a reinstall req lacks owner)
    if TURN_DOCKER:
        return os.path.join(os.path.dirname(_turn_bin_local(svc)), "repo.txt")
    return "/opt/vk-turn-proxy/.bin/" + _turn_fork(svc) + "/repo.txt"
def _turn_ver_path_legacy(svc):
    if TURN_DOCKER:
        return "/var/lib/swg-noded/turn/" + _turn_inst(svc) + "/version.txt"
    return "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/version.txt"

# ── Axis-1: dynamic flag discovery from the binary's own `-h` ──────────────────────────────────────────────
# The authors already "authored the manifest" — they registered every flag via Go's `flag` package. We read it
# from the (already checksum-verified, P1/P2) binary itself: run `<binary> -h`, parse name/type/default/usage,
# and report it in the snapshot. The panel overlays curated metadata (enum value-sets, secret, hide footguns);
# the SPA renders toggles (bool) / textboxes (else) + a raw-ExecStart override. We do NOT guess enum VALUES here
# (that's a curated concern) — `-h` gives structure reliably, not value-sets. See docs/TURN-PROXY-OVERHAUL-PLAN.md.
_TURN_FLAGS_CACHE = {}   # fork -> {"ver":<tag>, "flags":[...]}  (in-memory; mirrored to <fork-dir>/flags.json)

def _turn_binpath(svc):   # the shared per-fork binary this node actually runs (docker mount / bare-metal)
    if TURN_DOCKER:
        return _turn_bin_local(svc)
    return "/opt/vk-turn-proxy/.bin/" + _turn_fork(svc) + "/server"

def _turn_help_flags(text):
    """Parse Go `flag` `-h` output → [{name,type,default,usage}]. A flag line is `  -name [type]`; the following
    tab/space-indented line(s) are its usage, with `(default X)`. type '' ⇒ bool. Structure only — no enum guess."""
    flags, cur = [], None
    for ln in (text or "").splitlines():
        m = re.match(r"^  -([A-Za-z0-9][\w.-]*)(?:[ ]+(\S+))?[ ]*$", ln)
        if m:
            if cur: flags.append(cur)
            cur = {"name": m.group(1), "type": (m.group(2) or "").strip(), "usage": ""}
        elif cur is not None and (ln.startswith("\t") or ln.startswith("    ")):
            cur["usage"] += (" " if cur["usage"] else "") + ln.strip()
    if cur:
        flags.append(cur)
    for f in flags:
        dm = re.search(r'\(default (?:"([^"]*)"|(\S+?))\)', f["usage"])
        f["default"] = (dm.group(1) if (dm and dm.group(1) is not None) else (dm.group(2) if dm else "")) if dm else ""
    return flags

def _turn_discover_flags(svc):
    """Run the fork's (verified) binary with `-h` once per (fork, version) → its flag list, cached in memory +
    <fork-dir>/flags.json. Re-discovers when the version changes (a reinstall). [] on any failure — safe: the
    SPA just shows the raw-ExecStart override then."""
    fork = _turn_fork(svc)
    ver = ""
    with contextlib.suppress(Exception):
        with open(_turn_ver_path(svc)) as f:
            ver = f.read().strip()
    c = _TURN_FLAGS_CACHE.get(fork)
    if c and c.get("ver") == ver:
        return c["flags"]
    binp = _turn_binpath(svc)
    fp = os.path.join(os.path.dirname(binp), "flags.json")
    with contextlib.suppress(Exception):        # disk cache survives restarts; only re-run on a version change
        with open(fp) as f:
            d = json.load(f)
        if d.get("ver") == ver and isinstance(d.get("flags"), list):
            _TURN_FLAGS_CACHE[fork] = d
            return d["flags"]
    flags = []
    if os.path.isfile(binp):
        try:
            r = run([binp, "-h"], timeout=6)    # Go flag prints usage + exits 2; static binary, direct exec both models
            flags = _turn_help_flags((getattr(r, "stdout", "") or "") + "\n" + (getattr(r, "stderr", "") or ""))
        except Exception:
            flags = []
    rec = {"ver": ver, "flags": flags}
    _TURN_FLAGS_CACHE[fork] = rec
    with contextlib.suppress(Exception):
        with open(fp, "w") as f:
            json.dump(rec, f)
    return flags
def _turn_repo_path_legacy(svc):
    return "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/repo.txt"
def _turn_version(svc):
    for p in (_turn_ver_path(svc), _turn_ver_path_legacy(svc)):
        try:
            with open(p) as f:
                return f.read().strip()[:40]
        except Exception:
            pass
    return ""
def _turn_write_version(svc, tag):
    if not tag:
        return
    p = _turn_ver_path(svc)
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as f:
            f.write(tag.strip()[:40])
        with contextlib.suppress(OSError): os.chmod(p, 0o644)
    except OSError:
        pass
def _turn_resolve_tag(owner):
    """Latest release tag, read from the 302 of releases/latest/download (no API → no rate limit)."""
    if not owner:
        return ""
    arch = _turn_arch()
    url = "https://github.com/" + owner + "/releases/latest/download/server-linux-" + arch
    r = run(["curl", "-4", "-fsS", "-o", "/dev/null", "-w", "%{redirect_url}",
             "--connect-timeout", "15", "--max-time", "30", url], timeout=40)
    m = re.search(r"/releases/download/([^/]+)/", r.stdout or "")
    return m.group(1) if m else ""
def _attach_turn_version(tps):
    for t in tps:
        if t.get("service"):
            t["version"] = _turn_version(t["service"])

def _dturn_install(svc, req):   # returns (err, tp_record_or_None)
    owner = (req.get("owner") or "").strip(); listen = (req.get("listen") or "").strip()
    connect = (req.get("connect") or "").strip(); wrap_flags = (req.get("wrap_flags") or "").strip()
    if "/" not in owner or ":" not in listen or ":" not in connect: return "bad install request", None
    if not SWG_TURN_IMAGE or not SWG_HOST_NODE_DIR:
        return "turn-on-docker not configured (re-install the node with turn management on)", None
    if "params" in req:   # explicit ExecStart tail from the create form (verbatim, including its wrap key)
        params = (req.get("params") or "").strip()
    else:                 # legacy: build from the fork's wrap flags + a generated key
        params = (wrap_flags + " -wrap-key " + secrets.token_hex(32)) if wrap_flags else ""
    err = _dturn_download(svc, owner, req.get("pin"))   # panel checksum gate (pin absent → unverified, mixed-version safe)
    if err: return err, None
    tp = {"service": svc, "listen": listen, "connect": connect,
          "wrap_key": _params_wrapkey(params), "params": params, "owner": owner}
    _ti = (req.get("title") or "").strip()
    if _ti: tp["title"] = _ti          # optional display label, kept on the record
    r = _dturn_run(tp)
    if r.returncode != 0: return (r.stderr or "container start failed").strip()[:160], None
    verr = _dturn_verify(svc)
    return (verr, tp)   # keep the record even if down, so the panel shows it (greyed)

_DTURN_RUN = {"at": 0.0, "set": set()}
_TURN_INSTALLING = set()   # services whose container is being downloaded/(re)created RIGHT NOW → "installing"
_TURN_FAILED = set()       # services whose last install/run attempt errored → "install failed" on the panel
_TURN_ATTEMPTS = {}        # svc -> consecutive failed-download count; the bg reconcile STOPS retrying after
TURN_MAX_ATTEMPTS = 4      # this many (so a stuck 502/timeout becomes "install failed", not an endless "installing"). A manual Reinstall resets it.
# Async reinstall/update: the binary download + restart runs in a daemon thread so the sync loop STAYS RESPONSIVE
# and keeps posting snapshots — the panel sees the proxy as "updating" for the whole download (a synchronous
# reinstall blocks the loop, so the card can only jump pending→updated). apply_turn keeps the request in-flight
# (no "done" reported → turn_pending stays) while the job runs, then reports the result once it finishes.
_TURN_JOBS = {}            # svc -> {"done": bool, "err": str, "tp": dict, "at": ts}
_TURN_JOBS_LOCK = threading.Lock()
def _turn_job_launch(svc, tp, work):
    """Run work() (returns an error string, "" == success) in a daemon thread; mark the job done when it returns."""
    def _run():
        err = ""
        try:
            err = work() or ""
        except Exception as e:
            err = str(e)[:140]
        with _TURN_JOBS_LOCK:
            if svc in _TURN_JOBS:
                _TURN_JOBS[svc].update(done=True, err=err)
    with _TURN_JOBS_LOCK:
        _TURN_JOBS[svc] = {"done": False, "err": "", "tp": tp, "at": time.time()}
    threading.Thread(target=_run, daemon=True).start()

# Instances of the SAME fork share one binary (…/.bin/<fork>/server). Two reinstalls of that fork would race on the
# shared download temp / removal → "server.new: No such file" and half-updated units. Serialise per fork so the
# shared binary is refreshed by one job at a time; same-fork jobs simply queue (their cards stay "updating" while waiting).
_TURN_FORK_LOCKS = {}
_TURN_FORK_LOCKS_GUARD = threading.Lock()
def _turn_fork_lock(fork):
    with _TURN_FORK_LOCKS_GUARD:
        return _TURN_FORK_LOCKS.setdefault(fork or "", threading.Lock())
def _dturn_attach_running(tps):
    nowt = time.time()
    if nowt - _DTURN_RUN["at"] >= 15:
        r = run(["docker", "ps", "--filter", "name=swg-turn-", "--format", "{{.Names}}"])
        _DTURN_RUN["set"] = set((r.stdout or "").split()); _DTURN_RUN["at"] = nowt
    for t in tps:
        if t.get("service"):
            svc = t["service"]
            t["running"] = _turn_cname(svc) in _DTURN_RUN["set"]
            stopped = bool(t.get("stopped"))
            active = svc in _TURN_INSTALLING   # being downloaded / (re)created RIGHT NOW (only one at a time)
            failed = (svc in _TURN_FAILED) and not t["running"] and not stopped
            t["failed"] = failed
            # docker: only the proxy the bg reconcile is working on right now is "installing"; the others not
            # yet up (and not failed/stopped) are "pending" — queued for the sequential reconcile, not stuck.
            t["installing"] = active and not stopped
            t["pending"] = (not t["running"]) and (not failed) and (not stopped) and (not active)

def _dturn_ensure(tp):   # make the container match the record entry (download binary if missing, run if not up)
    svc = tp.get("service")
    if not svc:
        return
    if tp.get("stopped"):   # intentionally stopped from the panel → don't auto-(re)start it
        _TURN_INSTALLING.discard(svc)
        return
    r = run(["docker", "inspect", "-f", "{{.State.Running}}", _turn_cname(svc)])
    if (r.stdout or "").strip() == "true":
        _ns_ok = _dturn_netns_current(svc)      # (bridge) joined to our LIVE netns
        _img_ok = _dturn_image_current(svc)     # ...and on the image this node runs turns from
        if _ns_ok and _img_ok:
            _TURN_INSTALLING.discard(svc); _TURN_FAILED.discard(svc); _TURN_ATTEMPTS.pop(svc, None); NODE_PROGRESS.pop(svc, None)
            return
        # running, but not as it should be → fall through to the recreate path, saying which of the two it is
        print("swg-noded: turn %s %s — recreating it" %
              (svc, "is on a stale netns after a node recreate" if not _ns_ok
                    else "runs an image this node no longer uses (want %s)" % SWG_TURN_IMAGE), flush=True)
    if _TURN_ATTEMPTS.get(svc, 0) >= TURN_MAX_ATTEMPTS and not os.path.exists(_turn_bin_local(svc)):
        _TURN_FAILED.add(svc); _TURN_INSTALLING.discard(svc); NODE_PROGRESS.pop(svc, None)   # given up — "install failed" (a manual Reinstall resets the counter)
        return
    _TURN_INSTALLING.add(svc)   # downloading / (re)creating now → the panel shows it as "installing"
    try:
        if not os.path.exists(_turn_bin_local(svc)) and tp.get("owner"):
            NODE_PROGRESS[svc] = "Downloading the turn-proxy binary from GitHub — this can take a minute…"
            derr = _dturn_download(svc, tp["owner"])
            if derr:
                _TURN_ATTEMPTS[svc] = _TURN_ATTEMPTS.get(svc, 0) + 1
                # NON-terminating: keep retrying every pass, but tell the operator WHY it's slow so it doesn't look hung.
                NODE_PROGRESS[svc] = ("GitHub download failed (attempt %d/%d): %s. Still retrying — please wait for the install to finish."
                                       % (_TURN_ATTEMPTS[svc], TURN_MAX_ATTEMPTS, derr))
                print("swg-noded: turn %s binary download failed (attempt %d/%d): %s" % (svc, _TURN_ATTEMPTS[svc], TURN_MAX_ATTEMPTS, derr), flush=True)
        if not os.path.exists(_turn_bin_local(svc)):   # no binary yet
            if _TURN_ATTEMPTS.get(svc, 0) >= TURN_MAX_ATTEMPTS:   # stop the endless "installing" → mark failed + report it
                _TURN_FAILED.add(svc); NODE_PROGRESS.pop(svc, None)
                NODE_ERRORS[svc] = "binary download failed after %d attempts — Reinstall to retry" % TURN_MAX_ATTEMPTS
                print("swg-noded: turn %s — gave up after %d download attempts; Reinstall from the panel to retry" % (svc, TURN_MAX_ATTEMPTS), flush=True)
            else:
                print("swg-noded: turn %s has no binary yet — will retry on the next pass" % svc, flush=True)
            return
        _TURN_ATTEMPTS.pop(svc, None); NODE_ERRORS.pop(svc, None)   # got the binary → clear any prior failure
        NODE_PROGRESS[svc] = "Binary downloaded — starting the container…"
        rr = _dturn_run(tp)
        if rr.returncode != 0:
            _TURN_FAILED.add(svc); NODE_PROGRESS.pop(svc, None)
            print("swg-noded: turn %s 'docker run' failed: %s" % (svc, (rr.stderr or rr.stdout or "").strip()[:200]), flush=True)
            return
        verr = _dturn_verify(svc)
        if verr:
            _TURN_FAILED.add(svc); NODE_PROGRESS.pop(svc, None)
            print("swg-noded: turn %s started but didn't stay up: %s" % (svc, verr), flush=True)
        else:
            _TURN_FAILED.discard(svc); NODE_PROGRESS.pop(svc, None)
            print("swg-noded: turn %s container (re)started (%s)" % (svc, _turn_cname(svc)), flush=True)
    finally:
        _TURN_INSTALLING.discard(svc)

def _dturn_reconcile():   # startup/periodic: ensure every recorded turn-proxy has a running container
    if not TURN_DOCKER:
        return
    tps = load_turn_proxies()
    if not tps:
        return
    if not (SWG_TURN_IMAGE and SWG_HOST_NODE_DIR):   # the #1 silent failure — say so loudly
        print("swg-noded: %d turn-proxy record(s) present but turn-on-docker isn't configured "
              "(SWG_TURN_IMAGE=%r SWG_HOST_NODE_DIR=%r) — re-install the node with turn management ON"
              % (len(tps), SWG_TURN_IMAGE, SWG_HOST_NODE_DIR), flush=True)
        return
    for tp in tps:
        try:
            _dturn_ensure(tp)
        except Exception as e:
            print("swg-noded: turn reconcile %s failed: %s" % (tp.get("service"), e), flush=True)

def _dturn_bg_loop():   # background thread: keep turn-proxy containers up WITHOUT blocking the sync loop, so the
    while True:         # node appears on the panel right away and the cards fill in (installing → up) as each starts
        try:
            _dturn_reconcile()
        except Exception as e:
            print("swg-noded: turn reconcile error: %s" % e, flush=True)
        time.sleep(30)


# ───────── bare-metal turn-proxies: systemd unit + EnvironmentFile (edit = rewrite env, NO daemon-reload) ─────────
# The connect/listen/params live in a turn.env next to the binary; ExecStart references them as ${SWG_…}.
# Editing a turn-proxy then only rewrites turn.env + `systemctl restart` — systemd re-parsing EVERY unit
# (daemon-reload) was the CPU spike. Old units (values baked into ExecStart) are migrated on first edit.
def _turn_env_path(svc): return "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/turn.env"

def _fork_unit_path_env():
    """`Environment=PATH=…` for the fork systemd units (turn / wdtt / csqtt), or "" where it isn't needed.

    The downloaded fork binaries shell out to iproute2 / wireguard tools — a WDTT server runs
    `ip addr add` and EXITS 1 if it cannot find `ip`. On bare-metal those tools sit on systemd's default
    unit PATH (`/usr/sbin:/sbin:…`), so nothing is needed and we add nothing — otherwise every existing
    fork unit would drift and briefly bounce for no functional gain. On a store-based OS (NixOS) they are
    NOT on that default PATH: they live in the store, on swg-noded's OWN PATH (which node.nix curates with
    iproute2 / wireguard-tools / amneziawg-tools / iptables). Propagate that PATH — it already resolves
    every tool here — and append the FHS dirs as a fallback. Detected by `/nix/store` being on our PATH;
    docker forks run as child processes of this daemon and inherit the environment directly, so only the
    systemd-unit path needs this at all."""
    p = os.environ.get("PATH", "")
    if "/nix/store" not in p:
        return ""
    return "Environment=PATH=" + p.strip(":") + ":/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n"
_WANIF_RE = re.compile(r"^[A-Za-z0-9._-]{1,15}$")
def _safe_wan(w, fallback):
    """A WAN NIC name safe to splice into an iptables rule (which is later re-parsed from `iptables -S` and
    deleted via sh) — blocks ; ` $ | & from a compromised/MITM panel. Invalid → the auto-detected fallback."""
    w = (w or "").strip()
    return w if (w and _WANIF_RE.match(w)) else fallback


_TURN_CTRL_RE = re.compile(r"[\x00-\x1f\x7f]")
def _turn_input_safe(*vals):
    """Defence-in-depth: refuse turn params carrying control chars. They are interpolated into a systemd
    unit + env heredoc executed as root, so a newline could terminate the heredoc and inject a command.
    The panel validates these too — this is the belt on the node against a compromised or MITM'd panel."""
    return all(not _TURN_CTRL_RE.search(v or "") for v in vals)


def _turn_env_text(listen, connect, params):
    return "SWG_LISTEN=%s\nSWG_CONNECT=%s\nSWG_PARAMS=%s\n" % (listen, connect, (params or "").strip())
def _exec_bin(execl):
    try: return shlex.split(execl)[0]
    except Exception: return (execl.split() or [""])[0]
def _unit_is_envform(unit_text): return "${SWG_" in _exec_of(unit_text)

def _tp_from_unit(svc, unit_text):
    """Resolve a turn-proxy's config from its unit. EnvironmentFile form → read turn.env; old form → ExecStart."""
    if not _unit_is_envform(unit_text):
        return _parse_tp(svc, _exec_of(unit_text))
    env = host_sh("cat " + shlex.quote(_turn_env_path(svc)) + " 2>/dev/null").stdout or ""
    vals = {}
    for ln in env.splitlines():
        k, _, v = ln.partition("="); vals[k.strip()] = v.strip()
    params = vals.get("SWG_PARAMS", "")
    return {"service": svc, "listen": vals.get("SWG_LISTEN", ""), "connect": vals.get("SWG_CONNECT", ""),
            "wrap_key": _params_wrapkey(params), "params": params}

# Axis-2 P3: systemd sandbox for the turn-proxy unit. A turn proxy only shuffles bytes between two sockets, so
# confine it hard — a compromised/malicious fork binary is contained to its sockets, not root-on-the-box. The
# reinstall (binary swap) runs as root via host_sh OUTSIDE this sandbox, so ProtectSystem=strict doesn't block it.
# ⚠️ SystemCallFilter=@system-service is the one directive that could refuse an unusual Go syscall → if a proxy
# fails to start right after a deploy, check `journalctl -u <svc>` for a seccomp kill and this is the first suspect.
# Existing (pre-P3) units get hardened on their next reinstall/migration, not retroactively.
_TURN_HARDEN_KEYS = ("NoNewPrivileges", "ProtectSystem", "ProtectHome", "PrivateTmp", "ProtectKernelTunables",
                     "ProtectKernelModules", "ProtectControlGroups", "RestrictAddressFamilies", "RestrictNamespaces",
                     "RestrictSUIDSGID", "LockPersonality", "CapabilityBoundingSet", "SystemCallFilter", "SystemCallErrorNumber")
TURN_UNIT_HARDENING = (
    "NoNewPrivileges=yes\nProtectSystem=strict\nProtectHome=yes\nPrivateTmp=yes\n"
    "ProtectKernelTunables=yes\nProtectKernelModules=yes\nProtectControlGroups=yes\n"
    "RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK\nRestrictNamespaces=yes\nRestrictSUIDSGID=yes\n"
    "LockPersonality=yes\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\n"
    "SystemCallFilter=@system-service\nSystemCallErrorNumber=EPERM\n")

def _unit_to_envform(unit_text, svc, binp):
    """Rewrite a baked-ExecStart unit to the EnvironmentFile form (one-time migration) + apply the P3 sandbox."""
    envp = _turn_env_path(svc); out = []; have_ef = any(l.startswith("EnvironmentFile=") for l in unit_text.splitlines())
    for l in unit_text.splitlines():
        if l.startswith("ExecStart="):
            if not have_ef: out.append("EnvironmentFile=-" + envp)
            out.append("ExecStart=" + binp + " -listen ${SWG_LISTEN} -connect ${SWG_CONNECT} $SWG_PARAMS")
        elif l.startswith("EnvironmentFile="):
            out.append("EnvironmentFile=-" + envp)
        elif any(l.split("=", 1)[0].strip() == k for k in _TURN_HARDEN_KEYS):
            continue                                    # drop any stale hardening lines; re-added fresh below
        else:
            out.append(l)
    hard = TURN_UNIT_HARDENING.rstrip("\n").split("\n")   # inject the sandbox at the end of [Service] (before [Install])
    if "[Install]" in out:
        i = out.index("[Install]")
        out = out[:i] + hard + [""] + out[i:]
    else:
        out += hard
    return "\n".join(out) + "\n"

def _turn_install(svc, req):
    """Install a new turn-proxy: download the fork's prebuilt binary, write the systemd unit, enable
    it. Mirrors the installer's install_turn_binary (server-linux-<arch>). '' on success, else error."""
    owner = (req.get("owner") or "").strip()
    listen = (req.get("listen") or "").strip()
    connect = (req.get("connect") or "").strip()
    wrap_flags = (req.get("wrap_flags") or "").strip()
    if "/" not in owner or ":" not in listen or ":" not in connect:
        return "bad install request"
    if not _turn_input_safe(owner, listen, connect, wrap_flags, req.get("params")):
        return "refused: control characters in turn parameters"
    inst = svc[len("vk-turn-proxy-"):] if svc.startswith("vk-turn-proxy-") else svc
    fork = _turn_fork(svc)
    fdir = "/opt/vk-turn-proxy/.bin/" + fork   # shared per-fork: one binary + version.txt + repo.txt for every instance
    sbin = fdir + "/server"
    d = "/opt/vk-turn-proxy/" + inst           # per-instance: turn.env + a 'server' symlink → the shared binary
    binp = d + "/server"
    arch = _turn_arch()
    extra = ""
    if "params" in req:   # explicit ExecStart tail from the create form (verbatim, including its wrap key)
        extra = (req.get("params") or "").strip()
    elif wrap_flags:
        key = secrets.token_hex(32)   # 64 hex chars, no openssl dependency (the slim image lacks it)
        if not key:
            return "keygen failed"
        extra = wrap_flags + " -wrap-key " + key
    envp = _turn_env_path(svc)
    unit = ("[Unit]\nDescription=vk-turn-proxy (" + owner + ") - " + listen + " -> " + connect + "\n"
            "After=network-online.target\nWants=network-online.target\n\n"
            "[Service]\n" + _fork_unit_path_env() + "EnvironmentFile=-" + envp + "\n"
            "ExecStart=" + binp + " -listen ${SWG_LISTEN} -connect ${SWG_CONNECT} $SWG_PARAMS\n"
            # Same backoff as the wdtt/csqtt units (systemd <254 ignores both keys). A turn proxy's
            # standing permanent failure is the one _turn_verify exists for — a -listen IP that is not an
            # address on this host — and that bind fails identically for ever. Written on install and
            # reinstall only: turn units can be ONBOARDED (_tp_from_unit reads a unit this daemon did not
            # write, including the pre-EnvironmentFile form), so there is deliberately no drift-rewrite
            # here to push our rendering over an operator's or an installer's unit.
            "Restart=on-failure\nRestartSec=3\nRestartSteps=8\nRestartMaxDelaySec=300\n" + TURN_UNIT_HARDENING + "\n"
            "[Install]\nWantedBy=multi-user.target\n")
    pin_tag, want = _turn_pin(req.get("pin"))             # panel checksum gate: pin the immutable tag + expected sha256
    tag = pin_tag or _turn_resolve_tag(owner)
    _turn_panel_fetch(owner, tag, arch, sbin, want)       # P2: place the (verified) binary from the panel mirror → the heredoc's [ -x sbin ] then skips GitHub
    dl = " || ".join("curl -4 -fsSL --connect-timeout 20 --max-time 240 --retry 3 --retry-delay 3 --retry-all-errors "
                     + shlex.quote(u) + " -o " + shlex.quote(sbin) for u in _turn_dl_urls(owner, arch, tag))
    # verify ONLY a freshly downloaded binary (reuse of this fork's already-present binary, incl. a panel-mirror pull above = validated already)
    dlblock = "{ [ -x " + shlex.quote(sbin) + " ] || { { " + dl + "; }" + _turn_sha_shell(shlex.quote(sbin), want) + "; }; }"
    cmd = ("mkdir -p " + shlex.quote(fdir) + " " + shlex.quote(d)
           + " && " + dlblock + " && chmod 755 " + shlex.quote(sbin)
           + " && ln -sfn " + shlex.quote("../.bin/" + fork + "/server") + " " + shlex.quote(binp)
           + " && printf %s " + shlex.quote(owner) + " > " + shlex.quote(fdir + "/repo.txt")
           + ((" && printf %s " + shlex.quote(tag) + " > " + shlex.quote(fdir + "/version.txt")) if tag else "")
           + " && cat > " + shlex.quote(envp) + " <<'SWGENV'\n" + _turn_env_text(listen, connect, extra) + "SWGENV\n"
           + "cat > " + shlex.quote(_turn_unit_path(svc)) + " <<'SWGEOF'\n" + unit + "SWGEOF\n"
           + "systemctl daemon-reload && " + sc_enable_now(svc) + " >/dev/null 2>&1")
    w = host_sh(cmd, timeout=210)
    if w.returncode != 0:
        return (w.stderr or w.stdout or "install failed").strip()[:160]
    return _turn_verify(svc)   # enable --now returns 0 even if the binary crash-loops — confirm it stays up

def _turn_verify(svc):
    """Confirm a turn-proxy service is actually running after install/edit. enable/restart returns 0 as
    soon as the binary is exec'd, so a crash-loop (e.g. a -listen IP not local to the host → bind fails)
    looks like success — this catches it + returns the journal reason so the panel can show it."""
    v = host_sh("sleep 1.5; systemctl is-active " + shlex.quote(svc) + " 2>/dev/null; "
                "journalctl -u " + shlex.quote(svc) + " -n 5 --no-pager -o cat 2>/dev/null | grep -iE 'error|invalid|fail|bind|address|panic' | tail -1")
    lines = (v.stdout or "").strip().splitlines()
    if lines and lines[0] == "active":
        return ""
    reason = lines[-1] if len(lines) > 1 else "not running (check the -listen IP is an address on this host)"
    return "service didn't stay up: " + reason[:150]

def apply_turn(turn, turn_onboard):
    """Apply panel turn-proxy requests (manage/rotate/delete) + onboard host .service units, then
    update the turn record so the snapshot reflects it (which clears the panel request)."""
    res = {"done": [], "errors": []}
    if not turn and not turn_onboard:
        return res
    keys = set(turn or {}) | set(turn_onboard or [])
    print("turn: applying " + str(sorted(keys)) + " manage_on=" + str(TURN_MANAGE_ON)
          + " kind=" + NODE_KIND, flush=True)
    def fail(k, m):
        res["errors"].append(k + ": " + m); NODE_ERRORS[k] = m
        print("turn: FAIL " + k + " -> " + m, flush=True)
    def good(k, tag):
        res["done"].append(tag); NODE_ERRORS.pop(k, None)
        print("turn: ok " + tag, flush=True)
    if not TURN_MANAGE_ON:
        for k in keys:
            fail(k, "turn management off — re-install the docker node with the 'panel' option")
        return res
    rec = {tp.get("service"): tp for tp in load_turn_proxies() if tp.get("service")}
    changed = False
    for svc, req in (turn or {}).items():
        try:
            act = req.get("action")
            if TURN_DOCKER:                                   # ── container model ──
                if act == "install":
                    err, tp = _dturn_install(svc, req)
                    if tp is not None: rec[svc] = tp; changed = True
                    fail(svc, err) if err else good(svc, "ins:" + svc)
                    continue
                if act == "delete":
                    _dturn_delete(svc, rec); rec.pop(svc, None); changed = True; good(svc, "del:" + svc); continue
                if act == "reinstall":      # force a fresh binary (fix a failed download / update to latest) + (re)create — ASYNC (see _TURN_JOBS)
                    with _TURN_JOBS_LOCK: _job = dict(_TURN_JOBS.get(svc) or {})
                    if _job and not _job.get("done"):
                        continue                            # still downloading/recreating → keep it in-flight (card stays "updating")
                    if _job and _job.get("done"):           # thread finished → report the result + clear the job
                        with _TURN_JOBS_LOCK: _TURN_JOBS.pop(svc, None)
                        NODE_PROGRESS.pop(svc, None); _TURN_INSTALLING.discard(svc)
                        if _job.get("err"):
                            _TURN_FAILED.add(svc); fail(svc, _job["err"])
                        else:
                            rec[svc] = _job.get("tp") or rec.get(svc); changed = True; _TURN_FAILED.discard(svc); good(svc, "rei:" + svc)
                        continue
                    tp = rec.get(svc) or {"service": svc, "listen": req.get("listen", ""), "connect": req.get("connect", ""), "params": req.get("params", "")}
                    if req.get("owner"): tp["owner"] = req["owner"].strip()
                    if not tp.get("owner"):
                        fail(svc, "no owner repo for reinstall"); continue
                    _TURN_ATTEMPTS.pop(svc, None)   # manual retry → clear the give-up counter so the bg reconcile resumes if this one also fails
                    _TURN_INSTALLING.add(svc)       # mark "installing/updating" for the docker card (attach_running keys off this set,
                                                    # overriding load_turn_proxies' job flag) — cleared in the done handler below
                    _pin = req.get("pin")           # panel checksum gate — capture before the thread (req isn't in the closure's scope later)
                    def _work(svc=svc, tp=tp, pin=_pin):      # runs in a thread — download fresh + (re)create the container
                        with _turn_fork_lock(_turn_fork(svc)):   # serialise same-fork refreshes; atomic-swap the shared binary
                            with contextlib.suppress(OSError): os.remove(_turn_bin_local_legacy(svc))   # drop a stale pre-dedup copy
                            derr = _dturn_force_download(svc, tp["owner"], pin)
                        if derr: return derr
                        r = _dturn_run(tp)
                        if r.returncode != 0: return (r.stderr or "container start failed").strip()[:120]
                        return _dturn_verify(svc)
                    _turn_job_launch(svc, tp, _work)
                    continue                                 # in flight now — don't report done yet (card shows "updating")
                if act == "title":            # cosmetic label only → update the record, DON'T touch the container
                    tp = rec.get(svc)
                    if not tp:
                        fail(svc, "turn-proxy not in the node record"); continue
                    tp["title"] = (req.get("title") or "").strip(); rec[svc] = tp; changed = True
                    good(svc, "title:" + svc); continue
                if act == "stop":             # stop + remove the container; the 'stopped' flag keeps the bg reconcile from restarting it
                    tp = rec.get(svc)
                    if not tp:
                        fail(svc, "turn-proxy not in the node record"); continue
                    run(["docker", "rm", "-f", _turn_cname(svc)])
                    tp["stopped"] = True; rec[svc] = tp; changed = True
                    _TURN_INSTALLING.discard(svc); _TURN_FAILED.discard(svc); _TURN_ATTEMPTS.pop(svc, None); NODE_PROGRESS.pop(svc, None)
                    good(svc, "stop:" + svc); continue
                if act == "start":            # clear 'stopped' + (re)create the container
                    tp = rec.get(svc)
                    if not tp:
                        fail(svc, "turn-proxy not in the node record"); continue
                    tp.pop("stopped", None); rec[svc] = tp; changed = True
                    r = _dturn_run(tp)
                    if r.returncode != 0:
                        _TURN_FAILED.add(svc); fail(svc, (r.stderr or "container start failed").strip()[:120]); continue
                    verr = _dturn_verify(svc)
                    fail(svc, verr) if verr else good(svc, "start:" + svc)
                    continue
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                if act == "manage":
                    if req.get("listen"):  tp["listen"] = req["listen"].strip()
                    if req.get("connect"): tp["connect"] = req["connect"].strip()
                    if "params" in req:    tp["params"] = (req.get("params") or "").strip(); tp["wrap_key"] = _params_wrapkey(tp["params"])
