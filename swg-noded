NODED_VERSION = _noded_version()
# bare-metal vs docker — reported so the panel can tag the node (containers carry /.dockerenv)
NODE_KIND = "docker" if (os.path.exists("/.dockerenv") or os.path.exists("/run/.containerenv")) else "baremetal"
# …and WHICH container runtime, when it is one. `kind` stays "docker" for both — every behaviour in
# this daemon is the same either way, and flipping ~54 branches to say podman would be a lie about how
# it behaves. This is purely a LABEL, so the panel can call a podman node a podman node instead of
# telling its operator to go and look at docker. Each runtime drops its own marker and only its own:
# docker writes /.dockerenv, podman writes /run/.containerenv (which is also what made T-P7's
# detection wrong before it looked for both).
NODE_RUNTIME = ("podman" if os.path.exists("/run/.containerenv")
                else ("docker" if os.path.exists("/.dockerenv") else ""))
# ⚠️ NODE_KIND is deliberately NOT settable from the environment, and must not become so. It is the
# RUN-MODEL discriminator: ~54 branches in this file read it to choose between host systemd and
# supervised subprocesses, /opt and /var/lib, `docker run` siblings and host units — and the panel
# and SPA read it the same way. A host that runs this daemon in our container image IS a docker node
# for every one of those, whatever else is true about the machine. The two fields below carry
# "what else is true" instead.
#
# platform      a label for the host's OS/management flavour, e.g. "nixos". Presentation only —
#               nothing branches on it.
# declarative   this host's INSTALLATION is owned elsewhere (a NixOS module, a config-management
#               run), so the panel must not offer to mutate it: no self-update, no re-enrolment
#               one-liner, no `curl | sudo bash` recovery. Peers, routing and interfaces stay fully
#               mutable — that is the product; only installation state is off limits.
#
# Both come from the environment, because both delivery methods set them identically: our images
# under `virtualisation.oci-containers` pass them as container env, our programs from the Nix store
# get them from the unit's Environment=. Unset means ABSENT from the snapshot, so an ordinary node's
# report is byte-identical to what it sent before these existed.
NODE_PLATFORM = re.sub(r"[^a-z0-9_-]", "", (os.environ.get("SWG_NODE_PLATFORM") or "").strip().lower())[:32]
# …and when nothing set it, work it out from the host's own /etc/os-release, so an ordinary Debian or Ubuntu
# box says so too instead of the panel having a badge only NixOS ever earns.
#
# ⚠️ On a CONTAINER node /etc/os-release is the IMAGE's, not the host's — measured: our node image answers
# "Debian GNU/Linux 13 (trixie)" while the box it runs on is NixOS 25.11. Reporting that would badge every
# Docker node Debian, which is worse than an empty badge because it looks authoritative. So a container asks
# the HOST through host_sh, and if it cannot reach the host it reports NOTHING rather than the image's answer.
# The kernel is read locally either way — a container shares the host's.
#
# Computed ONCE, lazily, on the first snapshot: os-release does not change under a running node, and on the
# docker path each host_sh spawns a privileged one-shot container.
_PLATFORM = {"done": False, "id": "", "info": {}}


def _osrel_parse(txt):
    d = {}
    for ln in (txt or "").splitlines():
        k, _, v = ln.partition("=")
        if k and v:
            d[k.strip()] = v.strip().strip('"').strip("'")
    return d


def _platform_detect():
    """(id, {name, version, kernel}) for the HOST's OS — '' when it cannot be established honestly."""
    if _PLATFORM["done"]:
        return _PLATFORM["id"], _PLATFORM["info"]
    _PLATFORM["done"] = True
    osr = {}
    with contextlib.suppress(Exception):
        if NODE_KIND == "docker":
            r = host_sh("cat /etc/os-release 2>/dev/null || cat /usr/lib/os-release 2>/dev/null")
            if r.returncode == 0 and (r.stdout or "").strip():
                osr = _osrel_parse(r.stdout)
        else:
            for _p in ("/etc/os-release", "/usr/lib/os-release"):
                if os.path.exists(_p):
                    osr = _osrel_parse(open(_p).read()); break
    pid = re.sub(r"[^a-z0-9_-]", "", (osr.get("ID") or "").strip().lower())[:32]
    if not pid:
        return "", {}
    info = {"name": (osr.get("PRETTY_NAME") or osr.get("NAME") or "")[:80],
            "version": (osr.get("VERSION_ID") or "")[:32]}
    with contextlib.suppress(Exception):
        info["kernel"] = os.uname().release[:40]      # a container shares the host's kernel — correct on both
    _PLATFORM["id"], _PLATFORM["info"] = pid, {k: v for k, v in info.items() if v}
    return _PLATFORM["id"], _PLATFORM["info"]
NODE_DECLARATIVE = (os.environ.get("SWG_DECLARATIVE") or "").strip().lower() in ("1", "true", "yes", "on")
# The UDP port range this host's firewall is DECLARED to allow, e.g. "51820-51899" or
# "51820-51899,443". Reported so the panel can say when an interface it created listens outside it.
#
# The collision this exists for: interfaces get their ports from the PANEL, at any time, while a
# declarative firewall is evaluated at BUILD time. NixOS filters INPUT by default, so a
# panel-created interface on a stock node syncs, reports healthy, shows its peers — and is
# unreachable from the internet. Measured: firewall at its default, no handshake at all; allow the
# port, immediate handshake and a client routing TCP to the internet through the node. Nothing here
# opens a port — a node rewriting its host's firewall is exactly what a declarative operator
# objects to. It reports, and the panel makes the mismatch loud.
NODE_UDP_PORTS = re.sub(r"[^0-9,\- ]", "", (os.environ.get("SWG_UDP_PORTS") or "").strip())[:200]
# docker network mode (set by the installer via the compose env): "host" = every interface port is on
# the host (no publishing); "bridge" = panel-created interface ports must be published. Bare-metal is
# always "host"-like. The panel uses this to show port-publishing guidance only where it's needed.
NODE_NET = (os.environ.get("NODE_NET") or "host").strip().lower()
if NODE_NET not in ("host", "bridge"):
    NODE_NET = "host"
# In BRIDGE mode the WG interfaces live in THIS container's netns, so turn-proxy containers must join it
# (not the host net) to forward to 127.0.0.1:<port> and be seen by our nft client-IP capture. Our own container
# id is our hostname (docker's default); overridable if the deployment sets a custom hostname.
_SELF_CONTAINER = (os.environ.get("SWG_NODE_CONTAINER") or "").strip() or socket.gethostname()

# A plain-wg interface persists cmd=["wg"], but the docker image ships ONLY `awg` (a superset that also reads/writes
# plain-wg interfaces — they're even set up via `awg setconf`). With no `wg` binary every `wg show`/op would fail,
# so the interface's peers report no handshake/transfer (dashboard throughput, online status, top-talkers all blank).
# Resolve to the tool actually present: fall back to awg when wg is missing. Bare-metal with real wg is unchanged.
_HAVE_WG = shutil.which("wg") is not None
def _wgcmd(cmd):
    return ["awg"] if (cmd == ["wg"] and not _HAVE_WG) else cmd
# can the panel manage this node's host turn-proxy services? bare-metal: always (swg-noded is on the
# host). docker: only when the installer mounted docker.sock (TURN_MANAGE=panel) so we can drive host
# units via a privileged --pid=host helper. Reported so the panel only shows manage/onboard controls
# when they'd actually work.
TURN_MANAGE = (NODE_KIND != "docker") or ((os.environ.get("TURN_MANAGE") or "manual").strip().lower() == "panel")


# ───────────────────────── parsing (pure) ─────────────────────────

def parse_dump(out):
    lines = out.strip().splitlines()
    iface_line = lines[0].split("\t") if lines else []
    peers = []
    for line in lines[1:]:
        f = line.split("\t")
        if len(f) < 8:
            continue
        peers.append({
            "public_key": f[0],
            "preshared_key": None if f[1] in ("(none)", "") else f[1],   # keep PSK so adoption can reuse it
            "endpoint": None if f[2] in ("(none)", "") else f[2],
            "allowed_ips": f[3],
            "last_handshake": int(f[4]) if f[4].isdigit() else 0,
            "rx_bytes": int(f[5]) if f[5].isdigit() else 0,
            "tx_bytes": int(f[6]) if f[6].isdigit() else 0,
        })
    return iface_line, peers


def parse_interface_section(conf_text):
    info, in_iface = {}, False
    for line in conf_text.splitlines():
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]")
            continue
        if in_iface and "=" in s and not s.startswith("#"):
            k, v = s.split("=", 1)
            info[k.strip()] = v.strip()
    return info


def awg_params(info):
    out = {}
    for k in AWG_KEYS:
        if k in info:
            v = info[k]
            out[k] = int(v) if v.isdigit() else v
    return out


def derive_pubkey(cmd, priv):
    """Server public key from a private key (used when the interface is down / dump is empty)."""
    if not priv:
        return None
    try:
        out = run((cmd or ["awg"]) + ["pubkey"], input_text=priv + "\n").stdout.strip()
        return out or None
    except Exception:
        return None


def _link_kind(iface):
    """What the KERNEL says this device is: "awg" (amneziawg), "wg" (wireguard), or "" if it cannot say.

    Strictly stronger than "which CLI answered". On a box whose amneziawg module backs everything, `awg show`
    lists plain WireGuard devices and `wg show` lists AmneziaWG ones — the false positive _ctr_is_awg
    documents, and the reason a self-healed interface's recorded `cmd` is an inference, not a fact: the
    adopt loop simply takes the first tool that answers. The link type is the datapath's own answer about
    itself. Empty for a DOWN interface (no device to ask), where the caller falls back to the record.
    """
    with contextlib.suppress(Exception):
        r = run(["ip", "-d", "link", "show", iface])
        if r.returncode == 0:
            toks = (r.stdout or "").split()
            if "amneziawg" in toks:
                return "awg"
            if "wireguard" in toks:
                return "wg"
    return ""


def build_meta(iface_line, conf_text, endpoint_host, dns, cmd=None, iface=None):
    info = parse_interface_section(conf_text)
    addr = info.get("Address", "").split(",")[0].strip()
    subnet = None
    if addr and "/" in addr:
        try:
            import ipaddress
            subnet = str(ipaddress.ip_network(addr, strict=False))
        except Exception:
            subnet = addr.rsplit("/", 1)[0]
    port = int(iface_line[2]) if len(iface_line) > 2 and iface_line[2].isdigit() else None
    if not port and str(info.get("ListenPort", "")).strip().isdigit():   # fall back to the .conf
        port = int(str(info["ListenPort"]).strip())
    pub = iface_line[1] if len(iface_line) > 1 and iface_line[1] else derive_pubkey(cmd, info.get("PrivateKey"))
    return {
        "public_key": pub,
        "listen_port": port,
        # the LINK MTU, live first and the .conf as the fallback — same rule as listen_port above, and for the
        # same reason: a DOWN interface still has a desired value, and the panel converges to it either way.
        # The panel needs this reported to tell "not applied yet" from "the operator changed it on the box".
        "mtu": iface_mtu(iface, info),
        "endpoint": (f"{endpoint_host}:{port}" if endpoint_host and port else None),
        "address": addr or None,
        "subnet": subnet,
        "awg_params": awg_params(info),
        # WHICH TOOL actually drives this interface. The panel used to infer wg-vs-awg from the presence of
        # obfuscation params, which is an inference about the FILE, not the datapath: a plain-WG conf that
        # picked up S/H/I lines reads as AmneziaWG while `awg show` cannot even see the device. The node is
        # the only one who knows, so it says so. (Older panels ignore the field; older nodes omit it, and the
        # panel keeps the old inference for them.)
        "tool": (_link_kind(iface) if iface else "") or (cmd or ["wg"])[0],
        "dns": dns or [],
        # the pubkey of the node's on-disk key backup for this iface — lets the panel tell whether a
        # "Restore" can actually recover the blessed key (backup == blessed) or is futile (a re-seeded node
        # whose backup is the CURRENT key, so the original is gone). Absent-key => None (old node / no backup).
        "backup_public_key": ((read_iface_backup(iface) or {}).get("public_key") if iface else None),
    }


def iface_mtu(iface, info=None):
    """The interface's MTU: the live link's, else the .conf's `MTU =`, else None. `info` is an already
    parsed [Interface] section (build_meta has one); pass it to avoid re-reading the conf."""
    if iface:
        try:
            r = run(["ip", "-o", "link", "show", "dev", iface])
            if r.returncode == 0:
                m = re.search(r"\bmtu (\d+)\b", r.stdout or "")
                if m:
                    return int(m.group(1))
        except Exception:
            pass
    v = str((info or {}).get("MTU", "")).strip()
    return int(v) if v.isdigit() else None


# ───────── interface keypair backup (the node keeps a copy of each iface's blessed identity) ─────────
# The panel only ever stores the PUBLIC key, so it can't revert a server-key change on its own. Instead
# the NODE keeps a local backup of {private_key, public_key, listen_port, address} per interface — the
# private key is already in the .conf, so this adds no new exposure. If the live key diverges, the panel
# flags it and can ask the node to Restore (from this backup) or Adopt (re-baseline the backup).
IFACE_KEYS_DIR = "/var/lib/swg-noded/iface-keys"
def _iface_backup_path(iface): return os.path.join(IFACE_KEYS_DIR, iface + ".json")

def harvest_iface_backup(conf_text, cmd=None):
    """Blessed-identity record from a .conf, or None if it has no private key."""
    info = parse_interface_section(conf_text)
    priv = (info.get("PrivateKey") or "").strip()
    if not priv:
        return None
    port = str(info.get("ListenPort", "")).strip()
    return {"private_key": priv, "public_key": derive_pubkey(cmd, priv),
            "listen_port": int(port) if port.isdigit() else None,
            "address": (info.get("Address", "").split(",")[0].strip() or None),
            "saved_at": int(time.time())}

def write_iface_backup(iface, rec):
    with contextlib.suppress(Exception):
        os.makedirs(IFACE_KEYS_DIR, exist_ok=True)
        p = _iface_backup_path(iface); tmp = p + ".tmp"
        with open(tmp, "w") as f:
            json.dump(rec, f)
        os.chmod(tmp, 0o600); os.replace(tmp, p)

def read_iface_backup(iface):
    with contextlib.suppress(Exception):
        with open(_iface_backup_path(iface)) as f:
            return json.load(f)
    return None

def list_iface_backups():
    """{iface: backup_public_key} for every on-disk key backup — reported in the snapshot so the panel knows
    which interfaces can be cleanly RESTORED from the node's own key even after the live interface is gone
    (a delete / wipe). Live interfaces already carry backup_public_key in their meta; this covers the missing ones."""
    out = {}
    with contextlib.suppress(Exception):
        for fn in (os.listdir(IFACE_KEYS_DIR) if os.path.isdir(IFACE_KEYS_DIR) else []):
            if fn.endswith(".json"):
                rec = read_iface_backup(fn[:-5]) or {}
                if rec.get("public_key"):
                    out[fn[:-5]] = rec["public_key"]
    return out

def ensure_iface_backup(iface, conf_text, cmd=None):
    """Write a backup if one doesn't exist yet — covers create/onboard/install/first-sight. Re-install
    and conversion overwrite it explicitly; Adopt re-baselines it via a panel request."""
    if not conf_text or os.path.exists(_iface_backup_path(iface)):
        return
    rec = harvest_iface_backup(conf_text, cmd)
    if rec:
        write_iface_backup(iface, rec)


# ───────── interface-key vault crypto (pure stdlib: X25519 + HKDF-SHA256 + keystream-XOR + HMAC) ─────────
# Lets the node SEAL its interface private key to the operator's vault public key so a FULL wipe can still be
# restored cleanly, and UNSEAL a key the browser re-sealed to this node's transport key at restore time — the
# panel only ever relays ciphertext, never plaintext. Round-trips against WebCrypto (X25519/HKDF/HMAC), so no
# openssl / third-party dep — bare-metal and container behave identically. See docs/…-KEY-VAULT-PLAN.md §2.
_IVK_P = 2**255 - 19
def _x25519(k_bytes, u_bytes):
    A24 = 121665
    k = bytearray(k_bytes[:32]); k[0] &= 248; k[31] &= 127; k[31] |= 64
    k = int.from_bytes(k, "little")
    u = bytearray(u_bytes[:32]); u[31] &= 127
    x1 = int.from_bytes(u, "little")
    x2, z2, x3, z3, swap = 1, 0, x1, 1, 0
    for t in range(254, -1, -1):
        kt = (k >> t) & 1
        swap ^= kt
        if swap: x2, x3, z2, z3 = x3, x2, z3, z2
        swap = kt
        A = (x2 + z2) % _IVK_P; AA = (A * A) % _IVK_P
        B = (x2 - z2) % _IVK_P; BB = (B * B) % _IVK_P
        E = (AA - BB) % _IVK_P
        C = (x3 + z3) % _IVK_P; D = (x3 - z3) % _IVK_P
        DA = (D * A) % _IVK_P; CB = (C * B) % _IVK_P
        x3 = pow((DA + CB) % _IVK_P, 2, _IVK_P)
        z3 = (x1 * pow((DA - CB) % _IVK_P, 2, _IVK_P)) % _IVK_P
        x2 = (AA * BB) % _IVK_P
        z2 = (E * ((AA + (A24 * E)) % _IVK_P)) % _IVK_P
    if swap: x2, x3, z2, z3 = x3, x2, z3, z2
    return ((x2 * pow(z2, _IVK_P - 2, _IVK_P)) % _IVK_P).to_bytes(32, "little")
_IVK_BASE = b"\x09" + b"\x00" * 31
def _ivk_pub(priv): return _x25519(priv, _IVK_BASE)
def _ivk_hkdf(ikm, salt, info, length):
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    okm, t, i = b"", b"", 1
    while len(okm) < length:
        t = hmac.new(prk, t + info + bytes([i]), hashlib.sha256).digest(); okm += t; i += 1
    return okm[:length]
def ivk_seal(vault_pub_b64, plaintext):
    """Seal bytes to an X25519 public key → {eph, ct, mac} (base64). Only the matching private key can open it."""
    vault_pub = base64.b64decode(vault_pub_b64)
    eph_priv = secrets.token_bytes(32); eph_pub = _ivk_pub(eph_priv)
    shared = _x25519(eph_priv, vault_pub)
    ks = _ivk_hkdf(shared, eph_pub, b"swg-ivk-enc", len(plaintext))
    mk = _ivk_hkdf(shared, eph_pub, b"swg-ivk-mac", 32)
    ct = bytes(a ^ b for a, b in zip(plaintext, ks))
    mac = hmac.new(mk, eph_pub + ct, hashlib.sha256).digest()
    return {"eph": base64.b64encode(eph_pub).decode(), "ct": base64.b64encode(ct).decode(),
            "mac": base64.b64encode(mac).decode()}
def ivk_unseal(priv, blob):
    """Open a {eph, ct, mac} blob sealed to `priv` (32 raw bytes). Raises on a bad MAC / wrong key."""
    eph_pub = base64.b64decode(blob["eph"]); ct = base64.b64decode(blob["ct"]); mac = base64.b64decode(blob["mac"])
    shared = _x25519(priv, eph_pub)
    mk = _ivk_hkdf(shared, eph_pub, b"swg-ivk-mac", 32)
    if not hmac.compare_digest(hmac.new(mk, eph_pub + ct, hashlib.sha256).digest(), mac):
        raise ValueError("bad mac")
    ks = _ivk_hkdf(shared, eph_pub, b"swg-ivk-enc", len(ct))
    return bytes(a ^ b for a, b in zip(ct, ks))

# This node's TRANSPORT keypair — persistent, node-owned. The browser re-seals a vaulted interface key to this
# public key at restore so the panel relays only ciphertext; the node opens it with the private half.
_TRANSPORT_PATH = os.path.join(IFACE_KEYS_DIR, "..", "transport.json")
def transport_keypair():
    with contextlib.suppress(Exception):
        with open(_TRANSPORT_PATH) as f:
            d = json.load(f)
            if d.get("priv") and d.get("pub"): return d
    priv = secrets.token_bytes(32); pub = _ivk_pub(priv)
    d = {"priv": base64.b64encode(priv).decode(), "pub": base64.b64encode(pub).decode()}
    with contextlib.suppress(Exception):
        os.makedirs(os.path.dirname(_TRANSPORT_PATH), exist_ok=True)
        p = _TRANSPORT_PATH; tmp = p + ".tmp"
        with open(tmp, "w") as f: json.dump(d, f)
        os.chmod(tmp, 0o600); os.replace(tmp, p)
    return d
def transport_pub(): return transport_keypair().get("pub") or ""
def transport_priv(): return base64.b64decode(transport_keypair().get("priv") or "")

_IVK_VAULT_PUB = ""
_IVK_SEALED = {}   # iface -> {pub, eph, ct, mac} : sealed interface keys the panel doesn't yet hold (ride the next snapshot)
def ivk_process(vault_pub, want):
    """Seal the interface keys the panel asked for (`want`) to its vault public key; drop ones it now holds. A
    sealed blob rides the NEXT snapshot. No-op without a vault pub or a readable on-disk backup key."""
    global _IVK_VAULT_PUB
    if vault_pub: _IVK_VAULT_PUB = vault_pub
    want = set(want or [])
    for ifn in list(_IVK_SEALED):
        if ifn not in want: _IVK_SEALED.pop(ifn, None)   # panel now holds it → stop sending
    if not (_IVK_VAULT_PUB and want): return
    for ifn in want:
        with contextlib.suppress(Exception):
            rec = read_iface_backup(ifn) or {}
            priv = (rec.get("private_key") or "").strip()
            if not priv: continue
            cur = _IVK_SEALED.get(ifn)
            # ⚠️ "Already sealed THIS key" is only half the question — the other half is WHICH VAULT it was
            # sealed to. Without `vault` here, an operator who resets the panel's encryption keeps every
            # existing blob for ever: the interface key did not change, so nothing re-seals, and the panel
            # goes on reporting escrow as healthy over ciphertext whose private half no longer exists.
            # Stamping it makes the staleness visible to both ends and re-seals on the next pass.
            if cur and cur.get("pub") == rec.get("public_key") and cur.get("vault") == _IVK_VAULT_PUB:
                continue
            blob = ivk_seal(_IVK_VAULT_PUB, priv.encode())
            blob["pub"] = rec.get("public_key") or ""
            blob["vault"] = _IVK_VAULT_PUB
            _IVK_SEALED[ifn] = blob


def peer_view(peers, last, dt, online_max, now):
    out = []
    for p in peers:
        age = (now - p["last_handshake"]) if p["last_handshake"] else None
        prev = last.get(p["public_key"])
        rs = ts = 0.0
        if prev and dt > 0:
            rs = max(0, p["rx_bytes"] - prev[0]) / dt
            ts = max(0, p["tx_bytes"] - prev[1]) / dt
        out.append({
            "public_key": p["public_key"], "endpoint": p["endpoint"],
            "preshared_key": p.get("preshared_key"),   # so adoption can reuse the on-wire PSK (panel owns PSKs)
            "allowed_ips": p["allowed_ips"], "rx_bytes": p["rx_bytes"], "tx_bytes": p["tx_bytes"],
            "rx_speed": rs, "tx_speed": ts,
            "last_handshake": p["last_handshake"] or None, "handshake_age": age,
            "online": age is not None and age <= online_max,
        })
    return out


# ───────────────────────── node health (cheap: /proc + statvfs, no subprocess) ─────────────────────────
#
# Everything here reads in-kernel pseudo-files (/proc/{loadavg,meminfo,uptime,stat}) and
# does one statvfs() syscall per mount — microseconds total, no process spawns. Far cheaper
# than the `awg show dump` we already run per interface, so sampling it every loop is free.
# proc_root / statvfs are injectable so the parsing is testable against a fixture.

def _read_proc(proc_root, name):
    with open(os.path.join(proc_root, name)) as f:
        return f.read()


def read_loadavg(proc_root="/proc"):
    p = _read_proc(proc_root, "loadavg").split()
    return [float(p[0]), float(p[1]), float(p[2])]


def read_meminfo(proc_root="/proc"):
    vals = {}
    for line in _read_proc(proc_root, "meminfo").splitlines():
        k, _, rest = line.partition(":")
        f = rest.split()
        if f and f[0].isdigit():
            vals[k] = int(f[0]) * 1024          # kB -> bytes
    total = vals.get("MemTotal", 0)
    avail = vals.get("MemAvailable", vals.get("MemFree", 0))   # MemAvailable fallback for old kernels
    mem = {"total": total, "available": avail, "used": max(0, total - avail)}
    if "SwapTotal" in vals:
        mem["swap_total"] = vals["SwapTotal"]
        mem["swap_used"] = max(0, vals["SwapTotal"] - vals.get("SwapFree", 0))
    return mem


def read_uptime(proc_root="/proc"):
    return float(_read_proc(proc_root, "uptime").split()[0])


_virt = None


def read_virt(proc_root="/proc"):
    """True when this kernel runs under a hypervisor — i.e. /proc/stat's cpuN are vCPUs, not physical CPUs.

    Static for the life of the box, so it is detected once and cached. Read-only, no subprocess (deliberately
    not `systemd-detect-virt`). x86 kernels set the `hypervisor` CPU flag under any mainstream hypervisor;
    /sys/hypervisor/type catches Xen and some ARM guests. A container inherits its host's answer, which is
    correct: /proc is the host's.
    """
    global _virt
    if _virt is not None:
        return _virt
    v = False
    if proc_root == "/proc":                       # absolute path — skip it for injected fixtures
        with contextlib.suppress(Exception):
            v = os.path.exists("/sys/hypervisor/type")
    if not v:
        with contextlib.suppress(Exception):
            for ln in _read_proc(proc_root, "cpuinfo").splitlines():
                if ln.startswith("flags") and " hypervisor" in (" " + ln.split(":", 1)[-1] + " "):
                    v = True
                    break
    _virt = v
    return v


def read_ncpu(proc_root="/proc"):
    with contextlib.suppress(Exception):
        n = sum(1 for ln in _read_proc(proc_root, "stat").splitlines()
                if ln.startswith("cpu") and len(ln) > 3 and ln[3].isdigit())
        if n:
            return n
    return os.cpu_count() or 1


# /proc/stat exposes cumulative jiffy counters, not a rate, so utilization needs two samples.
# Keyed by proc_root so an injected fixture never diffs against the real /proc.
_cpu_prev = {}


def _cpu_fields(proc_root="/proc"):
    """{"cpu": (busy, total, iowait), "cpu0": (busy, total, iowait), ...} from /proc/stat.

    Sums user..steal only: the kernel folds `guest` into `user` and `guest_nice` into `nice`,
    so adding all ten fields double-counts them. Not-busy is idle + iowait — excluding iowait is
    what stops a disk wait from reading as CPU. `steal` stays in busy: the hypervisor took the
    core, so the node genuinely cannot get work done.
    """
    out = {}
    for ln in _read_proc(proc_root, "stat").splitlines():
        f = ln.split()
        if not f or not f[0].startswith("cpu"):
            continue
        vals = [int(x) for x in f[1:9]]      # user nice system idle iowait irq softirq steal
        vals += [0] * (8 - len(vals))        # kernels before 2.6.11 have no `steal`
        total = sum(vals)
        out[f[0]] = (total - vals[3] - vals[4], total, vals[4])
    return out


def read_cpu_pct(proc_root="/proc"):
    """(mean, [per-vcpu…], iowait) utilization % since the previous call — None until a baseline exists.

    `mean` comes from the aggregate `cpu` line, which the kernel already sums across cores, so it
    is inherently 0-100 and directly comparable between nodes of different core counts (a fully
    busy 8-core node reads 100, not 800). The per-vCPU list is what the mean hides: a pinned
    single-threaded datapath (amneziawg-go, swg-sni) saturates one core, and on an 8-vCPU box that
    is a mean of ~12%. Reporting every vCPU lets the panel say exactly which and how many are hot
    rather than inferring a count from (max - mean), which is only ever right by accident.

    The list is ordered by vCPU index (cpu0, cpu1, …), so position is meaningful.
    """
    cur = _cpu_fields(proc_root)
    prev = _cpu_prev.get(proc_root)
    if not prev or "cpu" not in cur or "cpu" not in prev:
        _cpu_prev[proc_root] = cur
        return None                          # first call after start: nothing to diff against
    dt0 = cur["cpu"][1] - prev["cpu"][1]
    if dt0 < 0:                              # counters went backwards (reboot / cpu hotplug) — re-baseline
        _cpu_prev[proc_root] = cur
        return None
    if dt0 == 0:
        # Two calls inside one clock tick (USER_HZ=100 → 10 ms). KEEP the older baseline rather than
        # overwrite it with an identical sample, so the next call still has a usable window to diff.
        return None
    _cpu_prev[proc_root] = cur

    def pct(key, idx=0):
        v0, v1 = prev[key], cur[key]
        dt = v1[1] - v0[1]
        if dt <= 0:                          # this core idle-halted, or was hotplugged in
            return None
        return max(0.0, min(100.0, (v1[idx] - v0[idx]) / dt * 100.0))

    mean = pct("cpu")
    if mean is None:
        return None
    # Aggregate iowait only. Per-CPU iowait is unreliable (the kernel credits it to whichever CPU was
    # idle when the I/O completed), so we never report it per core — see Documentation/filesystems/proc.rst.
    iowait = pct("cpu", 2) or 0.0
    cores = []
    for k in sorted((k for k in cur if k != "cpu"), key=lambda k: int(k[3:])):   # cpu0, cpu1, … in index order
        if k not in prev:
            continue
        p = pct(k)
        cores.append(mean if p is None else p)      # a core that reported no elapsed ticks: fall back to the mean
    return (round(mean, 1), cores, round(iowait, 1))


def disk_usage(mount, statvfs=os.statvfs):
    st = statvfs(mount)
    total = st.f_blocks * st.f_frsize
    return {"mount": mount, "total": total,
            "used": max(0, total - st.f_bfree * st.f_frsize),
            "free": st.f_bavail * st.f_frsize}


def collect_health(proc_root="/proc", mounts=None, statvfs=os.statvfs):
    """A small per-node health block. Each field is collected independently and a failure
    in one (e.g. a missing /proc file in a stripped container) never sinks the rest."""
    mounts = mounts if mounts is not None else ["/"]
    h = {}
    with contextlib.suppress(Exception):
        h["load"] = read_loadavg(proc_root)
    with contextlib.suppress(Exception):
        # Real utilization, additive: an older panel ignores it, and a panel that has it prefers it
        # over the load-derived figure. Absent on the very first sync (no baseline) — see read_cpu_pct.
        # cpu_cores is per-vCPU (rounded ints, index order); the panel derives peak + saturated count
        # from it. One int per vCPU is cheaper on the wire than the two summary scalars it replaces.
        cpu = read_cpu_pct(proc_root)
        if cpu is not None:
            h["cpu_pct"] = cpu[0]
            if cpu[1]:
                h["cpu_cores"] = [int(round(c)) for c in cpu[1]]
            h["cpu_iowait_pct"] = cpu[2]     # aggregate only — this is the share that used to masquerade as CPU
    with contextlib.suppress(Exception):
        h["virt"] = read_virt(proc_root)     # cpuN are vCPUs (VM) vs CPUs (bare metal) — only the label differs
    with contextlib.suppress(Exception):
        h["ncpu"] = read_ncpu(proc_root)
    with contextlib.suppress(Exception):
        h["mem"] = read_meminfo(proc_root)
    with contextlib.suppress(Exception):
        h["uptime"] = read_uptime(proc_root)
    disks = []
    for m in mounts:
        with contextlib.suppress(Exception):
            disks.append(disk_usage(m, statvfs))
    if disks:
        h["disk"] = disks
    return h


# ───────────────────────── io ─────────────────────────

def run(args, input_text=None, timeout=20):
    # Fail-safe: a MISSING binary (e.g. `nft` on a node/image without nftables) must never crash a caller —
    # return a non-zero result like a normal command failure so callers handle it (smart routing then no-ops
    # instead of taking down the sync loop). Same for a timeout.
    try:
        return subprocess.run(args, input=input_text, capture_output=True, text=True, timeout=timeout)
    except (FileNotFoundError, PermissionError) as e:
        return subprocess.CompletedProcess(args, 127, "", str(e))
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timeout")


# ── Reconcile op backoff / quarantine ──────────────────────────────────────────────────────────────────────
# A persistently-failing agent op (a datapath that keeps rejecting an add, a wedged iface, …) must not spawn the
# agent and do futile work every sync — that is what pinned CPU before. Track failures per key: while a key is in
# backoff we SKIP the op (still surfaced as an error so the panel sees it), then retry on an exponential, capped
# schedule so it self-heals the moment the condition clears. Cleared on the first success. In-memory by design —
# a restart re-attempts once (cheap) and re-quarantines if still broken.
_OP_BACKOFF = {}   # key -> [fail_count, next_attempt_monotonic]
# ...and WHY it failed, so a quarantined op can keep reporting the reason instead of "retrying later".
# A skipped attempt still has to answer the operator's question, and that question is never "is it being
# retried" — it is "what is wrong". Measured: with only the generic text, the panel showed
# `awg1: retrying later (repeated failure)` for a missing conf file, which is the same dead end §7.5 found,
# one sentence further along.
_OP_LASTERR = {}
def _op_ready(key):
    st = _OP_BACKOFF.get(key)
    return (not st) or time.monotonic() >= st[1]
def _op_fail(key, base=5.0, cap=300.0, err=None):
    st = _OP_BACKOFF.get(key) or [0, 0.0]
    st[0] += 1; st[1] = time.monotonic() + min(base * (2 ** min(st[0], 8)), cap)   # 10s,20s,…→cap 5min
    _OP_BACKOFF[key] = st
    if err:
        _OP_LASTERR[key] = str(err)
    return st[0]
def _op_err(key):
    return _OP_LASTERR.get(key) or ""
def _op_ok(key):
    _OP_BACKOFF.pop(key, None); _OP_LASTERR.pop(key, None)
_OP_LASTCFG = {}   # key -> last-attempted desired config; a CHANGE clears the backoff so a corrected desired state
def _op_cfg_changed(key, cfg):
    """Self-heal: if an op's DESIRED config changed since its last attempt, reset its backoff so the corrected
    state is retried on the very next sync (~5s) instead of waiting out the exponential backoff (≤5min). This is
    what lets a panel-side fix (e.g. a corrected mesh allowed_ips) take effect immediately rather than slowly."""
    if _OP_LASTCFG.get(key) != cfg:
        _OP_LASTCFG[key] = cfg
        _op_ok(key)
def op_quarantined():
    """keys wedged (≥3 consecutive fails) — merged into the snapshot so a stuck op is visible, not just silent."""
    return sorted(k for k, v in _OP_BACKOFF.items() if v[0] >= 3)


def run_agent(agent, sudo, payload):
    prefix = ["sudo", "-n"] if sudo else []
    try:
        p = run(prefix + [agent], input_text=json.dumps(payload))
    except Exception as e:
        return {"ok": False, "op": payload.get("op"), "error": str(e), "code": "internal"}
    out = (p.stdout or "").strip()
    if not out:
        return {"ok": False, "op": payload.get("op"),
                "error": (p.stderr or "").strip() or "no response", "code": "internal"}
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {"ok": False, "op": payload.get("op"), "error": "agent non-JSON", "code": "internal"}


def _sig_headers(token, body):
    """Per-request signature headers (Phase 4): X-SWG-TS + X-SWG-MAC = hmac_sha256(sha256(token), ts + '.' +
    sha256(body)). The panel stores sha256(token) as token_sha, so it verifies without ever holding the raw token.
    Additive: an old panel ignores these headers; a new one uses them for replay resistance. Harmless if token=''."""
    if not token:
        return {}
    ts = str(int(time.time()))
    key = hashlib.sha256(token.encode()).hexdigest()
    mac = hmac.new(key.encode(), (ts + "." + hashlib.sha256(body or b"").hexdigest()).encode(), hashlib.sha256).hexdigest()
    return {"X-SWG-TS": ts, "X-SWG-MAC": mac}


def post_json(url, token, obj, panel, timeout=20, source_ip=""):
    """POST JSON to the panel. TLS posture comes from `panel`:
         fingerprint set -> pin sha256 (verified during the handshake, before any
                            bytes are sent, and fails closed if it can't be read);
         verify true     -> system CA verification;
         otherwise       -> unverified (self-signed; encrypted but no MITM protection).
    `source_ip` (optional) binds the local source IP for the connection (the node's "panel connection IP"
    role); callers fall back to unbound on failure so a bad IP can't cut the node off from the panel.
    Returns (status, dict). status 0 means the request never completed."""
    body = json.dumps(obj).encode()
    headers = {"Content-Type": "application/json", "Authorization": "Bearer " + token, **_sig_headers(token, body)}
    u = urllib.parse.urlparse(url)
    host = u.hostname
    port = u.port or (443 if u.scheme == "https" else 80)
    path = (u.path or "/") + (("?" + u.query) if u.query else "")
    fp = (panel.get("fingerprint") or "").replace(":", "").lower().strip()
    src = (source_ip, 0) if source_ip else None
    conn = None
    try:
        if u.scheme == "http":
            conn = http.client.HTTPConnection(host, port, timeout=timeout, source_address=src)
        elif u.scheme == "https":
            if panel.get("verify", False) and not fp:
                ctx = ssl.create_default_context()
            else:
                ctx = ssl._create_unverified_context()
            conn = http.client.HTTPSConnection(host, port, timeout=timeout, context=ctx, source_address=src)
            if fp:
                conn.connect()                      # TLS handshake before sending the token
                der = conn.sock.getpeercert(True)
                if not der or hashlib.sha256(der).hexdigest() != fp:
                    return 0, {"error": "tls fingerprint mismatch"}
        else:
            return 0, {"error": f"unsupported url scheme {u.scheme!r}"}
        conn.request("POST", path, body=body, headers=headers)
        resp = conn.getresponse()
        data = (resp.read().decode() or "{}")
        if resp.status >= 400:
            return resp.status, {"error": data[:200]}
        return resp.status, json.loads(data)
    except Exception as e:
        return 0, {"error": str(e)}
    finally:
        if conn is not None:
            with contextlib.suppress(Exception):
                conn.close()


