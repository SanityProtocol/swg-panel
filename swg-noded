                    fail(svc, (w.stderr or "remove failed").strip()[:120]); continue
                rec.pop(svc, None); changed = True; good(svc, "del:" + svc); continue
            if act == "reinstall":          # re-download the binary (fix/update) + restart the unit — ASYNC (see _TURN_JOBS)
                with _TURN_JOBS_LOCK: _job = dict(_TURN_JOBS.get(svc) or {})
                if _job and not _job.get("done"):
                    continue                                 # download/restart running → keep in-flight (card "updating")
                if _job and _job.get("done"):
                    with _TURN_JOBS_LOCK: _TURN_JOBS.pop(svc, None)
                    NODE_PROGRESS.pop(svc, None)
                    fail(svc, _job["err"]) if _job.get("err") else good(svc, "rei:" + svc)
                    continue
                owner = (req.get("owner") or "").strip()
                if not owner:               # fall back to the recorded repo.txt (shared fork dir, then pre-dedup per-instance)
                    for rp in (_turn_repo_path(svc), _turn_repo_path_legacy(svc)):
                        try:
                            with open(rp) as f: owner = f.read().strip()
                        except Exception: owner = ""
                        if owner: break
                if not owner:
                    fail(svc, "no owner repo for reinstall"); continue
                arch = _turn_arch()
                fork = _turn_fork(svc)
                pin_tag, want = _turn_pin(req.get("pin"))                     # panel checksum gate: pin tag + expected sha256
                sbin = "/opt/vk-turn-proxy/.bin/" + fork + "/server"          # shared per-fork binary (a reinstall refreshes it for every instance of the fork)
                binp = "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/server"    # this instance's symlink → the shared binary
                tag = pin_tag or _turn_resolve_tag(owner); vp = _turn_ver_path(svc)
                tmp = sbin + ".new." + _turn_inst(svc)   # per-instance temp then atomically mv over the LIVE binary — curl -o onto a
                dl = " || ".join("curl -4 -fsSL --connect-timeout 20 --max-time 240 --retry 3 --retry-delay 3 --retry-all-errors "   # running executable fails ETXTBSY ("Failure
                                 + shlex.quote(u) + " -o " + shlex.quote(tmp) for u in _turn_dl_urls(owner, arch, tag))          # writing output"); rename keeps the old
                cmd = ("mkdir -p " + shlex.quote(os.path.dirname(sbin)) + " " + shlex.quote(os.path.dirname(binp))          # inode for the running proc until restart.
                       + " && ( [ -f " + shlex.quote(tmp) + " ] || ( " + dl + " ) ) && chmod 755 " + shlex.quote(tmp)      # [ -f tmp ]: the panel-mirror pull (in _work) already placed it → skip GitHub. verify BEFORE the swap either way.
                       + _turn_sha_shell(shlex.quote(tmp), want) + " && mv -f " + shlex.quote(tmp) + " " + shlex.quote(sbin)
                       + " && ln -sfn " + shlex.quote("../.bin/" + fork + "/server") + " " + shlex.quote(binp)
                       + " && printf %s " + shlex.quote(owner) + " > " + shlex.quote(_turn_repo_path(svc)))
                if tag:
                    cmd += " && printf %s " + shlex.quote(tag) + " > " + shlex.quote(vp) + " && chmod 644 " + shlex.quote(vp)
                cmd += " && systemctl restart " + shlex.quote(svc)
                def _work(cmd=cmd, svc=svc, fork=fork, owner=owner, tag=tag, arch=arch, tmp=tmp, want=want):    # runs in a thread; serialise same-fork refreshes on the shared binary
                    with _turn_fork_lock(fork):
                        _turn_panel_fetch(owner, tag, arch, tmp, want)   # P2: pull the (verified) binary from the panel mirror → the heredoc's [ -f tmp ] then skips GitHub
                        w = host_sh(cmd, timeout=340)
                    if w.returncode != 0: return (w.stderr or "reinstall failed").strip()[:140]
                    return _turn_verify(svc)
                _turn_job_launch(svc, rec.get(svc), _work)
                continue
            if act == "title":                # cosmetic label only → update the record, DON'T restart the unit
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                tp["title"] = (req.get("title") or "").strip(); rec[svc] = tp; changed = True
                good(svc, "title:" + svc); continue
            if act == "stop":                 # stop + disable the unit; 'stopped' flag distinguishes it from a crash
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                host_sh(sc_disable_now(svc) + " >/dev/null 2>&1; systemctl stop " + shlex.quote(svc) + " >/dev/null 2>&1; true")
                tp["stopped"] = True; rec[svc] = tp; changed = True; good(svc, "stop:" + svc); continue
            if act == "start":                # re-enable + start the unit
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                w = host_sh(sc_enable_now(svc))
                if w.returncode != 0:
                    fail(svc, (w.stderr or "start failed").strip()[:120]); continue
                tp.pop("stopped", None); rec[svc] = tp; changed = True
                verr = _turn_verify(svc)
                fail(svc, verr) if verr else good(svc, "start:" + svc)
                continue
            unit = host_sh("cat " + shlex.quote(up) + " 2>/dev/null").stdout
            if not unit:
                fail(svc, "unit not found on the node"); continue
            cur = _tp_from_unit(svc, unit)   # resolves env-file or old baked-ExecStart units
            listen, connect, params = cur.get("listen", ""), cur.get("connect", ""), cur.get("params", "")
            if act == "manage":
                if req.get("listen"):  listen = req["listen"].strip()
                if req.get("connect"): connect = req["connect"].strip()
                if "params" in req:    params = (req.get("params") or "").strip()
                if not _turn_input_safe(listen, connect, params):   # belt on the node vs a compromised/MITM panel
                    fail(svc, "refused: control characters in turn parameters"); continue
            elif act == "rotate":
                params = _params_set_wrapkey(params, secrets.token_hex(32))
            # restart: no config change — just rewrite turn.env (unchanged) + restart below
            envp = _turn_env_path(svc)
            env_here = "cat > " + shlex.quote(envp) + " <<'SWGENV'\n" + _turn_env_text(listen, connect, params) + "SWGENV\n"
            if _unit_is_envform(unit):       # fast path: rewrite turn.env + restart, NO daemon-reload (the spike)
                w = host_sh(env_here + "systemctl restart " + shlex.quote(svc))
            else:                            # one-time migrate: move the baked ExecStart onto the EnvironmentFile
                new_unit = _unit_to_envform(unit, svc, _exec_bin(_exec_of(unit)))
                w = host_sh("mkdir -p " + shlex.quote(os.path.dirname(envp)) + "\n" + env_here
                            + "cat > " + shlex.quote(up) + " <<'SWGEOF'\n" + new_unit + "SWGEOF\n"
                            + "systemctl daemon-reload && systemctl restart " + shlex.quote(svc))
            if w.returncode != 0:
                fail(svc, (w.stderr or "restart failed").strip()[:120]); continue
            _ti = req.get("title")   # set if the request carried one, else preserve the existing record's title
            _ti = _ti.strip() if isinstance(_ti, str) else (rec.get(svc) or {}).get("title", "")
            rec[svc] = {"service": svc, "listen": listen, "connect": connect,
                        "wrap_key": _params_wrapkey(params), "params": params}   # reflect even if it won't start
            if _ti: rec[svc]["title"] = _ti
            changed = True
            verr = _turn_verify(svc)
            if verr:
                fail(svc, verr); continue   # report not-running; the record already shows the new (broken) params
            good(svc, act + ":" + svc)
        except Exception as e:
            fail(svc, str(e))
    for sp in (turn_onboard or []):
        try:
            unit = host_sh("cat " + shlex.quote(sp) + " 2>/dev/null").stdout
            if not unit:
                fail(sp, "unit not found at that path"); continue
            base = os.path.basename(sp)
            svc = base[:-8] if base.endswith(".service") else base
            rec[svc] = _parse_tp(svc, _exec_of(unit)); changed = True; good(sp, "onb:" + svc)
        except Exception as e:
            fail(sp, str(e))
    if changed:
        try:
            tmp = TURN_RECORD + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"turn_proxies": list(rec.values())}, f)
            os.replace(tmp, TURN_RECORD)
        except Exception as e:
            res["errors"].append("record: " + str(e))
    return res


# ───────── WDTT (amurcanov/proxy-turn-vk-android): self-contained key-owning VPN as a node service ─────────
# Unlike the -connect turn forks, a WDTT instance OWNS its own userspace-WG interface (built-in). So the panel
# manages it declaratively (like desired_ifaces, NOT request/ack): each sync ships the desired WDTT instance set
# incl. the panel-owned generated-password set; the node installs missing instances, writes a panel-owned
# desired.json + SIGHUPs (WDTT reconciles it with no restart / no tunnel drop — see forks/wdtt/README.md), and removes
# instances no longer desired. WDTT stays the sole writer of its runtime passwords.json (device bindings +
# traffic), which the node reads back into the snapshot. Runs with -no-nat; the node owns the wdtt-subnet
# MASQUERADE via reconcile_egress. Bare-metal only (a container can't reach the userspace-wg UAPI). The unit is
# right-sized for a WG server (CAP_NET_ADMIN + /dev/net/tun), NOT the tight turn-proxy sandbox.
# On docker /opt/... is the container's EPHEMERAL layer — a recreate would lose wg-keys.dat (the server identity) →
# every GETCONF'd client breaks. Root WDTT state under the PERSISTED node volume (/var/lib/swg-noded → ./data/node)
# so identity + the install record survive a container recreate, exactly like bare-metal's on-disk /opt.
WDTT_RECORD = _shared_record("wdtt.json", "/etc/swg-agent/wdtt.json", "SWG_WDTT_RECORD")
WDTT_ROOT = "/var/lib/swg-noded/wdtt" if NODE_KIND == "docker" else "/opt/swg-wdtt"   # per-instance: <root>/<iface>/{server, wdtt.env, desired.json, passwords.json, wg-keys.dat}
WDTT_BIN_DIR = WDTT_ROOT + "/.bin"               # per-fork/arch binary slot; our patched build
WDTT_OWNER = "amurcanov/proxy-turn-vk-android"   # default fork's panel-mirror key
# WDTT fork family: fork id -> panel-mirror owner key. The node pulls each fork's binary from the panel
# mirror keyed on this owner + the "wdtt" tag; the panel maps that to our release (WDTT_BUILDS).
WDTT_FORK_OWNER = {"amurcanov": "amurcanov/proxy-turn-vk-android", "ildarmaga": "ildarmaga/wdtt",
                   "wdttplus": "Ivan4537/WDTT-Plus", "xxcipherx": "XXcipherX/proxy-turn-vk-android",
                   "qwdtt": "SpaceNeuroX/proxy-turn-vk-android"}   # qWDTT takes the default fork flags (-password/-max-passwords/-fixed-config)
def _wdtt_fork(inst):
    f = (inst.get("fork") or "amurcanov").strip()
    return f if f in WDTT_FORK_OWNER else "amurcanov"   # unknown → default (also blocks path injection via the fork string)

def _wdtt_fork_unknown(inst):
    """The requested fork name when THIS build doesn't know it, else "".

    The panel is updated before its nodes are, so a node WILL be asked for a fork it has never heard of.
    _wdtt_fork() sanitizes to amurcanov — right for a path or a label, wrong for an install: it would run
    a different author's server and report it under the requested fork's name, which reads as success.
    Install refuses instead, and says what to do about it."""
    f = (inst.get("fork") or "").strip()
    return "" if (not f or f in WDTT_FORK_OWNER) else f
# An ADOPTED server keeps the name it already had — we don't get to choose it. The name is used as a unit suffix
# and a directory component, so "safe as a path component" is the actual requirement. Keeping the narrow wdtt<N>
# rule here refused a perfectly good adoption AFTER the seed had already stopped the foreign server.
_WDTT_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$")
_WDTT_CIDR_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}/\d{1,2}$")

# ── csqtt (amurcanov/csqtt — the Rust rewrite; raw-IP TUN, io_uring, NO WireGuard) ────────────────────────────
# A SELF-CONTAINED, password-credential proxy like the WDTT family, but a raw-IP datapath (no wg handshake). Run
# as a PARALLEL kind (own record / service names / reply channel) so the proven WDTT path is never threaded
# through — zero regression risk (the same tactic WDTT used vs the turn path). Both run-models are supported;
# io_uring is blocked by docker's DEFAULT seccomp profile, so a docker node needs SWG_NODE_SECCOMP=unconfined.
# The record follows the run-model, exactly like WDTT_RECORD: on docker /etc is the container's own ephemeral
# filesystem, and only /var/lib/swg-noded is a mounted volume. Writing the record to /etc there meant every
# container recreate lost the NODE-OWNED owner password (re-minted, silently rotating it out from under the
# instance's own passwords.json) and any in-flight adoption's captured users.
CSQTT_RECORD = _shared_record("csqtt.json", "/etc/swg-agent/csqtt.json", "SWG_CSQTT_RECORD")
# Where an instance lives. On docker this MUST be inside the container: the server runs as a supervised child of
# swg-noded there (no systemd), and its config-dir + password store have to be readable by the same process that
# writes desired.json and reports the snapshot. Pointing at /opt/swg-csqtt on a docker node is what left the panel
# reporting csqtt servers as active with ZERO passwords — the store was on the host, invisible from in here.
CSQTT_ROOT = ("/var/lib/swg-noded/csqtt" if NODE_KIND == "docker"
              else "/opt/swg-csqtt")            # per-instance: <root>/<iface>/{server, csqtt.env, desired.json, passwords.json}
CSQTT_BIN_DIR = CSQTT_ROOT + "/.bin"             # per-arch binary slot; our swg-panel-patched build
CSQTT_OWNER = "amurcanov/csqtt"                  # panel-mirror owner key
CSQTT_WEBUSER = "swgpanel"                       # csqtt's own admin panel login (node-owned; a strong random pw is minted)
# Instance NAME rule, mirroring _WDTT_NAME_RE: permissive on purpose. Names we CREATE are gated to
# csqtt0..csqtt9999 by the panel; a server we ADOPT arrives with whatever name its operator chose, and a
# strict pattern here rejected it after the panel had already accepted the take-over — the instance was
# dropped on every reconcile with nothing on screen to say why. Still narrow enough for the two things the
# name becomes: a systemd unit name and a path component (no "/", no ".", so no traversal in the rm -rf guard).
_CSQTT_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$")
# csqtt's STOCK datapath values, for a server we did not deploy. OUR build takes --iface/--tun-addr; the authors'
# upstream hardcodes them (src/net_setup.rs: TUN_IFACE = "csqtt1", TUN_ADDR = 10.66.67.1/24) and registers no such
# flags — so a genuinely foreign server has neither in its argv. Same lesson as _wdtt_iface_of: keying the scan on
# a flag only OUR binary passes means it can only ever find servers we already manage, i.e. never the case it is
# for. Adopting on a stock guess is safe here — the adopt re-checks the subnet against the fleet, and csqtt hands
# clients an address at connect time, so a subnet that turns out to differ costs a reconnect, not a lost client.
CSQTT_DEFAULT_IFACE = "csqtt1"
CSQTT_DEFAULT_TUNADDR = "10.66.67.1/24"
_CSQTT_LASTBYTES = {}                            # iface -> {pw: (up+down, at)} for byte-delta liveness (raw datapath has no wg handshake)

def _wdtt_svc(iface): return "swg-wdtt-" + iface
def _wdtt_dir(iface): return WDTT_ROOT + "/" + iface
def _wdtt_unit_path(iface): return turn_unit_dir() + "/" + _wdtt_svc(iface) + ".service"
def _wdtt_bin_shared(fork): return WDTT_BIN_DIR + "/" + fork + "/" + _turn_arch() + "/wdtt-server"
def _wdtt_keyfile(iface): return _wdtt_dir(iface) + "/wg-keys.dat"

_WDTT_PW_CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789"   # WDTT's own unambiguous alphabet
def _gen_wdtt_password():
    """The owner/bootstrap -password. NODE-OWNED (the panel never holds it): minted here on first install,
    persisted in the node record + wdtt.env, and sealed to the operator vault so it survives a full wipe."""
    return "".join(secrets.choice(_WDTT_PW_CHARS) for _ in range(16))

def _wdtt_load():
    try:
        with open(WDTT_RECORD) as f:
            d = json.load(f)
        w = d.get("wdtt") if isinstance(d, dict) else None
        return {i["iface"]: i for i in (w or []) if isinstance(i, dict) and i.get("iface")}
    except Exception:
        return {}

def _wdtt_save(instances):
    with contextlib.suppress(Exception):
        os.makedirs(os.path.dirname(WDTT_RECORD), exist_ok=True)
        tmp = WDTT_RECORD + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"wdtt": list(instances.values())}, f)
        os.replace(tmp, WDTT_RECORD)
    return os.path.isfile(WDTT_RECORD)   # the caller reports a failed write: adopt_failed / await_restore /
                                         # panel_managed all live in this file, and losing it silently reverts
                                         # an acknowledged instance to "never acknowledged"

def _wdtt_subnet(cidr):
    """10.66.79.1/24 → 10.66.79.0/24 (the -s match for the egress MASQUERADE)."""
    try:
        return str(ipaddress.ip_network(cidr, strict=False))
    except Exception:
        return ""

_WDTT_RAW_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$")
_IPV4_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}$")

def _wdtt_raw(inst):
    """(listen, iface, addr) for an instance's RAW-IP listener, or None when raw is off.

    Raw is qWDTT-only and opt-in: the operator picks a port, the panel derives the TUN name + subnet
    (the fork's own defaults are process-global constants, so siblings would fight over one TUN — see
    forks/qwdtt/README.md). Anything malformed reads as OFF rather than as a half-configured listener."""
    port = str((inst or {}).get("raw_port") or "").strip()
    if not port.isdigit() or not (1 <= int(port) <= 65535):
        return None
    ifn = ((inst or {}).get("raw_iface") or "").strip()
    addr = ((inst or {}).get("raw_addr") or "").strip()
    if not _WDTT_RAW_NAME_RE.match(ifn) or not _WDTT_CIDR_RE.match(addr):
        return None
    # Bind the instance's OWN listen address, not the wildcard. The raw port is one fixed number (the app
    # dials that and nothing else), so a wildcard bind would hand the whole box to the first raw instance —
    # while the address is exactly what the app DOES take from the link, so one IP per raw server keeps a
    # multi-IP node able to run several. Falls back to the wildcard for a wildcard-bound instance.
    lip = str((inst or {}).get("listen") or "")
    lip = lip.rsplit(":", 1)[0].strip() if ":" in lip else ""
    if not _IPV4_RE.match(lip or ""):
        lip = "0.0.0.0"
    return (lip + ":" + port, ifn, addr)

def _wdtt_valid(inst):
    """Defence-in-depth: refuse control chars (interpolated into a root heredoc) + basic shape. The panel
    validates too — this is the belt on the node against a compromised/MITM panel."""
    if not _WDTT_NAME_RE.match(inst.get("iface") or ""):
        return False
    if not _WDTT_CIDR_RE.match(inst.get("wg_addr") or ""):
        return False
    if ":" not in (inst.get("listen") or ""):
        return False
    strs = [inst.get("iface"), inst.get("wg_addr"), inst.get("listen"), str(inst.get("wg_port") or ""),
            inst.get("password") or "", inst.get("params") or "",
            inst.get("raw_iface") or "", inst.get("raw_addr") or "", str(inst.get("raw_port") or "")]
    for pw, e in (inst.get("passwords") or {}).items():
        strs.append(pw)
        if isinstance(e, dict):
            strs += [e.get("vk_hash") or "", e.get("ports") or ""]
    return _turn_input_safe(*strs)

def _wdtt_desired_body(passwords):
    """The panel-owned desired.json body — only the four panel-owned fields per password (never runtime state)."""
    out = {}
    for pw, e in (passwords or {}).items():
        e = e or {}
        out[pw] = {"expires_at": int(e.get("expires_at") or 0), "vk_hash": str(e.get("vk_hash") or ""),
                   "ports": str(e.get("ports") or ""), "is_deactivated": bool(e.get("is_deactivated"))}
    return json.dumps({"passwords": out})

def _wdtt_serve_adopted(inst):
    """Union the users recovered from a taken-over server into the set this instance SERVES, for as long as the
    hand-off to the panel is open. Without it the take-over starts our server with only the roster's pre-existing
    peers, so every client the foreign server already had is refused ("wrong connection password") until the
    import lands a sync or two later — a visible outage in the one flow whose whole promise is that existing
    clients keep working. Union, never replace: a password the panel already sends wins, and the extra entries
    evaporate the moment the hand-off closes."""
    au = inst.get("adopt_users") or {}
    if not au:
        return
    dtls = (str(inst.get("listen") or "").rsplit(":", 1)[-1]) or "56000"
    ports = dtls + "," + str(inst.get("wg_port") or 56001) + ",9000"   # same shape the panel composes
    pwds = dict(inst.get("passwords") or {})
    for pw, m in au.items():
        if pw in pwds:
            continue
        m = m if isinstance(m, dict) else {}
        pwds[pw] = {"expires_at": int(m.get("expires_at") or 0), "vk_hash": str(m.get("vk_hash") or ""),
                    "ports": ports, "is_deactivated": bool(m.get("is_deactivated"))}
    inst["passwords"] = pwds


def _wdtt_env_text(inst):
    cfgdir = _wdtt_dir(inst["iface"])
    _raw = _wdtt_raw(inst)
    # The RAW listener is one group of flags or nothing at all. It rides a SINGLE unbraced var for the same
    # reason SWG_PARAMS does: ${...} passes an empty argument when unset, and the server then exits on an
    # unexpected positional. Empty here = raw off, no flags, stock behaviour.
    _rawflags = ("-listen-raw %s -raw-iface %s -raw-addr %s" % _raw) if _raw else ""
    return ("SWG_IFACE=%s\nSWG_WGADDR=%s\nSWG_LISTEN=%s\nSWG_WGPORT=%s\nSWG_CFGDIR=%s\nSWG_DESIRED=%s\n"
            "SWG_PASSWORD=%s\nSWG_MAXPW=%s\nSWG_RAWFLAGS=%s\nSWG_PARAMS=%s\n" % (
                inst["iface"], inst["wg_addr"], inst["listen"], inst.get("wg_port") or 56001, cfgdir,
                cfgdir + "/desired.json", inst.get("password") or "",
                inst.get("max_passwords") or _wdtt_maxpw_for(inst.get("wg_addr") or ""), _rawflags,
                (inst.get("params") or "").strip()))   # operator extra ExecStart flags (systemd splits on whitespace → argv, never a shell)

def _wdtt_unit_text(iface, binp, cfgdir, fork):
    # Right-sized for a WireGuard server (validated live): NET_ADMIN + /dev/net/tun, config-dir the only
    # writable path. NOT the turn sandbox (CAP_NET_BIND_SERVICE-only would block TUN creation).
    # Per-fork tail: both forks share -config-dir/-desired/-no-nat/-password (unified desired.json+SIGHUP
    # contract). ildarmaga uses -max-users (not -max-passwords), -fixed-config (device-agnostic, wg parity),
    # and a per-instance localhost admin port (reuses SWG_WGPORT — TCP:port ≠ the WG UDP:port).
    if fork == "ildarmaga":
        # The current ildarmaga build registers NO -no-panel flag (the panel is gated internally + its DB is already
        # redirected to the config-dir, so nothing writes /etc/wdtt); passing -no-panel crashes it with
        # "flag provided but not defined". It DOES run a localhost admin endpoint (default 127.0.0.1:2861), so give
        # each instance its own port (reuse the WG port number — TCP ≠ the WG UDP socket) to avoid a multi-instance clash.
        forkflags = " -password ${SWG_PASSWORD} -max-users ${SWG_MAXPW} -fixed-config -admin-addr 127.0.0.1:${SWG_WGPORT}"
    elif fork == "wdttplus":
        # wdttplus has an in-app admin socket + Telegram bot (unused under -desired) → -no-panel, like ildarmaga.
        forkflags = " -password ${SWG_PASSWORD} -max-passwords ${SWG_MAXPW} -fixed-config -no-panel"
    else:
        forkflags = " -password ${SWG_PASSWORD} -max-passwords ${SWG_MAXPW} -fixed-config"
    return ("[Unit]\nDescription=swg-wdtt (" + WDTT_FORK_OWNER.get(fork, WDTT_OWNER) + ") — " + iface + "\n"
            "After=network-online.target\nWants=network-online.target\n\n"
            "[Service]\nType=simple\n" + _fork_unit_path_env() + "EnvironmentFile=-" + cfgdir + "/wdtt.env\n"
            "ExecStart=" + binp + " -iface ${SWG_IFACE} -wg-addr ${SWG_WGADDR} -listen ${SWG_LISTEN}"
            " -wg-port ${SWG_WGPORT} -config-dir ${SWG_CFGDIR} -desired ${SWG_DESIRED} -no-nat"
            # Operator extra flags. MUST be $SWG_PARAMS, never ${SWG_PARAMS}: systemd treats the braced form as a
            # SINGLE argument (no word-splitting), so an empty value passes one EMPTY argument — the WDTT server
            # then reports "неожиданные аргументы" (unexpected positional) and exits 1, crash-looping forever on
            # the default no-extra-flags case. The unbraced form splits on whitespace and empty contributes nothing
            # (this is also what the turn-proxy units use).
            + forkflags + " $SWG_RAWFLAGS $SWG_PARAMS\n"
            # Restart, but with a BACKOFF. A server that cannot start at all (a missing tool on its PATH, a
            # -listen address that is not on this host) used to respawn every 3s for ever — a dead loop that
            # costs a small node real CPU and fills the journal, and that no reconcile pass interrupted. The
            # delay grows 3s → 5 min over 8 steps, so a transient cause still recovers in seconds and a
            # permanent one settles into one attempt per 5 min. Both keys are systemd ≥254; older systemd
            # logs "Unknown key name" and ignores them, which is exactly today's behaviour.
            "Restart=on-failure\nRestartSec=3\nRestartSteps=8\nRestartMaxDelaySec=300\n"
            "NoNewPrivileges=yes\nAmbientCapabilities=CAP_NET_ADMIN\nCapabilityBoundingSet=CAP_NET_ADMIN\n"
            "DeviceAllow=/dev/net/tun rw\nProtectHome=yes\nProtectSystem=strict\nReadWritePaths=" + cfgdir + "\n"
            "ProtectControlGroups=yes\nProtectKernelModules=yes\nRestrictSUIDSGID=yes\nLockPersonality=yes\n"
            "SystemCallFilter=@system-service\nSystemCallErrorNumber=EPERM\n\n"
            "[Install]\nWantedBy=multi-user.target\n")

# ── Docker run-model ─────────────────────────────────────────────────────────────────────────────────────────
# A container has no systemd, so on a docker node swg-noded runs each WDTT server as a SUPERVISED CHILD PROCESS in
# THIS container. With host networking the server's interface lands in the right netns automatically — exactly like
# the node's own userspace amneziawg-go. reconcile_wdtt relaunches a died server on its next pass (the equivalent of
# systemd Restart=on-failure); SIGHUP reloads desired.json live; SIGTERM runs the server's clean teardown. The
# config-dir (binary symlink + desired.json + wg-keys.dat) lives where noded runs, so nothing goes through host_sh.
_WDTT_PROCS = {}    # iface -> subprocess.Popen (this noded lifetime)

def _wdtt_pidfile(iface): return _wdtt_dir(iface) + "/server.pid"

def _wdtt_argv(inst, binp):
    """The exact server invocation (mirror of _wdtt_unit_text's ExecStart) as an argv list, for a direct Popen."""
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); fork = _wdtt_fork(inst)
    a = [binp, "-iface", iface, "-wg-addr", inst["wg_addr"], "-listen", inst["listen"],
         "-wg-port", str(inst.get("wg_port") or 56001), "-config-dir", cfgdir,
         "-desired", cfgdir + "/desired.json", "-no-nat", "-password", inst.get("password") or ""]
    # Password-pool size. Prefer what is configured (adoption carries the foreign server's own value across, so
    # its store stays consistent); otherwise size it to the tunnel subnet, which is the real ceiling — every
    # client needs an address as well as a slot, so a flat 200 under-serves a /23 and over-promises on a /25.
    maxpw = str(inst.get("max_passwords") or _wdtt_maxpw_for(inst.get("wg_addr") or ""))
    if fork == "ildarmaga":
        a += ["-max-users", maxpw, "-fixed-config", "-admin-addr", "127.0.0.1:" + str(inst.get("wg_port") or 56001)]
    elif fork == "wdttplus":
        a += ["-max-passwords", maxpw, "-fixed-config", "-no-panel"]
    else:
        a += ["-max-passwords", maxpw, "-fixed-config"]
    _raw = _wdtt_raw(inst)          # opt-in RAW-IP listener (qWDTT); absent = not passed at all
    if _raw:
        a += ["-listen-raw", _raw[0], "-raw-iface", _raw[1], "-raw-addr", _raw[2]]
    params = (inst.get("params") or "").strip()
    if params:
        with contextlib.suppress(Exception):
            a += shlex.split(params)
    return a

def _wdtt_docker_pid(iface):
    """The live server pid for iface (tracked Popen, else the pidfile verified against /proc cmdline), or None."""
    p = _WDTT_PROCS.get(iface)
    if p is not None and p.poll() is None:
        return p.pid
    with contextlib.suppress(Exception):
        with open(_wdtt_pidfile(iface)) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if ("-iface\x00" + iface + "\x00").encode() in f.read():
                return pid
    return None

def _wdtt_docker_alive(iface): return _wdtt_docker_pid(iface) is not None

def _wdtt_write_cfgdir(inst, binshared, binp, cfgdir):
    """Lay down the config-dir the server reads — binary symlink + wdtt.env + desired.json + optional vault-restore
    key — with pure os calls. Works for BOTH run-models: the docker subprocess (in-container) and bare-metal (where
    swg-noded runs as root, so /opt/swg-wdtt is writable). Writing NATIVELY, not through a host_sh heredoc, means a
    partial failure RAISES before the caller writes/enables the unit — so there's never a half-installed instance to
    wedge the reconcile. (host_sh is unusable for docker anyway: it nsenters the HOST, but these files + the child
    process must live in the node container.)"""
    os.makedirs(cfgdir, exist_ok=True); os.makedirs(os.path.dirname(binshared), exist_ok=True)
    with contextlib.suppress(Exception): os.chmod(binshared, 0o755)
    with contextlib.suppress(Exception):
        if os.path.islink(binp) or os.path.exists(binp): os.remove(binp)
        os.symlink(binshared, binp)
    with open(cfgdir + "/wdtt.env", "w") as f: f.write(_wdtt_env_text(inst))
    with open(cfgdir + "/desired.json", "w") as f: f.write(_wdtt_desired_body(inst.get("passwords")) + "\n")
    restore_b64 = (inst.get("_restore_wg_keys") or "").strip()
    if restore_b64:
        # NOT best-effort. A swallowed failure here (bad base64, ENOSPC, read-only mount) left no wg-keys.dat and
        # the server then minted a fresh identity on start — the restore reported success while every client that
        # had a config broke. Let it raise: the caller turns an exception into an error string, and validate=True
        # means a corrupted blob raises instead of decoding to garbage the server would reject the same way.
        _kf = _wdtt_keyfile(inst["iface"])
        with open(_kf, "wb") as f: f.write(base64.b64decode(restore_b64, validate=True))
        os.chmod(_kf, 0o600)
        if not _wdtt_identity_ok(_kf):
            raise ValueError("restored identity is not a usable WDTT key file — refusing to start with a fresh key")

SERVERLOG_MAX = 8 << 20     # per supervised server, rotated one deep → at most 2× this on disk

def _rotate_serverlog(path, cap=SERVERLOG_MAX):
    """Keep a supervised server's log bounded before it is appended to again.

    server.log is opened "ab" and nothing ever truncated it. A server that crash-loops is relaunched by the
    reconcile every 5s, and one that stays up but spins can log per iteration with no backoff — which is exactly
    how a csqtt on a user's box wrote 9.6G of `[WARN] I/O errors +1` into its docker log and filled the disk.
    Ours is the same shape with no cap at all, so it is the same box-killer waiting on a noisier server.

    Rotate rather than truncate: the tail of the PREVIOUS run is the diagnostic, and the failure paths that read
    this file back are why it exists. One generation is kept — enough to explain the last failure, bounded enough
    that it cannot be the thing that fills the disk. os.replace is atomic, so a reader never sees a partial file."""
    with contextlib.suppress(Exception):
        if os.path.getsize(path) < cap:
            return
        os.replace(path, path + ".1")


def _wdtt_docker_start(inst):
    """(Re)launch the WDTT server for this instance as a supervised child. '' on success (alive after a beat) else error."""
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); binp = cfgdir + "/server"
    _wdtt_docker_stop(iface)
    if not os.path.exists(binp):
        return "WDTT binary missing at " + binp
    _rotate_serverlog(cfgdir + "/server.log")
    try:
        lf = open(cfgdir + "/server.log", "ab", buffering=0)
        p = subprocess.Popen(_wdtt_argv(inst, binp), stdout=lf, stderr=lf, stdin=subprocess.DEVNULL, close_fds=True)
    except Exception as e:
        return ("spawn failed: " + str(e))[:160]
    _WDTT_PROCS[iface] = p
    with contextlib.suppress(Exception):
        with open(_wdtt_pidfile(iface), "w") as f: f.write(str(p.pid))
    time.sleep(1.5)
    if p.poll() is not None:                       # died immediately → surface the log tail
        tail = ""
        with contextlib.suppress(Exception):
            with open(cfgdir + "/server.log", "rb") as f: tail = f.read()[-240:].decode("utf-8", "replace").replace("\n", " ")
        return ("wdtt exited rc=%s: %s" % (p.returncode, tail.strip()))[:180]
    return ""

def _wdtt_docker_stop(iface):
    """SIGTERM (clean teardown removes the interface + rules), SIGKILL if it lingers; reap the child; drop the pidfile."""
    p = _WDTT_PROCS.pop(iface, None)
    pid = p.pid if p is not None else _wdtt_docker_pid(iface)
    if pid:
        with contextlib.suppress(Exception): os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            try:
                os.kill(pid, 0); time.sleep(0.15)
            except Exception:
                break
        else:
            # for/else — SIGKILL only if the loop never broke, i.e. it is STILL alive. Firing it unconditionally
            # after a clean exit is a real risk here: a pid taken from the pidfile (after a noded restart) is not
            # our child, so it is reaped the instant it exits and the number can already belong to something else.
            with contextlib.suppress(Exception): os.kill(pid, signal.SIGKILL)
    if p is not None:
        with contextlib.suppress(Exception): p.wait(timeout=2)
    with contextlib.suppress(Exception): os.remove(_wdtt_pidfile(iface))

def _wdtt_docker_sighup(iface):
    pid = _wdtt_docker_pid(iface)
    if pid:
        with contextlib.suppress(Exception): os.kill(pid, signal.SIGHUP)
        return True
    return False

def _wdtt_present(iface):
    """Is this instance set up on THIS node? systemd: its unit file exists. docker: its binary symlink is laid down."""
    if NODE_KIND == "docker":
        return os.path.exists(_wdtt_dir(iface) + "/server")
    # bare-metal: the unit file AND a WORKING binary symlink must BOTH be laid down. A unit whose `server`
    # symlink is missing or dangling (a partial install, or a docker→bare convert that carried only identity)
    # is NOT "present" — treating it as installed would wedge the reconcile into the update branch forever,
    # never re-laying the symlink, leaving the unit in a 203/EXEC crash-loop. os.path.exists follows the link,
    # so a dangling one (binary not fetched yet) also re-installs.
    return os.path.exists(_wdtt_unit_path(iface)) and os.path.exists(_wdtt_dir(iface) + "/server")

def _hex_to_b64(h):
    h = (h or "").strip()
    with contextlib.suppress(Exception):
        if len(h) == 64:
            return base64.b64encode(bytes.fromhex(h)).decode()
    return ""

def _wdtt_uapi(iface):
    """(interface_private_key_hex, {peer_pubkey_b64: last_handshake_sec}) straight from the UAPI socket. The
    container ships only `awg`, which can't read a plain wireguard-go socket — but the socket speaks the standard
    protocol, so we ask it directly. Drives online-status on docker."""
    priv = ""; hs = {}; cur = None
    for line in _uapi_lines(iface):
        if line.startswith("private_key="):
            priv = line.split("=", 1)[1]
        elif line.startswith("public_key="):
            cur = _hex_to_b64(line.split("=", 1)[1])
        elif line.startswith("last_handshake_time_sec=") and cur:
            with contextlib.suppress(ValueError):
                hs[cur] = int(line.split("=", 1)[1] or "0")
    return priv, hs

def _wdtt_server_pub(iface):
    """The WDTT server's WG public key. Bare-metal: `wg show` over the host-netns interface. Docker: derive it from
    the UAPI private key via `wg pubkey` (pure key math — works even though `awg show` can't read the socket)."""
    if NODE_KIND == "docker":
        priv, _ = _wdtt_uapi(iface)
        pb = _hex_to_b64(priv)
        if pb:
            with contextlib.suppress(Exception):
                return (run(_wgcmd(["wg"]) + ["pubkey"], input_text=pb + "\n").stdout or "").strip()   # _wgcmd(["wg"]) → ["awg"] on docker
        return ""
    return (host_sh("wg show " + shlex.quote(iface) + " public-key 2>/dev/null").stdout or "").strip()

def _wdtt_panel_fetch(fork, dest, want_sha, tag="wdtt"):
    """Fetch a fork's patched WDTT binary from the panel mirror (reuses the turn-binary endpoint keyed by the fork's
    owner + a version tag; the panel maps it to our release). `tag` is the author version we published (or "wdtt" =
    the current build, back-compat). Returns True on a verified write."""
    return _turn_panel_fetch(WDTT_FORK_OWNER.get(fork, WDTT_OWNER), tag or "wdtt", _turn_arch(), dest, want_sha)

def _wdtt_fetch_bin(fork, inst, binshared, ver=None):
    """Put fork `fork`'s WDTT binary at `binshared`. '' on success, else WHY not.

    Same two-hop shape csqtt now has, and for the same reason: _wdtt_panel_fetch alone means the panel is a single
    point of failure for every node's binary — if it cannot resolve or reach the asset, no node can install or
    version-bump a WDTT server, and the message blamed a missing build. The node reaches the panel where GitHub is
    blocked; the node reaches GitHub where the panel cannot. Trying both covers both, and neither is trusted more
    than the pinned sha256.
    Our release tags are `wdtt-<fork>-<author version>` — deterministic, so no lookup table is needed here — but a
    version IS required: see _swg_release_get on why there is no 'latest' fallback."""
    if not _turn_arch_ok():
        return ("no WDTT build for this architecture (" + os.uname().machine + ") — we publish amd64/arm64 only")
    arch = _turn_arch()
    v = (ver if ver is not None else (inst.get("ver") or "")).strip()
    want = (inst.get("sha256") or "").strip()
    if _wdtt_panel_fetch(fork, binshared, want, tag=v or "wdtt") and os.path.exists(binshared):
        return ""
    okd, why = _swg_release_get(("wdtt-" + fork + "-" + v) if v else "", arch, binshared, want, "WDTT")
    if okd:
        return ""
    return ("couldn't fetch the " + fork + " WDTT binary for " + arch + (" " + v if v else "")
            + " — the panel's mirror had none, and " + why
            + ". If GitHub is blocked here, set SWG_TURN_MIRROR on the panel to a proxy you trust.")

def _wdtt_ver_path(fork):   # the installed build version, alongside the shared per-fork binary
    return os.path.dirname(_wdtt_bin_shared(fork)) + "/version.txt"
def _wdtt_installed_ver(fork):
    try:
        with open(_wdtt_ver_path(fork)) as f:
            return f.read().strip()[:40]
    except Exception:
        return ""
def _wdtt_write_ver(fork, ver):
    with contextlib.suppress(Exception):
        p = _wdtt_ver_path(fork); os.makedirs(os.path.dirname(p), exist_ok=True)
        tmp = p + ".tmp"
        with open(tmp, "w") as f:
            f.write((ver or "").strip())
        os.replace(tmp, p)

def _wdtt_fork_ifaces(fork, want):   # every desired iface running THIS fork (a version swap restarts them all — shared binary)
    return [i for i, inst in (want or {}).items() if _wdtt_fork(inst) == fork]

def _wdtt_update_binary(inst, ver, ifaces):
    """Swap the shared per-fork binary to a different published VERSION (same fork → same password-store format, so
    it's safe, unlike a fork swap). Re-fetch from the mirror (atomic replace — the running process keeps the old
    inode), stamp the version file, then restart every instance of the fork so they exec the new inode. '' on
    success else an error string."""
    fork = _wdtt_fork(inst); binshared = _wdtt_bin_shared(fork)
    _e = _wdtt_fetch_bin(fork, inst, binshared, ver=ver)
    if _e or not os.path.exists(binshared):
        return _e or ("WDTT binary missing after a reportedly successful fetch — check free space on "
                      + os.path.dirname(binshared))
    _wdtt_write_ver(fork, ver)
    if NODE_KIND == "docker":                                  # container: restart each of the fork's supervised procs so they exec the new binary
        with contextlib.suppress(Exception): os.chmod(binshared, 0o755)
        insts = _wdtt_load(); err = ""
        for i in (ifaces or [inst["iface"]]):
            it = dict(insts.get(i) or {}); it["iface"] = i
            if it.get("password") and not it.get("stopped"):
                e = _wdtt_docker_start(it)
                if e: err = i + ": " + e
        return err
    host_sh("chmod 755 " + shlex.quote(binshared))
    for i in (ifaces or [inst["iface"]]):
        host_sh("systemctl restart " + shlex.quote(_wdtt_svc(i)) + " >/dev/null 2>&1")
    return _wdtt_verify(_wdtt_svc(inst["iface"]))

def _wdtt_verify(svc):
    v = host_sh("sleep 1.5; systemctl is-active " + shlex.quote(svc) + " 2>/dev/null; "
                "journalctl -u " + shlex.quote(svc) + " -n 6 --no-pager -o cat 2>/dev/null | "
                "grep -iE 'error|invalid|fail|panic|bind|denied|seccomp' | tail -1")
    lines = (v.stdout or "").strip().splitlines()
    if lines and lines[0] == "active":
        return ""
    return "wdtt service didn't stay up: " + (lines[-1] if len(lines) > 1 else "check journal")[:150]

def _wdtt_maxpw_for(wg_addr, cap=4000):
    """Usable hosts in the tunnel subnet, as the password-pool default. Falls back to 200 when there's nothing
    to read; capped so a wide prefix can't ask a server to preallocate an absurd pool."""
    with contextlib.suppress(Exception):
        pfx = int(str(wg_addr).split("/")[1])
        if 0 < pfx <= 32:
            return max(1, min(cap, (1 << (32 - pfx)) - 2))
    return 200


def _wdtt_stage_foreign(cfgdir, pid=None):
    """DOCKER only: copy a FOREIGN WDTT config-dir off the HOST into a container-local staging dir and return that
    path ('' when there is nothing to stage, or on bare-metal where the dir is already reachable).

    The adopt path validates and copy2's the identity with ordinary local file I/O. A foreign server's dir is on the
    host, so inside the container those reads all failed and adoption refused with "no usable server identity" —
    guarding keys that were sitting right there. Staging once here keeps every downstream check byte-identical
    across both install methods instead of teaching each one to speak host_sh.

    Read-only by construction: tar reads the original and nothing writes back, so an aborted adopt still leaves the
    foreign server serving — the property the copy-first ordering exists to preserve."""
    if not cfgdir:
        return ""
    # A CONTAINERISED foreign server's config-dir is a path inside ITS filesystem — /etc/wdtt in the container,
    # nothing at all on the box. wdtt_foreign_probe already reads it through the server's own root and reports it
    # adoptable; the take-over then opened the bare path and found nothing, so a server sitting right there was
    # refused with "no usable server identity". That is the scan-says-yes/executor-says-no split this helper was
    # written to close, on the axis it did not cover: host-vs-container was handled, container-vs-container was not.
    # On a BARE-METAL node the server's root is directly readable at /proc/<pid>/root, so hand that path back and
    # every check and copy2 downstream works unchanged — no staging copy needed, and read-only by construction.
    # (Safe to hold across the caller: the copy and the SQLite capture both run BEFORE the foreign server is
    # stopped — the copy-first ordering this whole path is built on.)
    _root = _proc_cfg_root(pid)
    if NODE_KIND != "docker":
        return (_root + cfgdir) if _root else ""
    dst = "/tmp/swg-wdtt-adopt"
    with contextlib.suppress(Exception):
        shutil.rmtree(dst, ignore_errors=True)
        os.makedirs(dst, mode=0o700, exist_ok=True)
        # Only the files adoption actually consumes — never the whole directory, which can hold anything.
        # panel.db-wal / -shm come too: a WAL-mode SQLite store is NOT one file. ildarmaga keeps its users in
        # panel.db, and staging the base file alone captured a stale snapshot whose wdtt_users table had not been
        # checkpointed yet — the adopted server started with an EMPTY user set and rejected every existing client.
        # The pid belongs to the HOST namespace here, so _proc_cfg_root could not test it from inside this
        # container — the host shell runs the same comparison itself and prefixes the dir when the server turns
        # out to be containerised. Identical idiom to _wdtt_cfg_probe's _pfxsh, so the scan and the take-over
        # resolve the SAME directory; they disagreeing is exactly the bug.
        _pfx = ("R=''; P=%s; [ -n \"$P\" ] && [ -e /proc/$P/ns/mnt ] && "
                "[ \"$(readlink /proc/$P/ns/mnt)\" != \"$(readlink /proc/1/ns/mnt)\" ] && R=/proc/$P/root; "
                % shlex.quote(str(int(pid)) if pid else ""))
        b64 = (host_sh(_pfx + "tar -C \"$R\"%s -cf - wg-keys.dat passwords.json panel.db panel.db-wal panel.db-shm "
                       "dtls-cert.pem dtls-key.pem 2>/dev/null | base64 -w0" % shlex.quote(cfgdir), timeout=60).stdout or "").strip()
        if b64:
            with tarfile.open(fileobj=io.BytesIO(base64.b64decode(b64))) as _t:
                for _m in _t.getmembers():          # flatten + refuse anything that isn't a plain file we asked for
                    if _m.isfile() and "/" not in _m.name and not _m.name.startswith("."):
                        _f = _t.extractfile(_m)
                        if _f:
                            with open(os.path.join(dst, _m.name), "wb") as _o:
                                _o.write(_f.read())
                            os.chmod(os.path.join(dst, _m.name), 0o600)
            if os.listdir(dst):
                return dst
    return ""


def _wdtt_identity_ok(path):
    """Does this look like a real wg-keys.dat? The forks write FOUR base64 keys (server + client pair), and a
    server handed a file it can't parse silently GENERATES a fresh identity — which is precisely the outcome
    adoption exists to prevent, arriving with no error anywhere. Checked before anything is copied or stopped."""
    with contextlib.suppress(Exception):
        lines = [l.strip() for l in open(path, "rb").read().decode("utf-8", "replace").splitlines() if l.strip()]
        if len(lines) < 4:
            return False
        for l in lines[:4]:
            if len(base64.b64decode(l + "=" * (-len(l) % 4), validate=False)) != 32:
                return False
        return True
    return False


def _wdtt_adopt_seed(inst):
    """ADOPT a foreign (panel-unmanaged) WDTT server: SEEDED CREATE. We never reuse the foreign SERVICE (it's an
    unpatched build we don't control) — we create one of OUR instances that REUSES its DATA, so every GETCONF'd
    client keeps working: the server identity (wg-keys.dat → same pubkey), the password store (passwords.json /
    panel.db), and the owner password (read LOCALLY from the running process — the panel never sees it).
    Copy-FIRST, then stop the foreign process, so an abort leaves the original serving. Returns '' on success
    (inst is mutated with the recovered password/params, ready for _wdtt_install) else an error string."""
    iface = inst["iface"]
    # The name arrives as a raw key from the panel reply and immediately becomes a directory path below, so it is
    # checked FIRST — before makedirs/copy2 could be pointed somewhere like ../../root/.ssh. _wdtt_valid runs
    # later and only on the install path, which several early returns skip.
    if not _WDTT_NAME_RE.match(iface or ""):
        return "refused: unsafe interface name"
    probe = wdtt_foreign_probe(iface)
    # A DORMANT install has no process and no interface — the operator supplied its config dir instead, and the
    # runtime parameters (ports, subnet) with it. Everything below is the same seeded create; there is simply
    # nothing to read from argv and nothing to stop.
    dormant_src = (inst.pop("adopt_config_dir", "") or "").strip()
    if not probe and not dormant_src:
        return "no foreign WDTT server found for " + iface + " (already gone?)"
    # The operator can point at the identity when we couldn't find it (a fork with an unusual layout, or a server
    # started from somewhere we don't guess). Verify it HERE, before anything is stopped or copied: an unreadable
    # or empty file is refused outright and the foreign server carries on serving, exactly as if we'd never tried.
    idpath = (inst.pop("identity_path", "") or "").strip()
    # DOCKER: everything below reads and copies the foreign config-dir with ordinary local file I/O, but a foreign
    # server's dir lives on the HOST — so os.path.isfile() said no and adoption refused with "no usable server
    # identity", protecting keys that were in fact right there. The scan (host-aware) said adoptable, the executor
    # disagreed. Stage the dir into the container ONCE here, then every check and copy2 below works unchanged on
    # both install methods. Read-only: the foreign original is never touched, so an abort still leaves it serving.
    # pid drives the namespace resolution, and it must ride with `dormant_src` too: the panel fills
    # adopt_config_dir from the CANDIDATE for a running server as well (swg-panel-server `_claim`), not only for a
    # genuinely dormant one — so gating the pid on "no dormant_src" switched the resolution off for exactly the
    # containerised case it exists to serve, and `src` then read the host directory. On a box that has ever run a
    # bare-metal fork that path EXISTS and holds a different install's wg-keys.dat, so the adopt succeeded, seeded
    # the wrong identity, and broke every client of the server it took over — silently, with nothing to see.
    # (Measured on msk before this line was fixed: ours came up holding the host key, not the container's.)
    # A real DORMANT adopt has no process, so `pid` is None there anyway and the behaviour is unchanged.
    # An operator-supplied identity_path is the one path they picked THEMSELVES on the node: no prefix.
    _stage = _wdtt_stage_foreign(os.path.dirname(idpath) if idpath else
                                 (dormant_src or ((probe or {}).get("config_dir") or "")),
                                 pid=(None if idpath else (probe or {}).get("pid")))
    if _stage:
        if idpath:
            idpath = os.path.join(_stage, os.path.basename(idpath))
        elif dormant_src:
            dormant_src = _stage
        else:
            probe = dict(probe or {}); probe["config_dir"] = _stage
    if idpath:
        if not os.path.isfile(idpath):
            return "refused: no key file at " + idpath + " — nothing was changed"
        if not _wdtt_identity_ok(idpath):
            return "refused: " + idpath + " doesn't look like a WDTT key file (four base64 keys) — nothing was changed"
        try:
            with open(idpath, "rb") as _f: _f.read(1)
        except OSError as e:
            return ("refused: can't read " + idpath + " (" + str(e) + ") — nothing was changed")[:200]
    elif probe and not probe.get("has_identity"):
        # (a DORMANT adopt has no probe at all — its identity is checked against `src` just below)
        return "refused: the foreign server's identity (wg-keys.dat) can't be found — adopting would mint a new key and break every existing client"
    src = os.path.dirname(idpath) if idpath else (dormant_src or probe["config_dir"])
    if not _wdtt_identity_ok(os.path.join(src, "wg-keys.dat")):
        return "refused: no usable server identity (wg-keys.dat) in " + src + " — adopting would mint a new key and break every client; nothing was changed"
    # Everything that can refuse must refuse BEFORE the first write. These checks used to sit after the copy, so a
    # refusal ("no build available yet" is the normal state on a node that hasn't pulled the fork) left wg-keys.dat
    # in our config-dir with the foreign server still running — and the next pass then saw a "provisioned" instance,
    # skipped the adopt branch entirely, and installed our unit on the same iface and ports as the live original.
    if not _wdtt_valid(dict(inst, iface=iface)):
        return "refused: bad/unsafe WDTT instance parameters — the foreign server was left running"
    _want_fork = (inst.get("fork") or "").strip()
    if _want_fork and _want_fork not in WDTT_FORK_OWNER:
        return "refused: unknown WDTT fork '" + _want_fork + "' — the foreign server was left running"
    _fk = _wdtt_fork(inst); _bs = _wdtt_bin_shared(_fk)
    if not os.path.exists(_bs):
        _e = ""
        with contextlib.suppress(Exception):
            _e = _wdtt_fetch_bin(_fk, inst, _bs)
        if not os.path.exists(_bs):
            return "refused: " + (_e or ("no " + _fk + " build available for this node yet")) + " — the foreign server was left running"
    dst = _wdtt_dir(iface)
    # 1) copy-first: identity + password store + DTLS material into OUR config-dir (the foreign one keeps serving)
    try:
        os.makedirs(dst, exist_ok=True)
        if idpath and os.path.basename(idpath) != "wg-keys.dat":
            shutil.copy2(idpath, os.path.join(dst, "wg-keys.dat"))
            with contextlib.suppress(Exception): os.chmod(os.path.join(dst, "wg-keys.dat"), 0o600)
        for fn in ("wg-keys.dat", "passwords.json", "panel.db", "dtls-cert.pem", "dtls-key.pem"):
            s = os.path.join(src, fn)
            if os.path.isfile(s) and os.path.abspath(s) != os.path.abspath(os.path.join(dst, fn)):
                shutil.copy2(s, os.path.join(dst, fn))
                with contextlib.suppress(Exception): os.chmod(os.path.join(dst, fn), 0o600)
    except Exception as e:
        return ("couldn't copy the foreign server's data: " + str(e))[:160]
    if not os.path.isfile(_wdtt_keyfile(iface)):
        return "refused: the server identity didn't copy across — not adopting (clients would break)"
    # panel.db is SQLite in WAL MODE: it is not one file. Copying the base alone captured whatever had been
    # checkpointed and silently dropped the rest — for ildarmaga that was the entire wdtt_users table, so the
    # adopted server came up with an empty user set and rejected every existing client with "wrong password".
    # Re-take it through SQLite (on a scratch copy, so the foreign original is never opened for writing) and the
    # result is one consistent, checkpointed file.
    _srcdb = os.path.join(src, "panel.db")
    if os.path.isfile(_srcdb):
        _stage = os.path.join(dst, ".dbstage")
        try:
            os.makedirs(_stage, exist_ok=True)
            for _f in ("panel.db", "panel.db-wal", "panel.db-shm"):
                _p = os.path.join(src, _f)
                if os.path.isfile(_p):
                    shutil.copy2(_p, os.path.join(_stage, _f))
            import sqlite3
            _s = sqlite3.connect(os.path.join(_stage, "panel.db"), timeout=10)   # writable COPY → the WAL replays
            _d = sqlite3.connect(os.path.join(dst, "panel.db"))
            try:
                with _d:
                    _s.backup(_d)
            finally:
                _s.close(); _d.close()
            with contextlib.suppress(Exception): os.chmod(os.path.join(dst, "panel.db"), 0o600)
        except Exception as e:
            return ("couldn't capture the foreign server's user store: " + str(e))[:160]
        finally:
            shutil.rmtree(_stage, ignore_errors=True)
    # The users themselves have to be handed UP to the panel: WDTT passwords are roster-owned (each one IS a
    # peer), and _wdtt_reply overwrites whatever the node holds with the roster-derived set on the very next
    # sync — so a node-local copy alone is erased seconds after the take-over. Capture them here, at the one
    # moment they are known, and report them until the panel has them (wdtt_snapshot → panel import).
    _found = _wdtt_adopted_users(dst)
    if _found:
        inst["adopt_users"] = _found
        inst["adopt_users_at"] = int(time.time())
    # 2) recover the owner password + transport params from the RUNNING process (node-local; never panel-side).
    #    A dormant install has no process: its parameters came from the operator, and the owner password is minted
    #    below like any fresh instance (there is no running server whose password we'd have to match).
    if not probe:
        return ""
    # Same namespace rule as the stop below: on a docker node this pid lives on the HOST, so the local read
    # returned nothing and the owner password was silently NOT carried over — the adopted server came up with a
    # freshly minted one, which is exactly what this step exists to prevent. Reading it host-side keeps it
    # node-local; the panel still never sees it.
    flags = _wdtt_cmdline_flags(probe["pid"])
    if not _wdtt_is_server(flags) and NODE_KIND == "docker":
        flags = _wdtt_flags_host(probe["pid"])
    pw = (flags.get("password") or "").strip()
    if pw:
        inst["password"] = pw                      # keep the SAME owner password → existing clients still authenticate
    for k, fk in (("listen", "listen"), ("wg_addr", "wg-addr")):
        if not (inst.get(k) or "").strip() and (flags.get(fk) or "").strip():
            inst[k] = flags[fk].strip()
    if not str(inst.get("wg_port") or "").strip() and str(flags.get("wg-port") or "").strip():
        inst["wg_port"] = flags["wg-port"].strip()
    # 3) stop the FOREIGN process — it holds the interface + ports our instance is about to bind
    # Re-verify before signalling: the pid was read before a file copy and possibly a full binary download, so it
    # could have exited and had its number recycled onto something unrelated — which we run as root.
    # On a DOCKER node the foreign server runs on the HOST, and wdtt_foreign_probe found it through
    # _wdtt_host_procs — so its pid belongs to the host's namespace, not ours. Reading /proc/<pid> locally
    # therefore described a DIFFERENT process (usually none at all) and os.kill signalled our own namespace:
    # the foreign server was never stopped, our instance could not bind its port or interface, and the card sat
    # on "starting" for ever. Verify and signal through the same host helper that found it. Local first, so
    # bare-metal and our own supervised children keep the cheap path and no privileged container is spawned.
    # _wdtt_iface_of, NOT flags["iface"]: a genuinely foreign server has no -iface at all (the authors' builds
    # hardcode it), so comparing the raw flag could never confirm one — the re-verify refused every real
    # adoption, after the copy had already happened, and the next pass then saw a "provisioned" instance and
    # started ours on the port the original still held.
    # The fallback is decided on "did the LOCAL read describe a server at all", never on the interface name:
    # a wrong-namespace read comes back empty, and _wdtt_iface_of() answers the DEFAULT name for empty flags —
    # which for wdtt0 equals the name we are adopting, so an iface-based test silently accepted the empty read
    # and never consulted the host.
    _flags_now = _wdtt_cmdline_flags(probe["pid"]); _host_pid = False
    if not _wdtt_is_server(_flags_now) and NODE_KIND == "docker":
        _flags_now = _wdtt_flags_host(probe["pid"]); _host_pid = True
    # _wdtt_is_server first: an exited pid reads back as empty flags, and _wdtt_iface_of would then hand us the
    # DEFAULT interface name — confirming "yes, that's the server on wdtt0" about a process that is gone.
    if not _wdtt_is_server(_flags_now) or _wdtt_iface_of(_flags_now) != iface:
        return "the foreign server exited while we were preparing — nothing was changed, re-try the adoption"
    # Stop the SERVICE if there is one. A foreign WDTT server is normally a systemd unit with Restart=on-failure,
    # so killing only the process left its manager to bring it straight back: it then crash-looped against the
    # port our instance had taken (NRestarts climbing, "address already in use") — and would have won the port
    # outright the moment ours stopped, handing clients back to the server we just replaced.
    _unit = _wdtt_unit_of_pid(probe["pid"], _host_pid)
    if _unit and not _unit.startswith("swg-wdtt-"):        # never our own supervisor
        host_sh(sc_disable_now(_unit) + " >/dev/null 2>&1; :")
    # A container is the OTHER kind of supervisor, and _wdtt_unit_of_pid cannot see it: every WDTT fork ships a
    # Docker install, and a foreign server running as its own container reads back as unsupervised. TERM/KILL
    # against `restart: unless-stopped` brings it straight back, ours never binds the port, and the take-over
    # times out with "it is still running" — which is exactly what it says, just not why. Same remedy csqtt
    # already uses: `docker stop`, never `rm` — this is somebody else's container and their data, and stop also
    # settles the restart policy, the container-level equivalent of the disable above.
    _cid = _csqtt_container_of(probe["pid"])   # generic cgroup→container-id read, despite the csqtt-era name
    if _cid:
        host_sh("docker stop " + shlex.quote(_cid) + " >/dev/null 2>&1; :", timeout=60)
        _wdtt_hostproc_flush()                 # the walk below must not answer from the pre-stop cache
        _after = _wdtt_flags_host(probe["pid"]) if _host_pid else _wdtt_cmdline_flags(probe["pid"])
        if not _wdtt_is_server(_after):
            # Gone, and we know it. Do NOT fall through to the signals: that pid is free now and may already
            # belong to something else — and we run as root. Same guard as _csqtt_stop_foreign.
            with contextlib.suppress(Exception):
                run(["ip", "link", "delete", "dev", iface])
            if _host_pid:
                host_sh("ip link delete dev %s 2>/dev/null; :" % shlex.quote(iface))
            _WDTT_HOSTPROC["at"] = 0.0
            return ""
    if _host_pid:
        # TERM, wait up to ~4.5s, then KILL — the same escalation as the local branch, run host-side in one hop.
        _p = int(probe["pid"])
        host_sh("kill -TERM %d 2>/dev/null; i=0; while [ $i -lt 30 ] && kill -0 %d 2>/dev/null; do sleep 0.15; "
                "i=$((i+1)); done; kill -0 %d 2>/dev/null && kill -KILL %d 2>/dev/null; :" % (_p, _p, _p, _p))
    else:
        with contextlib.suppress(Exception):
            os.kill(probe["pid"], signal.SIGTERM)
            for _ in range(30):
                try:
                    os.kill(probe["pid"], 0); time.sleep(0.15)
                except Exception:
                    break
            else:
                os.kill(probe["pid"], signal.SIGKILL)
    with contextlib.suppress(Exception):           # the interface may linger after the process dies
        run(["ip", "link", "delete", "dev", iface])
    if _host_pid:                                  # a bridge-mode node does not share the host netns
        host_sh("ip link delete dev %s 2>/dev/null; :" % shlex.quote(iface))
    # the walk that found it is cached (45s) and now describes a process we just killed — the very next
    # snapshot would still report the foreign server as running, and adoption as unfinished.
    _WDTT_HOSTPROC["at"] = 0.0
    return ""

def _wdtt_install(inst):
    """Install a WDTT instance: place the binary (panel mirror, shared per-arch), lay down the config-dir (binary
    symlink + wdtt.env + desired.json + optional vault-restore key), then start it — bare-metal via a systemd unit,
    docker via a supervised child process. '' on success else error. The config-dir is written natively in both
    cases (_wdtt_write_cfgdir), so a partial failure raises BEFORE the unit is written/started — no half-installed
    instance can wedge the reconcile into treating a broken unit as 'present'."""
    if not _wdtt_valid(inst):
        return "refused: bad/unsafe WDTT instance parameters"
    if not _turn_arch_ok():
        return "no WDTT build for this architecture (" + os.uname().machine + ")"
    _unk = _wdtt_fork_unknown(inst)
    if _unk:
        # Never silently substitute a different fork's server — see _wdtt_fork_unknown.
        return ("this node doesn't know the WDTT fork '" + _unk + "' — its swg-noded is older than the panel. "
                "Update the node (its page offers \"update node to …\"), then this server installs on the next sync. "
                "Known here: " + ", ".join(sorted(WDTT_FORK_OWNER)) + ".")
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); svc = _wdtt_svc(iface)
    fork = _wdtt_fork(inst)
    binshared = _wdtt_bin_shared(fork); binp = cfgdir + "/server"
    _want_ver = (inst.get("ver") or "").strip()
    if not os.path.exists(binshared):
        _e = _wdtt_fetch_bin(fork, inst, binshared, ver=_want_ver)
        if _e:
            return _e
        if not os.path.exists(binshared):
            return "WDTT binary missing after a reportedly successful fetch — check free space on " + os.path.dirname(binshared)
        _wdtt_write_ver(fork, _want_ver)                       # stamp the build version for the version board + rollback
    # Config-dir (symlink + env + desired.json + optional vault-restore key) — native os writes, both run-models.
    # A vault restore lays down the ORIGINAL server keypair BEFORE first start so the instance comes back with its
    # blessed identity (WDTT reuses an existing wg-keys.dat rather than minting) — GETCONF'd clients keep working.
    try:
        _wdtt_write_cfgdir(inst, binshared, binp, cfgdir)
    except Exception as e:
        return ("config-dir write failed: " + str(e))[:160]
    if NODE_KIND == "docker":                                  # container: no systemd → supervised child process
        return _wdtt_docker_start(inst)
    # bare-metal: write the systemd unit natively, then the one step that genuinely needs systemd (reload + enable).
    try:
        with open(_wdtt_unit_path(iface), "w") as f: f.write(_wdtt_unit_text(iface, binp, cfgdir, fork))
    except Exception as e:
        return ("unit write failed: " + str(e))[:160]
    w = host_sh("systemctl daemon-reload && " + sc_enable_now(svc) + " >/dev/null 2>&1", timeout=120)
    if w.returncode != 0:
        return (w.stderr or w.stdout or "install failed").strip()[:160]
    return _wdtt_verify(svc)

def _wdtt_params_changed(prev, inst):
    """True if a TRANSPORT param changed on a RUNNING instance — listen (endpoint:dtls-port) / internal wg-port /
    max-passwords. These live in the unit ExecStart + wdtt.env, so applying them needs a rewrite + restart
    (passwords/stopped are handled live, separately). endpoint is folded into `listen`. FORK is deliberately NOT
    here: it's a create-time choice (read-only in the edit UI) — hot-swapping the binary would also migrate the
    password store between the two forks' formats (passwords.json ↔ panel.db), which we don't risk on a live
    server. So a same-fork config change only ever restarts the SAME binary."""
    return ((prev.get("listen") or "") != (inst.get("listen") or "")
            or (prev.get("wg_addr") or "") != (inst.get("wg_addr") or "")   # subnet change → rewrite unit + restart (server reassigns client IPs on reconnect)
            or str(prev.get("wg_port") or 56001) != str(inst.get("wg_port") or 56001)
            or (str(prev.get("max_passwords") or _wdtt_maxpw_for(prev.get("wg_addr") or ""))
                != str(inst.get("max_passwords") or _wdtt_maxpw_for(inst.get("wg_addr") or "")))
            or (prev.get("params") or "").strip() != (inst.get("params") or "").strip()   # extra ExecStart flags → rewrite unit + restart
            or _wdtt_raw(prev) != _wdtt_raw(inst))   # RAW listener turned on/off or moved → same treatment

def _wdtt_unit_drifted(iface, inst, prev):
    """True when the on-disk unit differs from what THIS build would write for the fork that is INSTALLED
    (docker has no unit → never).

    Why it exists: the unit is written on install and on a PARAMETER change, and nowhere else — so a fix to the
    unit ITSELF never reached an instance that already existed. A WDTT server needs `ip` on its PATH, which a
    systemd unit does not have on a store-based OS (see _fork_unit_path_env); every WDTT instance installed
    before that fix crash-looped for ever, and reconcile SKIPPED it because the unit was present. Comparing the
    rendered text heals those on the next sync after a node update. csqtt has had this since _csqtt_unit_drifted;
    WDTT is the one that did not.

    Why `prev` and not just `inst`: the unit is rendered PER FORK (each fork takes a different flag tail), and a
    fork change is deliberately not a reconfigure — _wdtt_params_changed leaves it out so a live server is never
    hot-swapped onto another author's binary and password-store format. Rendering the panel's fork here would
    smuggle that swap back in through the drift path. So compare against the fork this node RECORDS as installed,
    and skip entirely when the two disagree or when there is no record to trust.
    """
    if NODE_KIND == "docker":
        return False
    if not prev or _wdtt_fork(prev) != _wdtt_fork(inst):
        return False
    try:
        with open(_wdtt_unit_path(iface)) as f:
            have = f.read()
    except OSError:
        return False                       # missing unit is the install path's problem, not a drift
    cfgdir = _wdtt_dir(iface)
    return have.strip() != _wdtt_unit_text(iface, cfgdir + "/server", cfgdir, _wdtt_fork(inst)).strip()

def _wdtt_write_unit(iface, inst):
    """Write the unit + daemon-reload, and DON'T start anything. For a drifted unit on an instance the operator
    has STOPPED: the fix has to reach the file (or the next start replays the old breakage), but starting a
    server that was deliberately turned off is not a heal. '' on success else an error."""
    cfgdir = _wdtt_dir(iface)
    try:
        with open(_wdtt_unit_path(iface), "w") as f:
            f.write(_wdtt_unit_text(iface, cfgdir + "/server", cfgdir, _wdtt_fork(inst)))
    except Exception as e:
        return ("unit write failed: " + str(e))[:160]
    host_sh("systemctl daemon-reload >/dev/null 2>&1")
    return ""

def _wdtt_reconfigure(inst):
    """Apply a transport-param change (listen / wg-port / max) to a RUNNING WDTT instance: rewrite wdtt.env + the
    unit and restart the SAME fork's binary, verify. PRESERVES wg-keys.dat (server identity → pubkey stable, no
    GETCONF break) and desired.json (passwords). '' on success else an error. Clients re-import only if
    listen/wg-port changed (those are in the wdtt:// link). The binary fetch-if-missing is a same-fork self-heal,
    never a fork swap (see _wdtt_params_changed)."""
    if not _wdtt_valid(inst):
        return "refused: bad/unsafe WDTT instance parameters"
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); svc = _wdtt_svc(iface)
    fork = _wdtt_fork(inst)
    binshared = _wdtt_bin_shared(fork); binp = cfgdir + "/server"
    if not os.path.exists(binshared):                       # fork swap → fetch the new fork's binary from the mirror
        _e = _wdtt_fetch_bin(fork, inst, binshared)
        if _e:
            return _e
        if not os.path.exists(binshared):
            return "WDTT binary missing after a reportedly successful fetch — check free space on " + os.path.dirname(binshared)
    # Rewrite the config-dir (symlink/env/desired) natively — wg-keys.dat is untouched (identity → pubkey stable), and
    # desired.json is rewritten with the SAME current password set (idempotent; matches the docker path). Partial write
    # raises before the restart, so a failed reconfigure never leaves a mismatched unit running.
    try:
        _wdtt_write_cfgdir(inst, binshared, binp, cfgdir)
    except Exception as e:
        return ("reconfigure failed: " + str(e))[:160]
    if NODE_KIND == "docker":                               # container: restart the supervised proc (no unit to rewrite)
        return _wdtt_docker_start(inst)
    try:
        with open(_wdtt_unit_path(iface), "w") as f: f.write(_wdtt_unit_text(iface, binp, cfgdir, fork))
    except Exception as e:
        return ("unit write failed: " + str(e))[:160]
    w = host_sh("systemctl daemon-reload && systemctl restart " + shlex.quote(svc) + " >/dev/null 2>&1", timeout=120)
    if w.returncode != 0:
        return (w.stderr or w.stdout or "reconfigure failed").strip()[:160]
    return _wdtt_verify(svc)

def _wdtt_reset_devices(iface, fork):
    """A wg_addr (subnet) change invalidates every cached client-IP binding — each fork pins its devices to
    addresses in the OLD subnet, so a reconnecting client would be handed an IP outside the new interface and get
    no route (online but no internet). Stop the server, clear its device cache, and drop the interface so it comes
    back fresh; clients re-register into the new subnet on their next connect. Credentials (the password set) and
    the server identity (wg-keys.dat) are left intact. Paired with the _wdtt_reconfigure that restarts the server
    immediately after — the server recreates the tun (new subnet, no stale peers) on start."""
    cfgdir = _wdtt_dir(iface)
    if NODE_KIND == "docker":
        _wdtt_docker_stop(iface)                         # SIGTERM → the server removes its interface on the way out
    else:
        host_sh("systemctl stop " + shlex.quote(_wdtt_svc(iface)) + " >/dev/null 2>&1")
    if fork == "ildarmaga":                              # SQLite panel.db → wipe the device bindings (users/passwords kept)
        with contextlib.suppress(Exception):
            import sqlite3
            dbp = cfgdir + "/panel.db"
            if os.path.exists(dbp):
                c = sqlite3.connect(dbp, timeout=2)
                try: c.execute("DELETE FROM wdtt_devices"); c.commit()
                finally: c.close()
    else:                                                # amurcanov & wire-compatible forks: passwords.json devices{}
        p = cfgdir + "/passwords.json"
        with contextlib.suppress(Exception):
            with open(p) as f: d = json.load(f)
            if d.get("devices"):
                d["devices"] = {}
                tmp = p + ".tmp"
                with open(tmp, "w") as f: json.dump(d, f)
                os.replace(tmp, p)
    if NODE_KIND == "docker":
        with contextlib.suppress(Exception): run(["ip", "link", "del", iface])   # in the container netns; usually already gone from the SIGTERM teardown
    else:
        host_sh("ip link del " + shlex.quote(iface) + " 2>/dev/null || true")   # gone → server recreates it fresh on restart

def _wdtt_desired_changed(iface, passwords):
    """True if the panel's desired password set differs from what's on disk (so we only rewrite+SIGHUP on change)."""
    try:
        with open(_wdtt_dir(iface) + "/desired.json") as f:
            cur = (json.load(f) or {}).get("passwords") or {}
    except Exception:
        return True
    return cur != (json.loads(_wdtt_desired_body(passwords)).get("passwords") or {})

def _wdtt_reconcile_desired(iface, passwords):
    """Write the panel's desired password set + SIGHUP the server → applied with no restart / no tunnel drop."""
    cfgdir = _wdtt_dir(iface)
    try:                                                 # desired.json is a plain node-local write in both run-models
        with open(cfgdir + "/desired.json", "w") as f: f.write(_wdtt_desired_body(passwords) + "\n")
    except Exception as e:
        return ("desired write failed: " + str(e))[:160]
    if NODE_KIND == "docker":
        _wdtt_docker_sighup(iface)                       # server reloads desired.json on HUP (mtime watch is the fallback)
        return ""
    w = host_sh("systemctl kill -s HUP " + shlex.quote(_wdtt_svc(iface)) + " 2>/dev/null || true")
    return "" if w.returncode == 0 else (w.stderr or w.stdout or "reconcile failed").strip()[:160]

def _wdtt_apply_stopped(iface, stopped, inst=None):
    """Start/stop one WDTT server. `inst` is the caller's in-scope record — pass it: re-reading the whole record
    file to find an entry the caller is already holding both costs a read per instance and races the caller
    (reconcile mutates `have` in memory and saves it once at the end, so a re-read here saw the PREVIOUS state)."""
    if NODE_KIND == "docker":
        if stopped:
            _wdtt_docker_stop(iface)
        else:
            if inst is None:
                inst = _wdtt_load().get(iface)
            if inst:
                inst = dict(inst); inst["iface"] = iface; _wdtt_docker_start(inst)
        return
    svc = _wdtt_svc(iface)
    if stopped:
        host_sh(sc_disable_now(svc) + " >/dev/null 2>&1")
    else:
        host_sh(sc_enable_now(svc) + " >/dev/null 2>&1")

def _wdtt_del_iptables_comment(table, chain, tag):
    """Delete every rule in <table>/<chain> whose comment is EXACTLY `tag` (the trailing quote in the rendered
    `--comment "tag"` prevents a swg-egress:wdtt7 tag from matching swg-egress:wdtt77)."""
    needle = '--comment "' + tag + '"'
    with contextlib.suppress(Exception):
        for ln in (run(["iptables", "-t", table, "-S", chain]).stdout or "").splitlines():
            if ln.startswith("-A ") and needle in ln:
                run(["sh", "-c", "iptables -t " + table + " " + ln.replace("-A ", "-D ", 1)])

def _wdtt_remove(iface):
    if not _WDTT_NAME_RE.match(iface or ""):   # never rm -rf a path built from an unvalidated name
        return
    if NODE_KIND == "docker":
        _wdtt_docker_stop(iface)                         # SIGTERM → clean interface + firewall teardown
        with contextlib.suppress(Exception): run(["ip", "link", "del", iface])
        with contextlib.suppress(Exception): shutil.rmtree(_wdtt_dir(iface))
    else:
        svc = _wdtt_svc(iface)
        host_sh(sc_disable_now(svc) + " >/dev/null 2>&1; "
                "rm -f " + shlex.quote(_wdtt_unit_path(iface)) + "; systemctl daemon-reload; "
                "ip link del " + shlex.quote(iface) + " 2>/dev/null; "
                "rm -rf " + shlex.quote(_wdtt_dir(iface)))
    # We just changed exactly what these caches describe, so serving the pre-teardown view back is not a saving,
    # it is a wrong answer: iface_candidates() reads the host proc walk, so a deleted server kept being reported
    # as an unmanaged interface — i.e. offered for ADOPTION — for the rest of the 45s TTL. The TTL exists to stop
    # a privileged one-shot container per candidate per 5s snapshot; it is not meant to outlive our own writes.
    _WDTT_HOSTPROC["at"] = 0.0
    _WDTT_CFGPROBE.pop(_wdtt_dir(iface), None)
    # Drop the node-owned egress rules for this iface — reconcile_egress won't, since the iface is already gone
    # from the WDTT record by the time it next runs (the POSTROUTING MASQUERADE would otherwise orphan).
    _wdtt_del_iptables_comment("nat", "POSTROUTING", "swg-egress:" + iface)
    _wdtt_del_iptables_comment("filter", "FORWARD", "swg-egress-acl:" + iface)
    _wdtt_del_iptables_comment("mangle", "FORWARD", "swg-egress-mss:" + iface)

_WDTT_SEALED = {}   # iface -> sealed {pub(server_pub), eph, ct, mac} of a WDTT server identity, pending upload
def wdtt_vault_process(vault_pub, want):
    """Seal each wanted WDTT instance's SERVER IDENTITY — the owner password + wg-keys.dat — to the operator
    vault (the analogue of ivk_process for interface keys). The blob rides the NEXT snapshot; the panel escrows
    only ciphertext. `pub` = the instance's WG server public key, so the panel re-requests if it ever rotates.
    No-op without a vault pub, or before the instance has been provisioned (no wg-keys.dat / not up yet).

    NOTE: this DELIBERATELY parallels ivk_process (two want lists, two _SEALED dicts, two snapshot fields, two
    panel escrow slots) rather than sharing a generic `vault_process([{kind,id}])`. With only two key-owning
    kinds the parallel is readable, and unifying now would mean refactoring the (separately, less-fully-tested)
    interface-key vault path to serve WDTT. GENERALIZE when a THIRD key-owning consumer appears — collapse both
    into one `vault_want:[{kind,id}]` + one `_SEALED` keyed by kind:id + a per-kind seal-source dispatch."""
    global _IVK_VAULT_PUB
    if vault_pub: _IVK_VAULT_PUB = vault_pub
    want = set(want or [])
    for ifn in list(_WDTT_SEALED):
        if ifn not in want: _WDTT_SEALED.pop(ifn, None)   # panel now holds it → stop sending
    if not (_IVK_VAULT_PUB and want): return
    insts = _wdtt_load()
    for ifn in want:
        with contextlib.suppress(Exception):
            inst = insts.get(ifn) or {}
            pw = (inst.get("password") or "").strip()
            keypath = _wdtt_keyfile(ifn)
            if not (pw and os.path.exists(keypath)):
                continue                                          # nothing provisioned to seal yet
            srvpub = _wdtt_server_pub(ifn)
            if not srvpub:
                continue
            cur = _WDTT_SEALED.get(ifn)
            if cur and cur.get("pub") == srvpub and cur.get("vault") == _IVK_VAULT_PUB:
                continue                                          # already sealed THIS identity, to THIS vault
            with open(keypath, "rb") as f:
                raw = f.read()
            payload = json.dumps({"password": pw, "wg_keys": base64.b64encode(raw).decode()}).encode()
            blob = ivk_seal(_IVK_VAULT_PUB, payload)
            blob["pub"] = srvpub
            blob["vault"] = _IVK_VAULT_PUB
            _WDTT_SEALED[ifn] = blob

def _wdtt_unseal_identity(sealed):
    """Open a WDTT identity blob the browser re-sealed to THIS node's transport key at restore → {password, wg_keys}."""
    with contextlib.suppress(Exception):
        d = json.loads(ivk_unseal(transport_priv(), sealed).decode())
        if isinstance(d, dict) and d.get("wg_keys"):
            return d
    return None

# What the PANEL currently claims, per turn family — recorded from the last VALID sync reply and nothing
# else. `None` means "we have never had one", which is not the same as "it claims nothing": a node that has
# only ever seen a network error must not start calling its own instances unclaimed. Same discipline as the
# reconcile invariant it sits beside.
_CLAIMED = {"wdtt": None, "csqtt": None}


def reconcile_wdtt(want, remove=None):
    """Declarative WDTT reconcile (continuous, like desired_ifaces). want = {iface: inst}. Installs missing,
    writes desired.json + SIGHUPs on password change, applies stop/start, and removes ONLY the instances the panel
    explicitly listed in `remove` — never one that is merely missing from `want`."""
    res = {"changed": 0, "errors": []}
    want = want or {}
    if isinstance(want, dict):
        _CLAIMED["wdtt"] = set(want)      # the panel has spoken: anything of ours NOT in here is unclaimed
    if not isinstance(want, dict):
        # The removal loop below runs FIRST and `iface in want` happily walks a list (or substring-matches a
        # string), so a malformed reply used to delete instances and only then raise on want.items(). Same guard
        # the sync loop already applies to `desired`.
        res["errors"].append("panel sent a malformed wdtt set (%s) — ignored" % type(want).__name__)
        return res
    have = _wdtt_load()
    if not want and not have:
        return res
    # Remove ONLY what the panel EXPLICITLY listed — the same shape interfaces and peers already use (`delete` /
    # `remove` lists). WDTT used to delete on absence, which conflates "the operator deleted it" with "this panel
    # has never heard of it": a freshly-enrolled node, or one syncing to a panel restored from an older
    # nodes.json, read as "delete everything" and took non-recreatable key material with it. panel_managed stays
    # as a second belt, so an instance the panel never acknowledged is never removed even if it appears in a list.
    # A name the panel still lists for removal but ALSO asks for is a REUSED name: the operator deleted an
    # instance and made a new one with the same iface. Honouring the removal would delete what was just created,
    # and the next sync would build it again — remove/reinstall every few seconds, forever, re-minting the owner
    # password each pass. The desired set is the newer instruction, so it wins.
    for iface in [i for i in (remove or []) if isinstance(i, str) and i not in (want or {})]:
        if iface not in have:
            continue
        if not (have.get(iface) or {}).get("panel_managed"):
            continue                                          # never acknowledged by the panel → not ours to delete
        _wdtt_remove(iface); have.pop(iface, None); res["changed"] += 1
    for iface, req in want.items():
        try:
            inst = dict(req or {}); inst["iface"] = iface
            prev = have.get(iface) or {}
            inst["panel_managed"] = True                      # the panel knows this one → a later absence IS a delete
            sealed_id = inst.pop("sealed_identity", None)   # a browser-resealed identity to restore (one-shot)
            key_blob = inst.pop("key_blob", None)           # escrowed ciphertext relayed by the panel — presence = restore possible
            # The owner -password is NODE-OWNED (the panel is blind): reuse the stored one, adopt a legacy
            # panel-supplied one (one-time migration), else it's minted below.
            # TODO-LATER (remove ~2 weeks after this ships): drop the `inst.get("password")` term — the panel no
            # longer sends the owner password, so once every instance has re-synced it is always empty (dead path).
            pw = (prev.get("password") or inst.get("password") or "").strip()
            # Has the PANEL ever owned a password on this instance? Latched on the first sync that carries one and
            # kept for ever after. It is what tells an EMPTY desired set apart from "the operator deleted the last
            # peer": until the panel has held a password here, an empty set means it doesn't KNOW the users yet —
            # and writing it reaps every one of them (our builds drop the wg peer + device for a password that is
            # gone). Read before _wdtt_serve_adopted, which unions the hand-off into inst["passwords"].
            _pw_seen = bool(prev.get("pw_seen") or (inst.get("passwords") or {}))
            if _pw_seen:
                inst["pw_seen"] = True
            # Carry the recovered foreign users across reconciles (the panel's `want` never contains them) until
            # the panel has actually taken them: once its roster-derived password set covers them, or 15 min pass,
            # the hand-off is over and the record is dropped so nothing keeps re-offering deleted peers.
            _au = prev.get("adopt_users") or {}
            if _au:
                _have = set((inst.get("passwords") or {}).keys())
                if _have and not (set(_au) - _have):
                    _au = {}
                elif int(time.time()) - int(prev.get("adopt_users_at") or 0) > 900:
                    _au = {}
            if _au:
                inst["adopt_users"] = _au
                inst["adopt_users_at"] = prev.get("adopt_users_at") or int(time.time())
                _wdtt_serve_adopted(inst)   # …and SERVE them while it is open (see the helper)
            unit_missing = not _wdtt_present(iface)          # systemd unit (bare-metal) / binary symlink (docker) absent → fresh install
            if (prev.get("adopt_failed") and not os.path.exists(_wdtt_keyfile(iface))
                    and not inst.get("adopt_foreign") and not sealed_id):
                # a take-over that was refused stays refused until the operator resolves it (retry with a path,
                # or Recreate fresh, which clears the adopt intent) — never silently becomes a fresh server
                inst["await_restore"] = True; inst["adopt_failed"] = prev["adopt_failed"]; have[iface] = inst
                res.setdefault("await", []).append(iface); continue
            provisioned = os.path.exists(_wdtt_keyfile(iface))
            # An ADOPT is honoured whenever THIS NODE has no record of the instance — not only when the box looks
            # untouched. A server this box ran BEFORE (a reinstall, a panel restored from an older nodes.json)
            # leaves OUR config-dir and OUR unit name behind, so `unit_missing`/`provisioned` both read "already
            # ours" and the seed was skipped in silence: the take-over never captured the users, the panel's empty
            # desired set reached the server, and it deleted every one of them. That is the single most common
            # thing an operator adopts (it is what "adopt what a box already runs" means), so it cannot be the one
            # case that no-ops. The seed is safe on a populated config-dir — it skips a self-copy and reads the
            # store that is already there.
            if not prev and inst.pop("adopt_foreign", None):
                # ADOPT a foreign WDTT server (panel-unmanaged, unpatched build): seeded create — copy its identity
                # + password store + owner password into OUR config-dir, stop it, then install OUR build below with
                # that same data. Clients keep working (same server pubkey + passwords). Refuses if the identity
                # can't be recovered rather than minting a fresh key and breaking every client.
                aerr = _wdtt_adopt_seed(inst)
                if aerr:
                    # HOLD, don't fall through. The refusal is only meaningful if it STICKS: the panel clears
                    # adopt_foreign once it has acked this instance, so the next sync would see an ordinary
                    # unprovisioned instance, mint a fresh key and start it — quietly turning "refused, nothing
                    # was changed" into exactly the fresh server we refused to make, minutes later, under the
                    # name the operator asked to ADOPT. Record the instance as awaiting a decision instead.
                    inst["await_restore"] = True; inst["adopt_failed"] = aerr[:200]
                    inst.pop("_restore_wg_keys", None); have[iface] = inst
                    res["errors"].append(iface + ": " + aerr)
                    res.setdefault("await", []).append(iface)
                    continue
                pw = (inst.get("password") or "").strip() or pw
                _wdtt_serve_adopted(inst)   # serve the recovered users from the FIRST start, not one sync later
                provisioned = os.path.exists(_wdtt_keyfile(iface))   # identity now seeded → don't mint/await below
            # SAFETY NET — an empty desired set must never REAP users the panel has never seen. Taking over a
            # config-dir that already holds users happens well outside adoption: a create landing on an earlier
            # install's directory, a node whose record was wiped while /opt/swg-wdtt survived, a refused adopt that
            # fell through. In every one of those the panel's roster-derived set is empty for one reason only — it
            # doesn't know these users yet — and writing it deletes them irrecoverably. Hand them UP instead (the
            # panel recreates each as a roster peer) and serve them meanwhile. The instance's own `remove` list
            # already works this way; this is the same rule one level down, at the password: a wipe needs positive
            # intent — the operator deleting a peer the panel HOLDS — never the mere absence of one.
            if not _pw_seen and not inst.get("adopt_users"):
                _pre = _wdtt_adopted_users(_wdtt_dir(iface))
                if _pre:
                    inst["adopt_users"] = _pre
                    inst["adopt_users_at"] = int(time.time())
                    _wdtt_serve_adopted(inst)
            if unit_missing and not provisioned:
                # Fresh, or a post-wipe re-provision. If the operator vaulted this instance, DON'T mint a new
                # server key (that would break every GETCONF'd client) — restore the ORIGINAL identity when the
                # sealed blob arrives, and HOLD until the operator unlocks it.
                ident = _wdtt_unseal_identity(sealed_id) if sealed_id else None
                if ident:
                    pw = (ident.get("password") or "").strip() or pw
                    inst["_restore_wg_keys"] = ident.get("wg_keys")
                elif isinstance(key_blob, dict) and key_blob.get("ct"):
                    inst["password"] = pw; inst["await_restore"] = True
                    inst.pop("_restore_wg_keys", None); have[iface] = inst
                    res.setdefault("await", []).append(iface); continue
            if not pw:
                pw = _gen_wdtt_password()
            inst["password"] = pw; inst.pop("await_restore", None)
            if not _wdtt_present(iface):
                err = _wdtt_install(inst)
                if err:
                    res["errors"].append(iface + ": " + err); continue
                res["changed"] += 1
            else:
                _want_ver = (inst.get("ver") or "").strip()   # panel-published build version → swap the shared binary if it moved
                _fk = _wdtt_fork(inst); _inst_ver = _wdtt_installed_ver(_fk)
                if _want_ver and not _inst_ver and os.path.exists(_wdtt_bin_shared(_fk)):
                    _wdtt_write_ver(_fk, _want_ver)           # first sync after upgrade: the running (unversioned) binary IS the current build → just stamp it, no re-fetch/restart
                elif _want_ver and _want_ver != _inst_ver:
                    err = _wdtt_update_binary(inst, _want_ver, _wdtt_fork_ifaces(_fk, want))
                    if err:
                        res["errors"].append(iface + ": " + err); continue
                    res["changed"] += 1
                # Heal a unit that no longer matches what this build writes — a fix to the unit itself (the PATH
                # a store-based OS needs, the restart backoff) otherwise never reaches an instance that already
                # exists, and a broken one crash-loops for ever because `present` is all reconcile looks at.
                # Rendered-text comparison, so it fires once per real change and not on every 5s sync.
                _drifted = _wdtt_unit_drifted(iface, inst, prev)
                if _drifted and inst.get("stopped"):
                    # deliberately down: the file gets the fix, the server stays stopped (see _wdtt_write_unit)
                    _e = _wdtt_write_unit(iface, inst)
                    if _e:
                        res["errors"].append(iface + ": " + _e)
                    else:
                        res["changed"] += 1
                elif _drifted or _wdtt_params_changed(prev, inst):   # listen/wg-addr/wg-port/max changed → rewrite unit + restart (identity kept)
                    # subnet MOVED → drop stale device-IP bindings first. Requires a previous subnet to have moved
                    # FROM: with no prior record (the first sync after an adopt, or a lost node record) every param
                    # reads as "changed", and resetting there threw away the device bindings — client IPs and the
                    # server-held keys behind them — of a server whose subnet had not moved at all.
                    if prev.get("wg_addr") and prev["wg_addr"] != (inst.get("wg_addr") or ""):
                        _wdtt_reset_devices(iface, _wdtt_fork(inst))
                    err = _wdtt_reconfigure(inst)
                    if err:
                        res["errors"].append(iface + ": " + err); continue
                    res["changed"] += 1
                if _wdtt_desired_changed(iface, inst.get("passwords")):   # password set changed → desired.json + SIGHUP (no restart)
                    err = _wdtt_reconcile_desired(iface, inst.get("passwords"))
                    if err:
                        res["errors"].append(iface + ": " + err); continue
                    res["changed"] += 1
            if bool(inst.get("stopped")) != bool(prev.get("stopped")):
                _wdtt_apply_stopped(iface, bool(inst.get("stopped")), inst); res["changed"] += 1
            if inst.get("restart") and inst.get("restart") != prev.get("restart") and not inst.get("stopped"):
                if NODE_KIND == "docker":
                    _wdtt_docker_start(inst)
                else:
                    host_sh("systemctl restart " + shlex.quote(_wdtt_svc(iface)) + " >/dev/null 2>&1")   # operator-requested bounce (nonce acted on once)
                res["changed"] += 1
            # bare-metal: the same supervision, for the case systemd cannot cover. Restart=on-failure brings a
            # server back from a CRASH, but not from a clean stop — a `systemctl stop` by hand, a unit left down
            # by an arm switch or a converter — and reconcile skipped it because the unit was PRESENT. The panel
            # says this instance should be running, so a node that has converged is one where it is. `activating`
            # counts as running: it is what a backing-off restart looks like, and starting it again would only
            # reset the backoff this build just added.
            if (NODE_KIND != "docker" and _wdtt_present(iface) and not bool(inst.get("stopped"))
                    and (host_sh("systemctl is-active " + shlex.quote(_wdtt_svc(iface)) + " 2>/dev/null").stdout or "").strip()
                        not in ("active", "activating", "reloading")):
                host_sh(sc_enable_now(_wdtt_svc(iface)) + " >/dev/null 2>&1")
                res["changed"] += 1
            # docker: supervise — relaunch a server that died (crash / prior noded exit), the equivalent of systemd Restart=on-failure
            if NODE_KIND == "docker" and _wdtt_present(iface) and not bool(inst.get("stopped")) and not _wdtt_docker_alive(iface):
                serr = _wdtt_docker_start(inst)
                if serr:
                    res["errors"].append(iface + ": " + serr)
                else:
                    res["changed"] += 1
            inst.pop("_restore_wg_keys", None)   # transient — never persist the restored key material to the record
            have[iface] = inst
        except Exception as e:
            res["errors"].append(iface + ": " + str(e))
    if not _wdtt_save(have):
        res["errors"].append("couldn't write the WDTT record (" + WDTT_RECORD + ") — adoption/hold state may not survive a restart")
    return res

def _wdtt_adopted_users(cfgdir):
    """The users a FOREIGN server was serving, as {password: {vk_hash, expires_at, is_deactivated, comment}} —
    everything the panel needs to recreate each one as a roster peer, and nothing else (no device/traffic rows).
    Reads whichever store the fork keeps: SQLite panel.db (ildarmaga) or passwords.json (amurcanov family)."""
    out = {}
    dbp = os.path.join(cfgdir, "panel.db")
    if os.path.isfile(dbp):
        with contextlib.suppress(Exception):
            import sqlite3
            c = sqlite3.connect(dbp, timeout=5)
            try:
                for pw, vkh, exp, deact, comment in c.execute(
                        "SELECT password, vk_hash, expires_at, is_deactivated, comment FROM wdtt_users"):
                    if pw:
                        out[pw] = {"vk_hash": (vkh or "").strip(), "expires_at": int(exp or 0),
                                   "is_deactivated": bool(deact), "comment": (comment or "").strip()[:80]}
            finally:
                c.close()
    pj = os.path.join(cfgdir, "passwords.json")
    if os.path.isfile(pj):
        with contextlib.suppress(Exception):
            with open(pj) as f:
                raw = json.load(f)
            src = raw.get("passwords") if isinstance(raw, dict) and isinstance(raw.get("passwords"), dict) else raw
            if isinstance(src, dict):
                for pw, meta in src.items():
                    if not pw or pw in out:
                        continue
                    meta = meta if isinstance(meta, dict) else {}
                    out[pw] = {"vk_hash": str(meta.get("vk_hash") or "").strip(),
                               "expires_at": int(meta.get("expires_at") or 0),
                               "is_deactivated": bool(meta.get("is_deactivated")),
                               # the JSON stores call it `name`; ildarmaga's SQLite calls it `comment`. Whichever
                               # it is, it is what the operator typed — without it every imported peer is titled
                               # "adopted" and they cannot tell one recovered user from another.
                               "comment": str(meta.get("name") or meta.get("comment") or "").strip()[:80]}
    return out


def _wdtt_read_paneldb(cfgdir):
    """ildarmaga's runtime store is SQLite panel.db (wdtt_users + wdtt_devices) — the analogue of amurcanov's
    passwords.json. Read it back for the snapshot in the SAME shape (pwds, devs). Never returns a private key.
    Under -fixed-config the single device is keyed 'pw:<password>' (getconfDeviceKey), which the caller resolves."""
    pwds, devs = {}, {}
    dbp = cfgdir + "/panel.db"
    if not os.path.exists(dbp):
        return pwds, devs
    with contextlib.suppress(Exception):
        import sqlite3
        c = sqlite3.connect(dbp, timeout=2)
        try:
            for pw, did, deact, exp, down, up in c.execute(
                    "SELECT password, device_id, is_deactivated, expires_at, down_bytes, up_bytes FROM wdtt_users"):
                pwds[pw] = {"device_id": did or "", "up_bytes": up or 0, "down_bytes": down or 0,
                            "is_deactivated": bool(deact), "expires_at": exp or 0}
            for did, ip, pub in c.execute("SELECT device_id, ip, pub_key FROM wdtt_devices"):
                devs[did] = {"ip": ip or "", "pub_key": pub or ""}
        finally:
            c.close()
    return pwds, devs

_WDTT_IFTRAF = {}   # iface -> (rx_bytes, tx_bytes, ts) — for per-second speed deltas between snapshots
def _wdtt_iface_traffic(iface):
    """The WDTT interface's cumulative rx/tx from /proc/net/dev (it's a real TUN device) + the per-second speed
    since the last read → (rx_bytes, tx_bytes, rx_speed, tx_speed). Lets the panel graph a WDTT interface exactly
    like a wg/awg one (its peers' traffic isn't in `wg show`, so this is the aggregate source)."""
    rxb = txb = 0
    try:
        with open("/proc/net/dev") as f:
            for line in f:
                if ":" not in line:
                    continue
                name, rest = line.split(":", 1)
                if name.strip() != iface:
                    continue
                p = rest.split()
                rxb, txb = int(p[0]), int(p[8]); break
    except Exception:
        return (0, 0, 0, 0)
    now = time.time(); prev = _WDTT_IFTRAF.get(iface); rs = ts = 0
    if prev and now - prev[2] > 0:
        dt = now - prev[2]
        rs = max(0, rxb - prev[0]) / dt
        ts = max(0, txb - prev[1]) / dt
    _WDTT_IFTRAF[iface] = (rxb, txb, now)
    return (rxb, txb, int(rs), int(ts))

_WDTT_PW_BYTES = {}   # iface -> {pw: (up, down, t)} for per-password speed (keyless servers have no per-peer wire counter)
def _pw_speed(cache, pw, up, dn, now):
    """Per-password rx/tx speed (B/s) from cumulative byte deltas: up = client→server = server rx, down = the reverse
    = tx. `cache` is the per-iface {pw: (up, down, t)} dict. This byte-delta IS the per-peer speed the Overview
    top-talkers use for WDTT/csqtt, which expose no per-peer wire counter (only cumulative per-password bytes)."""
    try:
        up = int(up or 0); dn = int(dn or 0)
    except Exception:
        up = dn = 0
    prev = cache.get(pw); rs = ts = 0
    if prev and len(prev) >= 3 and now - prev[2] > 0:
        dt = now - prev[2]
        rs = int(max(0, up - prev[0]) / dt); ts = int(max(0, dn - prev[1]) / dt)
    cache[pw] = (up, dn, now)
    return rs, ts

def wdtt_snapshot():
    """Read each WDTT instance's runtime state back for the panel: service active, server pubkey + endpoint
    (for client links), and per-password observed device binding + traffic. Never returns any private key."""
    out = []
    insts = _wdtt_load()
    if not insts:
        return out
    for iface, inst in insts.items():
        svc = _wdtt_svc(iface)
        if inst.get("await_restore"):
            # Held after a wipe: a vaulted identity exists but the operator hasn't unlocked it, so nothing is
            # installed yet. Report it so the panel can offer the one-click restore instead of showing "dangling".
            out.append({"iface": iface, "service": svc, "active": "inactive", "listen": inst.get("listen", ""),
                        "wg_addr": inst.get("wg_addr", ""), "wg_port": inst.get("wg_port", ""),
                        "server_pub": "", "stopped": bool(inst.get("stopped")), "await_restore": True, "fork": inst.get("fork", "amurcanov"),
                        "passwords": {}, "devices": {}})
            continue
        if NODE_KIND == "docker":
            active = "active" if _wdtt_docker_alive(iface) else "inactive"
        else:
            active = (host_sh("systemctl is-active " + shlex.quote(svc) + " 2>/dev/null").stdout or "").strip()
        _rawinfo = _wdtt_raw(inst)          # (listen, iface, addr) when this instance runs a RAW listener
        _rawon = bool(_rawinfo)
        if inst.get("fork", "amurcanov") == "ildarmaga":
            pwds, devs = _wdtt_read_paneldb(_wdtt_dir(iface))   # ildarmaga: SQLite panel.db, not passwords.json
        else:
            pj = {}
            try:
                with open(_wdtt_dir(iface) + "/passwords.json") as f:
                    pj = json.load(f) or {}
            except Exception:
                pass
            pwds = {}
            for pw, e in (pj.get("passwords") or {}).items():
                e = e or {}
                pwds[pw] = {"device_id": e.get("device_id", ""), "up_bytes": e.get("up_bytes", 0),
                            "down_bytes": e.get("down_bytes", 0), "is_deactivated": bool(e.get("is_deactivated")),
                            "expires_at": e.get("expires_at", 0)}
            devs = {}
            for did, d in (pj.get("devices") or {}).items():
                d = d or {}
                devs[did] = {"ip": d.get("ip", ""), "pub_key": d.get("pub_key", "")}   # NO priv_key
        # per-password online = the bound device's pubkey has a RECENT WG handshake. Docker: read the UAPI socket
        # directly ({pubkey_b64: last_handshake_sec}) since `awg show dump` can't read a plain wireguard-go socket.
        hs = {}
        if NODE_KIND == "docker":
            _, hs = _wdtt_uapi(iface)
        else:
            _wgdump = (host_sh("wg show " + shlex.quote(iface) + " dump 2>/dev/null").stdout or "")
            for _ln in _wgdump.splitlines()[1:]:
                _f = _ln.split("\t")
                if len(_f) >= 5:
                    try: hs[_f[0]] = int(_f[4])
                    except ValueError: pass
        _nowt = int(time.time())
        for _pw, _pe in pwds.items():
            # device lookup: stock binds by device_id; -fixed-config keys the (single) device by "pw:<password>"
            # (device-agnostic → device_id stays empty), so fall back to that or online/IP would never resolve.
            _dev = devs.get(_pe.get("device_id") or "") or devs.get("pw:" + _pw) or {}
            _pub = _dev.get("pub_key") or ""
            _hsv = hs.get(_pub, 0)
            _pe["online"] = bool(_pub and _hsv and (_nowt - _hsv) < 180)
            _pe["ip"] = _dev.get("ip", "")   # the peer's assigned WDTT IP (readback/UI)
            _pe["raw_ip"] = _dev.get("raw_ip", "")   # its RAW-datapath address, when the instance runs one
            _pe["rx_speed"], _pe["tx_speed"] = _pw_speed(_WDTT_PW_BYTES.setdefault(iface, {}), _pw, _pe.get("up_bytes"), _pe.get("down_bytes"), _nowt)   # per-peer speed for the Overview talkers
            # A RAW peer has no WireGuard handshake to read — the wg check above can only ever say "offline" for
            # it. Fall back to the same byte-delta liveness csqtt uses (moving bytes now = connected now), and
            # only for instances that actually run raw, so a wg-only peer's status logic is untouched.
            if _rawon and not _pe["online"] and (_pe["rx_speed"] or _pe["tx_speed"]):
                _pe["online"] = True
        srvpub = _wdtt_server_pub(iface)
        _rxb, _txb, _rxs, _txs = _wdtt_iface_traffic(iface)   # interface aggregate throughput → panel graphs it like a wg iface
        # RAW traffic crosses a SECOND TUN, so the wg interface's counters can't see it. Read that TUN too and
        # report the sum — otherwise an instance carrying its whole load over raw graphs as idle.
        if _rawon:
            _rrxb, _rtxb, _rrxs, _rtxs = _wdtt_iface_traffic(_rawinfo[1])
            _rxb += _rrxb; _txb += _rtxb; _rxs += _rrxs; _txs += _rtxs
        out.append({"iface": iface, "service": svc, "active": active, "listen": inst.get("listen", ""),
                    "wg_addr": inst.get("wg_addr", ""), "wg_port": inst.get("wg_port", ""),
                    "server_pub": srvpub, "stopped": bool(inst.get("stopped")), "fork": inst.get("fork", "amurcanov"),
                    "raw_port": (inst.get("raw_port") or "") if _rawon else "",   # RAW listener (empty = off)
                    "raw_iface": _rawinfo[1] if _rawon else "", "raw_addr": _rawinfo[2] if _rawon else "",
                    "version": _wdtt_installed_ver(inst.get("fork", "amurcanov")),   # installed build version (version board + rollback)
                    # T-18: the two TRANSPORT params _wdtt_params_changed compares that nothing else reported.
                    # Without them the panel cannot describe a running instance completely, so a record mirrored
                    # from this report reads as a parameter change on the next sync and rewrites the unit +
                    # RESTARTS a live server. Reported so the mirror can be lossless — and so the panel can tell
                    # a complete report from an old node's partial one and decline to mirror the partial.
                    "max_passwords": inst.get("max_passwords") or "",
                    "params": inst.get("params") or "",
                    "rx_bytes": _rxb, "tx_bytes": _txb, "rx_speed": _rxs, "tx_speed": _txs,
                    # Users recovered from a foreign server at take-over, for the panel to adopt into the roster.
                    # Reported until it has them (reconcile_wdtt drops the record once they appear in `desired`),
                    # NOT every cycle from the live store — that would resurrect a peer the operator deleted.
                    "adopt_users": inst.get("adopt_users") or {},
                    "passwords": pwds, "devices": devs})
    return out


# ── csqtt node lifecycle (parallel to reconcile_wdtt; bare-metal systemd) ─────────────────────────────────────
def _csqtt_svc(iface): return "swg-csqtt-" + iface
def _csqtt_dir(iface): return CSQTT_ROOT + "/" + iface
def _csqtt_bin_shared(): return CSQTT_BIN_DIR + "/" + _turn_arch() + "/csqtt-server"
# csqtt ships one implementation today; the instance still records WHICH fork, so a second one can never be
# silently substituted the way an unknown WDTT fork used to be (see _wdtt_fork_unknown).
CSQTT_FORK_OWNER = {"csqtt": "amurcanov/csqtt"}
def _csqtt_fork_unknown(inst):
    f = ((inst or {}).get("fork") or "").strip()
    return "" if (not f or f in CSQTT_FORK_OWNER) else f
def _csqtt_unit_path(iface): return turn_unit_dir() + "/" + _csqtt_svc(iface) + ".service"
def _csqtt_present(iface):
    """Is this instance set up on THIS node? docker: its binary symlink is laid down. systemd: unit AND binary."""
    if NODE_KIND == "docker":
        return os.path.exists(_csqtt_dir(iface) + "/server")
    # bare-metal: the unit file AND a WORKING binary symlink must BOTH be laid down — the same rule
    # _wdtt_present already enforces, which is why WDTT survived this and csqtt did not. A unit whose
    # `server` symlink is missing or dangling is NOT "present": treating it as installed sends the
    # reconcile down the update branch (_csqtt_reconfigure), which re-lays the symlink and restarts but
    # NEVER fetches, so the instance sits in a 203/EXEC crash-loop reporting "starting" for ever — it
    # only recovers if some OTHER instance's install happens to fetch the shared binary. os.path.exists
    # follows the link, so a dangling one (binary not fetched yet, or /opt wiped under a unit that lives
    # in /run) re-installs. Measured on the nix box: unit started 13:13:16, binary landed 13:17:21.
    return os.path.exists(_csqtt_unit_path(iface)) and os.path.exists(_csqtt_dir(iface) + "/server")
def _csqtt_subnet(cidr):
    try: return str(ipaddress.ip_network(cidr, strict=False))
    except Exception: return ""

def _csqtt_load():
    with contextlib.suppress(Exception):
        with open(CSQTT_RECORD) as f:
            d = json.load(f)
            if isinstance(d, dict): return d
    return {}

def _csqtt_save(insts):
    with contextlib.suppress(Exception):
        os.makedirs(os.path.dirname(CSQTT_RECORD), exist_ok=True)
        tmp = CSQTT_RECORD + ".tmp"
        with open(tmp, "w") as f:
            json.dump(insts, f)
        os.replace(tmp, CSQTT_RECORD)
    return os.path.isfile(CSQTT_RECORD)

def _gen_csqtt_password():
    return base64.urlsafe_b64encode(os.urandom(18)).decode().rstrip("=")

def _csqtt_webport(listen):
    # deterministic per-instance HTTPS admin port derived from the DTLS listen port (won't clash with it)
    try:
        p = int(str(listen).rsplit(":", 1)[-1]); return (p + 1000) if p + 1000 < 65535 else (p - 1000)
    except Exception:
        return 46002

def _csqtt_desired_body(passwords):
    """csqtt desired.json = a LIST of panel-owned password records (matches the Rust patch's SwgDesiredFile).
    NOTE the shape differs from WDTT's dict-keyed-by-password body."""
    out = []
    for pw, e in (passwords or {}).items():
        e = e or {}
        out.append({"password": pw, "expires_at": int(e.get("expires_at") or 0),
                    "vk_hash": str(e.get("vk_hash") or ""), "name": str(e.get("name") or ""),
                    "is_deactivated": bool(e.get("is_deactivated"))})
    return json.dumps({"passwords": out})

def _csqtt_env_text(inst):
    cfgdir = _csqtt_dir(inst["iface"])
    return ("SWG_LISTEN=%s\nSWG_WEBPORT=%s\nSWG_CFGDIR=%s\nSWG_DESIRED=%s\nSWG_IFACE=%s\nSWG_TUNADDR=%s\n"
            "SWG_PASSWORD=%s\nSWG_WEBPASS=%s\nSWG_MAXPW=%s\nSWG_PARAMS=%s\n" % (
                inst["listen"], inst.get("web_port") or _csqtt_webport(inst["listen"]), cfgdir,
                cfgdir + "/desired.json", inst["iface"], inst["tun_addr"],
                inst.get("password") or "", inst.get("web_pass") or "",
                inst.get("max_passwords") or 500, (inst.get("params") or "").strip()))

def _csqtt_unit_text(iface, binp, cfgdir):
    # csqtt = raw-IP TUN + io_uring: needs CAP_NET_ADMIN + /dev/net/tun AND the io_uring syscall set, which is NOT
    # in @system-service by default → allow @io-uring explicitly or the dataplane seccomp-dies. --no-nat: the NODE
    # owns MASQUERADE/forward for the csqtt subnet (reconcile_egress). --no-web: run headless — csqtt's own admin
    # panel (binds 0.0.0.0) + its DPI/syscalls monitor sockets are unused surfaces since the panel owns state via
    # --desired. $SWG_PARAMS unbraced (word-split; empty contributes nothing) — same as WDTT.
    return ("[Unit]\nDescription=swg-csqtt (" + CSQTT_OWNER + ") — " + iface + "\n"
            "After=network-online.target\nWants=network-online.target\n\n"
            "[Service]\nType=simple\n" + _fork_unit_path_env() + "EnvironmentFile=-" + cfgdir + "/csqtt.env\n"
            # Same recovery as the docker path's _csqtt_clear_stale_tun: a TUN still holding this name makes the
            # server die on "create TUN device", and Restart=on-failure then retries against it forever. `-` so the
            # normal case, where there is nothing to delete, is not a startup failure.
            "ExecStartPre=-/bin/sh -c 'ip link delete dev \"$SWG_IFACE\" 2>/dev/null || true'\n"
            "ExecStart=" + binp + " --listen ${SWG_LISTEN} --config-dir ${SWG_CFGDIR}"
            " --password ${SWG_PASSWORD} --no-web"
            " --iface ${SWG_IFACE} --tun-addr ${SWG_TUNADDR} --desired ${SWG_DESIRED} --no-nat"
            " --max-passwords ${SWG_MAXPW} $SWG_PARAMS\n"
            # Backs off like the WDTT unit: 3s → 5 min over 8 steps. csqtt's own history is the argument —
            # the @io-uring syscall group that does not exist left every bare-metal instance restarting
            # every 3s for ever. systemd <254 ignores both keys (today's behaviour). _csqtt_unit_drifted
            # carries this to instances that already exist, at one restart each.
            "Restart=on-failure\nRestartSec=3\nRestartSteps=8\nRestartMaxDelaySec=300\n"
            "NoNewPrivileges=yes\nAmbientCapabilities=CAP_NET_ADMIN\nCapabilityBoundingSet=CAP_NET_ADMIN\n"
            "DeviceAllow=/dev/net/tun rw\nProtectHome=yes\nProtectSystem=strict\nReadWritePaths=" + cfgdir + "\n"
            "ProtectControlGroups=yes\nProtectKernelModules=yes\nRestrictSUIDSGID=yes\nLockPersonality=yes\n"
            # @aio is where systemd keeps io_uring_setup/_enter/_register. "@io-uring" is NOT a systemd group and
            # never was: systemd logged "Unknown system call group, ignoring: @io-uring" and applied @system-service
            # alone — which contains none of the three. With SystemCallErrorNumber=EPERM they then returned EPERM
            # rather than dying loudly, so csqtt's io_uring dataplane (which has no fallback) failed on every
            # bare-metal node since csqtt shipped. Docker never hit it: a container has no systemd, so only the
            # docker seccomp profile applied there.
            "SystemCallFilter=@system-service @aio\nSystemCallErrorNumber=EPERM\n\n"
            "[Install]\nWantedBy=multi-user.target\n")

SWG_BUILD_REPO = os.environ.get("SWG_BUILD_REPO") or "SanityProtocol/swg-panel"   # where OUR patched server builds are published

def _swg_release_get(tag, arch, dest, want, what):
    """Download one of OUR published server binaries → dest. (True, "") on success, else (False, why).

    A TAG IS REQUIRED and there is deliberately no 'latest' path. One repository publishes the binaries for six
    different servers, so releases/latest is whichever of them was published most recently — right now that is
    csqtt-2.0.1. A versionless fetch would cheerfully install one server's binary as another's and try to run it,
    which is a far worse outcome than not downloading at all. No pinned version → no direct download.
    """
    if not tag:
        return (False, "the panel sent no version to pin, and this repo publishes several servers — "
                       "there is no safe 'latest' to fall back to")
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
    except OSError as e:
        return (False, "mkdir: " + str(e))
    err = ""
    for url in _turn_dl_urls(SWG_BUILD_REPO, arch, tag):
        r = run(["curl", "-4", "-fsSL", "--connect-timeout", "20", "--max-time", "240", "--retry", "3",
                 "--retry-delay", "3", "--retry-all-errors", url, "-o", dest], timeout=320)
        if r.returncode == 0:
            if not _turn_sha_ok(dest, want):          # never chmod+exec bytes that don't match the panel's hash
                with contextlib.suppress(OSError): os.remove(dest)
                return (False, "checksum mismatch — refusing to run an unverified " + what + " binary")
            with contextlib.suppress(OSError): os.chmod(dest, 0o755)
            # Say so. A fallback that silently succeeds papers over a broken mirror: the panel could be resolving
            # the wrong URL for months and every node would quietly paper over it by going direct — which is
            # exactly how the csqtt owner-mapping bug stayed invisible. Working is not the same as healthy.
            print("fetch: %s %s came from GitHub direct — the panel's mirror did not serve it" % (what, tag),
                  flush=True)
            return (True, "")
        err = (r.stderr or "").strip().replace("\n", " ")[:120]
    return (False, "GitHub was unreachable from this node" + ((": " + err) if err else ""))

def _csqtt_fetch_bin(inst, binshared):
    """Put the csqtt server binary at `binshared`. '' on success, else WHY not — naming the actual cause.

    Panel mirror FIRST (the node already holds an outbound channel to the panel, and reaches it on boxes where
    GitHub is blocked), then GitHub-direct plus any operator mirrors — the same order and fallback the turn-proxy
    forks have used since the checksum gate landed.

    csqtt shipped with only the first half. On a panel that cannot reach github.com — which is the normal case for
    a Russian-hosted panel — every node was left with no binary at all, and told "panel mirror has no build yet":
    a message that blames US for not publishing the release, when the release exists and it was the panel's own
    fetch that failed. Nothing in that sentence pointed at the network, so there was nothing to act on.
    """
    if not _turn_arch_ok():
        return ("no csqtt build for this architecture (" + os.uname().machine + ") — we publish amd64/arm64 only")
    arch = _turn_arch()
    ver = (inst.get("ver") or "").strip()
    want = (inst.get("sha256") or "").strip()
    if _csqtt_panel_fetch(binshared, want, ver or "csqtt") and os.path.exists(binshared):
        return ""
    okd, why = _swg_release_get(("csqtt-" + ver) if ver else "", arch, binshared, want, "csqtt")
    if okd:
        return ""
    return ("couldn't fetch the csqtt binary for " + arch + (" " + ver if ver else "")
            + " — the panel's mirror had none, and " + why
            + ". If GitHub is blocked here, set SWG_TURN_MIRROR on the panel to a proxy you trust.")

def _csqtt_panel_fetch(dest, want_sha, tag="csqtt"):
    """Fetch our patched csqtt server from the panel mirror (same /api/node/turn-binary transport, keyed by the
    csqtt owner + a version tag). Best-effort; A2 pre-places the binary, the panel CSQTT_BUILDS lands in A3."""
    with contextlib.suppress(Exception):
        return _turn_panel_fetch(CSQTT_OWNER, tag or "csqtt", _turn_arch(), dest, want_sha)
    return False

def _csqtt_write_cfgdir(inst, binshared, binp, cfgdir):
    """Lay down the config-dir (binary symlink + csqtt.env + desired.json) natively — a partial failure RAISES
    before the unit is written, so there is never a half-installed instance to wedge the reconcile."""
    os.makedirs(cfgdir, exist_ok=True); os.makedirs(os.path.dirname(binshared), exist_ok=True)
    with contextlib.suppress(Exception): os.chmod(binshared, 0o755)
    with contextlib.suppress(Exception):
        if os.path.islink(binp) or os.path.exists(binp): os.remove(binp)
        os.symlink(binshared, binp)
    with open(cfgdir + "/csqtt.env", "w") as f: f.write(_csqtt_env_text(inst))
    with open(cfgdir + "/desired.json", "w") as f: f.write(_csqtt_desired_body(inst.get("passwords")) + "\n")

# ── Docker run-model (mirror of the WDTT one above) ──────────────────────────────────────────────────────────
# A container has no systemd, so on a docker node swg-noded runs each csqtt server as a SUPERVISED CHILD PROCESS
# in THIS container. With host networking its raw TUN lands in the right netns automatically. reconcile_csqtt
# relaunches a died server on the next pass (the equivalent of Restart=on-failure); SIGHUP reloads desired.json
# live; SIGTERM runs its clean teardown. Everything — binary, config-dir, store — lives where noded runs, so
# nothing goes through host_sh (which nsenters the HOST, where these files must NOT be).
_CSQTT_PROCS = {}   # iface -> subprocess.Popen (this noded lifetime)

def _csqtt_pidfile(iface): return _csqtt_dir(iface) + "/server.pid"

def _csqtt_argv(inst, binp):
    """The exact server invocation (mirror of _csqtt_unit_text's ExecStart) as an argv list, for a direct Popen."""
    iface = inst["iface"]; cfgdir = _csqtt_dir(iface)
    a = [binp, "--listen", inst.get("listen") or "", "--config-dir", cfgdir,
         "--password", inst.get("password") or "", "--no-web",
         "--iface", iface, "--tun-addr", inst.get("tun_addr") or "",
         "--desired", cfgdir + "/desired.json", "--no-nat",
         "--max-passwords", str(inst.get("max_passwords") or 500)]
    params = (inst.get("params") or "").strip()
    if params:
        with contextlib.suppress(Exception):
            a += shlex.split(params)
    return a

def _csqtt_docker_pid(iface):
    """The live server pid for iface (tracked Popen, else the pidfile verified against /proc cmdline), or None."""
    p = _CSQTT_PROCS.get(iface)
    if p is not None and p.poll() is None:
        return p.pid
    with contextlib.suppress(Exception):
        with open(_csqtt_pidfile(iface)) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if ("--iface\x00" + iface + "\x00").encode() in f.read():
                return pid
    return None

def _csqtt_clear_stale_tun(iface):
    """Drop a TUN still holding this instance's NAME before starting it.

    The raw TUN can outlive its process (the same reason _csqtt_stop_foreign and _csqtt_remove delete it), and while
    it does, the name is taken: the server dies at once with "create TUN device" and keeps doing so on every later
    attempt, so the instance never comes back on its own. Observed on a converted box, where a bare-metal server the
    convert never stopped was still holding csqtt1/csqtt2 — but the wedge is the same whatever stranded the device,
    which is why the recovery lives here rather than only in the convert.
    Skipped while a FOREIGN server is live on that name: adoption stops that one first, and pulling its datapath out
    from under it would be the wrong kind of fix."""
    procs = _csqtt_procs()
    if not _csqtt_scan_ok():
        # Fail SAFE. Deleting the device is only correct once we KNOW no foreign server is on this name; with the
        # scan incomplete this is precisely the branch that pulls a live third party's datapath out from under it.
        # Worst case we skip a cleanup and the instance reports "create TUN device" — recoverable, and loud.
        print("swg-noded: csqtt " + iface + ": skipping stale-TUN cleanup — the process scan did not complete, "
              "so a foreign server holding this name would be invisible", flush=True)
        return
    if any((f.get("iface") or "").strip() == iface
           and not (f.get("config-dir") or "").startswith(CSQTT_ROOT + "/") for _p, f in procs):
        return
    with contextlib.suppress(Exception): run(["ip", "link", "delete", "dev", iface])

def _csqtt_docker_start(inst):
    """(Re)launch this instance's server as a supervised child. '' on success (alive after a beat), else error."""
    iface = inst["iface"]; cfgdir = _csqtt_dir(iface); binp = cfgdir + "/server"
    _csqtt_docker_stop(iface)
    _csqtt_clear_stale_tun(iface)   # a recreated container leaves its TUN behind, and the name with it
    if not os.path.exists(binp):
        return "csqtt binary missing at " + binp
    # Where THIS attempt's output starts. The log is append-only and holds every previous failure, so reading a
    # blind tail attributes an old error to a new attempt — which is exactly how a bind failure came back
    # reported as a seccomp problem.
    # Rotate BEFORE the offset is taken, so _from stays consistent with the file the child appends to (after a
    # rotation there is no file, getsize raises, and _from correctly stays 0 = the start of this attempt).
    _rotate_serverlog(cfgdir + "/server.log")
    _from = 0
    with contextlib.suppress(Exception):
        _from = os.path.getsize(cfgdir + "/server.log")
    try:
        lf = open(cfgdir + "/server.log", "ab", buffering=0)
        p = subprocess.Popen(_csqtt_argv(inst, binp), stdout=lf, stderr=lf, stdin=subprocess.DEVNULL, close_fds=True)
    except Exception as e:
        return ("spawn failed: " + str(e))[:160]
    _CSQTT_PROCS[iface] = p
    with contextlib.suppress(Exception):
        with open(_csqtt_pidfile(iface), "w") as f: f.write(str(p.pid))
    time.sleep(1.5)
    if p.poll() is not None:                       # died immediately → surface the log tail
        tail = ""
        with contextlib.suppress(Exception):
            with open(cfgdir + "/server.log", "rb") as f:
                f.seek(_from)
                tail = f.read()[-240:].decode("utf-8", "replace").replace("\n", " ")
        # csqtt's dataplane is io_uring and has no fallback, and Docker's DEFAULT seccomp profile denies
        # io_uring_setup — so on a container node the server dies instantly with a message that says nothing
        # about the actual cause. Name it: the operator cannot guess this one, and the fix is a container
        # setting, not anything they can change in the panel.
        # Match the CAUSE line, not the word: every csqtt dataplane failure is reported under the banner
        # "start io_uring protocol dataplane", so a substring test called a bind clash a seccomp problem.
        if "create io_uring" in tail:
            # The remedy is a container setting, not anything the operator can reach from the panel — so
            # apply it here instead of printing instructions and waiting. Returns a message either way.
            return _csqtt_seccomp_autofix() or (
                "csqtt needs the io_uring syscalls, which this container's seccomp profile denies. "
                "Set SWG_NODE_SECCOMP=unconfined in the node's .env and re-run "
                "`docker compose up -d swg-node` — it starts on the next sync.")
        return ("csqtt exited rc=%s: %s" % (p.returncode, tail.strip()))[:180]
    return ""

SECCOMP_MARK = os.path.join(STATE_DIR, ".seccomp-applied")   # bind-mounted → survives the recreate it triggers


def _csqtt_seccomp_autofix():
    """Apply SWG_NODE_SECCOMP=unconfined on the HOST and recreate this container, once.

    csqtt's dataplane is io_uring and has no fallback; docker's default seccomp profile denies
    io_uring_setup, so a csqtt server in a container dies the instant it starts. The remedy is a
    container-level setting the node cannot reach from inside itself — .env is not even mounted here — so
    until now the panel could only print the line and wait for somebody to edit a file over SSH.

    Do it instead. The operator already approved the thing that requires it: they asked for a csqtt server
    on this node, and the seccomp profile is an implementation detail of running one, no different from
    NET_ADMIN. The change is scoped to this node's container and nothing else on the box.

    Once per node, and the marker is written BEFORE the recreate — the recreate kills this process, and a
    fix that re-applied itself on every start would be a restart loop rather than a repair. Plain `up -d`,
    not the update trigger: the container is recreated to re-read .env, NOT updated to a new image, which
    is not what the operator asked for. An operator's own SWG_NODE_SECCOMP line is never overwritten.
    """
    if NODE_KIND != "docker":
        return ""
    # A DECLARATIVE host owns this container: there is no .env to edit and no compose to re-run, and
    # both the write and the advice were nonsense there — the write failed on every sync (rc 3, one
    # noisy host_sh line per 5s) and the message told a NixOS operator to run docker compose. Name the
    # option that actually governs it instead, and touch nothing.
    if NODE_DECLARATIVE:
        return ("csqtt needs the io_uring syscalls, which this container's seccomp profile denies. "
                "This node is managed declaratively, so set it there — `services.swg-node.seccomp = "
                "\"unconfined\";` — and rebuild. csqtt starts on the next sync.")
    if os.path.exists(SECCOMP_MARK):
        return ("csqtt needs the io_uring syscalls, which this container's seccomp profile denies. "
                "SWG_NODE_SECCOMP=unconfined was already applied here and csqtt still cannot start — "
                "check that the container was recreated (`docker compose --profile node up -d swg-node`).")
    if not SWG_HOST_NODE_DIR:
        return ""                                  # can't locate the install on the host — leave the hint as-is
    inst = os.path.dirname(os.path.dirname(SWG_HOST_NODE_DIR))    # …/data/node → the compose directory
    envf = inst + "/.env"
    line = ("SWG_NODE_SECCOMP=unconfined   # csqtt needs io_uring, which the default seccomp profile denies "
            "(applied by swg-noded)")
    # rc 3 = no .env to edit; rc 4 = the operator already has a line of their own, whatever its value.
    r = host_sh("[ -f %s ] || exit 3; grep -q '^SWG_NODE_SECCOMP=' %s && exit 4; printf '%%s\\n' %s >> %s"
                % (shlex.quote(envf), shlex.quote(envf), shlex.quote(line), shlex.quote(envf)))
    if r.returncode == 4:
        return ("csqtt needs the io_uring syscalls, which this container's seccomp profile denies. "
                "%s already sets SWG_NODE_SECCOMP — csqtt needs the value `unconfined`, then "
                "`docker compose --profile node up -d swg-node`." % envf)
    if r.returncode != 0:
        return ("csqtt needs the io_uring syscalls, which this container's seccomp profile denies. Set "
                "SWG_NODE_SECCOMP=unconfined in %s and re-run `docker compose --profile node up -d "
                "swg-node` — this node could not write that file itself." % envf)
    with contextlib.suppress(Exception):
        with open(SECCOMP_MARK, "w") as f:
            f.write(str(int(time.time())) + "\n")
    print("csqtt: wrote SWG_NODE_SECCOMP=unconfined to " + envf + " — recreating this container so it takes "
          "effect (csqtt's io_uring dataplane is denied without it)", flush=True)
    # Recreating our own container kills this process mid-call: that is the expected end of this function,
    # and the helper runs on the host, so the recreate completes regardless.
    host_sh("cd %s && (docker compose --profile node up -d swg-node || "
            "docker-compose --profile node up -d swg-node)" % shlex.quote(inst), timeout=180)
    return ("csqtt needs the io_uring syscalls, which this container's seccomp profile denies. "
            "SWG_NODE_SECCOMP=unconfined has been applied and the node container recreated — csqtt "
            "starts on the next sync.")


def _csqtt_docker_stop(iface):
    """SIGTERM (clean teardown drops the TUN), SIGKILL if it lingers; reap the child; drop the pidfile."""
    p = _CSQTT_PROCS.pop(iface, None)
    pid = p.pid if p is not None else _csqtt_docker_pid(iface)
    if pid:
        with contextlib.suppress(Exception): os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            try:
                os.kill(pid, 0); time.sleep(0.15)
            except Exception:
                break
        else:
            # for/else — SIGKILL only if it is STILL alive. A pid read from the pidfile after a noded restart is
            # not our child, so it is reaped the instant it exits and the number can already belong to something else.
            with contextlib.suppress(Exception): os.kill(pid, signal.SIGKILL)
    if p is not None:
        with contextlib.suppress(Exception): p.wait(timeout=2)
    with contextlib.suppress(Exception): os.remove(_csqtt_pidfile(iface))

def _csqtt_docker_sighup(iface):
    pid = _csqtt_docker_pid(iface)
    if pid:
        with contextlib.suppress(Exception): os.kill(pid, signal.SIGHUP)
        return True
    return False


def _csqtt_verify(iface):
    if NODE_KIND == "docker":                      # the supervised child IS the service
        for _ in range(8):
            time.sleep(0.5)
            if _csqtt_docker_pid(iface):
                return ""
        return "server did not stay up — see " + _csqtt_dir(iface) + "/server.log (io_uring/seccomp?)"
    for _ in range(8):
        time.sleep(0.5)
        if (host_sh("systemctl is-active " + shlex.quote(_csqtt_svc(iface)) + " 2>/dev/null").stdout or "").strip() == "active":
            return ""
    return "service did not become active — check `journalctl -u " + _csqtt_svc(iface) + "` (io_uring/seccomp?)"

def _csqtt_install(inst):
    _unk = _csqtt_fork_unknown(inst)
    if _unk:
        return ("this node doesn't know the csqtt fork '" + _unk + "' — its swg-noded is older than the panel. "
                "Update the node (its page offers \"update node to …\"), then this server installs on the next sync. "
                "Known here: " + ", ".join(sorted(CSQTT_FORK_OWNER)) + ".")
    iface = inst["iface"]; cfgdir = _csqtt_dir(iface)
    binshared = _csqtt_bin_shared(); binp = cfgdir + "/server"
    if not os.path.exists(binshared):
        _err = _csqtt_fetch_bin(inst, binshared)          # panel mirror, then GitHub-direct + operator mirrors
        if _err:
            return _err
        if not os.path.exists(binshared):                 # fetch reported success but wrote nothing → say so plainly
            return "csqtt binary missing after a reportedly successful fetch — check free space on " + os.path.dirname(binshared)
    try:
        _csqtt_write_cfgdir(inst, binshared, binp, cfgdir)
    except Exception as e:
        return ("cfgdir write failed: " + str(e))[:160]
    if NODE_KIND == "docker":
        err = _csqtt_docker_start(inst)
        return err or _csqtt_verify(iface)
    try:
        with open(_csqtt_unit_path(iface), "w") as f: f.write(_csqtt_unit_text(iface, binp, cfgdir))
    except Exception as e:
        return ("unit write failed: " + str(e))[:160]
    host_sh("systemctl daemon-reload; " + sc_enable_now(_csqtt_svc(iface)) + " >/dev/null 2>&1")
    return _csqtt_verify(iface)

def _csqtt_reconcile_desired(iface, passwords):
    """Write the panel's desired password set + SIGHUP the server → applied with no restart / no tunnel drop."""
    cfgdir = _csqtt_dir(iface)
    try:
        with open(cfgdir + "/desired.json", "w") as f: f.write(_csqtt_desired_body(passwords) + "\n")
    except Exception as e:
        return ("desired write failed: " + str(e))[:160]
    if NODE_KIND == "docker":
        # No child to signal is NOT a reload failure: desired.json is already on disk and a start reads it.
        # Reporting an error here would `continue` past the supervision that relaunches the server — and would
        # replace the real reason it is down (which the start carries) with a symptom.
        _csqtt_docker_sighup(iface)
        return ""
    w = host_sh("systemctl kill -s HUP " + shlex.quote(_csqtt_svc(iface)) + " 2>/dev/null || true")
    return "" if w.returncode == 0 else (w.stderr or w.stdout or "reconcile failed").strip()[:160]

def _csqtt_desired_changed(iface, passwords):
    try:
        with open(_csqtt_dir(iface) + "/desired.json") as f:
            cur = f.read().strip()
    except Exception:
        return True
    return cur != _csqtt_desired_body(passwords).strip()

def _csqtt_params_changed(prev, inst):
    return ((prev.get("listen") or "") != (inst.get("listen") or "")
            or (prev.get("tun_addr") or "") != (inst.get("tun_addr") or "")
            or str(prev.get("max_passwords") or 500) != str(inst.get("max_passwords") or 500)
            or (prev.get("params") or "").strip() != (inst.get("params") or "").strip())

def _csqtt_unit_drifted(iface, inst):
    """True when the on-disk unit differs from what this build would write (docker has no unit → never)."""
    if NODE_KIND == "docker":
        return False
    try:
        with open(_csqtt_unit_path(iface)) as f:
            have = f.read()
    except OSError:
        return False                       # missing unit is the install path's problem, not a drift
    cfgdir = _csqtt_dir(iface)
    return have.strip() != _csqtt_unit_text(iface, cfgdir + "/server", cfgdir).strip()

def _csqtt_reconfigure(inst):
    """Apply a transport-param change (listen / tun-addr / max / params) to a running instance: rewrite csqtt.env
    + the unit and restart. The store (passwords.json) is preserved."""
    iface = inst["iface"]; cfgdir = _csqtt_dir(iface); binp = cfgdir + "/server"
    binshared = _csqtt_bin_shared()
    if not os.path.exists(binshared):        # same-arch self-heal, mirroring _wdtt_reconfigure: without this
        _e = _csqtt_fetch_bin(inst, binshared)   # a reconfigure lays a DANGLING symlink and restarts into 203/EXEC
        if _e:
            return _e
        if not os.path.exists(binshared):
            return "csqtt binary missing after a reportedly successful fetch — check free space on " + os.path.dirname(binshared)
    try:
        _csqtt_write_cfgdir(inst, binshared, binp, cfgdir)
        if NODE_KIND != "docker":
            with open(_csqtt_unit_path(iface), "w") as f: f.write(_csqtt_unit_text(iface, binp, cfgdir))
    except Exception as e:
        return ("reconfigure failed: " + str(e))[:160]
    if NODE_KIND == "docker":
        err = _csqtt_docker_start(inst)            # respawn with the new argv
        return err or _csqtt_verify(iface)
    host_sh("systemctl daemon-reload; systemctl restart " + shlex.quote(_csqtt_svc(iface)) + " >/dev/null 2>&1")
    return _csqtt_verify(iface)

def _csqtt_remove(iface):
    if not _CSQTT_NAME_RE.match(iface or ""):   # never rm -rf a path built from an unvalidated name
        return
    if NODE_KIND == "docker":
        _csqtt_docker_stop(iface)
        with contextlib.suppress(Exception): run(["ip", "link", "delete", "dev", iface])
        with contextlib.suppress(Exception): shutil.rmtree(_csqtt_dir(iface), ignore_errors=True)
        _CSQTT_LASTBYTES.pop(iface, None)
        _wdtt_del_iptables_comment("nat", "POSTROUTING", "swg-egress:" + iface)
        _wdtt_del_iptables_comment("filter", "FORWARD", "swg-egress-acl:" + iface)
        _wdtt_del_iptables_comment("mangle", "FORWARD", "swg-egress-mss:" + iface)
        return
    svc = _csqtt_svc(iface)
    host_sh(sc_disable_now(svc) + " >/dev/null 2>&1; "
            "rm -f " + shlex.quote(_csqtt_unit_path(iface)) + "; systemctl daemon-reload; "
            "ip link del " + shlex.quote(iface) + " 2>/dev/null; "
            "rm -rf " + shlex.quote(_csqtt_dir(iface)))
    _CSQTT_LASTBYTES.pop(iface, None)
    # node-owned egress rules (reconcile_egress won't drop them — the iface is already gone from the record)
    _wdtt_del_iptables_comment("nat", "POSTROUTING", "swg-egress:" + iface)
    _wdtt_del_iptables_comment("filter", "FORWARD", "swg-egress-acl:" + iface)
    _wdtt_del_iptables_comment("mangle", "FORWARD", "swg-egress-mss:" + iface)

# A FOREIGN csqtt's config-dir lives on the HOST — the one that prompted this ran as its own container with
# /etc/csqtt bind-mounted from the host — so on a docker node os.path.isfile() from in here (the swg-node
# container) always says no. This is exactly why the WDTT scan has _wdtt_cfg_probe; csqtt read the store with a
# plain open() and so would have reported EVERY foreign server as having zero users, then stopped it and taken
# over serving nobody. One batched host probe, cached like the proc walk: this runs per candidate per 5s
# snapshot, and paying a privileged one-shot container for each of those would be ruinous.
_CSQTT_STOREPROBE = {}         # cfgdir -> (at, (users, store_found))
_CSQTT_STORE_MAX = 8 << 20     # a probe, not a backup — a store bigger than this is answered after adoption

def _csqtt_users_from_text(raw):
    """Parse a csqtt passwords.json body → {password: {vk_hash, expires_at, is_deactivated, comment}}. csqtt keeps
    ONE store shape, unlike the WDTT family's two — same fields, so the panel's importer treats both identically."""
    out = {}
    with contextlib.suppress(Exception):
        data = json.loads(raw)
        src = data.get("passwords") if isinstance(data, dict) and isinstance(data.get("passwords"), dict) else data
        if isinstance(src, dict):
            for pw, e in src.items():
                if not pw or not isinstance(e, dict):
                    continue
                out[str(pw)] = {"vk_hash": str(e.get("vk_hash") or "").strip(),
                                "expires_at": int(e.get("expires_at") or 0),
                                "is_deactivated": bool(e.get("is_deactivated")),
                                # the JSON stores call it `name`; whichever it is, it is what the operator typed —
                                # without it every imported peer is titled "adopted" and they cannot tell them apart
                                "comment": str(e.get("name") or e.get("comment") or "").strip()[:80]}
    return out


def _csqtt_store_probe(cfgdir, fresh=False, pid=None):
    """(users, store_found) for a csqtt config-dir — one of ours or a foreign one.

    store_found means we LOCATED AND READ the store. That is deliberately NOT the same question as "does it have
    users": an empty store is a legitimate state for a freshly started server, while "we could not look" must never
    be presented to the operator as "there is nothing here to lose". Adopting on that confusion would stop a live
    server and take over serving nobody — the users it was serving simply gone. The adopt turns the difference into
    a warning that has to be accepted explicitly.

    `fresh` skips the cache for the take-over itself: that read happens once and is destructive if it is wrong."""
    if not cfgdir:
        return {}, False
    now = time.time()
    # csqtt ships a Docker install too, and it has NO identity file — the password store IS the whole credential.
    # Reading a containerised server's -config-dir on the host therefore does not merely mislabel it: adopting on
    # another install's store at the same path takes over serving THAT store's users and silently drops every user
    # this server actually had. Read it the way the process sees it (see _proc_cfg_root); "" for a host process.
    _root = _proc_cfg_root(pid)
    _ck = (_root, cfgdir)
    hit = _CSQTT_STOREPROBE.get(_ck)
    if hit and not fresh and now - hit[0] < _WDTT_HOST_TTL:
        return hit[1]
    res = ({}, False)
    _cfgr = _root + cfgdir
    pj = os.path.join(_cfgr, "passwords.json")
    if os.path.isfile(pj):                      # bare metal, or a store mounted into THIS container
        with contextlib.suppress(Exception):
            with open(pj) as f:
                res = (_csqtt_users_from_text(f.read()), True)
    elif NODE_KIND == "docker":
        # The trailing `; :` holds the exit status at 0 whatever happens: this is a QUESTION, not an assertion, and
        # "no such dir" exiting 1 every 45s would bury the real log lines (the same lesson as _wdtt_cfg_probe).
        # An 'F:' prefix reports that the file EXISTS separately from its contents, so an oversized store still
        # answers store_found=True rather than looking like an absent one.
        with contextlib.suppress(Exception):
            # The pid is a HOST pid here, so the host shell applies the same namespace test itself.
            _pfxsh = ("R=''; P=%s; [ -n \"$P\" ] && [ -e /proc/$P/ns/mnt ] && "
                      "[ \"$(readlink /proc/$P/ns/mnt)\" != \"$(readlink /proc/1/ns/mnt)\" ] && R=/proc/$P/root; "
                      % shlex.quote(str(int(pid)) if pid else ""))
            _cmd = _pfxsh + ("cd \"$R\"%s 2>/dev/null && { [ -f passwords.json ] || exit 0; printf 'F:'; "
                    "[ $(stat -c %%s passwords.json) -le %d ] && base64 -w0 < passwords.json; }; :"
                    % (shlex.quote(cfgdir), _CSQTT_STORE_MAX))
            raw = (host_sh(_cmd, timeout=40).stdout or "").strip()
            if raw.startswith("F:"):
                b64 = raw[2:].strip()
                res = ((_csqtt_users_from_text(base64.b64decode(b64).decode("utf-8", "replace")) if b64 else {}), True)
    _CSQTT_STOREPROBE[_ck] = (now, res)
    return res


def _csqtt_adopted_users(cfgdir, fresh=False, pid=None):
    """The users a FOREIGN csqtt server is serving — everything the panel needs to recreate each one as a roster
    peer, and nothing else. See _csqtt_store_probe for how the store is reached on a docker node."""
    return _csqtt_store_probe(cfgdir, fresh, pid)[0]


def _csqtt_procs():
    """Every csqtt server process on this box → [(pid, argv-flags)]. csqtt names its binary `server` like the
    WDTT forks, so the discriminator is the same one _wdtt_is_server uses in reverse: -tun-addr (a WDTT server
    uses -wg-addr and never -tun-addr) or a csqtt path in argv[0].

    On docker this walks the HOST's pid namespace as well: the container has no pid:host, so a foreign csqtt
    running on the host — the whole point of the adoption scan — is invisible to a local walk. Reuses the WDTT
    host walk, which is already cached per TTL (one privileged one-shot container, not one per candidate)."""
    out = []
    if NODE_KIND == "docker":
        for pid, parts in _wdtt_host_procs():
            fl = _wdtt_flags_from_argv(parts) if isinstance(parts, list) else (parts or {})
            if (fl.get("tun-addr") or "").strip() or "csqtt" in (fl.get("_exe") or "").lower():
                out.append((pid, fl))
        return out
    with contextlib.suppress(Exception):
        for ent in os.listdir("/proc"):
            if not ent.isdigit():
                continue
            with contextlib.suppress(Exception):
                with open("/proc/%s/cmdline" % ent, "rb") as f:
                    parts = [x.decode(errors="replace") for x in f.read().split(b"\x00") if x]
                if not parts:
                    continue
                fl = _wdtt_flags_from_argv(parts)
                if (fl.get("tun-addr") or "").strip() or "csqtt" in (fl.get("_exe") or "").lower():
                    out.append((int(ent), fl))
    return out


def csqtt_candidates():
    """FOREIGN csqtt servers on this box — ones this node does not manage — as adoption candidates.

    csqtt has NO server keypair (its whole credential is the panel-owned password), so unlike WDTT there is no
    identity to locate and nothing that can be irrecoverably lost by adopting; what must survive is the password
    store, which is why every candidate carries its users. Reported non-secret: the panel stays blind to the
    passwords themselves until the node hands them up during the take-over."""
    mine = set(_csqtt_load().keys())
    out = []
    for pid, f in _csqtt_procs():
        # No -iface/-tun-addr means an UPSTREAM build, which hardcodes both — fall back to what it hardcodes
        # rather than skipping it. config-dir is NOT guessed: upstream does take that flag, and a wrong guess
        # would adopt an empty store, i.e. silently drop every user the take-over is meant to preserve.
        iface = (f.get("iface") or "").strip() or CSQTT_DEFAULT_IFACE
        cfg = (f.get("config-dir") or "").strip()
        if iface in mine or not cfg:
            continue
        # our own supervised instances live under CSQTT_ROOT — anything there is managed, not foreign
        if cfg.startswith(CSQTT_ROOT + "/"):
            continue
        users, store_found = _csqtt_store_probe(cfg, pid=pid)
        out.append({"iface": iface, "pid": pid, "config_dir": cfg,
                    # Which container owns it, "" when it runs on the node — this is what decides ALIEN vs
                    # ORPHAN in the panel (see _proc_container).
                    "container": _proc_container(pid),
                    # Could we read its store at all? The panel refuses a silent take-over when we could not:
                    # "no users found" and "we could not look" must not reach the operator as the same sentence.
                    "store_found": store_found,
                    "listen": (f.get("listen") or "").strip(),
                    "tun_addr": (f.get("tun-addr") or "").strip() or CSQTT_DEFAULT_TUNADDR,
                    "max_passwords": (f.get("max-passwords") or "").strip(),
                    "users": [{"comment": v["comment"], "vk_hash": v["vk_hash"], "expires_at": v["expires_at"],
                               "is_deactivated": v["is_deactivated"]} for v in users.values()],
                    "adoptable": True})     # no identity file to find: the store is the whole of it
    return out


def _csqtt_scan_ok():
    """Did the scan behind the last _csqtt_procs() actually COMPLETE?

    Everything that stops or deletes keys off "is a foreign server live on this name", and answers no when the
    scan returns nothing. On a docker node that scan is a privileged one-shot container over the host's /proc,
    and it can time out — so "nothing found" silently became "nothing is there", and the destructive branch ran
    on the strength of an answer we never got. A detection failure must fail SAFE, so callers ask this first.
    Bare metal walks /proc directly and has no such failure mode."""
    return True if NODE_KIND != "docker" else bool(_WDTT_HOSTPROC.get("ok", True))


def _csqtt_container_of(pid):
    """The docker container id this pid runs in, '' when it isn't in one.

    The docker analogue of _wdtt_unit_of_pid, needed for the same reason that one exists: killing a SUPERVISED
    process just hands it back to its supervisor. That function only recognises systemd (a cgroup segment ending
    .service), so a foreign server running as its own container — which is how amurcanov's csqtt recipe installs
    it, and how the one that prompted all this ran — reads back as unsupervised. TERM/KILL against
    `restart: unless-stopped` brings it straight back, ours can never bind the port, and the reconcile retries
    every 5s forever. Matches both cgroup drivers: `docker-<id>.scope` (systemd) and `/docker/<id>` (cgroupfs).
    On a bare-metal node the local /proc IS the host's, so no hop is needed to answer the same question."""
    txt = ""
    if NODE_KIND == "docker":
        txt = (host_sh("cat /proc/%d/cgroup 2>/dev/null; :" % int(pid), timeout=20).stdout or "")
    else:
        with contextlib.suppress(Exception):
            with open("/proc/%d/cgroup" % int(pid)) as f:
                txt = f.read()
    m = re.search(r"docker[-/]([0-9a-f]{12,64})", txt)
    return m.group(1) if m else ""


def _csqtt_stop_foreign(iface, cfgdir):
    """Stop the foreign csqtt serving `iface` so ours can bind its port and TUN. Disables the unit that starts it
    first — otherwise systemd restarts it the moment it dies and it takes the port back from under us — then TERM,
    wait, KILL. Returns True when nothing of it is left running.

    Re-reads the process table immediately before signalling: a pid resolved a scan ago may since have been
    reused, and the difference between stopping the foreign server and killing an unrelated process is exactly
    that staleness. On a docker node that promise needs _wdtt_hostproc_flush to be true at all — the walk it reads
    is cached for 45s."""
    _host = (NODE_KIND == "docker")               # the pid lives in the HOST namespace; os.kill here can't see it

    def _foreign():
        """(pid, flags) of the foreign server on this iface RIGHT NOW, or None — never off a cached walk."""
        _wdtt_hostproc_flush()
        return next(((p, f) for p, f in _csqtt_procs()
                     if (f.get("iface") or "").strip() == iface
                     and not (f.get("config-dir") or "").startswith(CSQTT_ROOT + "/")), None)

    def _drop_tun():
        with contextlib.suppress(Exception):      # the raw TUN can outlive the process
            run(["ip", "link", "delete", "dev", iface])
        if _host:
            host_sh("ip link delete dev %s 2>/dev/null; :" % shlex.quote(iface))

    hit = _foreign()
    if not hit:
        # "Nothing found" is only "already gone" when the scan ran. Otherwise say so: the caller treats False as
        # "couldn't stop it — adopt again once it is down", which is the honest answer and retries next pass.
        return _csqtt_scan_ok()
    pid, _f = hit
    unit = _wdtt_unit_of_pid(pid, _host)
    if unit and not unit.startswith(("swg-csqtt-", "swg-wdtt-")):     # never our own supervisor
        host_sh(sc_disable_now(unit) + " >/dev/null 2>&1; :")
    cid = _csqtt_container_of(pid)
    if cid:
        # `docker stop`, never `rm`: this is someone else's container and their data. stop also settles the
        # restart policy, so `unless-stopped` doesn't bring it back — the same semantics as the disable above.
        # Expect it to take the full StopTimeout then SIGKILL: an unpatched csqtt registers a SIGTERM handler
        # and never consumes it (see forks/csqtt/README.md), so SIGTERM is neither handled nor fatal.
        host_sh("docker stop " + shlex.quote(cid) + " >/dev/null 2>&1; :", timeout=60)
        if not _foreign() and _csqtt_scan_ok():
            # Gone, and we know it. Do NOT fall through to the signals: that pid is free now and may already
            # belong to something else — the very staleness this function re-reads the table to avoid.
            _drop_tun()
            return True
    if _host:
        # TERM, wait up to ~4.5s, then KILL — the same escalation as the local branch, run host-side in one hop.
        host_sh("kill -TERM %d 2>/dev/null; i=0; while [ $i -lt 30 ] && kill -0 %d 2>/dev/null; do sleep 0.15; "
                "i=$((i+1)); done; kill -0 %d 2>/dev/null && kill -KILL %d 2>/dev/null; :" % (pid, pid, pid, pid))
    else:
        with contextlib.suppress(Exception):
            os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                try:
                    os.kill(pid, 0); time.sleep(0.15)
                except Exception:
                    break
            else:
                os.kill(pid, signal.SIGKILL)
    gone = not _foreign()
    if not (gone and _csqtt_scan_ok()):
        return False                             # never drop a TUN we cannot prove is unused
    _drop_tun()
    return True


def _csqtt_serve_adopted(inst):
    """Union the users recovered from a taken-over csqtt server into the set this instance serves, for as long as
    the hand-off to the panel is open — same rule as _wdtt_serve_adopted, so existing clients keep connecting
    through the take-over instead of being refused until the import lands."""
    au = inst.get("adopt_users") or {}
    if not au:
        return
    pwds = dict(inst.get("passwords") or {})
    for pw, m in au.items():
        if pw in pwds:
            continue
        m = m if isinstance(m, dict) else {}
        pwds[pw] = {"expires_at": int(m.get("expires_at") or 0), "vk_hash": str(m.get("vk_hash") or ""),
                    "is_deactivated": bool(m.get("is_deactivated"))}
    inst["passwords"] = pwds


def reconcile_csqtt(want, remove=None):
    """Declarative csqtt reconcile (continuous). want = {iface: inst}. Installs missing, writes desired.json +
    SIGHUPs on password change, reconfigures on transport-param change, and removes ONLY panel-listed instances.
    Mirrors reconcile_wdtt minus the adoption/vault machinery (deferred to A7)."""
    res = {"changed": 0, "errors": []}
    want = want or {}
    if isinstance(want, dict):
        _CLAIMED["csqtt"] = set(want)      # the panel has spoken: anything of ours NOT in here is unclaimed
    if not isinstance(want, dict):
        res["errors"].append("panel sent a malformed csqtt set (%s) — ignored" % type(want).__name__)
        return res
    have = _csqtt_load()
    if not want and not have:
        return res
    # A name the panel still lists for removal but ALSO asks for is a REUSED name: the operator deleted an
    # instance and made a new one with the same iface. Honouring the removal would delete what was just created,
    # and the next sync would build it again — remove/reinstall every few seconds, forever, re-minting the owner
    # password each pass. The desired set is the newer instruction, so it wins.
    for iface in [i for i in (remove or []) if isinstance(i, str) and i not in (want or {})]:
        if iface in have and (have.get(iface) or {}).get("panel_managed"):
            _csqtt_remove(iface); have.pop(iface, None); res["changed"] += 1
    for iface, req in want.items():
        try:
            if not _CSQTT_NAME_RE.match(iface):
                res["errors"].append(iface + ": bad csqtt iface name"); continue
            inst = dict(req or {}); inst["iface"] = iface
            prev = have.get(iface) or {}
            inst["panel_managed"] = True
            # owner --password + --web-pass are NODE-OWNED (the panel is blind): reuse the stored ones, else mint.
            inst["password"] = (prev.get("password") or inst.get("password") or "").strip() or _gen_csqtt_password()
            inst["web_pass"] = (prev.get("web_pass") or _gen_csqtt_password() + _gen_csqtt_password())
            inst["web_port"] = prev.get("web_port") or _csqtt_webport(inst.get("listen") or "")
            # pw_seen safety net: an EMPTY desired set must not reap users the panel has never owned (a create
            # landing on an earlier install's dir, a lost node record). Until the panel has held a password here,
            # skip writing an empty desired (which our --desired reconcile would use to delete every password).
            _pw_seen = bool(prev.get("pw_seen") or (inst.get("passwords") or {}))
            if _pw_seen:
                inst["pw_seen"] = True
            # ⚠️ …AND HAND THEM UP, which is the half csqtt never had (T-18). WDTT does this for ANY instance
            # the panel has never held a password for; csqtt only ever did it inside `adopt_foreign` below. So a
            # csqtt the panel starts managing without a take-over — a record restored from an older nodes.json,
            # or T-18's mirror of an instance this node already runs — kept its users (pw_seen protects them)
            # and never told the panel they existed: invisible in the roster for ever, un-migratable, and the
            # first panel-created user flips pw_seen and reaps every original one. Same rule as the twin: a wipe
            # needs positive intent, and a user the panel cannot see is a user it cannot intend to keep.
            if not _pw_seen and not inst.get("adopt_users"):
                _pre = _csqtt_adopted_users(_csqtt_dir(iface))
                if _pre:
                    inst["adopt_users"] = _pre
                    inst["adopt_users_at"] = int(time.time())
                    _au = _pre
            # ADOPT a foreign csqtt: take its users, stop it, and run ours in its place. There is no server key
            # to preserve (csqtt has none) — the password store IS the server's identity to a client, so copying
            # it and serving it through the hand-off is the whole of a take-over.
            # The hand-off closes ITSELF: once the panel's desired set already holds every recovered password the
            # import has landed, and a 15-minute ceiling covers an import that never does. Same rule as WDTT, so
            # nothing keeps re-offering peers the operator has since deleted.
            _au = prev.get("adopt_users") or {}
            if _au:
                _have = set((inst.get("passwords") or {}).keys())
                if (_have and not (set(_au) - _have)) or int(time.time()) - int(prev.get("adopt_users_at") or 0) > 900:
                    _au = {}
            if _au:
                inst["adopt_users"] = _au
                inst["adopt_users_at"] = prev.get("adopt_users_at") or int(time.time())
            if inst.get("adopt_foreign") and not _csqtt_present(iface):
                _src = (inst.get("adopt_config_dir") or "").strip()
                if not _src:
                    _src = next((c["config_dir"] for c in csqtt_candidates() if c["iface"] == iface), "")
                # This is THE destructive read: whatever store it returns becomes the users we recreate, and the
                # foreign server is stopped straight after. Resolve the serving process so a containerised csqtt is
                # read inside its own namespace — on the host path we would hand over another install's users and
                # lose every one of this server's. Falls back to the plain path when no process matches.
                _spid = next((pid for pid, f in _csqtt_procs()
                              if ((f.get("iface") or "").strip() or CSQTT_DEFAULT_IFACE) == iface), None)
                _pre = _csqtt_adopted_users(_src, fresh=True, pid=_spid) if _src else {}
                if _pre:
                    inst["adopt_users"] = _pre
                    inst["adopt_users_at"] = int(time.time())
                    _au = _pre
                _stopped = _csqtt_stop_foreign(iface, _src)
                if not _stopped:
                    res["errors"].append(iface + ": couldn't stop the existing csqtt server — adopt again once it is down")
                    have[iface] = inst; continue
            if _au:
                _csqtt_serve_adopted(inst)
            if not _csqtt_present(iface):
                err = _csqtt_install(inst)
                if err:
                    res["errors"].append(iface + ": " + err); have[iface] = inst; continue
                res["changed"] += 1
            else:
                # NOTE the `have[iface] = inst` before each continue. Without it an error here DROPPED the
                # instance from the node record — and _csqtt_save then persisted the loss, taking the
                # node-owned owner password and the pw_seen flag with it. A transient failure (a server that
                # cannot start yet) must never cost us the record of what we are managing; that is the same
                # rule pw_seen exists to enforce one level down, at the password.
                # Heal a unit that no longer matches what this build writes. The unit is otherwise only written on
                # install or a PARAMETER change, so a fix to the unit itself (the @io-uring→@aio syscall group, say)
                # would never reach an instance that already exists — the operator would update the node and stay
                # broken. Compare the rendered text and rewrite only on a real difference: this restarts the server,
                # so it must not fire on every sync.
                if _csqtt_unit_drifted(iface, inst) or _csqtt_params_changed(prev, inst):
                    err = _csqtt_reconfigure(inst)
                    if err:
                        res["errors"].append(iface + ": " + err); have[iface] = inst; continue
                    res["changed"] += 1
                if _pw_seen and _csqtt_desired_changed(iface, inst.get("passwords")):
                    err = _csqtt_reconcile_desired(iface, inst.get("passwords"))
                    if err:
                        res["errors"].append(iface + ": " + err); have[iface] = inst; continue
                    res["changed"] += 1
            if bool(inst.get("stopped")) != bool(prev.get("stopped")):
                if NODE_KIND == "docker":
                    _csqtt_docker_stop(iface) if inst.get("stopped") else _csqtt_docker_start(inst)
                else:
                    host_sh("systemctl " + ("disable --now " if inst.get("stopped") else "enable --now ")
                            + shlex.quote(_csqtt_svc(iface)) + " >/dev/null 2>&1")
                res["changed"] += 1
            if inst.get("restart") and inst.get("restart") != prev.get("restart") and not inst.get("stopped"):
                if NODE_KIND == "docker":
                    _csqtt_docker_start(inst)
                else:
                    host_sh("systemctl restart " + shlex.quote(_csqtt_svc(iface)) + " >/dev/null 2>&1")
                res["changed"] += 1
            # bare-metal: start a present instance the panel wants running that is not (see the same block in
            # reconcile_wdtt — Restart=on-failure does not come back from a clean stop, and `present` was all
            # reconcile looked at).
            if (NODE_KIND != "docker" and _csqtt_present(iface) and not bool(inst.get("stopped"))
                    and (host_sh("systemctl is-active " + shlex.quote(_csqtt_svc(iface)) + " 2>/dev/null").stdout or "").strip()
                        not in ("active", "activating", "reloading")):
                host_sh(sc_enable_now(_csqtt_svc(iface)) + " >/dev/null 2>&1")
                res["changed"] += 1
            # docker has no Restart=on-failure: a server that died since the last pass is relaunched here, which
            # is what makes the supervised model as durable as the systemd one.
            if (NODE_KIND == "docker" and not inst.get("stopped") and _csqtt_present(iface)
                    and not _csqtt_docker_pid(iface)):
                err = _csqtt_docker_start(inst)
                if err:
                    res["errors"].append(iface + ": " + err)
                else:
                    res["changed"] += 1
            have[iface] = inst
        except Exception as e:
            res["errors"].append(iface + ": " + str(e))
    if not _csqtt_save(have):
        res["errors"].append("couldn't write the csqtt record (" + CSQTT_RECORD + ")")
    return res

def csqtt_snapshot():
    """Read each csqtt instance's runtime state back for the panel: service active + per-password device binding
    + traffic (from the csqtt store passwords.json — WDTT-shaped). Raw datapath has NO wg handshake, so `online`
    is a byte-delta heuristic (bytes moved since the last snapshot). Never returns any private key."""
    out = []
    insts = _csqtt_load()
    if not insts:
        return out
    _nowt = int(time.time())
    for iface, inst in insts.items():
        svc = _csqtt_svc(iface)
        # docker: the supervised child IS the service. Asking systemd here used to answer from the HOST, which on a
        # converted master still had the old units running — so the panel was told "active" for servers this node
        # was not running, beside an empty password store it could not read. Two wrong answers that agreed.
        active = ("active" if _csqtt_docker_pid(iface) else "inactive") if NODE_KIND == "docker" else \
                 (host_sh("systemctl is-active " + shlex.quote(svc) + " 2>/dev/null").stdout or "").strip()
        pj = {}
        with contextlib.suppress(Exception):
            with open(_csqtt_dir(iface) + "/passwords.json") as f:
                pj = json.load(f) or {}
        pwds, devs = {}, {}
        for did, d in (pj.get("devices") or {}).items():
            d = d or {}
            devs[did] = {"ip": d.get("ip", ""), "pub_key": d.get("pub_key", "")}   # NO priv_key
        last = _CSQTT_LASTBYTES.setdefault(iface, {})
        for pw, e in (pj.get("passwords") or {}).items():
            e = e or {}
            up, dn = int(e.get("up_bytes") or 0), int(e.get("down_bytes") or 0)
            _dev = devs.get(e.get("device_id") or "") or {}
            # byte-delta liveness + per-peer speed: raw TUN has no wg handshake, so recent traffic (speed > 0) IS the
            # online signal — and the SAME delta is the per-peer speed the Overview top-talkers use (no per-peer wire
            # counter exists for a keyless server). `last` now holds (up, down, t) per password.
            _rs, _ts = _pw_speed(last, pw, up, dn, _nowt)
            online = (_rs + _ts) > 0
            pwds[pw] = {"device_id": e.get("device_id", ""), "up_bytes": up, "down_bytes": dn,
                        "is_deactivated": bool(e.get("is_deactivated")), "expires_at": e.get("expires_at", 0),
                        "ip": _dev.get("ip", ""), "online": online, "rx_speed": _rs, "tx_speed": _ts}
        _rxb, _txb, _rxs, _txs = _wdtt_iface_traffic(iface)   # TUN aggregate throughput (same reader as a wg iface)
        out.append({"iface": iface, "service": svc, "active": active, "listen": inst.get("listen", ""),
                    "tun_addr": inst.get("tun_addr", ""), "web_port": inst.get("web_port", ""),
                    "stopped": bool(inst.get("stopped")), "kind": "csqtt",
                    # WHICH fork this instance is. The WDTT snapshot has always carried it and csqtt's did not, so
                    # the panel's fork list had nothing to match a running csqtt against and showed the fork as
                    # "not yet used" while the node was running two of them. Absent on an old record = the single
                    # csqtt fork known here, the same assumption _csqtt_fork_unknown already makes.
                    "fork": (inst.get("fork") or "").strip() or next(iter(CSQTT_FORK_OWNER)),
                    "version": (inst.get("ver") or "").strip(),   # A3 wires CSQTT_BUILDS + a version board; record-tracked for now
                    # T-18, the csqtt twin: the two params _csqtt_params_changed compares that nothing else
                    # reported. See the WDTT report for why a mirror without them restarts a live server.
                    "max_passwords": inst.get("max_passwords") or "",
                    "params": inst.get("params") or "",
                    "rx_bytes": _rxb, "tx_bytes": _txb, "rx_speed": _rxs, "tx_speed": _txs,
                    # Users recovered from a taken-over server, offered UP so the panel can recreate each as a
                    # roster peer. Present only while the hand-off is open; the panel clears it by importing.
                    "adopt_users": inst.get("adopt_users") or {},
                    "passwords": pwds, "devices": devs})
    return out


# node self-update is NODE-ONLY: on a master box (panel + node together) it must NOT restart the
# co-located panel, or the panel restart breaks the very sync that would clear the update request.
DEFAULT_UPDATE_CMD = ("curl -fsSL https://raw.githubusercontent.com/SanityProtocol/swg-panel/main/"
                      "bootstrap.sh | bash -s update -y --no-components --node-only")


def run_self_update(node_cfg, want):
    """Run the swg-only in-place updater, detached so it survives swg-noded's own restart. Only ever
    called on a valid sync reply that carries an 'update'. Updates swg-noded/swg-agent (and a co-located
    panel) — NOT wg/awg/turn-proxies. The panel clears the request once we report the new version."""
    cmd = (node_cfg.get("node") or {}).get("update_cmd") or DEFAULT_UPDATE_CMD
    base = cmd if isinstance(cmd, list) else ["bash", "-lc", (cmd if os.geteuid() == 0 else "sudo -n " + cmd)]
    try:
        # run OUTSIDE swg-noded's own cgroup, so the updater's 'systemctl restart swg-noded' doesn't
        # kill the updater itself. systemd-run --scope gives it a fresh transient scope.
        if os.path.exists("/run/systemd/system") and shutil.which("systemd-run"):
            argv = ["systemd-run", "--scope", "--collect", "--quiet", "--unit", "swg-self-update"] + base
        else:
            argv = base
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print(f"self-update started → {want.get('to')}", flush=True)
        return True
    except Exception as e:
        print("self-update failed to start:", e, flush=True)
        return False


UPDATE_RESULT_FILE = os.path.join(STATE_DIR, ".update-result")


def update_auto():
    """Can the panel's Update button actually do anything on this node?

    ⚠️ MIRRORS THE BRANCH ORDER IN THE SYNC LOOP, and must keep mirroring it: a trigger wins outright;
    without one a declarative host and a container both refuse — a container cannot recreate its own
    image, and a declarative host's installation belongs to the configuration that built it. Reported
    as a capability (like `turn_manage`) so the panel can refuse UP FRONT instead of staging a request
    whose only possible outcome is a red tag on this node.

    Unconditional in the snapshot, so it is a fact about every node and not a Nix-shaped exception."""
    return bool(os.environ.get("SWG_UPDATE_TRIGGER")) or (not NODE_DECLARATIVE and NODE_KIND != "docker")


def report_update_result(panel):
    """Relay the outcome of an update this daemon could not watch.

    On a declaratively-managed host the panel/node does not run the updater — it touches a trigger and a root
    unit rebuilds the system. That rebuild can fail for reasons that have nothing to do with us (a broken
    unrelated flake input, an out-of-tree kernel module against a new kernel), and it fails AFTER this process
    has been restarted or replaced, so nothing here ever sees it. The unit writes its verdict to
    `.update-result` — one line of state, then the command's output tail — and we forward it on the next sync
    and delete it. That is the difference between "the button is broken" and "your kernel pin needs bumping".

    Read-and-delete BEFORE the POST would lose the message if the panel is unreachable; delete after, and a
    panel that never comes back leaves one small file behind. The second is the cheaper failure."""
    try:
        with open(UPDATE_RESULT_FILE) as f:
            state = (f.readline() or "").strip()
            err = f.read().strip()
    except OSError:
        return
    if state:
        report_proc(panel, state, err or None)
    with contextlib.suppress(OSError):
        os.unlink(UPDATE_RESULT_FILE)


def report_proc(panel, state, err=None):
    """Best-effort POST of a lifecycle proc-status (e.g. 'update-failed' + reason) to the panel, so a failure
    that never reaches the normal script-side lifecycle reporting still surfaces as a red tag on the node."""
    try:
        u = panel["url"].rstrip("/") + "/api/node/proc-status"
        post_json(u, panel["token"], {"state": state, "err": (err or "")[:2000]}, panel)
        print(f"proc-status → {state}", flush=True)
    except Exception as e:
        print("proc-status report failed:", e, flush=True)


# ───────────────────────── main loop ─────────────────────────

# Routing convergence (egress SNAT + P2/P3 cascade) checks for drift by shelling out to `ip rule`,
# `iptables -S` and `nft list` (a big smart-routing table) — cheap individually but done EVERY sync it
# dominates a co-located master's CPU. Desired routing changes rarely, so we only run it on a change or
# every this-many seconds as a drift/reboot safety re-converge. Snapshot+POST (the 5s "alive" push) is
# never gated — the panel keeps seeing the node live every interval.
ROUTING_RECONCILE_EVERY_S = 60

# Silent-drift heal: the routing rebuilds above are signature-gated against DESIRED, so drift they don't inspect
# (an nft chain flushed by another tool, a rule lost across a partial apply, a marker that says "converged" while
# reality moved) would never repair on its own. Every VERIFY_EVERY_S we drop the rebuild sig-markers so the next
# routing pass re-asserts every chain/table from scratch against live state — the ordinary rebuild path, just
# forced. Cheap (rebuilds rules/chains, not set contents), so a large fleet pays it only twice an hour.
VERIFY_EVERY_S = 1800
def _force_reverify():
    """Drop the rebuild sig-markers so the next routing reconcile re-asserts the smart / count / DoH chains."""
    for fn in (".smart-sig", ".catcount-sig", ".doh.sig"):
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(GEO_DIR, fn))

_STATE_LOCK_FD = None          # held for the process lifetime → single-instance-per-state-dir guard
def _proc_cmdline(pid):
    """argv of a pid as a list of str, or [] if it is gone / unreadable."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def _flock_holder(path):
    """Who holds the flock on `path`, asked of the KERNEL (/proc/locks) rather than claimed.
    (pid,"held") / (None,"held") for an unattributed lock / (None,"free") / (None,"unknown").

    The panel carries the same helper for the same reason and with the same two decisions: a `-> `
    line is a process BLOCKED on the lock, not its holder, and the match is on INODE alone because
    /proc/locks prints a hex device that a btrfs/zfs/overlay st_dev never equals — so a device check
    would MISS real holders on the filesystems people actually run."""
    try:
        ino = os.stat(path).st_ino
    except OSError:
        return None, "unknown"
    try:
        with open("/proc/locks") as f:
            lines = f.read().splitlines()
    except OSError:
        return None, "unknown"
    for ln in lines:
        parts = ln.split()
        if len(parts) > 1 and parts[1] == "->":
            continue
        if len(parts) < 6 or parts[1] != "FLOCK":
            continue
        try:
            pid = int(parts[4])
            if int(parts[5].rsplit(":", 1)[-1]) != ino:
                continue
        except ValueError:
            continue
        return (pid if pid > 0 else None), "held"
    return None, "free"


def _lock_state_dir():
    """Refuse to start a SECOND swg-noded on the same state dir. Two nodeds sharing /var/lib/swg-noded fight over
    the reconcile/interface state (and, on a master, can clobber the panel's view) — the same class of bug as two
    panels sharing one state dir. A node with a DIFFERENT state dir (SWG_NODED_STATE) uses its own lock → unaffected."""
    global _STATE_LOCK_FD
    with contextlib.suppress(OSError):
        os.makedirs(STATE_DIR, exist_ok=True)
    lp = os.path.join(STATE_DIR, ".noded.lock")
    # The open and the flock fail for unrelated reasons and used to share one message, which asserted
    # "another swg-noded already holds" with no evidence for either. A state dir this process cannot
    # write is the likelier of the two on a moved or read-only install, and it is not a second node.
    try:
        fd = os.open(lp, os.O_WRONLY | os.O_CREAT, 0o600)
    except OSError as e:
        sys.exit(f"refusing to start: can't open {lp} ({e.strerror}) — the state dir {STATE_DIR} is not writable "
                 f"by this process (uid {os.getuid()}). If this node's state was moved onto this machine it still "
                 f"carries the old owner (chown it back to root); if the path is read-only, point SWG_NODED_STATE "
                 f"somewhere writable — this dir must persist.")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        pid, state = _flock_holder(lp)
        argv = _proc_cmdline(pid) if pid else []
        base = os.path.basename(argv[0]) if argv else ""
        if base.startswith("python") and len(argv) > 1:
            base = os.path.basename(argv[1])
        if base == "swg-noded":
            who = f"another swg-noded (pid {pid})"
        elif argv:
            who = f"pid {pid} (`{' '.join(argv)[:80]}`)"
        elif pid:
            who = f"pid {pid} (gone from /proc — another namespace, or it just exited)"
        elif state == "unknown":
            who = "another process (/proc/locks could not be read, so it cannot be named)"
        else:
            who = "another process the kernel does not name"
        sys.exit(f"refusing to start: {who} already holds {lp} (state dir {STATE_DIR}). Two nodeds on one state dir "
                 f"fight over the reconcile and interface state. Stop that process first, or point this one at a "
                 f"separate SWG_NODED_STATE dir.")
    os.ftruncate(fd, 0); os.write(fd, (str(os.getpid()) + "\n").encode())
    _STATE_LOCK_FD = fd


def main():
    _lock_state_dir()
    node_cfg = json.load(open(CONFIG_PATH))
    panel = node_cfg.get("panel") or {}
    nd = node_cfg.get("node") or {}
    if not panel.get("url") or not panel.get("token"):
        sys.exit("config needs a 'panel' block with url + token")
    globals()["_TURN_PANEL"] = panel   # so the turn-binary MIRROR pull (apply_turn + docker bg reconcile) can reach the panel
    url = panel["url"].rstrip("/") + "/api/node/sync"
    # ⚠️ NOT captured. `token = panel["token"]` here was invisible for as long as a re-point only ever meant
    # a new ADDRESS for the same panel — the credential never changed, so a stale copy of it was still
    # correct. A TRANSFER changes both, and the loop followed the url while posting the old panel's token:
    # measured on the live fleet, where svo-im promoted cleanly ("transferred to … CA-verified") and then
    # 401'd against its new panel every 5 seconds. Read it from `panel` at the point of use, so the same
    # mistake cannot be made again by whoever adds the next re-point.
    interval = nd.get("interval", 5)
    online_max = nd.get("online_max", 180)
    agent = nd.get("agent", "/opt/swg-agent/swg-agent")
    sudo = bool(nd.get("sudo"))
    with contextlib.suppress(Exception):
        read_cpu_pct()               # prime the CPU baseline so the first sync reports utilization, not nothing
    os.makedirs(STATE_DIR, exist_ok=True)
    last_samples = {}
    last_route_sig = None; last_route_t = 0.0    # gate the heavy routing reconcile (see ROUTING_RECONCILE_EVERY_S)
    last_verify_t = time.time()                  # periodic full re-verify (silent-drift heal, see VERIFY_EVERY_S)
    PANEL_IP_FILE = os.path.join(STATE_DIR, "panel-ip")   # node IP role: source IP to dial the panel (persisted)
    panel_ip = ""; bad_pip = ""                     # bad_pip = a panel_ip that failed to connect → don't keep re-binding it
    with contextlib.suppress(OSError):
        panel_ip = open(PANEL_IP_FILE).read().strip()
    with contextlib.suppress(OSError):              # resume a mid-swap candidate after a restart (external nodes have no loopback _heal)
        _SWAP["cand"] = open(os.path.join(STATE_DIR, "panel-url-cand")).read().strip()
    _load_transfer()                                # …and a mid-flight TRANSFER candidate, same reason
    update_started = False                          # spawn the self-updater at most once per process
    print(f"swg-noded: panel={panel['url']} interval={interval}s "
          f"ifaces={list((node_cfg.get('interfaces') or {}).keys())}", flush=True)
    # BEFORE the first sync: if a previous run-model left its servers running here, stop them by the names
    # it recorded. No-op on an ordinary restart (same model), which is every start but the one after a switch.
    with contextlib.suppress(Exception):
        handover_from_previous_runmodel()
    with contextlib.suppress(Exception):
        backfill_cmd_markers(node_cfg)     # existing confs get the marker too — see backfill_cmd_markers
    if TURN_DOCKER:   # download + start turn-proxy containers in the BACKGROUND so the node appears on the
        threading.Thread(target=_dturn_bg_loop, daemon=True).start()   # panel immediately (cards show installing → up)
    while True:
        t0 = time.time()
        _LOOP["n"] += 1                             # new loop → per-loop caches (nft table render) refresh
        if t0 - last_verify_t >= VERIFY_EVERY_S:    # periodic drift heal: force the next routing pass to re-assert
            _force_reverify(); last_route_sig = None   # (drop sig-markers + un-gate the routing reconcile this cycle)
            last_verify_t = t0
            print("reverify: re-asserting routing chains against live state", flush=True)
        try:
            report_update_result(panel)             # a declarative rebuild finished while we were restarting — say how it went
            snap = build_snapshot(node_cfg, online_max, last_samples)
            use_ip = panel_ip if (panel_ip and panel_ip != bad_pip) else ""
            status, reply = post_json(url, panel["token"], {"snapshot": snap}, panel, source_ip=use_ip)
            if status == 0 and use_ip:              # fail-safe: a bound source couldn't reach the panel → retry unbound + stop binding that IP
                bad_pip = use_ip
                status, reply = post_json(url, panel["token"], {"snapshot": snap}, panel)
            if status == 200:                       # adopt the panel-chosen connection IP (persist; reset bad-flag if it changed)
                want_pip = ((reply.get("node_egress") or {}).get("panel_ip") or "").strip()
                if want_pip != panel_ip:
                    panel_ip = want_pip
                    if want_pip != bad_pip:
                        bad_pip = ""
                    with contextlib.suppress(OSError):
                        if want_pip:
                            with open(PANEL_IP_FILE + ".tmp", "w") as _f:
                                _f.write(want_pip)
                            os.replace(PANEL_IP_FILE + ".tmp", PANEL_IP_FILE)
                        else:
                            os.unlink(PANEL_IP_FILE)
            if status == 200 and snap.get("container_adopt"):
                # The panel has it now (it imports the peers and clears the request on this same call), so drop
                # it. Left in place it is re-sent for ever and consumes every later request as its own answer.
                _CTR_ADOPT.clear()
            if status == 200 and isinstance(reply.get("desired"), dict):
                _newurl = apply_panel_hints(panel, node_cfg, reply)   # pin-gated auto-repoint on a panel host/port change
                # T-10: and a TRANSFER to a different panel entirely, promoted only once that panel answers
                # `whoami` with the token it sent. Tried AFTER the hints, on the same valid sync that
                # learned it, so a candidate is acted on within one interval rather than one interval late.
                _newurl = _promote_transfer(panel, node_cfg) or _newurl
                if _newurl:
                    url = _newurl                                     # dial the new address from the next sync on
                ivk_process(reply.get("iface_vault_pub"), reply.get("iface_vault_want"))   # seal interface keys the panel wants for the operator vault (blob rides the next snapshot)
                wdtt_vault_process(reply.get("iface_vault_pub"), reply.get("wdtt_vault_want"))   # seal WDTT server identities (owner pw + wg-keys.dat) to the same vault
                _upd0 = reply.get("update")
                if _upd0 and not update_started:   # already fired THIS exact request (a recreate restarted us)? then DON'T re-fire — else the update loops forever (recreate → restart → re-trigger → recreate …)
                    _at = str((_upd0 or {}).get("at") or "")
                    _marker = os.path.join(STATE_DIR, ".update-done")   # persists across the container recreate (bind-mounted to data/node)
                    try: _prev = open(_marker).read().strip()
                    except Exception: _prev = ""
                    if _at and _at == _prev: update_started = True
                if reply.get("update") and not update_started:        # panel asked us to self-update (and we haven't fired this one yet)
                    _trig = os.environ.get("SWG_UPDATE_TRIGGER")
                    if _trig:   # docker node: a container can't recreate its own image — touch the HOST trigger
                        try:    # instead; its swg-update.path runs `compose pull && up` on the host (swg images only)
                            with open(_trig, "w") as _f: _f.write(str(int(time.time())) + "\n")
                            try: open(_marker, "w").write(_at)   # remember the request we fired so a recreate-restart won't re-fire it
                            except Exception: pass
                            update_started = True; print(f"update trigger written → {_trig}", flush=True)
                        except Exception as _e:
                            print("update trigger failed:", _e, flush=True)
                            report_proc(panel, "update-failed", f"swg-noded could not write the update trigger {_trig}: {_e}")
                            update_started = True   # reported the failure — don't retry the bad write every sync
                    elif NODE_DECLARATIVE:
                        # This node's installation is owned by its configuration. DEFAULT_UPDATE_CMD would run
                        # `bootstrap.sh update` here, and on such a host that is not a no-op — it appears to work
                        # (`/` is writable, `mkdir -p /opt/… && cp` succeeds), then fails on PATH/apt-get, leaving
                        # an unmanaged install the configuration cannot see. So refuse and say what an update IS.
                        # Checked BEFORE the docker branch on purpose: a NixOS host running our image is `kind ==
                        # "docker"` for every behavioural purpose (T-P1), and that branch's remedy — a compose
                        # pull on the box — is the wrong answer for it.
                        print("update requested but this node is managed declaratively", flush=True)
                        report_proc(panel, "update-failed",
                                    "This node is managed declaratively, so an update is a rebuild of its "
                                    "configuration — not something the panel can start. Update the swg input and "
                                    "rebuild on the box (`nixos-rebuild switch`), or enable the module's "
                                    "selfUpdate option to wire this button to that rebuild.")
                        update_started = True
                    elif NODE_KIND == "docker":
                        # docker node with NO host updater wired: a container can't recreate its own image, so
                        # run_self_update can do nothing. Report a clear failure instead of silently no-op'ing.
                        print("update requested but no host updater is wired (docker)", flush=True)
                        report_proc(panel, "update-failed",
                                    "This docker node has no one-click host updater wired. Re-install it "
                                    "(bootstrap docker node) to enable the panel's Update button, or update on the box: "
                                    "cd /opt/swg-panel-docker && docker compose --profile node pull && docker compose --profile node up -d")
                        update_started = True
                    else:
                        update_started = run_self_update(node_cfg, reply["update"])
                cr = create_ifaces(node_cfg, reply.get("create"), agent, sudo)   # create new interfaces
                # …plus any mesh link left behind by a panel this node used to sync with — see orphan_mesh_links.
                _orph = orphan_mesh_links(node_cfg, reply.get("owned_ifaces"))
                if _orph:
                    print("mesh: dropping link(s) this panel does not claim (its peer node is gone, or "
                          "this node moved panels): " + ", ".join(_orph), flush=True)
                dl = delete_ifaces(node_cfg, list(reply.get("delete") or []) + _orph, agent, sudo)   # tear down deleted ones
                apply_panel_settings(reply.get("panel"))      # Panel settings → mirrors / geo TTL / geo refetch
                _heal = selfheal_ifaces(node_cfg, reply.get("desired_ifaces"),
                                         reply.get("owned_ifaces"))   # panel owns it, it is live here, we lost the conf
                for _hn in (cr.get("heal") or []):      # a create that found the device already here (see create_ifaces)
                    _heal.setdefault(_hn, {"cmd": ["auto"], "conf": ""})
                if _heal:
                    print("self-heal: adopting live interface(s) the panel manages but we hold no conf for: "
                          + ", ".join(sorted(_heal)), flush=True)
                ob = onboard_ifaces(node_cfg, {**(reply.get("onboard") or {}), **_heal})   # add panel-requested interfaces first
                tp = apply_turn(reply.get("turn"), reply.get("turn_onboard"))   # turn-proxy manage/onboard
                wd = reconcile_wdtt(reply.get("wdtt"), reply.get("wdtt_remove"))   # install/desired.json+SIGHUP; removals ONLY from the explicit list
                # Take over a wg/awg server from another container (Amnezia). One-shot and operator-driven:
                # it stops somebody else's container, so it runs only while the panel is asking for it, and the
                # answer — taken over, or refused and nothing changed — rides back in the next snapshot.
                # ⚠️ IN A THREAD, not inline. Stopping somebody else's container is the one operation here whose
                # duration another program decides: a container that ignores SIGTERM burns the whole grace period,
                # and podman then does not return until it has cleaned the container up — measured at over a
                # minute for one `stop`. Run inline, that is a minute in which this loop posts no snapshot, and
                # the panel marks the node STALE in the middle of the operator's take-over. The result is picked
                # up on a later pass exactly as before; the request stays pending at the panel meanwhile, which
                # is what its own timeout is written for.
                _adc = reply.get("adopt_container")
                _adc_name = (_adc.get("container") or "").strip() if isinstance(_adc, dict) else ""
                if _adc_name:
                    _ctr_job_start(_adc_name, (_adc.get("iface") or "").strip(), _adc.get("at") or 0,
                                   node_cfg, agent, sudo)
                _ctr_job_collect(node_cfg)
                cq = reconcile_csqtt(reply.get("csqtt"), reply.get("csqtt_remove"))   # csqtt (raw-TUN): parallel to wdtt; removals ONLY from the explicit list
                with contextlib.suppress(Exception):
                    write_inventory(node_cfg)      # what this box carries + how it runs it (see NODE_INVENTORY)
                r = reconcile(node_cfg, reply["desired"], agent, sudo, reply.get("remove"))
                reconcile_dial_src(reply["desired"], r)        # Part 3: pin per-link outbound source IPs (folds into r)
                ri = reconcile_ifaces(node_cfg, reply.get("desired_ifaces") or {}, agent, sudo)   # set-iface: write the new listen-port to the conf FIRST
                rs = restart_ifaces(node_cfg, reply.get("restart"), agent, sudo)   # THEN bounce — a restart picks up the just-written conf (e.g. a changed port)
                sp = stop_ifaces(node_cfg, reply.get("iface_stop"), agent, sudo)    # stop (down + disable) / start (up + enable) on request
                sa = start_ifaces(node_cfg, reply.get("iface_start"), agent, sudo)
                ik = apply_iface_keys(node_cfg, reply.get("iface_key"), agent, sudo)   # keypair restore/rebaseline from the on-disk backup
                _def_egress = ((reply.get("node_egress") or {}).get("default_egress_ip") or "").strip()   # node IP role: fallback SNAT source
                # Only run the drift-checking routing reconcile when the DESIRED routing changed, an interface's
                # lifecycle changed this cycle, or the safety window elapsed — not every 5s. (See ROUTING_RECONCILE_EVERY_S.)
                _route_sig = json.dumps([reply.get("desired_ifaces"), reply.get("cascade"),
                                         reply.get("smart"), _def_egress], sort_keys=True, default=str)
                _iface_churn = bool(cr["created"] or dl["deleted"] or ob["added"] or rs["restarted"]
                                    or sp["stopped"] or sa["started"] or ri["changed"] or wd["changed"] or cq["changed"])   # a WDTT/csqtt install/remove/change must trigger the egress reconcile (its subnet MASQUERADE) this cycle, not on the safety window
                if (_route_sig != last_route_sig or _iface_churn
                        or (time.time() - last_route_t) >= ROUTING_RECONCILE_EVERY_S):
                    eg = reconcile_egress(node_cfg, reply.get("desired_ifaces") or {}, _def_egress)   # per-interface egress SNAT (+ node default)
                    cas = reconcile_cascade(node_cfg, reply.get("cascade"), reply.get("smart"), _def_egress,
                                            panel_conn=panel, panel_cfg=reply.get("panel"))   # P2 forward + P3 smart + exit SNAT (+ panel-pull provider lists)
                    with contextlib.suppress(Exception):
                        reconcile_inet_chain(node_cfg)   # keep the SWG_INET byte-counting chain in step with the iface set (measured internet lane)
                    last_route_sig = _route_sig; last_route_t = time.time()
                else:
                    eg = {"changed": 0, "errors": []}; cas = {"changed": 0, "errors": []}   # unchanged routing → skip the ip/iptables/nft drift-check shell-outs
                # surface iface command failures to the panel too (cmd_errors), keyed by iface name — INCLUDING
                # keypair restore/rebaseline (ik): a failed Restore (e.g. awg-quick up failed) is reported so the
                # panel can show "restore failed" + the reason instead of hanging on "restoring".
                # `ri` (set-iface) joins the request-driven blocks here. It was the only reconcile block
                # that could fail for ever and say so ONLY to the log — see reconcile_ifaces. Its errors are
                # keyed "set-iface <iface>: …", so they are re-keyed to the bare iface name like the rest,
                # and cleared below by the same convergence sweep.
                for blk in (cr, dl, ob, rs, sp, sa, ik, wd, cq):
                    for e in blk["errors"]:
                        k, _, m = e.partition(": ")
                        NODE_ERRORS[k] = m or e
                _ri_failed = set()
                for e in ri["errors"]:
                    _k, _, _m = e.partition(": ")
                    _k = _k.replace("set-iface ", "", 1)
                    NODE_ERRORS[_k] = _m or e; _ri_failed.add(_k)
                for _n in ob.get("notes", []):                 # kept until the panel stops asking (pruned below)
                    _k, _, _m = _n.partition(": ")
                    NODE_NOTES[_k] = _m or _n
                for k in (cr.get("created", []) + dl.get("deleted", []) + ob.get("added", [])
                          + rs.get("restarted", []) + sp.get("stopped", []) + sa.get("started", [])
                          + ik.get("done", [])):
                    NODE_ERRORS.pop(k, None)
                # prune errors for requests the panel has since cleared (iface + turn + keypair restore)
                active = (set(reply.get("create") or {}) | set(reply.get("onboard") or {})
                          | set(reply.get("delete") or []) | set(reply.get("restart") or []) | set(reply.get("turn") or {})
                          | set(reply.get("iface_stop") or []) | set(reply.get("iface_start") or [])
                          | set(reply.get("iface_key") or {})
                          | set(reply.get("turn_onboard") or []) | set(reply.get("wdtt") or {}) | set(reply.get("csqtt") or {}))
                # ⚠️ AND THE SET-IFACE FAILURES FROM THIS PASS. Without this the two lines above would pop
                # them again in the very same pass — `desired_ifaces` is not in `active` — and the fix would
                # be a silent no-op that looks correct in the diff. Folding ALL of `desired_ifaces` in would
                # be wrong the other way: it is sent for every managed interface on every sync, so it would
                # keep stale create/delete errors alive too. Only what actually failed this pass is added,
                # which is self-limiting: while the condition holds, reconcile_ifaces reports it every pass
                # (including "retrying later" while quarantined), and the moment it converges it stops.
                active |= _ri_failed
                for k in list(NODE_ERRORS):
                    if k not in active:
                        NODE_ERRORS.pop(k, None)
                for k in list(NODE_NOTES):
                    if k not in active:
                        NODE_NOTES.pop(k, None)
                for e in eg["errors"] + cas["errors"]:
                    print("egress: " + e, flush=True)
                if (r["added"] or r["removed"] or r["errors"] or ri["changed"] or ri["errors"]
                        or eg["changed"] or eg["errors"] or cas["changed"] or cas["errors"]
                        or ob["added"] or ob["errors"] or cr["created"] or cr["errors"]
                        or dl["deleted"] or dl["errors"] or tp["done"] or tp["errors"]):
                    print(f"reconcile: +{r['added']} -{r['removed']} ifaces~{ri['changed']} cascade~{cas['changed']} "
                          f"onboard+{ob['added']} create+{cr['created']} delete-{dl['deleted']} turn={tp['done']} "
                          f"errors={(r['errors'] + ri['errors'] + ob['errors'] + cr['errors'] + dl['errors'] + tp['errors'] + eg['errors'] + cas['errors'])[:3]}", flush=True)
                interval = reply.get("interval", interval)
            elif status == 0:
                print("sync error:", reply.get("error"), flush=True)
                # blessed address unreachable → settle onto a pending-swap candidate if it answers, else (loopback)
                # rediscover the panel locally. Either one re-points us so a domain/port swap never strands the node.
                _nu = _failover_candidate(panel, node_cfg) or _heal_local_panel(panel, node_cfg)
                if _nu:
                    url = _nu
            else:
                print(f"sync HTTP {status}: {reply.get('error')}", flush=True)
                _nu = _failover_candidate(panel, node_cfg) or _heal_local_panel(panel, node_cfg)
                if _nu:
                    url = _nu
        except Exception as e:
            print("loop error:", e, flush=True)
        with _TURN_JOBS_LOCK:                       # while an async reinstall/update is in flight, sync fast so the
            _busy = bool(_TURN_JOBS)                 # panel actually SEES the "updating" phase (else a sub-interval
        _iv = 1.0 if _busy else interval            # download finishes entirely between two 5s posts → pending→updated)
        time.sleep(max(0.5, _iv - (time.time() - t0)))


if __name__ == "__main__":
    main()
