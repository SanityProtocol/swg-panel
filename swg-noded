    "9.9.9.11", "149.112.112.11",
    "94.140.14.14", "94.140.15.15", "94.140.14.140", "94.140.14.141",          # AdGuard (+ family)
    "208.67.222.222", "208.67.220.220", "208.67.222.123", "208.67.220.123",    # OpenDNS / FamilyShield
    "185.228.168.9", "185.228.169.9", "185.228.168.168",                       # CleanBrowsing
    "45.90.28.0", "45.90.30.0",                                                 # NextDNS anycast
    "194.242.2.2", "194.242.2.3", "194.242.2.4",                               # Mullvad
    "76.76.2.0", "76.76.10.0",                                                  # Control D
    "193.110.81.0", "185.253.5.0",                                             # dns0.eu
    "77.88.8.8", "77.88.8.1", "77.88.8.2", "77.88.8.3", "77.88.8.7",           # Yandex DNS
    "223.5.5.5", "223.6.6.6",                                                   # AliDNS
    "1.12.12.12", "120.53.53.53",                                              # DNSPod
]))


def _doh_ips():
    """The dedicated-resolver anycast IPs to drop on :443 (see DOH_IPS rationale)."""
    return DOH_IPS


def _ensure_doh_block(subnets, enable, res):
    """(Re)build or tear down the `swg_doh` drop table. Signature-gated (subnets + DoH-IP set), so steady state
    is a no-op and a list refresh re-applies. Built atomically via `nft -f`. Never raises into the sync loop."""
    try:
        have = run(["nft", "list", "table", "inet", DOH_NFT_TABLE])
        if not (enable and subnets):                           # disabled / no smart subnets → drop our table
            if have.returncode == 0:
                run(["nft", "delete", "table", "inet", DOH_NFT_TABLE]); res["changed"] += 1
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, ".doh.sig"))
            return
        ips = _doh_ips()
        want_src = sorted(subnets)
        sig = hashlib.sha256((";".join(want_src) + "|" + ";".join(ips)).encode()).hexdigest()
        sigf = os.path.join(GEO_DIR, ".doh.sig")
        cur = ""
        with contextlib.suppress(OSError):
            cur = open(sigf).read().strip()
        if have.returncode == 0 and cur == sig:                # already converged (table present + same wants)
            return
        lines = []
        if have.returncode == 0:
            lines.append("delete table inet " + DOH_NFT_TABLE)
        lines.append("table inet " + DOH_NFT_TABLE + " {")
        lines.append("  set doh4 { type ipv4_addr; flags interval; auto-merge; elements = { " + ", ".join(ips) + " } }")
        lines.append("  chain forward { type filter hook forward priority filter; policy accept;")
        for S in want_src:
            lines.append("    ip saddr " + S + " udp dport 853 drop")    # DoQ
            lines.append("    ip saddr " + S + " tcp dport 853 drop")    # DoT
            lines.append("    ip saddr " + S + " ip daddr @doh4 udp dport 443 drop")   # DoH3 / QUIC
            lines.append("    ip saddr " + S + " ip daddr @doh4 tcp dport 443 drop")   # DoH
        lines += ["  }", "}"]
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True)
        path = os.path.join(GEO_DIR, ".doh.nft")
        with open(path, "w") as f:
            f.write("\n".join(lines) + "\n")
        rc = run(["nft", "-f", path]).returncode
        with contextlib.suppress(OSError):
            os.unlink(path)
        if rc == 0:
            with contextlib.suppress(OSError):
                open(sigf, "w").write(sig)
            res["changed"] += 1
        else:
            res["errors"].append("doh block nft load failed")
    except Exception as e:
        res["errors"].append("doh block: " + str(e)[:120])


MECH_NFT_TABLE = "swg_mech"     # per-interface FREE traffic/abuse mechanism drops (SMTP/QUIC/torrent-port-hint/port-scan)

def _mech_meter(subnet):
    return "psc_" + re.sub(r"[^0-9a-z]", "_", subnet.lower())   # valid nft id for the per-subnet port-scan rate meter
def _mech_flagged(subnet):
    return "pscf_" + re.sub(r"[^0-9a-z]", "_", subnet.lower())  # per-subnet FLAGGED-scanner set: only over-rate src IPs land here (self-expiring)
def _mech_ports(subnet):
    return "mps_" + re.sub(r"[^0-9a-z]", "_", subnet.lower())   # valid nft id for the per-subnet (proto.port) drop set

def _ensure_mech_block(mech, res):
    """Per-interface FREE traffic/abuse mechanism drops in the `swg_mech` table (forward hook, mirrors _ensure_doh_block).
    mech = {subnet: [mechanism ids]}. EVERY rule is O(1) / offload-safe. To keep the datapath cheap the deterministic
    port drops (SMTP :25, QUIC udp/443, BitTorrent PORT-HINT 6881-6889) are COLLAPSED into ONE concatenated (proto.port)
    set → one lookup, not one rule per port. Plus a per-SOURCE new-connection rate meter for port-scan / brute-force
    (a token bucket touched ONLY at connection setup, `ct state new`; established packets skip it). The bounded
    L7-SIGNATURE mechanisms (torrent handshake, WebRTC, cryptomining) are NOT built here — deferred + measurement-gated.
    Signature-gated so steady state is a no-op; atomic `nft -f`; never raises; never-wipe (nothing wanted → delete ONLY
    our table). Unknown/sig mechanisms are ignored (fail-open, never a silent CPU cost)."""
    try:
        have = run(["nft", "list", "table", "inet", MECH_NFT_TABLE])
        portsets = {}   # subnet -> sorted [(proto.port) element strings]   (smtp/quic/torrents → ONE set → ONE rule)
        meters = []     # subnets running the port-scan rate meter
        for S in sorted(mech or {}):
            cats = set(mech.get(S) or [])
            els = []
            if "smtp" in cats:     els.append("tcp . 25")
            if "quic" in cats:     els.append("udp . 443")
            if "torrents" in cats: els += ["udp . 6881-6889", "tcp . 6881-6889"]   # FREE port-hint; the sig scan is a later measured tier
            if els:                portsets[S] = sorted(els)
            if "portscan" in cats: meters.append(S)
        if not portsets and not meters:                           # nothing wanted → tear down ONLY our table (never touches others)
            if have.returncode == 0:
                run(["nft", "delete", "table", "inet", MECH_NFT_TABLE]); res["changed"] += 1
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, ".mech.sig"))
            return
        sig = hashlib.sha256(json.dumps({"p": portsets, "m": sorted(meters), "v": 2}, sort_keys=True).encode()).hexdigest()   # v2: +pscf flagged-scanner set
        sigf = os.path.join(GEO_DIR, ".mech.sig")
        cur = ""
        with contextlib.suppress(OSError):
            cur = open(sigf).read().strip()
        if have.returncode == 0 and cur == sig:                   # table present + same wants → converged, no-op
            return
        lines = ["delete table inet " + MECH_NFT_TABLE] if have.returncode == 0 else []
        lines.append("table inet " + MECH_NFT_TABLE + " {")
        for S, els in sorted(portsets.items()):
            lines.append("  set " + _mech_ports(S) + " { type inet_proto . inet_service; flags interval; elements = { " + ", ".join(els) + " } }")
        for S in sorted(meters):                                  # FLAGGED-scanner set — only over-rate src IPs are added, timeout-expiring
            lines.append("  set " + _mech_flagged(S) + " { type ipv4_addr; flags timeout; }")
        lines.append("  chain forward { type filter hook forward priority filter; policy accept;")
        for S in sorted(portsets):                                # ONE port-drop rule per subnet (all its port mechanisms)
            lines.append("    ip saddr " + S + " meta l4proto . th dport @" + _mech_ports(S) + " drop")
        for S in sorted(meters):                                  # per-SOURCE new-connection rate limit (scans / brute-force). Over-rate
            lines.append("    ip saddr " + S + " ct state new meter " + _mech_meter(S) +   # sources are recorded in the flagged set (→ real
                         " { ip saddr limit rate over 200/second } add @" + _mech_flagged(S) + " { ip saddr timeout 600s } drop")   # scanner attribution, self-decaying)
        lines += ["  }", "}"]
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True)
        path = os.path.join(GEO_DIR, ".mech.nft")
        with open(path, "w") as f:
            f.write("\n".join(lines) + "\n")
        rc = run(["nft", "-f", path]).returncode
        with contextlib.suppress(OSError):
            os.unlink(path)
        if rc == 0:
            with contextlib.suppress(OSError):
                open(sigf, "w").write(sig)
            res["changed"] += 1
        else:
            res["errors"].append("mech block nft load failed")
    except Exception as e:
        res["errors"].append("mech block: " + str(e)[:120])


TORRENT_MARK = 0x7770     # connmark for a detected BitTorrent flow (outside the 7000-7099 fwmark band + SNI reset 0x9999)

def _ensure_torrent_sig(subnets, res):
    """Phase 3 of the torrents mechanism — the PROPER, port-independent BitTorrent block by protocol SIGNATURE
    (iptables `-m string`, xt_string). For each subnet: scan ONLY the first packets of a NEW tcp flow
    (`-m connbytes 0:12 original packets`) for the `\\x13BitTorrent protocol` handshake; on a hit, pin the flow's
    connmark and DROP it. A `connmark → DROP` rule placed FIRST means a classified flow drops O(1) and NEVER
    re-scans, so scanning is confined to a tiny bounded window at connection setup (near-zero amortized). SUPPLEMENTS
    the free port-hint (swg_mech) — catches BitTorrent on any port. Capability-gated (needs `iptables -m string`);
    where absent, the port-hint still applies. Sig-gated (rebuild only on change), never raises. Mirrors
    _ensure_smart_xtstring's SWGP chain lifecycle exactly (mangle PREROUTING)."""
    CHAIN = "SWGP"
    subs = sorted(set(subnets or []))
    sig = hashlib.sha1(("torsig7|" + ";".join(subs)).encode()).hexdigest()[:16]   # torsig7: presence-only swgp_src (element counters proven non-accumulating; reverted count rules)
    sigf = os.path.join(GEO_DIR, ".torsig-sig")
    try:
        stored = open(sigf).read().strip()
    except OSError:
        stored = ""
    hooked = run(["iptables", "-t", "mangle", "-C", "PREROUTING", "-p", "tcp", "-j", CHAIN]).returncode == 0
    if stored == sig and (hooked or not subs):                # steady state → no-op
        return
    if subs and not _kernel_sni_ok():                         # no xt_string on this box → port-hint (swg_mech) only, skip the scan
        return
    run(["iptables", "-t", "mangle", "-D", "PREROUTING", "-p", "tcp", "-j", CHAIN])   # unhook + rebuild fresh
    run(["iptables", "-t", "mangle", "-F", CHAIN]); run(["iptables", "-t", "mangle", "-X", CHAIN])
    if not subs:                                              # teardown (torrents off / no subnets)
        with contextlib.suppress(OSError):
            os.remove(sigf)
        return
    _ok = [True]
    def _ipt(*a):
        r = run(["iptables", "-t", "mangle", *a])
        if r.returncode != 0:
            res["errors"].append("torrent-sig: " + (r.stderr or "").strip()[:120]); _ok[0] = False
    _ipt("-N", CHAIN)
    # torrent source IPs (who tried torrents), self-expiring PRESENCE set (attribution: which peers offended).
    run(["ipset", "create", "swgp_src", "hash:ip", "timeout", "600", "-exist"])
    for S in subs:
        # Phase 1 (FIRST): a flow already classified BitTorrent → record the source (attribution: who tried torrents) then
        # drop O(1), never re-scan. swgp_src is a self-expiring PRESENCE set — membership tells us which peers offended;
        # ipset element counters don't accumulate (SET overwrites to the last packet), so we keep presence, not counts.
        _ipt("-A", CHAIN, "-s", S, "-m", "connmark", "--mark", hex(TORRENT_MARK), "-j", "SET", "--add-set", "swgp_src", "src", "--exist")
        _ipt("-A", CHAIN, "-s", S, "-m", "connmark", "--mark", hex(TORRENT_MARK), "-j", "DROP")
        # Phase 2 (BOUNDED scan): only the first packets of a NEW tcp flow — on the handshake, pin the connmark…
        _ipt("-A", CHAIN, "-s", S, "-p", "tcp",
             "-m", "connbytes", "--connbytes", "0:12", "--connbytes-dir", "original", "--connbytes-mode", "packets",
             "-m", "string", "--algo", "bm", "--hex-string", "|13|BitTorrent protocol",
             "-j", "CONNMARK", "--set-mark", hex(TORRENT_MARK))
        # …and drop the packet that just matched (subsequent packets hit the Phase-1 rule).
        _ipt("-A", CHAIN, "-s", S, "-m", "connmark", "--mark", hex(TORRENT_MARK), "-j", "DROP")
    _ipt("-A", "PREROUTING", "-p", "tcp", "-j", CHAIN)        # hook once, last
    if _ok[0]:
        res["changed"] += 1
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True); open(sigf, "w").write(sig)


def reconcile_dial_src(desired_by_iface, res):
    """Pin the OUTBOUND source IP for each mesh link that set a dial_src — a /32 route to the peer endpoint
    with `src <dial_src>` in the main table (the encrypted tunnel UDP leaves the WAN, so this never touches
    the cascade 7000-band). `ip route replace` is atomic (no gap) so it's re-asserted every sync (reboot-safe);
    a cleared dial_src removes the route (diffed against a small state file). Never raises into the sync loop."""
    try:
        want = {}                                              # peer endpoint IP -> dial source IP
        for peers in (desired_by_iface or {}).values():
            for p in peers:
                ds = (p.get("dial_src") or "").strip(); ep = p.get("endpoint") or ""
                if not ds or not ep:
                    continue
                try:
                    want[socket.gethostbyname(ep.rsplit(":", 1)[0])] = ds
                except Exception:
                    continue                                   # unresolvable endpoint → skip (retry next sync)
        statef = os.path.join(STATE_DIR, "dial-src.json")
        prev = {}
        with contextlib.suppress(Exception):
            prev = json.load(open(statef))
        for ip in (set(prev) - set(want)):                     # dial_src cleared → drop our /32
            run(["ip", "route", "del", ip + "/32"]); res["changed"] += 1
        for ip, ds in want.items():                            # (re)assert the source route (atomic, idempotent)
            g = run(["ip", "route", "get", ip]).stdout
            mdev = re.search(r"\bdev (\S+)", g); mvia = re.search(r"\bvia (\S+)", g)
            cmd = ["ip", "route", "replace", ip + "/32"]
            if mvia:
                cmd += ["via", mvia.group(1)]
            if mdev:
                cmd += ["dev", mdev.group(1)]
            cmd += ["src", ds]
            if run(cmd).returncode != 0:
                res["errors"].append("dial-src " + ip + ": route failed")
            elif prev.get(ip) != ds:
                res["changed"] += 1
        if want != prev:
            with contextlib.suppress(Exception):
                with open(statef + ".tmp", "w") as f:
                    json.dump(want, f)
                os.replace(statef + ".tmp", statef)
    except Exception as e:
        res["errors"].append("dial-src: " + str(e)[:120])


def apply_panel_settings(pan):
    """Consume the sync-reply `panel` block (Panel settings): push the geo/turn mirrors via in-process env
    (existing readers pick them up untouched), set the runtime geo TTL, and force a geo re-fetch when the
    operator bumps the epoch (wipe the cache files so they read missing). Never raises."""
    try:
        if not isinstance(pan, dict):
            return
        if (pan.get("turn_mirror") or "").strip():             # only ADD a turn mirror (preserve any install-time one)
            os.environ["SWG_TURN_MIRROR"] = pan["turn_mirror"].strip()
        ep = str(int(pan.get("geo_epoch") or 0))
        ef = os.path.join(GEO_DIR, ".geo-epoch")
        cur = ""
        with contextlib.suppress(Exception):
            cur = open(ef).read().strip()
        if ep != cur:                                          # Refresh-geo pressed → drop cache so it refetches
            with contextlib.suppress(OSError):
                os.makedirs(GEO_DIR, exist_ok=True)
            for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
                if fn.endswith((".txt", ".attempt", ".loaded", ".doms")):
                    with contextlib.suppress(OSError):
                        os.unlink(os.path.join(GEO_DIR, fn))
            with contextlib.suppress(OSError):
                open(ef, "w").write(ep)
    except Exception:
        pass


def _apply_routing_reset(reset_val, res, learned_val=None):
    """Dispatch the operator's reset counters. A full reset already clears the learned sets, so skip the learned
    pass when it fired. Returns True if either reset ran."""
    full = _apply_full_reset(reset_val, res)
    learned = False if full else _apply_learned_reset(learned_val, res)
    return full or learned


def _apply_learned_reset(learned_val, res):
    """Operator pressed 'Reset learned IPs': clear ONLY the node's learned dst-IP sets (kernel-SNI ipsets + the
    userspace-SNI nft sets), keeping the pulled lists in place — no re-pull. This SAME reconcile pass rebuilds the
    nft sets from the still-cached lists (geoip re-loads) and the reader re-learns hosts as traffic flows. Fires once
    per press (per-node counter vs local stamp)."""
    try:
        rv = str(int(learned_val or 0))
    except Exception:
        rv = "0"
    stamp = os.path.join(GEO_DIR, ".routing-reset-learned")
    cur = ""
    with contextlib.suppress(Exception):
        cur = open(stamp).read().strip()
    if rv == cur or rv == "0":                                  # unchanged (or never reset) → nothing to do
        return False
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True)
    # kernel-SNI: flush each learned ipset (keep the set + chain — only the learned IPs go)
    for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
        run(["ipset", "flush", setn])
    # userspace-SNI: drop the rebuild signatures + per-list loaded markers so the nft sets rebuild from the CACHED
    # lists this pass (userspace-learned IPs go; geoip re-loads from the still-present .txt — NO re-pull)
    for fn in (".smart-sig", ".xtstring-sig", ".catcount-sig"):
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(GEO_DIR, fn))
    for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
        if fn.endswith(".loaded"):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, fn))
    run(["nft", "delete", "table", "inet", SMART_NFT_TABLE])    # rebuilt from cache below (same pass)
    _SMART_TABLE["n"] = -1                                      # invalidate the per-loop table cache so _ensure_smart_nft re-renders
    p = _SNI_PROC.get("p")                                      # restart the userspace reader → its in-memory learned/seen clears
    if p and p.poll() is None:
        with contextlib.suppress(Exception): p.terminate()
    _SNI_PROC["p"] = None
    with contextlib.suppress(OSError):
        open(stamp, "w").write(rv)
    res["changed"] += 1
    print("routing: LEARNED RESET #%s — flushed learned ipsets/nft sets (lists kept); re-learning" % rv, flush=True)
    return True


def _apply_full_reset(reset_val, res):
    """Operator pressed 'Reset routing' for this node: wipe ALL smart-routing state so the SAME reconcile pass
    rebuilds it from scratch and re-pulls every enabled/curated list from the panel. Idempotent — acts only when
    the panel's per-node counter differs from our local stamp (so it fires once per press, never on a normal sync).
    An explicit operator action, not an outage → safe to wipe (the never-wipe-on-outage invariant is about failed
    syncs, which never reach here). Returns True if it reset."""
    try:
        rv = str(int(reset_val or 0))
    except Exception:
        rv = "0"
    stamp = os.path.join(GEO_DIR, ".routing-reset")
    cur = ""
    with contextlib.suppress(Exception):
        cur = open(stamp).read().strip()
    if rv == cur or rv == "0":                                  # unchanged (or never reset) → nothing to do
        return False
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True)
    # 1) wipe the pulled-list cache + every rebuild signature → forces a fresh re-pull + full rebuild next
    for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
        if fn.endswith((".txt", ".doms", ".attempt", ".loaded")) or fn in (
                ".smart-sig", ".xtstring-sig", ".catcount-sig", ".geo-epoch", ".doh.sig", ".automerge-migrated"):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, fn))
    # 2) drop the nft smart table (all sets + chains + mark rules) → rebuilt below
    run(["nft", "delete", "table", "inet", SMART_NFT_TABLE])
    _SMART_TABLE["n"] = -1                                      # invalidate the per-loop table cache so _ensure_smart_nft re-renders (sees it gone) and RECREATES it this same pass
    # 3) drop the kernel-SNI iptables chain + destroy the learned ipsets
    run(["iptables", "-t", "mangle", "-D", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", "SWGK"])
    run(["iptables", "-t", "mangle", "-F", "SWGK"]); run(["iptables", "-t", "mangle", "-X", "SWGK"])
    for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
        run(["ipset", "destroy", setn])
    # 4) restart the userspace SNI reader so its in-memory learned set clears (relaunched by _ensure_sni_router)
    p = _SNI_PROC.get("p")
    if p and p.poll() is None:
        with contextlib.suppress(Exception): p.terminate()
    _SNI_PROC["p"] = None
    with contextlib.suppress(OSError):
        open(stamp, "w").write(rv)
    res["changed"] += 1
    print("routing: FULL RESET #%s — wiped sets/chains/ipsets/list-cache; rebuilding + re-pulling" % rv, flush=True)
    return True


def reconcile_cascade(node_cfg, plan, smart=None, default_egress_ip="", panel_conn=None, panel_cfg=None):
    """Phase 2 cascade + Phase 3 smart routing. ENTRY (P2 forward): `ip rule from S lookup T`; ENTRY
    (P3 smart): nftables marks `ip saddr S ip daddr @<category> meta mark set T` then `ip rule fwmark T
    lookup T` — both route into `default dev <link> table T`. EXIT (shared): `ip rule to S lookup T` +
    `S dev <link> table T` + SNAT S out the WAN. Idempotent: policy rules/routes are rebuilt only when
    they DRIFT from the plan (a signature compare — never churn each sync, which would leak a packet to
    direct egress mid-gap); the iptables + nft sides are diffed by tag/signature. Runtime state is lost on
    reboot, so this re-applies on the first sync after one. Returns {changed, errors}."""
    res = {"changed": 0, "errors": []}
    plan = plan or {}
    fwd = plan.get("forward") or []
    exit_ = plan.get("exit") or []
    smart_e = (smart or {}).get("entries") or []
    smart_exit = [e for e in smart_e if e.get("action", "exit") == "exit"]   # only exit rules carry a mesh table/dev; direct/block are local verdicts
    mode = (smart or {}).get("mode") or "kernel"               # kernel | forcedns | sni | sni_kernel — the CONFIGURED host-match mode
    _SMART_MODE["m"] = mode                                     # report the configured mode for the panel's host-layer health
    # Resolve the ACTUAL host-fill engine; degrade kernel-SNI → userspace SNI if xt_string/ipset are missing on this box.
    if mode == "forcedns":     host_engine = "dns"
    elif mode == "sni":        host_engine = "sni_user"
    elif mode == "sni_kernel": host_engine = "sni_kernel" if _kernel_sni_ok() else "sni_user"
    else:                      host_engine = "none"
    is_sni = host_engine in ("sni_user", "sni_kernel")         # both SNI engines share the nft ct-restore/QUIC-drop/reset setup
    _SMART_MODE["engine"] = host_engine                        # the ACTUAL running engine → smart_status reports its liveness
    _apply_routing_reset((smart or {}).get("routing_reset"), res, (smart or {}).get("routing_reset_learned"))   # operator resets: full wipe+re-pull, or learned-IPs-only
    ip_learning = (smart or {}).get("ip_learning", True)       # False → keep the node "fresh": learned SNI IPs expire fast (short TTL)
    learn_ttl = 3600 if ip_learning else 120                   # learned-IP lifetime (s) — kernel-SNI ipset AND Hybrid-SNI catl_ set
    _CAT_CAPS.clear(); _CAT_CAPS.update((smart or {}).get("cat_caps") or {})   # panel-shipped caps → host-tier seeding + kernel greying
    # PROVIDER lists: pull each routed one from the PANEL (not GitHub) when its version changed — writes the same
    # <cat>.txt / <cat>.doms the loaders below consume. New cat → now; changed cat → only in the quiet window.
    _panel_list_refresh((smart or {}).get("list_manifest") or {}, (panel_cfg or {}).get("geo_update") or {},
                        panel_conn, res)
    band = _live_band_prios()
    want_tables = {str(e["table"]) for e in (fwd + smart_exit + exit_)}
    want_sig = _cascade_want_sig(fwd, exit_, smart_exit)   # only exit entries create fwmark→table policy routing
    live_sig = _cascade_live_sig({str(p) for p in band} | want_tables)
    # POLICY RULES/ROUTES — only touch them when they drift (avoids per-sync rule gaps).
    if want_sig != live_sig:
        if fwd or smart_e or exit_:                            # enable forwarding + loose rp_filter (asymmetric paths)
            run(["sysctl", "-q", "-w", "net.ipv4.ip_forward=1"])
            wan = _detect_wan()
            for dev in sorted({"all", wan} | {e["via_iface"] for e in (fwd + smart_exit + exit_)}):
                run(["sysctl", "-q", "-w", f"net.ipv4.conf.{dev}.rp_filter=2"])   # effective = max(all,dev): lower BOTH
        for pri in band:                                       # teardown our whole band (rules + tables)
            for _ in range(8):                                 # del-until-absent (a priority may carry several rules)
                if run(["ip", "rule", "del", "pref", str(pri)]).returncode != 0:
                    break
            run(["ip", "route", "flush", "table", str(pri)])
        for e in fwd:                                          # P2 ENTRY: from S → table T (default via link)
            T = str(e["table"]); S = e["subnet"]; dev = e["via_iface"]
            run(["ip", "route", "replace", "default", "dev", dev, "table", T])
            run(["ip", "rule", "add", "from", S, "lookup", T, "priority", T])
            res["changed"] += 1
        for T, dev in sorted({(str(e["table"]), e["via_iface"]) for e in smart_exit}):   # P3 ENTRY: fwmark T → table T
            run(["ip", "route", "replace", "default", "dev", dev, "table", T])
            run(["ip", "rule", "add", "fwmark", T, "lookup", T, "priority", T])
            res["changed"] += 1
        for e in exit_:                                        # EXIT: to S → table T (S via link)
            T = str(e["table"]); S = e["subnet"]; dev = e["via_iface"]
            run(["ip", "route", "replace", S, "dev", dev, "table", T])
            run(["ip", "rule", "add", "to", S, "lookup", T, "priority", T])
            res["changed"] += 1
    # IPTABLES (SNAT / FORWARD accept / MSS clamp) — always reconciled by tag (cheap, no-churn).
    _ensure_fwd_iptables(fwd, exit_, _detect_wan(), res, default_egress_ip)
    # NFTABLES smart-routing marking (saddr+daddr@category → mark T) — drift-gated, packets stay in-kernel.
    smart_cats = sorted(set((smart or {}).get("categories") or []) | {e["category"] for e in smart_e})
    _smart_subs = {e["subnet"] for e in smart_e}                # smart interfaces (by subnet) → IPv6 fail-closed drop
    smart_ifs = sorted({ifn for ifn in (node_cfg.get("interfaces") or {}) if _iface_subnet(node_cfg, ifn) in _smart_subs}) if _smart_subs else []
    set_counts = _ensure_smart_nft(smart_e, smart_cats, res, pin=is_sni, v6_ifaces=smart_ifs,
                                    reset_mark=(SNI_RESET_MARK if is_sni else 0), queue=(host_engine == "sni_user"),
                                    learn_ttl=learn_ttl)
    domains = dict((smart or {}).get("domains") or {})         # domain-tier bundles {cat:[domain]} → dnsmasq/sni/kernel-filled
    if mode != "kernel":                                       # CATALOG host cats (no curated bundle) → seed empty so the node domain-fills them from MetaCubeX
        for _c, _caps in _CAT_CAPS.items():
            if _caps.get("host") and _c not in domains and _c in smart_cats:
                domains[_c] = []
    # GeoSite host tier: enrich each panel-shipped domain cat with the node-fetched upstream list (union), so the
    # curated bundle stays a guaranteed fallback. The union+sort of a ~100k-entry list is expensive to redo every
    # cycle, so cache the enriched dict on a CHEAP signature of the inputs — subnets + the raw panel bundles (small)
    # + each fetched cat's geo-file (mtime,size) — never touching the big lists. Unchanged inputs reuse the enriched
    # dict AND tell _ensure_smart_dnsmasq to skip its (equally expensive) config rebuild. This keeps domains[cat]
    # populated either way, so the geoip↔domain split below (skip=...) stays correct.
    _host_cats = [c for c in domains if _CAT_CAPS.get(c, {}).get("host")]
    if host_engine == "dns":                                   # Force-DNS loads full lists into the per-domain dnsmasq
        _admit = set(_forcedns_admit(_host_cats, res))         # map → memory-gate it; over-budget cats stay off (reported)
        for c in _host_cats:
            if c not in _admit:
                domains.pop(c, None)                           # not loaded → not filled: honest degrade, node stays online
        _host_cats = [c for c in _host_cats if c in _admit]
    else:
        _SMART_MODE.pop("fill_gate", None)                     # gate only governs the dnsmasq fill; clear when not in it
    _fetched = _smart_domain_refresh(_host_cats, res)
    dom_sig = (tuple(sorted({e["subnet"] for e in smart_e})), json.dumps(domains, sort_keys=True),
               tuple(sorted((c, _DOM_CACHE.get(c, (None,))[0]) for c in _fetched)))
    _dt = _DOMTIER_CACHE.get("v")
    dom_unchanged = bool(_dt and _dt[0] == dom_sig)
    if dom_unchanged:
        domains = _dt[1]                                       # inputs unchanged → reuse enriched dict (skip union+sort)
    else:
        for cat, fl in _fetched.items():
            domains[cat] = sorted(set(domains.get(cat) or []) | set(fl))
        _DOMTIER_CACHE["v"] = (dom_sig, domains)
    # GEOIP cats fill from cached CIDR lists (TTL-gated); domain cats are owned by dnsmasq → skip them here. A
    # cat is demoted from geoip only once it actually HAS domains, so a geoip-only cat (ru_net) never demotes and a
    # domain-capable cat stays geoip until its upstream domain list lands rather than going briefly empty.
    if smart_cats:
        _smart_geo_refresh(smart_cats, set_counts or {}, res, skip={c for c, v in domains.items() if v})
    _smart_load_cidrs((smart or {}).get("cidrs") or {}, set_counts or {}, res)   # custom-rule raw IPs/CIDRs → into the set
    _subs = sorted({e["subnet"] for e in smart_e})
    _mech = (smart or {}).get("mech") or {}                   # {subnet: [mechanism ids]} → FREE L4/rate drops (mode-independent)
    _doh_mech = {s for s, cats in _mech.items() if "doh" in (cats or [])}   # explicit per-interface DoH-block mechanism
    if host_engine == "sni_user":                             # userspace swg-sni fills the domain cats from the TLS
        _ensure_sni_router(domains, _subs, res, learn_ttl)    # handshake (client DNS untouched); enriched lists OK here
        _ensure_smart_xtstring([], {}, 0, res, active=False)  # ensure the kernel engine is torn down
        reconcile_catk_chain([])                              # not kernel-SNI → drop the per-category counting chain
        if _dnsmasq_running() or os.path.exists(DNSMASQ_CONF):
            _ensure_smart_dnsmasq({}, [], res, unchanged=False)
    elif host_engine == "sni_kernel":                         # in-kernel xt_string reader — no userspace daemon at all
        _ensure_sni_router(None, [], res)                     # stop swg-sni
        _ensure_smart_xtstring(smart_exit, domains, SNI_RESET_MARK, res, ttl=learn_ttl)   # enriched domains, capped per-cat inside (256)
        reconcile_catk_chain(sorted({e["category"] for e in smart_exit if domains.get(e["category"])}))   # per-category dest byte counters (swgk sets)
        if _dnsmasq_running() or os.path.exists(DNSMASQ_CONF):
            _ensure_smart_dnsmasq({}, [], res, unchanged=False)
    else:                                                     # forcedns (dnsmasq oracle) or kernel/IP-only (nothing)
        _ensure_sni_router(None, [], res)                     # not SNI → stop the classifier + drop its map
        _ensure_smart_xtstring([], {}, 0, res, active=False)  # ensure the kernel engine is torn down
        reconcile_catk_chain([])                              # not kernel-SNI → drop the per-category counting chain
        if smart_e or domains or _dnsmasq_running() or os.path.exists(DNSMASQ_CONF):
            _ensure_smart_dnsmasq(domains, smart_e, res, unchanged=dom_unchanged)
    # Encrypted-DNS (DoH/DoT) guard: forcedns AUTO-blocks every smart subnet (so the dnsmasq domain fill can't be
    # bypassed); SNI modes leave the client's DNS untouched by default — but an explicit per-interface DoH-block
    # mechanism blocks it in ANY mode. Union the two; empty → the swg_doh table is torn down (never-wipe, our table only).
    _doh_subs = set(_doh_mech)
    if host_engine not in ("sni_user", "sni_kernel") and (smart or {}).get("block_doh"):
        _doh_subs |= set(_subs)
    _ensure_doh_block(sorted(_doh_subs), bool(_doh_subs), res)
    _ensure_mech_block(_mech, res)                            # FREE traffic/abuse L4/rate drops (smtp/quic/torrents-porthint/portscan)
    _ensure_torrent_sig(sorted({s for s, cats in _mech.items() if "torrents" in (cats or [])}), res)   # Phase 3: bounded signature drop (any-port), where xt_string is capable
    return res


_KSNI = {"ok": None}            # cached kernel-SNI capability (ipset tool + iptables xt_string) — stable per boot


def _kernel_sni_ok():
    """True if the kernel-SNI datapath is usable on this box: the `ipset` tool AND iptables `-m string` (xt_string).
    Cached (stable until the box changes + noded restarts). Used to degrade-open to the userspace engine if absent."""
    if _KSNI["ok"] is None:
        _KSNI["ok"] = (run(["sh", "-c", "command -v ipset >/dev/null 2>&1"]).returncode == 0
                       and run(["sh", "-c", "iptables -m string --help >/dev/null 2>&1"]).returncode == 0)
    return _KSNI["ok"]


def _xts_setname(cat):
    return ("swgk_" + re.sub(r"[^a-z0-9]", "_", cat.lower()))[:31]   # ipset names cap at 31 chars


def _ensure_smart_xtstring(host_entries, domains, reset_mark, res, active=True, ttl=3600):
    """Kernel-SNI host tier (mode=sni_kernel): learn each host category's dst IPs IN-KERNEL from the TLS SNI
    (iptables `-m string` Boyer-Moore on the ClientHello) into a per-category ipset, route KNOWN IPs to that
    category's exit fwmark (CONNMARK — the nft ct-restore carries it to the packet), and flag the FIRST hit with
    reset_mark (→ the shared nft forward reject → RST → client reconnects routed). No userspace daemon; runs
    parallel per-CPU in softirq. Reuses the shared fwmark→mesh band + the shared reset rule. Drift-gated.

    host_entries: exit rules [{subnet, category, table}] whose category has domains. domains: {cat:[domain]} — the
    SMALL curated bundle ONLY (never the geosite-enriched list → that'd be tens of thousands of xt_string rules).
    active=False (or no host entries) → full teardown."""
    CHAIN = "SWGK"
    entries = [e for e in host_entries if domains.get(e["category"])] if active else []
    # Remember WHY the chain may be absent. "No entries" is the normal, correct state for an all-direct/all-block
    # ruleset, or for the window right after a node restart before the domain lists have been pulled — but the
    # health probe below only sees "the SWGK hook isn't there" and reported the engine DOWN, which is a red badge
    # on a node with nothing wrong with it.
    _SMART_MODE["xts_idle"] = not entries
    want_cats = sorted({e["category"] for e in entries})
    sig_src = (json.dumps([[e["subnet"], e["category"], e.get("table")] for e in entries], sort_keys=True)
               + "|" + json.dumps({c: sorted((domains.get(c) or [])[:256]) for c in want_cats}, sort_keys=True) + "|rm:" + str(reset_mark) + "|ttl:" + str(ttl))
    sig = hashlib.sha1(sig_src.encode()).hexdigest()[:16]
    sigf = os.path.join(GEO_DIR, ".xtstring-sig")
    try:
        stored = open(sigf).read().strip()
    except OSError:
        stored = ""
    hooked = run(["iptables", "-t", "mangle", "-C", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN]).returncode == 0
    if stored == sig and (hooked or not entries):              # steady state: keep the ipsets alive (they hold learned IPs — NEVER flush here)
        for c in want_cats:
            run(["ipset", "create", _xts_setname(c), "hash:ip", "family", "inet", "timeout", str(ttl), "-exist"])
        return
    if entries and not _kernel_sni_ok():
        res["errors"].append("kernel-sni: ipset/xt_string unavailable"); return
    run(["iptables", "-t", "mangle", "-D", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN])   # unhook, rebuild fresh
    run(["iptables", "-t", "mangle", "-F", CHAIN]); run(["iptables", "-t", "mangle", "-X", CHAIN])
    ttl_marker = os.path.join(GEO_DIR, ".xtstring-ttl")         # a TTL change (IP-learning toggled) can't be applied to a live set → recreate
    prev_ttl = ""
    with contextlib.suppress(Exception):
        prev_ttl = open(ttl_marker).read().strip()
    if entries and str(ttl) != prev_ttl:
        for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
            run(["ipset", "destroy", setn])
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True); open(ttl_marker, "w").write(str(ttl))
    if not entries:                                            # teardown: drop the chain + our learned ipsets
        for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
            run(["ipset", "destroy", setn])
        with contextlib.suppress(OSError):
            os.remove(sigf)
        return
    _ok = [True]
    def _ipt(*a):
        r = run(["iptables", "-t", "mangle", *a])
        if r.returncode != 0:
            res["errors"].append("kernel-sni: " + (r.stderr or "").strip()[:120]); _ok[0] = False
    for c in want_cats:                                        # per-category learned-IP set MUST exist before the rules reference it
        run(["ipset", "create", _xts_setname(c), "hash:ip", "family", "inet", "timeout", str(ttl), "-exist"])
    _ipt("-N", CHAIN)
    for e in entries:                                          # Phase 1: route KNOWN learned IPs to their exit, then RETURN
        setn = _xts_setname(e["category"]); T = str(e.get("table"))   # (so a known flow never re-learns / re-resets)
        _ipt("-A", CHAIN, "-s", e["subnet"], "-m", "set", "--match-set", setn, "dst", "-j", "CONNMARK", "--set-mark", T)
        _ipt("-A", CHAIN, "-s", e["subnet"], "-m", "set", "--match-set", setn, "dst", "-j", "RETURN")
    for e in entries:                                          # Phase 2: FIRST hit — read the SNI in-kernel, learn + flag
        setn = _xts_setname(e["category"])
        for d in (domains.get(e["category"]) or [])[:256]:     # cap per-cat rules; kernel routing lists are small (youtube≈177)
            _ipt("-A", CHAIN, "-s", e["subnet"], "-p", "tcp", "--dport", "443", "-m", "string", "--algo", "bm", "--string", d, "-j", "SET", "--add-set", setn, "dst")
        if reset_mark:
            for d in (domains.get(e["category"]) or [])[:256]:
                _ipt("-A", CHAIN, "-s", e["subnet"], "-p", "tcp", "--dport", "443", "-m", "string", "--algo", "bm", "--string", d, "-j", "CONNMARK", "--set-mark", hex(reset_mark))
    _ipt("-A", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN)   # hook once, last
    if _ok[0]:
        res["changed"] += 1
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True); open(sigf, "w").write(sig)


def _ensure_sni_router(domains, subnets, res, learn_ttl=3600):
    """SNI mode: write the domain→category map for swg-sni and keep the classifier running; any other mode stops it
    and drops the map. swg-sni reads each connection's ClientHello off the NFQUEUE that _ensure_smart_nft set up
    and adds the dst IP to the matched category set, so the kernel routes FUTURE connections to that IP — the
    client's own DNS (incl. DoH/DoT) is never touched. Supervised as a subprocess (shares swg-noded's cgroup, so it
    dies on a noded restart and is relaunched here)."""
    want = domains is not None and bool(subnets)
    p = _SNI_PROC.get("p")
    if not want:
        if p and p.poll() is None:
            with contextlib.suppress(Exception): p.terminate()
        _SNI_PROC["p"] = None
        with contextlib.suppress(OSError): os.remove(SNI_MAP_PATH)
        return
    if p and p.poll() is None and _SNI_PROC.get("ttl") != learn_ttl:   # ip_learning TTL flipped → relaunch so swg-sni's seen-cache
        with contextlib.suppress(Exception): p.terminate()            # TTL matches the new learned-set timeout (else a 3600→120 flip leaks)
        _SNI_PROC["p"] = None; p = None
    try:                                                       # write the map only when it changes (cheap; swg-sni reloads on mtime)
        newmap = json.dumps({c: sorted(d) for c, d in (domains or {}).items() if d}, sort_keys=True)
        old = ""
        with contextlib.suppress(OSError):
            with open(SNI_MAP_PATH) as f: old = f.read()
        if newmap != old:
            os.makedirs(os.path.dirname(SNI_MAP_PATH), exist_ok=True)
            with open(SNI_MAP_PATH + ".tmp", "w") as f: f.write(newmap)
            os.replace(SNI_MAP_PATH + ".tmp", SNI_MAP_PATH)
            res["changed"] += 1
    except Exception as e:
        res["errors"].append("sni map: " + str(e)[:120]); return
    if not p or p.poll() is not None:                          # (re)launch the classifier if it isn't running
        exe = next((c for c in (os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "swg-sni"),
                                "/opt/swg-noded/swg-sni", "/usr/local/bin/swg-sni") if os.path.exists(c)), None)
        if not exe:
            res["errors"].append("sni: swg-sni not found"); return
        try:
            log = open("/var/lib/swg-noded/swg-sni.log", "a")
            _SNI_PROC["p"] = subprocess.Popen([sys.executable, exe, "--queue", str(SNI_NFQUEUE),
                                               "--map", SNI_MAP_PATH, "--table", SMART_NFT_TABLE,
                                               "--reset-mark", hex(SNI_RESET_MARK), "--learn-ttl", str(learn_ttl)],
                                              stdout=log, stderr=log)
            _SNI_PROC["ttl"] = learn_ttl
            res["changed"] += 1; print("sni: launched swg-sni (queue %d, learn-ttl %d)" % (SNI_NFQUEUE, learn_ttl), flush=True)
        except Exception as e:
            res["errors"].append("sni launch: " + str(e)[:120])


def _block_activity():
    """Per-subnet blocking ACTIVITY, harvested from EXISTING datapath state — NO new counters, no per-packet cost:
      torrent = iptables SWGP signature chain: the CONNMARK-set rule's per-subnet count (≈ torrent connections caught)
      scan    = the port-scan meter's live element count (hosts currently rate-limited for scanning/flooding)
    Reach (distinct blocked destinations) is already in smart_status.sets (the cat_blku_* set element counts), so it
    needs nothing here. Best-effort — any read that fails just omits that signal (never raises). Returns {subnet:{…}}."""
    out = {}
    IP = r"\d+\.\d+\.\d+\.\d+/\d+"
    with contextlib.suppress(Exception):                          # torrent: iptables always counts; sum the signature-match rule per source subnet
        for ln in (run(["iptables", "-t", "mangle", "-nvL", "SWGP", "-x"]).stdout or "").splitlines():
            f = ln.split()
            if "CONNMARK" in ln and f and f[0].isdigit():
                subs = [x for x in f if re.match("^" + IP + "$", x)]
                if subs:
                    out.setdefault(subs[0], {})["torrent"] = int(f[0])
    with contextlib.suppress(Exception):                          # scan: the FLAGGED-scanner set per subnet — only over-rate src IPs
        mech = run(["nft", "list", "table", "inet", "swg_mech"]).stdout or ""   # land there, so it's the REAL scanners (not every active
        for sub, fset in re.findall(r"ip saddr (" + IP + r")[^\n]*?add @(pscf_\S+)", mech):   # source) + their IPs → per-user attribution
            with contextlib.suppress(Exception):
                sm = re.search(r"set " + re.escape(fset) + r" \{.*?elements = \{([^}]*)\}", mech, re.S)
                ips = re.findall(r"\d+\.\d+\.\d+\.\d+", sm.group(1)) if sm else []
                out.setdefault(sub, {})["scan"] = len(ips)
                if ips:
                    out[sub]["scan_ips"] = ips                    # source IPs the panel maps → peer → user for the "who" bubble
    with contextlib.suppress(Exception):                          # blocked: cumulative packets dropped to a content-block set,
        pre = run(["nft", "list", "chain", "inet", SMART_NFT_TABLE, "prerouting"]).stdout or ""   # summed per source subnet
        for ln in pre.splitlines():                               # rule: ip saddr <sub> ip daddr @cat_blku_… counter packets N … drop
            if "blku" not in ln or "drop" not in ln:
                continue
            sub = re.search(r"ip saddr (" + IP + r")", ln)
            pk = re.search(r"counter packets (\d+)", ln)
            if sub and pk:                                        # cat_ AND catl_ (Hybrid) drop rules both count → sum per subnet
                out.setdefault(sub.group(1), {})
                out[sub.group(1)]["blocked"] = out[sub.group(1)].get("blocked", 0) + int(pk.group(1))
    with contextlib.suppress(Exception):                          # torrent SOURCE IPs (who tried torrents) from the swgp_src
        il = run(["ipset", "list", "swgp_src"]).stdout or ""      # presence set, matched into the subnet they belong to
        tips = re.findall(r"\d+\.\d+\.\d+\.\d+", il.split("Members:", 1)[-1]) if "Members:" in il else []
        for ip in tips:
            with contextlib.suppress(Exception):
                a = ipaddress.ip_address(ip)
                for sub in list(out):
                    if a in ipaddress.ip_network(sub, strict=False):
                        out[sub].setdefault("torrent_ips", []).append(ip); break
    return out


def _blk_domains_read():
    """swg-sni's bounded top-K of blocked hostnames (host → cumulative hit count). The PANEL buckets these into content
    categories (it owns the per-category source lists), so no per-category datapath is needed. Userspace-SNI mode only;
    best-effort, empty if the file is absent (other engines / SNI off)."""
    with contextlib.suppress(Exception):
        with open(os.path.join(os.path.dirname(SNI_MAP_PATH), "sni-blk-hits.json")) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return {str(k): int(v) for k, v in d.items() if isinstance(v, (int, float)) and int(v) > 0}
    return {}


def smart_status():
    """Phase 3 smart-routing health for the panel UI: whether our nft table is up, per-category element counts
    (a populated set = data loaded), active mark-rule count, and HOST-LAYER health — the configured mode, whether
    the mode's fill engine is alive (swg-sni for SNI, dnsmasq for Force-DNS), and the SNI first-hit reset hit-count.
    So the operator sees a silent host-layer failure (dead reader / never learning) instead of just missing routes."""
    t = _smart_table()                                          # shared per-loop render + parse (also used by _ensure_smart_nft)
    mode = _SMART_MODE.get("m") or "kernel"
    engine = _SMART_MODE.get("engine") or "none"                # actual running engine: none|dns|sni_user|sni_kernel
    sni_alive = bool(_SNI_PROC.get("p") and _SNI_PROC["p"].poll() is None)
    dns_alive = bool(_dnsmasq_running())
    if engine == "sni_user":     engine_ok = sni_alive          # is the mode's fill engine actually up?
    elif engine == "sni_kernel":                                # the hook is torn down on purpose when there is nothing to route
        engine_ok = bool(_SMART_MODE.get("xts_idle")) or run(
            ["iptables", "-w", "2", "-t", "mangle", "-C", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", "SWGK"]).returncode == 0
    elif engine == "dns":        engine_ok = dns_alive and _route_localnet_ok()   # dnsmasq up AND loopback-DNAT possible
    else:                        engine_ok = True               # IP-only → no host engine to be down
    base = {"mode": mode, "engine": engine, "engine_ok": engine_ok, "sni_alive": sni_alive,
            "dnsmasq": dns_alive, "route_localnet": _route_localnet_ok()}   # false in dns mode ⇒ client DNS blackholed (container)
    if _SMART_MODE.get("fill_gate"):                           # Force-DNS fill skipped over-budget categories → tell the panel
        base["fill_gate"] = _SMART_MODE["fill_gate"]
    if t["rc"] != 0:
        return {**base, "active": False, "sets": {}, "rules": 0, "resets": 0}
    rules = len(re.findall(r"ip saddr \S+ ip daddr @\S+ meta mark set", t["out"]))
    resets = sum(int(x) for x in re.findall(r"meta mark 0x0*9999 counter packets (\d+)", t["out"]))   # SNI first-hit RSTs
    return {**base, "active": rules > 0, "sets": dict(t["counts"]), "rules": rules,
            "bytes": dict(t["bytes"]), "resets": resets,   # bytes: {cat:{up,dn}} cumulative destination stats
            "block": _block_activity(),                    # {subnet:{torrent,scan}} blocking activity from existing state (reach is in `sets`)
            "blk_domains": _blk_domains_read()}            # {host:count} blocked-domain top-K (SNI mode) → panel buckets into categories


_CATS = {"t": 0.0, "cum": {}, "rate": {}}


def sample_cats():
    """LATEST per-category throughput {cat:{up,dn}} B/s — the delta of the cumulative nft category counters
    (harvested by _smart_table) over the last interval. The LIVE 'traffic by destination' figure: the most
    recent push, not a window average. Reset/vanish-safe; cheap (reuses the per-loop dump — no new subprocess)."""
    t = _smart_table()
    if t["rc"] != 0:
        _CATS["rate"] = {}
        return {}
    cum = t["bytes"]
    now = time.time()
    prev, pt = _CATS["cum"], _CATS["t"]
    if prev and now > pt:
        dt = now - pt
        r = {}
        for cat, v in cum.items():
            if str(cat).startswith("blku"):      # block-list set — a drop target, not a destination category; keep it
                continue                          # out of the "top destinations" throughput (its reach lives in `sets`)
            p = prev.get(cat) or {}
            r[cat] = {"up": max(0.0, v.get("up", 0) - p.get("up", 0)) / dt,   # counter reset (rebuild/reboot) → drop → 0
                      "dn": max(0.0, v.get("dn", 0) - p.get("dn", 0)) / dt}
        _CATS["rate"] = r
    _CATS["cum"] = cum
    _CATS["t"] = now
    return dict(_CATS["rate"])


# ───────────────────────── internet egress volume (measured, not estimated) ─────────────────────────
# The exact bytes this node forwards to/from the INTERNET, read off the per-iface FORWARD ACCEPT counters
# the agent installs in every interface's PostUp (`-i <iface> -o <wan>` = upload · `-i <wan> -o <iface>` =
# download). Counting is free (kernel keeps these counters always-on); we only READ them, and only on a slow
# gate (~15s) — NEVER on the 5s snapshot path — caching the rate so build_snapshot just attaches the cache.
# Correct for multi-hop by construction: at an ENTRY forwarded traffic goes iface→mesh (both tunnels, no `-o
# <wan>` match), so only DIRECT client traffic counts; at an EXIT the mesh iface forwards to the WAN
# (`-i swg_… -o <wan>`), so the relayed volume is attributed to the node that actually reaches the internet.
INET_SAMPLE_EVERY_S = 5    # match the client/mesh lanes' 5s cadence — a mangle-table iptables-save is ~1-3ms (geo sets live in a separate nft table), measured negligible on a 1-CPU node
SWG_INET_TABLE = "mangle"        # count in MANGLE FORWARD, not filter — see reconcile_inet_chain
SWG_INET_CHAIN = "SWG_INET"      # our own chain, jumped from mangle FORWARD: counts tunnel↔wan bytes
_INET = {"t": 0.0, "cum": None, "rate": {"up": 0.0, "down": 0.0}}


def reconcile_inet_chain(node_cfg):
    """Maintain the SWG_INET counting chain: one up (iface→wan) + one down (wan→iface) rule per managed
    tunnel iface, tagged with a comment, jumped from mangle FORWARD. The rules carry NO target, so they only
    COUNT and fall through — the packet's verdict is unchanged (no datapath effect).

    Why MANGLE FORWARD (not filter): netfilter traverses the mangle FORWARD hook BEFORE the filter table, so
    the counters see every forwarded packet regardless of the server's firewall. On a box running firewalld/
    ufw the filter FORWARD chain often starts with `ctstate ESTABLISHED,RELATED -j ACCEPT`, which would accept
    the return (download) traffic before any filter-level counter — undercounting there. Counting in mangle is
    config-independent: it works the same on a bare Debian box, a firewalld CentOS, an lxc/kvm guest, or the
    host-netns docker node. Mangle has no ACCEPT/DROP that terminates, so our fall-through rules never disturb
    the smart-routing marks either. WAN is the default-route egress (`ip route get 1.1.1.1`) — generic across
    providers/NIC names. Rebuilt only when the iface-set/WAN signature changes, so counters keep accruing.
    Best-effort (a node without iptables just no-ops)."""
    T = SWG_INET_TABLE
    managed = set((node_cfg.get("interfaces") or {}).keys())
    with contextlib.suppress(Exception):
        managed |= set(_wdtt_load().keys())   # WDTT owns its TUN + MASQUERADEs directly → count its internet egress too (feeds the flow-map internet lane)
    managed = sorted(managed)
    if not managed:
        return
    wan = _detect_wan()
    if not wan:
        return
    if run(["iptables", "-t", "filter", "-nL", SWG_INET_CHAIN]).returncode == 0:   # migrate: earlier builds
        run(["iptables", "-t", "filter", "-D", "FORWARD", "-j", SWG_INET_CHAIN])    # put this chain in FILTER;
        run(["iptables", "-t", "filter", "-F", SWG_INET_CHAIN])                     # drop it so counts don't
        run(["iptables", "-t", "filter", "-X", SWG_INET_CHAIN])                     # split across two tables
    if run(["iptables", "-t", T, "-nL", SWG_INET_CHAIN]).returncode != 0:
        run(["iptables", "-t", T, "-N", SWG_INET_CHAIN])          # create the chain (idempotent)
    if ("-j " + SWG_INET_CHAIN) not in (run(["iptables", "-t", T, "-S", "FORWARD"]).stdout or ""):
        run(["iptables", "-t", T, "-I", "FORWARD", "1", "-j", SWG_INET_CHAIN])   # count before anything else
    cur = run(["iptables", "-t", T, "-S", SWG_INET_CHAIN]).stdout.splitlines()
    cursig = set()
    for ln in cur:
        m = re.search(r'--comment "?(swg-inet-(?:up|dn)):([^"\s]+)', ln)   # `-S` QUOTES the comment — tolerate it, else cursig is always empty → constant flush → counters never accrue
        if not m:
            continue
        mi = re.search(r"-i (\S+)", ln); mo = re.search(r"-o (\S+)", ln)
        cursig.add((m.group(1), m.group(2), mi.group(1) if mi else "", mo.group(1) if mo else ""))
    wantsig = set()
    for ifn in managed:
        wantsig.add(("swg-inet-up", ifn, ifn, wan)); wantsig.add(("swg-inet-dn", ifn, wan, ifn))
    if cursig == wantsig:
        return                                              # unchanged → leave the counters accumulating
    run(["iptables", "-t", T, "-F", SWG_INET_CHAIN])          # iface set / WAN changed → rebuild
    for ifn in managed:
        run(["iptables", "-t", T, "-A", SWG_INET_CHAIN, "-i", ifn, "-o", wan,
             "-m", "comment", "--comment", "swg-inet-up:" + ifn])
        run(["iptables", "-t", T, "-A", SWG_INET_CHAIN, "-i", wan, "-o", ifn,
             "-m", "comment", "--comment", "swg-inet-dn:" + ifn])


def read_inet_bytes(managed_ifaces=None):
    """Cumulative internet-forwarded bytes {up, down} from the SWG_INET chain counters (see
    reconcile_inet_chain). One cheap `iptables-save -c -t mangle`. None → unreadable / chain not built yet."""
    r = run(["iptables-save", "-c", "-t", SWG_INET_TABLE])
    if r.returncode != 0 or not r.stdout:
        return None
    up = down = 0
    for ln in r.stdout.splitlines():
        if "swg-inet-" not in ln:
            continue
        m = re.match(r"\[\d+:(\d+)\]\s+-A\s+" + SWG_INET_CHAIN + r"\b(.*)", ln)
        if not m:
            continue
        by = int(m.group(1))
        if "swg-inet-up:" in m.group(2):
            up += by
        elif "swg-inet-dn:" in m.group(2):
            down += by
    return {"up": up, "down": down}


def sample_inet(node_cfg, now):
    """Return the cached internet {up, down} rate (B/s), refreshing the counters at most every
    INET_SAMPLE_EVERY_S. First read only sets the baseline (rate stays 0 until the next sample)."""
    if _INET["cum"] is not None and (now - _INET["t"]) < INET_SAMPLE_EVERY_S:
        return _INET["rate"]
    managed = set((node_cfg.get("interfaces") or {}).keys())
    if not managed:
        return _INET["rate"]
    cur = read_inet_bytes(managed)
    if cur is None:                                    # no iptables (some containers) → leave last known
        return _INET["rate"]
    prev, pt = _INET["cum"], _INET["t"]
    if prev is not None and now > pt:                  # counter reset (iface flap) → clamp the negative delta to 0
        dt = now - pt
        _INET["rate"] = {"up": max(0.0, (cur["up"] - prev["up"]) / dt),
                         "down": max(0.0, (cur["down"] - prev["down"]) / dt)}
    _INET["cum"] = cur; _INET["t"] = now
    return dict(_INET["rate"])


# ── Kernel-SNI per-category bytes (destination stats for the sni_kernel engine) ──
# The nft `catcount` counters key off the nft cat_<c> GEOIP sets. But Kernel-SNI learns dst IPs into the swgk_<c>
# IPSETS (nft can't match an ipset), so its routed traffic is invisible to catcount → the "top destinations" chart is
# empty in sni_kernel mode. Mirror the SWG_INET pattern: an iptables mangle-FORWARD chain that counts up (dst∈swgk_<c>)
# + dn (src∈swgk_<c>) per category via `-m set`, read as a delta. Config-independent (mangle runs before filter),
# count-only (no verdict → no datapath effect). Merged into cat_rate alongside the nft catcount cats.
SWG_CATK_CHAIN = "SWG_CATK"
CATK_SAMPLE_EVERY_S = 5
_CATK = {"t": 0.0, "cum": None, "rate": {}}


def reconcile_catk_chain(cats):
    """Maintain SWG_CATK: per-category up/dn count rules (`-m set --match-set swgk_<c> dst|src`) in mangle FORWARD,
    so the Kernel-SNI datapath's routed bytes are attributed per category. cats = raw category ids with a swgk_ set.
    Drift-gated on the category set; best-effort (a node without iptables/ipset just no-ops)."""
    T = "mangle"
    want = sorted(set(c for c in (cats or []) if c and c != "all"))
    have = run(["iptables", "-t", T, "-nL", SWG_CATK_CHAIN]).returncode == 0
    if not want:
        if have:
            run(["iptables", "-t", T, "-D", "FORWARD", "-j", SWG_CATK_CHAIN])
            run(["iptables", "-t", T, "-F", SWG_CATK_CHAIN]); run(["iptables", "-t", T, "-X", SWG_CATK_CHAIN])
        return
    if not have:
        run(["iptables", "-t", T, "-N", SWG_CATK_CHAIN])
    if ("-j " + SWG_CATK_CHAIN) not in (run(["iptables", "-t", T, "-S", "FORWARD"]).stdout or ""):
        run(["iptables", "-t", T, "-I", "FORWARD", "1", "-j", SWG_CATK_CHAIN])   # count before anything else
    cur = run(["iptables", "-t", T, "-S", SWG_CATK_CHAIN]).stdout or ""
    cursig = set(m.group(1) for m in re.finditer(r'--comment "?swg-catk-(?:up|dn):([^"\s]+)', cur))   # `-S` quotes the comment
    if cursig == set(want):
        return                                              # unchanged → leave the counters accumulating
    run(["iptables", "-t", T, "-F", SWG_CATK_CHAIN])
    for c in want:
        sn = _xts_setname(c)
        run(["iptables", "-t", T, "-A", SWG_CATK_CHAIN, "-m", "set", "--match-set", sn, "dst",
             "-m", "comment", "--comment", "swg-catk-up:" + c])   # up: client → dest (dst in the learned set)
        run(["iptables", "-t", T, "-A", SWG_CATK_CHAIN, "-m", "set", "--match-set", sn, "src",
             "-m", "comment", "--comment", "swg-catk-dn:" + c])   # dn: dest → client (src in the learned set)


def sample_catk():
    """Kernel-SNI per-category {cat:{up,dn}} B/s from the SWG_CATK counters (delta). {} if the chain isn't built."""
    now = time.time()
    if _CATK["cum"] is not None and (now - _CATK["t"]) < CATK_SAMPLE_EVERY_S:
        return dict(_CATK["rate"])
    r = run(["iptables-save", "-c", "-t", "mangle"])
    if r.returncode != 0 or not r.stdout:
        return dict(_CATK["rate"])                          # no iptables → leave last known
    if "swg-catk-" not in r.stdout:                         # chain gone (mode changed) → clear
        _CATK["cum"] = {}; _CATK["rate"] = {}; _CATK["t"] = now
        return {}
    cum = {}
    for ln in r.stdout.splitlines():
        m = re.match(r"\[\d+:(\d+)\]\s+-A\s+" + SWG_CATK_CHAIN + r"\b(.*)", ln)
        if not m:
            continue
        mm = re.search(r"swg-catk-(up|dn):(\S+)", m.group(2))
        if not mm:
            continue
        cum.setdefault(mm.group(2).strip('"'), {"up": 0, "dn": 0})[mm.group(1)] += int(m.group(1))
    prev, pt = _CATK["cum"], _CATK["t"]
    if prev is not None and now > pt:                       # counter reset (rebuild) → clamp negative delta to 0
        dt = now - pt
        _CATK["rate"] = {c: {"up": max(0.0, v["up"] - (prev.get(c) or {}).get("up", 0)) / dt,
                             "dn": max(0.0, v["dn"] - (prev.get(c) or {}).get("dn", 0)) / dt}
                         for c, v in cum.items()}
    _CATK["cum"] = cum; _CATK["t"] = now
    return dict(_CATK["rate"])


def node_datapath_health():
    """This node's kernel-datapath health for the panel's self-heal check: is the AmneziaWG kernel module loadable
    when the node uses awg? Bare-metal only — a docker node runs the userspace amneziawg-go datapath (no kernel
    module, so the "Unknown device type" DKMS class can't happen) → {}. Mirrors the panel's host_datapath_health."""
    if NODE_KIND == "docker":
        return {}
    out = {}
    try:
        awg_used = any(os.path.exists(p) for p in ("/usr/bin/awg", "/usr/local/bin/awg", "/sbin/awg", "/usr/sbin/awg"))
        if awg_used:
            loaded = False
            try:
                with open("/proc/modules") as f:
                    loaded = any(ln.startswith("amneziawg ") for ln in f)
            except Exception:
                pass
            built = False
            if not loaded:
                kr = os.uname().release
                for d in ("/lib/modules/%s/updates/dkms" % kr, "/lib/modules/%s/updates" % kr, "/lib/modules/%s/kernel/drivers/net" % kr):
                    try:
                        if any(f.startswith("amneziawg.ko") for f in os.listdir(d)):
                            built = True
                            break
                    except Exception:
                        continue
            out["awg"] = {"needed": True, "ok": bool(loaded or built)}
    except Exception:
        return {}
    return out


def _uapi_lines(iface):
    """Raw UAPI `get=1` response lines from a userspace wireguard-go/amneziawg-go socket, or [] if there is none.

    ONE reader for the two callers that each carried their own copy of the connect / send / read-until-errno
    loop — and the copies had drifted: this one searches every directory discovery accepts, the other hardcoded
    /var/run/wireguard, so an interface whose socket lives in /run/wireguard was invisible to it.
    """
    sock = next((p for p in (os.path.join(d, iface + ".sock") for d in WG_SOCK_DIRS) if os.path.exists(p)), "")
    if not sock:
        return []
    with contextlib.suppress(Exception):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(2)
        s.connect(sock)
        s.sendall(b"get=1\n\n")
        data = b""
        while b"errno=" not in data:
            c = s.recv(8192)
            if not c:
                break
            data += c
        s.close()
        return data.decode("utf-8", "replace").splitlines()
    return []


def _uapi_probe(iface):
    """(listen_port, peer_count) for an adoption candidate — works when the CLI can't read the socket."""
    port = 0; peers = 0
    for line in _uapi_lines(iface):
        if line.startswith("listen_port="):
            with contextlib.suppress(ValueError):
                port = int(line.split("=", 1)[1] or "0")
        elif line.startswith("public_key="):
            peers += 1
    return port, peers

# Where wg / awg / WDTT actually live on a box we did NOT set up. Discovery used to look only where WE install,
# so an interface configured by a distro package, by hand, or by an upstream installer was invisible — and an
# adoption flow that can't see the thing it exists to adopt is useless. Keep these lists as the single source of
# truth for every scan (conf lookup, candidate enumeration, WDTT probing).
WG_CONF_DIRS  = ("/etc/wireguard", "/usr/local/etc/wireguard")
AWG_CONF_DIRS = ("/etc/amnezia/amneziawg", "/etc/amneziawg", "/usr/local/etc/amneziawg", "/etc/amnezia")
WG_SOCK_DIRS  = ("/var/run/wireguard", "/run/wireguard")   # wireguard-go/amneziawg-go UAPI sockets
# Every fork's -config-dir default, plus the usual hand-install spots. wg-keys.dat here == a WDTT identity.
WDTT_CFG_DIRS = ("/etc/wdtt", "/opt/wdtt", "/var/lib/wdtt", "/usr/local/etc/wdtt")
# The interface an UNPATCHED upstream build serves. OUR builds take -iface; the authors' do not register the flag
# at all (ildarmaga compiles wgIfaceName = "wdtt0", alongside a hardcoded 10.66.66.1/24 and :2860 admin surface),
# which is also why only one upstream server can run per host.
WDTT_DEFAULT_IFACE = "wdtt0"
_WDTT_HOSTPROC = {"at": 0.0, "rows": []}    # docker: cached HOST /proc walk (see _wdtt_host_procs)
_WDTT_CFGPROBE = {}                          # docker: cfgdir -> (ts, {...}) cached host-side file probe
_WDTT_HOST_TTL = 45                          # each host probe is a privileged one-shot container — never per-5s


def _awg_conf_dirs():
    """AWG_CONF_DIRS plus every subdirectory of /etc/amnezia (the Amnezia installers use one per product)."""
    dirs = list(AWG_CONF_DIRS)
    with contextlib.suppress(Exception):
        for sub in os.listdir("/etc/amnezia"):
            d = "/etc/amnezia/" + sub
            if os.path.isdir(d) and d not in dirs:
                dirs.append(d)
    return dirs


def _cand_conf(name):
    """Path to an on-disk conf for this interface, searched across every conventional location. '' if none."""
    for d in _awg_conf_dirs() + list(WG_CONF_DIRS):
        p = os.path.join(d, name + ".conf")
        if os.path.isfile(p):
            return p
    return ""


def _conf_has_awg(path):
    """Does this conf carry AmneziaWG obfuscation knobs? Near-definitive — plain wg-quick rejects these keys."""
    with contextlib.suppress(Exception):
        for ln in open(path):
            if re.match(r"\s*(Jc|Jmin|Jmax|S[1-4]|H[1-4]|I[1-5])\s*=\s*\S", ln):
                return True
    return False


def _conf_is_awg(path):
    """Does this conf path sit in an AmneziaWG location? (drives proto, and awg confs also carry Jc/S1 knobs)"""
    return any(os.path.dirname(path) == d for d in _awg_conf_dirs())


def _wdtt_is_server(flags):
    """Is this argv a WDTT server AT ALL? _wdtt_procs deliberately casts a wide net (argv[0] containing "server"
    or "wdtt") because the forks name their binaries inconsistently — but the turn-proxies are literally called
    `turn-server`. Without this check every one of them looked like a WDTT server that simply hadn't been given
    -iface, and _wdtt_iface_of then attributed it to the DEFAULT interface: the foreign lookup for wdtt0 returned
    a TURN-PROXY, the panel offered its port as "currently" the one to adopt, and the adopt would have signalled
    it. A turn-proxy carries -connect/-obf-*/-wrap-*; none of the flags below, and no "wdtt" in its path."""
    if "wdtt" in (flags.get("_exe") or "").lower():
        return True
    return any((flags.get(k) or "").strip() for k in ("iface", "config-dir", "wg-port", "wg-addr", "desired"))


def _wdtt_iface_of(flags):
    """The interface a WDTT server owns. OUR builds pass -iface; the AUTHORS' upstream builds hardcode it and
    register no such flag, so a genuinely foreign server has no -iface at all. Matching on the flag alone meant the
    foreign lookup could only ever find WDTT we had deployed ourselves — i.e. never the case it exists for."""
    return (flags.get("iface") or "").strip() or WDTT_DEFAULT_IFACE


def _wdtt_foreign_proc(iface):
    """(pid, flags) of a WDTT server on this interface that we do NOT supervise — ({}/None when there is none.
    Returns the FLAGS too: on a docker node they come from the host's pid namespace, so the caller must not try to
    re-read /proc/<pid> itself (that pid does not exist in this container)."""
    ours = set()
    with contextlib.suppress(Exception):
        ours = {p.pid for p in _WDTT_PROCS.values() if p is not None}
    for pid, flags in _wdtt_procs():
        if pid not in ours and _wdtt_iface_of(flags) == iface:
            return pid, flags
    return None, {}


def _wdtt_flags_from_argv(parts):
    """{flag: value} from an argv list (`-flag value` pairs) + argv[0]. Shared by the local /proc reader and the
    docker host-namespace walk, so both understand a cmdline identically."""
    out = {"_exe": parts[0] if parts else ""}
    i = 1
    while i < len(parts):
        if parts[i].startswith("-"):
            key = parts[i].lstrip("-")
            if i + 1 < len(parts) and not parts[i + 1].startswith("-"):
                out[key] = parts[i + 1]; i += 2; continue
            out[key] = "true"
        i += 1
    return out


def _wdtt_cmdline_flags(pid):
    """{flag: value} from a LOCAL process cmdline + argv[0]."""
    out = {"_exe": ""}
    with contextlib.suppress(Exception):
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            parts = [p.decode("utf-8", "replace") for p in f.read().split(b"\x00") if p]
        out = _wdtt_flags_from_argv(parts)
    with contextlib.suppress(Exception):
        out["_exe"] = os.readlink("/proc/%d/exe" % pid) or out["_exe"]
        out["_cwd"] = os.readlink("/proc/%d/cwd" % pid) or ""
    return out


def _wdtt_unit_of_pid(pid, host_ns=False):
    """The service unit a process belongs to, '' when it isn't service-managed. Read from its cgroup line, on the
    HOST when the pid lives there (docker). Adoption needs this because a foreign WDTT server is normally a
    SERVICE: killing the process alone leaves its manager to restart it."""
    txt = ""
    if host_ns or NODE_KIND == "docker":
        txt = (host_sh("cat /proc/%d/cgroup 2>/dev/null; :" % int(pid), timeout=20).stdout or "")
    else:
        with contextlib.suppress(Exception):
            with open("/proc/%d/cgroup" % int(pid)) as f:
                txt = f.read()
    for ln in txt.splitlines():
        seg = ln.strip().rsplit("/", 1)[-1]
        if seg.endswith(".service"):
            return seg
    return ""


def _wdtt_flags_host(pid):
    """Flags for ONE pid in the HOST's pid namespace (docker) — the same base64 hand-off as _wdtt_host_procs,
    but never cached: this backs the re-verify taken immediately before we signal, where a stale answer is the
    difference between stopping the foreign server and killing whatever inherited its pid."""
    out = {}
    with contextlib.suppress(Exception):
        b64 = (host_sh("base64 -w0 < /proc/%d/cmdline 2>/dev/null" % int(pid), timeout=20).stdout or "").strip()
        if b64:
            parts = [x.decode("utf-8", "replace") for x in base64.b64decode(b64).split(b"\x00") if x]
            if parts:
                out = _wdtt_flags_from_argv(parts)
    return out


def _wdtt_host_procs():
    """WDTT servers in the HOST's pid namespace — docker only. This container has no pid:host, so a foreign server
    running on the host is invisible to a local /proc walk and could never be adopted. host_sh reaches it, but each
    call spawns a privileged one-shot container, so the result is cached: the foreign lookup runs per candidate per
    5s snapshot, and paying a container for each of those would be ruinous.
    cmdline goes over as base64 — an argv with spaces or newlines must survive the trip intact."""
    now = time.time()
    if now - _WDTT_HOSTPROC["at"] < _WDTT_HOST_TTL:
        return _WDTT_HOSTPROC["rows"]
    rows = []
    with contextlib.suppress(Exception):
        cmd = ("for p in /proc/[0-9]*; do c=$p/cmdline; [ -r \"$c\" ] || continue; "
               "case \"$(head -c 200 \"$c\" | tr '\\0' ' ')\" in *wdtt*|*server*) "
               "printf '%s ' \"${p#/proc/}\"; base64 -w0 < \"$c\"; echo ;; esac; done")
        for ln in (host_sh(cmd, timeout=30).stdout or "").splitlines():
            pid, _, b64 = ln.strip().partition(" ")
            if not pid.isdigit() or not b64:
                continue
            with contextlib.suppress(Exception):
                parts = [x.decode("utf-8", "replace") for x in base64.b64decode(b64).split(b"\x00") if x]
                if parts and ("wdtt" in parts[0] or "server" in parts[0]):
                    rows.append((int(pid), _wdtt_flags_from_argv(parts)))
    _WDTT_HOSTPROC["at"] = now
    _WDTT_HOSTPROC["rows"] = rows
    return rows


def _wdtt_unit_ports(execstart):
    """(listen, wg_port) parsed out of a unit's ExecStart. A STOPPED server has no argv to read, but the unit
    that starts it is right there on disk and is authoritative about the ports its clients already dial."""
    with contextlib.suppress(Exception):
        parts = [p for p in shlex.split(execstart or "") if p]
        f = _wdtt_flags_from_argv(parts)
        return (f.get("listen") or "").strip(), str(f.get("wg-port") or "").strip()
    return "", ""


def _wdtt_inbound_ports_local(cfgdir):
    """(dtls, wg) from ildarmaga's own panel.db `wdtt_inbound` row — the fork records what it listens on, which
    survives a stop. amurcanov keeps nothing equivalent, hence the unit fallback."""
    dbp = os.path.join(cfgdir, "panel.db")
    if not os.path.isfile(dbp):
        return "", ""
    with contextlib.suppress(Exception):
        import sqlite3
        c = sqlite3.connect(dbp, timeout=5)
        try:
            for d, w in c.execute("SELECT dtls_port, wg_port FROM wdtt_inbound LIMIT 1"):
                return (str(d or "").strip(), str(w or "").strip())
        finally:
            c.close()
    return "", ""


def _wdtt_users_local(cfgdir):
    """The users a WDTT config-dir holds, as NON-SECRET rows for the adoption UI — never the password itself
    (the panel stays blind to credentials until the operator actually adopts). Both store layouts, same shape:
    a user that has never connected still gets a row, because "3 issued, 1 ever connected" is exactly what an
    operator needs before taking a server over — and the interface can only ever show the connected one."""
    out = []
    dbp = os.path.join(cfgdir, "panel.db")
    if os.path.isfile(dbp):
        with contextlib.suppress(Exception):
            import sqlite3
            c = sqlite3.connect(dbp, timeout=5)
            try:
                for lbl, did, exp, deact, dn, up, vkh, seen, ports in c.execute(
                        "SELECT comment, device_id, expires_at, is_deactivated, down_bytes, up_bytes,"
                        " vk_hash, last_seen_at, ports FROM wdtt_users"):
                    out.append({"label": (lbl or "").strip()[:60], "bound": bool((did or "").strip()),
                                "last_seen": int(seen or 0), "expires_at": int(exp or 0),
                                "disabled": bool(deact), "vk": bool((vkh or "").strip()),
                                "down_bytes": int(dn or 0), "up_bytes": int(up or 0), "ports": str(ports or "")})
            finally:
                c.close()
        return out
    pj = os.path.join(cfgdir, "passwords.json")
    if os.path.isfile(pj):
        with contextlib.suppress(Exception):
            with open(pj) as f:
                raw = json.load(f) or {}
            devs = raw.get("devices") or {}
            for _pw, e in (raw.get("passwords") or {}).items():
                e = e if isinstance(e, dict) else {}
                _did = str(e.get("device_id") or "").strip()
                out.append({"label": "", "bound": bool(_did), "last_seen": int(e.get("last_seen_at") or 0),
                            "expires_at": int(e.get("expires_at") or 0),
                            "disabled": bool(e.get("is_deactivated")), "vk": bool(str(e.get("vk_hash") or "").strip()),
                            "down_bytes": int(e.get("down_bytes") or 0), "up_bytes": int(e.get("up_bytes") or 0),
                            "ports": str(e.get("ports") or ""),
                            "ip": str(((devs.get(_did) or {}) if _did else {}).get("ip") or "")})
    return out


def _wdtt_cfg_probe(cfg):
    """{'id': bool, 'store': str, 'users': [...]} for a config-dir — does it hold an identity (wg-keys.dat),
    which store, and the NON-SECRET rows of that store (never the passwords).
    A FOREIGN server's config-dir lives on the HOST, so on a docker node os.path.isfile() here always says no and
    every foreign WDTT reported adoptable=False. One batched host probe, cached like the proc walk."""
    now = time.time()
    hit = _WDTT_CFGPROBE.get(cfg)
    if hit and now - hit[0] < _WDTT_HOST_TTL:
        return hit[1]
    if NODE_KIND != "docker":
        res = {"id": os.path.isfile(os.path.join(cfg, "wg-keys.dat")),
               "store": ("panel.db" if os.path.isfile(os.path.join(cfg, "panel.db")) else
                         ("passwords.json" if os.path.isfile(os.path.join(cfg, "passwords.json")) else "")),
               "users": _wdtt_users_local(cfg), "inbound_ports": _wdtt_inbound_ports_local(cfg),
               "unit_listen": "", "unit_wg_port": ""}
        with contextlib.suppress(Exception):
            _udir = "/etc/systemd/system"
            for _un in sorted(x for x in os.listdir(_udir) if x.endswith(".service")):
                _u = os.path.join(_udir, _un)
                _txt = open(_u, errors="replace").read()
                if ("config-dir " + cfg) not in _txt:
                    continue
                for _l in _txt.splitlines():
                    if _l.startswith("ExecStart="):
                        res["unit_listen"], res["unit_wg_port"] = _wdtt_unit_ports(_l.split("=", 1)[1])
                        break
                break
    else:
        res = {"id": False, "store": "", "users": [], "inbound_ports": ("", ""), "unit_listen": "", "unit_wg_port": ""}
        with contextlib.suppress(Exception):
            # The trailing `; :` keeps the probe's exit status at 0 whatever happens. It is a QUESTION, not an
            # assertion: "no passwords.json" exited 1 and "the dir is gone" exited 2, so a probe that had
            # answered perfectly logged `rc=1`/`rc=2` every single cycle — burying the real WDTT log lines.
            # It must sit OUTSIDE the `&&` to also cover the failing `cd`.
            # The store rides back base64'd in the SAME batched call — one privileged container per 45s, not
            # one per question. Size-capped: this is a probe, not a backup, and a store big enough to matter is
            # better answered after adoption than by shipping it through a shell.
            _cmd = (("cd %s 2>/dev/null && { [ -f wg-keys.dat ] && echo id; [ -f panel.db ] && echo panel.db; "
                     "[ -f passwords.json ] && echo passwords.json; "
                     "for f in passwords.json panel.db panel.db-wal; do [ -f \"$f\" ] || continue; "
                     "[ $(stat -c %%s \"$f\") -gt 8388608 ] && continue; "
                     "printf 'B64:%%s ' \"$f\"; base64 -w0 < \"$f\"; echo; done; }; "
                     # the unit that STARTS this config dir carries the ports a stopped server can't tell us
                     "for u in /etc/systemd/system/*.service; do [ -f \"$u\" ] || continue; "
                     "grep -q -- %s \"$u\" 2>/dev/null || continue; "
                     "printf 'EXEC:'; grep -h '^ExecStart=' \"$u\" | head -1; done; :")
                    % (shlex.quote(cfg), shlex.quote("config-dir " + cfg)))
            raw = (host_sh(_cmd, timeout=40).stdout or "")
            flags = [ln for ln in raw.split() if not ln.startswith("B64:") and not ln.startswith("EXEC:")]
            for _ln in raw.splitlines():
                if _ln.startswith("EXEC:"):
                    res["unit_listen"], res["unit_wg_port"] = _wdtt_unit_ports(_ln[5:].split("=", 1)[-1])
                    break
            res["id"] = "id" in flags
            res["store"] = "panel.db" if "panel.db" in flags else ("passwords.json" if "passwords.json" in flags else "")
            _blobs = {}
            for _ln in raw.splitlines():
                if not _ln.startswith("B64:"):
                    continue
                _name, _, _b64 = _ln[4:].partition(" ")
                if _name and _b64:
                    with contextlib.suppress(Exception):
                        _blobs[_name] = base64.b64decode(_b64)
            if _blobs:
                _tmp = "/tmp/swg-wdtt-probe-" + hashlib.sha1(cfg.encode()).hexdigest()[:8]
                shutil.rmtree(_tmp, ignore_errors=True)
                os.makedirs(_tmp, mode=0o700, exist_ok=True)
                try:
                    for _n, _b in _blobs.items():
                        with open(os.path.join(_tmp, _n), "wb") as _fh:
                            _fh.write(_b)
                    res["users"] = _wdtt_users_local(_tmp)
                    res["inbound_ports"] = _wdtt_inbound_ports_local(_tmp)
                finally:
                    shutil.rmtree(_tmp, ignore_errors=True)
    _WDTT_CFGPROBE[cfg] = (now, res)
    return res

def _wdtt_guess_fork(exe, cfgdir):
    """Best-effort fork id for a FOREIGN WDTT: our own binary path → exact; else the config-dir layout
    (panel.db = ildarmaga, passwords.json = amurcanov-family); else the binary's own -h flag signature.
    Never authoritative — the panel's adopt modal always lets the operator confirm/override it."""
    for fk in WDTT_FORK_OWNER:
        if ("/" + fk + "/") in (exe or ""):
            return fk
    # Host-aware: a FOREIGN server's config-dir is on the HOST, so os.path.isfile() from inside a container always
    # said no. The layout check then fell through, the -h probe below tried to exec a host path that doesn't exist
    # in here, and the fork came back "" — which the panel renders as its DEFAULT, amurcanov. An upstream ildarmaga
    # server was therefore adopted and labelled as a different author's fork.
    _store = _wdtt_cfg_probe(cfgdir)["store"] if cfgdir else ""
    if _store == "panel.db":
        return "ildarmaga"
    # ONE exec, not two: this runs per unmanaged candidate on every 5s snapshot, and `run` blocks — two hung
    # execs of a foreign binary stalled the sync loop for up to 12s before the snapshot was even posted. Skip it
    # entirely when there's no executable to ask (the dormant scan passes exe="").
    # Nothing to exec (dormant scan), or a docker node where `exe` is a HOST path that does not resolve in here —
    # asking it for -h would just burn the 6s timeout per candidate, per snapshot.
    if not exe or NODE_KIND == "docker":
        return "amurcanov" if _store == "passwords.json" else ""
    h = ""
    with contextlib.suppress(Exception):
        _r = run([exe, "-h"], timeout=6)
        h = (_r.stderr or "") + (_r.stdout or "")
    if "-admin-addr" in h:
        return "ildarmaga"
    if "-no-panel" in h:
        return "wdttplus"
    return "amurcanov" if _store == "passwords.json" else ""

def _wdtt_procs():
    """Every WDTT server process on this box → [(pid, argv-flags)]. ONE /proc walk shared by the callers that
    used to each do their own — the foreign-server lookup (per candidate, per 5s snapshot) and the dormant scan."""
    out = []
    with contextlib.suppress(Exception):
        for ent in os.listdir("/proc"):
            if not ent.isdigit():
                continue
            with contextlib.suppress(Exception):
                with open("/proc/%s/cmdline" % ent, "rb") as f:
                    parts = f.read().split(b"\x00")
                if not parts or not parts[0] or not (b"server" in parts[0] or b"wdtt" in parts[0]):
                    continue
                out.append((int(ent), _wdtt_cmdline_flags(int(ent))))
    # DOCKER: the walk above only sees THIS container's pid namespace — our own supervised children. A foreign
    # server runs on the host and would be invisible, so merge the (cached) host-namespace walk. Host pids can't
    # collide with container-local ones here because the local set is only ever our own _WDTT_PROCS children.
    if NODE_KIND == "docker":
        _seen = {p for p, _ in out}
        out.extend((p, f) for p, f in _wdtt_host_procs() if p not in _seen)
    # One choke point for "is this actually WDTT": the argv[0] net above is deliberately wide, and everything
    # downstream (foreign lookup, dormant scan, live config-dirs) treats what it returns as a WDTT server.
    return [(p, f) for p, f in out if _wdtt_is_server(f)]


def _wdtt_live_cfgdirs():
    """Config directories of every WDTT server currently RUNNING here — ours and foreign alike."""
    dirs = set()
    with contextlib.suppress(Exception):
        for ifn in (_wdtt_load() or {}):
            dirs.add(os.path.realpath(_wdtt_dir(ifn)))
    for _pid, flags in _wdtt_procs():
        cd = (flags.get("config-dir") or "").strip()
        if cd:
            with contextlib.suppress(Exception):
                dirs.add(os.path.realpath(cd))
    return dirs


def wdtt_dormant():
    """WDTT installs sitting on disk with NOTHING running — the one real server we'd otherwise miss entirely.

    A WDTT server owns its TUN, so when it's stopped there is no interface, no UAPI socket and no process: it
    can't appear as an adoption candidate, and the operator sees nothing at all where a real server lives. But a
    wg-keys.dat in one of the fork config directories is unambiguous evidence of an install. Report those (with
    the fork guessed from the store layout) so the panel can say "start it, then adopt" instead of staying silent.
    Report-only — nothing is started, moved or touched."""
    live = _wdtt_live_cfgdirs()
    out = []
    for d in WDTT_CFG_DIRS:
        with contextlib.suppress(Exception):
            # Host-aware, like every other foreign lookup: a foreign install lives on the HOST, so on a docker
            # node os.path.isfile() here answered "no" for every one of them. A RUNNING foreign server was still
            # found (the proc walk crosses the namespace), but a STOPPED one — the exact case this function
            # exists for — was invisible and unadoptable. _wdtt_cfg_probe already crosses it, and is cached.
            probe = _wdtt_cfg_probe(d)
            if not probe["id"] or os.path.realpath(d) in live:
                continue
            store = probe["store"]
            # Ports ARE recoverable from a stopped install: the password store records the ports each password
            # was issued for ("<dtls>,<wg>,…"), so a server with at least one user tells us what it was listening
            # on. The SUBNET is not — client addresses are derived at runtime and never written — and the public
            # endpoint never lived here at all (the server binds 0.0.0.0; what clients dial is a property of the
            # network). So prefill what the files actually know and ask for the rest.
            # Ports for a STOPPED server, best source first. They are runtime flags, so they are not in the
            # config dir — but "we can't know them" was too quick: the unit that starts it spells them out, and
            # ildarmaga records them in its own store. Only ask the operator once all three come up empty; a
            # wrong port here means every existing client dials a server that is no longer listening.
            lp = wp = 0
            with contextlib.suppress(Exception):                       # 1) the service unit's ExecStart
                _ul = str(probe.get("unit_listen") or "").rsplit(":", 1)[-1]
                if _ul.isdigit():
                    lp = int(_ul)
                if str(probe.get("unit_wg_port") or "").isdigit():
                    wp = int(probe["unit_wg_port"])
            with contextlib.suppress(Exception):                       # 2) the fork's own inbound record
                if not (lp and wp):
                    _d, _w = probe.get("inbound_ports") or ("", "")
                    if not lp and str(_d).isdigit(): lp = int(_d)
                    if not wp and str(_w).isdigit(): wp = int(_w)
            with contextlib.suppress(Exception):                       # 3) the ports a password was issued for
                if not (lp and wp):
                    for _e in (probe.get("users") or []):
                        _ports = [p for p in str((_e or {}).get("ports") or "").split(",") if p.strip().isdigit()]
                        if len(_ports) >= 2:
                            lp, wp = lp or int(_ports[0]), wp or int(_ports[1]); break
            _at = 0
            with contextlib.suppress(Exception):
                _at = int(os.path.getmtime(os.path.join(d, "wg-keys.dat")))   # local only; 0 on docker (host path)
            out.append({"config_dir": d, "store": store,
                        "fork": _wdtt_guess_fork("", d),
                        "listen_port": lp, "wg_port": wp,
                        "users": probe.get("users") or [],    # non-secret rows, so the adopt UI can show WHO is on it
                        "at": _at})
    return out


def wdtt_foreign_probe(iface):
    """Can this FOREIGN (panel-unmanaged) WDTT interface be adopted? Locates its running server, its config-dir
    (explicit -config-dir → the fork default /etc/wdtt → the process cwd) and its identity file, and guesses the
    fork. Returns NON-SECRET metadata only — never the owner password or key material (the panel stays blind; the
    node re-reads those locally at adopt time). None when it isn't a locatable WDTT server.
    `adoptable` is False when the identity (wg-keys.dat) can't be found: adopting would mint a FRESH server key and
    break every existing client, so the panel offers Ignore instead."""
    # Take the flags the lookup already resolved — on docker they come from the HOST's pid namespace, so
    # re-reading /proc/<pid> from inside this container would find nothing and blank every field.
    pid, f = _wdtt_foreign_proc(iface)
    if not pid:
        return None
    # An explicit -config-dir is AUTHORITATIVE, even when it holds no identity — that just means this server
    # isn't adoptable. Searching on past it would attribute another server's wg-keys.dat to this one, report it
    # as adoptable, and then seed the adoption with the wrong identity: every client of BOTH servers breaks.
    # Only guess when the process didn't say (an upstream run with no flag lands in one of the defaults).
    cfg = (f.get("config-dir") or "").strip()
    if not cfg:
        for cand in list(WDTT_CFG_DIRS) + [f.get("_cwd") or ""]:
            if cand and _wdtt_cfg_probe(cand)["id"]:
                cfg = cand; break
        else:
            cfg = WDTT_CFG_DIRS[0]
    probe = _wdtt_cfg_probe(cfg)          # host-aware: a foreign config-dir lives on the HOST, not in this container
    # -wg-addr, like -iface, is OUR flag: the authors' builds compile the subnet in (ildarmaga hardcodes
    # 10.66.66.1/24) and register nothing to read it from. argv therefore yields "" for a genuinely foreign
    # server and adoption refused it — "this server's tunnel subnet isn't an IPv4 CIDR: (none)" — for a value
    # sitting on the live interface all along. The running device is the authority; argv is only a hint.
    _wa = (f.get("wg-addr") or "").strip()
    if not _wa:
        with contextlib.suppress(Exception):
            for ln in (run(["ip", "-4", "-o", "addr", "show", iface]).stdout or "").splitlines():
                _p = ln.split()
                if len(_p) >= 4 and _p[2] == "inet":
                    _wa = _p[3]; break
    return {"pid": pid, "fork": _wdtt_guess_fork(f.get("_exe") or "", cfg), "config_dir": cfg,
            "listen": f.get("listen") or "", "wg_port": f.get("wg-port") or "", "wg_addr": _wa,
            "max_passwords": f.get("max-passwords") or "", "has_identity": probe["id"], "adoptable": bool(probe["id"]),
            # Non-secret rows from its own store, so the adoption UI can list EVERY issued user — the interface
            # only knows the ones that have connected, which undercounts what the operator is taking on.
            "users": probe.get("users") or [],
            "store": probe["store"]}

def iface_candidates(node_cfg):
    """wg/awg interfaces present on this box that this node does NOT manage — Approach-B adoption candidates for the
    panel to classify (WG / AWG / WDTT) or ignore. REPORT ONLY — nothing is touched (a kernel interface stays on the
    kernel until the operator adopts it). Each: name, proto (wg|awg), datapath (kernel|userspace), listen_port,
    address, peers, up, wdtt_hint (an unmanaged userspace wg iface is most likely a WDTT server's)."""
    managed = set((node_cfg.get("interfaces") or {}).keys())
    local_wdtt = {}
    with contextlib.suppress(Exception):
        local_wdtt = _wdtt_load() or {}
    # Only WDTT the PANEL manages is "ours". One carried over by a convert onto a panel that has never seen it is
    # exactly an adoption candidate — and since reconcile_wdtt now preserves those instead of deleting them, this
    # is what makes them visible; otherwise they'd survive on disk and appear nowhere.
    managed |= set(k for k, v in local_wdtt.items() if (v or {}).get("panel_managed"))
    names_wdtt = set(k for k in local_wdtt if k not in managed)
    names = set(names_wdtt)                                  # unadopted local WDTT instances are candidates too
    for tool in (["wg"], ["awg"]):                           # kernel + any userspace socket the CLI can read
        with contextlib.suppress(Exception):
            r = run(_wgcmd(tool) + ["show", "interfaces"])
            if r.returncode == 0:
                names.update((r.stdout or "").split())
    for _d in WG_SOCK_DIRS:                                  # userspace wireguard-go the CLI can't read
        with contextlib.suppress(Exception):
            for f in os.listdir(_d):
                if f.endswith(".sock"):
                    names.add(f[:-5])
    # A FOREIGN WDTT server's interface is invisible to every source above: it writes no .conf, and on a docker node
    # the wg CLI can't see it either (the host's UAPI socket dir isn't mounted) — so an adoption flow that exists to
    # surface it listed everything EXCEPT it. The running process is the authority on which interface it owns.
    for _pid, _fl in _wdtt_procs():
        with contextlib.suppress(Exception):
            names.add(_wdtt_iface_of(_fl))
    for _d in _awg_conf_dirs() + list(WG_CONF_DIRS):         # confs on disk (a down interface is adoptable too)
        with contextlib.suppress(Exception):
            for f in os.listdir(_d):
                if f.endswith(".conf"):
                    names.add(f[:-5])                        # ".conf" is 5 chars — [:-4] leaves a trailing dot
    ipmap = {}
    with contextlib.suppress(Exception):
        for ln in (run(["ip", "-4", "-o", "addr", "show"]).stdout or "").splitlines():
            p = ln.split()
            if len(p) >= 4 and p[2] == "inet":
                ipmap.setdefault(p[1], p[3])
    out = []
    for name in sorted(names):
        if not name or name in managed or name.startswith("swg_"):
            continue
        userspace = any(os.path.exists(os.path.join(_d, name + ".sock")) for _d in WG_SOCK_DIRS)
        conf = _cand_conf(name)
        proto = "awg" if (conf and _conf_is_awg(conf)) else "wg"
        if not conf:
            with contextlib.suppress(Exception):
                if "amneziawg" in (run(["ip", "-d", "-o", "link", "show", name]).stdout or ""):
                    proto = "awg"
        port = 0; peers = 0; up = False; ent_peers = []; awg_live = False
        # Try BOTH tools, preferred one first. `wg` and `awg` each only speak to their own datapath, and the proto
        # guess above is just a guess: a confless interface reports "tun type tun" when it is userspace, so an
        # AmneziaWG device would be dumped with `wg`, fail, and be reported as an empty interface with no peers.
        # Whichever tool answers is also the authoritative proto.
        for _tool in (["awg"], ["wg"]) if proto == "awg" else (["wg"], ["awg"]):
            with contextlib.suppress(Exception):
                r = run(_wgcmd(_tool) + ["show", name, "dump"])
                if r.returncode == 0 and (r.stdout or "").strip():
                    lines = r.stdout.strip().splitlines(); f0 = lines[0].split("\t")
                    if len(f0) >= 3:
                        with contextlib.suppress(ValueError):
                            port = int(f0[2])
                    # Obfuscation knobs, straight from the live device — the ONE signal that cannot be a false
                    # positive: a plain WireGuard interface has no Jc/S1/H* to report. A `wg` dump is exactly
                    # [priv, pub, port, fwmark], so anything longer means the tool emitted awg fields; fwmark is
                    # the last one and is excluded, or a plain interface with a fwmark set would read as AWG.
                    if len(f0) > 4:
                        for _v in f0[3:-1]:
                            if _v and _v not in ("0", "off") and (_v[0].isdigit() or _v[0] == "-"):
                                awg_live = True; break
                    peers = max(0, len(lines) - 1); up = True
                    # The operator is deciding whether to adopt this thing, so show them WHAT is on it, not just a
                    # count. Non-secret fields only — the PSK parse_dump keeps for adoption is dropped here, since
                    # this rides to the browser in /api/state. Capped: a peer list is unbounded and this is a
                    # preview, not the roster it becomes after adoption.
                    with contextlib.suppress(Exception):
                        _, _pl = parse_dump(r.stdout)
                        ent_peers = [{"public_key": p["public_key"], "allowed_ips": p["allowed_ips"],
                                      "endpoint": p["endpoint"], "last_handshake": p["last_handshake"],
                                      "rx_bytes": p["rx_bytes"], "tx_bytes": p["tx_bytes"]} for p in _pl[:200]]
                    if not conf:                            # no conf to trust — believe the tool that answered
                        proto = "awg" if _wgcmd(_tool) == ["awg"] else "wg"
                    break
        if not up and userspace:                            # userspace socket the CLI can't read → UAPI
            port, peers = _uapi_probe(name); up = True
        addr = ipmap.get(name, "")
        if name in names_wdtt:                              # fill from OUR record — a stopped WDTT has no live iface
            _lw = local_wdtt.get(name) or {}
            if not port:
                with contextlib.suppress(Exception):
                    port = int(str(_lw.get("listen") or "").rsplit(":", 1)[-1] or 0)
            if not addr:
                addr = _lw.get("wg_addr") or ""
        if conf and (port == 0 or not addr):                # fill from the on-disk conf (down interface still counts)
            with contextlib.suppress(Exception):
                for ln in open(conf):
                    m = re.match(r"\s*ListenPort\s*=\s*(\d+)", ln)
                    if m and not port:
                        port = int(m.group(1))
                    m = re.match(r"\s*Address\s*=\s*([0-9./,]+)", ln)
                    if m and not addr:
                        addr = m.group(1).split(",")[0].strip()
        ent = {"name": name, "proto": proto, "datapath": "userspace" if userspace else "kernel",
               "listen_port": port, "address": addr, "peers": peers, "up": bool(up),
               "wdtt_hint": bool(userspace or name in names_wdtt),
               "peer_list": ent_peers,
               "conf": conf}
        # Which type should the adopt sheet PRESELECT? Rank by how badly a wrong guess hurts, and only ever
        # preselect on evidence that cannot be coincidence. Deliberately NOT used: "the awg tool answered the
        # dump" — on a box where the amneziawg module backs everything it answers for plain WireGuard interfaces
        # too, which is precisely the false positive to avoid.
        _why = ""
        if awg_live:
            _hint, _why = "awg", "obfuscation parameters are set on the interface"
        elif conf and _conf_has_awg(conf):
            _hint, _why = "awg", "its config carries AmneziaWG parameters"
        elif conf and _conf_is_awg(conf):
            _hint, _why = "awg", "its config is in an AmneziaWG directory (" + os.path.dirname(conf) + ")"
        else:
            _hint = "wg"
        ent["type_hint"], ent["type_why"] = _hint, _why   # abs conf path (if any) — the panel passes it back to /api/iface/onboard to adopt
        # ALWAYS probe — a running server bound to `-iface <name>` is the authoritative signal, and the socket is
        # not. Gating this on `userspace` missed a WDTT server on a kernel interface, one whose fork writes no UAPI
        # socket, and one whose socket sits outside the node's mount namespace — and the interface was then offered
        # as plain WireGuard, which is worse than missing it: adopting it that way fights the live WDTT server for
        # the same device. The probe is a /proc scan, so it costs nothing when there is no such process.
        with contextlib.suppress(Exception):
            fp = wdtt_foreign_probe(name)
            if fp:
                ent["wdtt"] = {k: fp[k] for k in ("fork", "config_dir", "listen", "wg_port", "wg_addr",
                                                  "max_passwords", "has_identity", "adoptable", "store")}
                ent["wdtt_hint"] = True
                ent["type_hint"] = "wdtt"
                ent["type_why"] = "a WDTT server (" + (fp.get("fork") or "unknown fork") + ") is running on it"
                if not ent["listen_port"]:                  # a stopped/kernel iface still knows its ports from argv
                    with contextlib.suppress(Exception):
                        ent["listen_port"] = int(str(fp.get("listen") or "").rsplit(":", 1)[-1] or 0)
                if not ent["address"]:
                    ent["address"] = fp.get("wg_addr") or ""
        out.append(ent)
    return out

def build_snapshot(node_cfg, online_max, last_samples, now=None):
    now = now or int(time.time())
    hcfg = node_cfg.get("health") or {}
    interfaces = {}
    stopped_set = _load_stopped_ifaces()   # interfaces the operator deliberately stopped → "stopped", not "down"
    for iface, ic in (node_cfg.get("interfaces") or {}).items():
        cmd = _wgcmd(ic.get("cmd", ["awg"]))
        try:                                        # one bad interface must never kill the whole snapshot
            _r = run(cmd + ["show", iface, "dump"])
            if _r.returncode != 0:                  # interface isn't up — flag it, but still surface its
                try:                                # intended config from the .conf (subnet/awg/port/pubkey)
                    conf_text = open(ic["conf"]).read()
                except OSError:
                    conf_text = ""
                _meta = build_meta([], conf_text, ic.get("endpoint_host") or node_cfg.get("endpoint_host"),
                                   node_cfg.get("dns", []), cmd, iface)
                if iface in stopped_set:            # the operator stopped it — a choice, not a failure (no error)
                    interfaces[iface] = {"peers": [], "meta": _meta, "stopped": True}
                else:
                    interfaces[iface] = {"peers": [], "meta": _meta,
                        "down": ((_r.stderr or "").strip() or "interface is not up")[:140]}
                ensure_iface_backup(iface, conf_text, cmd)
                continue
            dump = _r.stdout
            iface_line, raw = parse_dump(dump)
            try:
                conf_text = open(ic["conf"]).read()
            except OSError:
                conf_text = ""
            st = last_samples.setdefault(iface, {"peers": {}, "t": now})
            dt = max(1e-6, now - st["t"])
            peers = peer_view(raw, st["peers"], dt, online_max, now)
            st["peers"] = {p["public_key"]: (p["rx_bytes"], p["tx_bytes"]) for p in raw}
            st["t"] = now
            interfaces[iface] = {
                "peers": peers,
                "meta": build_meta(iface_line, conf_text,
                                   ic.get("endpoint_host") or node_cfg.get("endpoint_host"),
                                   node_cfg.get("dns", []), cmd, iface),
            }
            if iface in stopped_set:               # it's up again (e.g. brought up outside the panel) → clear the stopped mark
                _set_iface_stopped(iface, False)
            ensure_iface_backup(iface, conf_text, cmd)
        except Exception as e:
            print(f"snapshot: skipping {iface}: {e}", flush=True)
            continue
    _addrs = _node_addrs()                         # one `ip -o addr show`, shared by the three derived views below
    _tps = load_turn_proxies()
    _tflags = {}                                   # Axis-1: per-fork flag discovery (`<binary> -h`), only where the panel manages turn (that's the only place the settings UI shows). Cached per (fork,version).
    if TURN_MANAGE:
        for _tp in _tps:
            _fk = _turn_fork(_tp.get("service") or "")
            if _fk and _fk not in _tflags:
                _tflags[_fk] = _turn_discover_flags(_tp.get("service") or "")
    snap = {"hostname": socket.gethostname(), "generated_at": now,
            "interfaces": interfaces, "turn_proxies": _tps, "turn_flags": _tflags,
            "arch": _turn_arch(),   # so the panel mirrors/pins ONLY this node's arch for a turn install (not both → no slow/failed cross-arch fetch)
            "turn_capable": _turn_arch_ok(),   # false ONLY when this box's arch has no server-linux-<arch> build → panel greys out "Setup proxy" (never blocks on uncertainty)
            "noded_version": NODED_VERSION, "kind": NODE_KIND, "net_mode": NODE_NET,
            "turn_manage": TURN_MANAGE, "cmd_errors": dict(NODE_ERRORS), "cmd_progress": dict(NODE_PROGRESS),
            # Informational, NOT failures: an adoption that succeeded but not from the source the operator named.
            # cmd_errors is the wrong channel for it (it renders as a failure and is cleared on success).
            "onboard_notes": dict(NODE_NOTES),
            "quarantined": op_quarantined(),   # ops in repeated-failure backoff — visible, not silently churning
            "node_ips": list_node_ips(_addrs), "node_ifaces": list_node_ifaces(_addrs),
            "node_ip_ifaces": list_node_ip_ifaces(_addrs), "smartroute": smart_status(),
            "datapath": node_datapath_health(),          # kernel datapath health (awg module loadable?) → panel node-repair "Fix" (bare-metal)
            "iface_key_backups": list_iface_backups(),   # {iface: pubkey} of on-disk key backups (restorability of MISSING ifaces)
            "transport_pub": transport_pub(),            # node re-seal target — the browser seals a restored key to this
            "iface_key_sealed": dict(_IVK_SEALED),       # {iface: {pub, eph, ct, mac}} interface keys sealed to the vault, pending upload
            "wdtt_key_sealed": dict(_WDTT_SEALED)}        # {iface: {pub(server_pub), ...}} WDTT server identities sealed to the vault, pending upload
    snap["wdtt"] = wdtt_snapshot()                    # WDTT instances: active + server pubkey + per-password device/traffic (read-back for the panel; no privkeys)
    snap["iface_candidates"] = iface_candidates(node_cfg)   # unmanaged wg/awg interfaces on the box → panel adoption candidates (report-only, untouched)
    snap["wdtt_dormant"] = wdtt_dormant()                   # WDTT installs on disk with nothing running (no iface to be a candidate)
    if hcfg.get("enabled", True):      # additive + opt-out; mounts default to ["/"]
        snap["health"] = collect_health(mounts=hcfg.get("mounts"))
    snap["inet"] = sample_inet(node_cfg, now)   # measured internet up/down (B/s); cached, refreshed off the 5s path
    snap["cat_rate"] = sample_cats()            # LIVE per-category throughput {cat:{up,dn}} B/s (latest push, delta of the nft counters)
    for _c, _v in sample_catk().items():        # + Kernel-SNI categories (swgk ipsets, invisible to the nft catcount) — add per cat
        _b = snap["cat_rate"].setdefault(_c, {"up": 0.0, "dn": 0.0})
        _b["up"] = _b.get("up", 0.0) + _v["up"]; _b["dn"] = _b.get("dn", 0.0) + _v["dn"]
    return snap


# ───────────────────────── reconcile ─────────────────────────

_UNSET = object()


def _iface_dump(node_cfg, iface):
    """One `<cmd> show <iface> dump` -> (iface_line, peers), or None if the interface can't be read (down /
    no such device). Lets a caller fetch the live interface ONCE and share it across current_pubkeys/
    current_allowed instead of shelling out per accessor every cycle."""
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    cmd = _wgcmd(ic.get("cmd", ["awg"]))
    try:
        r = run(cmd + ["show", iface, "dump"])
        if r.returncode != 0:
            return None
        return parse_dump(r.stdout)
    except Exception:
        return None


def current_pubkeys(node_cfg, iface, dump=_UNSET):
    if dump is _UNSET:                              # not pre-fetched → read it now
        dump = _iface_dump(node_cfg, iface)
    if dump is None:                               # interface down / no such device — NOT "zero peers"
        return None
    return {p["public_key"] for p in dump[1]}


def _norm_allowed(s):
    """Normalize an AllowedIPs string for comparison — sorted, deduped, whitespace-stripped CIDRs.
    (awg/wg may reorder the list, so a raw string compare would churn.)"""
    return ",".join(sorted({c.strip() for c in (s or "").split(",") if c.strip()}))


def current_allowed(node_cfg, iface, dump=_UNSET):
    """{pubkey -> normalized AllowedIPs} live on the interface, or None if it can't be read."""
    if dump is _UNSET:
        dump = _iface_dump(node_cfg, iface)
    if dump is None:
        return None
    return {p["public_key"]: _norm_allowed(p["allowed_ips"]) for p in dump[1]}


def current_endpoints(node_cfg, iface, dump=_UNSET):
    """{pubkey -> live 'ip:port' endpoint} on the interface, or None if it can't be read. Used to ADOPT a
    mesh dial-out peer already dialed to the desired endpoint after our applied_ep memory is lost (restart /
    docker convert) — so we neither re-add a duplicate (which the agent refuses) nor spin the reconcile."""
    if dump is _UNSET:
        dump = _iface_dump(node_cfg, iface)
    if dump is None:
        return None
    return {p["public_key"]: p.get("endpoint") for p in dump[1]}


MESH_STALE_S = 240   # a dial-out mesh peer silent this long (well past keepalive + the panel's 180s "down") is stuck → bounce
def current_handshakes(node_cfg, iface, dump=_UNSET):
    """{pubkey -> last-handshake unix ts (0 if never)} on the interface, or None if unreadable. Lets the
    reconcile detect a dial-out mesh peer that HAS connected but gone silent-stale (endpoint moved / NAT
    rebind / DPI) — WG dialing a fixed endpoint never recovers that on its own, so we bounce it."""
    if dump is _UNSET:
        dump = _iface_dump(node_cfg, iface)
    if dump is None:
        return None
    return {p["public_key"]: p.get("last_handshake") or 0 for p in dump[1]}


def current_listen_port(node_cfg, iface):
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    cmd = _wgcmd(ic.get("cmd", ["awg"]))
    try:
        r = run(cmd + ["show", iface, "dump"])
        if r.returncode == 0:
            iface_line, _ = parse_dump(r.stdout)
            if len(iface_line) > 2 and str(iface_line[2]).isdigit():
                return int(iface_line[2])
    except Exception:
        pass
    try:                                  # interface DOWN — fall back to the .conf so a port change still
        info = parse_interface_section(open(ic["conf"]).read())   # converges (set-iface persists it for next up)
        lp = str(info.get("ListenPort", "")).strip()
        return int(lp) if lp.isdigit() else None
    except Exception:
        return None


def current_awg(node_cfg, iface):
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    try:
        with open(ic["conf"]) as f:
            return awg_params(parse_interface_section(f.read()))
    except Exception:
        return None


def reconcile_ifaces(node_cfg, desired_ifaces, agent, sudo):
    """Apply the panel's desired interface config (listen port and/or AmneziaWG params). Only
    ever called on a valid sync reply; converges the live interface to the panel's target."""
    res = {"changed": 0, "errors": []}
    for iface, want in (desired_ifaces or {}).items():
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        payload = {"op": "set-iface", "iface": iface}
        port = want.get("listen_port")
        if port:
            cur = current_listen_port(node_cfg, iface)
            if cur is not None and int(cur) != int(port):
                payload["listen_port"] = int(port)
        awg = want.get("awg_params")
        if isinstance(awg, dict) and awg:
            cur_awg = current_awg(node_cfg, iface) or {}
            want_s = {k: str(v) for k, v in awg.items()}
            if any(str(cur_awg.get(k)) != v for k, v in want_s.items()):
                payload["awg_params"] = awg
        if len(payload) <= 2:                 # only op + iface — nothing differs
            continue
        r = run_agent(agent, sudo, payload)
        if r.get("ok"):
            res["changed"] += 1
        else:
            res["errors"].append(f"set-iface {iface}: {r.get('error')}")
    return res


def reconcile(node_cfg, desired_by_iface, agent, sudo, remove_by_iface=None):
    """Apply the panel's desired peer set. Only ever called on a valid sync reply."""
    res = {"added": 0, "removed": 0, "errors": []}
    remove_by_iface = remove_by_iface or {}
    # last DESIRED endpoint we pushed per peer — so an operator changing a node's ingress IP re-dials existing
    # links (the panel sends the new endpoint; we apply it once), without fighting WireGuard's roaming (we key
    # on the desired value, not the live/roamed one). iface|pubkey -> endpoint.
    EP_FILE = os.path.join(STATE_DIR, "mesh-eps.json")
    applied_ep = {}
    with contextlib.suppress(Exception):
        applied_ep = json.load(open(EP_FILE))
    ep_dirty = False
    for iface, ic in (node_cfg.get("interfaces") or {}).items():
        desired = {p["public_key"]: p for p in (desired_by_iface.get(iface) or [])}
        dump = _iface_dump(node_cfg, iface)         # read the live interface ONCE, shared by both accessors below
        current = current_pubkeys(node_cfg, iface, dump)
        if current is None:
            res["errors"].append(f"{iface}: cannot read interface")
            continue
        live_allowed = current_allowed(node_cfg, iface, dump) or {}   # for re-applying a CHANGED AllowedIPs (cascade /32→/0)
        live_ep = current_endpoints(node_cfg, iface, dump) or {}       # live endpoints — adopt an already-dialed peer (see the re-assert below)
        live_hs = current_handshakes(node_cfg, iface, dump) or {}      # live handshake ts — detect a silent-stale dial-out mesh peer
        # EXPLICIT retirements from the panel (a key it rotated/deleted) FIRST — removed even on an
        # add-only interface, and before the add below so the replacement key can take the freed IP.
        for pk in remove_by_iface.get(iface, []):
            if pk in current and pk not in desired:
                r = run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                if r.get("ok"):
                    res["removed"] += 1; current.discard(pk)
                else:
                    res["errors"].append(f"retire {pk[:8]}: {r.get('error')}")
        for pk, p in desired.items():
            if pk in current:
                if live_hs.get(pk) and (time.time() - live_hs[pk]) <= MESH_STALE_S:
                    _op_ok("stale|" + iface + "|" + pk)   # link is healthy → reset any prior stale-bounce backoff
                # already present — but its AllowedIPs may have CHANGED (cascade flips a mesh peer
                # /32 ↔ 0.0.0.0/0, or an exit gains a forwarded subnet). reconcile otherwise skips
                # present peers, so apply the diff surgically (this is risk R1).
                want_a = _norm_allowed(p.get("allowed_ips", ""))
                if want_a and live_allowed.get(pk) is not None and live_allowed[pk] != want_a:
                    r = run_agent(agent, sudo, {"op": "set-peer-allowed", "iface": iface,
                                                "public_key": pk, "allowed_ips": p.get("allowed_ips", "")})
                    if r.get("ok"):
                        res["added"] += 1                        # count as a change (drives the reconcile log)
                    else:
                        res["errors"].append(f"allowed {pk[:8]}: {r.get('error')}")
                # endpoint CHANGED (the peer's ingress IP/port was edited) → re-dial: re-assert the peer with
                # the new endpoint. Keyed on the desired value so this fires once per real change, not per roam.
                ek = iface + "|" + pk; want_ep = p.get("endpoint")
                if want_ep and applied_ep.get(ek) != want_ep:
                    if live_ep.get(pk) == want_ep:
                        # SELF-HEAL (no datapath change): the peer is ALREADY dialed to exactly the desired
                        # endpoint — our applied_ep memory was simply lost (process restart / docker convert /
                        # EP_FILE gone). Adopt it: record the endpoint WITHOUT re-adding. The agent refuses a
                        # duplicate add ("peer_exists"), and that failure was pinning the reconcile at the fast
                        # retry cadence forever (~17% CPU). A healthy link is left untouched.
                        applied_ep[ek] = want_ep; ep_dirty = True
                    elif not _op_ready("redial|" + ek):             # a re-dial that keeps failing → back off, don't churn
                        res["errors"].append(f"endpoint {pk[:8]}: retrying later (repeated failure)")
                    else:
                        _mkadd = lambda: {"op": "add-peer", "iface": iface, "public_key": pk,
                                          "allowed_ips": p.get("allowed_ips", ""),
                                          "preshared_key": p.get("preshared_key", "none"),
                                          "endpoint": want_ep,
                                          "persistent_keepalive": p.get("persistent_keepalive"),
                                          "name": p.get("name", "")}
                        r = run_agent(agent, sudo, _mkadd())
                        if not r.get("ok") and r.get("code") == "peer_exists":
                            # genuine re-dial, but the peer lingers under a DIFFERENT endpoint and the agent won't
                            # add a duplicate → self-heal: drop it, then re-add with the new endpoint.
                            run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                            r = run_agent(agent, sudo, _mkadd())
                        if r.get("ok"):
                            _op_ok("redial|" + ek); applied_ep[ek] = want_ep; ep_dirty = True; res["added"] += 1
                        else:
                            _op_fail("redial|" + ek); res["errors"].append(f"endpoint {pk[:8]}: {r.get('error')}")
                elif want_ep and live_hs.get(pk) and (time.time() - live_hs[pk]) > MESH_STALE_S and _op_ready("stale|" + ek):
                    # SILENT-MESH-DEATH heal: a dial-out mesh peer that HANDSHOOK before but has been stale past
                    # MESH_STALE_S is stuck — the remote's ingress moved (NAT rebind / IP change / DPI) and WG,
                    # dialing a fixed endpoint, never recovers. Bounce it (re-resolves a hostname endpoint on
                    # re-add). Gated: only a previously-connected peer (never-connected = "connecting", not stuck),
                    # and backoff-guarded so a genuinely-offline peer doesn't churn.
                    run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                    r = run_agent(agent, sudo, {"op": "add-peer", "iface": iface, "public_key": pk,
                                                "allowed_ips": p.get("allowed_ips", ""),
                                                "preshared_key": p.get("preshared_key", "none"),
                                                "endpoint": want_ep,
                                                "persistent_keepalive": p.get("persistent_keepalive"),
                                                "name": p.get("name", "")})
                    if r.get("ok"):
                        _op_fail("stale|" + ek)   # count the bounce for backoff, but DON'T clear — a healthy link stops being stale on its own next cycle
                        applied_ep[ek] = want_ep; ep_dirty = True; res["added"] += 1
                    else:
                        _op_fail("stale|" + ek); res["errors"].append(f"stale-redial {pk[:8]}: {r.get('error')}")
                continue
            akey = "add|" + iface + "|" + pk
            _op_cfg_changed(akey, (p.get("allowed_ips", ""), str(p.get("endpoint") or ""), p.get("preshared_key", "none")))  # a corrected desired config → drop the backoff, retry now
            if not _op_ready(akey):                                  # repeatedly rejected AND config unchanged → in backoff; don't re-spawn the agent
                res["errors"].append(f"add {pk[:8]}: retrying later (repeated failure)")
                continue
            r = run_agent(agent, sudo, {
                "op": "add-peer", "iface": iface, "public_key": pk,
                "allowed_ips": p.get("allowed_ips", ""),
                "preshared_key": p.get("preshared_key", "none"),
                "endpoint": p.get("endpoint"),                       # mesh peers dial out (user peers: None)
                "persistent_keepalive": p.get("persistent_keepalive"),
                "name": p.get("name", "")})
            if r.get("ok"):
                _op_ok(akey); res["added"] += 1
                if p.get("endpoint"):
                    applied_ep[iface + "|" + pk] = p.get("endpoint"); ep_dirty = True
            else:
                _op_fail(akey); res["errors"].append(f"add {pk[:8]}: {r.get('error')}")
        # An onboarded interface is ADD-ONLY: the panel never removes peers it didn't create, so an
        # interface adopted from another tool (e.g. wg-easy) keeps its existing peers. They surface
        # as adoptable orphans instead of being wiped.
        if ic.get("onboarded"):
            continue
        for pk in current - set(desired):
            r = run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
            if r.get("ok"):
                res["removed"] += 1
                applied_ep.pop(iface + "|" + pk, None); ep_dirty = True
            else:
                res["errors"].append(f"remove {pk[:8]}: {r.get('error')}")
    if ep_dirty:
        with contextlib.suppress(Exception):
            with open(EP_FILE + ".tmp", "w") as f:
                json.dump(applied_ep, f)
            os.replace(EP_FILE + ".tmp", EP_FILE)
    return res


def _reconstruct_conf(iface, cmd):
    """Rebuild an interface's .conf from the LIVE device and return its path ('' if that isn't possible).

    A docker node mounts its own dir over /etc/amnezia/amneziawg, so a pre-existing HOST interface's .conf is
    invisible in here and the candidate is reported with conf="" — adoption then failed for every wg/awg device on
    the box. `wg/awg showconf` reads the running device over netlink, which works fine from the container (host
    networking) and yields the server key plus every peer — exactly what adoption promises to keep, and fresher
    than any file. showconf omits the interface ADDRESS (it is not kernel state the tool reports), so that comes
    from `ip addr`.

    Written into the node's own persisted conf dir, never the host's: we are adopting the interface, not editing
    somebody else's file, and on docker that dir is the bind-mount that survives a recreate."""
    dst_dir = _awg_conf_dirs()[0] if cmd == ["awg"] else (AWG_CONF_DIRS[0] if NODE_KIND == "docker" else WG_CONF_DIRS[0])
    with contextlib.suppress(Exception):
        r = run(cmd + ["showconf", iface])
        body = (r.stdout or "").strip()
        if not body or "[Interface]" not in body:
            return ""
        addr = ""
        with contextlib.suppress(Exception):
            for ln in (run(["ip", "-4", "-o", "addr", "show", iface]).stdout or "").splitlines():
                p = ln.split()
                if len(p) >= 4 and p[2] == "inet":
                    addr = p[3]; break
        if addr and "Address" not in body.split("[Peer]")[0]:
            body = body.replace("[Interface]", "[Interface]\nAddress = " + addr, 1)
        # MTU is a wg-quick directive, so showconf omits it — but it IS on the live link, and dropping it
        # silently re-created the interface with a different MTU than the one that was serving. (DNS, Table and
        # the PostUp/PostDown hooks live ONLY in the file; when that file is unreadable they are genuinely lost,
        # which is what the caller warns about rather than papering over.)
        mtu = ""
        with contextlib.suppress(Exception):
            _lk = (run(["ip", "-o", "link", "show", iface]).stdout or "")
            _m = re.search(r"\bmtu (\d+)\b", _lk)
            if _m:
                mtu = _m.group(1)
        if mtu and "MTU" not in body.split("[Peer]")[0]:
            body = body.replace("[Interface]", "[Interface]\nMTU = " + mtu, 1)
        os.makedirs(dst_dir, exist_ok=True)
        path = os.path.join(dst_dir, iface + ".conf")
        if os.path.exists(path):          # never clobber a conf we already manage
            return path
        with open(path, "w") as f:
            f.write("#swg:onboarded\n" + body + "\n")
        os.chmod(path, 0o600)
        return path
    return ""


def onboard_ifaces(node_cfg, onboard):
    """Add panel-requested interfaces to this node's managed set (config.json) when they exist
    locally — for a wg/awg interface the panel didn't auto-detect. Once added, build_snapshot
    reports it and the panel closes the request (no separate ack needed). Only ever on a 200."""
    res = {"added": [], "errors": []}
    if not onboard:
        return res
    ifaces = node_cfg.setdefault("interfaces", {})
    changed = False
    for iface, want in onboard.items():
        if iface in ifaces:                 # already managed — nothing to do (panel will clear it)
            continue
        cmd = want.get("cmd") or ["awg"]
        conf = want.get("conf") or ""
        try:
            _asked = conf
            if not conf or not os.path.exists(conf):
                # No readable .conf (a docker node cannot see the host's) — rebuild it from the live device.
                conf = _reconstruct_conf(iface, cmd if cmd != ["auto"] else ["awg"]) or \
                       (_reconstruct_conf(iface, ["wg"]) if cmd == ["auto"] else "")
                if not conf:
                    res["errors"].append(f"{iface}: no config on disk and the live interface couldn't be read"); continue
                # Which source won is not a detail: adopting from the device keeps the keys, peers, ports and
                # AWG params, but any DNS / Table / PostUp the operator had in that file is NOT on the device
                # and does not survive. Saying so beats a silent substitution — the operator supplied a path
                # and is entitled to know it was not the one used.
                if _asked:
                    res.setdefault("notes", []).append(
                        f"{iface}: couldn't read {_asked} — adopted from the live interface instead "
                        f"(keys, peers and ports kept; any DNS/Table/PostUp lines in that file are not)")
                    print(f"onboard: {iface}: {_asked} unreadable — rebuilt from the live device", flush=True)
            if cmd == ["auto"]:                     # "Existing" gave no protocol — detect it from the conf
                info = parse_interface_section(open(conf).read())
                cmd = ["awg"] if any(k in info for k in AWG_KEYS) else ["wg"]
                try:
                    run(cmd + ["show", iface, "dump"])
                except Exception:
                    cmd = ["wg"] if cmd == ["awg"] else ["awg"]   # fall back to the other tool
            run(cmd + ["show", iface, "dump"])      # raises if the interface isn't actually up
        except Exception as e:
            res["errors"].append(f"{iface}: {e}"); continue
        ifaces[iface] = {"cmd": cmd, "conf": conf, "onboarded": True}   # add-only: never wipe its peers
        try:                                            # persist the marker in the conf so a docker restart
            with open(conf) as _f: _t = _f.read()       # (config.json rebuilt from confs) keeps it add-only
            if "#swg:onboarded" not in _t:
                with open(conf, "w") as _f: _f.write("#swg:onboarded\n" + _t)
        except OSError:
            pass
        changed = True
        res["added"].append(iface)
    if changed:
        try:
            _persist_config(node_cfg)
        except Exception as e:
            res["errors"].append(f"persist config.json: {e}")
    return res


def restart_ifaces(node_cfg, restart, agent, sudo):
    """Bounce panel-requested interfaces (<tool>-quick down/up) via swg-agent — recovers a DOWN one."""
    res = {"restarted": [], "errors": []}
    for iface in (restart or []):
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        r = run_agent(agent, sudo, {"op": "restart-iface", "iface": iface})
        if r.get("ok"):
            res["restarted"].append(iface); _set_iface_stopped(iface, False)   # a restart brings it back up
        else:
            res["errors"].append(f"{iface}: {r.get('error')}")
    return res


# interfaces the operator deliberately stopped from the panel → reported as "stopped" (not "down": it's a
# choice, not a failure). Persisted so it survives a daemon restart. Cleared when the interface is started.
IFACE_STOPPED_FILE = os.path.join(STATE_DIR, "iface-stopped.json")
def _load_stopped_ifaces():
    try:
        with open(IFACE_STOPPED_FILE) as f:
            v = json.load(f)
        return set(v) if isinstance(v, list) else set()
    except Exception:
        return set()
def _set_iface_stopped(iface, stopped):
    s = _load_stopped_ifaces()
    if (iface in s) == bool(stopped):
        return
    s.add(iface) if stopped else s.discard(iface)
    with contextlib.suppress(Exception):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = IFACE_STOPPED_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(sorted(s), f)
        os.replace(tmp, IFACE_STOPPED_FILE)


def stop_ifaces(node_cfg, stop, agent, sudo):
    """Stop panel-requested interfaces (down + disable, conf kept) — they stay down until started again."""
    res = {"stopped": [], "errors": []}
    for iface in (stop or []):
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        r = run_agent(agent, sudo, {"op": "stop-iface", "iface": iface})
        if r.get("ok"):
            res["stopped"].append(iface); _set_iface_stopped(iface, True)   # mark as a deliberate stop, not a failure
        else:
            res["errors"].append(f"{iface}: {r.get('error')}")
    return res


def start_ifaces(node_cfg, start, agent, sudo):
    """Start panel-requested interfaces (up + enable)."""
    res = {"started": [], "errors": []}
    for iface in (start or []):
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        r = run_agent(agent, sudo, {"op": "start-iface", "iface": iface})
        if r.get("ok"):
            res["started"].append(iface); _set_iface_stopped(iface, False)   # no longer stopped
        else:
            res["errors"].append(f"{iface}: {r.get('error')}")
    return res


def apply_iface_keys(node_cfg, iface_key, agent, sudo):
    """Panel keypair requests per interface: 'rebaseline' overwrites the on-disk backup from the live
    conf (after an Adopt); 'restore' re-keys the interface from that backup + bounces it (a Restore)."""
    res = {"done": [], "errors": []}
    for iface, req in (iface_key or {}).items():
        ic = (node_cfg.get("interfaces") or {}).get(iface)
        if not ic:
            continue
        action = (req or {}).get("action")
        cmd = _wgcmd(ic.get("cmd", ["awg"]))
        try:
            if action == "rebaseline":
                conf_text = ""
                with contextlib.suppress(OSError):
                    conf_text = open(ic["conf"]).read()
                rec = harvest_iface_backup(conf_text, cmd) if conf_text else None
                if rec:
                    write_iface_backup(iface, rec); res["done"].append(iface)
            elif action == "restore":
                bak = read_iface_backup(iface)
                if not bak or not bak.get("private_key"):
                    res["errors"].append(iface + ": no keypair backup to restore from"); continue
                r = run_agent(agent, sudo, {"op": "restore-iface-key", "iface": iface, "conf": ic["conf"],
                                            "private_key": bak["private_key"], "listen_port": bak.get("listen_port"),
                                            "address": bak.get("address")})
                if r.get("ok"):
                    res["done"].append(iface)
                else:
                    res["errors"].append(iface + ": " + str(r.get("error")))
        except Exception as e:
            res["errors"].append(iface + ": " + str(e))
    return res


def _persist_config(node_cfg):
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(node_cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


# ── panel address auto-repoint (pin-gated) + opportunistic cert-pin adoption ──────────────────────────────
# The panel serves its canonical URL + cert fingerprint in every sync. On a change of the panel host/port an
# ONLINE node re-points itself — but ONLY after proving the new address presents the SAME identity we already
# trust (pinned cert / CA), so a MITM (or a stolen token feeding a bogus URL) can never redirect a node.

def _host_is_internal(host):
    """A compose/loopback/private address whose link to the panel is INDEPENDENT of the public address — the
    master's local node (docker: 'swg-panel', bare-metal: localhost) must never auto-repoint on a public change."""
    h = (host or "").strip().lower().strip("[]")
    if not h:
        return True
    if h == "localhost" or h.startswith("127.") or h == "::1":
        return True
    if "." not in h and ":" not in h:                      # single-label hostname (e.g. compose service 'swg-panel')
        return True
    if h.startswith(("10.", "192.168.", "169.254.")):
        return True
    if h.startswith("172."):
        try:
            return 16 <= int(h.split(".")[1]) <= 31
        except Exception:
            return False
    if h.startswith(("fc", "fd", "fe80")):                 # v6 ULA / link-local
        return True
    return False

def _norm_url(u):
    """scheme://host[:port][/path] with default ports dropped + trailing slash trimmed — so we don't churn on
    cosmetic differences, but DO distinguish a reverse-proxy mount-PATH change (/swg vs /panel is a real address
    change nodes must follow, not cosmetic)."""
    try:
        p = urllib.parse.urlparse(u if "://" in (u or "") else "https://" + (u or ""))
        host = p.hostname or ""
        default = 443 if p.scheme == "https" else 80
        port = p.port or default
        netloc = host if port == default else (("[%s]:%d" % (host, port)) if ":" in host else "%s:%d" % (host, port))
        return "%s://%s%s" % (p.scheme, netloc, (p.path or "").rstrip("/"))
    except Exception:
        return (u or "").rstrip("/")

def _verify_panel(base_url, token, panel):
    """True iff the panel at base_url answers /api/node/whoami with our token UNDER OUR CURRENT TLS POSTURE
    (existing pin / CA verify). This is the gate that stops a MITM from redirecting us."""
    try:
        st, _d, _h = _panel_get(base_url.rstrip("/") + "/api/node/whoami", token, panel, timeout=8)
        return st == 200
    except Exception:
        return False

def _persist_panel_url(node_cfg, new_url):
    """Persist a re-point. config.json is authoritative for bare-metal + the running process; the STATE_DIR copy
    survives a docker container recreate (node-entrypoint reads it ahead of the .env PANEL_URL)."""
    node_cfg.setdefault("panel", {})["url"] = new_url
    _persist_config(node_cfg)
    with contextlib.suppress(Exception):
        tmp = os.path.join(STATE_DIR, "panel-url.tmp")
        with open(tmp, "w") as f:
            f.write(new_url + "\n")
        os.replace(tmp, os.path.join(STATE_DIR, "panel-url"))


# The pending reverse-proxy address swap's CANDIDATE — the NEW address the panel is advertising ALONGSIDE our blessed
# one while the operator re-points the proxy (external: full new URL via panel_url_next; internal: the new listen port
# via panel_local_port). We keep dialing blessed; if it stops answering (proxy flipped old→new, or confirm dropped the
# old), we settle onto this. Kept OUT of config.json (a transient) + mirrored to a file so an external node — which has
# no loopback _heal backstop — survives a restart mid-swap. Cleared once no swap is pending or the candidate is adopted.
_SWAP = {"cand": ""}
def _persist_candidate(cand):
    _SWAP["cand"] = cand or ""
    try:
        path = os.path.join(STATE_DIR, "panel-url-cand")
        if cand:
            with open(path + ".tmp", "w") as f:
                f.write(cand + "\n")
            os.replace(path + ".tmp", path)
        else:
            with contextlib.suppress(OSError):
                os.unlink(path)
    except Exception:
        pass

def _learn_candidate(panel, reply):
    """From a valid sync, remember (don't yet switch to) the new address the panel is advertising. A co-located
    loopback node that can STILL dial the panel on loopback follows the listen PORT (+ mount base) via
    panel_local_port. But when the panel is direct-TLS / bound to a public IP, panel_local_port is None (loopback no
    longer reaches it) — so even a co-located node learns the PUBLIC url (panel_url_next before confirm, panel_url
    after), following the panel to its public hostname. External nodes always learn the public url. Cleared when the
    panel advertises no new address."""
    try:
        cur = (panel.get("url") or "").rstrip("/")
        cu = urllib.parse.urlparse(cur if "://" in cur else "https://" + cur)
        cur_host = cu.hostname
        _h = (cur_host or "").lower().strip("[]")
        lp = reply.get("panel_local_port")
        loopback_node = _host_is_internal(cur_host) and (_h == "localhost" or _h.startswith("127.") or _h == "::1")
        cand = ""
        if loopback_node and lp:
            # co-located loopback node, panel STILL loopback-reachable → follow the internal port AND mount base
            # directly (bypasses any proxy). A PENDING path swap carries the NEW base in panel_url_next's path (the
            # LIVE panel_base is still the OLD one until confirm); once confirmed panel_url_next clears + panel_base
            # holds the new base.
            cur_port = cu.port or (443 if cu.scheme == "https" else 80)
            cur_base = (cu.path or "").rstrip("/")
            nxt = (reply.get("panel_url_next") or "").strip()
            if nxt:
                new_base = urllib.parse.urlparse(nxt if "://" in nxt else "https://" + nxt).path.rstrip("/")
            else:
                pb = reply.get("panel_base")
                new_base = (pb if pb is not None else cur_base).rstrip("/")
            if int(lp) != cur_port or new_base != cur_base:
                cand = "%s://%s:%d%s" % (cu.scheme, cur_host, int(lp), new_base)
        else:
            # external node — OR a co-located node whose panel went direct-TLS / public (no usable loopback port, so it
            # must move to the public hostname). Candidate = the pending swap's next-url (before confirm) OR the
            # advanced canonical url — kept alive until this node actually sits on it, so a blessed-address death
            # right at/after confirm still has a fail-over target.
            nxt = (reply.get("panel_url_next") or "").strip().rstrip("/")
            can = (reply.get("panel_url") or "").strip().rstrip("/")
            if nxt and _norm_url(nxt) != _norm_url(cur):
                cand = nxt
            elif can and _norm_url(can) != _norm_url(cur):
                cand = can
        if _norm_url(cand) != _norm_url(_SWAP.get("cand") or ""):
            _persist_candidate(cand)
    except Exception as e:
        print("_learn_candidate:", e, flush=True)

def _failover_candidate(panel, node_cfg):
    """Our blessed panel address stopped answering while a swap is pending → settle onto the learned candidate if it
    now answers as the same panel (operator flipped the proxy to the new address, or confirmed the swap so the old was
    dropped). Verified with our OWN trust anchor — a wrong/hostile address can't capture us. Returns the new sync url
    if it moved, else None. This is what makes confirm land the node on the new address, cancel keep it on the old."""
    try:
        cand = (_SWAP.get("cand") or "").rstrip("/")
        cur = (panel.get("url") or "").rstrip("/")
        if not cand or _norm_url(cand) == _norm_url(cur):
            return None
        if _verify_panel(cand, panel.get("token") or "", panel):
            panel["url"] = cand
            _persist_candidate("")
            _persist_panel_url(node_cfg, cand)
            print(f"blessed panel address stopped answering — failed over to {cand} (verified same identity)", flush=True)
            return cand.rstrip("/") + "/api/node/sync"
    except Exception as e:
        print("_failover_candidate:", e, flush=True)
    return None

def apply_panel_hints(panel, node_cfg, reply):
    """On a VALID sync: (1) opportunistically adopt a cert pin if we're currently UNVERIFIED (TOFU upgrade over an
    already-unverified channel — strictly better); (2) re-point to a new panel URL, pin-gated. Returns the new
    sync URL to dial if it changed, else None. Never throws (a hiccup must not break the sync loop)."""
    try:
        p_url = (reply.get("panel_url") or "").strip().rstrip("/")
        cur_fp = (panel.get("fingerprint") or "").replace(":", "").lower().strip()
        verified = bool(panel.get("verify", False) or cur_fp)
        # NOTE: no server-driven pin adoption. The panel reports its ORIGIN cert fp, but a node behind a
        # TLS-terminating proxy (Cloudflare) sees the PROXY's cert — adopting the panel-reported fp would
        # pin the wrong cert and fail closed. Pinning belongs at install (Phase 1), where the installer
        # captures the cert the NODE actually sees. Here we only re-point, gated by the EXISTING trust anchor.
        # (a) LEARN the pending-swap candidate every valid sync (internal: new port; external: new url). We do NOT
        # switch to it here — we keep dialing blessed and fail over only if blessed stops answering (see
        # _failover_candidate). This is what keeps a node on BOTH addresses during the transition, settling on the
        # survivor: confirm drops the old → blessed dies → fail over to new; cancel drops the new → blessed lives on.
        _learn_candidate(panel, reply)
        # (b) CANONICAL adopt: the panel's CONFIRMED dial url advanced. Internal links never adopt the public url
        # (meaningless to a co-located node — they follow the listen PORT via the candidate path). An EXTERNAL node
        # adopts it once it verifies as the same panel — the graceful path when the old address still serves at confirm.
        if p_url:
            cur = (panel.get("url") or "").rstrip("/")
            cur_host = urllib.parse.urlparse(cur if "://" in cur else "https://" + cur).hostname
            if _norm_url(p_url) != _norm_url(cur) and not _host_is_internal(cur_host):
                if not verified:
                    print(f"panel moved to {p_url}, but this node is unverified — re-point it manually "
                          f"(set panel.url in {CONFIG_PATH} + restart)", flush=True)
                elif _verify_panel(p_url, panel.get("token") or "", panel):
                    panel["url"] = p_url
                    _persist_candidate("")   # canonical arrived → the swap is done, drop any candidate
                    _persist_panel_url(node_cfg, p_url)
                    print(f"panel address changed → re-pointed to {p_url} (verified same identity)", flush=True)
                    return p_url.rstrip("/") + "/api/node/sync"
                else:
                    print(f"panel says it moved to {p_url}, but that address doesn't present our trusted cert yet "
                          f"— staying on {cur}", flush=True)
    except Exception as e:
        print("apply_panel_hints:", e, flush=True)
    return None


_LOCAL_HEAL = {"at": 0.0}
def _heal_local_panel(panel, node_cfg):
    """A CO-LOCATED node (loopback panel URL, e.g. a bare-metal master's local node) can't learn a new panel port
    via sync — its link is refused, so it never receives the panel_url hint. When a LOOPBACK sync fails, rediscover
    the panel locally: read its bind port from the standard settings file, else probe common ports, and re-point.
    No MITM risk on loopback. Docker masters use a stable internal link (swg-panel:8443) that never breaks, so this
    only ever fires bare-metal. Returns the new sync URL if it moved, else None."""
    try:
        cur = (panel.get("url") or "").rstrip("/")
        u = urllib.parse.urlparse(cur if "://" in cur else "https://" + cur)
        host = (u.hostname or "").lower()
        if not (host == "localhost" or host.startswith("127.") or host == "::1"):
            return None                                  # not a loopback link → the sync-response repoint handles it
        now = time.time()
        if now - _LOCAL_HEAL["at"] < 30:                 # cooldown — don't rescan every failed 5s sync
            return None
        _LOCAL_HEAL["at"] = now
        scheme = u.scheme or "https"
        cur_port = u.port or (443 if scheme == "https" else 80)
        cur_base = (u.path or "").rstrip("/")                # keep the reverse-proxy mount path (e.g. /swg) — a subpath panel answers there, not at root
        token = panel.get("token") or ""
        candidates = [443, 8443, 2053, 2083, 2087, 2096, 80, 8080, 8000, 9443]
        bases = [cur_base]
        for sp in ("/var/lib/swg-panel/panel-settings.json", "/etc/swg-panel/panel-settings.json"):
            try:
                _acc = (((json.load(open(sp)) or {}).get("access") or {}).get("panel") or {})
                pp = int(_acc.get("port") or 0)
                if pp and pp not in candidates:
                    candidates.insert(0, pp)             # the exact configured port → covers a non-standard one
                sb = urllib.parse.urlparse(str(_acc.get("url") or "")).path.rstrip("/")   # the configured mount base → covers a PATH change (/swg → /panel)
                if sb not in bases:
                    bases.insert(0, sb)
                break
            except Exception:
                pass
        for base in bases:                               # try the configured base first, then the one we were on
            for port in candidates:
                if port == cur_port and base == cur_base:
                    continue
                probe = "%s://%s:%d%s" % (scheme, host, port, base)
                if _verify_panel(probe, token, panel):
                    panel["url"] = probe
                    _persist_candidate("")
                    _persist_panel_url(node_cfg, probe)
                    print(f"panel not reachable at {cur} — rediscovered it locally at {probe}, re-pointed", flush=True)
                    return probe.rstrip("/") + "/api/node/sync"
    except Exception as e:
        print("_heal_local_panel:", e, flush=True)
    return None


def create_ifaces(node_cfg, create, agent, sudo):
    """Create panel-requested BRAND-NEW interfaces via swg-agent (genkey + conf + auto-NAT + bring-up),
    then start managing them (config.json). Only on a valid sync. Bring-up runs live — verify on one
    node. Native datapath: kernel on a bare-metal node, container-userspace on a docker node."""
    res = {"created": [], "errors": []}
    if not create:
        return res
    ifaces = node_cfg.setdefault("interfaces", {})
    changed = False
    for iface, want in create.items():
        if iface in ifaces:                 # already created — nothing to do (panel clears it)
            continue
        cmd = want.get("cmd") or ["awg"]
        # RESTORE of a vanished interface: recreate it with its ORIGINAL server key so no client re-imports.
        # Key source, in order: a sealed_key the browser re-sealed to THIS node's transport key from the operator
        # vault (a full wipe — panel relayed only ciphertext); else the node's own on-disk backup. Absent both →
        # fall through to a brand-new genkey (agent side): a fresh identity.
        priv = (want.get("private_key") or "").strip()
        if not priv and want.get("sealed_key"):
            with contextlib.suppress(Exception):
                priv = ivk_unseal(transport_priv(), want["sealed_key"]).decode().strip()   # vault key, delivered sealed
        if not priv and want.get("restore"):
            priv = ((read_iface_backup(iface) or {}).get("private_key") or "").strip()
        r = run_agent(agent, sudo, {"op": "create-iface", "iface": iface, "cmd": cmd,
                                    "subnet": want.get("subnet"), "listen_port": want.get("listen_port"),
                                    "address": want.get("address"),   # explicit addr (mesh /31 ends)
                                    "private_key": priv,               # blank => agent genkeys a new one
                                    "awg_params": want.get("awg_params"),   # restore: original obfuscation (else agent randomizes)
                                    "mtu": want.get("mtu")})
        if not r.get("ok"):
            res["errors"].append(f"{iface}: {r.get('error')}"); continue
        data = r.get("data") or {}
        conf = data.get("conf") or ""
        if not conf:
            res["errors"].append(f"{iface}: agent returned no conf path"); continue
        with contextlib.suppress(Exception):
            ensure_iface_backup(iface, open(conf).read(), cmd)   # (re)seed the key backup (no-op if it already exists)
        # the agent may have fallen back (e.g. wg→awg on a node with only amneziawg-go) — record the
        # tool it ACTUALLY used, or we'll later run the wrong CLI (`wg show`) and "can't read" it
        ifaces[iface] = {"cmd": data.get("cmd") or cmd, "conf": conf}
        changed = True
        res["created"].append(iface)
    if changed:
        try:
            _persist_config(node_cfg)
        except Exception as e:
            res["errors"].append(f"persist config.json: {e}")
    return res


def delete_ifaces(node_cfg, delete, agent, sudo):
    """Tear down panel-requested interfaces (down + remove conf via swg-agent) and stop managing them.
    Only on a valid sync. The panel clears the request once the iface stops appearing in snapshots."""
    res = {"deleted": [], "errors": []}
    if not delete:
        return res
    ifaces = node_cfg.get("interfaces") or {}
    changed = False
    for iface in list(delete):
        if iface not in ifaces:             # already gone — panel clears it when the snapshot lacks it
            continue
        r = run_agent(agent, sudo, {"op": "delete-iface", "iface": iface})
        if not r.get("ok"):
            res["errors"].append(f"{iface}: {r.get('error')}"); continue
        ifaces.pop(iface, None)
        changed = True
        res["deleted"].append(iface)
    if changed:
        try:
            _persist_config(node_cfg)
        except Exception as e:
            res["errors"].append(f"persist config.json: {e}")
    return res


# ── turn-proxy management (host systemd units) ──────────────────────────────────────────────────
# UNVERIFIED ON DOCKER: the bare-metal path edits units + systemctl directly; the docker path runs
# the same on the HOST via a privileged --pid=host helper through the mounted docker.sock (nsenter
# into PID 1). Test on a real node before relying on it. The socket = root-on-host (opt-in install).
HELPER_IMAGE = os.environ.get("HELPER_IMAGE") or "ghcr.io/sanityprotocol/swg-node:latest"
TURN_UNIT_DIR = "/etc/systemd/system"
TURN_MANAGE_ON = (NODE_KIND != "docker") or ((os.environ.get("TURN_MANAGE") or "manual").strip().lower() == "panel")
NODE_PROGRESS = {} # request key (iface name / turn service) -> transient "what's happening right now" line
                   # (e.g. a slow GitHub download retrying) → cmd_progress on the snapshot → yellow card note.
NODE_ERRORS = {}   # request key (iface name / turn service / .service path) -> last apply error, reported
                   # in the snapshot ("cmd_errors") so the panel can show WHY a host->node command failed
NODE_NOTES = {}    # iface -> one-line note about HOW it was adopted (succeeded, but not from the named source);
                   # reported as "onboard_notes" and written to the activity log once by the panel

def host_sh(cmd, timeout=90):
    """Run a shell command on the HOST. Bare-metal: directly. Docker: via a one-shot privileged
    --pid=host helper through the mounted docker socket — nsenter into PID 1 so the command runs in
    the host's namespaces (its filesystem + systemd)."""
    if NODE_KIND != "docker":
        args = ["sh", "-c", cmd] if os.geteuid() == 0 else ["sudo", "-n", "sh", "-c", cmd]
    else:
        # --entrypoint nsenter is REQUIRED: the swg-node image's entrypoint is node-entrypoint.sh
        # (it demands PANEL_URL + sets up wg) — passing nsenter as the command alone still runs it.
        args = ["docker", "run", "--rm", "--privileged", "--pid=host", "--entrypoint", "nsenter",
                HELPER_IMAGE, "-t", "1", "-m", "-u", "-i", "-n", "-p", "--", "sh", "-c", cmd]
    try:
        r = run(args, timeout=timeout)
    except Exception as e:                              # e.g. 'docker' not found, or a timeout
        print("host_sh EXC: " + str(e) + " :: " + cmd[:160], flush=True)
        class _R:                                       # synthesize a failed result so callers see it
            returncode = 127; stdout = ""; stderr = str(e)
        return _R()
    if r.returncode != 0:
        print("host_sh rc=" + str(r.returncode) + " :: " + cmd[:160] + " :: " + (r.stderr or r.stdout or "")[:300], flush=True)
    return r

def _turn_unit_path(svc):
    return TURN_UNIT_DIR + "/" + svc + ".service"

def _exec_of(unit_text):
    for ln in unit_text.splitlines():
        if ln.startswith("ExecStart="):
            return ln[len("ExecStart="):]
    return ""

def _exec_params(execl):
    """Everything after '-connect <ip:port>' in the ExecStart — the free-text extra flags (wrap etc.)."""
    m = re.search(r"-connect[ =]+\S+\s*(.*)$", execl)
    return (m.group(1).strip() if m else "")

def _parse_tp(svc, execl):
    def g(flag):
        m = re.search(r"-" + re.escape(flag) + r"[ =]+(\S+)", execl)
        return m.group(1) if m else ""
    return {"service": svc, "listen": g("listen"), "connect": g("connect"),
            "wrap_key": g("wrap-key") or g("obf-key") or g("password"), "params": _exec_params(execl)}   # free-turn = -obf-key, MYSOREZ = -password

def _installed_tp(svc):
    """Re-read a turn unit (after install/edit) so the record carries the real ExecStart, incl. the
    generated wrap key."""
    unit = host_sh("cat " + shlex.quote(_turn_unit_path(svc)) + " 2>/dev/null").stdout
    return _tp_from_unit(svc, unit)


# ───────── docker turn-proxies: sibling CONTAINERS (no host systemd, no --pid=host helper) ─────────
# A docker node runs each turn-proxy as its OWN container (swg-turn-<inst>, host networking) instead of
# editing host systemd through a privileged --pid=host nsenter helper. swg-noded fetches the fork binary
# into its host-mounted data dir and runs it in the swg-node image; a change = recreate the container
# (fast, no daemon-reload). TURN_RECORD is the source of truth for the config on a docker node.
SWG_HOST_NODE_DIR = (os.environ.get("SWG_HOST_NODE_DIR") or "").rstrip("/")   # host path mapped to /var/lib/swg-noded
SWG_TURN_IMAGE = os.environ.get("SWG_TURN_IMAGE") or ""                       # image used to run the turn binary
TURN_DOCKER = (NODE_KIND == "docker")

def _turn_inst(svc):  return svc[len("vk-turn-proxy-"):] if svc.startswith("vk-turn-proxy-") else svc
def _turn_fork(svc):  inst = _turn_inst(svc); return inst.rsplit("-", 1)[0] or inst   # <fork>-<port> → <fork> (handles hyphenated forks, e.g. WINGS-N)
def _turn_cname(svc): return "swg-turn-" + _turn_inst(svc)
# ONE binary per fork, not per instance: every WINGS-N-<port> instance shares …/turn/.bin/WINGS-N/server.
def _turn_bin_local(svc): return "/var/lib/swg-noded/turn/.bin/" + _turn_fork(svc) + "/server"   # inside swg-noded
def _turn_bin_host(svc):  return SWG_HOST_NODE_DIR + "/turn/.bin/" + _turn_fork(svc) + "/server"  # same file on the host (mounted into each instance's container)
def _turn_bin_local_legacy(svc): return "/var/lib/swg-noded/turn/" + _turn_inst(svc) + "/server"  # pre-dedup per-instance path (migrated on next download)
def _turn_fork_in_use(svc, rec):   # is any OTHER instance of this fork still in the record? (don't drop a shared binary others use)
    fork = _turn_fork(svc); items = rec.values() if isinstance(rec, dict) else (rec or [])
    return any(isinstance(tp, dict) and tp.get("service") and tp["service"] != svc and _turn_fork(tp["service"]) == fork for tp in items)

def _params_wrapkey(params):
    # the obfuscation secret each fork carries: free-turn = -obf-key, the vk-turn-proxy forks = -wrap-key,
    # MYSOREZ = -password (a passphrase HKDF'd to the AEAD key).
    m = re.search(r"-(?:wrap|obf)-key[ =]+(\S+)", params or "") or re.search(r"-password[ =]+(\S+)", params or "")
    return m.group(1) if m else ""
def _params_set_wrapkey(params, key):
    params = params or ""
    # rotate whichever obfuscation-key flag the unit already carries (free-turn-proxy = -obf-key,
    # the vk-turn-proxy forks = -wrap-key, MYSOREZ = -password); only fall back to appending -wrap-key on a keyless unit.
    if re.search(r"-obf-key[ =]+\S+", params):
        return re.sub(r"-obf-key[ =]+\S+", "-obf-key " + key, params)
    if re.search(r"-wrap-key[ =]+\S+", params):
        return re.sub(r"-wrap-key[ =]+\S+", "-wrap-key " + key, params)
    if re.search(r"-password[ =]+\S+", params):
        return re.sub(r"-password[ =]+\S+", "-password " + key, params)
    return (params + " -wrap-key " + key).strip()

def _dturn_args(tp):
    listen = tp.get("listen", "")
    if NODE_NET == "bridge" and ":" in listen:
        # the stored listen binds the node's public IP, which isn't assignable inside our container netns — bind all
        # interfaces on the same port and let docker publish it (compose ports:). connect stays 127.0.0.1 (our netns).
        listen = "0.0.0.0:" + listen.rsplit(":", 1)[1]
    args = ["-listen", listen, "-connect", tp.get("connect", "")]
    p = (tp.get("params") or "").strip()
    if p:
        try: args += shlex.split(p)
        except Exception: args += p.split()
    return args

def _turn_arch():
    # Canonical arch for the turn-proxy binary name (server-linux-<arch>). Report the TRUE arch for anything we
    # have no build for (raw uname -m) so the panel can tell an armv7l / i686 / riscv64 box apart from amd64 —
    # NEVER collapse the unknown to amd64 (that silently fetched a wrong x86-64 binary → 404 / "Exec format error").
    # Recognise every alias of a supported arch so a valid 64-bit box is never misread as unsupported.
    m = os.uname().machine
    if m in ("x86_64", "amd64"):   return "amd64"
    if m in ("aarch64", "arm64"):  return "arm64"
    return m or "amd64"            # unknown/empty → its own name (blank falls back to amd64: when unsure, allow)

def _turn_arch_ok():
    # The forks publish server-linux-amd64 + server-linux-arm64 ONLY — this is the single source of truth for
    # "can this box run a turn-proxy". If a fork ever ships more arches, widen this set (and TURN_ARCHES on the panel).
    return _turn_arch() in ("amd64", "arm64")

def _turn_dl_urls(owner, arch, tag=None):
    """GitHub release assets are single-origin (objects.githubusercontent.com). Try GitHub direct first, then
    any operator-configured proxy mirrors (SWG_TURN_MIRROR, space-separated prefixes — OPT-IN: proxying a binary
    you execute is a supply-chain trust decision, so it's off by default).
    When the panel supplies a release TAG (the checksum gate), pin the IMMUTABLE per-tag asset
    (releases/download/<tag>/…) instead of the moving 'latest' — so the bytes match the sha256 the panel hashed."""
    path = ("download/" + tag) if tag else "latest/download"
    base = "https://github.com/" + owner + "/releases/" + path + "/server-linux-" + arch
    urls = [base]
    for m in (os.environ.get("SWG_TURN_MIRROR") or "").split():
        urls.append(m.rstrip("/") + "/" + base)   # e.g. https://ghproxy.example/https://github.com/<owner>/releases/...
    return urls

def _turn_pin(pin):
    """(tag, expected_sha) from the panel-provided pin {tag, sums:{arch:sha}} for THIS node's arch. Pass the pin
    dict itself (req.get("pin")), not the whole request. Either value may be '' — a mixed-version panel or one
    that couldn't hash the asset sends no sha, and the node then proceeds UNVERIFIED (the pre-checksum-gate
    behaviour). A PRESENT sha is ENFORCED fail-closed: a downloaded binary that doesn't match is deleted and
    never chmod+exec'd. See docs/TURN-PROXY-OVERHAUL-PLAN.md (Axis 2 · P1)."""
    pin = pin or {}
    return (pin.get("tag") or ""), ((pin.get("sums") or {}).get(_turn_arch()) or "")

def _turn_sha_ok(path, want):
    """True if `path`'s sha256 == want, or want is empty (nothing to verify → caller proceeds, logged elsewhere)."""
    if not want:
        return True
    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        return h.hexdigest() == want
    except OSError:
        return False

def _turn_sha_shell(path_q, want):
    """A shell fragment (for the host_sh install/reinstall heredocs) that verifies `path_q` (already shlex-quoted)
    against `want`, removing it and failing the command on mismatch. '' when there's nothing to enforce."""
    if not want:
        return ""
    return (" && { printf '%s  %s' " + shlex.quote(want) + " " + path_q
            + " | sha256sum -c --status - || { rm -f " + path_q
            + "; echo 'turn binary checksum mismatch — refusing to run unverified binary' >&2; false; }; }")

_TURN_PANEL = {}   # the panel connection dict (url/token/fingerprint/verify) — set each sync so the turn-binary MIRROR pull works

def _turn_panel_fetch(owner, tag, arch, dest, want):
    """Pull the fork binary from the PANEL's mirror (Axis 2 · P2) → dest, verified against `want` (the pin sha).
    Censorship-robust: the node reaches the panel over its existing outbound-only channel even where GitHub is
    blocked. Returns True on a verified write (dest is left executable-ready), else False (caller falls back to
    GitHub-direct). No-ops without a pin tag or panel config — so mixed-version panels keep GitHub-direct."""
    panel = _TURN_PANEL or {}
    base = (panel.get("url") or "").rstrip("/")
    if not base or not tag or "/" not in (owner or ""):
        return False
    url = (base + "/api/node/turn-binary?owner=" + urllib.parse.quote(owner, safe="")
           + "&tag=" + urllib.parse.quote(tag, safe="") + "&arch=" + arch)
    st, data, _hv = _panel_get(url, panel.get("token") or "", panel, timeout=200)
    if st != 200 or not data:
        return False
    if want and hashlib.sha256(data).hexdigest() != want:   # the mirror must still match the pin (belt & suspenders)
        return False
    try:
        tmp = dest + ".pdl"
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(tmp, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o755)
        os.replace(tmp, dest)
    except OSError:
        with contextlib.suppress(OSError):
            os.remove(dest + ".pdl")
        return False
    return True

def _dturn_download(svc, owner, pin=None):
    arch = _turn_arch()
    if not _turn_arch_ok():                               # no server-linux-<arch> build exists → refuse cleanly (never fetch a wrong-arch binary)
        return "no turn-proxy build for this architecture (" + os.uname().machine + ") — forks publish amd64/arm64 only"
    tag, want = _turn_pin(pin)                            # panel checksum gate: pin the tag + expected sha256 (both '' → unverified)
    binp = _turn_bin_local(svc)   # shared per-fork slot
    if os.path.exists(binp):       # already have this fork's binary (another instance, or a prior install) → REUSE,
        return ""                  # no GitHub hit. (A panel Reinstall removes binp first, so it still forces a fresh fetch.)
    try: os.makedirs(os.path.dirname(binp), exist_ok=True)
    except OSError as e: return "mkdir: " + str(e)
    leg = _turn_bin_local_legacy(svc)                    # upgrade: reuse a pre-dedup per-instance binary instead of re-downloading
    if os.path.exists(leg):
        with contextlib.suppress(OSError):
            os.replace(leg, binp); os.chmod(binp, 0o755)
        if os.path.exists(binp):
            _turn_write_version(svc, tag or _turn_resolve_tag(owner)); return ""
    if _turn_panel_fetch(owner, tag, arch, binp, want):  # P2: pull the (verified) binary from the panel mirror first — censorship-robust
        _turn_write_version(svc, tag or _turn_resolve_tag(owner)); return ""
    err = "binary download failed"
    for url in _turn_dl_urls(owner, arch, tag):          # GitHub-direct fallback (mirror miss / no pin / mixed-version)
        r = run(["curl", "-4", "-fsSL", "--connect-timeout", "20", "--max-time", "240", "--retry", "3",
                 "--retry-delay", "3", "--retry-all-errors", url, "-o", binp], timeout=320)
        if r.returncode == 0:
            if not _turn_sha_ok(binp, want):             # downloaded but doesn't match the panel's hash → delete + refuse (never chmod/exec)
                with contextlib.suppress(OSError): os.remove(binp)
                return "checksum mismatch — refusing to run unverified turn binary (want " + want[:12] + "…)"
            with contextlib.suppress(OSError): os.chmod(binp, 0o755)
            _turn_write_version(svc, tag or _turn_resolve_tag(owner))   # record which release tag we just fetched
            return ""
        err = (r.stderr or "binary download failed").strip()[:160]
    return err

def _dturn_force_download(svc, owner, pin=None):
    """Reinstall/update: fetch the fork binary FRESH and atomically swap it in — WITHOUT ever unlinking the live
    shared file. A container bind-mounts this path (…:/turn-server); if it's momentarily missing when docker
    (re)creates a container, docker creates a *directory* there and everything breaks. So: temp + os.replace only."""
    arch = _turn_arch()
    if not _turn_arch_ok():                               # reinstall/update on an unrunnable arch → refuse cleanly
        return "no turn-proxy build for this architecture (" + os.uname().machine + ") — forks publish amd64/arm64 only"
    pin_tag, want = _turn_pin(pin)                        # panel checksum gate: pin tag + expected sha (both '' → unverified)
    binp = _turn_bin_local(svc)
    try: os.makedirs(os.path.dirname(binp), exist_ok=True)
    except OSError as e: return "mkdir: " + str(e)
    tag = pin_tag or _turn_resolve_tag(owner)             # prefer the panel-pinned tag (matches the hashed asset)
    if tag and os.path.isfile(binp):                     # a sibling instance of this fork already refreshed the
        with contextlib.suppress(Exception):             # shared binary this round → reuse, don't re-download 22MB
            with open(_turn_ver_path(svc)) as f:
                if f.read().strip() == tag: return ""
    tmp = binp + ".new." + _turn_inst(svc)
    if _turn_panel_fetch(owner, tag, arch, tmp, want):   # P2: pull the (verified, chmod'd) binary from the panel mirror first
        try: os.replace(tmp, binp)                       # atomic swap; tmp was verified before this point
        except OSError as e:
            with contextlib.suppress(OSError): os.remove(tmp)
            return ("swap failed (is " + binp + " a directory? — docker bind-mount footgun): " + str(e))[:160]
        _turn_write_version(svc, tag); return ""
    err = "binary download failed"
    for url in _turn_dl_urls(owner, arch, tag):          # GitHub-direct fallback
        r = run(["curl", "-4", "-fsSL", "--connect-timeout", "20", "--max-time", "240", "--retry", "3",
                 "--retry-delay", "3", "--retry-all-errors", url, "-o", tmp], timeout=320)
        if r.returncode == 0:
            if not _turn_sha_ok(tmp, want):              # verify BEFORE the atomic swap → the live binary is never replaced by unverified bytes
                with contextlib.suppress(OSError): os.remove(tmp)
                return "checksum mismatch — refusing to run unverified turn binary (want " + want[:12] + "…)"
            with contextlib.suppress(OSError): os.chmod(tmp, 0o755)
            try: os.replace(tmp, binp)                   # atomic: the path is a valid file at every instant
            except OSError as e:
                with contextlib.suppress(OSError): os.remove(tmp)
                return ("swap failed (is " + binp + " a directory? — docker bind-mount footgun): " + str(e))[:160]
            _turn_write_version(svc, tag)                # record which release tag we just fetched
            return ""
        err = (r.stderr or "binary download failed").strip()[:160]
    with contextlib.suppress(OSError): os.remove(tmp)
    return err

def _dturn_run(tp):   # (re)create the container to match tp; returns the docker-run CompletedProcess
    svc = tp["service"]; cn = _turn_cname(svc)
    run(["docker", "rm", "-f", cn], timeout=30)   # ignore errors (may not exist yet)
    # HOST-net node: turn shares the host net → forwards to the WG interface at 127.0.0.1:<port>. BRIDGE-net node:
    # the WG interfaces are in OUR netns, so the turn container joins it (container:<us>) to reach 127.0.0.1:<port>
    # and be visible to our nft client-IP capture. In bridge, its public listen port lives in our netns → publish it
    # on the swg-node container (compose ports:). (A swg-node recreate orphans netns-joined turns; reconcile re-runs them.)
    net = ["--network", "container:" + _SELF_CONTAINER] if NODE_NET == "bridge" else ["--network", "host"]
    # Axis-2 P3: drop every capability except NET_BIND_SERVICE (bind a <1024 listen port) + no-new-privileges —
    # a turn proxy only forwards packets, so a compromised fork binary is confined to its sockets.
    harden = ["--cap-drop", "ALL", "--cap-add", "NET_BIND_SERVICE", "--security-opt", "no-new-privileges"]
    return run(["docker", "run", "-d", "--name", cn] + net + ["--restart", "unless-stopped"] + harden +
               ["-v", _turn_bin_host(svc) + ":/turn-server:ro", "--entrypoint", "/turn-server",
                SWG_TURN_IMAGE] + _dturn_args(tp), timeout=60)

def _dturn_netns_current(svc):
    """Bridge only: is the (running) turn container attached to OUR CURRENT netns? A swg-node recreate/update leaves
    its netns-joined turns pointing at the OLD (now-dead) container — docker still reports them 'running', but they're
    network-broken (can't reach the WG interface, invisible to nft capture). Our container id is our hostname, and the
    turn's NetworkMode records the full id it joined, so a stale join no longer starts with our current id → recreate."""
    if NODE_NET != "bridge":
        return True
    r = run(["docker", "inspect", "-f", "{{.HostConfig.NetworkMode}}", _turn_cname(svc)])
    return (r.stdout or "").strip().startswith("container:" + socket.gethostname())

def _dturn_verify(svc):
    time.sleep(1.5)
    r = run(["docker", "inspect", "-f", "{{.State.Running}}", _turn_cname(svc)])
    if (r.stdout or "").strip() == "true": return ""
    lg = run(["docker", "logs", "--tail", "5", _turn_cname(svc)])
    return ("turn container isn't running: " + ((lg.stderr or lg.stdout or "").strip() or "see docker logs"))[:160]

def _dturn_delete(svc, rec=None):
    run(["docker", "rm", "-f", _turn_cname(svc)], timeout=30)
    shutil.rmtree(os.path.dirname(_turn_bin_local_legacy(svc)), ignore_errors=True)   # old per-instance dir, if any
    if not _turn_fork_in_use(svc, rec):                  # last instance of this fork → drop the shared binary
        shutil.rmtree(os.path.dirname(_turn_bin_local(svc)), ignore_errors=True)

# ── turn-proxy VERSION/owner — sidecars next to the SHARED per-fork binary (one tag/owner per fork) ──
# docker: …/turn/.bin/<fork>/version.txt · bare: /opt/vk-turn-proxy/.bin/<fork>/version.txt + repo.txt.
# Reads fall back to the pre-dedup per-instance path so an un-migrated install still shows its version.
def _turn_ver_path(svc):
    if TURN_DOCKER:
        return os.path.join(os.path.dirname(_turn_bin_local(svc)), "version.txt")
    return "/opt/vk-turn-proxy/.bin/" + _turn_fork(svc) + "/version.txt"
def _turn_repo_path(svc):    # owner repo (fallback if a reinstall req lacks owner)
    if TURN_DOCKER:
        return os.path.join(os.path.dirname(_turn_bin_local(svc)), "repo.txt")
    return "/opt/vk-turn-proxy/.bin/" + _turn_fork(svc) + "/repo.txt"
def _turn_ver_path_legacy(svc):
    if TURN_DOCKER:
        return "/var/lib/swg-noded/turn/" + _turn_inst(svc) + "/version.txt"
    return "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/version.txt"

# ── Axis-1: dynamic flag discovery from the binary's own `-h` ──────────────────────────────────────────────
# The authors already "authored the manifest" — they registered every flag via Go's `flag` package. We read it
# from the (already checksum-verified, P1/P2) binary itself: run `<binary> -h`, parse name/type/default/usage,
# and report it in the snapshot. The panel overlays curated metadata (enum value-sets, secret, hide footguns);
# the SPA renders toggles (bool) / textboxes (else) + a raw-ExecStart override. We do NOT guess enum VALUES here
# (that's a curated concern) — `-h` gives structure reliably, not value-sets. See docs/TURN-PROXY-OVERHAUL-PLAN.md.
_TURN_FLAGS_CACHE = {}   # fork -> {"ver":<tag>, "flags":[...]}  (in-memory; mirrored to <fork-dir>/flags.json)

def _turn_binpath(svc):   # the shared per-fork binary this node actually runs (docker mount / bare-metal)
    if TURN_DOCKER:
        return _turn_bin_local(svc)
    return "/opt/vk-turn-proxy/.bin/" + _turn_fork(svc) + "/server"

def _turn_help_flags(text):
    """Parse Go `flag` `-h` output → [{name,type,default,usage}]. A flag line is `  -name [type]`; the following
    tab/space-indented line(s) are its usage, with `(default X)`. type '' ⇒ bool. Structure only — no enum guess."""
    flags, cur = [], None
    for ln in (text or "").splitlines():
        m = re.match(r"^  -([A-Za-z0-9][\w.-]*)(?:[ ]+(\S+))?[ ]*$", ln)
        if m:
            if cur: flags.append(cur)
            cur = {"name": m.group(1), "type": (m.group(2) or "").strip(), "usage": ""}
        elif cur is not None and (ln.startswith("\t") or ln.startswith("    ")):
            cur["usage"] += (" " if cur["usage"] else "") + ln.strip()
    if cur:
        flags.append(cur)
    for f in flags:
        dm = re.search(r'\(default (?:"([^"]*)"|(\S+?))\)', f["usage"])
        f["default"] = (dm.group(1) if (dm and dm.group(1) is not None) else (dm.group(2) if dm else "")) if dm else ""
    return flags

def _turn_discover_flags(svc):
    """Run the fork's (verified) binary with `-h` once per (fork, version) → its flag list, cached in memory +
    <fork-dir>/flags.json. Re-discovers when the version changes (a reinstall). [] on any failure — safe: the
    SPA just shows the raw-ExecStart override then."""
    fork = _turn_fork(svc)
    ver = ""
    with contextlib.suppress(Exception):
        with open(_turn_ver_path(svc)) as f:
            ver = f.read().strip()
    c = _TURN_FLAGS_CACHE.get(fork)
    if c and c.get("ver") == ver:
        return c["flags"]
    binp = _turn_binpath(svc)
    fp = os.path.join(os.path.dirname(binp), "flags.json")
    with contextlib.suppress(Exception):        # disk cache survives restarts; only re-run on a version change
        with open(fp) as f:
            d = json.load(f)
        if d.get("ver") == ver and isinstance(d.get("flags"), list):
            _TURN_FLAGS_CACHE[fork] = d
            return d["flags"]
    flags = []
    if os.path.isfile(binp):
        try:
            r = run([binp, "-h"], timeout=6)    # Go flag prints usage + exits 2; static binary, direct exec both models
            flags = _turn_help_flags((getattr(r, "stdout", "") or "") + "\n" + (getattr(r, "stderr", "") or ""))
        except Exception:
            flags = []
    rec = {"ver": ver, "flags": flags}
    _TURN_FLAGS_CACHE[fork] = rec
    with contextlib.suppress(Exception):
        with open(fp, "w") as f:
            json.dump(rec, f)
    return flags
def _turn_repo_path_legacy(svc):
    return "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/repo.txt"
def _turn_version(svc):
    for p in (_turn_ver_path(svc), _turn_ver_path_legacy(svc)):
        try:
            with open(p) as f:
                return f.read().strip()[:40]
        except Exception:
            pass
    return ""
def _turn_write_version(svc, tag):
    if not tag:
        return
    p = _turn_ver_path(svc)
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as f:
            f.write(tag.strip()[:40])
        with contextlib.suppress(OSError): os.chmod(p, 0o644)
    except OSError:
        pass
def _turn_resolve_tag(owner):
    """Latest release tag, read from the 302 of releases/latest/download (no API → no rate limit)."""
    if not owner:
        return ""
    arch = _turn_arch()
    url = "https://github.com/" + owner + "/releases/latest/download/server-linux-" + arch
    r = run(["curl", "-4", "-fsS", "-o", "/dev/null", "-w", "%{redirect_url}",
             "--connect-timeout", "15", "--max-time", "30", url], timeout=40)
    m = re.search(r"/releases/download/([^/]+)/", r.stdout or "")
    return m.group(1) if m else ""
def _attach_turn_version(tps):
    for t in tps:
        if t.get("service"):
            t["version"] = _turn_version(t["service"])

def _dturn_install(svc, req):   # returns (err, tp_record_or_None)
    owner = (req.get("owner") or "").strip(); listen = (req.get("listen") or "").strip()
    connect = (req.get("connect") or "").strip(); wrap_flags = (req.get("wrap_flags") or "").strip()
    if "/" not in owner or ":" not in listen or ":" not in connect: return "bad install request", None
    if not SWG_TURN_IMAGE or not SWG_HOST_NODE_DIR:
        return "turn-on-docker not configured (re-install the node with turn management on)", None
    if "params" in req:   # explicit ExecStart tail from the create form (verbatim, including its wrap key)
        params = (req.get("params") or "").strip()
    else:                 # legacy: build from the fork's wrap flags + a generated key
        params = (wrap_flags + " -wrap-key " + secrets.token_hex(32)) if wrap_flags else ""
    err = _dturn_download(svc, owner, req.get("pin"))   # panel checksum gate (pin absent → unverified, mixed-version safe)
    if err: return err, None
    tp = {"service": svc, "listen": listen, "connect": connect,
          "wrap_key": _params_wrapkey(params), "params": params, "owner": owner}
    _ti = (req.get("title") or "").strip()
    if _ti: tp["title"] = _ti          # optional display label, kept on the record
    r = _dturn_run(tp)
    if r.returncode != 0: return (r.stderr or "container start failed").strip()[:160], None
    verr = _dturn_verify(svc)
    return (verr, tp)   # keep the record even if down, so the panel shows it (greyed)

_DTURN_RUN = {"at": 0.0, "set": set()}
_TURN_INSTALLING = set()   # services whose container is being downloaded/(re)created RIGHT NOW → "installing"
_TURN_FAILED = set()       # services whose last install/run attempt errored → "install failed" on the panel
_TURN_ATTEMPTS = {}        # svc -> consecutive failed-download count; the bg reconcile STOPS retrying after
TURN_MAX_ATTEMPTS = 4      # this many (so a stuck 502/timeout becomes "install failed", not an endless "installing"). A manual Reinstall resets it.
# Async reinstall/update: the binary download + restart runs in a daemon thread so the sync loop STAYS RESPONSIVE
# and keeps posting snapshots — the panel sees the proxy as "updating" for the whole download (a synchronous
# reinstall blocks the loop, so the card can only jump pending→updated). apply_turn keeps the request in-flight
# (no "done" reported → turn_pending stays) while the job runs, then reports the result once it finishes.
_TURN_JOBS = {}            # svc -> {"done": bool, "err": str, "tp": dict, "at": ts}
_TURN_JOBS_LOCK = threading.Lock()
def _turn_job_launch(svc, tp, work):
    """Run work() (returns an error string, "" == success) in a daemon thread; mark the job done when it returns."""
    def _run():
        err = ""
        try:
            err = work() or ""
        except Exception as e:
            err = str(e)[:140]
        with _TURN_JOBS_LOCK:
            if svc in _TURN_JOBS:
                _TURN_JOBS[svc].update(done=True, err=err)
    with _TURN_JOBS_LOCK:
        _TURN_JOBS[svc] = {"done": False, "err": "", "tp": tp, "at": time.time()}
    threading.Thread(target=_run, daemon=True).start()

# Instances of the SAME fork share one binary (…/.bin/<fork>/server). Two reinstalls of that fork would race on the
# shared download temp / removal → "server.new: No such file" and half-updated units. Serialise per fork so the
# shared binary is refreshed by one job at a time; same-fork jobs simply queue (their cards stay "updating" while waiting).
_TURN_FORK_LOCKS = {}
_TURN_FORK_LOCKS_GUARD = threading.Lock()
def _turn_fork_lock(fork):
    with _TURN_FORK_LOCKS_GUARD:
        return _TURN_FORK_LOCKS.setdefault(fork or "", threading.Lock())
def _dturn_attach_running(tps):
    nowt = time.time()
    if nowt - _DTURN_RUN["at"] >= 15:
        r = run(["docker", "ps", "--filter", "name=swg-turn-", "--format", "{{.Names}}"])
        _DTURN_RUN["set"] = set((r.stdout or "").split()); _DTURN_RUN["at"] = nowt
    for t in tps:
        if t.get("service"):
            svc = t["service"]
            t["running"] = _turn_cname(svc) in _DTURN_RUN["set"]
            stopped = bool(t.get("stopped"))
            active = svc in _TURN_INSTALLING   # being downloaded / (re)created RIGHT NOW (only one at a time)
            failed = (svc in _TURN_FAILED) and not t["running"] and not stopped
            t["failed"] = failed
            # docker: only the proxy the bg reconcile is working on right now is "installing"; the others not
            # yet up (and not failed/stopped) are "pending" — queued for the sequential reconcile, not stuck.
            t["installing"] = active and not stopped
            t["pending"] = (not t["running"]) and (not failed) and (not stopped) and (not active)

def _dturn_ensure(tp):   # make the container match the record entry (download binary if missing, run if not up)
    svc = tp.get("service")
    if not svc:
        return
    if tp.get("stopped"):   # intentionally stopped from the panel → don't auto-(re)start it
        _TURN_INSTALLING.discard(svc)
        return
    r = run(["docker", "inspect", "-f", "{{.State.Running}}", _turn_cname(svc)])
    if (r.stdout or "").strip() == "true" and _dturn_netns_current(svc):   # running AND (bridge) joined to our LIVE netns
        _TURN_INSTALLING.discard(svc); _TURN_FAILED.discard(svc); _TURN_ATTEMPTS.pop(svc, None); NODE_PROGRESS.pop(svc, None)
        return
    if (r.stdout or "").strip() == "true":                                 # running but on a stale netns (post-recreate) → rebuild into ours
        print("swg-noded: turn %s on a stale netns after a node recreate — rebuilding into the current one" % svc, flush=True)
    if _TURN_ATTEMPTS.get(svc, 0) >= TURN_MAX_ATTEMPTS and not os.path.exists(_turn_bin_local(svc)):
        _TURN_FAILED.add(svc); _TURN_INSTALLING.discard(svc); NODE_PROGRESS.pop(svc, None)   # given up — "install failed" (a manual Reinstall resets the counter)
        return
    _TURN_INSTALLING.add(svc)   # downloading / (re)creating now → the panel shows it as "installing"
    try:
        if not os.path.exists(_turn_bin_local(svc)) and tp.get("owner"):
            NODE_PROGRESS[svc] = "Downloading the turn-proxy binary from GitHub — this can take a minute…"
            derr = _dturn_download(svc, tp["owner"])
            if derr:
                _TURN_ATTEMPTS[svc] = _TURN_ATTEMPTS.get(svc, 0) + 1
                # NON-terminating: keep retrying every pass, but tell the operator WHY it's slow so it doesn't look hung.
                NODE_PROGRESS[svc] = ("GitHub download failed (attempt %d/%d): %s. Still retrying — please wait for the install to finish."
                                       % (_TURN_ATTEMPTS[svc], TURN_MAX_ATTEMPTS, derr))
                print("swg-noded: turn %s binary download failed (attempt %d/%d): %s" % (svc, _TURN_ATTEMPTS[svc], TURN_MAX_ATTEMPTS, derr), flush=True)
        if not os.path.exists(_turn_bin_local(svc)):   # no binary yet
            if _TURN_ATTEMPTS.get(svc, 0) >= TURN_MAX_ATTEMPTS:   # stop the endless "installing" → mark failed + report it
                _TURN_FAILED.add(svc); NODE_PROGRESS.pop(svc, None)
                NODE_ERRORS[svc] = "binary download failed after %d attempts — Reinstall to retry" % TURN_MAX_ATTEMPTS
                print("swg-noded: turn %s — gave up after %d download attempts; Reinstall from the panel to retry" % (svc, TURN_MAX_ATTEMPTS), flush=True)
            else:
                print("swg-noded: turn %s has no binary yet — will retry on the next pass" % svc, flush=True)
            return
        _TURN_ATTEMPTS.pop(svc, None); NODE_ERRORS.pop(svc, None)   # got the binary → clear any prior failure
        NODE_PROGRESS[svc] = "Binary downloaded — starting the container…"
        rr = _dturn_run(tp)
        if rr.returncode != 0:
            _TURN_FAILED.add(svc); NODE_PROGRESS.pop(svc, None)
            print("swg-noded: turn %s 'docker run' failed: %s" % (svc, (rr.stderr or rr.stdout or "").strip()[:200]), flush=True)
            return
        verr = _dturn_verify(svc)
        if verr:
            _TURN_FAILED.add(svc); NODE_PROGRESS.pop(svc, None)
            print("swg-noded: turn %s started but didn't stay up: %s" % (svc, verr), flush=True)
        else:
            _TURN_FAILED.discard(svc); NODE_PROGRESS.pop(svc, None)
            print("swg-noded: turn %s container (re)started (%s)" % (svc, _turn_cname(svc)), flush=True)
    finally:
        _TURN_INSTALLING.discard(svc)

def _dturn_reconcile():   # startup/periodic: ensure every recorded turn-proxy has a running container
    if not TURN_DOCKER:
        return
    tps = load_turn_proxies()
    if not tps:
        return
    if not (SWG_TURN_IMAGE and SWG_HOST_NODE_DIR):   # the #1 silent failure — say so loudly
        print("swg-noded: %d turn-proxy record(s) present but turn-on-docker isn't configured "
              "(SWG_TURN_IMAGE=%r SWG_HOST_NODE_DIR=%r) — re-install the node with turn management ON"
              % (len(tps), SWG_TURN_IMAGE, SWG_HOST_NODE_DIR), flush=True)
        return
    for tp in tps:
        try:
            _dturn_ensure(tp)
        except Exception as e:
            print("swg-noded: turn reconcile %s failed: %s" % (tp.get("service"), e), flush=True)

def _dturn_bg_loop():   # background thread: keep turn-proxy containers up WITHOUT blocking the sync loop, so the
    while True:         # node appears on the panel right away and the cards fill in (installing → up) as each starts
        try:
            _dturn_reconcile()
        except Exception as e:
            print("swg-noded: turn reconcile error: %s" % e, flush=True)
        time.sleep(30)


# ───────── bare-metal turn-proxies: systemd unit + EnvironmentFile (edit = rewrite env, NO daemon-reload) ─────────
# The connect/listen/params live in a turn.env next to the binary; ExecStart references them as ${SWG_…}.
# Editing a turn-proxy then only rewrites turn.env + `systemctl restart` — systemd re-parsing EVERY unit
# (daemon-reload) was the CPU spike. Old units (values baked into ExecStart) are migrated on first edit.
def _turn_env_path(svc): return "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/turn.env"
_WANIF_RE = re.compile(r"^[A-Za-z0-9._-]{1,15}$")
def _safe_wan(w, fallback):
    """A WAN NIC name safe to splice into an iptables rule (which is later re-parsed from `iptables -S` and
    deleted via sh) — blocks ; ` $ | & from a compromised/MITM panel. Invalid → the auto-detected fallback."""
    w = (w or "").strip()
    return w if (w and _WANIF_RE.match(w)) else fallback


_TURN_CTRL_RE = re.compile(r"[\x00-\x1f\x7f]")
def _turn_input_safe(*vals):
    """Defence-in-depth: refuse turn params carrying control chars. They are interpolated into a systemd
    unit + env heredoc executed as root, so a newline could terminate the heredoc and inject a command.
    The panel validates these too — this is the belt on the node against a compromised or MITM'd panel."""
    return all(not _TURN_CTRL_RE.search(v or "") for v in vals)


def _turn_env_text(listen, connect, params):
    return "SWG_LISTEN=%s\nSWG_CONNECT=%s\nSWG_PARAMS=%s\n" % (listen, connect, (params or "").strip())
def _exec_bin(execl):
    try: return shlex.split(execl)[0]
    except Exception: return (execl.split() or [""])[0]
def _unit_is_envform(unit_text): return "${SWG_" in _exec_of(unit_text)

def _tp_from_unit(svc, unit_text):
    """Resolve a turn-proxy's config from its unit. EnvironmentFile form → read turn.env; old form → ExecStart."""
    if not _unit_is_envform(unit_text):
        return _parse_tp(svc, _exec_of(unit_text))
    env = host_sh("cat " + shlex.quote(_turn_env_path(svc)) + " 2>/dev/null").stdout or ""
    vals = {}
    for ln in env.splitlines():
        k, _, v = ln.partition("="); vals[k.strip()] = v.strip()
    params = vals.get("SWG_PARAMS", "")
    return {"service": svc, "listen": vals.get("SWG_LISTEN", ""), "connect": vals.get("SWG_CONNECT", ""),
            "wrap_key": _params_wrapkey(params), "params": params}

# Axis-2 P3: systemd sandbox for the turn-proxy unit. A turn proxy only shuffles bytes between two sockets, so
# confine it hard — a compromised/malicious fork binary is contained to its sockets, not root-on-the-box. The
# reinstall (binary swap) runs as root via host_sh OUTSIDE this sandbox, so ProtectSystem=strict doesn't block it.
# ⚠️ SystemCallFilter=@system-service is the one directive that could refuse an unusual Go syscall → if a proxy
# fails to start right after a deploy, check `journalctl -u <svc>` for a seccomp kill and this is the first suspect.
# Existing (pre-P3) units get hardened on their next reinstall/migration, not retroactively.
_TURN_HARDEN_KEYS = ("NoNewPrivileges", "ProtectSystem", "ProtectHome", "PrivateTmp", "ProtectKernelTunables",
                     "ProtectKernelModules", "ProtectControlGroups", "RestrictAddressFamilies", "RestrictNamespaces",
                     "RestrictSUIDSGID", "LockPersonality", "CapabilityBoundingSet", "SystemCallFilter", "SystemCallErrorNumber")
TURN_UNIT_HARDENING = (
    "NoNewPrivileges=yes\nProtectSystem=strict\nProtectHome=yes\nPrivateTmp=yes\n"
    "ProtectKernelTunables=yes\nProtectKernelModules=yes\nProtectControlGroups=yes\n"
    "RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK\nRestrictNamespaces=yes\nRestrictSUIDSGID=yes\n"
    "LockPersonality=yes\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\n"
    "SystemCallFilter=@system-service\nSystemCallErrorNumber=EPERM\n")

def _unit_to_envform(unit_text, svc, binp):
    """Rewrite a baked-ExecStart unit to the EnvironmentFile form (one-time migration) + apply the P3 sandbox."""
    envp = _turn_env_path(svc); out = []; have_ef = any(l.startswith("EnvironmentFile=") for l in unit_text.splitlines())
    for l in unit_text.splitlines():
        if l.startswith("ExecStart="):
            if not have_ef: out.append("EnvironmentFile=-" + envp)
            out.append("ExecStart=" + binp + " -listen ${SWG_LISTEN} -connect ${SWG_CONNECT} $SWG_PARAMS")
        elif l.startswith("EnvironmentFile="):
            out.append("EnvironmentFile=-" + envp)
        elif any(l.split("=", 1)[0].strip() == k for k in _TURN_HARDEN_KEYS):
            continue                                    # drop any stale hardening lines; re-added fresh below
        else:
            out.append(l)
    hard = TURN_UNIT_HARDENING.rstrip("\n").split("\n")   # inject the sandbox at the end of [Service] (before [Install])
    if "[Install]" in out:
        i = out.index("[Install]")
        out = out[:i] + hard + [""] + out[i:]
    else:
        out += hard
    return "\n".join(out) + "\n"

def _turn_install(svc, req):
    """Install a new turn-proxy: download the fork's prebuilt binary, write the systemd unit, enable
    it. Mirrors the installer's install_turn_binary (server-linux-<arch>). '' on success, else error."""
    owner = (req.get("owner") or "").strip()
    listen = (req.get("listen") or "").strip()
    connect = (req.get("connect") or "").strip()
    wrap_flags = (req.get("wrap_flags") or "").strip()
    if "/" not in owner or ":" not in listen or ":" not in connect:
        return "bad install request"
    if not _turn_input_safe(owner, listen, connect, wrap_flags, req.get("params")):
        return "refused: control characters in turn parameters"
    inst = svc[len("vk-turn-proxy-"):] if svc.startswith("vk-turn-proxy-") else svc
    fork = _turn_fork(svc)
    fdir = "/opt/vk-turn-proxy/.bin/" + fork   # shared per-fork: one binary + version.txt + repo.txt for every instance
    sbin = fdir + "/server"
    d = "/opt/vk-turn-proxy/" + inst           # per-instance: turn.env + a 'server' symlink → the shared binary
    binp = d + "/server"
    arch = _turn_arch()
    extra = ""
    if "params" in req:   # explicit ExecStart tail from the create form (verbatim, including its wrap key)
        extra = (req.get("params") or "").strip()
    elif wrap_flags:
        key = secrets.token_hex(32)   # 64 hex chars, no openssl dependency (the slim image lacks it)
        if not key:
            return "keygen failed"
        extra = wrap_flags + " -wrap-key " + key
    envp = _turn_env_path(svc)
    unit = ("[Unit]\nDescription=vk-turn-proxy (" + owner + ") - " + listen + " -> " + connect + "\n"
            "After=network-online.target\nWants=network-online.target\n\n"
            "[Service]\nEnvironmentFile=-" + envp + "\n"
            "ExecStart=" + binp + " -listen ${SWG_LISTEN} -connect ${SWG_CONNECT} $SWG_PARAMS\n"
            "Restart=on-failure\nRestartSec=3\n" + TURN_UNIT_HARDENING + "\n"
            "[Install]\nWantedBy=multi-user.target\n")
    pin_tag, want = _turn_pin(req.get("pin"))             # panel checksum gate: pin the immutable tag + expected sha256
    tag = pin_tag or _turn_resolve_tag(owner)
    _turn_panel_fetch(owner, tag, arch, sbin, want)       # P2: place the (verified) binary from the panel mirror → the heredoc's [ -x sbin ] then skips GitHub
    dl = " || ".join("curl -4 -fsSL --connect-timeout 20 --max-time 240 --retry 3 --retry-delay 3 --retry-all-errors "
                     + shlex.quote(u) + " -o " + shlex.quote(sbin) for u in _turn_dl_urls(owner, arch, tag))
    # verify ONLY a freshly downloaded binary (reuse of this fork's already-present binary, incl. a panel-mirror pull above = validated already)
    dlblock = "{ [ -x " + shlex.quote(sbin) + " ] || { { " + dl + "; }" + _turn_sha_shell(shlex.quote(sbin), want) + "; }; }"
    cmd = ("mkdir -p " + shlex.quote(fdir) + " " + shlex.quote(d)
           + " && " + dlblock + " && chmod 755 " + shlex.quote(sbin)
           + " && ln -sfn " + shlex.quote("../.bin/" + fork + "/server") + " " + shlex.quote(binp)
           + " && printf %s " + shlex.quote(owner) + " > " + shlex.quote(fdir + "/repo.txt")
           + ((" && printf %s " + shlex.quote(tag) + " > " + shlex.quote(fdir + "/version.txt")) if tag else "")
           + " && cat > " + shlex.quote(envp) + " <<'SWGENV'\n" + _turn_env_text(listen, connect, extra) + "SWGENV\n"
           + "cat > " + shlex.quote(_turn_unit_path(svc)) + " <<'SWGEOF'\n" + unit + "SWGEOF\n"
           + "systemctl daemon-reload && systemctl enable --now " + shlex.quote(svc) + " >/dev/null 2>&1")
    w = host_sh(cmd, timeout=210)
    if w.returncode != 0:
        return (w.stderr or w.stdout or "install failed").strip()[:160]
    return _turn_verify(svc)   # enable --now returns 0 even if the binary crash-loops — confirm it stays up

def _turn_verify(svc):
    """Confirm a turn-proxy service is actually running after install/edit. enable/restart returns 0 as
    soon as the binary is exec'd, so a crash-loop (e.g. a -listen IP not local to the host → bind fails)
    looks like success — this catches it + returns the journal reason so the panel can show it."""
    v = host_sh("sleep 1.5; systemctl is-active " + shlex.quote(svc) + " 2>/dev/null; "
                "journalctl -u " + shlex.quote(svc) + " -n 5 --no-pager -o cat 2>/dev/null | grep -iE 'error|invalid|fail|bind|address|panic' | tail -1")
    lines = (v.stdout or "").strip().splitlines()
    if lines and lines[0] == "active":
        return ""
    reason = lines[-1] if len(lines) > 1 else "not running (check the -listen IP is an address on this host)"
    return "service didn't stay up: " + reason[:150]

def apply_turn(turn, turn_onboard):
    """Apply panel turn-proxy requests (manage/rotate/delete) + onboard host .service units, then
    update the turn record so the snapshot reflects it (which clears the panel request)."""
    res = {"done": [], "errors": []}
    if not turn and not turn_onboard:
        return res
    keys = set(turn or {}) | set(turn_onboard or [])
    print("turn: applying " + str(sorted(keys)) + " manage_on=" + str(TURN_MANAGE_ON)
          + " kind=" + NODE_KIND, flush=True)
    def fail(k, m):
        res["errors"].append(k + ": " + m); NODE_ERRORS[k] = m
        print("turn: FAIL " + k + " -> " + m, flush=True)
    def good(k, tag):
        res["done"].append(tag); NODE_ERRORS.pop(k, None)
        print("turn: ok " + tag, flush=True)
    if not TURN_MANAGE_ON:
        for k in keys:
            fail(k, "turn management off — re-install the docker node with the 'panel' option")
        return res
    rec = {tp.get("service"): tp for tp in load_turn_proxies() if tp.get("service")}
    changed = False
    for svc, req in (turn or {}).items():
        try:
            act = req.get("action")
            if TURN_DOCKER:                                   # ── container model ──
                if act == "install":
                    err, tp = _dturn_install(svc, req)
                    if tp is not None: rec[svc] = tp; changed = True
                    fail(svc, err) if err else good(svc, "ins:" + svc)
                    continue
                if act == "delete":
                    _dturn_delete(svc, rec); rec.pop(svc, None); changed = True; good(svc, "del:" + svc); continue
                if act == "reinstall":      # force a fresh binary (fix a failed download / update to latest) + (re)create — ASYNC (see _TURN_JOBS)
                    with _TURN_JOBS_LOCK: _job = dict(_TURN_JOBS.get(svc) or {})
                    if _job and not _job.get("done"):
                        continue                            # still downloading/recreating → keep it in-flight (card stays "updating")
                    if _job and _job.get("done"):           # thread finished → report the result + clear the job
                        with _TURN_JOBS_LOCK: _TURN_JOBS.pop(svc, None)
                        NODE_PROGRESS.pop(svc, None); _TURN_INSTALLING.discard(svc)
                        if _job.get("err"):
                            _TURN_FAILED.add(svc); fail(svc, _job["err"])
                        else:
                            rec[svc] = _job.get("tp") or rec.get(svc); changed = True; _TURN_FAILED.discard(svc); good(svc, "rei:" + svc)
                        continue
                    tp = rec.get(svc) or {"service": svc, "listen": req.get("listen", ""), "connect": req.get("connect", ""), "params": req.get("params", "")}
                    if req.get("owner"): tp["owner"] = req["owner"].strip()
                    if not tp.get("owner"):
                        fail(svc, "no owner repo for reinstall"); continue
                    _TURN_ATTEMPTS.pop(svc, None)   # manual retry → clear the give-up counter so the bg reconcile resumes if this one also fails
                    _TURN_INSTALLING.add(svc)       # mark "installing/updating" for the docker card (attach_running keys off this set,
                                                    # overriding load_turn_proxies' job flag) — cleared in the done handler below
                    _pin = req.get("pin")           # panel checksum gate — capture before the thread (req isn't in the closure's scope later)
                    def _work(svc=svc, tp=tp, pin=_pin):      # runs in a thread — download fresh + (re)create the container
                        with _turn_fork_lock(_turn_fork(svc)):   # serialise same-fork refreshes; atomic-swap the shared binary
                            with contextlib.suppress(OSError): os.remove(_turn_bin_local_legacy(svc))   # drop a stale pre-dedup copy
                            derr = _dturn_force_download(svc, tp["owner"], pin)
                        if derr: return derr
                        r = _dturn_run(tp)
                        if r.returncode != 0: return (r.stderr or "container start failed").strip()[:120]
                        return _dturn_verify(svc)
                    _turn_job_launch(svc, tp, _work)
                    continue                                 # in flight now — don't report done yet (card shows "updating")
                if act == "title":            # cosmetic label only → update the record, DON'T touch the container
                    tp = rec.get(svc)
                    if not tp:
                        fail(svc, "turn-proxy not in the node record"); continue
                    tp["title"] = (req.get("title") or "").strip(); rec[svc] = tp; changed = True
                    good(svc, "title:" + svc); continue
                if act == "stop":             # stop + remove the container; the 'stopped' flag keeps the bg reconcile from restarting it
                    tp = rec.get(svc)
                    if not tp:
                        fail(svc, "turn-proxy not in the node record"); continue
                    run(["docker", "rm", "-f", _turn_cname(svc)])
                    tp["stopped"] = True; rec[svc] = tp; changed = True
                    _TURN_INSTALLING.discard(svc); _TURN_FAILED.discard(svc); _TURN_ATTEMPTS.pop(svc, None); NODE_PROGRESS.pop(svc, None)
                    good(svc, "stop:" + svc); continue
                if act == "start":            # clear 'stopped' + (re)create the container
                    tp = rec.get(svc)
                    if not tp:
                        fail(svc, "turn-proxy not in the node record"); continue
                    tp.pop("stopped", None); rec[svc] = tp; changed = True
                    r = _dturn_run(tp)
                    if r.returncode != 0:
                        _TURN_FAILED.add(svc); fail(svc, (r.stderr or "container start failed").strip()[:120]); continue
                    verr = _dturn_verify(svc)
                    fail(svc, verr) if verr else good(svc, "start:" + svc)
                    continue
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                if act == "manage":
                    if req.get("listen"):  tp["listen"] = req["listen"].strip()
                    if req.get("connect"): tp["connect"] = req["connect"].strip()
                    if "params" in req:    tp["params"] = (req.get("params") or "").strip(); tp["wrap_key"] = _params_wrapkey(tp["params"])
                    if "title" in req:     tp["title"] = (req.get("title") or "").strip()
                elif act == "rotate":
                    nk = secrets.token_hex(32); tp["params"] = _params_set_wrapkey(tp.get("params", ""), nk); tp["wrap_key"] = nk
                # restart: no config change — just recreate the container
                r = _dturn_run(tp)
                if r.returncode != 0:
                    fail(svc, (r.stderr or "container start failed").strip()[:120]); continue
                rec[svc] = tp; changed = True
                verr = _dturn_verify(svc)
                fail(svc, verr) if verr else good(svc, act + ":" + svc)
                continue
            up = _turn_unit_path(svc)                          # ── bare-metal systemd model ──
            if act == "install":
                err = _turn_install(svc, req)
                if err:
                    fail(svc, err)
                else:
                    rec[svc] = _installed_tp(svc)
                    _ti = (req.get("title") or "").strip()
                    if _ti: rec[svc]["title"] = _ti
                    changed = True; good(svc, "ins:" + svc)
                continue
            if act == "delete":
                w = host_sh("systemctl disable --now " + shlex.quote(svc) + " >/dev/null 2>&1; "
                            "rm -f " + shlex.quote(up) + "; systemctl daemon-reload")
                if w.returncode != 0:
                    fail(svc, (w.stderr or "remove failed").strip()[:120]); continue
                rec.pop(svc, None); changed = True; good(svc, "del:" + svc); continue
            if act == "reinstall":          # re-download the binary (fix/update) + restart the unit — ASYNC (see _TURN_JOBS)
                with _TURN_JOBS_LOCK: _job = dict(_TURN_JOBS.get(svc) or {})
                if _job and not _job.get("done"):
                    continue                                 # download/restart running → keep in-flight (card "updating")
                if _job and _job.get("done"):
                    with _TURN_JOBS_LOCK: _TURN_JOBS.pop(svc, None)
                    NODE_PROGRESS.pop(svc, None)
                    fail(svc, _job["err"]) if _job.get("err") else good(svc, "rei:" + svc)
                    continue
                owner = (req.get("owner") or "").strip()
                if not owner:               # fall back to the recorded repo.txt (shared fork dir, then pre-dedup per-instance)
                    for rp in (_turn_repo_path(svc), _turn_repo_path_legacy(svc)):
                        try:
                            with open(rp) as f: owner = f.read().strip()
                        except Exception: owner = ""
                        if owner: break
                if not owner:
                    fail(svc, "no owner repo for reinstall"); continue
                arch = _turn_arch()
                fork = _turn_fork(svc)
                pin_tag, want = _turn_pin(req.get("pin"))                     # panel checksum gate: pin tag + expected sha256
                sbin = "/opt/vk-turn-proxy/.bin/" + fork + "/server"          # shared per-fork binary (a reinstall refreshes it for every instance of the fork)
                binp = "/opt/vk-turn-proxy/" + _turn_inst(svc) + "/server"    # this instance's symlink → the shared binary
                tag = pin_tag or _turn_resolve_tag(owner); vp = _turn_ver_path(svc)
                tmp = sbin + ".new." + _turn_inst(svc)   # per-instance temp then atomically mv over the LIVE binary — curl -o onto a
                dl = " || ".join("curl -4 -fsSL --connect-timeout 20 --max-time 240 --retry 3 --retry-delay 3 --retry-all-errors "   # running executable fails ETXTBSY ("Failure
                                 + shlex.quote(u) + " -o " + shlex.quote(tmp) for u in _turn_dl_urls(owner, arch, tag))          # writing output"); rename keeps the old
                cmd = ("mkdir -p " + shlex.quote(os.path.dirname(sbin)) + " " + shlex.quote(os.path.dirname(binp))          # inode for the running proc until restart.
                       + " && ( [ -f " + shlex.quote(tmp) + " ] || ( " + dl + " ) ) && chmod 755 " + shlex.quote(tmp)      # [ -f tmp ]: the panel-mirror pull (in _work) already placed it → skip GitHub. verify BEFORE the swap either way.
                       + _turn_sha_shell(shlex.quote(tmp), want) + " && mv -f " + shlex.quote(tmp) + " " + shlex.quote(sbin)
                       + " && ln -sfn " + shlex.quote("../.bin/" + fork + "/server") + " " + shlex.quote(binp)
                       + " && printf %s " + shlex.quote(owner) + " > " + shlex.quote(_turn_repo_path(svc)))
                if tag:
                    cmd += " && printf %s " + shlex.quote(tag) + " > " + shlex.quote(vp) + " && chmod 644 " + shlex.quote(vp)
                cmd += " && systemctl restart " + shlex.quote(svc)
                def _work(cmd=cmd, svc=svc, fork=fork, owner=owner, tag=tag, arch=arch, tmp=tmp, want=want):    # runs in a thread; serialise same-fork refreshes on the shared binary
                    with _turn_fork_lock(fork):
                        _turn_panel_fetch(owner, tag, arch, tmp, want)   # P2: pull the (verified) binary from the panel mirror → the heredoc's [ -f tmp ] then skips GitHub
                        w = host_sh(cmd, timeout=340)
                    if w.returncode != 0: return (w.stderr or "reinstall failed").strip()[:140]
                    return _turn_verify(svc)
                _turn_job_launch(svc, rec.get(svc), _work)
                continue
            if act == "title":                # cosmetic label only → update the record, DON'T restart the unit
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                tp["title"] = (req.get("title") or "").strip(); rec[svc] = tp; changed = True
                good(svc, "title:" + svc); continue
            if act == "stop":                 # stop + disable the unit; 'stopped' flag distinguishes it from a crash
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                host_sh("systemctl disable --now " + shlex.quote(svc) + " >/dev/null 2>&1; systemctl stop " + shlex.quote(svc) + " >/dev/null 2>&1; true")
                tp["stopped"] = True; rec[svc] = tp; changed = True; good(svc, "stop:" + svc); continue
            if act == "start":                # re-enable + start the unit
                tp = rec.get(svc)
                if not tp:
                    fail(svc, "turn-proxy not in the node record"); continue
                w = host_sh("systemctl enable --now " + shlex.quote(svc))
                if w.returncode != 0:
                    fail(svc, (w.stderr or "start failed").strip()[:120]); continue
                tp.pop("stopped", None); rec[svc] = tp; changed = True
                verr = _turn_verify(svc)
                fail(svc, verr) if verr else good(svc, "start:" + svc)
                continue
            unit = host_sh("cat " + shlex.quote(up) + " 2>/dev/null").stdout
            if not unit:
                fail(svc, "unit not found on the node"); continue
            cur = _tp_from_unit(svc, unit)   # resolves env-file or old baked-ExecStart units
            listen, connect, params = cur.get("listen", ""), cur.get("connect", ""), cur.get("params", "")
            if act == "manage":
                if req.get("listen"):  listen = req["listen"].strip()
                if req.get("connect"): connect = req["connect"].strip()
                if "params" in req:    params = (req.get("params") or "").strip()
                if not _turn_input_safe(listen, connect, params):   # belt on the node vs a compromised/MITM panel
                    fail(svc, "refused: control characters in turn parameters"); continue
            elif act == "rotate":
                params = _params_set_wrapkey(params, secrets.token_hex(32))
            # restart: no config change — just rewrite turn.env (unchanged) + restart below
            envp = _turn_env_path(svc)
            env_here = "cat > " + shlex.quote(envp) + " <<'SWGENV'\n" + _turn_env_text(listen, connect, params) + "SWGENV\n"
            if _unit_is_envform(unit):       # fast path: rewrite turn.env + restart, NO daemon-reload (the spike)
                w = host_sh(env_here + "systemctl restart " + shlex.quote(svc))
            else:                            # one-time migrate: move the baked ExecStart onto the EnvironmentFile
                new_unit = _unit_to_envform(unit, svc, _exec_bin(_exec_of(unit)))
                w = host_sh("mkdir -p " + shlex.quote(os.path.dirname(envp)) + "\n" + env_here
                            + "cat > " + shlex.quote(up) + " <<'SWGEOF'\n" + new_unit + "SWGEOF\n"
                            + "systemctl daemon-reload && systemctl restart " + shlex.quote(svc))
            if w.returncode != 0:
                fail(svc, (w.stderr or "restart failed").strip()[:120]); continue
            _ti = req.get("title")   # set if the request carried one, else preserve the existing record's title
            _ti = _ti.strip() if isinstance(_ti, str) else (rec.get(svc) or {}).get("title", "")
            rec[svc] = {"service": svc, "listen": listen, "connect": connect,
                        "wrap_key": _params_wrapkey(params), "params": params}   # reflect even if it won't start
            if _ti: rec[svc]["title"] = _ti
            changed = True
            verr = _turn_verify(svc)
            if verr:
                fail(svc, verr); continue   # report not-running; the record already shows the new (broken) params
            good(svc, act + ":" + svc)
        except Exception as e:
            fail(svc, str(e))
    for sp in (turn_onboard or []):
        try:
            unit = host_sh("cat " + shlex.quote(sp) + " 2>/dev/null").stdout
            if not unit:
                fail(sp, "unit not found at that path"); continue
            base = os.path.basename(sp)
            svc = base[:-8] if base.endswith(".service") else base
            rec[svc] = _parse_tp(svc, _exec_of(unit)); changed = True; good(sp, "onb:" + svc)
        except Exception as e:
            fail(sp, str(e))
    if changed:
        try:
            tmp = TURN_RECORD + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"turn_proxies": list(rec.values())}, f)
            os.replace(tmp, TURN_RECORD)
        except Exception as e:
            res["errors"].append("record: " + str(e))
    return res


# ───────── WDTT (amurcanov/proxy-turn-vk-android): self-contained key-owning VPN as a node service ─────────
# Unlike the -connect turn forks, a WDTT instance OWNS its own userspace-WG interface (built-in). So the panel
# manages it declaratively (like desired_ifaces, NOT request/ack): each sync ships the desired WDTT instance set
# incl. the panel-owned generated-password set; the node installs missing instances, writes a panel-owned
# desired.json + SIGHUPs (WDTT reconciles it with no restart / no tunnel drop — see wdtt/README.md), and removes
# instances no longer desired. WDTT stays the sole writer of its runtime passwords.json (device bindings +
# traffic), which the node reads back into the snapshot. Runs with -no-nat; the node owns the wdtt-subnet
# MASQUERADE via reconcile_egress. Bare-metal only (a container can't reach the userspace-wg UAPI). The unit is
# right-sized for a WG server (CAP_NET_ADMIN + /dev/net/tun), NOT the tight turn-proxy sandbox.
# On docker /opt/... is the container's EPHEMERAL layer — a recreate would lose wg-keys.dat (the server identity) →
# every GETCONF'd client breaks. Root WDTT state under the PERSISTED node volume (/var/lib/swg-noded → ./data/node)
# so identity + the install record survive a container recreate, exactly like bare-metal's on-disk /opt.
WDTT_RECORD = os.environ.get("SWG_WDTT_RECORD") or ("/var/lib/swg-noded/wdtt.json" if NODE_KIND == "docker" else "/etc/swg-agent/wdtt.json")
WDTT_ROOT = "/var/lib/swg-noded/wdtt" if NODE_KIND == "docker" else "/opt/swg-wdtt"   # per-instance: <root>/<iface>/{server, wdtt.env, desired.json, passwords.json, wg-keys.dat}
WDTT_BIN_DIR = WDTT_ROOT + "/.bin"               # per-fork/arch binary slot; our patched build
WDTT_OWNER = "amurcanov/proxy-turn-vk-android"   # default fork's panel-mirror key
# WDTT fork family: fork id -> panel-mirror owner key. The node pulls each fork's binary from the panel
# mirror keyed on this owner + the "wdtt" tag; the panel maps that to our release (WDTT_BUILDS).
WDTT_FORK_OWNER = {"amurcanov": "amurcanov/proxy-turn-vk-android", "ildarmaga": "ildarmaga/wdtt",
                   "wdttplus": "Ivan4537/WDTT-Plus", "xxcipherx": "XXcipherX/proxy-turn-vk-android"}
def _wdtt_fork(inst):
    f = (inst.get("fork") or "amurcanov").strip()
    return f if f in WDTT_FORK_OWNER else "amurcanov"   # unknown → default (also blocks path injection via the fork string)
# An ADOPTED server keeps the name it already had — we don't get to choose it. The name is used as a unit suffix
# and a directory component, so "safe as a path component" is the actual requirement. Keeping the narrow wdtt<N>
# rule here refused a perfectly good adoption AFTER the seed had already stopped the foreign server.
_WDTT_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$")
_WDTT_CIDR_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}/\d{1,2}$")

def _wdtt_svc(iface): return "swg-wdtt-" + iface
def _wdtt_dir(iface): return WDTT_ROOT + "/" + iface
def _wdtt_unit_path(iface): return TURN_UNIT_DIR + "/" + _wdtt_svc(iface) + ".service"
def _wdtt_bin_shared(fork): return WDTT_BIN_DIR + "/" + fork + "/" + _turn_arch() + "/wdtt-server"
def _wdtt_keyfile(iface): return _wdtt_dir(iface) + "/wg-keys.dat"

_WDTT_PW_CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789"   # WDTT's own unambiguous alphabet
def _gen_wdtt_password():
    """The owner/bootstrap -password. NODE-OWNED (the panel never holds it): minted here on first install,
    persisted in the node record + wdtt.env, and sealed to the operator vault so it survives a full wipe."""
    return "".join(secrets.choice(_WDTT_PW_CHARS) for _ in range(16))

def _wdtt_load():
    try:
        with open(WDTT_RECORD) as f:
            d = json.load(f)
        w = d.get("wdtt") if isinstance(d, dict) else None
        return {i["iface"]: i for i in (w or []) if isinstance(i, dict) and i.get("iface")}
    except Exception:
        return {}

def _wdtt_save(instances):
    with contextlib.suppress(Exception):
        os.makedirs(os.path.dirname(WDTT_RECORD), exist_ok=True)
        tmp = WDTT_RECORD + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"wdtt": list(instances.values())}, f)
        os.replace(tmp, WDTT_RECORD)
    return os.path.isfile(WDTT_RECORD)   # the caller reports a failed write: adopt_failed / await_restore /
                                         # panel_managed all live in this file, and losing it silently reverts
                                         # an acknowledged instance to "never acknowledged"

def _wdtt_subnet(cidr):
    """10.66.79.1/24 → 10.66.79.0/24 (the -s match for the egress MASQUERADE)."""
    try:
        return str(ipaddress.ip_network(cidr, strict=False))
    except Exception:
        return ""

def _wdtt_valid(inst):
    """Defence-in-depth: refuse control chars (interpolated into a root heredoc) + basic shape. The panel
    validates too — this is the belt on the node against a compromised/MITM panel."""
    if not _WDTT_NAME_RE.match(inst.get("iface") or ""):
        return False
    if not _WDTT_CIDR_RE.match(inst.get("wg_addr") or ""):
        return False
    if ":" not in (inst.get("listen") or ""):
        return False
    strs = [inst.get("iface"), inst.get("wg_addr"), inst.get("listen"), str(inst.get("wg_port") or ""),
            inst.get("password") or "", inst.get("params") or ""]
    for pw, e in (inst.get("passwords") or {}).items():
        strs.append(pw)
        if isinstance(e, dict):
            strs += [e.get("vk_hash") or "", e.get("ports") or ""]
    return _turn_input_safe(*strs)

def _wdtt_desired_body(passwords):
    """The panel-owned desired.json body — only the four panel-owned fields per password (never runtime state)."""
    out = {}
    for pw, e in (passwords or {}).items():
        e = e or {}
        out[pw] = {"expires_at": int(e.get("expires_at") or 0), "vk_hash": str(e.get("vk_hash") or ""),
                   "ports": str(e.get("ports") or ""), "is_deactivated": bool(e.get("is_deactivated"))}
    return json.dumps({"passwords": out})

def _wdtt_serve_adopted(inst):
    """Union the users recovered from a taken-over server into the set this instance SERVES, for as long as the
    hand-off to the panel is open. Without it the take-over starts our server with only the roster's pre-existing
    peers, so every client the foreign server already had is refused ("wrong connection password") until the
    import lands a sync or two later — a visible outage in the one flow whose whole promise is that existing
    clients keep working. Union, never replace: a password the panel already sends wins, and the extra entries
    evaporate the moment the hand-off closes."""
    au = inst.get("adopt_users") or {}
    if not au:
        return
    dtls = (str(inst.get("listen") or "").rsplit(":", 1)[-1]) or "56000"
    ports = dtls + "," + str(inst.get("wg_port") or 56001) + ",9000"   # same shape the panel composes
    pwds = dict(inst.get("passwords") or {})
    for pw, m in au.items():
        if pw in pwds:
            continue
        m = m if isinstance(m, dict) else {}
        pwds[pw] = {"expires_at": int(m.get("expires_at") or 0), "vk_hash": str(m.get("vk_hash") or ""),
                    "ports": ports, "is_deactivated": bool(m.get("is_deactivated"))}
    inst["passwords"] = pwds


def _wdtt_env_text(inst):
    cfgdir = _wdtt_dir(inst["iface"])
    return ("SWG_IFACE=%s\nSWG_WGADDR=%s\nSWG_LISTEN=%s\nSWG_WGPORT=%s\nSWG_CFGDIR=%s\nSWG_DESIRED=%s\n"
            "SWG_PASSWORD=%s\nSWG_MAXPW=%s\nSWG_PARAMS=%s\n" % (
                inst["iface"], inst["wg_addr"], inst["listen"], inst.get("wg_port") or 56001, cfgdir,
                cfgdir + "/desired.json", inst.get("password") or "",
                inst.get("max_passwords") or _wdtt_maxpw_for(inst.get("wg_addr") or ""),
                (inst.get("params") or "").strip()))   # operator extra ExecStart flags (systemd splits on whitespace → argv, never a shell)

def _wdtt_unit_text(iface, binp, cfgdir, fork):
    # Right-sized for a WireGuard server (validated live): NET_ADMIN + /dev/net/tun, config-dir the only
    # writable path. NOT the turn sandbox (CAP_NET_BIND_SERVICE-only would block TUN creation).
    # Per-fork tail: both forks share -config-dir/-desired/-no-nat/-password (unified desired.json+SIGHUP
    # contract). ildarmaga uses -max-users (not -max-passwords), -fixed-config (device-agnostic, wg parity),
    # and a per-instance localhost admin port (reuses SWG_WGPORT — TCP:port ≠ the WG UDP:port).
    if fork == "ildarmaga":
        # The current ildarmaga build registers NO -no-panel flag (the panel is gated internally + its DB is already
        # redirected to the config-dir, so nothing writes /etc/wdtt); passing -no-panel crashes it with
        # "flag provided but not defined". It DOES run a localhost admin endpoint (default 127.0.0.1:2861), so give
        # each instance its own port (reuse the WG port number — TCP ≠ the WG UDP socket) to avoid a multi-instance clash.
        forkflags = " -password ${SWG_PASSWORD} -max-users ${SWG_MAXPW} -fixed-config -admin-addr 127.0.0.1:${SWG_WGPORT}"
    elif fork == "wdttplus":
        # wdttplus has an in-app admin socket + Telegram bot (unused under -desired) → -no-panel, like ildarmaga.
        forkflags = " -password ${SWG_PASSWORD} -max-passwords ${SWG_MAXPW} -fixed-config -no-panel"
    else:
        forkflags = " -password ${SWG_PASSWORD} -max-passwords ${SWG_MAXPW} -fixed-config"
    return ("[Unit]\nDescription=swg-wdtt (" + WDTT_FORK_OWNER.get(fork, WDTT_OWNER) + ") — " + iface + "\n"
            "After=network-online.target\nWants=network-online.target\n\n"
            "[Service]\nType=simple\nEnvironmentFile=-" + cfgdir + "/wdtt.env\n"
            "ExecStart=" + binp + " -iface ${SWG_IFACE} -wg-addr ${SWG_WGADDR} -listen ${SWG_LISTEN}"
            " -wg-port ${SWG_WGPORT} -config-dir ${SWG_CFGDIR} -desired ${SWG_DESIRED} -no-nat"
            # Operator extra flags. MUST be $SWG_PARAMS, never ${SWG_PARAMS}: systemd treats the braced form as a
            # SINGLE argument (no word-splitting), so an empty value passes one EMPTY argument — the WDTT server
            # then reports "неожиданные аргументы" (unexpected positional) and exits 1, crash-looping forever on
            # the default no-extra-flags case. The unbraced form splits on whitespace and empty contributes nothing
            # (this is also what the turn-proxy units use).
            + forkflags + " $SWG_PARAMS\n"
            "Restart=on-failure\nRestartSec=3\n"
            "NoNewPrivileges=yes\nAmbientCapabilities=CAP_NET_ADMIN\nCapabilityBoundingSet=CAP_NET_ADMIN\n"
            "DeviceAllow=/dev/net/tun rw\nProtectHome=yes\nProtectSystem=strict\nReadWritePaths=" + cfgdir + "\n"
            "ProtectControlGroups=yes\nProtectKernelModules=yes\nRestrictSUIDSGID=yes\nLockPersonality=yes\n"
            "SystemCallFilter=@system-service\nSystemCallErrorNumber=EPERM\n\n"
            "[Install]\nWantedBy=multi-user.target\n")

# ── Docker run-model ─────────────────────────────────────────────────────────────────────────────────────────
# A container has no systemd, so on a docker node swg-noded runs each WDTT server as a SUPERVISED CHILD PROCESS in
# THIS container. With host networking the server's interface lands in the right netns automatically — exactly like
# the node's own userspace amneziawg-go. reconcile_wdtt relaunches a died server on its next pass (the equivalent of
# systemd Restart=on-failure); SIGHUP reloads desired.json live; SIGTERM runs the server's clean teardown. The
# config-dir (binary symlink + desired.json + wg-keys.dat) lives where noded runs, so nothing goes through host_sh.
_WDTT_PROCS = {}    # iface -> subprocess.Popen (this noded lifetime)

def _wdtt_pidfile(iface): return _wdtt_dir(iface) + "/server.pid"

def _wdtt_argv(inst, binp):
    """The exact server invocation (mirror of _wdtt_unit_text's ExecStart) as an argv list, for a direct Popen."""
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); fork = _wdtt_fork(inst)
    a = [binp, "-iface", iface, "-wg-addr", inst["wg_addr"], "-listen", inst["listen"],
         "-wg-port", str(inst.get("wg_port") or 56001), "-config-dir", cfgdir,
         "-desired", cfgdir + "/desired.json", "-no-nat", "-password", inst.get("password") or ""]
    # Password-pool size. Prefer what is configured (adoption carries the foreign server's own value across, so
    # its store stays consistent); otherwise size it to the tunnel subnet, which is the real ceiling — every
    # client needs an address as well as a slot, so a flat 200 under-serves a /23 and over-promises on a /25.
    maxpw = str(inst.get("max_passwords") or _wdtt_maxpw_for(inst.get("wg_addr") or ""))
    if fork == "ildarmaga":
        a += ["-max-users", maxpw, "-fixed-config", "-admin-addr", "127.0.0.1:" + str(inst.get("wg_port") or 56001)]
    elif fork == "wdttplus":
        a += ["-max-passwords", maxpw, "-fixed-config", "-no-panel"]
    else:
        a += ["-max-passwords", maxpw, "-fixed-config"]
    params = (inst.get("params") or "").strip()
    if params:
        with contextlib.suppress(Exception):
            a += shlex.split(params)
    return a

def _wdtt_docker_pid(iface):
    """The live server pid for iface (tracked Popen, else the pidfile verified against /proc cmdline), or None."""
    p = _WDTT_PROCS.get(iface)
    if p is not None and p.poll() is None:
        return p.pid
    with contextlib.suppress(Exception):
        with open(_wdtt_pidfile(iface)) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if ("-iface\x00" + iface + "\x00").encode() in f.read():
                return pid
    return None

def _wdtt_docker_alive(iface): return _wdtt_docker_pid(iface) is not None

def _wdtt_write_cfgdir(inst, binshared, binp, cfgdir):
    """Lay down the config-dir the server reads — binary symlink + wdtt.env + desired.json + optional vault-restore
    key — with pure os calls. Works for BOTH run-models: the docker subprocess (in-container) and bare-metal (where
    swg-noded runs as root, so /opt/swg-wdtt is writable). Writing NATIVELY, not through a host_sh heredoc, means a
    partial failure RAISES before the caller writes/enables the unit — so there's never a half-installed instance to
    wedge the reconcile. (host_sh is unusable for docker anyway: it nsenters the HOST, but these files + the child
    process must live in the node container.)"""
    os.makedirs(cfgdir, exist_ok=True); os.makedirs(os.path.dirname(binshared), exist_ok=True)
    with contextlib.suppress(Exception): os.chmod(binshared, 0o755)
    with contextlib.suppress(Exception):
        if os.path.islink(binp) or os.path.exists(binp): os.remove(binp)
        os.symlink(binshared, binp)
    with open(cfgdir + "/wdtt.env", "w") as f: f.write(_wdtt_env_text(inst))
    with open(cfgdir + "/desired.json", "w") as f: f.write(_wdtt_desired_body(inst.get("passwords")) + "\n")
    restore_b64 = (inst.get("_restore_wg_keys") or "").strip()
    if restore_b64:
        # NOT best-effort. A swallowed failure here (bad base64, ENOSPC, read-only mount) left no wg-keys.dat and
        # the server then minted a fresh identity on start — the restore reported success while every client that
        # had a config broke. Let it raise: the caller turns an exception into an error string, and validate=True
        # means a corrupted blob raises instead of decoding to garbage the server would reject the same way.
        _kf = _wdtt_keyfile(inst["iface"])
        with open(_kf, "wb") as f: f.write(base64.b64decode(restore_b64, validate=True))
        os.chmod(_kf, 0o600)
        if not _wdtt_identity_ok(_kf):
            raise ValueError("restored identity is not a usable WDTT key file — refusing to start with a fresh key")

def _wdtt_docker_start(inst):
    """(Re)launch the WDTT server for this instance as a supervised child. '' on success (alive after a beat) else error."""
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); binp = cfgdir + "/server"
    _wdtt_docker_stop(iface)
    if not os.path.exists(binp):
        return "WDTT binary missing at " + binp
    try:
        lf = open(cfgdir + "/server.log", "ab", buffering=0)
        p = subprocess.Popen(_wdtt_argv(inst, binp), stdout=lf, stderr=lf, stdin=subprocess.DEVNULL, close_fds=True)
    except Exception as e:
        return ("spawn failed: " + str(e))[:160]
    _WDTT_PROCS[iface] = p
    with contextlib.suppress(Exception):
        with open(_wdtt_pidfile(iface), "w") as f: f.write(str(p.pid))
    time.sleep(1.5)
    if p.poll() is not None:                       # died immediately → surface the log tail
        tail = ""
        with contextlib.suppress(Exception):
            with open(cfgdir + "/server.log", "rb") as f: tail = f.read()[-240:].decode("utf-8", "replace").replace("\n", " ")
        return ("wdtt exited rc=%s: %s" % (p.returncode, tail.strip()))[:180]
    return ""

def _wdtt_docker_stop(iface):
    """SIGTERM (clean teardown removes the interface + rules), SIGKILL if it lingers; reap the child; drop the pidfile."""
    p = _WDTT_PROCS.pop(iface, None)
    pid = p.pid if p is not None else _wdtt_docker_pid(iface)
    if pid:
        with contextlib.suppress(Exception): os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            try:
                os.kill(pid, 0); time.sleep(0.15)
            except Exception:
                break
        else:
            # for/else — SIGKILL only if the loop never broke, i.e. it is STILL alive. Firing it unconditionally
            # after a clean exit is a real risk here: a pid taken from the pidfile (after a noded restart) is not
            # our child, so it is reaped the instant it exits and the number can already belong to something else.
            with contextlib.suppress(Exception): os.kill(pid, signal.SIGKILL)
    if p is not None:
        with contextlib.suppress(Exception): p.wait(timeout=2)
    with contextlib.suppress(Exception): os.remove(_wdtt_pidfile(iface))

def _wdtt_docker_sighup(iface):
    pid = _wdtt_docker_pid(iface)
    if pid:
        with contextlib.suppress(Exception): os.kill(pid, signal.SIGHUP)
        return True
    return False

def _wdtt_present(iface):
    """Is this instance set up on THIS node? systemd: its unit file exists. docker: its binary symlink is laid down."""
    if NODE_KIND == "docker":
        return os.path.exists(_wdtt_dir(iface) + "/server")
    # bare-metal: the unit file AND a WORKING binary symlink must BOTH be laid down. A unit whose `server`
    # symlink is missing or dangling (a partial install, or a docker→bare convert that carried only identity)
    # is NOT "present" — treating it as installed would wedge the reconcile into the update branch forever,
    # never re-laying the symlink, leaving the unit in a 203/EXEC crash-loop. os.path.exists follows the link,
    # so a dangling one (binary not fetched yet) also re-installs.
    return os.path.exists(_wdtt_unit_path(iface)) and os.path.exists(_wdtt_dir(iface) + "/server")

def _hex_to_b64(h):
    h = (h or "").strip()
    with contextlib.suppress(Exception):
        if len(h) == 64:
            return base64.b64encode(bytes.fromhex(h)).decode()
    return ""

def _wdtt_uapi(iface):
    """(interface_private_key_hex, {peer_pubkey_b64: last_handshake_sec}) straight from the UAPI socket. The
    container ships only `awg`, which can't read a plain wireguard-go socket — but the socket speaks the standard
    protocol, so we ask it directly. Drives online-status on docker."""
    priv = ""; hs = {}; cur = None
    for line in _uapi_lines(iface):
        if line.startswith("private_key="):
            priv = line.split("=", 1)[1]
        elif line.startswith("public_key="):
            cur = _hex_to_b64(line.split("=", 1)[1])
        elif line.startswith("last_handshake_time_sec=") and cur:
            with contextlib.suppress(ValueError):
                hs[cur] = int(line.split("=", 1)[1] or "0")
    return priv, hs

def _wdtt_server_pub(iface):
    """The WDTT server's WG public key. Bare-metal: `wg show` over the host-netns interface. Docker: derive it from
    the UAPI private key via `wg pubkey` (pure key math — works even though `awg show` can't read the socket)."""
    if NODE_KIND == "docker":
        priv, _ = _wdtt_uapi(iface)
        pb = _hex_to_b64(priv)
        if pb:
            with contextlib.suppress(Exception):
                return (run(_wgcmd(["wg"]) + ["pubkey"], input_text=pb + "\n").stdout or "").strip()   # _wgcmd(["wg"]) → ["awg"] on docker
        return ""
    return (host_sh("wg show " + shlex.quote(iface) + " public-key 2>/dev/null").stdout or "").strip()

def _wdtt_panel_fetch(fork, dest, want_sha, tag="wdtt"):
    """Fetch a fork's patched WDTT binary from the panel mirror (reuses the turn-binary endpoint keyed by the fork's
    owner + a version tag; the panel maps it to our release). `tag` is the author version we published (or "wdtt" =
    the current build, back-compat). Returns True on a verified write."""
    return _turn_panel_fetch(WDTT_FORK_OWNER.get(fork, WDTT_OWNER), tag or "wdtt", _turn_arch(), dest, want_sha)

def _wdtt_ver_path(fork):   # the installed build version, alongside the shared per-fork binary
    return os.path.dirname(_wdtt_bin_shared(fork)) + "/version.txt"
def _wdtt_installed_ver(fork):
    try:
        with open(_wdtt_ver_path(fork)) as f:
            return f.read().strip()[:40]
    except Exception:
        return ""
def _wdtt_write_ver(fork, ver):
    with contextlib.suppress(Exception):
        p = _wdtt_ver_path(fork); os.makedirs(os.path.dirname(p), exist_ok=True)
        tmp = p + ".tmp"
        with open(tmp, "w") as f:
            f.write((ver or "").strip())
        os.replace(tmp, p)

def _wdtt_fork_ifaces(fork, want):   # every desired iface running THIS fork (a version swap restarts them all — shared binary)
    return [i for i, inst in (want or {}).items() if _wdtt_fork(inst) == fork]

def _wdtt_update_binary(inst, ver, ifaces):
    """Swap the shared per-fork binary to a different published VERSION (same fork → same password-store format, so
    it's safe, unlike a fork swap). Re-fetch from the mirror (atomic replace — the running process keeps the old
    inode), stamp the version file, then restart every instance of the fork so they exec the new inode. '' on
    success else an error string."""
    fork = _wdtt_fork(inst); binshared = _wdtt_bin_shared(fork)
    if not _wdtt_panel_fetch(fork, binshared, (inst.get("sha256") or "").strip(), tag=ver) or not os.path.exists(binshared):
        return "WDTT binary unavailable for " + fork + " " + ver + " (panel mirror)"
    _wdtt_write_ver(fork, ver)
    if NODE_KIND == "docker":                                  # container: restart each of the fork's supervised procs so they exec the new binary
        with contextlib.suppress(Exception): os.chmod(binshared, 0o755)
        insts = _wdtt_load(); err = ""
        for i in (ifaces or [inst["iface"]]):
            it = dict(insts.get(i) or {}); it["iface"] = i
            if it.get("password") and not it.get("stopped"):
                e = _wdtt_docker_start(it)
                if e: err = i + ": " + e
        return err
    host_sh("chmod 755 " + shlex.quote(binshared))
    for i in (ifaces or [inst["iface"]]):
        host_sh("systemctl restart " + shlex.quote(_wdtt_svc(i)) + " >/dev/null 2>&1")
    return _wdtt_verify(_wdtt_svc(inst["iface"]))

def _wdtt_verify(svc):
    v = host_sh("sleep 1.5; systemctl is-active " + shlex.quote(svc) + " 2>/dev/null; "
                "journalctl -u " + shlex.quote(svc) + " -n 6 --no-pager -o cat 2>/dev/null | "
                "grep -iE 'error|invalid|fail|panic|bind|denied|seccomp' | tail -1")
    lines = (v.stdout or "").strip().splitlines()
    if lines and lines[0] == "active":
        return ""
    return "wdtt service didn't stay up: " + (lines[-1] if len(lines) > 1 else "check journal")[:150]

def _wdtt_maxpw_for(wg_addr, cap=4000):
    """Usable hosts in the tunnel subnet, as the password-pool default. Falls back to 200 when there's nothing
    to read; capped so a wide prefix can't ask a server to preallocate an absurd pool."""
    with contextlib.suppress(Exception):
        pfx = int(str(wg_addr).split("/")[1])
        if 0 < pfx <= 32:
            return max(1, min(cap, (1 << (32 - pfx)) - 2))
    return 200


def _wdtt_stage_foreign(cfgdir):
    """DOCKER only: copy a FOREIGN WDTT config-dir off the HOST into a container-local staging dir and return that
    path ('' when there is nothing to stage, or on bare-metal where the dir is already reachable).

    The adopt path validates and copy2's the identity with ordinary local file I/O. A foreign server's dir is on the
    host, so inside the container those reads all failed and adoption refused with "no usable server identity" —
    guarding keys that were sitting right there. Staging once here keeps every downstream check byte-identical
    across both install methods instead of teaching each one to speak host_sh.

    Read-only by construction: tar reads the original and nothing writes back, so an aborted adopt still leaves the
    foreign server serving — the property the copy-first ordering exists to preserve."""
    if NODE_KIND != "docker" or not cfgdir:
        return ""
    dst = "/tmp/swg-wdtt-adopt"
    with contextlib.suppress(Exception):
        shutil.rmtree(dst, ignore_errors=True)
        os.makedirs(dst, mode=0o700, exist_ok=True)
        # Only the files adoption actually consumes — never the whole directory, which can hold anything.
        # panel.db-wal / -shm come too: a WAL-mode SQLite store is NOT one file. ildarmaga keeps its users in
        # panel.db, and staging the base file alone captured a stale snapshot whose wdtt_users table had not been
        # checkpointed yet — the adopted server started with an EMPTY user set and rejected every existing client.
        b64 = (host_sh("tar -C %s -cf - wg-keys.dat passwords.json panel.db panel.db-wal panel.db-shm "
                       "dtls-cert.pem dtls-key.pem 2>/dev/null | base64 -w0" % shlex.quote(cfgdir), timeout=60).stdout or "").strip()
        if b64:
            with tarfile.open(fileobj=io.BytesIO(base64.b64decode(b64))) as _t:
                for _m in _t.getmembers():          # flatten + refuse anything that isn't a plain file we asked for
                    if _m.isfile() and "/" not in _m.name and not _m.name.startswith("."):
                        _f = _t.extractfile(_m)
                        if _f:
                            with open(os.path.join(dst, _m.name), "wb") as _o:
                                _o.write(_f.read())
                            os.chmod(os.path.join(dst, _m.name), 0o600)
            if os.listdir(dst):
                return dst
    return ""


def _wdtt_identity_ok(path):
    """Does this look like a real wg-keys.dat? The forks write FOUR base64 keys (server + client pair), and a
    server handed a file it can't parse silently GENERATES a fresh identity — which is precisely the outcome
    adoption exists to prevent, arriving with no error anywhere. Checked before anything is copied or stopped."""
    with contextlib.suppress(Exception):
        lines = [l.strip() for l in open(path, "rb").read().decode("utf-8", "replace").splitlines() if l.strip()]
        if len(lines) < 4:
            return False
        for l in lines[:4]:
            if len(base64.b64decode(l + "=" * (-len(l) % 4), validate=False)) != 32:
                return False
        return True
    return False


def _wdtt_adopt_seed(inst):
    """ADOPT a foreign (panel-unmanaged) WDTT server: SEEDED CREATE. We never reuse the foreign SERVICE (it's an
    unpatched build we don't control) — we create one of OUR instances that REUSES its DATA, so every GETCONF'd
    client keeps working: the server identity (wg-keys.dat → same pubkey), the password store (passwords.json /
    panel.db), and the owner password (read LOCALLY from the running process — the panel never sees it).
    Copy-FIRST, then stop the foreign process, so an abort leaves the original serving. Returns '' on success
    (inst is mutated with the recovered password/params, ready for _wdtt_install) else an error string."""
    iface = inst["iface"]
    # The name arrives as a raw key from the panel reply and immediately becomes a directory path below, so it is
    # checked FIRST — before makedirs/copy2 could be pointed somewhere like ../../root/.ssh. _wdtt_valid runs
    # later and only on the install path, which several early returns skip.
    if not _WDTT_NAME_RE.match(iface or ""):
        return "refused: unsafe interface name"
    probe = wdtt_foreign_probe(iface)
    # A DORMANT install has no process and no interface — the operator supplied its config dir instead, and the
    # runtime parameters (ports, subnet) with it. Everything below is the same seeded create; there is simply
    # nothing to read from argv and nothing to stop.
    dormant_src = (inst.pop("adopt_config_dir", "") or "").strip()
    if not probe and not dormant_src:
        return "no foreign WDTT server found for " + iface + " (already gone?)"
    # The operator can point at the identity when we couldn't find it (a fork with an unusual layout, or a server
    # started from somewhere we don't guess). Verify it HERE, before anything is stopped or copied: an unreadable
    # or empty file is refused outright and the foreign server carries on serving, exactly as if we'd never tried.
    idpath = (inst.pop("identity_path", "") or "").strip()
    # DOCKER: everything below reads and copies the foreign config-dir with ordinary local file I/O, but a foreign
    # server's dir lives on the HOST — so os.path.isfile() said no and adoption refused with "no usable server
    # identity", protecting keys that were in fact right there. The scan (host-aware) said adoptable, the executor
    # disagreed. Stage the dir into the container ONCE here, then every check and copy2 below works unchanged on
    # both install methods. Read-only: the foreign original is never touched, so an abort still leaves it serving.
    _stage = _wdtt_stage_foreign(os.path.dirname(idpath) if idpath else
                                 (dormant_src or ((probe or {}).get("config_dir") or "")))
    if _stage:
        if idpath:
            idpath = os.path.join(_stage, os.path.basename(idpath))
        elif dormant_src:
            dormant_src = _stage
        else:
            probe = dict(probe or {}); probe["config_dir"] = _stage
    if idpath:
        if not os.path.isfile(idpath):
            return "refused: no key file at " + idpath + " — nothing was changed"
        if not _wdtt_identity_ok(idpath):
            return "refused: " + idpath + " doesn't look like a WDTT key file (four base64 keys) — nothing was changed"
        try:
            with open(idpath, "rb") as _f: _f.read(1)
        except OSError as e:
            return ("refused: can't read " + idpath + " (" + str(e) + ") — nothing was changed")[:200]
    elif probe and not probe.get("has_identity"):
        # (a DORMANT adopt has no probe at all — its identity is checked against `src` just below)
        return "refused: the foreign server's identity (wg-keys.dat) can't be found — adopting would mint a new key and break every existing client"
    src = os.path.dirname(idpath) if idpath else (dormant_src or probe["config_dir"])
    if not _wdtt_identity_ok(os.path.join(src, "wg-keys.dat")):
        return "refused: no usable server identity (wg-keys.dat) in " + src + " — adopting would mint a new key and break every client; nothing was changed"
    # Everything that can refuse must refuse BEFORE the first write. These checks used to sit after the copy, so a
    # refusal ("no build available yet" is the normal state on a node that hasn't pulled the fork) left wg-keys.dat
    # in our config-dir with the foreign server still running — and the next pass then saw a "provisioned" instance,
    # skipped the adopt branch entirely, and installed our unit on the same iface and ports as the live original.
    if not _wdtt_valid(dict(inst, iface=iface)):
        return "refused: bad/unsafe WDTT instance parameters — the foreign server was left running"
    _want_fork = (inst.get("fork") or "").strip()
    if _want_fork and _want_fork not in WDTT_FORK_OWNER:
        return "refused: unknown WDTT fork '" + _want_fork + "' — the foreign server was left running"
    _fk = _wdtt_fork(inst); _bs = _wdtt_bin_shared(_fk)
    if not os.path.exists(_bs):
        with contextlib.suppress(Exception):
            _wdtt_panel_fetch(_fk, _bs, (inst.get("sha256") or "").strip(), tag=(inst.get("ver") or "").strip() or "wdtt")
        if not os.path.exists(_bs):
            return "refused: no " + _fk + " build available for this node yet — the foreign server was left running"
    dst = _wdtt_dir(iface)
    # 1) copy-first: identity + password store + DTLS material into OUR config-dir (the foreign one keeps serving)
    try:
        os.makedirs(dst, exist_ok=True)
        if idpath and os.path.basename(idpath) != "wg-keys.dat":
            shutil.copy2(idpath, os.path.join(dst, "wg-keys.dat"))
            with contextlib.suppress(Exception): os.chmod(os.path.join(dst, "wg-keys.dat"), 0o600)
        for fn in ("wg-keys.dat", "passwords.json", "panel.db", "dtls-cert.pem", "dtls-key.pem"):
            s = os.path.join(src, fn)
            if os.path.isfile(s) and os.path.abspath(s) != os.path.abspath(os.path.join(dst, fn)):
                shutil.copy2(s, os.path.join(dst, fn))
                with contextlib.suppress(Exception): os.chmod(os.path.join(dst, fn), 0o600)
    except Exception as e:
        return ("couldn't copy the foreign server's data: " + str(e))[:160]
    if not os.path.isfile(_wdtt_keyfile(iface)):
        return "refused: the server identity didn't copy across — not adopting (clients would break)"
    # panel.db is SQLite in WAL MODE: it is not one file. Copying the base alone captured whatever had been
    # checkpointed and silently dropped the rest — for ildarmaga that was the entire wdtt_users table, so the
    # adopted server came up with an empty user set and rejected every existing client with "wrong password".
    # Re-take it through SQLite (on a scratch copy, so the foreign original is never opened for writing) and the
    # result is one consistent, checkpointed file.
    _srcdb = os.path.join(src, "panel.db")
    if os.path.isfile(_srcdb):
        _stage = os.path.join(dst, ".dbstage")
        try:
            os.makedirs(_stage, exist_ok=True)
            for _f in ("panel.db", "panel.db-wal", "panel.db-shm"):
                _p = os.path.join(src, _f)
                if os.path.isfile(_p):
                    shutil.copy2(_p, os.path.join(_stage, _f))
            import sqlite3
            _s = sqlite3.connect(os.path.join(_stage, "panel.db"), timeout=10)   # writable COPY → the WAL replays
            _d = sqlite3.connect(os.path.join(dst, "panel.db"))
            try:
                with _d:
                    _s.backup(_d)
            finally:
                _s.close(); _d.close()
            with contextlib.suppress(Exception): os.chmod(os.path.join(dst, "panel.db"), 0o600)
        except Exception as e:
            return ("couldn't capture the foreign server's user store: " + str(e))[:160]
        finally:
            shutil.rmtree(_stage, ignore_errors=True)
    # The users themselves have to be handed UP to the panel: WDTT passwords are roster-owned (each one IS a
    # peer), and _wdtt_reply overwrites whatever the node holds with the roster-derived set on the very next
    # sync — so a node-local copy alone is erased seconds after the take-over. Capture them here, at the one
    # moment they are known, and report them until the panel has them (wdtt_snapshot → panel import).
    _found = _wdtt_adopted_users(dst)
    if _found:
        inst["adopt_users"] = _found
        inst["adopt_users_at"] = int(time.time())
    # 2) recover the owner password + transport params from the RUNNING process (node-local; never panel-side).
    #    A dormant install has no process: its parameters came from the operator, and the owner password is minted
    #    below like any fresh instance (there is no running server whose password we'd have to match).
    if not probe:
        return ""
    # Same namespace rule as the stop below: on a docker node this pid lives on the HOST, so the local read
    # returned nothing and the owner password was silently NOT carried over — the adopted server came up with a
    # freshly minted one, which is exactly what this step exists to prevent. Reading it host-side keeps it
    # node-local; the panel still never sees it.
    flags = _wdtt_cmdline_flags(probe["pid"])
    if not _wdtt_is_server(flags) and NODE_KIND == "docker":
        flags = _wdtt_flags_host(probe["pid"])
    pw = (flags.get("password") or "").strip()
    if pw:
        inst["password"] = pw                      # keep the SAME owner password → existing clients still authenticate
    for k, fk in (("listen", "listen"), ("wg_addr", "wg-addr")):
        if not (inst.get(k) or "").strip() and (flags.get(fk) or "").strip():
            inst[k] = flags[fk].strip()
    if not str(inst.get("wg_port") or "").strip() and str(flags.get("wg-port") or "").strip():
        inst["wg_port"] = flags["wg-port"].strip()
    # 3) stop the FOREIGN process — it holds the interface + ports our instance is about to bind
    # Re-verify before signalling: the pid was read before a file copy and possibly a full binary download, so it
    # could have exited and had its number recycled onto something unrelated — which we run as root.
    # On a DOCKER node the foreign server runs on the HOST, and wdtt_foreign_probe found it through
    # _wdtt_host_procs — so its pid belongs to the host's namespace, not ours. Reading /proc/<pid> locally
    # therefore described a DIFFERENT process (usually none at all) and os.kill signalled our own namespace:
    # the foreign server was never stopped, our instance could not bind its port or interface, and the card sat
    # on "starting" for ever. Verify and signal through the same host helper that found it. Local first, so
    # bare-metal and our own supervised children keep the cheap path and no privileged container is spawned.
    # _wdtt_iface_of, NOT flags["iface"]: a genuinely foreign server has no -iface at all (the authors' builds
    # hardcode it), so comparing the raw flag could never confirm one — the re-verify refused every real
    # adoption, after the copy had already happened, and the next pass then saw a "provisioned" instance and
    # started ours on the port the original still held.
    # The fallback is decided on "did the LOCAL read describe a server at all", never on the interface name:
    # a wrong-namespace read comes back empty, and _wdtt_iface_of() answers the DEFAULT name for empty flags —
    # which for wdtt0 equals the name we are adopting, so an iface-based test silently accepted the empty read
    # and never consulted the host.
    _flags_now = _wdtt_cmdline_flags(probe["pid"]); _host_pid = False
    if not _wdtt_is_server(_flags_now) and NODE_KIND == "docker":
        _flags_now = _wdtt_flags_host(probe["pid"]); _host_pid = True
    # _wdtt_is_server first: an exited pid reads back as empty flags, and _wdtt_iface_of would then hand us the
    # DEFAULT interface name — confirming "yes, that's the server on wdtt0" about a process that is gone.
    if not _wdtt_is_server(_flags_now) or _wdtt_iface_of(_flags_now) != iface:
        return "the foreign server exited while we were preparing — nothing was changed, re-try the adoption"
    # Stop the SERVICE if there is one. A foreign WDTT server is normally a systemd unit with Restart=on-failure,
    # so killing only the process left its manager to bring it straight back: it then crash-looped against the
    # port our instance had taken (NRestarts climbing, "address already in use") — and would have won the port
    # outright the moment ours stopped, handing clients back to the server we just replaced.
    _unit = _wdtt_unit_of_pid(probe["pid"], _host_pid)
    if _unit and not _unit.startswith("swg-wdtt-"):        # never our own supervisor
        host_sh("systemctl disable --now " + shlex.quote(_unit) + " >/dev/null 2>&1; :")
    if _host_pid:
        # TERM, wait up to ~4.5s, then KILL — the same escalation as the local branch, run host-side in one hop.
        _p = int(probe["pid"])
        host_sh("kill -TERM %d 2>/dev/null; i=0; while [ $i -lt 30 ] && kill -0 %d 2>/dev/null; do sleep 0.15; "
                "i=$((i+1)); done; kill -0 %d 2>/dev/null && kill -KILL %d 2>/dev/null; :" % (_p, _p, _p, _p))
    else:
        with contextlib.suppress(Exception):
            os.kill(probe["pid"], signal.SIGTERM)
            for _ in range(30):
                try:
                    os.kill(probe["pid"], 0); time.sleep(0.15)
                except Exception:
                    break
            else:
                os.kill(probe["pid"], signal.SIGKILL)
    with contextlib.suppress(Exception):           # the interface may linger after the process dies
        run(["ip", "link", "delete", "dev", iface])
    if _host_pid:                                  # a bridge-mode node does not share the host netns
        host_sh("ip link delete dev %s 2>/dev/null; :" % shlex.quote(iface))
    # the walk that found it is cached (45s) and now describes a process we just killed — the very next
    # snapshot would still report the foreign server as running, and adoption as unfinished.
    _WDTT_HOSTPROC["at"] = 0.0
    return ""

def _wdtt_install(inst):
    """Install a WDTT instance: place the binary (panel mirror, shared per-arch), lay down the config-dir (binary
    symlink + wdtt.env + desired.json + optional vault-restore key), then start it — bare-metal via a systemd unit,
    docker via a supervised child process. '' on success else error. The config-dir is written natively in both
    cases (_wdtt_write_cfgdir), so a partial failure raises BEFORE the unit is written/started — no half-installed
    instance can wedge the reconcile into treating a broken unit as 'present'."""
    if not _wdtt_valid(inst):
        return "refused: bad/unsafe WDTT instance parameters"
    if not _turn_arch_ok():
        return "no WDTT build for this architecture (" + os.uname().machine + ")"
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); svc = _wdtt_svc(iface)
    fork = _wdtt_fork(inst)
    binshared = _wdtt_bin_shared(fork); binp = cfgdir + "/server"
    _want_ver = (inst.get("ver") or "").strip()
    if not os.path.exists(binshared):
        _wdtt_panel_fetch(fork, binshared, (inst.get("sha256") or "").strip(), tag=_want_ver or "wdtt")
        if not os.path.exists(binshared):
            return "WDTT binary unavailable (panel mirror has no build yet)"
        _wdtt_write_ver(fork, _want_ver)                       # stamp the build version for the version board + rollback
    # Config-dir (symlink + env + desired.json + optional vault-restore key) — native os writes, both run-models.
    # A vault restore lays down the ORIGINAL server keypair BEFORE first start so the instance comes back with its
    # blessed identity (WDTT reuses an existing wg-keys.dat rather than minting) — GETCONF'd clients keep working.
    try:
        _wdtt_write_cfgdir(inst, binshared, binp, cfgdir)
    except Exception as e:
        return ("config-dir write failed: " + str(e))[:160]
    if NODE_KIND == "docker":                                  # container: no systemd → supervised child process
        return _wdtt_docker_start(inst)
    # bare-metal: write the systemd unit natively, then the one step that genuinely needs systemd (reload + enable).
    try:
        with open(_wdtt_unit_path(iface), "w") as f: f.write(_wdtt_unit_text(iface, binp, cfgdir, fork))
    except Exception as e:
        return ("unit write failed: " + str(e))[:160]
    w = host_sh("systemctl daemon-reload && systemctl enable --now " + shlex.quote(svc) + " >/dev/null 2>&1", timeout=120)
    if w.returncode != 0:
        return (w.stderr or w.stdout or "install failed").strip()[:160]
    return _wdtt_verify(svc)

def _wdtt_params_changed(prev, inst):
    """True if a TRANSPORT param changed on a RUNNING instance — listen (endpoint:dtls-port) / internal wg-port /
    max-passwords. These live in the unit ExecStart + wdtt.env, so applying them needs a rewrite + restart
    (passwords/stopped are handled live, separately). endpoint is folded into `listen`. FORK is deliberately NOT
    here: it's a create-time choice (read-only in the edit UI) — hot-swapping the binary would also migrate the
    password store between the two forks' formats (passwords.json ↔ panel.db), which we don't risk on a live
    server. So a same-fork config change only ever restarts the SAME binary."""
    return ((prev.get("listen") or "") != (inst.get("listen") or "")
            or (prev.get("wg_addr") or "") != (inst.get("wg_addr") or "")   # subnet change → rewrite unit + restart (server reassigns client IPs on reconnect)
            or str(prev.get("wg_port") or 56001) != str(inst.get("wg_port") or 56001)
            or (str(prev.get("max_passwords") or _wdtt_maxpw_for(prev.get("wg_addr") or ""))
                != str(inst.get("max_passwords") or _wdtt_maxpw_for(inst.get("wg_addr") or "")))
            or (prev.get("params") or "").strip() != (inst.get("params") or "").strip())   # extra ExecStart flags → rewrite unit + restart

def _wdtt_reconfigure(inst):
    """Apply a transport-param change (listen / wg-port / max) to a RUNNING WDTT instance: rewrite wdtt.env + the
    unit and restart the SAME fork's binary, verify. PRESERVES wg-keys.dat (server identity → pubkey stable, no
    GETCONF break) and desired.json (passwords). '' on success else an error. Clients re-import only if
    listen/wg-port changed (those are in the wdtt:// link). The binary fetch-if-missing is a same-fork self-heal,
    never a fork swap (see _wdtt_params_changed)."""
    if not _wdtt_valid(inst):
        return "refused: bad/unsafe WDTT instance parameters"
    iface = inst["iface"]; cfgdir = _wdtt_dir(iface); svc = _wdtt_svc(iface)
    fork = _wdtt_fork(inst)
    binshared = _wdtt_bin_shared(fork); binp = cfgdir + "/server"
    if not os.path.exists(binshared):                       # fork swap → fetch the new fork's binary from the mirror
        _wdtt_panel_fetch(fork, binshared, (inst.get("sha256") or "").strip())
        if not os.path.exists(binshared):
            return "WDTT binary unavailable for fork " + fork + " (panel mirror has no build yet)"
    # Rewrite the config-dir (symlink/env/desired) natively — wg-keys.dat is untouched (identity → pubkey stable), and
    # desired.json is rewritten with the SAME current password set (idempotent; matches the docker path). Partial write
    # raises before the restart, so a failed reconfigure never leaves a mismatched unit running.
    try:
        _wdtt_write_cfgdir(inst, binshared, binp, cfgdir)
    except Exception as e:
        return ("reconfigure failed: " + str(e))[:160]
    if NODE_KIND == "docker":                               # container: restart the supervised proc (no unit to rewrite)
        return _wdtt_docker_start(inst)
    try:
        with open(_wdtt_unit_path(iface), "w") as f: f.write(_wdtt_unit_text(iface, binp, cfgdir, fork))
    except Exception as e:
        return ("unit write failed: " + str(e))[:160]
    w = host_sh("systemctl daemon-reload && systemctl restart " + shlex.quote(svc) + " >/dev/null 2>&1", timeout=120)
    if w.returncode != 0:
        return (w.stderr or w.stdout or "reconfigure failed").strip()[:160]
    return _wdtt_verify(svc)

def _wdtt_reset_devices(iface, fork):
    """A wg_addr (subnet) change invalidates every cached client-IP binding — each fork pins its devices to
    addresses in the OLD subnet, so a reconnecting client would be handed an IP outside the new interface and get
    no route (online but no internet). Stop the server, clear its device cache, and drop the interface so it comes
    back fresh; clients re-register into the new subnet on their next connect. Credentials (the password set) and
    the server identity (wg-keys.dat) are left intact. Paired with the _wdtt_reconfigure that restarts the server
    immediately after — the server recreates the tun (new subnet, no stale peers) on start."""
    cfgdir = _wdtt_dir(iface)
    if NODE_KIND == "docker":
        _wdtt_docker_stop(iface)                         # SIGTERM → the server removes its interface on the way out
    else:
        host_sh("systemctl stop " + shlex.quote(_wdtt_svc(iface)) + " >/dev/null 2>&1")
    if fork == "ildarmaga":                              # SQLite panel.db → wipe the device bindings (users/passwords kept)
        with contextlib.suppress(Exception):
            import sqlite3
            dbp = cfgdir + "/panel.db"
            if os.path.exists(dbp):
                c = sqlite3.connect(dbp, timeout=2)
                try: c.execute("DELETE FROM wdtt_devices"); c.commit()
                finally: c.close()
    else:                                                # amurcanov & wire-compatible forks: passwords.json devices{}
        p = cfgdir + "/passwords.json"
        with contextlib.suppress(Exception):
            with open(p) as f: d = json.load(f)
            if d.get("devices"):
                d["devices"] = {}
                tmp = p + ".tmp"
                with open(tmp, "w") as f: json.dump(d, f)
                os.replace(tmp, p)
    if NODE_KIND == "docker":
        with contextlib.suppress(Exception): run(["ip", "link", "del", iface])   # in the container netns; usually already gone from the SIGTERM teardown
    else:
        host_sh("ip link del " + shlex.quote(iface) + " 2>/dev/null || true")   # gone → server recreates it fresh on restart

def _wdtt_desired_changed(iface, passwords):
    """True if the panel's desired password set differs from what's on disk (so we only rewrite+SIGHUP on change)."""
    try:
        with open(_wdtt_dir(iface) + "/desired.json") as f:
            cur = (json.load(f) or {}).get("passwords") or {}
    except Exception:
        return True
    return cur != (json.loads(_wdtt_desired_body(passwords)).get("passwords") or {})

def _wdtt_reconcile_desired(iface, passwords):
    """Write the panel's desired password set + SIGHUP the server → applied with no restart / no tunnel drop."""
    cfgdir = _wdtt_dir(iface)
    try:                                                 # desired.json is a plain node-local write in both run-models
        with open(cfgdir + "/desired.json", "w") as f: f.write(_wdtt_desired_body(passwords) + "\n")
    except Exception as e:
        return ("desired write failed: " + str(e))[:160]
    if NODE_KIND == "docker":
        _wdtt_docker_sighup(iface)                       # server reloads desired.json on HUP (mtime watch is the fallback)
        return ""
    w = host_sh("systemctl kill -s HUP " + shlex.quote(_wdtt_svc(iface)) + " 2>/dev/null || true")
    return "" if w.returncode == 0 else (w.stderr or w.stdout or "reconcile failed").strip()[:160]

def _wdtt_apply_stopped(iface, stopped, inst=None):
    """Start/stop one WDTT server. `inst` is the caller's in-scope record — pass it: re-reading the whole record
    file to find an entry the caller is already holding both costs a read per instance and races the caller
    (reconcile mutates `have` in memory and saves it once at the end, so a re-read here saw the PREVIOUS state)."""
    if NODE_KIND == "docker":
        if stopped:
            _wdtt_docker_stop(iface)
        else:
            if inst is None:
                inst = _wdtt_load().get(iface)
            if inst:
                inst = dict(inst); inst["iface"] = iface; _wdtt_docker_start(inst)
        return
    svc = _wdtt_svc(iface)
    if stopped:
        host_sh("systemctl disable --now " + shlex.quote(svc) + " >/dev/null 2>&1")
    else:
        host_sh("systemctl enable --now " + shlex.quote(svc) + " >/dev/null 2>&1")

def _wdtt_del_iptables_comment(table, chain, tag):
    """Delete every rule in <table>/<chain> whose comment is EXACTLY `tag` (the trailing quote in the rendered
    `--comment "tag"` prevents a swg-egress:wdtt7 tag from matching swg-egress:wdtt77)."""
    needle = '--comment "' + tag + '"'
    with contextlib.suppress(Exception):
        for ln in (run(["iptables", "-t", table, "-S", chain]).stdout or "").splitlines():
            if ln.startswith("-A ") and needle in ln:
                run(["sh", "-c", "iptables -t " + table + " " + ln.replace("-A ", "-D ", 1)])

def _wdtt_remove(iface):
    if not _WDTT_NAME_RE.match(iface or ""):   # never rm -rf a path built from an unvalidated name
        return
    if NODE_KIND == "docker":
        _wdtt_docker_stop(iface)                         # SIGTERM → clean interface + firewall teardown
        with contextlib.suppress(Exception): run(["ip", "link", "del", iface])
        with contextlib.suppress(Exception): shutil.rmtree(_wdtt_dir(iface))
    else:
        svc = _wdtt_svc(iface)
        host_sh("systemctl disable --now " + shlex.quote(svc) + " >/dev/null 2>&1; "
                "rm -f " + shlex.quote(_wdtt_unit_path(iface)) + "; systemctl daemon-reload; "
                "ip link del " + shlex.quote(iface) + " 2>/dev/null; "
                "rm -rf " + shlex.quote(_wdtt_dir(iface)))
    # We just changed exactly what these caches describe, so serving the pre-teardown view back is not a saving,
    # it is a wrong answer: iface_candidates() reads the host proc walk, so a deleted server kept being reported
    # as an unmanaged interface — i.e. offered for ADOPTION — for the rest of the 45s TTL. The TTL exists to stop
    # a privileged one-shot container per candidate per 5s snapshot; it is not meant to outlive our own writes.
    _WDTT_HOSTPROC["at"] = 0.0
    _WDTT_CFGPROBE.pop(_wdtt_dir(iface), None)
    # Drop the node-owned egress rules for this iface — reconcile_egress won't, since the iface is already gone
    # from the WDTT record by the time it next runs (the POSTROUTING MASQUERADE would otherwise orphan).
    _wdtt_del_iptables_comment("nat", "POSTROUTING", "swg-egress:" + iface)
    _wdtt_del_iptables_comment("filter", "FORWARD", "swg-egress-acl:" + iface)
    _wdtt_del_iptables_comment("mangle", "FORWARD", "swg-egress-mss:" + iface)

_WDTT_SEALED = {}   # iface -> sealed {pub(server_pub), eph, ct, mac} of a WDTT server identity, pending upload
def wdtt_vault_process(vault_pub, want):
    """Seal each wanted WDTT instance's SERVER IDENTITY — the owner password + wg-keys.dat — to the operator
    vault (the analogue of ivk_process for interface keys). The blob rides the NEXT snapshot; the panel escrows
    only ciphertext. `pub` = the instance's WG server public key, so the panel re-requests if it ever rotates.
    No-op without a vault pub, or before the instance has been provisioned (no wg-keys.dat / not up yet).

    NOTE: this DELIBERATELY parallels ivk_process (two want lists, two _SEALED dicts, two snapshot fields, two
    panel escrow slots) rather than sharing a generic `vault_process([{kind,id}])`. With only two key-owning
    kinds the parallel is readable, and unifying now would mean refactoring the (separately, less-fully-tested)
    interface-key vault path to serve WDTT. GENERALIZE when a THIRD key-owning consumer appears — collapse both
    into one `vault_want:[{kind,id}]` + one `_SEALED` keyed by kind:id + a per-kind seal-source dispatch."""
    global _IVK_VAULT_PUB
    if vault_pub: _IVK_VAULT_PUB = vault_pub
    want = set(want or [])
    for ifn in list(_WDTT_SEALED):
        if ifn not in want: _WDTT_SEALED.pop(ifn, None)   # panel now holds it → stop sending
    if not (_IVK_VAULT_PUB and want): return
    insts = _wdtt_load()
    for ifn in want:
        with contextlib.suppress(Exception):
            inst = insts.get(ifn) or {}
            pw = (inst.get("password") or "").strip()
            keypath = _wdtt_keyfile(ifn)
            if not (pw and os.path.exists(keypath)):
                continue                                          # nothing provisioned to seal yet
            srvpub = _wdtt_server_pub(ifn)
            if not srvpub:
                continue
            cur = _WDTT_SEALED.get(ifn)
            if cur and cur.get("pub") == srvpub:
                continue                                          # already sealed THIS identity
            with open(keypath, "rb") as f:
                raw = f.read()
            payload = json.dumps({"password": pw, "wg_keys": base64.b64encode(raw).decode()}).encode()
            blob = ivk_seal(_IVK_VAULT_PUB, payload); blob["pub"] = srvpub
            _WDTT_SEALED[ifn] = blob

def _wdtt_unseal_identity(sealed):
    """Open a WDTT identity blob the browser re-sealed to THIS node's transport key at restore → {password, wg_keys}."""
    with contextlib.suppress(Exception):
        d = json.loads(ivk_unseal(transport_priv(), sealed).decode())
        if isinstance(d, dict) and d.get("wg_keys"):
            return d
    return None

def reconcile_wdtt(want, remove=None):
    """Declarative WDTT reconcile (continuous, like desired_ifaces). want = {iface: inst}. Installs missing,
    writes desired.json + SIGHUPs on password change, applies stop/start, and removes ONLY the instances the panel
    explicitly listed in `remove` — never one that is merely missing from `want`."""
    res = {"changed": 0, "errors": []}
    want = want or {}
    if not isinstance(want, dict):
        # The removal loop below runs FIRST and `iface in want` happily walks a list (or substring-matches a
        # string), so a malformed reply used to delete instances and only then raise on want.items(). Same guard
        # the sync loop already applies to `desired`.
        res["errors"].append("panel sent a malformed wdtt set (%s) — ignored" % type(want).__name__)
        return res
    have = _wdtt_load()
    if not want and not have:
        return res
    # Remove ONLY what the panel EXPLICITLY listed — the same shape interfaces and peers already use (`delete` /
    # `remove` lists). WDTT used to delete on absence, which conflates "the operator deleted it" with "this panel
    # has never heard of it": a freshly-enrolled node, or one syncing to a panel restored from an older
    # nodes.json, read as "delete everything" and took non-recreatable key material with it. panel_managed stays
    # as a second belt, so an instance the panel never acknowledged is never removed even if it appears in a list.
    for iface in [i for i in (remove or []) if isinstance(i, str)]:
        if iface not in have:
            continue
        if not (have.get(iface) or {}).get("panel_managed"):
            continue                                          # never acknowledged by the panel → not ours to delete
        _wdtt_remove(iface); have.pop(iface, None); res["changed"] += 1
    for iface, req in want.items():
        try:
            inst = dict(req or {}); inst["iface"] = iface
            prev = have.get(iface) or {}
            inst["panel_managed"] = True                      # the panel knows this one → a later absence IS a delete
            sealed_id = inst.pop("sealed_identity", None)   # a browser-resealed identity to restore (one-shot)
            key_blob = inst.pop("key_blob", None)           # escrowed ciphertext relayed by the panel — presence = restore possible
            # The owner -password is NODE-OWNED (the panel is blind): reuse the stored one, adopt a legacy
            # panel-supplied one (one-time migration), else it's minted below.
            # TODO-LATER (remove ~2 weeks after this ships): drop the `inst.get("password")` term — the panel no
            # longer sends the owner password, so once every instance has re-synced it is always empty (dead path).
            pw = (prev.get("password") or inst.get("password") or "").strip()
            # Has the PANEL ever owned a password on this instance? Latched on the first sync that carries one and
            # kept for ever after. It is what tells an EMPTY desired set apart from "the operator deleted the last
            # peer": until the panel has held a password here, an empty set means it doesn't KNOW the users yet —
            # and writing it reaps every one of them (our builds drop the wg peer + device for a password that is
            # gone). Read before _wdtt_serve_adopted, which unions the hand-off into inst["passwords"].
            _pw_seen = bool(prev.get("pw_seen") or (inst.get("passwords") or {}))
            if _pw_seen:
                inst["pw_seen"] = True
            # Carry the recovered foreign users across reconciles (the panel's `want` never contains them) until
            # the panel has actually taken them: once its roster-derived password set covers them, or 15 min pass,
            # the hand-off is over and the record is dropped so nothing keeps re-offering deleted peers.
            _au = prev.get("adopt_users") or {}
            if _au:
                _have = set((inst.get("passwords") or {}).keys())
                if _have and not (set(_au) - _have):
                    _au = {}
                elif int(time.time()) - int(prev.get("adopt_users_at") or 0) > 900:
                    _au = {}
            if _au:
                inst["adopt_users"] = _au
                inst["adopt_users_at"] = prev.get("adopt_users_at") or int(time.time())
                _wdtt_serve_adopted(inst)   # …and SERVE them while it is open (see the helper)
            unit_missing = not _wdtt_present(iface)          # systemd unit (bare-metal) / binary symlink (docker) absent → fresh install
            if (prev.get("adopt_failed") and not os.path.exists(_wdtt_keyfile(iface))
                    and not inst.get("adopt_foreign") and not sealed_id):
                # a take-over that was refused stays refused until the operator resolves it (retry with a path,
                # or Recreate fresh, which clears the adopt intent) — never silently becomes a fresh server
                inst["await_restore"] = True; inst["adopt_failed"] = prev["adopt_failed"]; have[iface] = inst
                res.setdefault("await", []).append(iface); continue
            provisioned = os.path.exists(_wdtt_keyfile(iface))
            # An ADOPT is honoured whenever THIS NODE has no record of the instance — not only when the box looks
            # untouched. A server this box ran BEFORE (a reinstall, a panel restored from an older nodes.json)
            # leaves OUR config-dir and OUR unit name behind, so `unit_missing`/`provisioned` both read "already
            # ours" and the seed was skipped in silence: the take-over never captured the users, the panel's empty
            # desired set reached the server, and it deleted every one of them. That is the single most common
            # thing an operator adopts (it is what "adopt what a box already runs" means), so it cannot be the one
            # case that no-ops. The seed is safe on a populated config-dir — it skips a self-copy and reads the
            # store that is already there.
            if not prev and inst.pop("adopt_foreign", None):
                # ADOPT a foreign WDTT server (panel-unmanaged, unpatched build): seeded create — copy its identity
                # + password store + owner password into OUR config-dir, stop it, then install OUR build below with
                # that same data. Clients keep working (same server pubkey + passwords). Refuses if the identity
                # can't be recovered rather than minting a fresh key and breaking every client.
                aerr = _wdtt_adopt_seed(inst)
                if aerr:
                    # HOLD, don't fall through. The refusal is only meaningful if it STICKS: the panel clears
                    # adopt_foreign once it has acked this instance, so the next sync would see an ordinary
                    # unprovisioned instance, mint a fresh key and start it — quietly turning "refused, nothing
                    # was changed" into exactly the fresh server we refused to make, minutes later, under the
                    # name the operator asked to ADOPT. Record the instance as awaiting a decision instead.
                    inst["await_restore"] = True; inst["adopt_failed"] = aerr[:200]
                    inst.pop("_restore_wg_keys", None); have[iface] = inst
                    res["errors"].append(iface + ": " + aerr)
                    res.setdefault("await", []).append(iface)
                    continue
                pw = (inst.get("password") or "").strip() or pw
                _wdtt_serve_adopted(inst)   # serve the recovered users from the FIRST start, not one sync later
                provisioned = os.path.exists(_wdtt_keyfile(iface))   # identity now seeded → don't mint/await below
            # SAFETY NET — an empty desired set must never REAP users the panel has never seen. Taking over a
            # config-dir that already holds users happens well outside adoption: a create landing on an earlier
            # install's directory, a node whose record was wiped while /opt/swg-wdtt survived, a refused adopt that
            # fell through. In every one of those the panel's roster-derived set is empty for one reason only — it
            # doesn't know these users yet — and writing it deletes them irrecoverably. Hand them UP instead (the
            # panel recreates each as a roster peer) and serve them meanwhile. The instance's own `remove` list
            # already works this way; this is the same rule one level down, at the password: a wipe needs positive
            # intent — the operator deleting a peer the panel HOLDS — never the mere absence of one.
            if not _pw_seen and not inst.get("adopt_users"):
                _pre = _wdtt_adopted_users(_wdtt_dir(iface))
                if _pre:
                    inst["adopt_users"] = _pre
                    inst["adopt_users_at"] = int(time.time())
                    _wdtt_serve_adopted(inst)
            if unit_missing and not provisioned:
                # Fresh, or a post-wipe re-provision. If the operator vaulted this instance, DON'T mint a new
                # server key (that would break every GETCONF'd client) — restore the ORIGINAL identity when the
                # sealed blob arrives, and HOLD until the operator unlocks it.
                ident = _wdtt_unseal_identity(sealed_id) if sealed_id else None
                if ident:
                    pw = (ident.get("password") or "").strip() or pw
                    inst["_restore_wg_keys"] = ident.get("wg_keys")
                elif isinstance(key_blob, dict) and key_blob.get("ct"):
                    inst["password"] = pw; inst["await_restore"] = True
                    inst.pop("_restore_wg_keys", None); have[iface] = inst
                    res.setdefault("await", []).append(iface); continue
            if not pw:
                pw = _gen_wdtt_password()
            inst["password"] = pw; inst.pop("await_restore", None)
            if not _wdtt_present(iface):
                err = _wdtt_install(inst)
                if err:
                    res["errors"].append(iface + ": " + err); continue
                res["changed"] += 1
            else:
                _want_ver = (inst.get("ver") or "").strip()   # panel-published build version → swap the shared binary if it moved
                _fk = _wdtt_fork(inst); _inst_ver = _wdtt_installed_ver(_fk)
                if _want_ver and not _inst_ver and os.path.exists(_wdtt_bin_shared(_fk)):
                    _wdtt_write_ver(_fk, _want_ver)           # first sync after upgrade: the running (unversioned) binary IS the current build → just stamp it, no re-fetch/restart
                elif _want_ver and _want_ver != _inst_ver:
                    err = _wdtt_update_binary(inst, _want_ver, _wdtt_fork_ifaces(_fk, want))
                    if err:
                        res["errors"].append(iface + ": " + err); continue
                    res["changed"] += 1
                if _wdtt_params_changed(prev, inst):        # listen/wg-addr/wg-port/max changed → rewrite unit + restart (identity kept)
                    # subnet MOVED → drop stale device-IP bindings first. Requires a previous subnet to have moved
                    # FROM: with no prior record (the first sync after an adopt, or a lost node record) every param
                    # reads as "changed", and resetting there threw away the device bindings — client IPs and the
                    # server-held keys behind them — of a server whose subnet had not moved at all.
                    if prev.get("wg_addr") and prev["wg_addr"] != (inst.get("wg_addr") or ""):
                        _wdtt_reset_devices(iface, _wdtt_fork(inst))
                    err = _wdtt_reconfigure(inst)
                    if err:
                        res["errors"].append(iface + ": " + err); continue
                    res["changed"] += 1
                if _wdtt_desired_changed(iface, inst.get("passwords")):   # password set changed → desired.json + SIGHUP (no restart)
                    err = _wdtt_reconcile_desired(iface, inst.get("passwords"))
                    if err:
                        res["errors"].append(iface + ": " + err); continue
                    res["changed"] += 1
            if bool(inst.get("stopped")) != bool(prev.get("stopped")):
                _wdtt_apply_stopped(iface, bool(inst.get("stopped")), inst); res["changed"] += 1
            if inst.get("restart") and inst.get("restart") != prev.get("restart") and not inst.get("stopped"):
                if NODE_KIND == "docker":
                    _wdtt_docker_start(inst)
                else:
                    host_sh("systemctl restart " + shlex.quote(_wdtt_svc(iface)) + " >/dev/null 2>&1")   # operator-requested bounce (nonce acted on once)
                res["changed"] += 1
            # docker: supervise — relaunch a server that died (crash / prior noded exit), the equivalent of systemd Restart=on-failure
            if NODE_KIND == "docker" and _wdtt_present(iface) and not bool(inst.get("stopped")) and not _wdtt_docker_alive(iface):
                serr = _wdtt_docker_start(inst)
                if serr:
                    res["errors"].append(iface + ": " + serr)
                else:
                    res["changed"] += 1
            inst.pop("_restore_wg_keys", None)   # transient — never persist the restored key material to the record
            have[iface] = inst
        except Exception as e:
            res["errors"].append(iface + ": " + str(e))
    if not _wdtt_save(have):
        res["errors"].append("couldn't write the WDTT record (" + WDTT_RECORD + ") — adoption/hold state may not survive a restart")
    return res

def _wdtt_adopted_users(cfgdir):
    """The users a FOREIGN server was serving, as {password: {vk_hash, expires_at, is_deactivated, comment}} —
    everything the panel needs to recreate each one as a roster peer, and nothing else (no device/traffic rows).
    Reads whichever store the fork keeps: SQLite panel.db (ildarmaga) or passwords.json (amurcanov family)."""
    out = {}
    dbp = os.path.join(cfgdir, "panel.db")
    if os.path.isfile(dbp):
        with contextlib.suppress(Exception):
            import sqlite3
            c = sqlite3.connect(dbp, timeout=5)
            try:
                for pw, vkh, exp, deact, comment in c.execute(
                        "SELECT password, vk_hash, expires_at, is_deactivated, comment FROM wdtt_users"):
                    if pw:
                        out[pw] = {"vk_hash": (vkh or "").strip(), "expires_at": int(exp or 0),
                                   "is_deactivated": bool(deact), "comment": (comment or "").strip()[:80]}
            finally:
                c.close()
    pj = os.path.join(cfgdir, "passwords.json")
    if os.path.isfile(pj):
        with contextlib.suppress(Exception):
            with open(pj) as f:
                raw = json.load(f)
            src = raw.get("passwords") if isinstance(raw, dict) and isinstance(raw.get("passwords"), dict) else raw
            if isinstance(src, dict):
                for pw, meta in src.items():
                    if not pw or pw in out:
                        continue
                    meta = meta if isinstance(meta, dict) else {}
                    out[pw] = {"vk_hash": str(meta.get("vk_hash") or "").strip(),
                               "expires_at": int(meta.get("expires_at") or 0),
                               "is_deactivated": bool(meta.get("is_deactivated")), "comment": ""}
    return out


def _wdtt_read_paneldb(cfgdir):
    """ildarmaga's runtime store is SQLite panel.db (wdtt_users + wdtt_devices) — the analogue of amurcanov's
    passwords.json. Read it back for the snapshot in the SAME shape (pwds, devs). Never returns a private key.
    Under -fixed-config the single device is keyed 'pw:<password>' (getconfDeviceKey), which the caller resolves."""
    pwds, devs = {}, {}
    dbp = cfgdir + "/panel.db"
    if not os.path.exists(dbp):
        return pwds, devs
    with contextlib.suppress(Exception):
        import sqlite3
        c = sqlite3.connect(dbp, timeout=2)
        try:
            for pw, did, deact, exp, down, up in c.execute(
                    "SELECT password, device_id, is_deactivated, expires_at, down_bytes, up_bytes FROM wdtt_users"):
                pwds[pw] = {"device_id": did or "", "up_bytes": up or 0, "down_bytes": down or 0,
                            "is_deactivated": bool(deact), "expires_at": exp or 0}
            for did, ip, pub in c.execute("SELECT device_id, ip, pub_key FROM wdtt_devices"):
                devs[did] = {"ip": ip or "", "pub_key": pub or ""}
        finally:
            c.close()
    return pwds, devs

_WDTT_IFTRAF = {}   # iface -> (rx_bytes, tx_bytes, ts) — for per-second speed deltas between snapshots
def _wdtt_iface_traffic(iface):
    """The WDTT interface's cumulative rx/tx from /proc/net/dev (it's a real TUN device) + the per-second speed
    since the last read → (rx_bytes, tx_bytes, rx_speed, tx_speed). Lets the panel graph a WDTT interface exactly
    like a wg/awg one (its peers' traffic isn't in `wg show`, so this is the aggregate source)."""
    rxb = txb = 0
    try:
        with open("/proc/net/dev") as f:
            for line in f:
                if ":" not in line:
                    continue
                name, rest = line.split(":", 1)
                if name.strip() != iface:
                    continue
                p = rest.split()
                rxb, txb = int(p[0]), int(p[8]); break
    except Exception:
        return (0, 0, 0, 0)
    now = time.time(); prev = _WDTT_IFTRAF.get(iface); rs = ts = 0
    if prev and now - prev[2] > 0:
        dt = now - prev[2]
        rs = max(0, rxb - prev[0]) / dt
        ts = max(0, txb - prev[1]) / dt
    _WDTT_IFTRAF[iface] = (rxb, txb, now)
    return (rxb, txb, int(rs), int(ts))

def wdtt_snapshot():
    """Read each WDTT instance's runtime state back for the panel: service active, server pubkey + endpoint
    (for client links), and per-password observed device binding + traffic. Never returns any private key."""
    out = []
    insts = _wdtt_load()
    if not insts:
        return out
    for iface, inst in insts.items():
        svc = _wdtt_svc(iface)
        if inst.get("await_restore"):
            # Held after a wipe: a vaulted identity exists but the operator hasn't unlocked it, so nothing is
            # installed yet. Report it so the panel can offer the one-click restore instead of showing "dangling".
            out.append({"iface": iface, "service": svc, "active": "inactive", "listen": inst.get("listen", ""),
                        "wg_addr": inst.get("wg_addr", ""), "wg_port": inst.get("wg_port", ""),
                        "server_pub": "", "stopped": bool(inst.get("stopped")), "await_restore": True, "fork": inst.get("fork", "amurcanov"),
                        "passwords": {}, "devices": {}})
            continue
        if NODE_KIND == "docker":
            active = "active" if _wdtt_docker_alive(iface) else "inactive"
        else:
            active = (host_sh("systemctl is-active " + shlex.quote(svc) + " 2>/dev/null").stdout or "").strip()
        if inst.get("fork", "amurcanov") == "ildarmaga":
            pwds, devs = _wdtt_read_paneldb(_wdtt_dir(iface))   # ildarmaga: SQLite panel.db, not passwords.json
        else:
            pj = {}
            try:
                with open(_wdtt_dir(iface) + "/passwords.json") as f:
                    pj = json.load(f) or {}
            except Exception:
                pass
            pwds = {}
            for pw, e in (pj.get("passwords") or {}).items():
                e = e or {}
                pwds[pw] = {"device_id": e.get("device_id", ""), "up_bytes": e.get("up_bytes", 0),
                            "down_bytes": e.get("down_bytes", 0), "is_deactivated": bool(e.get("is_deactivated")),
                            "expires_at": e.get("expires_at", 0)}
            devs = {}
            for did, d in (pj.get("devices") or {}).items():
                d = d or {}
                devs[did] = {"ip": d.get("ip", ""), "pub_key": d.get("pub_key", "")}   # NO priv_key
        # per-password online = the bound device's pubkey has a RECENT WG handshake. Docker: read the UAPI socket
        # directly ({pubkey_b64: last_handshake_sec}) since `awg show dump` can't read a plain wireguard-go socket.
        hs = {}
        if NODE_KIND == "docker":
            _, hs = _wdtt_uapi(iface)
        else:
            _wgdump = (host_sh("wg show " + shlex.quote(iface) + " dump 2>/dev/null").stdout or "")
            for _ln in _wgdump.splitlines()[1:]:
                _f = _ln.split("\t")
                if len(_f) >= 5:
                    try: hs[_f[0]] = int(_f[4])
                    except ValueError: pass
        _nowt = int(time.time())
        for _pw, _pe in pwds.items():
            # device lookup: stock binds by device_id; -fixed-config keys the (single) device by "pw:<password>"
            # (device-agnostic → device_id stays empty), so fall back to that or online/IP would never resolve.
            _dev = devs.get(_pe.get("device_id") or "") or devs.get("pw:" + _pw) or {}
            _pub = _dev.get("pub_key") or ""
            _hsv = hs.get(_pub, 0)
            _pe["online"] = bool(_pub and _hsv and (_nowt - _hsv) < 180)
            _pe["ip"] = _dev.get("ip", "")   # the peer's assigned WDTT IP (readback/UI)
        srvpub = _wdtt_server_pub(iface)
        _rxb, _txb, _rxs, _txs = _wdtt_iface_traffic(iface)   # interface aggregate throughput → panel graphs it like a wg iface
        out.append({"iface": iface, "service": svc, "active": active, "listen": inst.get("listen", ""),
                    "wg_addr": inst.get("wg_addr", ""), "wg_port": inst.get("wg_port", ""),
                    "server_pub": srvpub, "stopped": bool(inst.get("stopped")), "fork": inst.get("fork", "amurcanov"),
                    "version": _wdtt_installed_ver(inst.get("fork", "amurcanov")),   # installed build version (version board + rollback)
                    "rx_bytes": _rxb, "tx_bytes": _txb, "rx_speed": _rxs, "tx_speed": _txs,
                    # Users recovered from a foreign server at take-over, for the panel to adopt into the roster.
                    # Reported until it has them (reconcile_wdtt drops the record once they appear in `desired`),
                    # NOT every cycle from the live store — that would resurrect a peer the operator deleted.
                    "adopt_users": inst.get("adopt_users") or {},
                    "passwords": pwds, "devices": devs})
    return out


# node self-update is NODE-ONLY: on a master box (panel + node together) it must NOT restart the
# co-located panel, or the panel restart breaks the very sync that would clear the update request.
DEFAULT_UPDATE_CMD = ("curl -fsSL https://raw.githubusercontent.com/SanityProtocol/swg-panel/main/"
                      "bootstrap.sh | bash -s update -y --no-components --node-only")


def run_self_update(node_cfg, want):
    """Run the swg-only in-place updater, detached so it survives swg-noded's own restart. Only ever
    called on a valid sync reply that carries an 'update'. Updates swg-noded/swg-agent (and a co-located
    panel) — NOT wg/awg/turn-proxies. The panel clears the request once we report the new version."""
    cmd = (node_cfg.get("node") or {}).get("update_cmd") or DEFAULT_UPDATE_CMD
    base = cmd if isinstance(cmd, list) else ["bash", "-lc", (cmd if os.geteuid() == 0 else "sudo -n " + cmd)]
    try:
        # run OUTSIDE swg-noded's own cgroup, so the updater's 'systemctl restart swg-noded' doesn't
        # kill the updater itself. systemd-run --scope gives it a fresh transient scope.
        if os.path.exists("/run/systemd/system") and shutil.which("systemd-run"):
            argv = ["systemd-run", "--scope", "--collect", "--quiet", "--unit", "swg-self-update"] + base
        else:
            argv = base
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print(f"self-update started → {want.get('to')}", flush=True)
        return True
    except Exception as e:
        print("self-update failed to start:", e, flush=True)
        return False


def report_proc(panel, state, err=None):
    """Best-effort POST of a lifecycle proc-status (e.g. 'update-failed' + reason) to the panel, so a failure
    that never reaches the normal script-side lifecycle reporting still surfaces as a red tag on the node."""
    try:
        u = panel["url"].rstrip("/") + "/api/node/proc-status"
        post_json(u, panel["token"], {"state": state, "err": (err or "")[:2000]}, panel)
        print(f"proc-status → {state}", flush=True)
    except Exception as e:
        print("proc-status report failed:", e, flush=True)


# ───────────────────────── main loop ─────────────────────────

# Routing convergence (egress SNAT + P2/P3 cascade) checks for drift by shelling out to `ip rule`,
# `iptables -S` and `nft list` (a big smart-routing table) — cheap individually but done EVERY sync it
# dominates a co-located master's CPU. Desired routing changes rarely, so we only run it on a change or
# every this-many seconds as a drift/reboot safety re-converge. Snapshot+POST (the 5s "alive" push) is
# never gated — the panel keeps seeing the node live every interval.
ROUTING_RECONCILE_EVERY_S = 60

# Silent-drift heal: the routing rebuilds above are signature-gated against DESIRED, so drift they don't inspect
# (an nft chain flushed by another tool, a rule lost across a partial apply, a marker that says "converged" while
# reality moved) would never repair on its own. Every VERIFY_EVERY_S we drop the rebuild sig-markers so the next
# routing pass re-asserts every chain/table from scratch against live state — the ordinary rebuild path, just
# forced. Cheap (rebuilds rules/chains, not set contents), so a large fleet pays it only twice an hour.
VERIFY_EVERY_S = 1800
def _force_reverify():
    """Drop the rebuild sig-markers so the next routing reconcile re-asserts the smart / count / DoH chains."""
    for fn in (".smart-sig", ".catcount-sig", ".doh.sig"):
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(GEO_DIR, fn))

_STATE_LOCK_FD = None          # held for the process lifetime → single-instance-per-state-dir guard
def _lock_state_dir():
    """Refuse to start a SECOND swg-noded on the same state dir. Two nodeds sharing /var/lib/swg-noded fight over
    the reconcile/interface state (and, on a master, can clobber the panel's view) — the same class of bug as two
    panels sharing one state dir. A node with a DIFFERENT state dir (SWG_NODED_STATE) uses its own lock → unaffected."""
    global _STATE_LOCK_FD
    with contextlib.suppress(OSError):
        os.makedirs(STATE_DIR, exist_ok=True)
    lp = os.path.join(STATE_DIR, ".noded.lock")
    try:
        fd = os.open(lp, os.O_WRONLY | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(f"refusing to start: another swg-noded already holds {lp} (state dir {STATE_DIR}). "
                 f"Stop the other instance first, or point this one at a separate SWG_NODED_STATE dir.")
    os.ftruncate(fd, 0); os.write(fd, (str(os.getpid()) + "\n").encode())
    _STATE_LOCK_FD = fd


def main():
    _lock_state_dir()
    node_cfg = json.load(open(CONFIG_PATH))
    panel = node_cfg.get("panel") or {}
    nd = node_cfg.get("node") or {}
    if not panel.get("url") or not panel.get("token"):
        sys.exit("config needs a 'panel' block with url + token")
    globals()["_TURN_PANEL"] = panel   # so the turn-binary MIRROR pull (apply_turn + docker bg reconcile) can reach the panel
    url = panel["url"].rstrip("/") + "/api/node/sync"
    token = panel["token"]
    interval = nd.get("interval", 5)
    online_max = nd.get("online_max", 180)
    agent = nd.get("agent", "/opt/swg-agent/swg-agent")
    sudo = bool(nd.get("sudo"))
    with contextlib.suppress(Exception):
        read_cpu_pct()               # prime the CPU baseline so the first sync reports utilization, not nothing
    os.makedirs(STATE_DIR, exist_ok=True)
    last_samples = {}
    last_route_sig = None; last_route_t = 0.0    # gate the heavy routing reconcile (see ROUTING_RECONCILE_EVERY_S)
    last_verify_t = time.time()                  # periodic full re-verify (silent-drift heal, see VERIFY_EVERY_S)
    PANEL_IP_FILE = os.path.join(STATE_DIR, "panel-ip")   # node IP role: source IP to dial the panel (persisted)
    panel_ip = ""; bad_pip = ""                     # bad_pip = a panel_ip that failed to connect → don't keep re-binding it
    with contextlib.suppress(OSError):
        panel_ip = open(PANEL_IP_FILE).read().strip()
    with contextlib.suppress(OSError):              # resume a mid-swap candidate after a restart (external nodes have no loopback _heal)
        _SWAP["cand"] = open(os.path.join(STATE_DIR, "panel-url-cand")).read().strip()
    update_started = False                          # spawn the self-updater at most once per process
    print(f"swg-noded: panel={panel['url']} interval={interval}s "
          f"ifaces={list((node_cfg.get('interfaces') or {}).keys())}", flush=True)
    if TURN_DOCKER:   # download + start turn-proxy containers in the BACKGROUND so the node appears on the
        threading.Thread(target=_dturn_bg_loop, daemon=True).start()   # panel immediately (cards show installing → up)
    while True:
        t0 = time.time()
        _LOOP["n"] += 1                             # new loop → per-loop caches (nft table render) refresh
        if t0 - last_verify_t >= VERIFY_EVERY_S:    # periodic drift heal: force the next routing pass to re-assert
            _force_reverify(); last_route_sig = None   # (drop sig-markers + un-gate the routing reconcile this cycle)
            last_verify_t = t0
            print("reverify: re-asserting routing chains against live state", flush=True)
        try:
            snap = build_snapshot(node_cfg, online_max, last_samples)
            use_ip = panel_ip if (panel_ip and panel_ip != bad_pip) else ""
            status, reply = post_json(url, token, {"snapshot": snap}, panel, source_ip=use_ip)
            if status == 0 and use_ip:              # fail-safe: a bound source couldn't reach the panel → retry unbound + stop binding that IP
                bad_pip = use_ip
                status, reply = post_json(url, token, {"snapshot": snap}, panel)
            if status == 200:                       # adopt the panel-chosen connection IP (persist; reset bad-flag if it changed)
                want_pip = ((reply.get("node_egress") or {}).get("panel_ip") or "").strip()
                if want_pip != panel_ip:
                    panel_ip = want_pip
                    if want_pip != bad_pip:
                        bad_pip = ""
                    with contextlib.suppress(OSError):
                        if want_pip:
                            with open(PANEL_IP_FILE + ".tmp", "w") as _f:
                                _f.write(want_pip)
                            os.replace(PANEL_IP_FILE + ".tmp", PANEL_IP_FILE)
                        else:
                            os.unlink(PANEL_IP_FILE)
            if status == 200 and isinstance(reply.get("desired"), dict):
                _newurl = apply_panel_hints(panel, node_cfg, reply)   # pin-gated auto-repoint on a panel host/port change
                if _newurl:
                    url = _newurl                                     # dial the new address from the next sync on
                ivk_process(reply.get("iface_vault_pub"), reply.get("iface_vault_want"))   # seal interface keys the panel wants for the operator vault (blob rides the next snapshot)
                wdtt_vault_process(reply.get("iface_vault_pub"), reply.get("wdtt_vault_want"))   # seal WDTT server identities (owner pw + wg-keys.dat) to the same vault
                _upd0 = reply.get("update")
                if _upd0 and not update_started:   # already fired THIS exact request (a recreate restarted us)? then DON'T re-fire — else the update loops forever (recreate → restart → re-trigger → recreate …)
                    _at = str((_upd0 or {}).get("at") or "")
                    _marker = os.path.join(STATE_DIR, ".update-done")   # persists across the container recreate (bind-mounted to data/node)
                    try: _prev = open(_marker).read().strip()
                    except Exception: _prev = ""
                    if _at and _at == _prev: update_started = True
                if reply.get("update") and not update_started:        # panel asked us to self-update (and we haven't fired this one yet)
                    _trig = os.environ.get("SWG_UPDATE_TRIGGER")
                    if _trig:   # docker node: a container can't recreate its own image — touch the HOST trigger
                        try:    # instead; its swg-update.path runs `compose pull && up` on the host (swg images only)
                            with open(_trig, "w") as _f: _f.write(str(int(time.time())) + "\n")
                            try: open(_marker, "w").write(_at)   # remember the request we fired so a recreate-restart won't re-fire it
                            except Exception: pass
                            update_started = True; print(f"update trigger written → {_trig}", flush=True)
                        except Exception as _e:
                            print("update trigger failed:", _e, flush=True)
                            report_proc(panel, "update-failed", f"swg-noded could not write the update trigger {_trig}: {_e}")
                            update_started = True   # reported the failure — don't retry the bad write every sync
                    elif NODE_KIND == "docker":
                        # docker node with NO host updater wired: a container can't recreate its own image, so
                        # run_self_update can do nothing. Report a clear failure instead of silently no-op'ing.
                        print("update requested but no host updater is wired (docker)", flush=True)
                        report_proc(panel, "update-failed",
                                    "This docker node has no one-click host updater wired. Re-install it "
                                    "(bootstrap docker node) to enable the panel's Update button, or update on the box: "
                                    "cd /opt/swg-panel-docker && docker compose --profile node pull && docker compose --profile node up -d")
                        update_started = True
                    else:
                        update_started = run_self_update(node_cfg, reply["update"])
                cr = create_ifaces(node_cfg, reply.get("create"), agent, sudo)   # create new interfaces
                dl = delete_ifaces(node_cfg, reply.get("delete"), agent, sudo)   # tear down deleted ones
                apply_panel_settings(reply.get("panel"))      # Panel settings → mirrors / geo TTL / geo refetch
                ob = onboard_ifaces(node_cfg, reply.get("onboard"))   # add panel-requested interfaces first
                tp = apply_turn(reply.get("turn"), reply.get("turn_onboard"))   # turn-proxy manage/onboard
                wd = reconcile_wdtt(reply.get("wdtt"), reply.get("wdtt_remove"))   # install/desired.json+SIGHUP; removals ONLY from the explicit list
                r = reconcile(node_cfg, reply["desired"], agent, sudo, reply.get("remove"))
                reconcile_dial_src(reply["desired"], r)        # Part 3: pin per-link outbound source IPs (folds into r)
                ri = reconcile_ifaces(node_cfg, reply.get("desired_ifaces") or {}, agent, sudo)   # set-iface: write the new listen-port to the conf FIRST
                rs = restart_ifaces(node_cfg, reply.get("restart"), agent, sudo)   # THEN bounce — a restart picks up the just-written conf (e.g. a changed port)
                sp = stop_ifaces(node_cfg, reply.get("iface_stop"), agent, sudo)    # stop (down + disable) / start (up + enable) on request
                sa = start_ifaces(node_cfg, reply.get("iface_start"), agent, sudo)
                ik = apply_iface_keys(node_cfg, reply.get("iface_key"), agent, sudo)   # keypair restore/rebaseline from the on-disk backup
                _def_egress = ((reply.get("node_egress") or {}).get("default_egress_ip") or "").strip()   # node IP role: fallback SNAT source
                # Only run the drift-checking routing reconcile when the DESIRED routing changed, an interface's
                # lifecycle changed this cycle, or the safety window elapsed — not every 5s. (See ROUTING_RECONCILE_EVERY_S.)
                _route_sig = json.dumps([reply.get("desired_ifaces"), reply.get("cascade"),
                                         reply.get("smart"), _def_egress], sort_keys=True, default=str)
                _iface_churn = bool(cr["created"] or dl["deleted"] or ob["added"] or rs["restarted"]
                                    or sp["stopped"] or sa["started"] or ri["changed"] or wd["changed"])   # a WDTT install/remove/change must trigger the egress reconcile (its subnet MASQUERADE) this cycle, not on the safety window
                if (_route_sig != last_route_sig or _iface_churn
                        or (time.time() - last_route_t) >= ROUTING_RECONCILE_EVERY_S):
                    eg = reconcile_egress(node_cfg, reply.get("desired_ifaces") or {}, _def_egress)   # per-interface egress SNAT (+ node default)
                    cas = reconcile_cascade(node_cfg, reply.get("cascade"), reply.get("smart"), _def_egress,
                                            panel_conn=panel, panel_cfg=reply.get("panel"))   # P2 forward + P3 smart + exit SNAT (+ panel-pull provider lists)
                    with contextlib.suppress(Exception):
                        reconcile_inet_chain(node_cfg)   # keep the SWG_INET byte-counting chain in step with the iface set (measured internet lane)
                    last_route_sig = _route_sig; last_route_t = time.time()
                else:
                    eg = {"changed": 0, "errors": []}; cas = {"changed": 0, "errors": []}   # unchanged routing → skip the ip/iptables/nft drift-check shell-outs
                # surface iface command failures to the panel too (cmd_errors), keyed by iface name — INCLUDING
                # keypair restore/rebaseline (ik): a failed Restore (e.g. awg-quick up failed) is reported so the
                # panel can show "restore failed" + the reason instead of hanging on "restoring".
                for blk in (cr, dl, ob, rs, sp, sa, ik, wd):
                    for e in blk["errors"]:
                        k, _, m = e.partition(": ")
                        NODE_ERRORS[k] = m or e
                for _n in ob.get("notes", []):                 # kept until the panel stops asking (pruned below)
                    _k, _, _m = _n.partition(": ")
                    NODE_NOTES[_k] = _m or _n
                for k in (cr.get("created", []) + dl.get("deleted", []) + ob.get("added", [])
                          + rs.get("restarted", []) + sp.get("stopped", []) + sa.get("started", [])
                          + ik.get("done", [])):
                    NODE_ERRORS.pop(k, None)
                # prune errors for requests the panel has since cleared (iface + turn + keypair restore)
                active = (set(reply.get("create") or {}) | set(reply.get("onboard") or {})
                          | set(reply.get("delete") or []) | set(reply.get("restart") or []) | set(reply.get("turn") or {})
                          | set(reply.get("iface_stop") or []) | set(reply.get("iface_start") or [])
                          | set(reply.get("iface_key") or {})
                          | set(reply.get("turn_onboard") or []) | set(reply.get("wdtt") or {}))
                for k in list(NODE_ERRORS):
                    if k not in active:
                        NODE_ERRORS.pop(k, None)
                for k in list(NODE_NOTES):
                    if k not in active:
                        NODE_NOTES.pop(k, None)
                for e in eg["errors"] + cas["errors"]:
                    print("egress: " + e, flush=True)
                if (r["added"] or r["removed"] or r["errors"] or ri["changed"] or ri["errors"]
                        or eg["changed"] or eg["errors"] or cas["changed"] or cas["errors"]
                        or ob["added"] or ob["errors"] or cr["created"] or cr["errors"]
                        or dl["deleted"] or dl["errors"] or tp["done"] or tp["errors"]):
                    print(f"reconcile: +{r['added']} -{r['removed']} ifaces~{ri['changed']} cascade~{cas['changed']} "
                          f"onboard+{ob['added']} create+{cr['created']} delete-{dl['deleted']} turn={tp['done']} "
                          f"errors={(r['errors'] + ri['errors'] + ob['errors'] + cr['errors'] + dl['errors'] + tp['errors'] + eg['errors'] + cas['errors'])[:3]}", flush=True)
                interval = reply.get("interval", interval)
            elif status == 0:
                print("sync error:", reply.get("error"), flush=True)
                # blessed address unreachable → settle onto a pending-swap candidate if it answers, else (loopback)
                # rediscover the panel locally. Either one re-points us so a domain/port swap never strands the node.
                _nu = _failover_candidate(panel, node_cfg) or _heal_local_panel(panel, node_cfg)
                if _nu:
                    url = _nu
            else:
                print(f"sync HTTP {status}: {reply.get('error')}", flush=True)
                _nu = _failover_candidate(panel, node_cfg) or _heal_local_panel(panel, node_cfg)
                if _nu:
                    url = _nu
        except Exception as e:
            print("loop error:", e, flush=True)
        with _TURN_JOBS_LOCK:                       # while an async reinstall/update is in flight, sync fast so the
            _busy = bool(_TURN_JOBS)                 # panel actually SEES the "updating" phase (else a sub-interval
        _iv = 1.0 if _busy else interval            # download finishes entirely between two 5s posts → pending→updated)
        time.sleep(max(0.5, _iv - (time.time() - t0)))


if __name__ == "__main__":
    main()
