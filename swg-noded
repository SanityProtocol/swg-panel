CONFIG_PATH = os.environ.get("SWG_AGENT_CONFIG", "/etc/swg-agent/config.json")
STATE_DIR   = os.environ.get("SWG_NODED_STATE", "/var/lib/swg-noded")


def _shared_record(name, legacy, env):
    """A record that survives a RUN-MODEL change, and the migration onto it.

    These three records — turn proxies, WDTT and csqtt instances — used to live at a path chosen by the
    run-model: /etc/swg-agent on bare-metal, the state dir in a container. So a box that switched (a
    convert, a declarative delivery change, a restore onto the other model) ended up with TWO copies that
    drift, and the switch made the OLDER one win: measured on a live master, an operator's turn-proxy port
    change and its wrap key silently reverted, which breaks every client of that proxy.

    STATE_DIR is the one directory every model already shares — bare-metal writes it directly, a container
    bind-mounts it, convert.sh carries it across — so put them there and be done. An explicit env still
    wins (compose and the Nix module both set these).

    Migration is NOT a plain copy, because both files can exist and either can be the fresher one: a box
    that ran as a container once has a shared copy that may be months stale. Newest mtime wins. The legacy
    file is left exactly where it is — a rollback to an older build must still find its record."""
    p = os.environ.get(env)
    if p:
        return p
    new = os.path.join(STATE_DIR, name)
    with contextlib.suppress(Exception):
        _n = os.path.exists(new)
        _l = os.path.exists(legacy)
        if _l and (not _n or os.path.getmtime(legacy) > os.path.getmtime(new)):
            os.makedirs(STATE_DIR, exist_ok=True)
            shutil.copy2(legacy, new)
            print("record: %s -> %s (the newer copy; records are shared across run-models now)"
                  % (legacy, new), flush=True)
    return new


TURN_RECORD = _shared_record("turn-proxy.json", "/etc/swg-agent/turn-proxy.json", "SWG_TURN_RECORD")
AWG_KEYS = ["Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4",
            "H1", "H2", "H3", "H4", "I1", "I2", "I3", "I4", "I5"]


