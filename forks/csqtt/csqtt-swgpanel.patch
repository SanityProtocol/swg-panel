+// the GETCONF answered NOCONF before anything is set up for that device, the password staying where it is.
+#[derive(Debug, PartialEq, Eq)]
+enum RebindPlan {
+    Move { old: String, row_moves: bool },
+    Blocked,
+    No,
+}
+
+fn rebind_plan(db: &Database, password: &str, device_id: &str) -> RebindPlan {
+    let Some(entry) = db.passwords.get(password) else {
+        return RebindPlan::No;
+    };
+    let old = &entry.device_id;
+    if old.is_empty() || old == device_id || !device_is_unclaimed(db, device_id) {
+        return RebindPlan::No;
+    }
+    let shared = *old == db.main_device_id
+        || db
+            .passwords
+            .iter()
+            .any(|(other, other_entry)| other != password && other_entry.device_id == *old);
+    let row_moves = !shared && db.devices.contains_key(old);
+    if !row_moves && get_next_ip(db).is_none() {
+        return RebindPlan::Blocked;
+    }
+    RebindPlan::Move { old: old.clone(), row_moves }
+}
