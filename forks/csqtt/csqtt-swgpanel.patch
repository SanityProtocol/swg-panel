+
+// A generated password follows its user to another device (see getconf_credential_access). Only under --desired —
+// the panel owns the password set there, and a config is portable like a WireGuard one; without it, stock csqtt's
+// one-device lock stands. Tests switch it per thread: the config is a process-wide OnceLock that the first reader
+// fixes, and tests run in parallel.
+pub fn password_follows_device() -> bool {
+    #[cfg(test)]
+    if TEST_FOLLOWS_DEVICE.with(std::cell::Cell::get) {
+        return true;
+    }
+    desired_path().is_some()
+}
+
+// A password that just left a device does not move straight back to it. Two devices starting one config at the same
+// moment send their workers' GETCONFs interleaved, and each GETCONF from the device that does not hold the password
+// would move it and drop the other device's workers set up so far: the device left holding it keeps only the workers
+// that came after the last move, and the client does not redial the rest. With this, the first move wins the burst —
+// the other device's GETCONFs are refused (the client says the password is bound to another device) — while a
+// device coming back later, after sleep or a network change, still takes the password as before.
+const MOVE_BACK_HOLD: std::time::Duration = std::time::Duration::from_secs(5);
+
+fn recent_moves() -> &'static std::sync::Mutex<std::collections::HashMap<String, (String, std::time::Instant)>> {
+    static MOVES: OnceLock<std::sync::Mutex<std::collections::HashMap<String, (String, std::time::Instant)>>> =
+        OnceLock::new();
+    MOVES.get_or_init(Default::default)
+}
+
+// Record that `password` just left `device_id`.
+pub fn note_password_left(password: &str, device_id: &str) {
+    let now = std::time::Instant::now();
+    let mut moves = recent_moves().lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    moves.retain(|_, (_, at)| now.duration_since(*at) < MOVE_BACK_HOLD);
+    moves.insert(password.to_owned(), (device_id.to_owned(), now));
+}
+
+// Did `password` leave `device_id` within MOVE_BACK_HOLD?
+pub fn password_left_recently(password: &str, device_id: &str) -> bool {
+    let moves = recent_moves().lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    moves
+        .get(password)
+        .is_some_and(|(left, at)| left == device_id && at.elapsed() < MOVE_BACK_HOLD)
+}
+
+#[cfg(test)]
+thread_local! {
+    static TEST_FOLLOWS_DEVICE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+// Panel mode for the calling test's thread, switched off again when the guard drops — so no later test that the
+// runner happens to put on the same thread inherits it.
+#[cfg(test)]
+pub(crate) struct FollowsDeviceForTest;
+
+#[cfg(test)]
+impl FollowsDeviceForTest {
+    pub(crate) fn on() -> Self {
+        TEST_FOLLOWS_DEVICE.with(|follows| follows.set(true));
+        Self
+    }
+}
+
+#[cfg(test)]
+impl Drop for FollowsDeviceForTest {
+    fn drop(&mut self) {
+        TEST_FOLLOWS_DEVICE.with(|follows| follows.set(false));
+    }
+}
