+// swg-panel: the source address of an IPv4 packet (bytes 12..16). Used to reject an uplink packet whose
+// source is not the tunnel address the panel assigned to the sending session (a keyless share source must
+// prove which identity a packet belongs to). Non-IPv4 uplink returns None → dropped by the caller.
+pub fn extract_src_ipv4(packet: &[u8]) -> Option<[u8; 4]> {
+    if packet.len() < 20 || packet[0] >> 4 != 4 {
+        return None;
+    }
+    Some([packet[12], packet[13], packet[14], packet[15]])
+}
