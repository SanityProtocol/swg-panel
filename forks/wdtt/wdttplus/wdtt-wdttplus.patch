+type desiredEntry struct {
+	ExpiresAt     int64  `json:"expires_at"`
+	VkHash        string `json:"vk_hash"`
+	Ports         string `json:"ports"`
+	IsDeactivated bool   `json:"is_deactivated"`
+}
+type desiredFileT struct {
+	Passwords map[string]*desiredEntry `json:"passwords"`
+}
+
+// reconcileDesired merges the panel-owned desired password set into the live DB and — the load-bearing part —
+// REAPS the wg peer + device for any password now gone (rotate) or deactivated (block). Fixed-config binds the
+// device under "pw:<password>", so resolve by that key; also reaps orphans. Runs on boot, SIGHUP, and mtime change.
+// The node-owned owner password (-password) is not in desired.json: its devices are keyed by the client's device
+// id and recorded in the admin profile, so they are skipped — reaping them cut the owner's session on every
+// unrelated roster change.
+func reconcileDesired(wgDev wgDevice) { // wgDevice (v13+): works with BOTH the userspace and kernel backends
+	if desiredFile == "" {
+		return
+	}
+	data, err := os.ReadFile(desiredFile)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			log.Printf("[DESIRED] read %s: %v", desiredFile, err)
+		}
+		return
+	}
+	var want desiredFileT
+	if err := json.Unmarshal(data, &want); err != nil {
+		log.Printf("[DESIRED] parse: %v", err)
+		return
+	}
+	dbMutex.Lock()
+	changed := false
+	for pw, d := range want.Passwords {
+		if pw == "" || d == nil {
+			continue
+		}
+		e, ok := db.Passwords[pw]
+		if !ok {
+			e = &PasswordEntry{}
+			db.Passwords[pw] = e
+			changed = true
+			log.Printf("[DESIRED] + пароль %s", maskPassword(pw))
+		}
+		if e.ExpiresAt != d.ExpiresAt || e.VkHash != d.VkHash || e.Ports != d.Ports || e.IsDeactivated != d.IsDeactivated {
+			e.ExpiresAt = d.ExpiresAt
+			e.VkHash = d.VkHash
+			e.Ports = d.Ports
+			e.IsDeactivated = d.IsDeactivated
+			changed = true
+		}
+	}
+	for pw := range db.Passwords {
+		if pw == db.MainPassword {
+			continue
+		}
+		if _, ok := want.Passwords[pw]; !ok {
+			delete(db.Passwords, pw)
+			changed = true
+			log.Printf("[DESIRED] - пароль %s", maskPassword(pw))
+		}
+	}
+	// swg-panel: under -fixed-config GETCONF binds a generated password to "pw:<password>". A password bound to a
+	// client's own device ID — a store written before -fixed-config, or adopted from a stock server — is refused on
+	// EVERY device, that one included, since GETCONF presents "pw:<password>" and the binding check compares. Such a
+	// binding is moved onto the fixed-config key here: the device row goes with it (address and keys kept, so the
+	// user's config and every rule on their address stay valid) unless the owner or another password still names it,
+	// or a key row already exists. Otherwise the binding is cleared, the next GETCONF binds the key with a fresh
+	// address, and the old row goes in the reap below. The binding history records the old device as unbound, as
+	// every other unbind path here does.
+	if fixedConfig && migrateFixedBindingsLocked(db, time.Now().Unix()) {
+		changed = true
+	}
+	ownerDevices := adminDeviceIDSet(db)
+	for dkey, dev := range db.Devices {
+		pw := dkey
+		if strings.HasPrefix(dkey, "pw:") {
+			pw = dkey[3:]
+		} else if _, isOwner := ownerDevices[dkey]; isOwner {
+			continue // the owner password's device: no roster user, never the panel's to reap
+		}
+		e, ok := db.Passwords[pw]
+		if !ok || e == nil || e.IsDeactivated {
+			removePeerFromWG(wgDev, dev)
+			delete(db.Devices, dkey)
+			changed = true
+		}
+	}
+	if changed {
+		if err := saveDB(); err != nil {
+			log.Printf("[DESIRED] сверка применена в памяти, но база не сохранена: %v", err)
+		}
+	}
+	if err := refreshWrapKeysFromDBLocked(); err != nil {
+		log.Printf("[DESIRED] wrap keys: %v", err)
+	}
+	dbMutex.Unlock()
+	syncPersistedPeersToWG(wgDev)
+}
+
+// migrateFixedBindingsLocked moves every generated password still bound to a client's own device ID onto its
+// -fixed-config key "pw:<password>" (see reconcileDesired). Caller holds dbMutex. Reports whether anything changed.
+func migrateFixedBindingsLocked(db *Database, now int64) bool {
+	changed := false
+	owners := adminDeviceIDSet(db)
+	// How many passwords name each device, counted BEFORE any binding moves: counting inside the loop would let
+	// whichever of two sharing passwords Go's map order visits last see the row as its own and take it.
+	holders := make(map[string]int)
+	for _, o := range db.Passwords {
+		if o != nil && o.DeviceID != "" {
+			holders[o.DeviceID]++
+		}
+	}
+	for pw, e := range db.Passwords {
+		if pw == db.MainPassword || e == nil || e.DeviceID == "" || e.DeviceID == "pw:"+pw {
+			continue
+		}
+		old, key := e.DeviceID, "pw:"+pw
+		_, shared := owners[old]
+		// A "pw:" row is another password's fixed-config device (an adopted or hand-edited store bound to it): never
+		// ours to take, whether or not that password is bound to it right now.
+		shared = shared || holders[old] > 1 || strings.HasPrefix(old, "pw:")
+		markActiveBindUnbound(e, old, now)
+		if dev := db.Devices[old]; dev != nil && !shared && db.Devices[key] == nil {
+			delete(db.Devices, old)
+			dev.DeviceID = key
+			db.Devices[key] = dev
+			e.DeviceID = key
+			appendBindHistory(e, BindHistoryEntry{
+				DeviceID:   key,
+				DeviceName: deviceDisplayName(dev),
+				DeviceIP:   dev.IP,
+				RemoteIP:   dev.RemoteIP,
+				Country:    dev.Country,
+				BoundAt:    now,
+				EventAt:    now,
+				Status:     "active",
+			})
+			log.Printf("[DESIRED] пароль %s: устройство %s перенесено на -fixed-config ключ (адрес сохранён)", maskPassword(pw), deviceLogRef(old))
+		} else {
+			e.DeviceID = ""
+			log.Printf("[DESIRED] пароль %s: привязка к устройству %s снята (-fixed-config)", maskPassword(pw), deviceLogRef(old))
+		}
+		changed = true
+	}
+	return changed
+}
+
+// desiredWatcher reconciles when the desired file's mtime changes (belt-and-suspenders alongside SIGHUP).
+func desiredWatcher(ctx context.Context, wgDev wgDevice) {
+	if desiredFile == "" {
+		return
+	}
+	var last int64
+	if fi, err := os.Stat(desiredFile); err == nil {
+		last = fi.ModTime().UnixNano()
+	}
+	ticker := time.NewTicker(3 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			fi, err := os.Stat(desiredFile)
+			if err != nil {
+				continue
+			}
+			if m := fi.ModTime().UnixNano(); m != last {
+				last = m
+				reconcileDesired(wgDev)
+			}
+		}
+	}
+}
+
+var errNoPanelService = errors.New("отключено на этом сервере (-no-panel)")
+
+// inTunnelServiceRefusal answers, under -no-panel, the in-tunnel requests that make the NODE act on a client's
+// behalf — update metadata (GitHub), APK download (up to 200 MB), an HTTPS POST to any public host, and the
+// deploy/admin relay — the way upstream answers a busy relay: an ACK, then an error frame. None of them runs. Any
+// valid password could otherwise make the node fetch or POST from its own address, outside that peer's routing and
+// blocking. Without -no-panel: stock behaviour.
+func inTunnelServiceRefusal(packet []byte) ([][]byte, bool) {
+	if !noPanel {
+		return nil, false
+	}
+	refuse := func(ackPrefix, requestID string, frames [][]byte) ([][]byte, bool) {
+		return append([][]byte{[]byte(ackPrefix + requestID + "|ACK|")}, frames...), true
+	}
+	if requestID, ok := parseUpdateMetadataRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, requestID, encodeUpdateMetadataResponse(requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseOpaqueHTTPSRequest(packet); ok {
+		return refuse(opaqueHTTPSResponsePrefix, request.requestID, encodeOpaqueHTTPSResponse(request.requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseUpdateAPKChunkRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, request.requestID, encodeUpdateAPKChunkResponse(request.requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseDeploySafeStartRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, request.requestID, encodeUpdateMetadataResponse(request.requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseDeploySafeChunkRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, request.requestID, encodeUpdateAPKChunkResponse(request.requestID, nil, errNoPanelService))
+	}
+	return nil, false
+}
