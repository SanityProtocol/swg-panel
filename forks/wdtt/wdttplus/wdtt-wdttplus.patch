+var errNoPanelService = errors.New("отключено на этом сервере (-no-panel)")
+
+// inTunnelServiceRefusal answers, under -no-panel, the in-tunnel requests that make the NODE act on a client's
+// behalf — update metadata (GitHub), APK download (up to 200 MB), an HTTPS POST to any public host, and the
+// deploy/admin relay — the way upstream answers a busy relay: an ACK, then an error frame. None of them runs. Any
+// valid password could otherwise make the node fetch or POST from its own address, outside that peer's routing and
+// blocking. Without -no-panel: stock behaviour.
+func inTunnelServiceRefusal(packet []byte) ([][]byte, bool) {
+	if !noPanel {
+		return nil, false
+	}
+	refuse := func(ackPrefix, requestID string, frames [][]byte) ([][]byte, bool) {
+		return append([][]byte{[]byte(ackPrefix + requestID + "|ACK|")}, frames...), true
+	}
+	if requestID, ok := parseUpdateMetadataRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, requestID, encodeUpdateMetadataResponse(requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseOpaqueHTTPSRequest(packet); ok {
+		return refuse(opaqueHTTPSResponsePrefix, request.requestID, encodeOpaqueHTTPSResponse(request.requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseUpdateAPKChunkRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, request.requestID, encodeUpdateAPKChunkResponse(request.requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseDeploySafeStartRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, request.requestID, encodeUpdateMetadataResponse(request.requestID, nil, errNoPanelService))
+	}
+	if request, ok := parseDeploySafeChunkRequest(packet); ok {
+		return refuse(updateMetadataResponsePrefix, request.requestID, encodeUpdateAPKChunkResponse(request.requestID, nil, errNoPanelService))
+	}
+	return nil, false
+}
