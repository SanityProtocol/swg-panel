@@ -0,0 +1,63 @@
+package main
+
+import "testing"
+
+// swg-panel: migrateFixedBindingsLocked (reconcileDesired, -fixed-config). A password bound to a client's own device
+// ID moves onto "pw:<password>" with its row — address and keys kept — unless the owner or another password still
+// names that row; then the binding is cleared, whatever order the map is visited in.
+func TestMigrateFixedBindingsKeepsTheAddressAndNeverTakesASharedRow(t *testing.T) {
+	for round := 0; round < 50; round++ { // map order is random: a result that depended on it would flip
+		db := &Database{
+			MainPassword: "owner",
+			AdminProfile: AdminProfileEntry{DeviceIDs: []string{"owner-phone"}},
+			Passwords: map[string]*PasswordEntry{
+				"pw-a":   {DeviceID: "phone-a", BindHistory: []BindHistoryEntry{{DeviceID: "phone-a", Status: "active"}}},
+				"pw-b":   {DeviceID: "shared"},
+				"pw-c":   {DeviceID: "shared"},
+				"pw-d":   {DeviceID: "owner-phone"},
+				"pw-e":   {DeviceID: "pw:pw-e"},
+				"pw-f":   {DeviceID: "pw:pw-g"},
+				"pw-g":   {},
+				"pw-new": {},
+			},
+			Devices: map[string]*ClientDevice{
+				"phone-a":     {DeviceID: "phone-a", IP: "10.66.66.3", PubKey: "KA"},
+				"shared":      {DeviceID: "shared", IP: "10.66.66.4"},
+				"owner-phone": {DeviceID: "owner-phone", IP: "10.66.66.2"},
+				"pw:pw-e":     {DeviceID: "pw:pw-e", IP: "10.66.66.5"},
+				"pw:pw-g":     {DeviceID: "pw:pw-g", IP: "10.66.66.6"},
+			},
+		}
+		if !migrateFixedBindingsLocked(db, 1000) {
+			t.Fatal("expected changes")
+		}
+		a := db.Devices["pw:pw-a"]
+		if db.Passwords["pw-a"].DeviceID != "pw:pw-a" || a == nil || a.IP != "10.66.66.3" || a.PubKey != "KA" || a.DeviceID != "pw:pw-a" {
+			t.Fatalf("sole holder must move with its row: %+v %+v", db.Passwords["pw-a"], a)
+		}
+		if _, left := db.Devices["phone-a"]; left {
+			t.Fatal("the old key must be gone")
+		}
+		h := db.Passwords["pw-a"].BindHistory
+		if len(h) != 2 || h[0].Status != "unbound" || h[1].DeviceID != "pw:pw-a" || h[1].Status != "active" {
+			t.Fatalf("history must show the old device unbound and the key active: %+v", h)
+		}
+		for _, pw := range []string{"pw-b", "pw-c", "pw-d"} {
+			if db.Passwords[pw].DeviceID != "" {
+				t.Fatalf("round %d: %s shares its row and must be cleared, got %q", round, pw, db.Passwords[pw].DeviceID)
+			}
+		}
+		if db.Devices["shared"] == nil || db.Devices["owner-phone"] == nil || db.Devices["pw:pw-b"] != nil || db.Devices["pw:pw-c"] != nil {
+			t.Fatalf("round %d: a shared or owner row must never move: %v", round, db.Devices)
+		}
+		if db.Passwords["pw-f"].DeviceID != "" || db.Devices["pw:pw-g"] == nil || db.Devices["pw:pw-f"] != nil {
+			t.Fatalf("a binding to another password's key is cleared, and that row is never taken: %v", db.Devices)
+		}
+		if db.Passwords["pw-e"].DeviceID != "pw:pw-e" || db.Passwords["pw-new"].DeviceID != "" {
+			t.Fatal("already-keyed and unbound passwords are left alone")
+		}
+		if migrateFixedBindingsLocked(db, 2000) {
+			t.Fatal("a second pass must change nothing")
+		}
+	}
+}
