+// reconcileDesired merges the panel-owned desired password set into the live DB and — the load-bearing part —
+// REAPS the wg peer + device for any password now gone (rotate) or deactivated (block). Fixed-config binds the
+// device under "pw:<password>", so resolve by that key; also reaps orphans. Runs on boot, SIGHUP, and mtime change.
+// The node-owned owner password (-password) is not in desired.json: its devices are keyed by the client's device
+// id and recorded in the admin profile, so they are skipped — reaping them cut the owner's session on every
+// unrelated roster change.
+func reconcileDesired(wgDev wgDevice) { // wgDevice (v13+): works with BOTH the userspace and kernel backends
+	if desiredFile == "" {
+		return
+	}
+	data, err := os.ReadFile(desiredFile)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			log.Printf("[DESIRED] read %s: %v", desiredFile, err)
+		}
+		return
+	}
+	var want desiredFileT
+	if err := json.Unmarshal(data, &want); err != nil {
+		log.Printf("[DESIRED] parse: %v", err)
+		return
+	}
+	dbMutex.Lock()
+	changed := false
+	for pw, d := range want.Passwords {
+		if pw == "" || d == nil {
+			continue
+		}
+		e, ok := db.Passwords[pw]
+		if !ok {
+			e = &PasswordEntry{}
+			db.Passwords[pw] = e
+			changed = true
+			log.Printf("[DESIRED] + пароль %s", maskPassword(pw))
+		}
+		if e.ExpiresAt != d.ExpiresAt || e.VkHash != d.VkHash || e.Ports != d.Ports || e.IsDeactivated != d.IsDeactivated {
+			e.ExpiresAt = d.ExpiresAt
+			e.VkHash = d.VkHash
+			e.Ports = d.Ports
+			e.IsDeactivated = d.IsDeactivated
+			changed = true
+		}
+	}
+	for pw := range db.Passwords {
+		if pw == db.MainPassword {
+			continue
+		}
+		if _, ok := want.Passwords[pw]; !ok {
+			delete(db.Passwords, pw)
+			changed = true
+			log.Printf("[DESIRED] - пароль %s", maskPassword(pw))
+		}
+	}
+	ownerDevices := adminDeviceIDSet(db)
+	for dkey, dev := range db.Devices {
+		pw := dkey
+		if strings.HasPrefix(dkey, "pw:") {
+			pw = dkey[3:]
+		} else if _, isOwner := ownerDevices[dkey]; isOwner {
+			continue // the owner password's device: no roster user, never the panel's to reap
+		}
+		e, ok := db.Passwords[pw]
+		if !ok || e == nil || e.IsDeactivated {
+			removePeerFromWG(wgDev, dev)
+			delete(db.Devices, dkey)
+			changed = true
+		}
+	}
+	if changed {
+		if err := saveDB(); err != nil {
+			log.Printf("[DESIRED] сверка применена в памяти, но база не сохранена: %v", err)
+		}
+	}
+	if err := refreshWrapKeysFromDBLocked(); err != nil {
+		log.Printf("[DESIRED] wrap keys: %v", err)
+	}
+	dbMutex.Unlock()
+	syncPersistedPeersToWG(wgDev)
+}
+
+// desiredWatcher reconciles when the desired file's mtime changes (belt-and-suspenders alongside SIGHUP).
+func desiredWatcher(ctx context.Context, wgDev wgDevice) {
+	if desiredFile == "" {
+		return
+	}
+	var last int64
+	if fi, err := os.Stat(desiredFile); err == nil {
+		last = fi.ModTime().UnixNano()
+	}
+	ticker := time.NewTicker(3 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			fi, err := os.Stat(desiredFile)
+			if err != nil {
+				continue
+			}
+			if m := fi.ModTime().UnixNano(); m != last {
+				last = m
+				reconcileDesired(wgDev)
+			}
+		}
+	}
+}
