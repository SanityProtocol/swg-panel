+// ── Panel-owned desired-state input (see types.go desiredFile) ───────────────
+
+// DesiredPassword is the panel-owned subset of a generated password's config.
+// Runtime fields (DeviceID, UpBytes, DownBytes) are NOT here — WDTT owns those.
+type DesiredPassword struct {
+	ExpiresAt     int64  `json:"expires_at,omitempty"`
+	VkHash        string `json:"vk_hash,omitempty"`
+	Ports         string `json:"ports,omitempty"`
+	IsDeactivated bool   `json:"is_deactivated,omitempty"`
+}
+
+type DesiredFile struct {
+	Passwords map[string]*DesiredPassword `json:"passwords"`
+}
+
+// reconcileDesired merges the panel's desired generated-password set into the
+// live DB: add new passwords, update panel-owned fields, and remove passwords no
+// longer desired (dropping their bound device + wg peer). Runtime fields
+// (DeviceID/UpBytes/DownBytes) are preserved for surviving passwords, then WRAP
+// keys and wg peers are re-synced — so a panel edit takes effect with no restart
+// and no tunnel drop for unaffected devices. The owner (main) password is never
+// touched here (it is a flag / server identity). No-op if -desired is unset.
+func reconcileDesired(wgDev *device.Device) {
+	if desiredFile == "" {
+		return
+	}
+	data, err := os.ReadFile(desiredFile)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			log.Printf("[DESIRED] Чтение %s: %v", desiredFile, err)
+		}
+		return
+	}
+	var want DesiredFile
+	if err := json.Unmarshal(data, &want); err != nil {
+		log.Printf("[DESIRED] Разбор %s: %v", desiredFile, err)
+		return
+	}
+	if want.Passwords == nil {
+		want.Passwords = map[string]*DesiredPassword{}
+	}
+
+	dbMutex.Lock()
+	changed := false
+
+	// Add / update desired passwords, preserving runtime fields.
+	for p, d := range want.Passwords {
+		if p == "" || d == nil {
+			continue
+		}
+		e, ok := db.Passwords[p]
+		if !ok {
+			e = &PasswordEntry{}
+			db.Passwords[p] = e
+			changed = true
+			log.Printf("[DESIRED] + пароль %s", maskPassword(p))
+		}
+		if e.ExpiresAt != d.ExpiresAt || e.VkHash != d.VkHash || e.Ports != d.Ports || e.IsDeactivated != d.IsDeactivated {
+			// Newly deactivated → drop the live peer immediately.
+			if d.IsDeactivated && !e.IsDeactivated && e.DeviceID != "" {
+				removePeerFromWG(wgDev, db.Devices[e.DeviceID])
+			}
+			e.ExpiresAt = d.ExpiresAt
+			e.VkHash = d.VkHash
+			e.Ports = d.Ports
+			e.IsDeactivated = d.IsDeactivated
+			changed = true
+		}
+	}
+
+	// Remove passwords no longer desired (+ their device + wg peer).
+	for p, e := range db.Passwords {
+		if _, ok := want.Passwords[p]; ok {
+			continue
+		}
+		if e != nil && e.DeviceID != "" {
+			removePeerFromWG(wgDev, db.Devices[e.DeviceID])
+			delete(db.Devices, e.DeviceID)
+		}
+		delete(db.Passwords, p)
+		changed = true
+		log.Printf("[DESIRED] - пароль %s", maskPassword(p))
+	}
+
+	// Load-bearing disconnect: drop the wg peer + device for any password that's now GONE or DEACTIVATED. Fixed-config
+	// binds the device under "pw:<password>" and leaves PasswordEntry.DeviceID EMPTY, so the per-branch removals above
+	// can't find it — resolve by the key here. Also reaps orphans (devices whose password was rotated away earlier).
+	// Without this, rotate/block only deny NEW connections; the ACTIVE tunnel lingers until its handshake expires.
+	for dkey, dev := range db.Devices {
+		pw := dkey
+		if len(pw) > 3 && pw[:3] == "pw:" {
+			pw = pw[3:]
+		}
+		e, ok := db.Passwords[pw]
+		if !ok || e == nil || e.IsDeactivated {
+			removePeerFromWG(wgDev, dev)
+			delete(db.Devices, dkey)
+			changed = true
+			log.Printf("[DESIRED] × device %s (пароль gone/deactivated)", maskPassword(pw))
+		}
+	}
+
+	if changed {
+		saveDBLazy()
+	}
+	if err := refreshWrapKeysFromDBLocked(); err != nil {
+		log.Printf("[DESIRED] Обновление WRAP-ключей: %v", err)
+	}
+	dbMutex.Unlock()
+
+	// Re-add surviving devices' peers (idempotent; takes the lock itself).
+	syncPersistedPeersToWG(wgDev)
+}
