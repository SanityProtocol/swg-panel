@@ -0,0 +1,106 @@
+package main
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// -fixed-config: a GENERATED password owns ONE keypair+IP, keyed "pw:<password>", returned to ANY deviceID (wg/awg
+// parity). Stock mode keys by deviceID.
+func TestFixedConfigDeviceKey(t *testing.T) {
+	old := fixedConfig
+	defer func() { fixedConfig = old }()
+
+	fixedConfig = true
+	if getconfDeviceKey(true, "x", "pwA") != "pw:pwA" || getconfDeviceKey(true, "y", "pwA") != "pw:pwA" {
+		t.Fatalf("fixed-config: same password must map to one key regardless of deviceID")
+	}
+	if getconfDeviceKey(false, "x", "main") != "x" {
+		t.Fatalf("the owner password keeps device-ID keys")
+	}
+	fixedConfig = false
+	if getconfDeviceKey(true, "x", "pwA") == getconfDeviceKey(true, "y", "pwA") {
+		t.Fatalf("stock mode must key by deviceID")
+	}
+}
+
+// A "pw:" device belongs to the password it names: never to the owner, never to another password, and it is not
+// listed among the owner's devices.
+func TestFixedConfigKeyOwnership(t *testing.T) {
+	database := &Database{
+		Passwords: map[string]*PasswordEntry{"pwA": {}, "pwB": {}},
+		Devices: map[string]*ClientDevice{
+			"pw:pwA":      {DeviceID: "pw:pwA"},
+			"owner-phone": {DeviceID: "owner-phone"},
+		},
+	}
+	if connectionOwnsDevice(database, "pw:pwA", "owner", true) {
+		t.Fatalf("the owner password must not claim a pw: device")
+	}
+	if connectionOwnsDevice(database, "pw:pwA", "pwB", false) {
+		t.Fatalf("another password must not claim a pw: device")
+	}
+	if !connectionOwnsDevice(database, "pw:pwA", "pwA", false) {
+		t.Fatalf("a password must own its own pw: device")
+	}
+	if !connectionOwnsDevice(database, "owner-phone", "owner", true) {
+		t.Fatalf("the owner must still own its device-ID devices")
+	}
+	if ids := mainDeviceIDs(database); len(ids) != 1 || ids[0] != "owner-phone" {
+		t.Fatalf("mainDeviceIDs = %v, want only owner-phone", ids)
+	}
+}
+
+// A store written by a build that bound devices by device ID — including a binding to a device its reconcile had
+// deleted, which used to make every later start fail validation — loads under -fixed-config: the live device is
+// re-keyed with its keypair and address kept, and the dangling binding is dropped.
+func TestFixedConfigStoreMigration(t *testing.T) {
+	old := fixedConfig
+	defer func() { fixedConfig = old }()
+	fixedConfig = true
+
+	priv, pub := mustPair(t)
+	ownerPriv, ownerPub := mustPair(t)
+	legacy := &Database{
+		Passwords: map[string]*PasswordEntry{
+			"pwLive": {DeviceID: "phone-1", Ports: "56000,56001,9000"},
+			"pwGone": {DeviceID: "tablet-2", Ports: "56000,56001,9000"},
+		},
+		Devices: map[string]*ClientDevice{
+			"phone-1":     {DeviceID: "phone-1", IP: "10.66.66.2", PrivKey: priv, PubKey: pub},
+			"owner-phone": {DeviceID: "owner-phone", IP: "10.66.66.3", PrivKey: ownerPriv, PubKey: ownerPub},
+		},
+	}
+	data, err := json.Marshal(legacy)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "passwords.json"), data, 0600); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	if err := initDB(dir, "Strong-Test_7kM9xQ2", "", ""); err != nil {
+		t.Fatalf("initDB on a legacy store: %v", err)
+	}
+	dev := db.Devices["pw:pwLive"]
+	if dev == nil || dev.DeviceID != "pw:pwLive" || dev.IP != "10.66.66.2" || dev.PubKey != pub {
+		t.Fatalf("live device not re-keyed with its address and keypair: %+v", dev)
+	}
+	if db.Devices["phone-1"] != nil || db.Passwords["pwLive"].DeviceID != "" || db.Passwords["pwGone"].DeviceID != "" {
+		t.Fatalf("legacy bindings left behind")
+	}
+	if db.Devices["owner-phone"] == nil {
+		t.Fatalf("the owner's device must survive the migration")
+	}
+}
+
+func mustPair(t *testing.T) (string, string) {
+	t.Helper()
+	priv, pub, err := generateKeyPair()
+	if err != nil {
+		t.Fatalf("keygen: %v", err)
+	}
+	return priv, pub
+}
