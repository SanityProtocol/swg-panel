diff --git a/server/desired_ingest.go b/server/desired_ingest.go
new file mode 100644
index 0000000..0f433b0
--- /dev/null
+++ b/server/desired_ingest.go
@@ -0,0 +1,206 @@
+package server
+
+// swg-panel integration: the node pushes the panel-owned password SET as a desired.json file (the SAME
+// format the amurcanov fork consumes) and SIGHUPs. We ingest it into wdtt_users — the server's own SQLite
+// store — so the node's WDTT driver stays fork-agnostic: NO node-side SQLite, NO web panel, NO schema work.
+// Only the four panel-owned fields per password are authoritative; runtime state (devices/traffic) is the
+// server's. Users present in the DB but absent from the file are revoked (the owner/main password is never
+// touched). ingest writes SQLite; reloadDBFromDisk() applies it to memory + the live WG device.
+
+import (
+	"database/sql"
+	"encoding/json"
+	"log"
+	"os"
+	"path/filepath"
+
+	"github.com/ildarmaga/wdtt/pkg/paneldb"
+)
+
+var desiredPath string // set from -desired
+
+// ensurePanelDB creates panel.db + schema when it's missing. Stock ildarmaga relies on its web panel to
+// create the DB; in swg-panel's server-only mode there is no panel, and paneldb.Open() refuses a missing
+// file (os.Stat guard). Must run BEFORE the first openServerPanelDB (which is memoized by a sync.Once, so a
+// first-run failure would stick). SQLite creates the file on first Ping; EnsureWDTTSchema builds the tables.
+func ensurePanelDB() error {
+	if panelDBPath == "" {
+		return nil
+	}
+	if _, err := os.Stat(panelDBPath); err == nil {
+		return nil // already exists
+	}
+	if dir := filepath.Dir(panelDBPath); dir != "" {
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			return err
+		}
+	}
+	d, err := sql.Open("sqlite", paneldb.DSN(panelDBPath))
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	if err := d.Ping(); err != nil {
+		return err
+	}
+	if _, err := d.Exec(baseWDTTSchema); err != nil {
+		return err
+	}
+	return paneldb.EnsureWDTTSchema(d) // idempotent ALTER migrations (sub_id, last_seen_at, …)
+}
+
+// baseWDTTSchema — the wdtt_* base tables (verbatim from the web panel's normalizer, which the server-only
+// build doesn't include). CREATE IF NOT EXISTS so it's safe to re-run. Empty wdtt_inbound → the server falls
+// back to the CLI inbound flags (-listen/-wg-port/-admin-addr), which is exactly what we want.
+const baseWDTTSchema = `
+CREATE TABLE IF NOT EXISTS wdtt_global (
+	id INTEGER PRIMARY KEY CHECK (id = 1),
+	main_password TEXT NOT NULL DEFAULT '',
+	admin_id TEXT NOT NULL DEFAULT '',
+	bot_token TEXT NOT NULL DEFAULT '',
+	users_rev INTEGER NOT NULL DEFAULT 0
+);
+CREATE TABLE IF NOT EXISTS wdtt_users (
+	password TEXT PRIMARY KEY,
+	device_id TEXT NOT NULL DEFAULT '',
+	max_devices INTEGER NOT NULL DEFAULT 0,
+	expires_at INTEGER NOT NULL DEFAULT 0,
+	down_bytes INTEGER NOT NULL DEFAULT 0,
+	up_bytes INTEGER NOT NULL DEFAULT 0,
+	total_bytes INTEGER NOT NULL DEFAULT 0,
+	max_down_mbps REAL NOT NULL DEFAULT 0,
+	max_up_mbps REAL NOT NULL DEFAULT 0,
+	is_deactivated INTEGER NOT NULL DEFAULT 0,
+	comment TEXT NOT NULL DEFAULT '',
+	ports TEXT NOT NULL DEFAULT '',
+	vk_hash TEXT NOT NULL DEFAULT ''
+);
+CREATE TABLE IF NOT EXISTS wdtt_user_devices (
+	password TEXT NOT NULL,
+	device_id TEXT NOT NULL,
+	sort_order INTEGER NOT NULL DEFAULT 0,
+	PRIMARY KEY (password, device_id),
+	FOREIGN KEY (password) REFERENCES wdtt_users(password) ON DELETE CASCADE
+);
+CREATE TABLE IF NOT EXISTS wdtt_devices (
+	device_id TEXT PRIMARY KEY,
+	ip TEXT NOT NULL DEFAULT '',
+	priv_key TEXT NOT NULL DEFAULT '',
+	pub_key TEXT NOT NULL DEFAULT ''
+);
+CREATE TABLE IF NOT EXISTS wdtt_inbound (
+	id INTEGER PRIMARY KEY CHECK (id = 1),
+	tag TEXT NOT NULL DEFAULT 'wdtt-in',
+	remark TEXT NOT NULL DEFAULT 'WDTT',
+	enable INTEGER NOT NULL DEFAULT 1,
+	listen_host TEXT NOT NULL DEFAULT '0.0.0.0',
+	server_host TEXT NOT NULL DEFAULT '',
+	dtls_port INTEGER NOT NULL DEFAULT 56000,
+	wg_port INTEGER NOT NULL DEFAULT 56001,
+	client_port INTEGER NOT NULL DEFAULT 9000,
+	dns TEXT NOT NULL DEFAULT '1.1.1.1',
+	mtu INTEGER NOT NULL DEFAULT 1280,
+	max_users INTEGER NOT NULL DEFAULT 10,
+	handshake_timeout_sec INTEGER NOT NULL DEFAULT 30,
+	max_dtls_per_device INTEGER NOT NULL DEFAULT 0,
+	online_timeout_sec INTEGER NOT NULL DEFAULT 15,
+	admin_addr TEXT NOT NULL DEFAULT '127.0.0.1:2861'
+);`
+
+type desiredFile struct {
+	Passwords map[string]struct {
+		ExpiresAt     int64  `json:"expires_at"`
+		VkHash        string `json:"vk_hash"`
+		Ports         string `json:"ports"`
+		IsDeactivated bool   `json:"is_deactivated"`
+	} `json:"passwords"`
+}
+
+// ingestDesiredFile upserts the desired password set into wdtt_users and revokes DB users no longer
+// desired. SQLite-only; the caller reloads memory. No-op without -desired or before the DB is open.
+func ingestDesiredFile() error {
+	if desiredPath == "" || !serverPanelDBReady() {
+		return nil
+	}
+	raw, err := os.ReadFile(desiredPath)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil // not written yet (or removed) — leave the store as-is
+		}
+		return err
+	}
+	var d desiredFile
+	if err := json.Unmarshal(raw, &d); err != nil {
+		return err
+	}
+	sdb := serverPanelDB
+
+	dbMutex.Lock()
+	main := db.MainPassword
+	dbMutex.Unlock()
+
+	want := make(map[string]bool, len(d.Passwords))
+	for pw, e := range d.Passwords {
+		if pw == "" {
+			continue
+		}
+		want[pw] = true
+		u := &paneldb.User{
+			MaxDevices:    1, // one logical config per password (device-agnostic under -fixed-config)
+			ExpiresAt:     e.ExpiresAt,
+			IsDeactivated: e.IsDeactivated,
+			Ports:         e.Ports,
+			VkHash:        e.VkHash,
+		}
+		if err := paneldb.UpsertUser(sdb, main, pw, u); err != nil {
+			return err
+		}
+	}
+
+	stale, err := staleUserPasswords(sdb, main, want)
+	if err != nil {
+		return err
+	}
+	for _, pw := range stale {
+		if err := paneldb.DeleteUser(sdb, pw, nil); err != nil {
+			log.Printf("[DESIRED] revoke %s: %v", maskPassword(pw), err)
+		}
+	}
+	return nil
+}
+
+// staleUserPasswords = DB user passwords absent from `want` (never the owner/main password).
+func staleUserPasswords(sdb *sql.DB, main string, want map[string]bool) ([]string, error) {
+	rows, err := sdb.Query(`SELECT password FROM wdtt_users`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var stale []string
+	for rows.Next() {
+		var pw string
+		if err := rows.Scan(&pw); err != nil {
+			return nil, err
+		}
+		if pw != "" && pw != main && !want[pw] {
+			stale = append(stale, pw)
+		}
+	}
+	return stale, rows.Err()
+}
+
+// reloadDesired ingests the file then applies it to memory + the live WG device (nil-safe at startup).
+func reloadDesired() {
+	if err := ingestDesiredFile(); err != nil {
+		log.Printf("[DESIRED] ingest %s: %v", desiredPath, err)
+		return
+	}
+	serverWGDevMu.RLock()
+	dev := serverWGDev
+	serverWGDevMu.RUnlock()
+	if err := reloadDBFromDisk(dev); err != nil {
+		log.Printf("[DESIRED] reload: %v", err)
+		return
+	}
+	log.Printf("[DESIRED] password set reloaded from %s", desiredPath)
+}
