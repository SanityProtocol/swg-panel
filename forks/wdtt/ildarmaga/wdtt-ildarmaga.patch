+		return ""
+	}
+	base := ipnet.IP.To4()
+	if base == nil {
+		return ""
+	}
+	ones, bits := ipnet.Mask.Size()
+	if bits != 32 || ones > 30 {
+		return "" // no usable host range
+	}
+	span := uint64(1) << uint(32-ones)
+	start := uint64(base[0])<<24 | uint64(base[1])<<16 | uint64(base[2])<<8 | uint64(base[3])
+	// try a few offsets so a .0/.255 landing does not consume the caller's attempt budget
+	for i := uint64(0); i < 4; i++ {
+		off := ((n + i - 1) % (span - 1)) + 1 // 1 .. span-1, never the network address
+		v := start + off
+		last := byte(v)
+		if last == 0 || last == 255 {
+			continue
+		}
+		return fmt.Sprintf("%d.%d.%d.%d", byte(v>>24), byte(v>>16), byte(v>>8), last)
+	}
+	return ""
