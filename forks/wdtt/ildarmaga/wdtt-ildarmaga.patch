index 0000000..1065043
--- /dev/null
+++ b/server/rawpool_test.go
@@ -0,0 +1,44 @@
+package server
+
+import (
+	"net"
+	"testing"
+)
+
+func TestNthRawHostFollowsSubnet(t *testing.T) {
+	cases := []struct {
+		subnet, server string
+		want           int // how many of the first 400 allocations must be inside the subnet
+	}{
+		{"10.70.1.0/24", "10.70.1.1", 400},
+		{"10.70.0.0/16", "10.70.66.1", 400},
+		{"10.31.7.0/24", "10.31.7.1", 400},
+	}
+	for _, c := range cases {
+		rawSubnet, rawServerAddr = c.subnet, c.server
+		_, ipnet, _ := net.ParseCIDR(c.subnet)
+		in, seen := 0, map[string]bool{}
+		for n := uint64(1); n <= 400; n++ {
+			ip := nthRawHost(n)
+			if ip == "" {
+				t.Fatalf("%s: empty at n=%d", c.subnet, n)
+			}
+			p := net.ParseIP(ip).To4()
+			if p == nil || !ipnet.Contains(p) {
+				t.Fatalf("%s: %s is OUTSIDE the subnet — the exact bug this fixes", c.subnet, ip)
+			}
+			if p[3] == 0 || p[3] == 255 {
+				t.Fatalf("%s: %s uses a .0/.255 host", c.subnet, ip)
+			}
+			in++
+			seen[ip] = true
+		}
+		if in != c.want {
+			t.Fatalf("%s: %d/%d inside", c.subnet, in, c.want)
+		}
+		if len(seen) < 200 {
+			t.Fatalf("%s: only %d distinct addresses in 400 draws — pool collapses", c.subnet, len(seen))
+		}
+		t.Logf("%s -> %d draws, all inside, %d distinct", c.subnet, in, len(seen))
+	}
+}
