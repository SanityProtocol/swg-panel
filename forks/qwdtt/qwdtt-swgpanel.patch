diff --git a/swgpanel.go b/swgpanel.go
new file mode 100644
index 0000000..afaa3a3
--- /dev/null
+++ b/swgpanel.go
@@ -0,0 +1,442 @@
+package main
+
+// swg-panel additions to the qWDTT (SpaceNeuroX) server.
+//
+// Everything the panel needs lives here; server.go carries only small hooks. All
+// flags default to STOCK behaviour, so a binary built with this file but run
+// without our flags behaves exactly like upstream.
+//
+//	-iface          userspace-WG interface name      (multi-instance per node)
+//	-wg-addr        interface address/subnet, CIDR   (drives the client IP pool)
+//	-mtu            interface MTU
+//	-max-passwords  raise the stock 10-password cap
+//	-desired        panel-owned desired.json         (declarative password set)
+//	-no-nat         never touch host NAT/forward/sysctl (the node owns them)
+//	-fixed-config   one generated password = one keypair+IP, any device (wg parity)
+//	-api-addr       bind the HTTP control API here; EMPTY (default) = do not start it
+//	-raw-iface      raw-IP TUN name        (with -listen-raw; per instance)
+//	-raw-addr       raw-IP TUN address/subnet, CIDR
+//
+// Upstream binds its HTTP admin API on the *public DTLS port* (`-listen`), so a
+// stock server answers HTTP on the same port it pretends to be a VK call on. We
+// default it OFF and require an explicit (loopback) address to enable it.
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"log"
+	"net"
+	"os"
+	"os/exec"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.zx2c4.com/wireguard/device"
+)
+
+// ── panel-owned globals (stock defaults) ────────────────────────────────────
+
+var (
+	noNat       bool   // -no-nat: the node owns NAT/forward/sysctls
+	desiredFile string // -desired: panel-owned declarative password set
+	fixedConfig bool   // -fixed-config: password-keyed config, device-agnostic
+	swgAPIAddr  string // -api-addr: HTTP control API bind ("" = disabled)
+	swgPool     *net.IPNet
+	swgRawPool  *net.IPNet
+)
+
+var (
+	swgIfaceFlag  *string
+	swgWgAddrFlag *string
+	swgMTUFlag    *int
+	swgMaxPwFlag  *int
+	swgDesired    *string
+	swgNoNat      *bool
+	swgFixed      *bool
+	swgAPIFlag    *string
+	swgRawIface   *string
+	swgRawAddr    *string
+)
+
+// swgRegisterFlags is called from main() before flag.Parse().
+func swgRegisterFlags() {
+	swgIfaceFlag = flag.String("iface", wgIfaceName, "имя userspace-WG интерфейса (для нескольких инстансов на узле)")
+	swgWgAddrFlag = flag.String("wg-addr", wgServerCIDR, "адрес/подсеть интерфейса, IPv4 CIDR (напр. 10.66.66.1/24)")
+	swgMTUFlag = flag.Int("mtu", wgMTU, "MTU интерфейса")
+	swgMaxPwFlag = flag.Int("max-passwords", maxGeneratedPasswords, "лимит сгенерированных паролей")
+	swgDesired = flag.String("desired", "", "путь к panel-owned desired.json (декларативное управление паролями; пусто = режим бота)")
+	swgNoNat = flag.Bool("no-nat", false, "не трогать NAT/forward/sysctl хоста (узел управляет ими)")
+	swgFixed = flag.Bool("fixed-config", false, "один сгенерированный пароль = один keypair+IP для любого устройства (паритет с wg/awg)")
+	swgAPIFlag = flag.String("api-addr", "", "адрес HTTP control API (напр. 127.0.0.1:56100); пусто = API выключен")
+	swgRawIface = flag.String("raw-iface", rawIfaceName, "имя raw-IP TUN (только с -listen-raw; для нескольких инстансов на узле)")
+	swgRawAddr = flag.String("raw-addr", rawServerCIDR, "адрес/подсеть raw-IP TUN, IPv4 CIDR (напр. 10.70.66.1/16)")
+}
+
+// swgApplyFlags is called from main() right after flag.Parse().
+func swgApplyFlags() {
+	if v := strings.TrimSpace(*swgIfaceFlag); v != "" {
+		wgIfaceName = v
+	}
+	applyWgAddr(*swgWgAddrFlag)
+	if *swgMTUFlag > 0 {
+		wgMTU = *swgMTUFlag
+	}
+	if *swgMaxPwFlag > 0 {
+		maxGeneratedPasswords = *swgMaxPwFlag
+	}
+	desiredFile = strings.TrimSpace(*swgDesired)
+	noNat = *swgNoNat
+	fixedConfig = *swgFixed
+	swgAPIAddr = strings.TrimSpace(*swgAPIFlag)
+	if v := strings.TrimSpace(*swgRawIface); v != "" {
+		rawIfaceName = v
+	}
+	applyRawAddr(*swgRawAddr)
+}
+
+// applyWgAddr parses -wg-addr ("10.66.66.1/24" or a bare "10.66.66.1") into the
+// interface address, its CIDR, and the host pool the client IPs come from.
+func applyWgAddr(cidr string) {
+	cidr = strings.TrimSpace(cidr)
+	if cidr == "" {
+		return
+	}
+	ipStr := cidr
+	if i := strings.Index(cidr, "/"); i >= 0 {
+		ipStr = cidr[:i]
+	} else {
+		cidr = cidr + "/24"
+	}
+	ip := net.ParseIP(strings.TrimSpace(ipStr))
+	if ip == nil || ip.To4() == nil {
+		log.Fatalf("[CFG] неверный -wg-addr %q (ожидается IPv4 CIDR, напр. 10.66.66.1/24)", cidr)
+	}
+	_, ipnet, err := net.ParseCIDR(cidr)
+	if err != nil || ipnet == nil {
+		log.Fatalf("[CFG] неверный -wg-addr %q: %v", cidr, err)
+	}
+	wgServerAddr = ip.To4().String()
+	wgServerCIDR = cidr
+	swgPool = ipnet
+}
+
+// swgNextIP walks the configured pool for a free host address. Skips the network
+// address, the broadcast address and the server's own address. Stock getNextIP
+// hardcodes 10.66.0.0/16, which cannot host several instances on one node.
+func swgNextIP(used map[string]bool) string { return swgNextIPFrom(swgPool, wgServerAddr, used) }
+
+func swgNextIPFrom(pool *net.IPNet, selfAddr string, used map[string]bool) string {
+	if pool == nil {
+		return ""
+	}
+	base := pool.IP.Mask(pool.Mask).To4()
+	if base == nil {
+		return ""
+	}
+	ones, bits := pool.Mask.Size()
+	if bits != 32 || ones > 30 {
+		return ""
+	}
+	total := uint32(1) << uint(bits-ones)
+	start := uint32(base[0])<<24 | uint32(base[1])<<16 | uint32(base[2])<<8 | uint32(base[3])
+	for i := uint32(1); i < total-1; i++ {
+		v := start + i
+		ip := net.IPv4(byte(v>>24), byte(v>>16), byte(v>>8), byte(v)).String()
+		if ip == selfAddr || used[ip] {
+			continue
+		}
+		return ip
+	}
+	return ""
+}
+
+// applyRawAddr is applyWgAddr for the RAW subnet (-raw-addr).
+func applyRawAddr(cidr string) {
+	cidr = strings.TrimSpace(cidr)
+	if cidr == "" {
+		return
+	}
+	ipStr := cidr
+	if i := strings.Index(cidr, "/"); i >= 0 {
+		ipStr = cidr[:i]
+	} else {
+		cidr = cidr + "/16"
+	}
+	ip := net.ParseIP(strings.TrimSpace(ipStr))
+	if ip == nil || ip.To4() == nil {
+		log.Fatalf("[CFG] неверный -raw-addr %q (ожидается IPv4 CIDR, напр. 10.70.66.1/16)", cidr)
+	}
+	_, ipnet, err := net.ParseCIDR(cidr)
+	if err != nil || ipnet == nil {
+		log.Fatalf("[CFG] неверный -raw-addr %q: %v", cidr, err)
+	}
+	rawServerAddr = ip.To4().String()
+	rawServerCIDR = cidr
+	swgRawPool = ipnet
+}
+
+// ── raw-path device identity ────────────────────────────────────────────────
+//
+// Under -fixed-config a PASSWORD is the peer, so the raw path must key its device
+// by "pw:<password>" exactly like the WG path — otherwise one peer ends up with two
+// device records (one per datapath), its raw traffic is credited to neither, and
+// canConnectAndBind fills DeviceIDs with per-device bindings the panel never asked
+// for. Only the GETCONF_RAW worker carries the password; the other workers of the
+// group send bare AUTH, so remember the mapping for them.
+var (
+	swgRawAliasMu sync.Mutex
+	swgRawAlias   = map[string]string{}
+)
+
+func swgRawRemember(deviceID, dkey string) {
+	if deviceID == "" || dkey == "" || deviceID == dkey {
+		return
+	}
+	swgRawAliasMu.Lock()
+	swgRawAlias[deviceID] = dkey
+	swgRawAliasMu.Unlock()
+}
+
+func swgRawKey(deviceID string) string {
+	swgRawAliasMu.Lock()
+	defer swgRawAliasMu.Unlock()
+	if k, ok := swgRawAlias[deviceID]; ok {
+		return k
+	}
+	return deviceID
+}
+
+// getconfDeviceKey keys a GETCONF config by the PASSWORD (not the device) under
+// -fixed-config, so a generated password behaves like a wg/awg config file: one
+// keypair + one IP, portable across the user's devices, one connection at a time
+// (WireGuard itself enforces that).
+func getconfDeviceKey(isGenPass bool, deviceID, password string) string {
+	if fixedConfig && isGenPass {
+		return "pw:" + password
+	}
+	return deviceID
+}
+
+// ── panel-owned desired state ───────────────────────────────────────────────
+
+// DesiredPassword is the panel-owned subset of a generated password's config.
+// Runtime fields (device bindings, traffic counters) are NOT here — the server
+// owns those, and this file is never written by anything but the panel.
+type DesiredPassword struct {
+	ExpiresAt     int64  `json:"expires_at,omitempty"`
+	VkHash        string `json:"vk_hash,omitempty"`
+	Ports         string `json:"ports,omitempty"`
+	IsDeactivated bool   `json:"is_deactivated,omitempty"`
+}
+
+type DesiredFile struct {
+	Passwords map[string]*DesiredPassword `json:"passwords"`
+}
+
+// swgDevicesOf returns every device-store key that belongs to a password: the
+// fixed-config key, the legacy single binding, and the multi-device list.
+func swgDevicesOf(password string, e *PasswordEntry) []string {
+	keys := []string{"pw:" + password}
+	if e != nil {
+		if e.DeviceID != "" && e.DeviceID != "multi" {
+			keys = append(keys, e.DeviceID)
+		}
+		keys = append(keys, e.DeviceIDs...)
+	}
+	return keys
+}
+
+// swgDropDevices removes a password's devices from WireGuard and (optionally)
+// from the store. Never touches devices that belong to another password or to
+// the owner (main) password.
+func swgDropDevices(wgDev *device.Device, password string, e *PasswordEntry, del bool) bool {
+	changed := false
+	for _, k := range swgDevicesOf(password, e) {
+		dev, ok := db.Devices[k]
+		if !ok {
+			continue
+		}
+		removePeerFromWG(wgDev, dev)
+		if del {
+			delete(db.Devices, k)
+		}
+		changed = true
+	}
+	return changed
+}
+
+// reconcileDesired merges the panel's desired generated-password set into the
+// live DB: add new passwords, update the panel-owned fields, drop passwords no
+// longer desired (with their devices and wg peers). Runtime fields survive for
+// passwords that stay, then WRAP keys and wg peers are re-synced — so a panel
+// edit lands with no restart and no tunnel drop for unaffected devices. The
+// owner (main) password is never touched here. No-op if -desired is unset.
+func reconcileDesired(wgDev *device.Device) {
+	if desiredFile == "" {
+		return
+	}
+	data, err := os.ReadFile(desiredFile)
+	if err != nil {
+		if !os.IsNotExist(err) {
+			log.Printf("[DESIRED] Чтение %s: %v", desiredFile, err)
+		}
+		return
+	}
+	var want DesiredFile
+	if err := json.Unmarshal(data, &want); err != nil {
+		log.Printf("[DESIRED] Разбор %s: %v", desiredFile, err)
+		return
+	}
+	if want.Passwords == nil {
+		want.Passwords = map[string]*DesiredPassword{}
+	}
+
+	dbMutex.Lock()
+	changed := false
+
+	// Add / update desired passwords, preserving runtime state.
+	for p, d := range want.Passwords {
+		if p == "" || d == nil {
+			continue
+		}
+		e, ok := db.Passwords[p]
+		if !ok {
+			e = &PasswordEntry{}
+			db.Passwords[p] = e
+			changed = true
+			log.Printf("[DESIRED] + пароль %s", maskPassword(p))
+		}
+		if e.ExpiresAt != d.ExpiresAt || e.VkHash != d.VkHash || e.Ports != d.Ports || e.IsDeactivated != d.IsDeactivated {
+			// Newly deactivated → drop the live tunnel now, not at handshake expiry.
+			if d.IsDeactivated && !e.IsDeactivated {
+				swgDropDevices(wgDev, p, e, false)
+			}
+			e.ExpiresAt = d.ExpiresAt
+			e.VkHash = d.VkHash
+			e.Ports = d.Ports
+			e.IsDeactivated = d.IsDeactivated
+			changed = true
+		}
+	}
+
+	// Remove passwords the panel no longer wants (+ their devices + wg peers).
+	for p, e := range db.Passwords {
+		if _, ok := want.Passwords[p]; ok {
+			continue
+		}
+		swgDropDevices(wgDev, p, e, true)
+		delete(db.Passwords, p)
+		changed = true
+		log.Printf("[DESIRED] - пароль %s", maskPassword(p))
+	}
+
+	// Load-bearing disconnect: a password that is still present but DEACTIVATED
+	// must not keep a live tunnel. Also reaps fixed-config devices whose password
+	// was rotated away earlier. Devices belonging to no password at all are left
+	// alone — the owner (main) password's device lives there.
+	for p, e := range db.Passwords {
+		if e != nil && e.IsDeactivated {
+			if swgDropDevices(wgDev, p, e, false) {
+				changed = true
+			}
+		}
+	}
+	for dkey, dev := range db.Devices {
+		if !strings.HasPrefix(dkey, "pw:") {
+			continue
+		}
+		if _, ok := db.Passwords[dkey[3:]]; !ok {
+			removePeerFromWG(wgDev, dev)
+			delete(db.Devices, dkey)
+			changed = true
+			log.Printf("[DESIRED] × device %s (пароль удалён)", maskPassword(dkey[3:]))
+		}
+	}
+
+	if changed {
+		saveDB()
+	}
+	if err := refreshWrapKeysFromDBLocked(); err != nil {
+		log.Printf("[DESIRED] Обновление WRAP-ключей: %v", err)
+	}
+	dbMutex.Unlock()
+
+	// Re-add surviving devices' peers (idempotent; takes the lock itself).
+	syncPersistedPeersToWG(wgDev)
+}
+
+// desiredWatcher reconciles whenever the desired file's mtime changes — a
+// dependency-free backstop to SIGHUP, so a panel write always lands.
+func desiredWatcher(ctx context.Context, wgDev *device.Device) {
+	if desiredFile == "" {
+		return
+	}
+	var last int64
+	if fi, err := os.Stat(desiredFile); err == nil {
+		last = fi.ModTime().UnixNano()
+	}
+	ticker := time.NewTicker(3 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			fi, err := os.Stat(desiredFile)
+			if err != nil {
+				continue
+			}
+			if m := fi.ModTime().UnixNano(); m != last {
+				last = m
+				log.Println("[DESIRED] Изменение файла — сверка")
+				reconcileDesired(wgDev)
+			}
+		}
+	}
+}
+
+// ── teardown ────────────────────────────────────────────────────────────────
+
+// removeManagedFirewall reverses this instance's WDTT_MANAGED NAT/forward rules
+// on a clean stop, scoped to this instance's CIDR + interface so siblings are
+// untouched. No-op under -no-nat (the node owns the rules, and we never added
+// any).
+func removeManagedFirewall() {
+	if noNat {
+		return
+	}
+	extIface := getDefaultInterface()
+	if commandExists("iptables") {
+		for i := 0; i < 5; i++ {
+			exec.Command("iptables", "-t", "nat", "-D", "POSTROUTING", "-s", wgServerCIDR, "-o", extIface, "-m", "comment", "--comment", "WDTT_MANAGED", "-j", "MASQUERADE").Run()
+			exec.Command("iptables", "-D", "FORWARD", "-i", wgIfaceName, "-m", "comment", "--comment", "WDTT_MANAGED", "-j", "ACCEPT").Run()
+			exec.Command("iptables", "-D", "FORWARD", "-o", wgIfaceName, "-m", "comment", "--comment", "WDTT_MANAGED", "-j", "ACCEPT").Run()
+		}
+	}
+}
+
+// swgShutdown is the ONE teardown path for every exit — upstream's signal
+// handler calls os.Exit(0), which skips the deferred interface cleanup.
+func swgShutdown(cancel context.CancelFunc, wgDev *device.Device) {
+	cancel()
+	if wgDev != nil {
+		wgDev.Close()
+	}
+	runCmdSilent("ip", "link", "del", wgIfaceName)
+	removeManagedFirewall()
+}
+
+// swgBanner logs the panel-relevant configuration at boot.
+func swgBanner() {
+	api := swgAPIAddr
+	if api == "" {
+		api = "выключен"
+	}
+	log.Printf("   iface: %s | subnet: %s | desired: %q | no-nat: %v | fixed-config: %v | api: %s",
+		wgIfaceName, wgServerCIDR, desiredFile, noNat, fixedConfig, api)
+	log.Printf("   raw: %s | subnet: %s", rawIfaceName, rawServerCIDR)
+	_ = fmt.Sprintf
+}
