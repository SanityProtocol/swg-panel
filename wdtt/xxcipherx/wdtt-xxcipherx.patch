@@ -0,0 +1,48 @@
+package main
+
+import "testing"
+
+// -fixed-config: a GENERATED password owns ONE keypair+IP returned to ANY deviceID (wg/awg parity;
+// device-agnostic). Mirrors the ildarmaga fork's fixedconfig test (byte-identical wire).
+func TestFixedConfigDeviceAgnostic(t *testing.T) {
+	old := fixedConfig
+	defer func() { fixedConfig = old }()
+
+	fixedConfig = true
+	db = &Database{
+		Passwords: map[string]*PasswordEntry{"pwA": {}, "pwB": {}},
+		Devices:   map[string]*ClientDevice{},
+	}
+	mint := func(deviceID, password string) *ClientDevice {
+		dkey := getconfDeviceKey(true, deviceID, password)
+		if d, ok := db.Devices[dkey]; ok {
+			return d
+		}
+		priv, pub, err := generateKeyPair()
+		if err != nil {
+			t.Fatalf("keygen: %v", err)
+		}
+		d := &ClientDevice{DeviceID: dkey, IP: getNextIP(), PrivKey: priv, PubKey: pub}
+		db.Devices[dkey] = d
+		return d
+	}
+	// same password, two DIFFERENT physical devices -> identical config
+	d1 := mint("iphone-A", "pwA")
+	d2 := mint("macbook-B", "pwA")
+	if d1.PrivKey != d2.PrivKey || d1.IP != d2.IP {
+		t.Fatalf("not device-agnostic: %s@%s vs %s@%s", d1.PrivKey[:6], d1.IP, d2.PrivKey[:6], d2.IP)
+	}
+	// different password -> different config
+	d3 := mint("iphone-A", "pwB")
+	if d3.PrivKey == d1.PrivKey || d3.IP == d1.IP {
+		t.Fatalf("distinct passwords must get distinct configs")
+	}
+	if getconfDeviceKey(true, "x", "pwA") != getconfDeviceKey(true, "y", "pwA") {
+		t.Fatalf("fixed-config: same password must map to one key regardless of deviceID")
+	}
+	// stock mode keys by deviceID
+	fixedConfig = false
+	if getconfDeviceKey(true, "x", "pwA") == getconfDeviceKey(true, "y", "pwA") {
+		t.Fatalf("stock mode must key by deviceID")
+	}
+}
