+// applyWgAddr parses -wg-addr ("10.66.66.1/24" or bare "10.66.66.1") into the
+// interface's server address, CIDR and host-pool prefix.
+func applyWgAddr(cidr string) {
+	cidr = strings.TrimSpace(cidr)
+	ipStr := cidr
+	if i := strings.Index(cidr, "/"); i >= 0 {
+		ipStr = cidr[:i]
+	} else {
+		cidr = cidr + "/24"
+	}
+	ip := net.ParseIP(strings.TrimSpace(ipStr))
+	if ip == nil || ip.To4() == nil {
+		log.Fatalf("[CFG] неверный -wg-addr %q (ожидается IPv4 CIDR, напр. 10.66.66.1/24)", cidr)
+	}
+	v4 := ip.To4().String()
+	octs := strings.Split(v4, ".")
+	wgServerAddr = v4
+	wgServerCIDR = cidr
+	wgPoolPrefix = strings.Join(octs[:3], ".")
+}
+
+// desiredWatcher reconciles the panel-owned desired file whenever its mtime
+// changes — a dependency-free fallback to SIGHUP so a panel write always lands.
+func desiredWatcher(ctx context.Context, wgDev *device.Device) {
+	if desiredFile == "" {
+		return
+	}
+	var last int64
+	if fi, err := os.Stat(desiredFile); err == nil {
+		last = fi.ModTime().UnixNano()
+	}
+	ticker := time.NewTicker(3 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			fi, err := os.Stat(desiredFile)
+			if err != nil {
+				continue
+			}
+			if m := fi.ModTime().UnixNano(); m != last {
+				last = m
+				log.Println("[DESIRED] Изменение файла — сверка")
+				reconcileDesired(wgDev)
+			}
+		}
+	}
+}
 
