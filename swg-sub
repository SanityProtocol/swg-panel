def load_json(path, default):
    """Tolerant read: absent, unreadable, or a mid-write parse error all fall back to
    `default`. atomic_write/os.replace on the panel side means we never see a partial
    file — a JSONDecodeError here just means the primary is momentarily inconsistent."""
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except (json.JSONDecodeError, OSError, ValueError):
        return default


# ── describe (server/interface params for config building), mirrored from swg-panel-server ──
# Kept byte-for-byte compatible so a subscription config matches the panel's own QR.

def node_describe(snapshot):
    """Server/interface info from a node's pushed snapshot."""
    interfaces = {}
    for iface, blk in (snapshot.get("interfaces") or {}).items():
        meta = blk.get("meta") or {}
        interfaces[iface] = {
            "public_key": meta.get("public_key"), "listen_port": meta.get("listen_port"),
            "endpoint": meta.get("endpoint"), "address": meta.get("address"),
            "subnet": meta.get("subnet"), "awg_params": meta.get("awg_params", {}),
            "mtu_reported": meta.get("mtu"),   # the node's ACTUAL link MTU (None from a node too old to report it)
            "dns": meta.get("dns", []),
        }
    return interfaces


def node_public_host(snap):
    """First reported PUBLIC IPv4 of a node (skip private/loopback/link-local) — the host a client dials when the
    operator hasn't set an explicit endpoint_host. Byte-for-byte the same rule as swg-panel-server's
    node_public_ip: this used to be a hand-rolled prefix regex that claimed to mirror it and didn't, so the same
    node could be advertised differently by the panel and by this page. It accepted any public IPv6 (the panel is
    IPv4-only here) and, worse, anything that wasn't an IP at all — a malformed node_ips entry became the endpoint
    handed to clients."""
    for ip in ((snap or {}).get("node_ips") or []):
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            continue
        if a.version == 4 and not (a.is_private or a.is_loopback or a.is_link_local):
            return str(ip)
    return ""


def apply_iface_meta(node_cfg, interfaces):
    """Overlay the panel-side per-interface overrides (public endpoint host/port, DNS, MTU, keepalive,
    AmneziaWG obfuscation) onto node-reported metadata — exactly what the panel emits into client configs,
    field for field with swg-panel-server's apply_iface_meta. Read-only: never touches the node or any
    file. Returns interfaces."""
    node_ep = (node_cfg or {}).get("endpoint_host")
    ifov = (node_cfg or {}).get("ifaces") or {}
    for ifn, ifc in interfaces.items():
        ov = ifov.get(ifn) or {}
        rep = ifc.get("endpoint") or ""
        rep_host = rep.rsplit(":", 1)[0] if ":" in rep else rep
        host = ov.get("endpoint_host") or node_ep or rep_host
        port = ov.get("listen_port") or ifc.get("listen_port")
        if host and port:
            ifc["endpoint"] = f"{host}:{port}"
        if ov.get("dns") is not None:
            d = ov["dns"]
            ifc["dns"] = d if isinstance(d, list) else [s.strip() for s in str(d).split(",") if s.strip()]
        # Same rule as swg-panel-server's apply_iface_meta, and the same reason the render params live in
        # one function: this page and the panel must hand a peer the identical config. The panel override is
        # the desired MTU (the node converges to it), so rendering follows it rather than the reported one.
        ifc["mtu"] = ov.get("mtu") or ifc.get("mtu_reported") or 1280
        if ov.get("keepalive") is not None:
            ifc["keepalive"] = ov["keepalive"]        # client PersistentKeepalive for this interface
        ovawg = ov.get("awg_params")
        if isinstance(ovawg, dict) and ovawg:
            rep_awg = dict(ifc.get("awg_params") or {})
            ifc["awg_params"] = {**rep_awg, **{k: ovawg[k] for k in ovawg if ovawg[k] not in (None, "")}}
    return interfaces


def effective_client_params(peer, target, meta):
    """The four non-secret render parameters for ONE deployment of one peer (DNS / MTU / AllowedIPs /
    keepalive): the interface's live defaults, under the peer-wide `overrides`, under THIS target's own.
    Byte-for-byte the same rule as swg-panel-server's effective_client_params — see that docstring for why
    the rule lives in one place and is copied rather than paraphrased. Absent keys render live from the
    interface defaults, so a fleet-wide default change still reaches a peer that never customised."""
    _pov = peer.get("overrides") if isinstance(peer, dict) and isinstance(peer.get("overrides"), dict) else {}
    _tov = target.get("overrides") if isinstance(target, dict) and isinstance(target.get("overrides"), dict) else {}
    ov = {**_pov, **_tov}                               # the deployment's own setting wins, field by field
    meta = meta if isinstance(meta, dict) else {}
    _ka = ov.get("keepalive")
    _ika = meta.get("keepalive")
    if not (isinstance(_ka, int) and not isinstance(_ka, bool)):          # no per-peer/per-deployment value…
        _ka = _ika if isinstance(_ika, int) and not isinstance(_ika, bool) else 25   # …so the interface's, else 25
    return {
        # dns=[] is meaningful — an explicit "no DNS line" — so the test is "is there a list", not "is it truthy"
        "dns": list(ov["dns"]) if isinstance(ov.get("dns"), list) else list(meta.get("dns") or []),
        "mtu": ov.get("mtu") or meta.get("mtu") or 1280,
        "allowed": ov.get("allowed") or "0.0.0.0/0, ::/0",
        "keepalive": _ka,
    }


# ── the subscription state (all read-only; the panel owns writes) ──

_SUB_META = {
    "ru": {"desc": "Ваш доступ к VPN — настройки и QR-коды для ваших устройств в одном месте.",
           "title": "Ваш доступ к VPN",
           "ogdesc": "Настройки и QR-коды для ваших устройств в одном месте."},
}

def _sub_meta(data, lang):
    """Rewrite the shell's description/og for `lang`. English is what sub.html ships with, so that is a no-op;
    an unknown code leaves the file as written rather than emptying the tags. Nothing here is per-user — the URL
    carries a token, so a preview must describe the page and never say whose it is."""
    m = _SUB_META.get((lang or "").strip().lower()[:2])
    if not m:
        return data
    out = data.replace(b'<html lang="en">', ('<html lang="%s">' % lang).encode())
    with contextlib.suppress(Exception):
        out = re.sub(rb'(<meta name="description" content=")[^"]*(")',
                     lambda mo: mo.group(1) + m["desc"].encode() + mo.group(2), out)
        out = re.sub(rb'(<meta property="og:title" content=")[^"]*(")',
                     lambda mo: mo.group(1) + m["title"].encode() + mo.group(2), out)
        out = re.sub(rb'(<meta property="og:description" content=")[^"]*(")',
                     lambda mo: mo.group(1) + m["ogdesc"].encode() + mo.group(2), out)
    return out


class State:
    """Resolved paths into the panel's state dir, from fleet.json + the panel's own defaults."""

    def __init__(self, fleet):
        self.roster_path = fleet.get("roster_path", "/var/lib/swg-panel/users.json")
        self.nodes_path = fleet.get("nodes_path", "/var/lib/swg-panel/nodes.json")
        self.stats_dir = fleet.get("stats_dir", "/var/www/wgstats")
        state_dir = os.path.dirname(self.roster_path) or "."
        self.sub_dir = fleet.get("sub_dir") or os.path.join(state_dir, "subs")

    def subscriptions(self):
        # Read {enabled, serve} from the tiny subs/serve.json the panel mirrors — NOT panel-settings.json.
        # That file also holds webhook signing secrets + API token hashes, which this public, internet-
        # facing surface has no business being able to open (least privilege). serve.json is all we need.
        d = load_json(os.path.join(self.sub_dir, "serve.json"), {})
        return d if isinstance(d, dict) else {}

    def enabled(self):
        return bool(self.subscriptions().get("enabled"))

    def sub_users(self):
        d = load_json(os.path.join(self.sub_dir, "users.json"), {})
        return d if isinstance(d, dict) else {}

    def sub_blobs(self, uid):
        safe = re.sub(r"[^A-Za-z0-9_-]", "_", str(uid))
        d = load_json(os.path.join(self.sub_dir, "blobs", safe + ".json"), {})
        return d if isinstance(d, dict) else {}

    def roster(self):
        r = load_json(self.roster_path, {})
        if not isinstance(r, dict):
            r = {}
        if not isinstance(r.get("users"), dict):
            r["users"] = {}
        if not isinstance(r.get("peers"), dict):
            r["peers"] = {}
        return r

    def nodes(self):
        d = load_json(self.nodes_path, {})
        return d if isinstance(d, dict) else {}

    def describe(self, nodes):
        """Per-node {ifaces, turn} — snapshots are read from the mirror files the panel writes
        (stats-<id>.json), so this needs no running panel. `turn` is the node's raw turn-proxy list
        (non-secret client-config material: service / listen / wrap_key)."""
        out = {}
        for nid, cfg in nodes.items():
            snap = load_json(os.path.join(self.stats_dir, (cfg or {}).get("stats_file") or f"stats-{nid}.json"), None)
            if not isinstance(snap, dict) or not snap:
                continue
            out[nid] = {"ifaces": apply_iface_meta(cfg, node_describe(snap)),
                        "turn": snap.get("turn_proxies") or [],
                        "pub_host": node_public_host(snap)}   # reported public IP → WDTT link host when endpoint_host is unset
        return out


def _role_of(t):
    """The operator's label for one deployment: "primary", "backup", or "" — literal, never derived.

    The only such field: the page both prints this word and orders by it (primary, then unmarked, then
    backups). A peer nobody has labelled prints nothing at all, rather than calling its first deployment
    primary and every other one a backup of it."""
    v = (t or {}).get("primary")
    r = v.strip().lower() if isinstance(v, str) else ("primary" if v else "")
    return r if r in ("primary", "backup") else ""   # `True` is what pre-backup rosters carry


def _port_of(hostport):
    """Trailing :port of a host:port string → int, else None (mirrors the SPA's portOf)."""
    s = str(hostport or "")
    i = s.rfind(":")
    if i < 0:
        return None
    try:
        return int(s[i + 1:])
    except ValueError:
        return None


def _bind_ip_of(listen):
    """The concrete IP an instance binds, from its `host:port` listen string — "" for a wildcard or a bare port.

    A node can carry several public addresses, and a WDTT/csqtt server binds ONE of them. That bind is the only
    address that will answer, so it beats the node-wide fallback; a wildcard bind answers on all of them, and there
    the operator's endpoint choice is the right one. This mirrors the operator app's own resolution order
    (js/peer-ui.js) — which the subscription page had simply never learned, so on a multi-address node it handed
    the holder a different IP from the one the operator picked, with the right port. Nothing listens there.
    """
    s = str(listen or "").strip()
    i = s.rfind(":")
    host = s[:i] if i > 0 else ""
    if not host or host in ("0.0.0.0", "::", "[::]", "*"):
        return ""
    return host.strip("[]")


def token_lookup(users, token):
    """Raw token → user_id via constant-time sha256 match; None if unknown or disabled."""
    if not token:
        return None
    sha = hashlib.sha256(token.encode()).hexdigest()
    for uid, rec in users.items():
        if isinstance(rec, dict) and rec.get("enabled") and hmac.compare_digest(str(rec.get("token_sha", "")), sha):
            return uid
    return None


def token_lookup_rec(users, token):
    """Like token_lookup but matches a SUSPENDED user too (enabled False) → (uid, rec). A blocked user keeps
    its token_sha so the page can show a "Subscription disabled" screen instead of a bare 404. None if unknown."""
    if not token:
        return None
    sha = hashlib.sha256(token.encode()).hexdigest()
    for uid, rec in users.items():
        if isinstance(rec, dict) and hmac.compare_digest(str(rec.get("token_sha", "")), sha):
            return uid, rec
    return None


# Short-TTL cache for the HEAVY shared read — the roster, the token map, and the describe (which
# reads EVERY node's snapshot mirror). Without it, each /api hit re-parses the whole roster + all
# stats-<id>.json from disk, so a flood on one valid token turns into a disk-I/O storm (the panel
# guards its own /api/state the same way). The enable flag is deliberately NOT cached — it's read
# live per request so a panel toggle takes effect at once.
_READ_TTL = 3.0
_read_lock = threading.Lock()
_READ_CACHE = {"at": -1e9, "roster": None, "describe": None, "users": None, "nodes": None}

def _shared_read(state):
    now = time.monotonic()
    c = _READ_CACHE
    if c["roster"] is not None and (now - c["at"]) < _READ_TTL:
        return c["roster"], c["describe"], c["users"], c["nodes"]
    with _read_lock:
        now = time.monotonic()
        if c["roster"] is not None and (now - c["at"]) < _READ_TTL:
            return c["roster"], c["describe"], c["users"], c["nodes"]
        roster = state.roster()
        nodes = state.nodes()
        describe = state.describe(nodes)
        users = state.sub_users()
        c.update({"at": time.monotonic(), "roster": roster, "describe": describe, "users": users, "nodes": nodes})
        return roster, describe, users, nodes


# Per-client token-bucket backstop. This is NOT the authoritative rate limit — put swg-sub behind a
# reverse proxy and set real per-client limits there. It only blunts a runaway flood hitting the
# process directly. Behind a proxy every request appears to come from the proxy IP (one shared
# bucket), so set SWG_SUB_TRUST_XFF=1 ONLY when a trusted proxy fronts swg-sub — then the left-most
# X-Forwarded-For hop is used instead (never trust XFF on a directly-exposed instance: clients spoof it).
_TRUST_XFF = bool(os.environ.get("SWG_SUB_TRUST_XFF"))
_RL_CAP = 120           # burst allowance per client
_RL_RATE = 20.0         # sustained refill (tokens/sec)
_RL_MAX = 8192          # cap the tracking table so a spoofed/rotating-IP flood can't grow memory
_rl_lock = threading.Lock()
_RL = {}                # ident -> [tokens, last_monotonic]

def _rate_ok(ident):
    now = time.monotonic()
    with _rl_lock:
        if len(_RL) > _RL_MAX:
            _RL.clear()                                # crude but bounded: a many-IP flood resets the table, not RAM
        b = _RL.get(ident)
        if b is None:
            _RL[ident] = [_RL_CAP - 1.0, now]
            return True
        b[0] = min(_RL_CAP, b[0] + (now - b[1]) * _RL_RATE)
        b[1] = now
        if b[0] < 1.0:
            return False
        b[0] -= 1.0
        return True


def is_expired(rec, nowv):
    """True if rec (a user or a peer) has an expiry date that has already passed. 0/absent = never expires.
    Evaluated live on every request — no scheduler; a peer/sub reappears the instant the date is extended."""
    exp = (rec or {}).get("expiry") or 0
    return bool(exp) and nowv >= int(exp)


def read_data(state, token):
    """The public page's data for a token: the user's CURRENT peers, each target's NON-SECRET
    params + the encrypted secret blob. Never returns a plaintext key. None if subscriptions are
    off or the token is invalid.

    READ-ONLY: unlike the panel's sub_read_data (which prunes stale blobs on read), this filters
    the blob set against the live roster purely in memory — a peer no longer assigned to the user
    is simply skipped, so a stale blob can never surface even though we never delete it. The
    roster is authoritative; the blob store is a subordinate cache the panel keeps in sync."""
    if not state.enabled():
        return None
    roster, describe, users, nodes = _shared_read(state)
    found = token_lookup_rec(users, token)
    if found is None:
        return None
    uid, rec = found
    user = (roster.get("users") or {}).get(uid) or {}
    subs = state.subscriptions()
    langs = subs.get("languages") if isinstance(subs.get("languages"), dict) else {}
    theme = {"theme_color": subs.get("theme_color") or "", "theme_color_light": subs.get("theme_color_light") or "",
             "langs": {"enabled": langs.get("enabled") or ["en"], "default": langs.get("default") or "en"}}
    nowv = int(time.time())
    # BLOCKED user (subscription suspended, or the roster flag set): resolve the token to show the name +
    # theme, but serve NO peers or secrets. The page renders the centered "Subscription disabled" screen.
    if not rec.get("enabled") or user.get("disabled"):
        return {"disabled": True, "user": {"name": user.get("name") or ""}, **theme}
    # EXPIRED subscription: same treatment as blocked, but the page shows "Subscription expired". Expiry is a live
    # date test (the sub record stays enabled), so it's evaluated here on every request rather than at set-time.
    if is_expired(user, nowv):
        return {"expired": True, "user": {"name": user.get("name") or ""}, **theme}
    live = {pid: p for pid, p in (roster.get("peers") or {}).items()
            if isinstance(p, dict) and p.get("user_id") == uid}
    blobs = state.sub_blobs(uid)                        # per-user file — small, read fresh so a new peer shows at once
    peers_out = []
    for pid, p in live.items():
        sec = (blobs.get(pid) or {}).get("sec")        # None until the admin browser provisions it
        tgts_in = p.get("targets") or []
        # ── Which deployment is the PRIMARY one ──────────────────────────────────────────────────────
        # Roles are the operator's own labels now, so this surface reports them and derives nothing. It used to
        # elect a primary per protocol group when the roster held none, which put the word "Primary" on a
        # deployment nobody had chosen and called every other one a "Backup" of it. (That grouping insight still
        # holds — a turn proxy is no fallback for a tunnel — but it is the operator who expresses it, by marking
        # a primary in each family; the panel lets them, since roles are not exclusive.)
        tgts = []
        # Per-peer published SOURCES. The operator can hide a kind (say the turn-proxy configs) from THIS peer's
        # subscription without touching its deployments — the panel still shows them all, the sub just narrows.
        # A hidden source is dropped here, so its credential is never even served.
        _hide = set(x for x in (p.get("sub_hide") or []) if isinstance(x, str))
        for i, t in enumerate(tgts_in):
            if not isinstance(t, dict):
                continue
            _ty = (t.get("type") or "wg")
            if _ty in ("wdtt", "csqtt") and _ty in _hide:
                continue
            if (t.get("type") or "") == "wdtt":
                # WDTT peer: keyless. Its client link carries only the WRAP password (roster) + the node's public
                # host + the instance's DTLS/WG ports (from the node store, NOT a snapshot). No WG meta / no `sec`.
                node_cfg = nodes.get(t.get("node")) or {}
                inst = ((node_cfg.get("wdtt")) or {}).get(t.get("iface")) or {}
                dtls = ((inst.get("listen") or "").rsplit(":", 1)[-1]) or "56000"
                tgts.append({
                    "node": t.get("node"), "iface": t.get("iface"),
                    "node_name": node_cfg.get("name") or t.get("node"),
                    "type": "wdtt",
                    "wdtt": {"password": p.get("wdtt_password") or "",
                             "fork": inst.get("fork") or "amurcanov",   # which WDTT fork → resolve the right per-OS client + encoder

                             "endpoint_host": (_bind_ip_of(inst.get("listen")) or node_cfg.get("endpoint_host")
                                               or (describe.get(t.get("node")) or {}).get("pub_host") or ""),
                             "dtls_port": dtls, "wg_port": str(inst.get("wg_port") or 56001), "tun_port": "9000",
                             "raw_port": str(inst.get("raw_port") or ""),   # RAW-IP mode, when this server accepts it
                             "vk_hash": (p.get("vk_hash") or "").strip()},
                    "primary": _role_of(t),
                })
                continue
            if (t.get("type") or "") == "csqtt":
                # csqtt peer: keyless raw-TUN turn server. Its client link (csqtt://connect?v=2) carries only the
                # panel-owned access password + the node's public host + the instance's UDP/DTLS port; the VK hashes
                # (peer.vk_hash + the user's VK call links) are the TURN credential. No WG meta / no `sec`.
                node_cfg = nodes.get(t.get("node")) or {}
                inst = ((node_cfg.get("csqtt")) or {}).get(t.get("iface")) or {}
                port = ((inst.get("listen") or "").rsplit(":", 1)[-1]) or "46000"
                tgts.append({
                    "node": t.get("node"), "iface": t.get("iface"),
                    "node_name": node_cfg.get("name") or t.get("node"),
                    "type": "csqtt",
                    "csqtt": {"password": p.get("csqtt_password") or "",
                              "endpoint_host": (_bind_ip_of(inst.get("listen")) or node_cfg.get("endpoint_host")
                                                or (describe.get(t.get("node")) or {}).get("pub_host") or ""),
                              "port": port,
                              "vk_hash": (p.get("vk_hash") or "").strip()},
                    "primary": _role_of(t),
                })
                continue
            nd = describe.get(t.get("node")) or {}
            meta = (nd.get("ifaces") or {}).get(t.get("iface")) or {}
            awg = meta.get("awg_params") or {}
            lp = meta.get("listen_port")
            # turn-proxies forwarding to THIS interface (same test as the admin's turnProxiesFor: the proxy
            # connects to the iface's listen port). Only non-secret client-config material rides along.
            turn = [{"service": tp.get("service"), "listen": tp.get("listen"), "wrap_key": tp.get("wrap_key")}
                    for tp in (nd.get("turn") or []) if isinstance(tp, dict) and lp and _port_of(tp.get("connect")) == lp]
            _wgty = "awg" if awg else (t.get("type") or "wg")
            # THIS deployment's client-config customisation over the peer-wide one over the interface's live
            # defaults. A peer may span several interfaces, and the settings that describe how a client reaches
            # one of them (DNS / MTU / AllowedIPs / keepalive) belong to that deployment; the peer-wide block
            # stays the fallback so every peer written before per-target settings existed renders as it did.
            eff = effective_client_params(p, t, meta)
            if "turn" in _hide:
                turn = []                       # keep the direct config, drop its proxy variants
            if _wgty in _hide:
                if not turn:
                    continue                    # nothing left to publish for this deployment
                _direct_off = True              # publish ONLY its turn variants (below)
            else:
                _direct_off = False
            tgts.append({
                "node": t.get("node"), "iface": t.get("iface"),
                "node_name": (nodes.get(t.get("node")) or {}).get("name") or t.get("node"),
                "type": "awg" if awg else (t.get("type") or "wg"),
                "ip": t.get("ip"),
                "endpoint": meta.get("endpoint"), "server_pubkey": meta.get("public_key"),
                "dns": eff["dns"],
                "subnet": meta.get("subnet"),
                "mtu": eff["mtu"],
                "allowed": eff["allowed"],
                "keepalive": eff["keepalive"],
                "awg": awg,
                "turn": turn,
                **({} if not _direct_off else {"direct": False}),   # its own kind is hidden: only the proxy variants publish
                "primary": _role_of(t),
            })
        # A blocked/expired peer still appears on the page, but the cell shows a "BLOCKED"/"EXPIRED" placeholder
        # instead of its QR/config/buttons — so the holder sees WHY it stopped working. (A whole-user block/expiry
        # is handled above; these per-peer flags cover the case where only some of a user's peers are cut off.)
        peers_out.append({"peer_id": pid, "title": p.get("title") or "", "sec": sec, "targets": tgts,
                          "disabled": bool(p.get("disabled")), "expired": is_expired(p, nowv)})
    # active peers first (A-Z by title, untitled by IP), then blocked/expired at the bottom (also A-Z). The sub page
    # renders live-then-dead within this order, so a single title sort here gives both groups their A-Z ordering.
    def _peer_key(po):
        t = (po.get("title") or "").strip().lower()
        ip = ((po.get("targets") or [{}])[0] or {}).get("ip") or ""
        return (bool(po.get("disabled") or po.get("expired")), t == "", t, ip)   # active-first · titled-first · A-Z · then IP
    peers_out.sort(key=_peer_key)
    subs = state.subscriptions()
    langs = subs.get("languages") if isinstance(subs.get("languages"), dict) else {}
    return {"user": {"name": user.get("name") or ""}, "peers": peers_out,
            # PER-USER VK link only — subscriptions NEVER fall back to the panel-wide vk_link (that one is for
            # the admin's own testing + unassigned peers). Empty here → the sub page shows a "create one" warning.
            "turn_enabled": bool(subs.get("turn_enabled")), "vk_link": (user.get("vk_link") or ""),
            "vk_links": (user.get("vk_links") if isinstance(user.get("vk_links"), list) else ([user.get("vk_link")] if user.get("vk_link") else [])),   # all of the user's VK links (primary first); forks that support it embed all, freeturn lists them

            "theme_color": subs.get("theme_color") or "", "theme_color_light": subs.get("theme_color_light") or "",
            "turn_fork_colors": subs.get("turn_fork_colors") or {}, "iface_colors": subs.get("iface_colors") or {},
            "turn_client_default": subs.get("turn_client_default") or {},   # admin's END-USER default app per (fork, OS) → the page hands out THIS app instead of the compat-ranked top one
            "turn_client_settings": subs.get("turn_client_settings") or {},   # SETTINGS SPLIT: admin's per-fork client (app) values → the sub page generates configs with them (encoder fills any unset with defaults)
            "turn_catalog": subs.get("turn_catalog") or {},   # AXIS-3: server→client/app/scheme/store metadata so the page can offer "Get the app" install links (public app links only, no secrets)
            "wg_catalog": subs.get("wg_catalog") or {},   # WG/AWG client apps + per-OS resolved installer (download bubble): body → downloads page, icon → direct file
            "node_colors": subs.get("node_colors") or {},   # per-node colour so each server name renders in its panel colour
            "langs": {"enabled": langs.get("enabled") or ["en"], "default": langs.get("default") or "en"}}


# ── HTTP ──

class Handler(BaseHTTPRequestHandler):
    server_version = "swg-sub"
    protocol_version = "HTTP/1.1"
    state = None
    _meta_warned = False        # link-preview metadata failure is reported once, not once per visit

    def log_message(self, *a):
        pass                                            # no request logging — the page is public, keep it quiet

    def _headers(self, code, ctype, length, cache="no-store", extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(length))
        self.send_header("Cache-Control", cache)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()

    def _send(self, code, body, ctype="text/plain; charset=utf-8", cache="no-store", extra=None):
        data = body if isinstance(body, (bytes, bytearray)) else str(body).encode()
        self._headers(code, ctype, len(data), cache, extra)
        if self.command != "HEAD":
            with contextlib.suppress(BrokenPipeError, ConnectionError):
                self.wfile.write(data)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj).encode(), "application/json; charset=utf-8")

    def _notfound(self):
        # Uniform 404 for everything that isn't a live surface: an off master switch, an unknown
        # or disabled token, a stray path. Reveals nothing about which tokens exist.
        self._send(404, "not found\n")

    # Strict CSP for the buildless page: same-origin scripts/styles, data: only for the QR images
    # this page draws into <img>. No connect-src to anywhere but self; no framing.
    _CSP = ("default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; "
            "img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; "
            "base-uri 'self'; frame-ancestors 'none'")

    def _static(self, name):
        rel = STATIC.get(name)
        if not rel:
            return self._notfound()
        full = os.path.normpath(os.path.join(WEB_DIR, rel))
        if not (full.startswith(os.path.realpath(WEB_DIR)) or full.startswith(WEB_DIR)):
            return self._send(403, "forbidden\n")
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            return self._notfound()
        _, ext = os.path.splitext(full)
        self._send(200, data, CTYPES.get(ext, "application/octet-stream"), cache="no-cache")

    def _page(self):
        # The single-page shell for every token. It carries no user data itself — the browser reads
        # its token from the path and the unlock key from the fragment, then fetches /api/<token>.
        full = os.path.join(WEB_DIR, "sub.html")
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            return self._send(500, "subscription page missing\n")
        if VERSION:
            # a "+sha" dev build must be %2B in the query — a literal "+" makes a CDN/WAF (Cloudflare) reject the URL.
            q = ("?v=" + VERSION.replace("+", "%2B")).encode()   # asset refs are RELATIVE (no leading /) so they resolve under any reverse-proxy mount
            data = (data.replace(b'href="_a/sub.css"', b'href="_a/sub.css' + q + b'"')
                        .replace(b'src="_a/sub.js"', b'src="_a/sub.js' + q + b'"')
                        .replace(b'src="_a/qrcode.js"', b'src="_a/qrcode.js' + q + b'"')
                        .replace(b'src="_a/turn-artifacts.js"', b'src="_a/turn-artifacts.js' + q + b'"'))
        # Metadata in the language the ADMIN set as the subscriptions default (subs.languages.default) — not the
        # visitor's, and not a per-browser choice: this is what a link preview shows wherever the URL is pasted,
        # long before anyone opens it and picks a language. Body text still follows the visitor's own selection.
        # Handler.state, NOT a bare `state`: the state object is a CLASS attribute, which is not in a method's
        # scope, so the bare name was a plain global lookup that could only ever raise NameError. Every other route
        # already reads it this way (`st = Handler.state`). It raised AFTER the connection was accepted, so the
        # page replied with nothing at all — and an empty reply is invisible in every place anyone looks: the unit
        # reads active, the journal is clean, /healthz, /api/<token> and every asset answer 200, and a CDN in front
        # reports its own 520 as if the origin were at fault. Only the one route that renders the page was dead.
        # Suppressed, too: the shell must be served even if the metadata step fails. A localised og: tag is worth
        # strictly less than the page loading, and this is the whole subscription surface.
        # Reported ONCE, not suppressed silently: this page is served on every visit, so a per-request line would
        # be noise — but a failure nobody can see is exactly what made the bug above survive a release. Degrade,
        # and say so a single time.
        try:
            _lg = (Handler.state.subscriptions() or {}).get("languages")
            data = _sub_meta(data, ((_lg if isinstance(_lg, dict) else {}).get("default") or "en"))
        except Exception as _e:
            if not Handler._meta_warned:
                Handler._meta_warned = True
                print("sub: link-preview metadata skipped (%s) — the page itself is served unchanged"
                      % str(_e)[:160], flush=True)
        self._send(200, data, "text/html; charset=utf-8", cache="no-cache", extra={"Content-Security-Policy": self._CSP})

    def _client_ident(self):
        if _TRUST_XFF:
            xff = self.headers.get("X-Forwarded-For", "")
            if xff:
                return xff.split(",")[0].strip()
        try:
            return self.client_address[0]
        except Exception:
            return "?"

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        path = strip_base(self.path.split("?", 1)[0].split("#", 1)[0])   # drop the reverse-proxy mount prefix, if any
        st = Handler.state

        if path == "/healthz":
            return self._send(200, "ok\n")

        if not _rate_ok(self._client_ident()):
            return self._send(429, "slow down\n", extra={"Retry-After": "5"})

        if path.startswith(ASSET_PREFIX):
            return self._static(path[len(ASSET_PREFIX):])

        if path.startswith("/api/"):
            token = path[len("/api/"):]
            if not TOKEN_RE.match(token):
                return self._notfound()
            data = read_data(st, token)
            if data is None:
                return self._notfound()
            return self._json(200, {"ok": True, "data": data})

        if path == "/" or path == "":
            return self._notfound()

        token = path[1:]
        if "/" in token or not TOKEN_RE.match(token):
            return self._notfound()
        if not st.enabled():                            # surface off ⇒ nothing here, not even the shell
            return self._notfound()
        return self._page()


class _TLSServer(ThreadingHTTPServer):
    daemon_threads = True
    ssl_ctx = None

    def get_request(self):
        sock, addr = self.socket.accept()
        sock.settimeout(60)
        return sock, addr

    def finish_request(self, request, client_address):
        if self.ssl_ctx is not None:
            request = self.ssl_ctx.wrap_socket(request, server_side=True)
        super().finish_request(request, client_address)

    def handle_error(self, request, client_address):
        pass                                            # failed handshake / scanner / vanished client — routine noise


def _serve_config(state):
    """Listener host/port/TLS. Read once at startup — changing the bind or TLS needs a restart; the
    master enable flag is what's re-read live per request.

    Precedence is env-FIRST, then the panel's `subscriptions.serve`, then a default. The bind is an
    infrastructure fact — the systemd unit's SWG_SUB_PORT, or the port the docker container publishes
    (fixed at 8444 inside the container) — so it MUST win over a panel field; otherwise changing the
    port in the panel would bind a port the container never published. The panel's serve.* is the
    fallback for a hand-run bare-metal process with no unit, and the source of the TLS cert when the
    infra didn't pin one (e.g. reusing the panel's cert)."""
    serve = state.subscriptions().get("serve") if isinstance(state.subscriptions().get("serve"), dict) else {}
    host = (os.environ.get("SWG_SUB_HOST") or serve.get("host") or "0.0.0.0").strip() or "0.0.0.0"
    try:
        port = int(os.environ.get("SWG_SUB_PORT") or serve.get("port") or 8444)
    except (TypeError, ValueError):
        port = 8444
    port = max(1, min(65535, port))
    env_cert, env_key = os.environ.get("SWG_SUB_TLS_CERT"), os.environ.get("SWG_SUB_TLS_KEY")
    if env_cert and env_key:
        cert, key = env_cert.strip(), env_key.strip()          # infra pinned a cert (e.g. bare-metal internal mode)
    elif serve.get("tls_mode") == "reverse-proxy":
        cert, key = "", ""                                      # operator terminates TLS upstream → plain HTTP here
    else:
        # swg-sub terminates its own TLS: an explicit path from the panel, else its standard cert location
        # (swg-netctl installs the acme cert there). Missing file → plain HTTP, so a proxy can still front it.
        cert = (serve.get("cert_path") or "").strip() or DEFAULT_SUB_CERT
        key = (serve.get("key_path") or "").strip() or DEFAULT_SUB_KEY
    if cert and key and os.path.exists(cert) and os.path.exists(key):
        return host, port, cert, key
    return host, port, None, None                              # no usable cert → plain HTTP (front with a proxy)


def main():
    # Tolerate a cold start where the panel hasn't written fleet.json yet (docker: swg-sub and the
    # panel come up together and share the config volume). Wait a bounded while, then let the process
    # exit so the supervisor (systemd Restart / compose restart) retries — never spin forever.
    fleet = load_json(FLEET_PATH, None)
    for _ in range(30):
        if fleet is not None:
            break
        print(f"swg-sub: waiting for {FLEET_PATH} …", flush=True)
        time.sleep(2)
        fleet = load_json(FLEET_PATH, None)
    if fleet is None:
        raise SystemExit(f"cannot read fleet config: {FLEET_PATH}")
    state = State(fleet)
    Handler.state = state

    global SUB_BASE, SUB_BASE_ALT                            # SWG_SUB_BASE wins (infra), else the panel's serve.base (from the sub public URL path)
    def _read_bases():
        sv = (state.subscriptions().get("serve") or {})
        b = _norm_base(os.environ.get("SWG_SUB_BASE") or sv.get("base"))
        ba = _norm_base(sv.get("base_alt"))                 # a transitional OLD base the panel keeps live during a grace
        return b, (ba if ba and ba != b else "")
    SUB_BASE, SUB_BASE_ALT = _read_bases()

    host, port, cert, key = _serve_config(state)
    # Direct-TLS: the panel issues swg-sub's OWN cert ASYNCHRONOUSLY (docker), so it may not be on disk yet when we
    # (re)start right after a mode change. Falling straight to plain HTTP would then 525 behind a Cloudflare Full zone.
    # Wait a bounded while for the cert to appear, re-reading each pass; give up to plain HTTP if it never comes (a
    # reverse proxy / CF Flexible can still front it). Skipped when a cert is already present or pinned via env.
    _sv = (state.subscriptions().get("serve") or {})
    if not (cert and key) and _sv.get("tls_mode") not in (None, "", "reverse-proxy") \
            and not (os.environ.get("SWG_SUB_TLS_CERT") and os.environ.get("SWG_SUB_TLS_KEY")):
        print("swg-sub: direct-TLS (%s) but no certificate yet — waiting for the panel to issue it…" % _sv.get("tls_mode"), flush=True)
        # SURVIVE THE SIGNAL THAT SAYS THE CERT IS READY. The real SIGHUP handler is installed further down,
        # AFTER this wait — so for the whole ~90s window the default action applied and a HUP simply killed
        # the process. And a HUP is exactly what arrives here: the panel issues the certificate and then
        # signals swg-sub to pick it up. Observed end to end — "waiting for the panel to issue it…", cert
        # issued 2s later, "Sent signal SIGHUP", process dead, subscription page down (Cloudflare 521).
        # Ignoring it is enough: the loop below re-reads every 2s and finds the cert on its own.
        with contextlib.suppress(Exception):
            signal.signal(signal.SIGHUP, signal.SIG_IGN)
        for _ in range(45):                       # ~90s ceiling — a Cloudflare DNS-01 issue+install
            time.sleep(2)
            state = State(fleet); Handler.state = state
            host, port, cert, key = _serve_config(state)
            if cert and key:
                print("swg-sub: certificate ready — serving HTTPS", flush=True); break
        else:
            print("swg-sub: no certificate after ~90s — serving plain HTTP (front with a TLS proxy / Cloudflare Flexible)", flush=True)
    scheme = "http"
    if cert and key:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(cert, key)
        srv = _TLSServer((host, port), Handler)
        srv.ssl_ctx = ctx
        scheme = "https"
    else:
        srv = ThreadingHTTPServer((host, port), Handler)

    def _reload(_sig, _frm):
        # SIGHUP: re-read serve.json (mount base + transitional alt base) with NO rebind, and — under TLS — swap in a
        # renewed cert. This lets the panel apply a PATH / config / cert change to swg-sub WITHOUT a restart; only a
        # bind (host/port) change still needs the restart + crash-loop verify. A path change thus becomes zero-downtime
        # (dual-base keeps the old path live), and existing subscription links keep working through the transition.
        global SUB_BASE, SUB_BASE_ALT
        try:
            nb, nba = _read_bases()
            if (nb, nba) != (SUB_BASE, SUB_BASE_ALT):
                SUB_BASE, SUB_BASE_ALT = nb, nba
                print("swg-sub: reloaded config (SIGHUP) — base %s%s" % (SUB_BASE or "/",
                      (" (+ old base %s during migration)" % SUB_BASE_ALT) if SUB_BASE_ALT else ""), flush=True)
        except Exception as e:
            print(f"swg-sub: config reload failed: {e}", flush=True)
        if getattr(srv, "ssl_ctx", None) is not None:
            # Swap in a FRESH context, not load_cert_chain() over the live one: an SSLContext keeps one cert PER KEY
            # TYPE, so loading a cert of a different key type (an acme renewal that flips ECDSA↔RSA) leaves the OLD
            # cert active — a silent no-op. A new context holds only the new cert, so the swap always takes.
            try:
                nctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
                nctx.load_cert_chain(cert, key)
                srv.ssl_ctx = nctx
                print("swg-sub: reloaded TLS certificate (SIGHUP)", flush=True)
            except Exception as e:
                print(f"swg-sub: TLS reload failed (keeping old cert): {e}", flush=True)
    with contextlib.suppress(ValueError, OSError, AttributeError):
        signal.signal(signal.SIGHUP, _reload)

    on = "enabled" if state.enabled() else "disabled (all requests 404 until turned on in the panel)"
    print(f"swg-sub {VERSION} on {scheme}://{host}:{port}{SUB_BASE or ''} — subscriptions {on}", flush=True)
    with contextlib.suppress(KeyboardInterrupt):
        srv.serve_forever()


if __name__ == "__main__":
    main()
