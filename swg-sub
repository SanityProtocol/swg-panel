# Reverse-proxy mount base, e.g. "/swgsub" (empty = served at root), mirroring the panel's SWG_PANEL_BASE. Set
# once at startup from SWG_SUB_BASE or the panel-written serve.base, and stripped off every request path so the
# routes ("/_a/…", "/api/…", "/<token>") match whether swg-sub is mounted at root or under a subpath. The page's
# own asset/API URLs are RELATIVE, so nothing needs injecting into the HTML — the browser resolves them under the
# path the page was served from. A base change (like a bind change) needs a restart; the panel restarts swg-sub.
SUB_BASE = ""
SUB_BASE_ALT = ""                                            # a SECOND base swg-sub ALSO serves during a reverse-proxy
                                                            # PATH change — the panel keeps the OLD base here through a
                                                            # grace so existing subscription links keep working while
                                                            # users move to the new one. Set/cleared on SIGHUP reload.
def _norm_base(v):
    v = "/" + str(v or "").strip().strip("/")
    return "" if v == "/" else v
def strip_base(path):
    for b in (SUB_BASE, SUB_BASE_ALT):                       # serve the current base AND, during a path swap, the old one
        if not b:
            continue
        if path == b:
            return "/"
        if path.startswith(b + "/"):
            return path[len(b):]
    return path                                              # root mount, or outside every mount (e.g. /healthz) → untouched

